{
  "name": "apha-fps-apps-codespaces",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/src/Apha.BatchJobs",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [5432],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-dotnettools.csharp",
        "github.vscode-github-actions"
      ]
    }
  },
  "postCreateCommand": "docker --version; docker compose version",
  "postStartCommand": "git config --global --add safe.directory /workspaces/${localWorkspaceFolderBasename}"
}
