QUERY NAME: qryAdditionalOverview
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW qryProjectYearProject.FinancialYear, qryProjectYearProject.Project, tblAdditionalCosts.Description, Sum(tblAdditionalCosts.Number) AS SumOfNumber, tblAdditionalCosts.ItemCost, [Number]*[ItemCost] AS TotalAdditionalCost
FROM qryProjectYearProject INNER JOIN tblAdditionalCosts ON qryProjectYearProject.ProjectYear = tblAdditionalCosts.ProjectYear
GROUP BY qryProjectYearProject.FinancialYear, qryProjectYearProject.Project, tblAdditionalCosts.Description, tblAdditionalCosts.ItemCost, [Number]*[ItemCost]
HAVING ((qryProjectYearProject.Project=[Forms]![frmProject1]![Project]));

