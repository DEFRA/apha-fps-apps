QUERY NAME: qryIncomeByDisease_Crosstab1
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(qryIncomeByDisease.SYearIncome) AS SumOfSYearIncome
SELECT qryIncomeByDisease.FinancialYear, qryIncomeByDisease.Project, qryIncomeByDisease.ProjectTitle
FROM qryIncomeByDisease
GROUP BY qryIncomeByDisease.FinancialYear, qryIncomeByDisease.Project, qryIncomeByDisease.ProjectTitle
PIVOT qryIncomeByDisease.Disease;

