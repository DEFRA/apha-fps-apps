QUERY NAME: qryTestOverview
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW qryProjectYearProject.FinancialYear, qryProjectYearProject.Project, qryTestReqTest.TestCode, qryTestReqTest.TestDescription, qryTestReqTest.UnitPrice, Sum(qryTestReqTest.NoTests) AS SumOfNoTests, Sum(qryTestReqTest.TestCost) AS SumOfTestCost
FROM qryProjectYearProject INNER JOIN qryTestReqTest ON qryProjectYearProject.ProjectYear = qryTestReqTest.ProjectYear
GROUP BY qryProjectYearProject.FinancialYear, qryProjectYearProject.Project, qryTestReqTest.TestCode, qryTestReqTest.TestDescription, qryTestReqTest.UnitPrice
HAVING ((qryProjectYearProject.Project=[Forms]![frmProject1]![Project]));

