QUERY NAME: qrySummaryStaffEffort
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(tblStaffRequ.NoDays) AS SumOfNoDays
SELECT tblProjectYear.Project, WorkGroupGrade.WorkGroup, IIf([tblStaffRequ].[WGGrade] Like "GD5*","GD5",Left([tblStaffRequ].[WGGrade],1)) AS GradeCode, tblStaffRequ.Name, Sum(tblStaffRequ.NoDays) AS Total
FROM (tblProject INNER JOIN tblProjectYear ON tblProject.Project = tblProjectYear.Project) INNER JOIN (tblStaffRequ LEFT JOIN WorkGroupGrade ON tblStaffRequ.WGGrade = WorkGroupGrade.WGGrade) ON (tblProjectYear.YearNo = tblStaffRequ.Year) AND (tblProjectYear.Project = tblStaffRequ.Project)
WHERE (((tblProject.Project)=fnGetProject()))
GROUP BY tblProjectYear.Project, WorkGroupGrade.WorkGroup, IIf([tblStaffRequ].[WGGrade] Like "GD5*","GD5",Left([tblStaffRequ].[WGGrade],1)), tblStaffRequ.Name
PIVOT tblProjectYear.YearNo;

