QUERY NAME: qryCSG7_Exceptional
---------------------------------------------
TYPE: SELECT

SQL:
SELECT tblAdditionalCosts.Project, tblAdditionalCosts.Year AS YearNo, Sum(tblAdditionalCosts.ItemCost) AS cost, tblkpAccountCategory.CSG7_Group AS Category
FROM tblAdditionalCosts INNER JOIN tblkpAccountCategory ON tblAdditionalCosts.AccountCat = tblkpAccountCategory.AccShortName
GROUP BY tblAdditionalCosts.Project, tblAdditionalCosts.Year, tblkpAccountCategory.CSG7_Group
HAVING (((tblAdditionalCosts.Project)=[Forms]![frmProject1]![Project]));

