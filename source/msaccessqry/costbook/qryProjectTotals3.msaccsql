QUERY NAME: qryProjectTotals3
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW qryProjectYearProject.Disease, qryProjectYearProject.FinancialYear, qryProjectYearProject.Project, qryProjectYearProject.YearIncome, qryProjectYearProject.ProjectTitle, qryProjectYearProject.StartFYear, qryProjectYearProject.ContractPrice, qryProjectYearProject.PlanCat, qryProjectYearProject.ProjectWorkGroup, qryProjectYearProject.StartDate, Sum(qryStaffReqGradeSum.StaffCost) AS SumOfStaffCost, Sum(qryTestReqTestSum.TestCost) AS SumOfTestCost, Sum(qryAnimalTypeAnimalSum.AnimalCost) AS SumOfAnimalCost, Sum(qryAdditionalCosts.LineCost) AS SumOfLineCost
FROM (((qryProjectYearProject LEFT JOIN qryAnimalTypeAnimalSum ON qryProjectYearProject.ProjectYear = qryAnimalTypeAnimalSum.ProjectYear) LEFT JOIN qryStaffReqGradeSum ON qryProjectYearProject.ProjectYear = qryStaffReqGradeSum.ProjectYear) LEFT JOIN qryTestReqTestSum ON qryProjectYearProject.ProjectYear = qryTestReqTestSum.ProjectYear) INNER JOIN qryAdditionalCosts ON qryProjectYearProject.ProjectYear = qryAdditionalCosts.ProjectYear
GROUP BY qryProjectYearProject.Disease, qryProjectYearProject.FinancialYear, qryProjectYearProject.Project, qryProjectYearProject.YearIncome, qryProjectYearProject.ProjectTitle, qryProjectYearProject.StartFYear, qryProjectYearProject.ContractPrice, qryProjectYearProject.PlanCat, qryProjectYearProject.ProjectWorkGroup, qryProjectYearProject.StartDate
HAVING ((qryProjectYearProject.Disease=[Forms]![FrmDisease]![SelectDisease]));

