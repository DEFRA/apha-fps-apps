QUERY NAME: Query2
---------------------------------------------
TYPE: SELECT

SQL:
SELECT tblStaffRequ.WGGrade, Query1.Expr1, WorkGroupGrade.WGGrade, tblPCGrades.ChargeRate, tblPCGrades.PayRate, tblPCGrades.NPR
FROM ((Query1 INNER JOIN tblStaffRequ ON Query1.WGGrade = tblStaffRequ.WGGrade) LEFT JOIN WorkGroupGrade ON Query1.Expr1 = WorkGroupGrade.WGGrade) LEFT JOIN tblPCGrades ON WorkGroupGrade.ProfitCentreGrade = tblPCGrades.PCGrade
WHERE (((tblStaffRequ.Year)>=2010))
GROUP BY tblStaffRequ.WGGrade, Query1.Expr1, WorkGroupGrade.WGGrade, tblPCGrades.ChargeRate, tblPCGrades.PayRate, tblPCGrades.NPR;

