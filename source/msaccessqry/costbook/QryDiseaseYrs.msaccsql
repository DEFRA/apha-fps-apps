QUERY NAME: QryDiseaseYrs
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW qryProjectYearProject_1.FinancialYear, qryProjectYearProject_1.Disease, qryProjectYearProject_1.Project, qryProjectYearProject_1.ProjectTitle, qryProjectYearProject_1.YearIncome, qryProjectYearProject_1.ExceptionalCost, Sum(qryAnimalTypeAnimalSum_1.AnimalCost) AS SumOfAnimalCost, Sum(qryTestReqTestSum.TestCost) AS SumOfTestCost, Sum(qryStaffReqGradeSum_1.StaffCost) AS SumOfStaffCost
FROM qryProjectYearProject, qryAnimalTypeAnimal, qryAnimalTypeAnimalSum, qryStaffReqGradeSum, qryAnimalTypeAnimalSum AS qryAnimalTypeAnimalSum_1 RIGHT JOIN (qryStaffReqGradeSum AS qryStaffReqGradeSum_1 RIGHT JOIN (qryTestReqTestSum RIGHT JOIN qryProjectYearProject AS qryProjectYearProject_1 ON qryTestReqTestSum.ProjectYear = qryProjectYearProject_1.ProjectYear) ON qryStaffReqGradeSum_1.ProjectYear = qryProjectYearProject_1.ProjectYear) ON qryAnimalTypeAnimalSum_1.ProjectYear = qryProjectYearProject_1.ProjectYear
GROUP BY qryProjectYearProject_1.FinancialYear, qryProjectYearProject_1.Disease, qryProjectYearProject_1.Project, qryProjectYearProject_1.ProjectTitle, qryProjectYearProject_1.YearIncome, qryProjectYearProject_1.ExceptionalCost
HAVING ((qryProjectYearProject_1.Disease=[Forms]![FrmDisease]![SelectDisease]));

