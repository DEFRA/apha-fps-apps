QUERY NAME: QryDiseaseFinYr
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW qryProjectYearProject.Project, qryProjectYearProject.ProjectTitle, qryProjectYearProject.YearIncome, Sum(qryStaffReqGradeSum.StaffCost) AS SumOfStaffCost, Sum(qryAnimalTypeAnimalSum.AnimalCost) AS SumOfAnimalCost, Sum(qryTestReqTestSum.TestCost) AS SumOfTestCost, Sum(qryAdditionalCosts.LineCost) AS SumOfLineCost
FROM (((qryProjectYearProject LEFT JOIN qryTestReqTestSum ON qryProjectYearProject.ProjectYear = qryTestReqTestSum.ProjectYear) LEFT JOIN qryStaffReqGradeSum ON qryProjectYearProject.ProjectYear = qryStaffReqGradeSum.ProjectYear) LEFT JOIN qryAnimalTypeAnimalSum ON qryProjectYearProject.ProjectYear = qryAnimalTypeAnimalSum.ProjectYear) INNER JOIN qryAdditionalCosts ON qryProjectYearProject.ProjectYear = qryAdditionalCosts.ProjectYear
WHERE ((qryProjectYearProject.FinancialYear=[Forms]![FrmDiseaseYear]![FinancialYr]) AND (qryProjectYearProject.Disease=[Forms]![FrmDiseaseYear]![DiseaseReq]))
GROUP BY qryProjectYearProject.Project, qryProjectYearProject.ProjectTitle, qryProjectYearProject.YearIncome;

