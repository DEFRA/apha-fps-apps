QUERY NAME: QryAnimalPerYear
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW qryProjectYearProject.FinancialYear, tblProject.Project, tblProject.ProjectTitle, tblAnimals.AnimalType, tblAnimalReq.[Number of Days], tblAnimalReq.[Number of Animals], [Number of Days]*[Number of Animals]*[DailyRate] AS [Total Cost], tblAnimals.DailyRate
FROM ((tblProject INNER JOIN tblProjectYear ON tblProject.Project = tblProjectYear.Project) INNER JOIN (tblAnimals INNER JOIN tblAnimalReq ON tblAnimals.AnimalType = tblAnimalReq.AnimalType) ON tblProjectYear.ProjectYear = tblAnimalReq.ProjectYear) INNER JOIN qryProjectYearProject ON tblProjectYear.ProjectYear = qryProjectYearProject.ProjectYear;

