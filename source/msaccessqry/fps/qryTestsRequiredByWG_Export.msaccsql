QUERY NAME: qryTestsRequiredByWG_Export
---------------------------------------------
TYPE: SELECT

SQL:
SELECT WorkGroup.ProfitCentre, WorkGroup.WorkGroup, qryTestsRequiredByWG.TestCode, qryTestsRequiredByWG.ItemDescription, qryTestsRequiredByWG.ProjectedTotal, qryTestsRequiredByWG.UnitPrice
FROM qryTestsRequiredByWG INNER JOIN WorkGroup ON qryTestsRequiredByWG.WG = WorkGroup.WorkGroup
WHERE (((WorkGroup.ProfitCentre) Like nz([Forms]![frmProgrammeSummary]![pickRC],"*")))
ORDER BY WorkGroup.ProfitCentre, WorkGroup.WorkGroup, qryTestsRequiredByWG.TestCode;

