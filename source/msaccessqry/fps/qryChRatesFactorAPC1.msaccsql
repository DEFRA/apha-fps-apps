QUERY NAME: qryChRatesFactorAPC1
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW WorkGroup_General.ProfitCentre, ProfitCentreGrade_General.PCGrade, Grade.AvSalary, Sum(PlanCatWGGrade.Hours) AS AllocHrs, [Grade].[AvSalary]*[AllocHrs] AS FactorA
FROM ((PlanCatWGGrade INNER JOIN WorkGroupGrade_General ON PlanCatWGGrade.WGGrade = WorkGroupGrade_General.WGGrade) INNER JOIN (Grade INNER JOIN ProfitCentreGrade_General ON Grade.GradeCode = ProfitCentreGrade_General.GradeCode) ON WorkGroupGrade_General.ProfitCentreGrade = ProfitCentreGrade_General.PCGrade) INNER JOIN WorkGroup_General ON WorkGroupGrade_General.WorkGroup = WorkGroup_General.WorkGroup
WHERE ((PlanCatWGGrade.PlanCategory Not Like "ZT*"))
GROUP BY WorkGroup_General.ProfitCentre, ProfitCentreGrade_General.PCGrade, Grade.AvSalary;

