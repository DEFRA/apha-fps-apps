QUERY NAME: qrySurvContractRpt
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tblContractMAP.Category, tblContractMAP.Manager, tblContractMAP.Customer, tlkpProject_MAP.Program, tlkpProject_MAP.Contract, tblContractMAP.Title, tlkpProject_MAP.ParentProject, tlkpProject_MAP.ShortTitle, tlkpProject_MAP.CustIncome, qrySurvPMF.SumOfTimeCosts, qrySurvPMF.SumOfTransferCosts, qrySurvPMF.SumOfSubcontracts, qrySurvPMF.SumOfTotalCost, qrySurvPMF.SumOfCWDebit, qrySurvPMF.SumOfCWCredit, IIf(IsNull([SumOfTotalFee]),0,[SumOfTotalFee]) AS PVSInc, qrySurvInvoice.CVOGIncome, [TotalCosts]*([Forms]![frmPactReportMenu]![PeriodPick])/12 AS YTDPlan, IIf(IsNull([CVOGIncome]),0,[CVOGIncome]) AS CVOGInc, qrySurvPMF.SumOfTotalHours, Sum(tblSurvFF_Submissions.CountOfJobName) AS totsubs, qrySurvCW_Cost.SumOfCost, ([sumofcost]+[sumoftransfercosts]-[sumofcwcredit])/[totsubs] AS CWCostPerSub, tlkpProject_MAP.PVSIncome, Left([tlkpProject_Map].[parentproject],5) AS IntGroup, IIf(Left([tlkpProject_Map].[projecttitle],3)='TDP','TDP','Int Trade') AS TDPGroup
FROM ((tblSurvFF_Submissions RIGHT JOIN (tblContractMAP INNER JOIN (((tlkpProject_MAP LEFT JOIN FPSYearTotals ON tlkpProject_MAP.ParentProject = FPSYearTotals.ParentProject) LEFT JOIN qrySurvInvoice ON tlkpProject_MAP.ParentProject = qrySurvInvoice.ProjectParent) LEFT JOIN qrySurvPMF ON tlkpProject_MAP.ParentProject = qrySurvPMF.Project) ON tblContractMAP.ContractNo = tlkpProject_MAP.Contract) ON tblSurvFF_Submissions.Contract = tlkpProject_MAP.ParentProject) LEFT JOIN qrySurvCW_Cost ON tlkpProject_MAP.ParentProject = qrySurvCW_Cost.Project) LEFT JOIN qrySurvFFFees ON tlkpProject_MAP.ParentProject = qrySurvFFFees.Contract
GROUP BY tblContractMAP.Category, tblContractMAP.Manager, tblContractMAP.Customer, tlkpProject_MAP.Program, tlkpProject_MAP.Contract, tblContractMAP.Title, tlkpProject_MAP.ParentProject, tlkpProject_MAP.ShortTitle, tlkpProject_MAP.CustIncome, qrySurvPMF.SumOfTimeCosts, qrySurvPMF.SumOfTransferCosts, qrySurvPMF.SumOfSubcontracts, qrySurvPMF.SumOfTotalCost, qrySurvPMF.SumOfCWDebit, qrySurvPMF.SumOfCWCredit, IIf(IsNull([SumOfTotalFee]),0,[SumOfTotalFee]), qrySurvInvoice.CVOGIncome, [TotalCosts]*([Forms]![frmPactReportMenu]![PeriodPick])/12, IIf(IsNull([CVOGIncome]),0,[CVOGIncome]), qrySurvPMF.SumOfTotalHours, qrySurvCW_Cost.SumOfCost, tlkpProject_MAP.PVSIncome, Left([tlkpProject_Map].[parentproject],5), IIf(Left([tlkpProject_Map].[projecttitle],3)='TDP','TDP','Int Trade')
HAVING (((tblContractMAP.Category)="surv"))
ORDER BY tlkpProject_MAP.ParentProject;

