QUERY NAME: qryTestSummaryByOracleCode
---------------------------------------------
TYPE: SELECT

SQL:
SELECT qryDeptIncomeTests.OracleProjectCode, qryDeptIncomeTests.Project AS [VLA Project], qryDeptIncomeTests.OCC, qryDeptIncomeTests.SubAccountCode, Sum(qryDeptIncomeTests.TotalCost) AS SumOfTotalCost
FROM qryDeptIncomeTests
GROUP BY qryDeptIncomeTests.OracleProjectCode, qryDeptIncomeTests.Project, qryDeptIncomeTests.OCC, qryDeptIncomeTests.SubAccountCode
ORDER BY qryDeptIncomeTests.OracleProjectCode;

