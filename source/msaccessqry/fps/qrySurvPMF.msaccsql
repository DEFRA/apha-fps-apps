QUERY NAME: qrySurvPMF
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW ProjectMonthFinalMAP.Project, Sum(ProjectMonthFinalMAP.TimeCosts) AS SumOfTimeCosts, Sum(ProjectMonthFinalMAP.TransferCosts) AS SumOfTransferCosts, Sum(ProjectMonthFinalMAP.Subcontracts) AS SumOfSubcontracts, Sum(ProjectMonthFinalMAP.TotalCost) AS SumOfTotalCost, Sum(ProjectMonthFinalMAP.CWDebit) AS SumOfCWDebit, Sum(ProjectMonthFinalMAP.CWCredit) AS SumOfCWCredit, Sum(ProjectMonthFinalMAP.TotalHours) AS SumOfTotalHours
FROM ProjectMonthFinalMAP
WHERE ((ProjectMonthFinalMAP.MonthNo<=[Forms]![frmPactReportMenu]![PeriodPick]))
GROUP BY ProjectMonthFinalMAP.Project;

