QUERY NAME: qrySurvProgramRptTDP
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject_MAP.Program, tlkpProject_MAP.Contract, tlkpProject_MAP.ParentProject, tlkpProject_MAP.ShortTitle, tlkpProject_MAP.CustIncome, qrySurvPMF.SumOfTimeCosts, qrySurvPMF.SumOfTransferCosts, qrySurvPMF.SumOfSubcontracts, qrySurvPMF.SumOfTotalCost, qrySurvPMF.SumOfCWDebit, qrySurvPMF.SumOfCWCredit, IIf(IsNull([SumOfTotalFee]),0,[SumOfTotalFee]) AS PVSInc, qrySurvInvoice.CVOGIncome, [TotalCosts]*([Forms]![frmPactReportMenu]![PeriodPick])/12 AS YTDPlan, IIf(IsNull([CVOGIncome]),0,[CVOGIncome]) AS CVOGInc, tlkpProgram_MAP.ProgramName, tlkpProgram_MAP.Manager, qrySurvPMF.SumOfTotalHours, tlkpProject_MAP.PVSIncome, IIf(([tlkpProject_Map].[ParentProject]) Like "*[a-z]",((Left(([tlkpProject_Map].[ParentProject]),4) & "0" & Mid(([tlkpProject_Map].[ParentProject]),5,1))),([tlkpProject_Map].[ParentProject])) AS IntGroup, IIf(([tlkpProject_Map].[ParentProject]='IT6007' Or [tlkpProject_Map].[ParentProject]='IT6008' Or [tlkpProject_Map].[ParentProject]='IT6009'),'TDP','Int Trade') AS TDPGroup
FROM ((((tlkpProject_MAP LEFT JOIN FPSYearTotals ON tlkpProject_MAP.ParentProject = FPSYearTotals.ParentProject) LEFT JOIN qrySurvInvoice ON tlkpProject_MAP.ParentProject = qrySurvInvoice.ProjectParent) INNER JOIN qrySurvPMF ON tlkpProject_MAP.ParentProject = qrySurvPMF.Project) INNER JOIN tlkpProgram_MAP ON tlkpProject_MAP.Program = tlkpProgram_MAP.ProgramNo) LEFT JOIN qrySurvFFFees ON tlkpProject_MAP.ParentProject = qrySurvFFFees.Contract
WHERE (((tlkpProject_MAP.ShortTitle) Like "TDP*"))
ORDER BY tlkpProject_MAP.ParentProject;

