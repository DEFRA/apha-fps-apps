QUERY NAME: ltdTestVolumes2
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpTestCapability.PlanPortfolio, tlkpProject_General.Program, tlkpTestReqmt.TestCode, ltdTestVolumes.SumOfNoRequired, IIf([sumofnorequired]=0 Or [vol]=0,0,[vol]/[sumofnorequired]) AS [%Fulfilled], Sum(MonthlyOutput.Volume) AS Vol, Sum([Volume]*[unitprice]) AS Fee, ltdTestVolumes.PlanFee
FROM ltdTestVolumes INNER JOIN (tlkpProject_General INNER JOIN ((MonthlyOutput INNER JOIN tlkpTestReqmt ON (MonthlyOutput.Buyer = tlkpTestReqmt.Buyer) AND (MonthlyOutput.TestCode = tlkpTestReqmt.TestCode)) INNER JOIN tlkpTestCapability ON (MonthlyOutput.WorkGroup = tlkpTestCapability.WorkGroup) AND (MonthlyOutput.TestCode = tlkpTestCapability.TestCode)) ON tlkpProject_General.ParentProject = tlkpTestReqmt.Buyer) ON (ltdTestVolumes.TestCode = tlkpTestReqmt.TestCode) AND (ltdTestVolumes.Program = tlkpProject_General.Program)
WHERE ((MonthlyOutput.Month<=[forms]![frmPactReportMenu]![periodpick]))
GROUP BY tlkpTestCapability.PlanPortfolio, tlkpProject_General.Program, tlkpTestReqmt.TestCode, ltdTestVolumes.SumOfNoRequired, ltdTestVolumes.PlanFee
ORDER BY tlkpProject_General.Program, tlkpTestReqmt.TestCode;

