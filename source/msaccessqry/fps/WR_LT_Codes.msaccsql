QUERY NAME: WR_LT_Codes
---------------------------------------------
TYPE: SELECT

SQL:
SELECT TimeCodeValid.ParentProject, TimeCodeValid.TimeCode, [JobCodeName] & [Itemdescription] AS Description
FROM (TimeCodeValid LEFT JOIN tlkpJobCode ON (TimeCodeValid.TimeCode = tlkpJobCode.JobCode) AND (TimeCodeValid.ParentProject = tlkpJobCode.ParentProject)) LEFT JOIN TestOrProduct ON TimeCodeValid.TimeCode = TestOrProduct.ItemCode
WHERE (((TimeCodeValid.WorkGroup) Like "LT??" Or (TimeCodeValid.WorkGroup)="Wildlife") AND ((TimeCodeValid.Active)=True))
GROUP BY TimeCodeValid.ParentProject, TimeCodeValid.TimeCode, [JobCodeName] & [Itemdescription]
ORDER BY TimeCodeValid.ParentProject, TimeCodeValid.TimeCode;

