QUERY NAME: qryVetWGUtil_Xtab
---------------------------------------------
TYPE: OTHER

SQL:
PARAMETERS Forms!frmPactReportMenu!PeriodPick IEEEDouble;
TRANSFORM Sum(qryVetWGUtil.TotalTime) AS [Time]
SELECT qryVetWGUtil.WorkGroup, ZT_Split([parentproject]) AS ZTSplit, qryVetWGUtil.Program, qryVetWGUtil.ParentProject, qryVetWGUtil.WGPlanHours, qryVetWGUtil.ShortTitle, qryVetWGUtil.JobCode, Sum(qryVetWGUtil.TotalTime) AS TotalTime
FROM qryVetWGUtil
WHERE (((qryVetWGUtil.WorkGroup)=retglobalvetwg()))
GROUP BY qryVetWGUtil.WorkGroup, ZT_Split([parentproject]), qryVetWGUtil.Program, qryVetWGUtil.ParentProject, qryVetWGUtil.WGPlanHours, qryVetWGUtil.ShortTitle, qryVetWGUtil.JobCode
PIVOT [Name] & "=" & [PRHrsPaid];

