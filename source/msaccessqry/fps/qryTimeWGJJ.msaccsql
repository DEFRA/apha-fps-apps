QUERY NAME: qryTimeWGJJ
---------------------------------------------
TYPE: SELECT

SQL:
SELECT tlkpProject.Program, WorkGroupGrade_General.WorkGroup, tlkpProject.ParentProject, tlkpProject.Customer, Sum(tblStaffJob.plannedhours) AS SumOfplannedhours, Sum([plannedhours]*[chargerate]) AS Cost
FROM (((tlkpProject INNER JOIN tblStaffJob ON tlkpProject.ParentProject = tblStaffJob.Jobcode) INNER JOIN tblWGEmployee_general ON tblStaffJob.StaffID = tblWGEmployee_general.PactID) INNER JOIN WorkGroupGrade_General ON tblWGEmployee_general.WorkGroupGrade = WorkGroupGrade_General.WGGrade) INNER JOIN ProfitCentreGrade_General ON WorkGroupGrade_General.ProfitCentreGrade = ProfitCentreGrade_General.PCGrade
GROUP BY tlkpProject.Program, WorkGroupGrade_General.WorkGroup, tlkpProject.ParentProject, tlkpProject.Customer
ORDER BY WorkGroupGrade_General.WorkGroup;

