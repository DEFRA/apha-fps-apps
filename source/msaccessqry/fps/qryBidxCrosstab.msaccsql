QUERY NAME: qryBidxCrosstab
---------------------------------------------
TYPE: OTHER

SQL:
PARAMETERS Forms![frmBudgetResourceLevel]![ProfitCentre] Text ( 255 );
TRANSFORM Sum(qryBid1.GenBid) AS [The Value]
SELECT tblkpAccountCategory.AccShortName, Sum(qryBid1.GenBid) AS [Row Summary]
FROM tblkpAccountCategory LEFT JOIN qryBid1 ON tblkpAccountCategory.AccShortName = qryBid1.AccShortName
WHERE (((tblkpAccountCategory.RCSpecific)=-1))
GROUP BY tblkpAccountCategory.AccShortName
PIVOT qryBid1.WorkGroup;

