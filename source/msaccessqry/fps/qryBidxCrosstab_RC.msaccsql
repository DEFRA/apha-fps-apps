QUERY NAME: qryBidxCrosstab_RC
---------------------------------------------
TYPE: OTHER

SQL:
PARAMETERS [Forms]![frmResourceManager]![RCpick] Text ( 255 );
TRANSFORM Sum(qryBid_RC.GenBid) AS [The Value]
SELECT tblkpAccountCategory.AccShortName, Sum(qryBid_RC.GenBid) AS [Row Summary]
FROM tblkpAccountCategory LEFT JOIN qryBid_RC ON tblkpAccountCategory.AccShortName = qryBid_RC.AccShortName
WHERE (((tblkpAccountCategory.RCSpecific)=-1))
GROUP BY tblkpAccountCategory.AccShortName
PIVOT qryBid_RC.WorkGroup;

