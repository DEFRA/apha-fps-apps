QUERY NAME: qryDefaultWG2
---------------------------------------------
TYPE: SELECT

SQL:
SELECT tlkpTestCapability.TestCode, Min(IIf([countofWorkgroup]=1,[Workgroup],fnWGPlan([workgroup]))) AS WG
FROM tlkpTestCapability INNER JOIN qryDefaultWG1 ON tlkpTestCapability.TestCode = qryDefaultWG1.TestCode
WHERE (((fnWGplanlevel([workgroup]))=[level]))
GROUP BY tlkpTestCapability.TestCode
ORDER BY tlkpTestCapability.TestCode;

