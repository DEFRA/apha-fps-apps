QUERY NAME: qryZTonly
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tblStaffJob_RM.StaffID, Sum(tblStaffJob_RM.plannedhours) AS SumOfplannedhours
FROM tlkpProject_General INNER JOIN tblStaffJob_RM ON tlkpProject_General.ParentProject = tblStaffJob_RM.Jobcode
WHERE ((tlkpProject_General.Program="ZT_Prog"))
GROUP BY tblStaffJob_RM.StaffID;

