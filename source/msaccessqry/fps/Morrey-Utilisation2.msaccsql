QUERY NAME: Morrey-Utilisation2
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Max([charge]/([charge]+[free])) AS Utilisation
SELECT WorkGroup.ProfitCentre, WorkGroup.WorkGroup, Sum([charge])/Sum(([charge]+[free])) AS Utilisation
FROM [Morrey-Utilisation1] INNER JOIN WorkGroup ON [Morrey-Utilisation1].WorkGroup = WorkGroup.WorkGroup
GROUP BY WorkGroup.ProfitCentre, WorkGroup.WorkGroup
PIVOT [Morrey-Utilisation1].GradeCode;

