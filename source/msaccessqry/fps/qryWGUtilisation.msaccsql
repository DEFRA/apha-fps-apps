QUERY NAME: qryWGUtilisation
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(tblStaffJob_RM.plannedhours) AS SumOfplannedhours
SELECT WorkGroupGrade_General.WorkGroup, tlkpProject_General.Program, tlkpProject_General.ParentProject, tlkpProject_General.ProjectStatus, First(tblStaff.HrsAvail) AS totalAvail, Sum(tblStaffJob_RM.plannedhours) AS Totals
FROM tlkpProject_General RIGHT JOIN ((WorkGroupGrade_General INNER JOIN tblStaff ON WorkGroupGrade_General.WGGrade = tblStaff.WorkGroupGrade) LEFT JOIN tblStaffJob_RM ON tblStaff.StaffID = tblStaffJob_RM.StaffID) ON tlkpProject_General.ParentProject = tblStaffJob_RM.Jobcode
WHERE (((WorkGroupGrade_General.WorkGroup)=RetGlobalWGVar()) AND ((tblStaff.Name) Like "*General"))
GROUP BY WorkGroupGrade_General.WorkGroup, tlkpProject_General.Program, tlkpProject_General.ParentProject, tlkpProject_General.ProjectStatus
PIVOT [tblStaff].[name] & "=" & Int([HrsAvail]);

