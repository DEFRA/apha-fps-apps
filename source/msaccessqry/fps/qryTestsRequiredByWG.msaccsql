QUERY NAME: qryTestsRequiredByWG
---------------------------------------------
TYPE: SELECT

SQL:
SELECT nz([qryLastYearsWGTests].[WorkGroup],DLookUp("Workgroup","qryWGTestCapability","Testcode='" & [qryTestsRequiredThisYear].[Testcode] & "'")) AS WG, qryTestsRequiredThisYear.TestCode, qryTestsRequiredThisYear.NoRequired, qryLastYearsTests.YearTotal, qryLastYearsWGTests.TestsByWG, IIf(IsNull([YearTotal]),[NoRequired],CLng(([Norequired]*[TestsByWG]/[YearTotal])+0.49)) AS ProjectedTotal, qryTestsRequiredThisYear.ItemDescription, IIf(IsNull([price]),[Unitpricevla],[price]) AS UnitPrice, qryTestsRequiredThisYear.UnitPriceVLA, qryTestsRequiredByWG_RCCost.Price
FROM ((qryTestsRequiredThisYear LEFT JOIN qryLastYearsTests ON qryTestsRequiredThisYear.TestCode = qryLastYearsTests.TestCode) LEFT JOIN qryLastYearsWGTests ON qryLastYearsTests.TestCode = qryLastYearsWGTests.TestCode) LEFT JOIN qryTestsRequiredByWG_RCCost ON (qryLastYearsWGTests.WorkGroup = qryTestsRequiredByWG_RCCost.WorkGroup) AND (qryLastYearsWGTests.TestCode = qryTestsRequiredByWG_RCCost.TestCode)
WHERE (((qryTestsRequiredThisYear.NoRequired)<>0))
ORDER BY nz([qryLastYearsWGTests].[WorkGroup],DLookUp("Workgroup","qryWGTestCapability","Testcode='" & [qryTestsRequiredThisYear].[Testcode] & "'")), qryTestsRequiredThisYear.TestCode;

