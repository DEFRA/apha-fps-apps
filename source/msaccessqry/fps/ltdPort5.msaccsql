QUERY NAME: ltdPort5
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(ltdPort3.RawUP) AS SumOfRawUP
SELECT ltdPort3.PlanPortfolio, ltdPort3.TestCode, ltdPort3.UnitFEC, Sum(ltdPort3.SumOfVolume) AS TotVol, Sum(ltdPort3.SumOfCost) AS TotCost, [TotCost]/[TotVol] AS RawUP
FROM ltdPort3
GROUP BY ltdPort3.PlanPortfolio, ltdPort3.TestCode, ltdPort3.UnitFEC
PIVOT ltdPort3.WorkGroup In ("ltab","ltbu","ltbr","ltca","ltla","ltlu","ltnc","ltpe","ltpr","ltsb","ltsh","ltst","ltth","ltwi");

