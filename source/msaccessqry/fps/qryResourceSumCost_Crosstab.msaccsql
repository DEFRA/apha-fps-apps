QUERY NAME: qryResourceSumCost_Crosstab
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(vProjectStaffPlan.Cost) AS SumOfCost
SELECT vProjectStaffPlan.ProgramNo AS Program, vProjectStaffPlan.ParentProject AS Jobcode, vProjectStaffPlan.ProfitCentre, Sum(vProjectStaffPlan.Cost) AS RowSummary
FROM vProjectStaffPlan
GROUP BY vProjectStaffPlan.ProgramNo, vProjectStaffPlan.ParentProject, vProjectStaffPlan.ChargeRate, vProjectStaffPlan.ProfitCentre
PIVOT vProjectStaffPlan.GradeCode In ("GD5","A","B","C","D","E","F","G");

