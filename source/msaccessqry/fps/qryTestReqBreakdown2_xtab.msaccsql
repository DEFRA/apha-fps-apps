QUERY NAME: qryTestReqBreakdown2_xtab
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum([NoReq]*[WGPrice]) AS Cost
SELECT qryTestReqBreakdown.TestCode, qryTestReqBreakdown.ShortDescription, Sum([NoReq]*[WGPrice]) AS TotalCost
FROM qryTestReqBreakdown LEFT JOIN WorkGroup_General ON qryTestReqBreakdown.WorkG = WorkGroup_General.WorkGroup
GROUP BY qryTestReqBreakdown.TestCode, qryTestReqBreakdown.ShortDescription
PIVOT IIf(IsNull([qryTestReqBreakdown].[ProfitCentre]),[Workgroup_General].[ProfitCentre],[qryTestReqBreakdown].[ProfitCentre]);

