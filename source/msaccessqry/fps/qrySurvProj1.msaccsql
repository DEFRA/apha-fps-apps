QUERY NAME: qrySurvProj1
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(qrySurvProjectSum.HoursCost) AS HoursCost
SELECT qrySurvProjectSum.Project AS ParentProject, qrySurvProjectSum.WorkGroup, Sum(qrySurvProjectSum.HoursCost) AS TotalTimeCost
FROM qrySurvProjectSum
WHERE ((qrySurvProjectSum.Month<=[Forms]![frmPactReportMenu]![PeriodPick] Or qrySurvProjectSum.Month Is Null) AND (qrySurvProjectSum.Type Is Null Or qrySurvProjectSum.Type<>"Primary Spread"))
GROUP BY qrySurvProjectSum.Project, qrySurvProjectSum.WorkGroup
PIVOT qrySurvProjectSum.Type In ('Consultancy','Database','Expertise','PlannedSurveill','ReferenceLab','Visits','Casework');

