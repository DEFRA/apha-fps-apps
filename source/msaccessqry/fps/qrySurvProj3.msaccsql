QUERY NAME: qrySurvProj3
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(TimeCostCalcs.Cost) AS HoursCost
SELECT qryTCC_Union_MO.Project, qryTCC_Union_MO.WorkGroup, Sum(TimeCostCalcs.Cost) AS TotalTimeCost
FROM qryTCC_Union_MO LEFT JOIN (tlkpJobCode RIGHT JOIN TimeCostCalcs ON (tlkpJobCode.ParentProject = TimeCostCalcs.Project) AND (tlkpJobCode.JobCode = TimeCostCalcs.JobCode)) ON (qryTCC_Union_MO.Project = TimeCostCalcs.Project) AND (qryTCC_Union_MO.Workgroup = TimeCostCalcs.WorkGroup)
WHERE ((qryTCC_Union_MO.Project="seb4100") AND (TimeCostCalcs.Month<=[Forms]![frmPactReportMenu]![PeriodPick] Or TimeCostCalcs.Month Is Null) AND (tlkpJobCode.Type Is Null Or tlkpJobCode.Type<>"Primary Spread"))
GROUP BY qryTCC_Union_MO.Project, qryTCC_Union_MO.WorkGroup
PIVOT tlkpJobCode.Type In ('Consultancy','Database','Expertise','PlannedSurveill','ReferenceLab','Visits','Casework');

