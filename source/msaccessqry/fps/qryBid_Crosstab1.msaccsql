QUERY NAME: qryBid_Crosstab1
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(tblBid.GenBid) AS [The Value]
SELECT tblkpProfitCentre_General.ProfitCentre, tblBid.WorkGroup, Sum(tblBid.GenBid) AS [Row Summary]
FROM tblkpProfitCentre_General INNER JOIN (tblBid INNER JOIN WorkGroup_General ON tblBid.WorkGroup = WorkGroup_General.WorkGroup) ON tblkpProfitCentre_General.ProfitCentre = WorkGroup_General.ProfitCentre
GROUP BY tblkpProfitCentre_General.ProfitCentre, tblBid.WorkGroup
PIVOT tblBid.Account In ("BuildMaint","Consult","ExhibMktg","Fuels","Furniture","Hosp","MaintCon","MeatRes","Media","NocSe","Office","OtherDel","OtherStaff","Pay","Post","PubVis","PurcSupp","Rent","StafTrn","Stat","SubCon","Telecom","TrvSub","VehMaint");

