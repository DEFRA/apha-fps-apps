QUERY NAME: UMa2
---------------------------------------------
TYPE: SELECT

SQL:
SELECT qryJobCodeTotalsNew.Programme, qryJobCodeTotalsNew.JobCode AS project, Sum(TotalTests_Project.SumOfNoRequired) AS [No Tests], Sum(TotalTests_Project.Cost) AS Cost, TotalTests_Project.TestCode
FROM qryJobCodeTotalsNew LEFT JOIN TotalTests_Project ON qryJobCodeTotalsNew.JobCode = TotalTests_Project.Buyer
GROUP BY qryJobCodeTotalsNew.Programme, qryJobCodeTotalsNew.JobCode, TotalTests_Project.TestCode
HAVING (((qryJobCodeTotalsNew.Programme) Like "tse*"))
ORDER BY qryJobCodeTotalsNew.JobCode;

