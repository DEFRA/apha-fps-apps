QUERY NAME: ltdPort6
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject_MAP.Program, TimeCodeValid.ParentProject, TimeCodeValid.WorkGroup
FROM TimeCodeValid INNER JOIN tlkpProject_MAP ON TimeCodeValid.ParentProject = tlkpProject_MAP.ParentProject
GROUP BY tlkpProject_MAP.Program, TimeCodeValid.ParentProject, TimeCodeValid.WorkGroup
HAVING ((tlkpProject_MAP.Program="test_port"));

