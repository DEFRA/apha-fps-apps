QUERY NAME: Morrey-Utilisation1
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(TimeCostCalcs.Time) AS SumOfTime
SELECT TimeCostCalcs.WorkGroup, TimeCostCalcs.GradeCode, tblStaff.StaffID, tblStaff.HrsPaid
FROM TimeCostCalcs INNER JOIN tblStaff ON TimeCostCalcs.StaffID = tblStaff.StaffID
WHERE (((TimeCostCalcs.Month) In (1,2,3,4,5)))
GROUP BY TimeCostCalcs.WorkGroup, TimeCostCalcs.GradeCode, tblStaff.StaffID, tblStaff.HrsPaid
PIVOT IIf([project]="ZTleave","Leave",[Class]) In ("Charge","leave","free");

