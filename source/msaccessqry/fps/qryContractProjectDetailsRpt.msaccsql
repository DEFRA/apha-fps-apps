QUERY NAME: qryContractProjectDetailsRpt
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW qryJobCodeCust.Contract, qryJobCodeCust.JobCode, (IIf(IsNull([TotalAdditionalCosts]),0,[TotalAdditionalCosts]))*[MONTH]/12 AS JCTotalAdditionalCosts, IIf(IsNull([TotalAnimalCosts]),0,[TotalAnimalCosts])*[month]/12 AS JCTotalAnimalCosts, IIf(IsNull([TotalStaffCosts]),0,[TotalStaffCosts])*[MONTH]/12 AS JCTotalStaffCosts, IIf(IsNull([TotalTestCosts]),0,[TotalTestCosts])*[month]/12 AS JCTotalTestCosts, [JCTotalAnimalCosts]+[JCTotalAdditionalCosts]+[JCTotalStaffCosts]+[JCTotalTestCosts] AS JCTotalCosts, ([budget_cvl]-[jcTotalCosts])*[month]/12 AS JCProfit, ([budget_cvl])*[month]/12 AS JCBudget, qryPMFinalRpt.Animals, qryPMFinalRpt.Other, qryPMFinalRpt.Staff, qryPMFinalRpt.Tests, qryPMFinalRpt.TotalCost, [Forms]![frmContractMenu]![PeriodPick] AS [Month], [JCBudget]-[TotalCost] AS ActProfit, qryJobCodeCust.Disease, qryJobCodeCust.JobCode.Customer AS Cust, qryJobCodeCust.Budget_CVL
FROM ((((qryJobCodeCust LEFT JOIN qryTotalAdditionalCosts ON qryJobCodeCust.JobCode = qryTotalAdditionalCosts.JobCode) LEFT JOIN qryTotalAnimalCosts ON qryJobCodeCust.JobCode = qryTotalAnimalCosts.JobCode) LEFT JOIN qryTotalStaffCosts ON qryJobCodeCust.JobCode = qryTotalStaffCosts.Jobcode) LEFT JOIN qryTotalTestCosts ON qryJobCodeCust.JobCode = qryTotalTestCosts.JobCode) LEFT JOIN qryPMFinalRpt ON qryJobCodeCust.JobCode = qryPMFinalRpt.Project;

