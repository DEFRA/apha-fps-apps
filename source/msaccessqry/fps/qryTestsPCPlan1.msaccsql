QUERY NAME: qryTestsPCPlan1
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW TestOrProduct.Owner, tlkpProgram_MAP.ProgramNo, tlkpTestReqmt_MAP.TestCode, tlkpTestReqmt_MAP.UnitPrice, tlkpTestReqmt_MAP.PlannedWG, WorkGroup_General.ProfitCentre, Sum(tlkpTestReqmt_MAP.NoRequired) AS PlanTests
FROM WorkGroup_General RIGHT JOIN ((TestOrProduct INNER JOIN tlkpTestReqmt_MAP ON TestOrProduct.ItemCode = tlkpTestReqmt_MAP.TestCode) INNER JOIN (tlkpProject_general INNER JOIN tlkpProgram_MAP ON tlkpProject_general.Program = tlkpProgram_MAP.ProgramNo) ON tlkpTestReqmt_MAP.Buyer = tlkpProject_general.ParentProject) ON WorkGroup_General.WorkGroup = tlkpTestReqmt_MAP.PlannedWG
WHERE (((tlkpTestReqmt_MAP.NoRequired)<>0))
GROUP BY TestOrProduct.Owner, tlkpProgram_MAP.ProgramNo, tlkpTestReqmt_MAP.TestCode, tlkpTestReqmt_MAP.UnitPrice, tlkpTestReqmt_MAP.PlannedWG, WorkGroup_General.ProfitCentre
ORDER BY tlkpProgram_MAP.ProgramNo;

