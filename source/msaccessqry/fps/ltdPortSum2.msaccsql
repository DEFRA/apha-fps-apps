QUERY NAME: ltdPortSum2
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject_General.Program, tlkpProject_General.ParentProject, ltdPortSum1.SumOfCost AS TotalCost, Sum(ltdPort2.Fee) AS TotalFee, [TotalFee]-[TotalCost] AS Profit
FROM (ltdPort2 RIGHT JOIN tlkpProject_General ON ltdPort2.ParentProject = tlkpProject_General.ParentProject) LEFT JOIN ltdPortSum1 ON tlkpProject_General.ParentProject = ltdPortSum1.Project
GROUP BY tlkpProject_General.Program, tlkpProject_General.ParentProject, ltdPortSum1.SumOfCost
HAVING ((tlkpProject_General.Program="test_port"));

