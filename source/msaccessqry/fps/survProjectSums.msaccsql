QUERY NAME: survProjectSums
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW ProjectMonthFinalMAP.Project, Sum(ProjectMonthFinalMAP.Subcontracts) AS SumOfSubcontracts, Sum(ProjectMonthFinalMAP.Animals) AS SumOfAnimals, Sum(ProjectMonthFinalMAP.NonAnimals) AS SumOfNonAnimals, Sum(ProjectMonthFinalMAP.TimeCosts) AS SumOfTimeCosts, Sum(ProjectMonthFinalMAP.TransferCosts) AS SumOfTransferCosts, Sum(ProjectMonthFinalMAP.TotalCost) AS SumOfTotalCost, Sum(ProjectMonthFinalMAP.Invoices) AS SumOfInvoices, Sum(ProjectMonthFinalMAP.CWDebit) AS SumOfCWDebit, Sum(ProjectMonthFinalMAP.CWCredit) AS SumOfCWCredit, Max(ProjectMonthFinalMAP.MonthNo) AS MaxOfMonthNo
FROM ProjectMonthFinalMAP
WHERE ((ProjectMonthFinalMAP.CumFlag=1))
GROUP BY ProjectMonthFinalMAP.Project;

