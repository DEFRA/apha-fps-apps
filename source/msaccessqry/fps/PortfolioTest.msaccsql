QUERY NAME: PortfolioTest
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW WorkGroup_General.ProfitCentre, tlkpProject_General.Program, tlkpTestCapability.PlanPortfolio, tlkpTestCapability.TestCode, tlkpTestCapability.WorkGroup
FROM (tlkpProject_General INNER JOIN tlkpTestCapability ON tlkpProject_General.ParentProject = tlkpTestCapability.PlanPortfolio) INNER JOIN WorkGroup_General ON tlkpTestCapability.WorkGroup = WorkGroup_General.WorkGroup
GROUP BY WorkGroup_General.ProfitCentre, tlkpProject_General.Program, tlkpTestCapability.PlanPortfolio, tlkpTestCapability.TestCode, tlkpTestCapability.WorkGroup
HAVING ((WorkGroup_General.ProfitCentre="labt") AND (tlkpProject_General.Program="Test_Port"));

