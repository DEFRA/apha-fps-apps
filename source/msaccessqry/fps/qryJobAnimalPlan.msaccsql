QUERY NAME: qryJobAnimalPlan
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tblAnimalReq.JobCode, tblAnimalReq.AnimalType, tblAnimalReq.NumberOfDays, tblAnimalReq.NumberOfAnimals, [numberofdays]*[numberofanimals] AS CalcDays, IIf([isdefraproject]=0,[tblAnimals].[DailyRate],[defradailyrate]) AS DailyRate, [NumberOfDays]*[NumberOfAnimals]*IIf([isdefraproject]=0,[tblAnimals].[DailyRate],[defradailyrate]) AS Fee, tblAnimalReq.IndCounter
FROM JobCode INNER JOIN (tblAnimals INNER JOIN tblAnimalReq ON tblAnimals.AnimalType = tblAnimalReq.AnimalType) ON JobCode.JobCode = tblAnimalReq.JobCode;

