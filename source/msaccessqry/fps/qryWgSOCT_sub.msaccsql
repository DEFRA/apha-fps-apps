QUERY NAME: qryWgSOCT_sub
---------------------------------------------
TYPE: SELECT

SQL:
PARAMETERS Forms!frmResouceCentreWorkGroups!ProjectPick Text ( 255 );
SELECT DISTINCTROW vProjectStaffPlan.ProgramNo AS Program, vProjectStaffPlan.ParentProject, tlkpProject_General.ProjectStatus, vProjectStaffPlan.StaffID, Sum(vProjectStaffPlan.Cost) AS Totals
FROM tlkpProject_General INNER JOIN vProjectStaffPlan ON tlkpProject_General.ParentProject = vProjectStaffPlan.ParentProject
GROUP BY vProjectStaffPlan.ProgramNo, vProjectStaffPlan.ParentProject, tlkpProject_General.ProjectStatus, vProjectStaffPlan.StaffID;

