QUERY NAME: qryDeptIncomeTotals_sub
---------------------------------------------
TYPE: OTHER

SQL:
SELECT Project, OracleProjectCode, TotalCost, "Time" AS Area
FROM qryDeptIncomeTime
union all

SELECT Project, OracleProjectCode, TotalCost, "Tests" AS Area
FROM qryDeptIncomeTests
union all

SELECT Project, OracleProjectCode, TotalCost, "Animals" AS Area
FROM qryDeptIncomeAnimals
UNION ALL SELECT Project, OracleProjectCode, TotalCost, "Project-specifics" AS Area
FROM qryDeptIncomeExceptional;

