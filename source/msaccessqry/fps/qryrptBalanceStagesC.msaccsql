QUERY NAME: qryrptBalanceStagesC
---------------------------------------------
TYPE: OTHER

SQL:
SELECT DISTINCTROW qryrptBalanceStagesA.[WGGrade], qryrptBalanceStagesA.PlanningCategory
FROM qryrptBalanceStagesA

UNION SELECT DISTINCTROW qryrptBalanceStagesB.[WGGrade], qryrptBalanceStagesB.PlanCategory
FROM qryrptBalanceStagesB;

