QUERY NAME: ltdPort4
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW TimeCostCalcs.Project, TimeCostCalcs.WorkGroup, TimeCostCalcs.JobCode, Sum(TimeCostCalcs.Cost) AS SumOfCost, tlkpJobCode.Type
FROM (tlkpProject INNER JOIN TimeCostCalcs ON tlkpProject.ParentProject = TimeCostCalcs.Project) INNER JOIN tlkpJobCode ON TimeCostCalcs.JobCode = tlkpJobCode.JobCode
WHERE ((TimeCostCalcs.Month<=[forms]![frmLTD-ReportsMenu]![periodPick]))
GROUP BY TimeCostCalcs.Project, TimeCostCalcs.WorkGroup, TimeCostCalcs.JobCode, tlkpJobCode.Type;

