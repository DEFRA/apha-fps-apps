QUERY NAME: qryTestsPCPlan_xtab
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum([NoRequired]*[unitprice]) AS PlanTests
SELECT tlkpTestReqmt_MAP.TestCode, Sum([NoRequired]*[unitprice]) AS Total
FROM (qryDefaultWG2 INNER JOIN ((TestOrProduct INNER JOIN tlkpTestReqmt_MAP ON TestOrProduct.ItemCode = tlkpTestReqmt_MAP.TestCode) INNER JOIN (tlkpProject_general INNER JOIN tlkpProgram_MAP ON tlkpProject_general.Program = tlkpProgram_MAP.ProgramNo) ON tlkpTestReqmt_MAP.Buyer = tlkpProject_general.ParentProject) ON qryDefaultWG2.TestCode = TestOrProduct.ItemCode) INNER JOIN WorkGroup_General ON qryDefaultWG2.WG = WorkGroup_General.WorkGroup
GROUP BY TestOrProduct.Owner, tlkpTestReqmt_MAP.TestCode
ORDER BY tlkpTestReqmt_MAP.TestCode, tlkpProgram_MAP.ProgramNo
PIVOT tlkpProgram_MAP.ProgramNo;

