QUERY NAME: qryProgramSummary
---------------------------------------------
TYPE: SELECT

SQL:
SELECT FPSYearTotals.Program, ProjectMonthFinalMAP.Project, FPSYearTotals.Manager, tlkpProject_MAP.ProjectTitle, ProjectMonthFinalMAP.MonthNo, ProjectMonthFinalMAP.PeriodName, ProjectMonthFinalMAP.CumCost, FPSYearTotals.TotalCosts, qryTestReqVActual.TestCode, qryTestReqVActual.ItemDescription, qryTestReqVActual.NoTests, qryTestReqVActual.SumOfVolume, tlkpProject_MAP.Contract
FROM ((ProjectMonthFinalMAP INNER JOIN FPSYearTotals ON ProjectMonthFinalMAP.Project = FPSYearTotals.ParentProject) INNER JOIN tlkpProject_MAP ON ProjectMonthFinalMAP.Project = tlkpProject_MAP.ParentProject) LEFT JOIN qryTestReqVActual ON tlkpProject_MAP.ParentProject = qryTestReqVActual.JobCode
WHERE (((FPSYearTotals.Program) Like nz([Forms]![frmProgrammeSummary]![pickProgram],"*")) AND ((ProjectMonthFinalMAP.MonthNo)=[Forms]![frmProgrammeSummary]![PeriodPick]) AND ((tlkpProject_MAP.Contract) Like nz([Forms]![frmProgrammeSummary]![pickContract],"*")))
ORDER BY FPSYearTotals.Program, ProjectMonthFinalMAP.Project;

