QUERY NAME: ltdPort1
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject.Program, tlkpProject.ParentProject, TimeCostCalcs.WorkGroup, TimeCostCalcs.JobCode, Sum(TimeCostCalcs.Cost) AS SumOfCost
FROM tlkpProject INNER JOIN TimeCostCalcs ON tlkpProject.ParentProject = TimeCostCalcs.Project
WHERE ((TimeCostCalcs.Month<=[forms]![frmLTD-ReportsMenu]![PeriodPick]))
GROUP BY tlkpProject.Program, tlkpProject.ParentProject, TimeCostCalcs.WorkGroup, TimeCostCalcs.JobCode
HAVING ((tlkpProject.Program="test_port"));

