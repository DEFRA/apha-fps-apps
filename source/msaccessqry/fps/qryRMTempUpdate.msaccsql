QUERY NAME: qryRMTempUpdate
---------------------------------------------
TYPE: APPEND

SQL:
INSERT INTO tblTempStaffJob ( StaffID, JobCode, PlannedHours )
SELECT tblStaffJob_RM.StaffID, tblStaffJob_RM.Jobcode, tblStaffJob_RM.plannedhours
FROM tblStaffJob_RM INNER JOIN tblWGEmployee_general ON tblStaffJob_RM.StaffID = tblWGEmployee_general.PactID
WHERE (((tblStaffJob_RM.Jobcode)=[forms]![frmRM_Replan]![pickproject]) AND ((tblWGEmployee_general.WorkGroupGrade)=[forms]![frmRM_Replan]![pickWGGrade]));

