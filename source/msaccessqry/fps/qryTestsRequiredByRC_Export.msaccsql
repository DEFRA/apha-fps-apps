QUERY NAME: qryTestsRequiredByRC_Export
---------------------------------------------
TYPE: SELECT

SQL:
SELECT WorkGroup.ProfitCentre, qryTestsRequiredByWG.TestCode, qryTestsRequiredByWG.ItemDescription, Sum(qryTestsRequiredByWG.ProjectedTotal) AS ProjectedTotal, qryTestsRequiredByWG.UnitPrice
FROM qryTestsRequiredByWG INNER JOIN WorkGroup ON qryTestsRequiredByWG.WG = WorkGroup.WorkGroup
GROUP BY WorkGroup.ProfitCentre, qryTestsRequiredByWG.TestCode, qryTestsRequiredByWG.ItemDescription, qryTestsRequiredByWG.UnitPrice
HAVING (((WorkGroup.ProfitCentre) Like nz([Forms]![frmProgrammeSummary]![pickRC],"*")))
ORDER BY WorkGroup.ProfitCentre, qryTestsRequiredByWG.TestCode;

