QUERY NAME: qryVetHoursAct_RClevel
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW WorkGroup_General.ProfitCentre, TimeCostCalcsMAP.Project AS ParentProject, Sum(TimeCostCalcsMAP.Time) AS SumOfHours
FROM TimeCostCalcsMAP INNER JOIN WorkGroup_General ON TimeCostCalcsMAP.WorkGroup = WorkGroup_General.WorkGroup
WHERE ((TimeCostCalcsMAP.Month<=[Forms]![frmPactReportMenu]![PeriodPick]))
GROUP BY WorkGroup_General.ProfitCentre, TimeCostCalcsMAP.Project
HAVING ((WorkGroup_General.ProfitCentre="vetr"));

