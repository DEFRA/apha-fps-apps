QUERY NAME: IgProgramTotals
---------------------------------------------
TYPE: MAKE TABLE

SQL:
SELECT DISTINCTROW tlkpProgram.Directorate, tlkpProgram.ProgramNo, Sum(qryJobCodeTotals.JCTotalAdditionalCosts) AS SumOfJCTotalAdditionalCosts, Sum(qryJobCodeTotals.JCTotalAnimalCosts) AS SumOfJCTotalAnimalCosts, Sum(qryJobCodeTotals.JCTotalStaffCosts) AS SumOfJCTotalStaffCosts, Sum(qryJobCodeTotals.JCTotalTestCosts) AS SumOfJCTotalTestCosts, Sum(qryJobCodeTotals.TotalCosts) AS SumOfTotalCosts, Sum(qryJobCodeTotals.JCProfit) AS PlannedCont, Sum(qryJobCodeTotals.Profit) AS TargetCont, Sum(qryJobCodeTotals.Income) AS SumOfIncome, ([PlannedCont]-[TargetCont]) AS Variance, Sum(qryJobCodeTotals.TransferIncome) AS SumOfTransferIncome INTO ProgramTotals IN 'C:\pactsql\Pact99.mdb'
FROM qryJobCodeTotals INNER JOIN tlkpProgram ON qryJobCodeTotals.Program = tlkpProgram.ProgramNo
GROUP BY tlkpProgram.Directorate, tlkpProgram.ProgramNo
HAVING ((tlkpProgram.ProgramNo Not Like ("ZT*")))
ORDER BY tlkpProgram.ProgramNo;

