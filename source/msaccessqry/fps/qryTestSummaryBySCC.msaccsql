QUERY NAME: qryTestSummaryBySCC
---------------------------------------------
TYPE: SELECT

SQL:
SELECT qryDeptIncomeTests.SCC, qryDeptIncomeTests.SubAccountCode, Sum(qryDeptIncomeTests.TotalCost) AS SumOfTotalCost
FROM qryDeptIncomeTests
GROUP BY qryDeptIncomeTests.SCC, qryDeptIncomeTests.SubAccountCode
ORDER BY qryDeptIncomeTests.SCC;

