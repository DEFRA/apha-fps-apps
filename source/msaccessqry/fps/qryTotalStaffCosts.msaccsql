QUERY NAME: qryTotalStaffCosts
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW vProjectStaffPlan.ParentProject AS Jobcode, Sum(vProjectStaffPlan.Cost) AS TotalStaffCosts
FROM tlkpProgram_MAP INNER JOIN vProjectStaffPlan ON tlkpProgram_MAP.ProgramNo = vProjectStaffPlan.ProgramNo
WHERE (((tlkpProgram_MAP.SECTOR_NAME)="Charge"))
GROUP BY vProjectStaffPlan.ParentProject;

