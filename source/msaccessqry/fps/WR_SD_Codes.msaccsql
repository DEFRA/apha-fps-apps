QUERY NAME: WR_SD_Codes
---------------------------------------------
TYPE: SELECT

SQL:
SELECT tlkpJobCode.ParentProject, tlkpJobCode.JobCode, tlkpJobCode.JobCodeName
FROM (TimeCodeValid INNER JOIN tlkpJobCode ON (TimeCodeValid.TimeCode = tlkpJobCode.JobCode) AND (TimeCodeValid.ParentProject = tlkpJobCode.ParentProject)) INNER JOIN (WorkGroup_MAP INNER JOIN tblkpProfitCentre_MAP ON WorkGroup_MAP.ProfitCentre = tblkpProfitCentre_MAP.ProfitCentre) ON TimeCodeValid.WorkGroup = WorkGroup_MAP.WorkGroup
WHERE (((TimeCodeValid.WorkGroup) Like "SV??" Or (TimeCodeValid.WorkGroup)="Wildlife") AND ((TimeCodeValid.Active)=True)) OR (((TimeCodeValid.Active)=True) AND ((tblkpProfitCentre_MAP.Division)="INSP")) OR (((TimeCodeValid.Active)=True) AND ((WorkGroup_MAP.ProfitCentre)="Path"))
GROUP BY tlkpJobCode.ParentProject, tlkpJobCode.JobCode, tlkpJobCode.JobCodeName
ORDER BY tlkpJobCode.ParentProject;

