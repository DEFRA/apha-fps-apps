QUERY NAME: SnapshotTests
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW "Plan - " & Date() AS Version, tlkpProgram_MAP.Directorate, tlkpProject_MAP.Customer, tlkpProject_MAP.Program, tlkpProject_MAP.Contract, tlkpProject_MAP.ParentProject AS Project, tlkpProject_MAP.ProjectStatus AS Status, tblTestRequ.TestCode, tblTestRequ.TestPrice AS UnitPrice, tblTestRequ.NoTests, [Notests]*[testPrice] AS TestFee, TestOrProduct.Owner
FROM TestOrProduct INNER JOIN ((tlkpProject_MAP INNER JOIN tblTestRequ ON tlkpProject_MAP.ParentProject = tblTestRequ.JobCode) INNER JOIN tlkpProgram_MAP ON tlkpProject_MAP.Program = tlkpProgram_MAP.ProgramNo) ON TestOrProduct.ItemCode = tblTestRequ.TestCode
WHERE (((tblTestRequ.NoTests)<>0))
ORDER BY tlkpProgram_MAP.Directorate, tlkpProject_MAP.Program, tlkpProject_MAP.ParentProject;

