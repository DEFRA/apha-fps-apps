QUERY NAME: qryAnimalSummaryBySCC
---------------------------------------------
TYPE: SELECT

SQL:
SELECT 35227 AS SCC, tlkpProject_MAP.SubAccountCode, Sum(Proj_SubContract.Amount) AS TotalCost
FROM (CostCentre RIGHT JOIN tlkpProject_MAP ON CostCentre.CostCentre = tlkpProject_MAP.CostCentre) INNER JOIN Proj_SubContract ON tlkpProject_MAP.ParentProject = Proj_SubContract.Project
WHERE (((Proj_SubContract.Month) Between fnDeptIncomeMonthFrom() And fnDeptIncomeMonthTo()) AND ((tlkpProject_MAP.ParentProject) Like nz([Forms]![frmDeptIncome]![pickProject],"*")) AND ((Proj_SubContract.AcctCode) In ("LargeAnimals","SmallAnimals","Mice")))
GROUP BY tlkpProject_MAP.SubAccountCode;

