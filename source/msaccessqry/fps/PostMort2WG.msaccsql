QUERY NAME: PostMort2WG
---------------------------------------------
TYPE: SELECT

SQL:
SELECT Right([workgroup_General].[WorkGroup],2) AS location1, IIf([location1]="A5","LA",[Location1]) AS Location, TimeCostCalcsMAP.Project, TimeCostCalcsMAP.JobCode, Sum(TimeCostCalcsMAP.Cost) AS SumOfCost, IIf([ProfitCentre] In ("Path","vetr"),"Surveillance/Pathology","Laboratory Testing") AS ResourceCentre
FROM TimeCostCalcsMAP INNER JOIN WorkGroup_General ON TimeCostCalcsMAP.WorkGroup = WorkGroup_General.WorkGroup
WHERE (((TimeCostCalcsMAP.Month)<=[Forms]![frmPactReportMenu]![PeriodPick]))
GROUP BY Right([workgroup_General].[WorkGroup],2), TimeCostCalcsMAP.Project, TimeCostCalcsMAP.JobCode, IIf([ProfitCentre] In ("Path","vetr"),"Surveillance/Pathology","Laboratory Testing")
HAVING (((TimeCostCalcsMAP.Project)="tg0100") AND ((IIf([ProfitCentre] In ("Path","vetr"),"Surveillance/Pathology","Laboratory Testing"))="Laboratory Testing"));

