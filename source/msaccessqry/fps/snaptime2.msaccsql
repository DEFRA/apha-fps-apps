QUERY NAME: snaptime2
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(SnapshotTime_Union.HoursCost) AS SumOfHoursCost
SELECT SnapshotTime_Union.Directorate, SnapshotTime_Union.Program, SnapshotTime_Union.Customer, SnapshotTime_Union.Contract, SnapshotTime_Union.Project, SnapshotTime_Union.Status, SnapshotTime_Union.ResourceCentre, SnapshotTime_Union.WorkGroup, SnapshotTime_Union.GradeCode, SnapshotTime_Union.Name
FROM SnapshotTime_Union
GROUP BY SnapshotTime_Union.Directorate, SnapshotTime_Union.Program, SnapshotTime_Union.Customer, SnapshotTime_Union.Contract, SnapshotTime_Union.Project, SnapshotTime_Union.Status, SnapshotTime_Union.ResourceCentre, SnapshotTime_Union.WorkGroup, SnapshotTime_Union.GradeCode, SnapshotTime_Union.Name
PIVOT SnapshotTime_Union.Version;

