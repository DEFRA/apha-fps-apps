QUERY NAME: Snapshot Time-ActualBBaggs
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject_MAP.Program, tlkpProject_MAP.ParentProject AS Project, MonthlyTime.TimeCode, ProfitCentreGrade_General.ProfitCentre AS ResourceCentre, WorkGroupGrade_General.WorkGroup, ProfitCentreGrade_General.ChargeRate, WorkGroupGrade_General.GradeCode, tblStaff_General.Name, Sum(MonthlyTime.Hours) AS Hours, IIf([Program] In ("ZT_prog","ZT_leave","Pend_work"),0,[hours]*[chargerate]) AS HoursCost, MonthlyTime.Month
FROM (tblStaff_General INNER JOIN (WorkGroupGrade_General INNER JOIN ProfitCentreGrade_General ON WorkGroupGrade_General.ProfitCentreGrade = ProfitCentreGrade_General.PCGrade) ON tblStaff_General.WorkGroupGrade = WorkGroupGrade_General.WGGrade) INNER JOIN ((tlkpProgram_MAP INNER JOIN tlkpProject_MAP ON tlkpProgram_MAP.ProgramNo = tlkpProject_MAP.Program) INNER JOIN MonthlyTime ON tlkpProject_MAP.ParentProject = MonthlyTime.ParentProject) ON tblStaff_General.StaffID = MonthlyTime.PACTStaffID
GROUP BY tlkpProject_MAP.Program, tlkpProject_MAP.ParentProject, MonthlyTime.TimeCode, ProfitCentreGrade_General.ProfitCentre, WorkGroupGrade_General.WorkGroup, ProfitCentreGrade_General.ChargeRate, WorkGroupGrade_General.GradeCode, tblStaff_General.Name, MonthlyTime.Month
HAVING (((tlkpProject_MAP.Program) Not Like "ZT*") AND ((ProfitCentreGrade_General.ProfitCentre)="LabT")) OR (((tlkpProject_MAP.Program)="Test_port" Or (tlkpProject_MAP.Program)="IT_Surv"));

