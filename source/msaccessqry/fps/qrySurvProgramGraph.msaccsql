QUERY NAME: qrySurvProgramGraph
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject_MAP.Program, ProjectMonthFinal.MonthNo, tblkpMonth.MonthName, Sum(tlkpProject_MAP.Budget_CVL) AS Budget, Sum(([CumCost]+IIf(IsNull([CumCWDebit]),0,[CumCWDebit]))) AS Cost, IIf([monthNo]<=[Forms]![frmPactReportMenu]![PeriodPick],(Sum([Invoices]+IIf(IsNull([CumCWCredit]),0,[CumCWCredit]))),Null) AS Income
FROM (ProjectMonthFinal INNER JOIN tlkpProject_MAP ON ProjectMonthFinal.Project = tlkpProject_MAP.ParentProject) INNER JOIN tblkpMonth ON ProjectMonthFinal.MonthNo = tblkpMonth.MonthNumber
GROUP BY tlkpProject_MAP.Program, ProjectMonthFinal.MonthNo, tblkpMonth.MonthName;

