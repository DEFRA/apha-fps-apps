QUERY NAME: qryPostMort_VRD_Split2
---------------------------------------------
TYPE: SELECT

SQL:
SELECT qryPostMort_VRD_Split.Location, qryPostMort_VRD_Split.Month, Sum(qryPostMort_VRD_Split.LTSplitFee) AS LabLTSplitFee
FROM qryPostMort_VRD_Split
GROUP BY qryPostMort_VRD_Split.Location, qryPostMort_VRD_Split.Month;

