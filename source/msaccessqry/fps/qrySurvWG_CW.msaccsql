QUERY NAME: qrySurvWG_CW
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(TimeCostCalcsMAP.Time) AS SumOfTime
SELECT WorkGroup_General.ProfitCentre, Sum(TimeCostCalcsMAP.Time) AS SumOfTime1
FROM TimeCostCalcsMAP INNER JOIN WorkGroup_General ON TimeCostCalcsMAP.WorkGroup = WorkGroup_General.WorkGroup
WHERE ((WorkGroup_General.ProfitCentre="vetr") AND (TimeCostCalcsMAP.JobCode Like "CW*"))
GROUP BY WorkGroup_General.ProfitCentre
PIVOT TimeCostCalcsMAP.WorkGroup In ("SVAB","SVBR","SVBU","SVCA","SVLU","SVNC","SVPE","SVPR","SVSB","SVSH","SVST","SVTH","SVWI");

