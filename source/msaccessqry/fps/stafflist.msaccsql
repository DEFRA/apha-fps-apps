QUERY NAME: stafflist
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Count(tblStaff.StaffID) AS CountOfStaffID
SELECT WorkGroup.ProfitCentre, WorkGroup.WorkGroup, WorkGroup.Description
FROM (WorkGroup INNER JOIN ProfitCentreGrade ON WorkGroup.ProfitCentre = ProfitCentreGrade.ProfitCentre) INNER JOIN (WorkGroupGrade INNER JOIN tblStaff ON WorkGroupGrade.WGGrade = tblStaff.WorkGroupGrade) ON (WorkGroup.WorkGroup = WorkGroupGrade.WorkGroup) AND (ProfitCentreGrade.PCGrade = WorkGroupGrade.ProfitCentreGrade)
WHERE (((tblStaff.PersonStatus)="A"))
GROUP BY WorkGroup.ProfitCentre, WorkGroup.WorkGroup, WorkGroup.Description
PIVOT ProfitCentreGrade.GradeCode;

