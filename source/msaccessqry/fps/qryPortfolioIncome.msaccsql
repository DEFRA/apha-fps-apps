QUERY NAME: qryPortfolioIncome
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject_General.ParentProject, tlkpTestReqMet_TM.TestCode, tlkpTestReqMet_TM.SupplierWG, TestOrProduct.UnitPriceVLA, Sum(tlkpTestReqMet_TM.ContrVolume) AS SumOfContrVolume, Sum([ContrVolume]*[UnitPriceVLA]) AS Income
FROM ((tlkpProject_General INNER JOIN tlkpTestCapability_TM ON tlkpProject_General.ParentProject = tlkpTestCapability_TM.PlanPortfolio) INNER JOIN tlkpTestReqMet_TM ON (tlkpTestCapability_TM.WorkGroup = tlkpTestReqMet_TM.SupplierWG) AND (tlkpTestCapability_TM.TestCode = tlkpTestReqMet_TM.TestCode)) INNER JOIN TestOrProduct ON tlkpTestReqMet_TM.TestCode = TestOrProduct.ItemCode
GROUP BY tlkpProject_General.ParentProject, tlkpTestReqMet_TM.TestCode, tlkpTestReqMet_TM.SupplierWG, TestOrProduct.UnitPriceVLA
ORDER BY tlkpProject_General.ParentProject;

