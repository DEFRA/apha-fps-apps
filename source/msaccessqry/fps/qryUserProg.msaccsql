QUERY NAME: qryUserProg
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM IIf(IsNull([ProgramNo]),"","1") AS val
SELECT tblUsers.UserName
FROM tblUsers INNER JOIN tblUser_Program ON tblUsers.User_ID = tblUser_Program.User_ID
GROUP BY tblUsers.UserName
PIVOT tblUser_Program.ProgramNo;

