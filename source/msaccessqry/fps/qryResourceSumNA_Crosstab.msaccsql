QUERY NAME: qryResourceSumNA_Crosstab
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(tblStaffJob_RM.plannedhours) AS SumOfplannedhours
SELECT ProfitCentreGrade_General.ProfitCentre, tlkpProject_General.Program, tlkpProject_General.ProjectStatus, tblStaffJob_RM.Jobcode, Sum(tblStaffJob_RM.plannedhours) AS [Row Summary]
FROM ((ProfitCentreGrade_General INNER JOIN (WorkGroupGrade_General INNER JOIN tblStaff_General ON WorkGroupGrade_General.WGGrade = tblStaff_General.WorkGroupGrade) ON ProfitCentreGrade_General.PCGrade = WorkGroupGrade_General.ProfitCentreGrade) INNER JOIN tblStaffJob_RM ON tblStaff_General.StaffID = tblStaffJob_RM.StaffID) INNER JOIN tlkpProject_General ON tblStaffJob_RM.Jobcode = tlkpProject_General.ParentProject
WHERE ((tlkpProject_General.ProjectStatus="Not Approved"))
GROUP BY ProfitCentreGrade_General.ProfitCentre, tlkpProject_General.Program, tlkpProject_General.ProjectStatus, tblStaffJob_RM.Jobcode
PIVOT ProfitCentreGrade_General.GradeCode In ("GD5","A","BSci","BVet","B1Sci","B1Vet","C","D","ESci","EAdm","FSci","FAdm","GSci","GAdm");

