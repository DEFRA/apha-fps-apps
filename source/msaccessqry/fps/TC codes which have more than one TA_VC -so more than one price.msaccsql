QUERY NAME: TC codes which have more than one TA/VC -so more than one price
---------------------------------------------
TYPE: MAKE TABLE

SQL:
SELECT DISTINCTROW TestOrProduct.ItemCode, Count(BOOK1.ItemCode) AS CountOfItemCode, Min(BOOK1.UnitPriceVLAgen) AS MinOfUnitPriceVLAgen, Max(BOOK1.UnitPriceVLAgen) AS MaxOfUnitPriceVLAgen INTO dups
FROM (TestOrProduct INNER JOIN BOOK1 ON TestOrProduct.ItemCode = BOOK1.NewTC) INNER JOIN dups ON TestOrProduct.ItemCode = dups.ItemCode
GROUP BY dups.CountOfItemCode, TestOrProduct.ItemCode
HAVING ((dups.CountOfItemCode>1))
ORDER BY Count(BOOK1.ItemCode) DESC;

