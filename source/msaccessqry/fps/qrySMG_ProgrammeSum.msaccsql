QUERY NAME: qrySMG_ProgrammeSum
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProgram.Directorate, tlkpProgram.ProgramNo, Sum(qryJobCodeTotalsNew.JCTotalAdditionalCosts) AS SumOfJCTotalAdditionalCosts, Sum(qryJobCodeTotalsNew.JCTotalAnimalCosts) AS SumOfJCTotalAnimalCosts, Sum(qryJobCodeTotalsNew.JCTotalStaffCosts) AS SumOfJCTotalStaffCosts, Sum(qryJobCodeTotalsNew.JCTotalTestCosts) AS SumOfJCTotalTestCosts, Sum(qryJobCodeTotalsNew.JCTotalProdCosts) AS SumOfJCTotalProdCosts, Sum(qryJobCodeTotalsNew.TotalCosts) AS SumOfTotalCosts, Sum([Income]-[TotalCosts]) AS PlannedCont, Sum(qryJobCodeTotalsNew.Profit) AS TargetCont, Sum(qryJobCodeTotalsNew.Income) AS SumOfIncome, Sum(-[TransferIncome]+IIf(IsNull([plancaseworkdebit]),0,[plancaseworkdebit])) AS TransferTotal, ([PlannedCont]-[TargetCont]) AS Variance
FROM qryJobCodeTotalsNew INNER JOIN tlkpProgram ON qryJobCodeTotalsNew.Program = tlkpProgram.ProgramNo
GROUP BY tlkpProgram.Directorate, tlkpProgram.ProgramNo
HAVING (((tlkpProgram.ProgramNo)<>"zt_prog"))
ORDER BY tlkpProgram.ProgramNo;

