QUERY NAME: qrySurvInvoice
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(Proj_Invoice.Amount) AS SumOfAmount
SELECT Proj_Invoice.ProjectParent
FROM Proj_Invoice
WHERE ((Proj_Invoice.Month<=[Forms]![frmPactReportMenu]![PeriodPick]))
GROUP BY Proj_Invoice.ProjectParent
PIVOT Proj_Invoice.Type In ("PVSIncome","CVOGIncome");

