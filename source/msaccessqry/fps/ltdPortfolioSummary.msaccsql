QUERY NAME: ltdPortfolioSummary
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject_MAP.Program, Left([project],2) AS PortType, IIf([porttype] In ("TG","LT","TE"),"LTD","NonLTD") AS PortOwner, ProjectMonthFinal.Project, ProjectMonthFinal.MonthNo, ProjectMonthFinal.CumCost, Sum(IIf(IsNull([PortTransferFee]),0,[porttransferfee])) AS Transfee, IIf(IsNull([TransferReceipt]),0,[TransferREceipt]) AS TransRec, [TransFee]-[TransRec] AS Transfer, [projectmonthfinal].[cumcost]+[transfer] AS TotCost, ProjectMonthFinal.CumPortSales, [cumportsales]-[projectmonthfinal].[cumcost] AS Profit, tlkpProject_MAP.TransferIncome, tlkpProject_MAP.CustIncome, tlkpProject_MAP.Budget_CVL, [projectmonthfinal].[cumcost]/[budget_CVL] AS [%Spent]
FROM ((tlkpProject_MAP INNER JOIN ProjectMonthFinal ON tlkpProject_MAP.ParentProject = ProjectMonthFinal.Project) LEFT JOIN ltdPortXfee ON ProjectMonthFinal.Project = ltdPortXfee.PayingPortfolio) LEFT JOIN ltdPortXFee2 ON ProjectMonthFinal.Project = ltdPortXFee2.SubsidisedPortfolio
GROUP BY tlkpProject_MAP.Program, Left([project],2), ProjectMonthFinal.Project, ProjectMonthFinal.MonthNo, ProjectMonthFinal.CumCost, IIf(IsNull([TransferReceipt]),0,[TransferREceipt]), ProjectMonthFinal.CumPortSales, tlkpProject_MAP.TransferIncome, tlkpProject_MAP.CustIncome, tlkpProject_MAP.Budget_CVL
HAVING ((tlkpProject_MAP.Program="test_port") AND (ProjectMonthFinal.MonthNo=[Forms]![frmLTD-ReportsMenu]![PeriodPick]));

