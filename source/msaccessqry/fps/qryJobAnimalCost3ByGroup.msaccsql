QUERY NAME: qryJobAnimalCost3ByGroup
---------------------------------------------
TYPE: SELECT

SQL:
SELECT tlkpProject_General.Program AS Programme, tblAnimalReq_ByGroup.AnimalType, tblAnimalReq_ByGroup.JobCode, tblAnimalReq_ByGroup.NumberOfDays, tblAnimalReq_ByGroup.NumberOfAnimals, IIf([isdefraproject]=0,[tblAnimals].[DailyRate],[defradailyrate]) AS DailyRate, [NumberOfDays]*[NumberOfAnimals]*[DailyRate] AS AnimalCost, [NumberOfAnimals]*[NumberOfDays] AS TotalDays, tblAnimalReq_ByGroup.IndCounter, tlkpProject_General.IsDefraProject
FROM tlkpProject_General INNER JOIN (tblAnimals INNER JOIN tblAnimalReq_ByGroup ON tblAnimals.AnimalType = tblAnimalReq_ByGroup.AnimalType) ON tlkpProject_General.ParentProject = tblAnimalReq_ByGroup.JobCode;

