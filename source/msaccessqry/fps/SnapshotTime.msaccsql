QUERY NAME: SnapshotTime
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW "Plan - " & Date() AS Version, tlkpProgram_MAP.Directorate, tlkpProject_MAP.Program, tlkpProject_MAP.Customer, tlkpProject_MAP.Contract, tlkpProject_MAP.ParentProject AS Project, tlkpProject_MAP.ProjectStatus AS Status, ProfitCentreGrade_General.ProfitCentre AS ResourceCentre, WorkGroupGrade_General.WorkGroup, WorkGroupGrade_General.GradeCode, tblStaff_General.Name, tblStaffJob_MAP.plannedhours AS Hours, IIf([Program] In ("ZT_prog","ZT_leave","Pend_work"),0,[plannedhours]*[chargerate]) AS HoursCost
FROM tlkpProgram_MAP INNER JOIN (((tlkpProject_MAP INNER JOIN tblStaffJob_MAP ON tlkpProject_MAP.ParentProject = tblStaffJob_MAP.Jobcode) INNER JOIN tblStaff_General ON tblStaffJob_MAP.StaffID = tblStaff_General.StaffID) INNER JOIN (WorkGroupGrade_General INNER JOIN ProfitCentreGrade_General ON WorkGroupGrade_General.ProfitCentreGrade = ProfitCentreGrade_General.PCGrade) ON tblStaff_General.WorkGroupGrade = WorkGroupGrade_General.WGGrade) ON tlkpProgram_MAP.ProgramNo = tlkpProject_MAP.Program;

