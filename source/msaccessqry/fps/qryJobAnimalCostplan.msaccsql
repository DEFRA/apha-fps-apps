QUERY NAME: qryJobAnimalCostplan
---------------------------------------------
TYPE: SELECT

SQL:
SELECT tlkpProject_General.Program AS Programme, tblAnimalReq.AnimalType, tblAnimalReq.JobCode, tblAnimalReq.NumberOfDays, tblAnimalReq.NumberOfAnimals, IIf([isdefraproject]=0,[tblAnimals].[DailyRate],[defradailyrate]) AS DailyRate, [NumberOfDays]*[NumberOfAnimals]*IIf([isdefraproject]=0,[tblAnimals].[DailyRate],[defradailyrate]) AS AnimalCost, [NumberOfAnimals]*[NumberOfDays] AS TotalDays, tblAnimalReq.IndCounter
FROM tlkpProject_General INNER JOIN (tblAnimals INNER JOIN tblAnimalReq ON tblAnimals.AnimalType = tblAnimalReq.AnimalType) ON tlkpProject_General.ParentProject = tblAnimalReq.JobCode;

