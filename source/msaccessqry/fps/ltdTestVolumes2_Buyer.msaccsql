QUERY NAME: ltdTestVolumes2_Buyer
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject_General.Program, TestOrProduct.ShortDescription AS ItemDescription, tlkpTestReqmt.TestCode, ltdTestVolumes.SumOfNoRequired, IIf([sumofnorequired]=0 Or [vol]=0,0,[vol]/[sumofnorequired]) AS [%Fulfilled], Sum(MonthlyOutput.Volume) AS Vol, Sum([Volume]*[unitprice]) AS Fee, ltdTestVolumes.PlanFee
FROM TestOrProduct INNER JOIN (ltdTestVolumes INNER JOIN (tlkpProject_General INNER JOIN (MonthlyOutput INNER JOIN tlkpTestReqmt ON (MonthlyOutput.Buyer = tlkpTestReqmt.Buyer) AND (MonthlyOutput.TestCode = tlkpTestReqmt.TestCode)) ON tlkpProject_General.ParentProject = tlkpTestReqmt.Buyer) ON (ltdTestVolumes.TestCode = tlkpTestReqmt.TestCode) AND (ltdTestVolumes.Program = tlkpProject_General.Program)) ON TestOrProduct.ItemCode = ltdTestVolumes.TestCode
WHERE (((MonthlyOutput.Month)<=[forms]![frmLTD_ReportsMenu]![periodpick]))
GROUP BY tlkpProject_General.Program, TestOrProduct.ShortDescription, tlkpTestReqmt.TestCode, ltdTestVolumes.SumOfNoRequired, ltdTestVolumes.PlanFee
ORDER BY tlkpProject_General.Program;

