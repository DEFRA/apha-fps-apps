QUERY NAME: qrySumProjectHours
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW MonthlyTime.ParentProject, Sum(MonthlyTime.Hours) AS SumOfHours, Sum([Hours]*[chargeRate]) AS Cost
FROM ((MonthlyTime INNER JOIN tblStaff_General ON MonthlyTime.PACTStaffID = tblStaff_General.StaffID) INNER JOIN WorkGroupGrade_General ON tblStaff_General.WorkGroupGrade = WorkGroupGrade_General.WGGrade) INNER JOIN ProfitCentreGrade_General ON WorkGroupGrade_General.ProfitCentreGrade = ProfitCentreGrade_General.PCGrade
GROUP BY MonthlyTime.ParentProject
ORDER BY MonthlyTime.ParentProject;

