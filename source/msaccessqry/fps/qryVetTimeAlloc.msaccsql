QUERY NAME: qryVetTimeAlloc
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(TimeCostCalcsMAP.Time) AS SumOfTime
SELECT IIf([program]="ZT_prog","ZT","Not_ZT") AS IsZT, tlkpProject_General.Program, tlkpJobCode.Type, Sum(TimeCostCalcsMAP.Time) AS TotalTime
FROM (tlkpJobCode INNER JOIN TimeCostCalcsMAP ON (tlkpJobCode.JobCode = TimeCostCalcsMAP.JobCode) AND (tlkpJobCode.ParentProject = TimeCostCalcsMAP.Project)) INNER JOIN tlkpProject_General ON tlkpJobCode.ParentProject = tlkpProject_General.ParentProject
WHERE ((TimeCostCalcsMAP.WorkGroup Like "sv*") AND (Not tlkpJobCode.JobCode="zt0001"))
GROUP BY IIf([program]="ZT_prog","ZT","Not_ZT"), tlkpProject_General.Program, tlkpJobCode.Type
PIVOT TimeCostCalcsMAP.WorkGroup;

