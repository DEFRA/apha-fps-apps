QUERY NAME: qryfrmGradeAllocationSt1
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW WorkGroupGrade.WorkGroup AS Seller, WorkGroupGrade.WGGrade, WorkGroupGrade.TotalHours AS AvailHrs, Sum(IIf(IsNull([Hours]),0,[Hours])) AS AllocHrs, IIf(IsNull([sumofhours]),0,[SumOfHours]) AS ZTcat, ProfitCentreGrade.ChargeRate, [AllocHrs]*[ChargeRate] AS Cost, [AvailHrs]-[AllocHrs] AS Remaining, [AllocHrs]/[AvailHrs] AS [%Alloc], ([allochrs]-[ztcat])/[availhrs] AS [%Util]
FROM ProfitCentreGrade INNER JOIN ((WorkGroupGrade LEFT JOIN qryfrmGradeAllocationSt1ZT ON WorkGroupGrade.WGGrade = qryfrmGradeAllocationSt1ZT.WGGrade) LEFT JOIN PlanCatWGGrade ON WorkGroupGrade.WGGrade = PlanCatWGGrade.WGGrade) ON ProfitCentreGrade.PCGrade = WorkGroupGrade.ProfitCentreGrade
GROUP BY WorkGroupGrade.WorkGroup, WorkGroupGrade.WGGrade, WorkGroupGrade.TotalHours, IIf(IsNull([sumofhours]),0,[SumOfHours]), ProfitCentreGrade.ChargeRate
HAVING ((WorkGroupGrade.TotalHours>0)) OR (((Sum(IIf(IsNull([Hours]),0,[Hours])))>0));

