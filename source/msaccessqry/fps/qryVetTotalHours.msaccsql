QUERY NAME: qryVetTotalHours
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(tblWGEmployeeMAB.HrsAvail) AS SumOfHrsAvail
SELECT WorkGroup_General.ProfitCentre, Sum(tblWGEmployeeMAB.HrsAvail) AS TotalHrsAvail
FROM (WorkGroupGrade_General INNER JOIN tblWGEmployeeMAB ON WorkGroupGrade_General.WGGrade = tblWGEmployeeMAB.WorkGroupGrade) INNER JOIN WorkGroup_General ON WorkGroupGrade_General.WorkGroup = WorkGroup_General.WorkGroup
WHERE ((WorkGroup_General.ProfitCentre="vetr"))
GROUP BY WorkGroup_General.ProfitCentre, WorkGroup_General.ProfitCentre
PIVOT WorkGroupGrade_General.WorkGroup;

