QUERY NAME: qryCreateSuppyAgrmt
---------------------------------------------
TYPE: APPEND

SQL:
INSERT INTO tlkpTestReqMet ( TestCode, Buyer, SupplierWG, ContrVolume )
SELECT DISTINCTROW tlkpTestCapability.TestCode, tblTestRequ_TM.JobCode, tlkpTestCapability.WorkGroup, tblTestRequ_TM.NoTests
FROM tblTestRequ_TM INNER JOIN tlkpTestCapability ON tblTestRequ_TM.TestCode = tlkpTestCapability.TestCode
WHERE ((tlkpTestCapability.TestCode=[Forms]![frmTestList]![TestPick]) AND (tlkpTestCapability.WorkGroup=[Forms]![frmTestList]![SupplierPick]));

