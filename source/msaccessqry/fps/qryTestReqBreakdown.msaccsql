QUERY NAME: qryTestReqBreakdown
---------------------------------------------
TYPE: SELECT

SQL:
SELECT tblTestRequ_TM.TestCode, TestOrProduct.ShortDescription, tlkpProject_General.Program, tblTestRequ_TM.JobCode, IIf(IsNull([tblTestReqWG].[Workgroup]),[WG],[tblTestReqWG].[Workgroup]) AS WorkG, tblTestRCCost.ProfitCentre, IIf(IsNull([tblTestRCCost].[price]),[TestPrice],[tblTestRCCost].[price]) AS WGPrice, IIf(IsNull([Amount]),[NoTests],[Amount]) AS NoReq
FROM ((tlkpProject_General INNER JOIN ((tblTestRequ_TM LEFT JOIN tblTestReqWG ON (tblTestRequ_TM.TestCode = tblTestReqWG.TestCode) AND (tblTestRequ_TM.JobCode = tblTestReqWG.Buyer)) LEFT JOIN tblTestRCCost ON tblTestRequ_TM.TestCode = tblTestRCCost.TestCode) ON tlkpProject_General.ParentProject = tblTestRequ_TM.JobCode) INNER JOIN qryDefaultWG2 ON tblTestRequ_TM.TestCode = qryDefaultWG2.TestCode) INNER JOIN TestOrProduct ON tblTestRequ_TM.TestCode = TestOrProduct.ItemCode
GROUP BY tblTestRequ_TM.TestCode, TestOrProduct.ShortDescription, tlkpProject_General.Program, tblTestRequ_TM.JobCode, IIf(IsNull([tblTestReqWG].[Workgroup]),[WG],[tblTestReqWG].[Workgroup]), tblTestRCCost.ProfitCentre, IIf(IsNull([tblTestRCCost].[price]),[TestPrice],[tblTestRCCost].[price]), IIf(IsNull([Amount]),[NoTests],[Amount])
ORDER BY tblTestRequ_TM.TestCode, tlkpProject_General.Program, tblTestRequ_TM.JobCode;

