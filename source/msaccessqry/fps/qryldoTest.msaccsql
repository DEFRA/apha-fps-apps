QUERY NAME: qryldoTest
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tblStaff.StaffID, tblStaff.HrsAvail, Sum(tblStaffJob.plannedhours) AS SumOfplannedhours
FROM tblStaff INNER JOIN tblStaffJob ON tblStaff.StaffID = tblStaffJob.StaffID
GROUP BY tblStaff.StaffID, tblStaff.HrsAvail
HAVING (((Sum(tblStaffJob.plannedhours))>[tblStaff].[HrsAvail]));

