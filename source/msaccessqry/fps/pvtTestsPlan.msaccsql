QUERY NAME: pvtTestsPlan
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW TestOrProduct.Owner AS [Test Owner], tlkpProgram_MAP.Directorate, tlkpProgram_MAP.ProgramNo, tlkpProject_general.Contract, tlkpProject_general.ParentProject, tlkpProject_general.Disease AS ProjDisease, tlkpProject_general.ProjectStatus, tlkpProject_general.Customer, tlkpTestReqmt_MAP.TestCode, tlkpTestReqmt_MAP.NoRequired AS PlanTests, tlkpTestReqmt_MAP.UnitPrice, [NoRequired]*[UnitPrice] AS PlanCharge
FROM (TestOrProduct INNER JOIN tlkpTestReqmt_MAP ON TestOrProduct.ItemCode = tlkpTestReqmt_MAP.TestCode) INNER JOIN (tlkpProject_general INNER JOIN tlkpProgram_MAP ON tlkpProject_general.Program = tlkpProgram_MAP.ProgramNo) ON tlkpTestReqmt_MAP.Buyer = tlkpProject_general.ParentProject
WHERE (((fnSelectedProg([Program]))=True) AND ((fnselectedproject([parentproject]))=True))
ORDER BY tlkpProgram_MAP.ProgramNo;

