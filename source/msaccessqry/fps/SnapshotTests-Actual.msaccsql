QUERY NAME: SnapshotTests-Actual
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW "Actual - " & Date() AS Version, tlkpProgram_MAP.Directorate, tlkpProject_MAP.Program, tlkpProject_MAP.Contract, tlkpProject_MAP.ParentProject, tlkpProject_MAP.ProjectStatus, tblTestRequ.TestCode, tblTestRequ.TestPrice AS UnitPrice, Sum(MonthlyOutput.Volume) AS TotVol, [TotVol]*[TestPrice] AS TestFee, TestOrProduct.Owner
FROM TestOrProduct INNER JOIN (((tlkpProject_MAP INNER JOIN tblTestRequ ON tlkpProject_MAP.ParentProject = tblTestRequ.JobCode) INNER JOIN tlkpProgram_MAP ON tlkpProject_MAP.Program = tlkpProgram_MAP.ProgramNo) INNER JOIN MonthlyOutput ON (tblTestRequ.TestCode = MonthlyOutput.TestCode) AND (tblTestRequ.JobCode = MonthlyOutput.Buyer)) ON TestOrProduct.ItemCode = MonthlyOutput.TestCode
WHERE (((MonthlyOutput.Month)<3))
GROUP BY tlkpProgram_MAP.Directorate, tlkpProject_MAP.Program, tlkpProject_MAP.Contract, tlkpProject_MAP.ParentProject, tlkpProject_MAP.ProjectStatus, tblTestRequ.TestCode, tblTestRequ.TestPrice, TestOrProduct.Owner
ORDER BY tlkpProgram_MAP.Directorate, tlkpProject_MAP.Program, tlkpProject_MAP.ParentProject;

