QUERY NAME: qryrptAHVGcontract1
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tblkPeriodMonth.EndMonth, MonthlyOutput.Buyer, MonthlyOutput.TestCode, Sum(MonthlyOutput.Volume) AS SumOfVolume
FROM tlkpTestCapability INNER JOIN (tblkPeriodMonth INNER JOIN MonthlyOutput ON tblkPeriodMonth.MonthNo = MonthlyOutput.Month) ON (tlkpTestCapability.WorkGroup = MonthlyOutput.WorkGroup) AND (tlkpTestCapability.TestCode = MonthlyOutput.TestCode)
GROUP BY tblkPeriodMonth.EndMonth, MonthlyOutput.Buyer, MonthlyOutput.TestCode
HAVING ((tblkPeriodMonth.EndMonth=[forms]![menu-division]![periodpick]));

