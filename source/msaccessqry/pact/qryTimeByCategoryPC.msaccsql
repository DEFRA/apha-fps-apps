QUERY NAME: qryTimeByCategoryPC
---------------------------------------------
TYPE: OTHER

SQL:
PARAMETERS forms![menu-division]!pcpick Text ( 255 );
TRANSFORM Sum(TimeCostCalcs.Time) AS SumOfTime
SELECT TimeCostCalcs.Division, WorkGroup.ProfitCentre, TimeCostCalcs.WorkGroup, tblPeriod.PeriodName, Sum(TimeCostCalcs.Time) AS TotalTime
FROM (tblkPeriodMonth INNER JOIN (tlkpProject INNER JOIN ((TimeCostCalcs INNER JOIN TimeCodeValid ON (TimeCodeValid.ParentProject = TimeCostCalcs.Project) AND (TimeCostCalcs.JobCode = TimeCodeValid.TimeCode) AND (TimeCostCalcs.WorkGroup = TimeCodeValid.WorkGroup)) LEFT JOIN WorkGroup ON TimeCostCalcs.WorkGroup = WorkGroup.WorkGroup) ON tlkpProject.ParentProject = TimeCodeValid.ParentProject) ON tblkPeriodMonth.MonthNo = TimeCostCalcs.Month) INNER JOIN tblPeriod ON tblkPeriodMonth.EndMonth = tblPeriod.EndPeriod
WHERE ((WorkGroup.ProfitCentre=[forms]![menu-division]![pcpick]) AND (tblPeriod.EndPeriod=[forms]![menu-division]![periodpick]))
GROUP BY TimeCostCalcs.Division, WorkGroup.ProfitCentre, TimeCostCalcs.WorkGroup, tblPeriod.PeriodName, tblPeriod.EndPeriod
PIVOT IIf([timecode] Like "cn*","Consultancy",[PlanCat]) In ("Consultancy","CoreCapacity","TestActivity","Production","OtherAHVG","CSG","OtherMAFF","OtherGovt","Commercial","ZTleave","ZTwork","Pending");

