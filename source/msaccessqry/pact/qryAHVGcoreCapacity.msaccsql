QUERY NAME: qryAHVGcoreCapacity
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProgram.Directorate, tlkpProgram.ProgramNo, tlkpProgram.ProgramName, Left([ParentProject],5) AS [Group], tlkpProject.ParentProject, tlkpProject.Budget_cvl, ProjectMonthFinal.CumCost, IIf(([budget_cvl]>0 And [cumcost]>0),[cumcost]/[Budget_cvl],Null) AS [Percent], tblkPeriodMonth.PeriodName
FROM tblkPeriodMonth INNER JOIN (tlkpProgram INNER JOIN (tlkpProject INNER JOIN ProjectMonthFinal ON tlkpProject.ParentProject = ProjectMonthFinal.Project) ON tlkpProgram.ProgramNo = tlkpProject.Program) ON tblkPeriodMonth.EndMonth = ProjectMonthFinal.MonthNo
WHERE ((tblkPeriodMonth.EndMonth=[Forms]![Menu-Division]![PeriodPick]))
GROUP BY tlkpProgram.Directorate, tlkpProgram.ProgramNo, tlkpProgram.ProgramName, Left([ParentProject],5), tlkpProject.ParentProject, tlkpProject.Budget_cvl, ProjectMonthFinal.CumCost, tblkPeriodMonth.PeriodName
HAVING ((tlkpProgram.Directorate="corecapacity"));

