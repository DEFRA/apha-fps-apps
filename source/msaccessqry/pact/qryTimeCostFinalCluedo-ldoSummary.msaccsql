QUERY NAME: qryTimeCostFinalCluedo-ldoSummary
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject.ParentProject, Sum(qryTimeCostCumulativeCluedo.CumCost) AS SumOfCumCost
FROM (WorkGroup INNER JOIN tlkpProject ON WorkGroup.WorkGroup = tlkpProject.ProjectWorkGroup) INNER JOIN ((TimeCodeValid INNER JOIN qryTimeCostCumulativeCluedo ON (TimeCodeValid.TimeCode = qryTimeCostCumulativeCluedo.JobCode) AND (TimeCodeValid.ParentProject = qryTimeCostCumulativeCluedo.Project) AND (TimeCodeValid.WorkGroup = qryTimeCostCumulativeCluedo.WorkGroup)) LEFT JOIN qryTimeCostPeriodCluedo ON (qryTimeCostCumulativeCluedo.JobCode = qryTimeCostPeriodCluedo.JobCode) AND (qryTimeCostCumulativeCluedo.Project = qryTimeCostPeriodCluedo.Project) AND (qryTimeCostCumulativeCluedo.StaffID = qryTimeCostPeriodCluedo.StaffID)) ON tlkpProject.ParentProject = TimeCodeValid.ParentProject
GROUP BY tlkpProject.ParentProject
ORDER BY tlkpProject.ParentProject;

