QUERY NAME: JF ZT SW EW
---------------------------------------------
TYPE: SELECT

SQL:
SELECT TimeCostCalcs.WorkGroup, TimeCostCalcs.Name, TimeCostCalcs.GradeCode, tlkpJobCode.ParentProject, TimeCostCalcs.JobCode, tlkpProject.ProjectTitle, tlkpJobCode.JobCodeName, TimeCostCalcs.Month, Sum(TimeCostCalcs.Time) AS SumOfTime, TimeCostCalcs.ChargeRate, Sum(TimeCostCalcs.Cost) AS SumOfCost, TimeCostCalcs.Overhead
FROM ((TimeCostCalcs INNER JOIN tlkpJobCode ON TimeCostCalcs.JobCode = tlkpJobCode.JobCode) INNER JOIN tlkpProject ON tlkpJobCode.ParentProject = tlkpProject.ParentProject) INNER JOIN WorkGroup ON TimeCostCalcs.WorkGroup = WorkGroup.WorkGroup
GROUP BY TimeCostCalcs.WorkGroup, TimeCostCalcs.Name, TimeCostCalcs.GradeCode, tlkpJobCode.ParentProject, TimeCostCalcs.JobCode, tlkpProject.ProjectTitle, tlkpJobCode.JobCodeName, TimeCostCalcs.Month, TimeCostCalcs.ChargeRate, TimeCostCalcs.Overhead
HAVING (((TimeCostCalcs.WorkGroup) Like "svbr" Or (TimeCostCalcs.WorkGroup)="svst" Or (TimeCostCalcs.WorkGroup)="svtr") AND ((TimeCostCalcs.JobCode) Like "ZT0*"));

