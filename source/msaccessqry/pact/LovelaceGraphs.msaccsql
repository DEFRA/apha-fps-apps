QUERY NAME: LovelaceGraphs
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject.PlanCat, ProjectMonthFinal.Project, ProjectMonthFinal.MonthNo, ProjectMonthFinal.TotalCost
FROM tlkpProject INNER JOIN ProjectMonthFinal ON tlkpProject.ParentProject = ProjectMonthFinal.Project
WHERE ((tlkpProject.PlanCat="csg"))
ORDER BY ProjectMonthFinal.Project, ProjectMonthFinal.MonthNo;

