QUERY NAME: qryTimeCostCumulativeCluedo
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW qryTimeCodeNames.ProfitCentre, qryTimeCodeNames.Manager, TimeCostCalcs.WorkGroup AS BuyingWG, TimeCostCalcs.WorkGroup AS SellingWG, TimeCostCalcs.Project, TimeCostCalcs.JobCode, Min(qryTimeCodeNames.Description) AS MinOfDescription, TimeCostCalcs.StaffID, TimeCostCalcs.GradeCode, TimeCostCalcs.Name, Sum(TimeCostCalcs.Time) AS CumTime, Sum(TimeCostCalcs.Cost) AS CumCost, qryTimeCostPeriodCluedo.PeriodTime, qryTimeCostPeriodCluedo.PeriodCost, TimeCostCalcs.Month, Min(qryTimeCodeNames.ProjectTitle) AS MinOfProjectTitle, qryTimeCodeNames.PlanCat
FROM (qryTimeCodeNames INNER JOIN TimeCostCalcs ON (qryTimeCodeNames.ParentProject = TimeCostCalcs.Project) AND (qryTimeCodeNames.TimeCode = TimeCostCalcs.JobCode)) LEFT JOIN qryTimeCostPeriodCluedo ON (TimeCostCalcs.StaffID = qryTimeCostPeriodCluedo.StaffID) AND (TimeCostCalcs.Project = qryTimeCostPeriodCluedo.Project) AND (TimeCostCalcs.JobCode = qryTimeCostPeriodCluedo.JobCode)
WHERE ((TimeCostCalcs.Class="Charge"))
GROUP BY qryTimeCodeNames.ProfitCentre, qryTimeCodeNames.Manager, TimeCostCalcs.WorkGroup, TimeCostCalcs.WorkGroup, TimeCostCalcs.Project, TimeCostCalcs.JobCode, TimeCostCalcs.StaffID, TimeCostCalcs.GradeCode, TimeCostCalcs.Name, qryTimeCostPeriodCluedo.PeriodTime, qryTimeCostPeriodCluedo.PeriodCost, TimeCostCalcs.Month, qryTimeCodeNames.PlanCat
HAVING ((qryTimeCodeNames.ProfitCentre="viro") AND (TimeCostCalcs.Month=4));

