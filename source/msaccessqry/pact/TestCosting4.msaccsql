QUERY NAME: TestCosting4
---------------------------------------------
TYPE: MAKE TABLE

SQL:
SELECT DISTINCTROW TestCosting3.ProfitCentre, TestCosting3.ProjectWorkGroup, TestCosting3.PlanCat, TestCosting3.Project, TestCosting3.TotalTP, TestCosting3.TotalTA, TestCosting3.[TPper£], TestCosting3.[NonTimePer£], TestCosting3.ProjectTitle, TestCosting3.JobCode, TestCosting3.ItemDescription, TestCosting3.CostSum AS TestCost, TestCosting3.TPSurcharge, TestCosting3.NonTimeSurcharge, TestCosting3.Total, Sum(MonthlyOutput.Volume) AS VolSum, [Total]/[VolSum] AS UnitCost, TestCosting3.CumCost, Query28.UnitCost INTO UnitCost
FROM (tlkpPortfolioTest LEFT JOIN ((TestCosting3 LEFT JOIN tlkpTestCapability ON (TestCosting3.JobCode = tlkpTestCapability.TestCode) AND (TestCosting3.Project = tlkpTestCapability.PlanPortfolio)) LEFT JOIN MonthlyOutput ON (tlkpTestCapability.WorkGroup = MonthlyOutput.WorkGroup) AND (tlkpTestCapability.TestCode = MonthlyOutput.TestCode)) ON (tlkpPortfolioTest.TestCode = TestCosting3.JobCode) AND (tlkpPortfolioTest.PlanPortfolio = TestCosting3.Project)) LEFT JOIN Query28 ON (tlkpTestCapability.PlanPortfolio = Query28.Project) AND (tlkpTestCapability.TestCode = Query28.JobCode)
WHERE ((MonthlyOutput.Month<7))
GROUP BY TestCosting3.ProfitCentre, TestCosting3.ProjectWorkGroup, TestCosting3.PlanCat, TestCosting3.Project, TestCosting3.TotalTP, TestCosting3.TotalTA, TestCosting3.[TPper£], TestCosting3.[NonTimePer£], TestCosting3.ProjectTitle, TestCosting3.JobCode, TestCosting3.ItemDescription, TestCosting3.CostSum, TestCosting3.TPSurcharge, TestCosting3.NonTimeSurcharge, TestCosting3.Total, TestCosting3.CumCost, Query28.UnitCost;

