QUERY NAME: JF proj spec costs
---------------------------------------------
TYPE: SELECT

SQL:
SELECT Proj_SubContract.SubContCounter, Proj_SubContract.Project, Proj_SubContract.TestJob, Proj_SubContract.Month, Proj_SubContract.Amount, Proj_SubContract.AcctCode, Proj_SubContract.TimeStamp, Proj_SubContract.Supplier, Proj_SubContract.Description, Proj_SubContract.SupplierNumber, Proj_SubContract.DailyRate, Proj_SubContract.AnimalDays
FROM Proj_SubContract INNER JOIN [JF Seedcorn projects 2016-17] ON Proj_SubContract.Project = [JF Seedcorn projects 2016-17].Field1;

