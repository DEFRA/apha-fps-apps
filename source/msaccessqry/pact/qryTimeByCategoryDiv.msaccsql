QUERY NAME: qryTimeByCategoryDiv
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(TimeCostCalcs.Time) AS SumOfTime
SELECT TimeCostCalcs.Division, WorkGroup.ProfitCentre, TimeCostCalcs.WorkGroup, tblPeriod.PeriodName, Sum(TimeCostCalcs.Time) AS TotalTime
FROM qryCurrentMonth INNER JOIN tblPeriod ON qryCurrentMonth.MaxOfMonthNo = tblPeriod.EndPeriod, (tlkpDivision RIGHT JOIN tblkpProfitCentre ON tlkpDivision.DivName = tblkpProfitCentre.Division) RIGHT JOIN (tlkpProject INNER JOIN ((TimeCostCalcs INNER JOIN TimeCodeValid ON (TimeCodeValid.ParentProject = TimeCostCalcs.Project) AND (TimeCostCalcs.JobCode = TimeCodeValid.TimeCode) AND (TimeCostCalcs.WorkGroup = TimeCodeValid.WorkGroup)) LEFT JOIN WorkGroup ON TimeCostCalcs.WorkGroup = WorkGroup.WorkGroup) ON tlkpProject.ParentProject = TimeCodeValid.ParentProject) ON tblkpProfitCentre.ProfitCentre = WorkGroup.ProfitCentre
GROUP BY TimeCostCalcs.Division, WorkGroup.ProfitCentre, TimeCostCalcs.WorkGroup, tblPeriod.PeriodName, tlkpDivision.DivName
PIVOT IIf([timecode] Like "cn*","Consultancy",[PlanCat]) In ("Consultancy","CoreCapacity","TestActivity","Production","OtherAHVG","CSG","OtherMAFF","OtherGovt","Commercial","ZTleave","ZTwork","Pending");

