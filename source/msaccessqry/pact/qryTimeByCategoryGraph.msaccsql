QUERY NAME: qryTimeByCategoryGraph
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(TimeCostCalcs.Time) AS SumOfTime
SELECT TimeCostCalcs.WorkGroup
FROM tlkpProject INNER JOIN (TimeCostCalcs INNER JOIN TimeCodeValid ON (TimeCostCalcs.JobCode = TimeCodeValid.TimeCode) AND (TimeCostCalcs.WorkGroup = TimeCodeValid.WorkGroup)) ON tlkpProject.ParentProject = TimeCodeValid.ParentProject
GROUP BY TimeCostCalcs.WorkGroup
PIVOT IIf([timecode] Like "cn*","Consultancy",[PlanCat]) In ("Consultancy","CoreCapacity","TestActivity","Production","OtherAHVG","CSG","OtherMAFF","OtherGovt","Commercial","Pending","ZTwork","ZTleave");

