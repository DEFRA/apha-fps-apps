QUERY NAME: qryAD6000_GetAndTransform
---------------------------------------------
TYPE: APPEND

SQL:
INSERT INTO tempMonthlyTime_Transform ( [Month], Hours, ParentProject, TimeCode )
SELECT MonthlyTime.Month, MonthlyTime.Hours, MonthlyTime.ParentProject, MonthlyTime.TimeCode
FROM MonthlyTime
WHERE (((MonthlyTime.Month)<=GetgVarFMonth()) AND ((Exists (SELECT * FROM tblMTConversion WHERE (MonthlyTime.TimeCode = tblMTConversion.OldCode) AND (MonthlyTime.ParentProject = tblMTConversion.OldProject)
))<>False) AND ((MonthlyTime.WorkGroup) Like "SV*"));

