QUERY NAME: qryrptAHVGcontract3a
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject.PlanCat, tlkpProject.Budget_Ext, TestOrProduct.ItemDescription, tlkpProject.ParentProject, tlkpProject.ProjectTitle, tlkpTestReqMet.TestCode, Sum(tlkpTestReqMet.ContrVolume) AS SumOfContrVolume
FROM TestOrProduct INNER JOIN (tlkpProject INNER JOIN tlkpTestReqMet ON tlkpProject.ParentProject = tlkpTestReqMet.Buyer) ON TestOrProduct.ItemCode = tlkpTestReqMet.TestCode
GROUP BY tlkpProject.PlanCat, tlkpProject.Budget_Ext, TestOrProduct.ItemDescription, tlkpProject.ParentProject, tlkpProject.ProjectTitle, tlkpTestReqMet.TestCode
HAVING ((tlkpProject.PlanCat="testcontract"));

