QUERY NAME: qryWG-ALL
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject.PlanCat, WorkGroup.ProfitCentre, tlkpProject.ProjectWorkGroup, tlkpProject.ParentProject, tblkMonth.MonthName, JobCodeMonthFinal.TotalCost AS MonthCost, tlkpProject.[wip_eoy], JobCodeMonthFinal.CumProfile, [wip_eoy]+[cumprofile] AS ForecastCost1, JobCodeMonthFinal.CumCost, [cumcost]+[wip_eoy] AS ActualCost1, [forecastcost1]-[actualcost1] AS CostVar, [cuminvoices]+[cumportsales] AS YTDincome, JobCodeMonthFinal.CumCOIW, tlkpProject.[Budget-Ext] AS ContractPrice, ([budget-ext]-[actualcost1]) AS ContPriceLessCost, JobCodeMonthFinal.SumOfCostProfile, tlkpProject.Contract
FROM qryCurrentMonth INNER JOIN ((WorkGroup INNER JOIN tlkpProject ON WorkGroup.WorkGroup = tlkpProject.ProjectWorkGroup) INNER JOIN (JobCodeMonthFinal INNER JOIN tblkMonth ON JobCodeMonthFinal.MonthNo = tblkMonth.MonthNo) ON tlkpProject.ParentProject = JobCodeMonthFinal.JobCode) ON qryCurrentMonth.MaxOfMonthNo = JobCodeMonthFinal.MonthNo
WHERE ((WorkGroup.ProfitCentre=[Forms]![Menu-Division]![PCpick]))
ORDER BY tlkpProject.ProjectWorkGroup, tlkpProject.ParentProject;

