QUERY NAME: qryrptAHVGTestContractsScreen
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(MonthlyOutput.Volume) AS SumOfVolume
SELECT tlkpTestReqmt.Buyer, tlkpTestReqmt.TestCode, TestOrProduct.ItemDescription, tlkpTestReqmt.NoRequired, tlkpTestReqmt.UnitPrice, IIf(IsNull([TotVol]),0,[totvol]*[UnitPrice]) AS Worth, Sum(MonthlyOutput.Volume) AS TotVol, IIf([Norequired]=0,Null,Format([TotVol]/[NoRequired],"0%")) AS [YTD %]
FROM (TestOrProduct INNER JOIN tlkpPortfolioTest ON TestOrProduct.ItemCode = tlkpPortfolioTest.TestCode) INNER JOIN (tlkpTestReqmt LEFT JOIN (tlkpMonth RIGHT JOIN MonthlyOutput ON tlkpMonth.AccntsPeriod = MonthlyOutput.Month) ON (tlkpTestReqmt.Buyer = MonthlyOutput.Buyer) AND (tlkpTestReqmt.TestCode = MonthlyOutput.TestCode)) ON TestOrProduct.ItemCode = tlkpTestReqmt.TestCode
GROUP BY tlkpTestReqmt.Buyer, tlkpTestReqmt.TestCode, TestOrProduct.ItemDescription, tlkpTestReqmt.NoRequired, tlkpTestReqmt.UnitPrice
PIVOT tlkpMonth.MonthName In ("April","May","June","July","August","September","October","November","December","January","February","March");

