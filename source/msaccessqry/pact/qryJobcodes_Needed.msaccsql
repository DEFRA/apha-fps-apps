QUERY NAME: qryJobcodes_Needed
---------------------------------------------
TYPE: APPEND

SQL:
INSERT INTO TimeCodeValid ( TimeCode, WorkGroup, JobCode, ParentProject, Active )
SELECT tlkpJobCode.JobCode, WorkGroupGrade.WorkGroup, tlkpJobCode.JobCode AS JobCode1, tlkpJobCode.ParentProject, True AS Active
FROM ((tblWGEmployee INNER JOIN tblStaffJob ON tblWGEmployee.PACTid = tblStaffJob.StaffID) INNER JOIN tlkpJobCode ON tblStaffJob.Jobcode = tlkpJobCode.ParentProject) INNER JOIN WorkGroupGrade ON tblWGEmployee.WorkGroupGrade = WorkGroupGrade.WG_Grade
WHERE (((Exists (SELECT * FROM Timecodevalid WHERE
Timecodevalid.timecode = tlkpJobcode.jobcode AND
Timecodevalid.parentproject = tlkpJobcode.parentproject AND
Timecodevalid.workgroup = WorkGroupGrade.WorkGroup ))=False))
GROUP BY tlkpJobCode.JobCode, WorkGroupGrade.WorkGroup, tlkpJobCode.JobCode, tlkpJobCode.ParentProject;

