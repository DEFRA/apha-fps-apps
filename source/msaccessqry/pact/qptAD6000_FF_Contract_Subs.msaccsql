QUERY NAME: qptAD6000_FF_Contract_Subs
---------------------------------------------
TYPE: PASS-THROUGH

SQL:
SELECT     
dbo.ServiceRequest.FINAL_CONTRACT, 
COUNT(*) AS No_Subs,
dbo.Submission.VIC_DR_Month, 
dbo.Submission.VIC_DR_Year,  

/* Convert to PREVIOUS Finacial Month - Year*/
Case 
WHEN VIC_DR_Month between 5 and 12 then VIC_DR_Month-4 
 WHEN VIC_DR_Month <5 then VIC_DR_Month +8
ELSE NULL END  as FMonth,

Case 
WHEN VIC_DR_Month between 5 and 12 then VIC_DR_Year
 WHEN VIC_DR_Month <5 then VIC_DR_Year-1
ELSE NULL END  as FYear

FROM         dbo.Submission INNER JOIN
                      dbo.ServiceRequest ON dbo.Submission.JOB_NAME = dbo.ServiceRequest.JOB_NAME

WHERE     (dbo.Submission.VIC_SUBMISSION = 'T') AND (dbo.Submission.JOB_STATUS <> 'X') AND (dbo.ServiceRequest.SELECTED = 'T') AND 
                      (dbo.Submission.VIC_DR_Year >= Year(GetDate())-1) AND (dbo.Submission.SUBMISSION_REASON = 'DIAG') AND 
                      (dbo.ServiceRequest.FINAL_CONTRACT IN ('ED1000', 'ED1100', 'ED1200', 'ED1300', 'ED1500'))

GROUP BY dbo.ServiceRequest.FINAL_CONTRACT, dbo.Submission.VIC_DR_Month, dbo.Submission.VIC_DR_Year
