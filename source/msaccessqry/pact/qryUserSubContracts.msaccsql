QUERY NAME: qryUserSubContracts
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(Proj_SubContract.Amount) AS SumOfAmount
SELECT tlkpProject.Program, tlkpProject.ParentProject
FROM tlkpProject INNER JOIN Proj_SubContract ON tlkpProject.ParentProject = Proj_SubContract.Project
GROUP BY tlkpProject.Program, tlkpProject.ParentProject
ORDER BY tlkpProject.Program, tlkpProject.ParentProject
PIVOT Proj_SubContract.Month;

