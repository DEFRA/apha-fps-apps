QUERY NAME: qryManager
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tblStaff_General.Name, WorkGroupGrade.WorkGroup AS Expr1, WorkGroupGrade.GradeCode AS Expr2
FROM WorkGroupGrade INNER JOIN tblStaff_General ON WorkGroupGrade.WG_Grade = tblStaff_General.WorkGroupGrade
WHERE (((tblStaff_General.Name) Not Like "*gen*" And (tblStaff_General.Name) Not Like "*vacancy*") AND ((WorkGroupGrade.GradeCode)<="E" Or (WorkGroupGrade.GradeCode)="GD5"))
ORDER BY tblStaff_General.Name;

