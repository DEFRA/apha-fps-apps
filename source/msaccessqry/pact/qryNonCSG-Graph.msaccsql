QUERY NAME: qryNonCSG-Graph
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW ProjectMonthFinal.MonthNo AS EndPeriod, ProjectMonthFinal.Project, ProjectMonthFinal.CumProfile, [CumCost]+[wip_eoy] AS TotCumCost, [cuminvoices]+[cumportsales] AS CumIncome, tlkpProject.Budget_CVL AS Budget
FROM tlkpProject INNER JOIN ProjectMonthFinal ON tlkpProject.ParentProject = ProjectMonthFinal.Project;

