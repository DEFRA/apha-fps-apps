QUERY NAME: qryrptPC1part1B
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW WorkGroup.ProfitCentre, Sum(TimeCostCalcs.Cost) AS SumOfCost, TimeCostCalcs.Class
FROM TimeCostCalcs INNER JOIN WorkGroup ON TimeCostCalcs.WorkGroup = WorkGroup.WorkGroup
GROUP BY WorkGroup.ProfitCentre, TimeCostCalcs.Class
HAVING ((TimeCostCalcs.Class="charge"));

