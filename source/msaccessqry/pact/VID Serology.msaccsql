QUERY NAME: VID Serology
---------------------------------------------
TYPE: OTHER

SQL:
PARAMETERS forms!sara!portpick Text ( 255 );
TRANSFORM Count(tlkpTestReqmt.TestCode) AS CountOfTestCode
SELECT tlkpTestCapability.PlanPortfolio, tlkpTestCapability.TestCode
FROM tlkpTestCapability INNER JOIN tlkpTestReqmt ON tlkpTestCapability.TestCode = tlkpTestReqmt.TestCode
GROUP BY tlkpTestCapability.PlanPortfolio, tlkpTestCapability.TestCode
PIVOT IIf([tlkptestreqmt].[buyer] Like "UT*" Or [tlkptestreqmt].[buyer] Like "ft*","Comm",[tlkptestreqmt].[Buyer]);

