QUERY NAME: TimeCodes_By_Project
---------------------------------------------
TYPE: SELECT

SQL:
SELECT TimeCodeValid.ParentProject, TimeCodeValid.TimeCode, TimeCodeValid.WorkGroup, IIf(IsNull([ItemDescription]),[JobCodeName],[ItemDescription]) AS Description
FROM (TimeCodeValid LEFT JOIN tlkpJobCode ON TimeCodeValid.JobCode = tlkpJobCode.JobCode) LEFT JOIN TestorProduct ON TimeCodeValid.TestCode = TestorProduct.ItemCode
WHERE (((TimeCodeValid.Active)=True))
ORDER BY TimeCodeValid.ParentProject, TimeCodeValid.TimeCode, TimeCodeValid.WorkGroup;

