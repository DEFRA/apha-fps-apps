QUERY NAME: LizTime
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW WorkGroupGrade.WorkGroup, WorkGroupGrade.GradeCode, tlkpProject.PlanCat, tlkpProject.ParentProject, MonthlyTime.TimeCode, Sum(MonthlyTime.Hours) AS 11months, [11months]/11*12 AS 12months
FROM (WorkGroup INNER JOIN (WorkGroupGrade INNER JOIN (tblStaff INNER JOIN MonthlyTime ON tblStaff.PACTid = MonthlyTime.PACTStaffID) ON WorkGroupGrade.WG_Grade = tblStaff.WorkGroupGrade) ON WorkGroup.WorkGroup = WorkGroupGrade.WorkGroup) INNER JOIN tlkpProject ON MonthlyTime.ParentProject = tlkpProject.ParentProject
WHERE ((WorkGroup.ProfitCentre="vine" Or WorkGroup.ProfitCentre="visw"))
GROUP BY WorkGroupGrade.WorkGroup, WorkGroupGrade.GradeCode, tlkpProject.PlanCat, tlkpProject.ParentProject, MonthlyTime.TimeCode;

