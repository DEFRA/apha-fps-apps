QUERY NAME: qryVID-WG
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpDivision.DivName, tblkpProfitCentre.ProfitCentre, WorkGroup.WorkGroup
FROM (tlkpDivision INNER JOIN tblkpProfitCentre ON tlkpDivision.DivName = tblkpProfitCentre.Division) INNER JOIN WorkGroup ON tblkpProfitCentre.ProfitCentre = WorkGroup.ProfitCentre
WHERE ((tlkpDivision.DivName="VID"))
ORDER BY tblkpProfitCentre.ProfitCentre, WorkGroup.WorkGroup;

