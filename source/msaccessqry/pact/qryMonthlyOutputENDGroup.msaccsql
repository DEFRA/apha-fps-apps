QUERY NAME: qryMonthlyOutputENDGroup
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW MonthlyOutput.TestCode, MonthlyOutput.Month, Sum(MonthlyOutput.Volume) AS Volume
FROM MonthlyOutput
WHERE (((MonthlyOutput.Buyer)="ed1000" Or (MonthlyOutput.Buyer)="ed1100" Or (MonthlyOutput.Buyer)="ed1200" Or (MonthlyOutput.Buyer)="ed1300" Or (MonthlyOutput.Buyer)="ed1500" Or (MonthlyOutput.Buyer)="ed1600"))
GROUP BY MonthlyOutput.TestCode, MonthlyOutput.Month;

