QUERY NAME: JF ZT query
---------------------------------------------
TYPE: SELECT

SQL:
SELECT TimeCostCalcs.WorkGroup, TimeCostCalcs.JobCode, TimeCostCalcs.Project, TimeCostCalcs.Month, TimeCostCalcs.StaffID, TimeCostCalcs.GradeCode, TimeCostCalcs.Name, TimeCostCalcs.ChargeRate, TimeCostCalcs.Class, TimeCostCalcs.Time, TimeCostCalcs.Cost, TimeCostCalcs.Division, TimeCostCalcs.JobCodeOld, TimeCostCalcs.Pay, TimeCostCalcs.NonPay, TimeCostCalcs.Overhead
FROM TimeCostCalcs
WHERE (((TimeCostCalcs.WorkGroup) Like "BAC*" Or (TimeCostCalcs.WorkGroup) Like "BTB*") AND ((TimeCostCalcs.JobCode)="ZT0019"));

