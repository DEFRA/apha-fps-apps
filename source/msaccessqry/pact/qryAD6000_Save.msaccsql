QUERY NAME: qryAD6000_Save
---------------------------------------------
TYPE: APPEND

SQL:
INSERT INTO MonthlyTime ( PACTStaffID, TimeCode, [Month], ParentProject, WorkGroup, Hours )
SELECT tempMonthlyTime_TransformFinal.PACTStaffID, tempMonthlyTime_TransformFinal.TimeCode, tempMonthlyTime_TransformFinal.Month, tempMonthlyTime_TransformFinal.ParentProject, tempMonthlyTime_TransformFinal.WorkGroup, Sum(tempMonthlyTime_TransformFinal.Hours) AS SumOfHours
FROM tempMonthlyTime_TransformFinal
GROUP BY tempMonthlyTime_TransformFinal.PACTStaffID, tempMonthlyTime_TransformFinal.TimeCode, tempMonthlyTime_TransformFinal.Month, tempMonthlyTime_TransformFinal.ParentProject, tempMonthlyTime_TransformFinal.WorkGroup;

