QUERY NAME: qryProjectIG
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProject.ParentProject, tlkpMonth.AccntsPeriod, tlkpMonth.MonthName, ProjectMonthFinal.TotalCost AS MonthCost, tlkpProject.WIP_EOY, ProjectMonthFinal.CumProfile, [wip_eoy]+[cumprofile] AS ForecastCost1, ProjectMonthFinal.CumCost, [cumcost]+[wip_eoy] AS ActualCost1, [forecastcost1]-[actualcost1] AS CostVar, [cuminvoices]+[cumportsales] AS YTDincome, ProjectMonthFinal.CumCOIW, tlkpProject.Budget_Ext AS ContractPrice, ([ContractPrice]-[actualcost1]) AS ContPriceLessCost, ProjectMonthFinal.SumOfCostProfile, IIf(([ActualCost1]-[YTDincome])>([ContractPrice]-[ytdincome]),[CONTRACTPRICE]-[YTDINCOME],[ACTUALCOST1]-[YTDINCOME]) AS WIP1, IIf(IsNull([WIP_CURRENT]),[WIP1],[WIP_CURRENT]) AS WIP, [ytdincome]-[CUMCOIW] AS ProfitLoss, tlkpProject.Program, tlkpProject.Program AS ProgramNo, tlkpProject.Budget_cvl, tlkpProject.Budget_Ext, tlkpProject.TransferIncome
FROM (ProjectMonthFinal INNER JOIN tlkpProject ON ProjectMonthFinal.Project = tlkpProject.ParentProject) INNER JOIN tlkpMonth ON ProjectMonthFinal.MonthNo = tlkpMonth.AccntsPeriod
WHERE ((tlkpMonth.AccntsPeriod=[forms]![menu-division]![periodpick]));

