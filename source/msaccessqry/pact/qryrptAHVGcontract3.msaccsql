QUERY NAME: qryrptAHVGcontract3
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW qryrptAHVGcontract3a.PlanCat, qryrptAHVGcontract3a.ParentProject, qryrptAHVGcontract3a.ProjectTitle, qryrptAHVGcontract3a.TestCode, qryrptAHVGcontract3a.ItemDescription, qryrptAHVGcontract3a.Budget_Ext, qryrptAHVGcontract3a.SumOfContrVolume AS ContrVolume, Sum(tlkpTestReqMetMonth.MonthVol) AS SumOfMonthVol, tblkPeriodMonth.EndMonth, tblkPeriodMonth.PeriodName
FROM qryrptAHVGcontract3a INNER JOIN (tblkPeriodMonth INNER JOIN tlkpTestReqMetMonth ON tblkPeriodMonth.MonthNo = tlkpTestReqMetMonth.Month) ON (qryrptAHVGcontract3a.ParentProject = tlkpTestReqMetMonth.Buyer) AND (qryrptAHVGcontract3a.TestCode = tlkpTestReqMetMonth.TestCode)
GROUP BY qryrptAHVGcontract3a.PlanCat, qryrptAHVGcontract3a.ParentProject, qryrptAHVGcontract3a.ProjectTitle, qryrptAHVGcontract3a.TestCode, qryrptAHVGcontract3a.ItemDescription, qryrptAHVGcontract3a.Budget_Ext, qryrptAHVGcontract3a.SumOfContrVolume, tblkPeriodMonth.EndMonth, tblkPeriodMonth.PeriodName
HAVING ((qryrptAHVGcontract3a.PlanCat="testcontract") AND (tblkPeriodMonth.EndMonth=[forms]![menu-division]![periodpick]));

