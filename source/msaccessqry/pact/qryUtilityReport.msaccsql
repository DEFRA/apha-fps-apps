QUERY NAME: qryUtilityReport
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProgram.ProgramNo AS Program, tlkpProgram.ProgramName, tlkpProgram.Directorate, ProjectMonthFinal.Project, tlkpProject.Manager, tlkpProject.ProjectStatus, tlkpMonth.AccntsPeriod AS MonthNo, tlkpMonth.MonthName, ProjectMonthFinal.TimeCosts, ProjectMonthFinal.TransferCosts, ProjectMonthFinal.Animals, ProjectMonthFinal.NonAnimals, ProjectMonthFinal.TotalCost, IIf(IsNull([invoices]),0,[invoices]) AS Invoiced, ProjectMonthFinal.PortSales, IIf(IsNull([portsales]),0,[portsales]) AS Transfers, [transfers]+[invoiced] AS TotalIncome, tlkpProject.Customer, tlkpProject.Finished
FROM tlkpProgram INNER JOIN ((tlkpProject INNER JOIN ProjectMonthFinal ON tlkpProject.ParentProject = ProjectMonthFinal.Project) INNER JOIN tlkpMonth ON ProjectMonthFinal.MonthNo = tlkpMonth.AccntsPeriod) ON tlkpProgram.ProgramNo = tlkpProject.Program
WHERE (((tlkpProject.Program) Not Like "*_Port" And (tlkpProject.Program) Not Like "*_RES")) OR (((ProjectMonthFinal.Project) Like "FT*" Or (ProjectMonthFinal.Project) Like "OM*"))
GROUP BY tlkpProgram.ProgramNo, tlkpProgram.ProgramName, tlkpProgram.Directorate, ProjectMonthFinal.Project, tlkpProject.Manager, tlkpProject.ProjectStatus, tlkpMonth.AccntsPeriod, tlkpMonth.MonthName, ProjectMonthFinal.TimeCosts, ProjectMonthFinal.TransferCosts, ProjectMonthFinal.Animals, ProjectMonthFinal.NonAnimals, ProjectMonthFinal.TotalCost, IIf(IsNull([invoices]),0,[invoices]), ProjectMonthFinal.PortSales, tlkpProject.Customer, tlkpProject.Finished
HAVING (((tlkpProgram.ProgramNo) Not Like "*_Surv" And (tlkpProgram.ProgramNo)<>"om_work"));

