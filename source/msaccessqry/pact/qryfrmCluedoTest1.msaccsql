QUERY NAME: qryfrmCluedoTest1
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(MonthlyOutput.Volume) AS Vol
SELECT WorkGroup.WorkGroup, tlkpProject.ParentProject, tlkpProject.ProjectTitle, tlkpPortfolioTest.TestCode, tlkpPortfolioTest.TotalCost AS UnitCost, TestOrProduct.ItemDescription, Max(ProjectMonthFinal.CumCost) AS MaxOfCumCost, Sum(MonthlyOutput.Volume) AS SumOfVolume1, [unitcost]*[sumofvolume1] AS TestCost
FROM WorkGroup INNER JOIN ((ProjectMonthFinal INNER JOIN tlkpProject ON ProjectMonthFinal.Project = tlkpProject.ParentProject) INNER JOIN ((TestOrProduct INNER JOIN (tlkpPortfolioTest INNER JOIN tlkpTestCapability ON (tlkpPortfolioTest.PlanPortfolio = tlkpTestCapability.PlanPortfolio) AND (tlkpPortfolioTest.TestCode = tlkpTestCapability.TestCode)) ON TestOrProduct.ItemCode = tlkpPortfolioTest.TestCode) INNER JOIN (tlkpMonth INNER JOIN MonthlyOutput ON tlkpMonth.AccntsPeriod = MonthlyOutput.Month) ON (tlkpTestCapability.WorkGroup = MonthlyOutput.WorkGroup) AND (tlkpTestCapability.TestCode = MonthlyOutput.TestCode)) ON tlkpProject.ParentProject = tlkpPortfolioTest.PlanPortfolio) ON WorkGroup.WorkGroup = tlkpProject.ProjectWorkGroup
WHERE ((ProjectMonthFinal.MonthNo=5))
GROUP BY ProjectMonthFinal.MonthNo, WorkGroup.WorkGroup, tlkpProject.ParentProject, tlkpProject.ProjectTitle, tlkpPortfolioTest.TestCode, tlkpPortfolioTest.TotalCost, TestOrProduct.ItemDescription
PIVOT tlkpMonth.MonthName In ("April","May","June","July","August","September","October","November","December","January","February","March");

