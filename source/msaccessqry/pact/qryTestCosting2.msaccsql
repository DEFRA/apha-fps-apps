QUERY NAME: qryTestCosting2
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW qryTestCosting1.ProfitCentre, qryTestCosting1.PlanPortfolio, qryTestCosting3.SumOfVolume AS Volume, qryTestCosting3.CumCost AS TotalCost, IIf(IsNull([SpreadCost]),0,[spreadcost]) AS Spread, IIf(IsNull([volume]),0,[spread]/[Volume]) AS UnitSpread, qryTestCosting1.TestCode, TestOrProduct.ItemDescription, IIf(IsNull([SumOfCost]),0,[sumofcost]) AS TestCost, Sum(MonthlyOutput.Volume) AS TestVol, IIf(IsNull([testvol]) Or ([testcost]=0),0,[TestCost]/[TestVol]) AS UnitCost, [UnitCost]+[UnitSpread] AS TotalUnitCost, IIf(IsNull([testvol]),0,[TotalUnitCost]*[TestVol]) AS TotRecovery
FROM ((((qryTestCosting1 LEFT JOIN tlkpTestCapability ON (qryTestCosting1.PlanPortfolio = tlkpTestCapability.PlanPortfolio) AND (qryTestCosting1.TestCode = tlkpTestCapability.TestCode)) LEFT JOIN qryTestCosting4 ON qryTestCosting1.PlanPortfolio = qryTestCosting4.Portfolio) LEFT JOIN qryTestCosting3 ON qryTestCosting1.PlanPortfolio = qryTestCosting3.PlanPortfolio) LEFT JOIN MonthlyOutput ON (tlkpTestCapability.WorkGroup = MonthlyOutput.WorkGroup) AND (tlkpTestCapability.TestCode = MonthlyOutput.TestCode)) INNER JOIN TestOrProduct ON qryTestCosting1.TestCode = TestOrProduct.ItemCode
GROUP BY qryTestCosting1.ProfitCentre, qryTestCosting1.PlanPortfolio, qryTestCosting3.SumOfVolume, qryTestCosting3.CumCost, IIf(IsNull([SpreadCost]),0,[spreadcost]), qryTestCosting1.TestCode, TestOrProduct.ItemDescription, IIf(IsNull([SumOfCost]),0,[sumofcost])
HAVING ((qryTestCosting1.ProfitCentre=[Enter PC]));

