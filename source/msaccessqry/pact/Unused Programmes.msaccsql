QUERY NAME: Unused Programmes
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpProgram.ProgramNo, tlkpProgram.ProgramName, tlkpProgram.Directorate, Count(tlkpProject.ParentProject) AS CountOfParentProject
FROM tlkpProject RIGHT JOIN tlkpProgram ON tlkpProject.Program = tlkpProgram.ProgramNo
GROUP BY tlkpProgram.ProgramNo, tlkpProgram.ProgramName, tlkpProgram.Directorate
ORDER BY Count(tlkpProject.ParentProject) DESC;

