QUERY NAME: JF Vetpivot
---------------------------------------------
TYPE: SELECT

SQL:
SELECT TimeCostCalcs.Name, tlkpProject.Program, TimeCostCalcs.GradeCode, Sum(TimeCostCalcs.Time) AS SumOfTime, TimeCostCalcs.WorkGroup
FROM TimeCostCalcs INNER JOIN tlkpProject ON TimeCostCalcs.Project = tlkpProject.ParentProject
GROUP BY TimeCostCalcs.Name, tlkpProject.Program, TimeCostCalcs.GradeCode, TimeCostCalcs.WorkGroup
HAVING (((TimeCostCalcs.GradeCode) Like "b*" Or (TimeCostCalcs.GradeCode) Like "c*") AND ((TimeCostCalcs.WorkGroup) Like "SV*"));

