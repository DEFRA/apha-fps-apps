QUERY NAME: IgProjectTotals
---------------------------------------------
TYPE: MAKE TABLE

SQL:
SELECT DISTINCTROW tlkpProgram.Directorate, tlkpProgram.ProgramNo, qryJobCodeTotals.JobCode AS ParentProject, Sum(qryJobCodeTotals.JCTotalAdditionalCosts) AS SumOfJCTotalAdditionalCosts, Sum(qryJobCodeTotals.JCTotalAnimalCosts) AS SumOfJCTotalAnimalCosts, Sum(qryJobCodeTotals.JCTotalStaffCosts) AS SumOfJCTotalStaffCosts, Sum(qryJobCodeTotals.JCTotaLTestCosts) AS SumOfJCTotaLTestCosts, Sum(qryJobCodeTotals.TotalCosts) AS SumOfTotalCosts, Sum(qryJobCodeTotals.JCProfit) AS PlannedCont, Sum(qryJobCodeTotals.Income) AS SumOfIncome, Sum(qryJobCodeTotals.TransferIncome) AS SumOfTransferIncome INTO ProjectTotals
FROM qryJobCodeTotals INNER JOIN tlkpProgram ON qryJobCodeTotals.Program = tlkpProgram.ProgramNo
GROUP BY tlkpProgram.Directorate, tlkpProgram.ProgramNo, qryJobCodeTotals.JobCode
HAVING ((tlkpProgram.ProgramNo Not Like ("ZT*")))
ORDER BY tlkpProgram.ProgramNo;

