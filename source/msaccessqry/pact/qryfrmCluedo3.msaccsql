QUERY NAME: qryfrmCluedo3
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(TimeCostCalcs.Time) AS SumOfTime
SELECT WorkGroup.ProfitCentre, WorkGroup.WorkGroup, tlkpProject.ParentProject, tlkpProject.ProjectTitle, Sum(TimeCostCalcs.Time) AS SumOfTime1, Sum(TimeCostCalcs.Cost) AS SumOfCost
FROM tlkpProject INNER JOIN (tlkpMonth INNER JOIN (((WorkGroup INNER JOIN WorkGroupGrade ON WorkGroup.WorkGroup = WorkGroupGrade.WorkGroup) INNER JOIN tblStaff ON WorkGroupGrade.WG_Grade = tblStaff.WorkGroupGrade) INNER JOIN TimeCostCalcs ON tblStaff.PACTid = TimeCostCalcs.StaffID) ON tlkpMonth.AccntsPeriod = TimeCostCalcs.Month) ON tlkpProject.ParentProject = TimeCostCalcs.Project
GROUP BY WorkGroup.ProfitCentre, WorkGroup.WorkGroup, tlkpProject.ParentProject, tlkpProject.ProjectTitle
PIVOT tlkpMonth.MonthName In ("April","May","June","July","August","September","October","November","December","January","February","March");

