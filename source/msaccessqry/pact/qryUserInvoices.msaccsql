QUERY NAME: qryUserInvoices
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(Proj_Invoice.Amount) AS SumOfAmount
SELECT tlkpProject.Program, tlkpProject.ParentProject
FROM tlkpProject INNER JOIN Proj_Invoice ON tlkpProject.ParentProject = Proj_Invoice.ProjectParent
GROUP BY tlkpProject.Program, tlkpProject.ParentProject
ORDER BY tlkpProject.Program, tlkpProject.ParentProject
PIVOT Proj_Invoice.Month;

