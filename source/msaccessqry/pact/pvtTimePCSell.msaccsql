QUERY NAME: pvtTimePCSell
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW WorkGroup.ProfitCentre, WorkGroup.WorkGroup, TimeCostCalcs.GradeCode, TimeCostCalcs.Name, tlkpProject.ParentProject, TimeCostCalcs.JobCode, Sum(TimeCostCalcs.Time) AS SumOfTime, Sum(TimeCostCalcs.Cost) AS SumOfCost
FROM WorkGroup INNER JOIN (tlkpProject INNER JOIN TimeCostCalcs ON tlkpProject.ParentProject = TimeCostCalcs.Project) ON WorkGroup.WorkGroup = TimeCostCalcs.WorkGroup
GROUP BY WorkGroup.ProfitCentre, WorkGroup.WorkGroup, TimeCostCalcs.GradeCode, TimeCostCalcs.Name, tlkpProject.ParentProject, TimeCostCalcs.JobCode
HAVING (((WorkGroup.ProfitCentre)=[Forms]![frmSplash]![ProfitCentrePick]));

