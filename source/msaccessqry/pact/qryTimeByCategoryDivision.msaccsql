QUERY NAME: qryTimeByCategoryDivision
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(TimeCostCalcs.Time) AS SumOfTime
SELECT tblkpProfitCentre.Division, tblkpProfitCentre.ProfitCentre, tblPeriod.PeriodName, Sum(TimeCostCalcs.Time) AS TotalTime
FROM (tblkPeriodMonth INNER JOIN (tblkpProfitCentre RIGHT JOIN (tlkpProject INNER JOIN ((TimeCostCalcs INNER JOIN TimeCodeValid ON (TimeCodeValid.ParentProject = TimeCostCalcs.Project) AND (TimeCostCalcs.JobCode = TimeCodeValid.TimeCode) AND (TimeCostCalcs.WorkGroup = TimeCodeValid.WorkGroup)) LEFT JOIN WorkGroup ON TimeCostCalcs.WorkGroup = WorkGroup.WorkGroup) ON tlkpProject.ParentProject = TimeCodeValid.ParentProject) ON tblkpProfitCentre.ProfitCentre = WorkGroup.ProfitCentre) ON tblkPeriodMonth.MonthNo = TimeCostCalcs.Month) INNER JOIN tblPeriod ON tblkPeriodMonth.EndMonth = tblPeriod.EndPeriod
WHERE ((tblPeriod.EndPeriod=[forms]![menu-division]![periodpick]))
GROUP BY tblkpProfitCentre.Division, tblkpProfitCentre.ProfitCentre, tblPeriod.PeriodName, tblPeriod.EndPeriod
PIVOT IIf([timecode] Like "cn*","Consultancy",[PlanCat]) In ("Consultancy","CoreCapacity","TestActivity","Production","OtherAHVG","CSG","OtherMAFF","OtherGovt","Commercial","ZTleave","ZTwork","Pending");

