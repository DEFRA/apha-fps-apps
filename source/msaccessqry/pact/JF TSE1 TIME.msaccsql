QUERY NAME: JF TSE1 TIME
---------------------------------------------
TYPE: SELECT

SQL:
SELECT tlkpJobCode.ParentProject, TimeCostCalcs.JobCode, tlkpJobCode.JobCodeName, TimeCostCalcs.Month, TimeCostCalcs.Name, TimeCostCalcs.WorkGroup, TimeCostCalcs.Time, TimeCostCalcs.ChargeRate, Sum(TimeCostCalcs.Cost) AS SumOfCost, TimeCostCalcs.Overhead
FROM (TimeCostCalcs INNER JOIN tlkpJobCode ON TimeCostCalcs.JobCode = tlkpJobCode.JobCode) INNER JOIN tlkpProject ON tlkpJobCode.ParentProject = tlkpProject.ParentProject
GROUP BY tlkpJobCode.ParentProject, TimeCostCalcs.JobCode, tlkpJobCode.JobCodeName, TimeCostCalcs.Month, TimeCostCalcs.Name, TimeCostCalcs.WorkGroup, TimeCostCalcs.Time, TimeCostCalcs.ChargeRate, TimeCostCalcs.Overhead
HAVING (((TimeCostCalcs.WorkGroup) Like "TSE1*"));

