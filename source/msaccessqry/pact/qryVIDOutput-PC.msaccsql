QUERY NAME: qryVIDOutput-PC
---------------------------------------------
TYPE: OTHER

SQL:
PARAMETERS forms![menu-division]!pcpick Text ( 255 );
TRANSFORM Sum(MonthlyOutput.Volume) AS SumOfVolume
SELECT tblkpProfitCentre.ProfitCentre, MonthlyOutput.TestCode, TestOrProduct.ItemDescription AS Description, MonthlyOutput.Buyer AS Requirement
FROM (tlkpDivision INNER JOIN tblkpProfitCentre ON tlkpDivision.DivName = tblkpProfitCentre.Division) INNER JOIN (TestOrProduct INNER JOIN (WorkGroup INNER JOIN MonthlyOutput ON WorkGroup.WorkGroup = MonthlyOutput.WorkGroup) ON TestOrProduct.ItemCode = MonthlyOutput.TestCode) ON tblkpProfitCentre.ProfitCentre = WorkGroup.ProfitCentre
WHERE ((tblkpProfitCentre.ProfitCentre=[Forms]![Menu-Division]![PCpick]))
GROUP BY tblkpProfitCentre.ProfitCentre, MonthlyOutput.TestCode, TestOrProduct.ItemDescription, MonthlyOutput.Buyer
ORDER BY MonthlyOutput.TestCode, MonthlyOutput.Buyer
PIVOT MonthlyOutput.Month In (1,2,3,4);

