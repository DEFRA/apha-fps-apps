QUERY NAME: qryJobMonth-Single-Test
---------------------------------------------
TYPE: APPEND

SQL:
INSERT INTO ProjectMonth2 ( Project, MonthNo, CostProfile, Subcontracts, Animals, NonAnimal, TimeCosts, TransferCosts, TotalCost, Invoices, COIW, SumOfCostProfile, PortSales, MstoneDue, Due__Done, OnTime )
SELECT DISTINCTROW ProjectMonth.Project, ProjectMonth.MonthNo, ProjectMonth.CostProfile, IIf(IsNull([total]),0,[total]) AS Subcontracts, dbo_qryJobMonth_SubContracts.Animals, IIf(IsNull([Other]),0,[other]) AS NonAnimal, IIf(IsNull([sumofcost]),0,[sumofcost]) AS TimeCosts, IIf(IsNull([SumOfTransferCost]),0,[sumoftransfercost]) AS TransferCosts, [subcontracts]+[timecosts]+[transfercosts] AS TotalCost, IIf(IsNull([SumOfAmount1]),0,[sumofamount1]) AS Invoices, IIf(IsNull([WorkCost]),0,[workcost]) AS COIW, dbo_qryJobMonth_TotProfile.SumOfCostProfile, IIf(IsNull([Fee]),0,[fee]) AS PortSales, dbo_qryJobMonthMilestone.MstoneDue, dbo_qryJobMonthMilestone.Due__Done, dbo_qryJobMonthMilestone.OnTime
FROM ((((((ProjectMonth LEFT JOIN dbo_qryJobMonth_SubContracts ON (ProjectMonth.MonthNo = dbo_qryJobMonth_SubContracts.Month) AND (ProjectMonth.Project = dbo_qryJobMonth_SubContracts.Project)) LEFT JOIN dbo_qryJobMonth_Time ON (ProjectMonth.MonthNo = dbo_qryJobMonth_Time.Month) AND (ProjectMonth.Project = dbo_qryJobMonth_Time.Project)) LEFT JOIN dbo_qryJobMonth_TotProfile ON ProjectMonth.Project = dbo_qryJobMonth_TotProfile.Project) LEFT JOIN dbo_qryJobMonthMilestone ON (ProjectMonth.MonthNo = dbo_qryJobMonthMilestone.DueMonth) AND (ProjectMonth.Project = dbo_qryJobMonthMilestone.Project)) LEFT JOIN dbo_qryJobMonthPortfolioSales ON (ProjectMonth.MonthNo = dbo_qryJobMonthPortfolioSales.Month) AND (ProjectMonth.Project = dbo_qryJobMonthPortfolioSales.PlanPortfolio)) LEFT JOIN dbo_qryJobMonth_Invoices ON (ProjectMonth.MonthNo = dbo_qryJobMonth_Invoices.Month) AND (ProjectMonth.Project = dbo_qryJobMonth_Invoices.ProjectParent)) LEFT JOIN dbo_qryJobMonth_Transfers2 ON (ProjectMonth.Project = dbo_qryJobMonth_Transfers2.Project) AND (ProjectMonth.MonthNo = dbo_qryJobMonth_Transfers2.Month);

