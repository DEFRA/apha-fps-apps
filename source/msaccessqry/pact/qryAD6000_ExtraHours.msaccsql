QUERY NAME: qryAD6000_ExtraHours
---------------------------------------------
TYPE: APPEND

SQL:
INSERT INTO tempMonthlyTime_TransformFinal ( ParentProject, TimeCode, [Month], Hours, PACTStaffID, WorkGroup )
SELECT qptAD6000_FF_Contract_Subs.Final_Contract, tblMTConversion.NewCode, qptAD6000_FF_Contract_Subs.FMonth, [extrahours]*[No_Subs]/[Total_No_Subs] AS ExtraContractHours, BESettingsGet("AD6000_ID") AS Expr1, BESettingsGet("AD6000_WG") AS Expr2
FROM ((qptAD6000_FF_Contract_Subs INNER JOIN qryAD6000_FF_TotalSubs ON (qptAD6000_FF_Contract_Subs.VIC_DR_Year = qryAD6000_FF_TotalSubs.VIC_DR_Year) AND (qptAD6000_FF_Contract_Subs.VIC_DR_Month = qryAD6000_FF_TotalSubs.VIC_DR_Month)) INNER JOIN qryAD6000_Hours ON qptAD6000_FF_Contract_Subs.FMonth = qryAD6000_Hours.Month) INNER JOIN tblMTConversion ON qptAD6000_FF_Contract_Subs.Final_Contract = tblMTConversion.NewProject
WHERE (((qptAD6000_FF_Contract_Subs.FMonth)<=GetgVarFMonth()) AND ((qptAD6000_FF_Contract_Subs.FYear)=GetgVarFYear()));

