QUERY NAME: PortfolioVolumes
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpPortfolioTest.TestCode, tlkpPortfolioTest.PlanPortfolio, tlkpTestCapability.WorkGroup, tlkpTestCapability.WGTestCode, Sum(MonthlyOutput.Volume) AS SumOfVolume
FROM (tlkpPortfolioTest LEFT JOIN tlkpTestCapability ON (tlkpPortfolioTest.PlanPortfolio = tlkpTestCapability.PlanPortfolio) AND (tlkpPortfolioTest.TestCode = tlkpTestCapability.TestCode)) LEFT JOIN MonthlyOutput ON (tlkpTestCapability.WorkGroup = MonthlyOutput.WorkGroup) AND (tlkpTestCapability.TestCode = MonthlyOutput.TestCode)
GROUP BY tlkpPortfolioTest.TestCode, tlkpPortfolioTest.PlanPortfolio, tlkpTestCapability.WorkGroup, tlkpTestCapability.WGTestCode
ORDER BY Sum(MonthlyOutput.Volume);

