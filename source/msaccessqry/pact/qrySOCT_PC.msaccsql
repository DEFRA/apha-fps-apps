QUERY NAME: qrySOCT_PC
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW WorkGroup.ProfitCentre, Sum([chargerate]*[time]) AS Cost
FROM TimeCostCalcs INNER JOIN WorkGroup ON TimeCostCalcs.WorkGroup = WorkGroup.WorkGroup
WHERE ((TimeCostCalcs.Class="charge") AND (TimeCostCalcs.Month<=[Forms]![Menu-Division]![PeriodPick]))
GROUP BY WorkGroup.ProfitCentre;

