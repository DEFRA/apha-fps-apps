QUERY NAME: qryrptAHVGgraph1
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tblkPeriodMonth.PeriodName, MonthlyOutput.Buyer, tblkPeriodMonth.EndMonth, MonthlyOutput.TestCode, Sum(MonthlyOutput.Volume) AS ActualVol
FROM tlkpTestCapability INNER JOIN (tblkPeriodMonth INNER JOIN MonthlyOutput ON tblkPeriodMonth.MonthNo = MonthlyOutput.Month) ON (tlkpTestCapability.WorkGroup = MonthlyOutput.WorkGroup) AND (tlkpTestCapability.TestCode = MonthlyOutput.TestCode)
GROUP BY tblkPeriodMonth.PeriodName, MonthlyOutput.Buyer, tblkPeriodMonth.EndMonth, MonthlyOutput.TestCode
ORDER BY MonthlyOutput.Buyer, tblkPeriodMonth.EndMonth;

