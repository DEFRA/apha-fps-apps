QUERY NAME: qryUtilisationWGGraph
---------------------------------------------
TYPE: OTHER

SQL:
PARAMETERS Reports!rptUtilisationWG!WorkGroup Text ( 255 );
TRANSFORM Sum(TimeCostCalcs.Time) AS SumOfTime
SELECT TimeCostCalcs.WorkGroup
FROM tlkpProject INNER JOIN (TimeCostCalcs INNER JOIN TimeCodeValid ON (TimeCostCalcs.WorkGroup = TimeCodeValid.WorkGroup) AND (TimeCostCalcs.JobCode = TimeCodeValid.TimeCode)) ON tlkpProject.ParentProject = TimeCodeValid.ParentProject
WHERE ((TimeCostCalcs.WorkGroup=[Reports]![rptUtilisationWG]![WorkGroup]))
GROUP BY TimeCostCalcs.WorkGroup
PIVOT tlkpProject.Program;

