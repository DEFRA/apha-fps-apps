QUERY NAME: qryVID-PC
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tlkpDivision.DivName, tblkpProfitCentre.ProfitCentre
FROM tlkpDivision INNER JOIN tblkpProfitCentre ON tlkpDivision.DivName = tblkpProfitCentre.Division
WHERE ((tlkpDivision.DivName="VID"))
ORDER BY tblkpProfitCentre.ProfitCentre;

