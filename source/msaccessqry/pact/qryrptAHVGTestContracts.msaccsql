QUERY NAME: qryrptAHVGTestContracts
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(MonthlyOutput.Volume) AS SumOfVolume
SELECT tlkpTestReqmt.Buyer, tlkpProject.ProjectTitle, tlkpProject.Budget_Ext, tlkpTestReqmt.TestCode, TestOrProduct.ItemDescription, tlkpTestReqmt.NoRequired, Sum(MonthlyOutput.Volume) AS TotVol, IIf([Norequired]=0,Null,Format([TotVol]/[NoRequired],"0%")) AS [YTD %]
FROM tlkpProject INNER JOIN ((tlkpMonth RIGHT JOIN (tlkpTestReqmt LEFT JOIN MonthlyOutput ON (tlkpTestReqmt.Buyer = MonthlyOutput.Buyer) AND (tlkpTestReqmt.TestCode = MonthlyOutput.TestCode)) ON tlkpMonth.AccntsPeriod = MonthlyOutput.Month) INNER JOIN TestOrProduct ON tlkpTestReqmt.TestCode = TestOrProduct.ItemCode) ON tlkpProject.ParentProject = tlkpTestReqmt.Buyer
WHERE ((tlkpProject.Program Like "*_SURV"))
GROUP BY tlkpTestReqmt.Buyer, tlkpProject.ProjectTitle, tlkpProject.Budget_Ext, tlkpTestReqmt.TestCode, TestOrProduct.ItemDescription, tlkpTestReqmt.NoRequired
PIVOT tlkpMonth.MonthName In ("April","May","June","July","August","September","October","November","December","January","February","March");

