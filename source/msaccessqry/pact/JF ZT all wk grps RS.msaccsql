QUERY NAME: JF ZT all wk grps RS
---------------------------------------------
TYPE: SELECT

SQL:
SELECT TimeCostCalcs.JobCode, tlkpJobCode.JobCodeName, TimeCostCalcs.Month, TimeCostCalcs.Name, WorkGroup.CostCentre, TimeCostCalcs.WorkGroup, Sum(TimeCostCalcs.Time) AS SumOfTime, TimeCostCalcs.ChargeRate, Sum(TimeCostCalcs.Cost) AS SumOfCost, TimeCostCalcs.Overhead
FROM ((TimeCostCalcs INNER JOIN tlkpJobCode ON TimeCostCalcs.JobCode = tlkpJobCode.JobCode) INNER JOIN tlkpProject ON tlkpJobCode.ParentProject = tlkpProject.ParentProject) INNER JOIN WorkGroup ON TimeCostCalcs.WorkGroup = WorkGroup.WorkGroup
GROUP BY TimeCostCalcs.JobCode, tlkpJobCode.JobCodeName, TimeCostCalcs.Month, TimeCostCalcs.Name, WorkGroup.CostCentre, TimeCostCalcs.WorkGroup, TimeCostCalcs.ChargeRate, TimeCostCalcs.Overhead
HAVING (((TimeCostCalcs.JobCode) Like "ZT0*"));

