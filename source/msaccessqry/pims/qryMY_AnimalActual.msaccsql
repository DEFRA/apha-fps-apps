QUERY NAME: qryMY_AnimalActual
---------------------------------------------
TYPE: SELECT

SQL:
SELECT MY_Proj_SubContract.Year, MY_Proj_SubContract.Project, MY_Proj_SubContract.Month, MY_Proj_SubContract.AcctCode, MY_Proj_SubContract.Amount, MY_Proj_SubContract.Description, MY_Proj_SubContract.DailyRate, MY_Proj_SubContract.AnimalDays
FROM MY_Proj_SubContract
WHERE (((MY_Proj_SubContract.AcctCode) In ("LargeAnimals","SmallAnimals","Mice")));

