QUERY NAME: qryAHWDG_InvoicesForMonth
---------------------------------------------
TYPE: SELECT

SQL:
SELECT tblRadTrackInvoice.Contract, Sum(tblRadTrackInvoice.PlannedAmount) AS TotalPrice, Sum(tblRadTrackInvoice.DueAmount) AS DueAmount, Sum(tblRadTrackInvoice.ActualAmount) AS AmountInvoiced, Sum((Not [InvoicePaid])) AS Unpaid, Max(tblRadTrackInvoice.DateJobsheetRaised) AS LastDateJobsheetRaised, tblRadTrackInvoice.InvoiceRef, Sum(qryContractInvoiceTotals.SumOfActualAmount) AS ActualAmount
FROM (MY_tblContract INNER JOIN tblRadTrackInvoice ON MY_tblContract.ContractNo = tblRadTrackInvoice.Contract) LEFT JOIN qryContractInvoiceTotals ON tblRadTrackInvoice.Contract = qryContractInvoiceTotals.Contract
WHERE (((MY_tblContract.Year) Is Null Or (MY_tblContract.Year)=fnReportYear()) AND ((fnInReportMonth([Duedate]))=True))
GROUP BY tblRadTrackInvoice.Contract, tblRadTrackInvoice.InvoiceRef;

