QUERY NAME: qryMilestoneSummary
---------------------------------------------
TYPE: SELECT

SQL:
SELECT MY_tlkpProject.Program, tblMilestone.Project, MY_tlkpProject.Manager, Sum(IIf(IsNull([DateCompleted]),0,1)) AS No_Completed, Sum(IIf(fnInReportMonthOrBefore([DateDue]),1,0)) AS No_Due, MY_tlkpProject.Customer, G_tlkpProject.Contract, MY_tlkpProject.ProjectGroup
FROM (MY_tlkpProject INNER JOIN tblMilestone ON MY_tlkpProject.ParentProject = tblMilestone.Project) INNER JOIN G_tlkpProject ON MY_tlkpProject.ParentProject = G_tlkpProject.ParentProject
WHERE (((MY_tlkpProject.Year)=fnReportYear()) AND ((MY_tlkpProject.Manager) Like fnGetHiddenManager()) AND ((fnInFinancialYear([DateDue]))=True))
GROUP BY MY_tlkpProject.Program, tblMilestone.Project, MY_tlkpProject.Manager, MY_tlkpProject.Customer, G_tlkpProject.Contract, MY_tlkpProject.ProjectGroup
HAVING (((IsEU_Project([project]))=False));

