QUERY NAME: SM_MonthlyExpenditure
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM Sum(MY_TimeCostCalcs.Time) AS SumOfTime
SELECT MY_TimeCostCalcs.WorkGroup, MY_TimeCostCalcs.GradeCode, MY_TimeCostCalcs.ChargeRate, Sum([MY_TimeCostCalcs]![Time]) AS Total
FROM MY_TimeCostCalcs INNER JOIN MY_tlkpProject ON (MY_TimeCostCalcs.Project = MY_tlkpProject.ParentProject) AND (MY_TimeCostCalcs.Year = MY_tlkpProject.Year)
WHERE (((MY_TimeCostCalcs.Year)=2007) AND ((MY_TimeCostCalcs.Project)="SB4022"))
GROUP BY MY_TimeCostCalcs.WorkGroup, MY_TimeCostCalcs.GradeCode, MY_TimeCostCalcs.ChargeRate
ORDER BY MY_TimeCostCalcs.WorkGroup
PIVOT MY_TimeCostCalcs.Month;

