QUERY NAME: qryReportPickProgram
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW MY_tlkpProject.Program
FROM MY_tlkpProject INNER JOIN tblRadTrackProg ON MY_tlkpProject.Program = tblRadTrackProg.Program
GROUP BY MY_tlkpProject.Program
HAVING (((MY_tlkpProject.Program) Is Not Null))
ORDER BY MY_tlkpProject.Program;

