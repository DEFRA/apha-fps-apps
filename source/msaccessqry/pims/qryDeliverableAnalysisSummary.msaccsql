QUERY NAME: qryDeliverableAnalysisSummary
---------------------------------------------
TYPE: SELECT

SQL:
SELECT qryDeliverableAnalysis.Program, qryDeliverableAnalysis.IDType, Sum(qryDeliverableAnalysis.DueThisYear) AS DueThisYear, Sum(qryDeliverableAnalysis.DueNow) AS DueNow, Sum(qryDeliverableAnalysis.Met) AS Met, Sum(qryDeliverableAnalysis.MetAheadOfSchedule) AS MetAheadOfSchedule, Sum(qryDeliverableAnalysis.MetOnTime) AS MetOnTime, Sum(qryDeliverableAnalysis.DueUnderReview) AS DueUnderReview, Sum(qryDeliverableAnalysis.DueNotUnderReview) AS DueNotUnderReview, Sum(qryDeliverableAnalysis.Unreported) AS Unreported
FROM qryDeliverableAnalysis
WHERE (((qryDeliverableAnalysis.Manager) Like fnGetHiddenManager()) AND ((qryDeliverableAnalysis.Customer) Like fnSummaryCustomer()) AND ((qryDeliverableAnalysis.Contract) Like fnSummaryContract()))
GROUP BY qryDeliverableAnalysis.Program, qryDeliverableAnalysis.IDType;

