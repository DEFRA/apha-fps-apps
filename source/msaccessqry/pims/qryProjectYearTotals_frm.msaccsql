QUERY NAME: qryProjectYearTotals_frm
---------------------------------------------
TYPE: SELECT

SQL:
SELECT vPactProjectYearCosts.Project, Sum(vPactProjectYearCosts.SubContracts) AS SubContracts, Sum(vPactProjectYearCosts.Animals) AS Animals, Sum(vPactProjectYearCosts.Tests) AS Tests, Sum(vPactProjectYearCosts.Pay) AS Pay, Sum(vPactProjectYearCosts.NonPayOH) AS NonPayOH, Sum(vPactProjectYearCosts.Hours) AS Hours, Sum(vPactProjectYearCosts.TimeCost) AS TimeCost, Sum(vPactProjectYearCosts.TotalCosts) AS TotalCosts, MY_tlkpProject.Year, MY_tlkpProject.CustIncome, MY_tlkpProject.Budget_CVL
FROM vPactProjectYearCosts INNER JOIN MY_tlkpProject ON (vPactProjectYearCosts.Project = MY_tlkpProject.ParentProject) AND (vPactProjectYearCosts.Year = MY_tlkpProject.Year)
GROUP BY vPactProjectYearCosts.Project, MY_tlkpProject.Year, MY_tlkpProject.CustIncome, MY_tlkpProject.Budget_CVL
HAVING (((vPactProjectYearCosts.Project)=[Forms]![frmProjectRadTrackData_Update]![Project]) AND ((MY_tlkpProject.Year)=[Forms]![frmProjectRadTrackData_Update]![Year]));

