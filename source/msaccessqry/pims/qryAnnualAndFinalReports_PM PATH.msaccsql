QUERY NAME: qryAnnualAndFinalReports_PM PATH
---------------------------------------------
TYPE: SELECT

SQL:
SELECT qryMY_RadtrackReports.Year, qryMY_RadtrackReports.Program, qryMY_RadtrackReports.Project, qryMY_RadtrackReports.Type, G_tlkpProject.ProjectTitle, qryMY_RadtrackReports.RepDueDate, qryMY_RadtrackReports.EmailedToCustomer, 1 AS Due, (Not IsNull([EmailedToCustomer]))*-1 AS Sub, IIf([EmailedToCustomer]<=[RepDueDate],1,0) AS SubOnTime, G_tlkpProject.Contract, qryMY_RadtrackReports.Customer, qryMY_RadtrackReports.Manager
FROM (G_tlkpProject INNER JOIN qryMY_RadtrackReports ON G_tlkpProject.ParentProject = qryMY_RadtrackReports.Project) INNER JOIN dbo_vtblStaff_General ON qryMY_RadtrackReports.Manager = dbo_vtblStaff_General.Name
WHERE (((dbo_vtblStaff_General.WorkGroupGrade) Like "*PA*"))
GROUP BY qryMY_RadtrackReports.Year, qryMY_RadtrackReports.Program, qryMY_RadtrackReports.Project, qryMY_RadtrackReports.Type, G_tlkpProject.ProjectTitle, qryMY_RadtrackReports.RepDueDate, qryMY_RadtrackReports.EmailedToCustomer, 1, (Not IsNull([EmailedToCustomer]))*-1, IIf([EmailedToCustomer]<=[RepDueDate],1,0), G_tlkpProject.Contract, qryMY_RadtrackReports.Customer, qryMY_RadtrackReports.Manager
HAVING (((qryMY_RadtrackReports.Year)=fnReportYear()))
ORDER BY qryMY_RadtrackReports.Manager;

