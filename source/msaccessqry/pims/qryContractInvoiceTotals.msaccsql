QUERY NAME: qryContractInvoiceTotals
---------------------------------------------
TYPE: SELECT

SQL:
SELECT tblRadTrackInvoice.Contract, Sum(tblRadTrackInvoice.ActualAmount) AS SumOfActualAmount
FROM tblRadTrackInvoice
WHERE (((fnInReportMonthOrBefore([Duedate]))=True) AND ((tblRadTrackInvoice.InvoicePaid)=True))
GROUP BY tblRadTrackInvoice.Contract;

