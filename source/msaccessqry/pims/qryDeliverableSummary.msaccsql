QUERY NAME: qryDeliverableSummary
---------------------------------------------
TYPE: SELECT

SQL:
SELECT vProjectLatestDetails.Program, tblMilestone.Project, vProjectLatestDetails.Manager, Sum(IIf(IsNull([DateCompleted]),0,1)) AS No_Completed, Sum(IIf(fnInReportMonthOrBefore([DateDue]),1,0)) AS No_Due, G_tlkpProject.Contract, vProjectLatestDetails.Customer, vProjectLatestDetails.ProjectGroup
FROM (vProjectLatestDetails INNER JOIN tblMilestone ON vProjectLatestDetails.ParentProject = tblMilestone.Project) INNER JOIN G_tlkpProject ON vProjectLatestDetails.ParentProject = G_tlkpProject.ParentProject
WHERE (((vProjectLatestDetails.Manager) Like fnGetHiddenManager()) AND ((IsEU_Project([project]))=False) AND ((fnInFinancialYear([DateDue]))=True))
GROUP BY vProjectLatestDetails.Program, tblMilestone.Project, vProjectLatestDetails.Manager, G_tlkpProject.Contract, vProjectLatestDetails.Customer, vProjectLatestDetails.ProjectGroup;

