QUERY NAME: qryReportGroupReports
---------------------------------------------
TYPE: SELECT

SQL:
SELECT DISTINCTROW tblReport.ReportName, tblReport.ReportDescription, tblReport.Emailable, tblReport.AllowPickProgramme, tblReport.AllowPickProject, tblReport.AllowPickManager, tblReport.AllowPickContract, tblReport.AllowPickCustomer, tblReport.ReportHelp, tblReport.Filter, tblReportGroup_Link.GroupID
FROM tblReport LEFT JOIN tblReportGroup_Link ON tblReport.ID = tblReportGroup_Link.ReportID
WHERE (((tblReport.Type)="R"))
ORDER BY tblReport.ReportDescription, tblReport.SortOrder;

