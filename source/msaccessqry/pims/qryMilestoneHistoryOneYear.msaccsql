QUERY NAME: qryMilestoneHistoryOneYear
---------------------------------------------
TYPE: SELECT

SQL:
SELECT MY_tlkpProject.ParentProject, MY_tlkpProject.Program, MY_tlkpProject.Manager, G_tlkpProject.ProjectTitle, tblMilestone.Number, tblMilestone.Description, tblMilestone.DateDue, tblMilestone.DateCompleted, tblMilestone.OnTarget, tblMilestone.Project, MY_tlkpProject.Customer, MY_tlkpProject.ProjectGroup
FROM (tblMilestone INNER JOIN MY_tlkpProject ON tblMilestone.Project = MY_tlkpProject.ParentProject) INNER JOIN G_tlkpProject ON MY_tlkpProject.ParentProject = G_tlkpProject.ParentProject
WHERE (((MY_tlkpProject.Manager) Like fnGetHiddenManager()) AND ((MY_tlkpProject.Year)=fnYear()) AND ((IsEU_Project([project]))=False) AND ((fnDueYear([DateDue]))=fnYear()));

