QUERY NAME: qryDeliverableDetail
---------------------------------------------
TYPE: SELECT

SQL:
SELECT vProjectLatestDetails.ParentProject AS Project, vProjectLatestDetails.Program, vProjectLatestDetails.Manager, tblMilestone.Number, tblMilestone.Description, tblMilestone.DateDue, tblMilestone.DateCompleted, tblMilestone.ProjectLeaderComment, G_tlkpProject.ProjectTitle, tblMilestone.UnderSDReview, tblMilestone.OnTarget, G_tlkpProject.ParentProject, G_tlkpProject_RadTrackData.Version, G_tlkpProject.ProjectStatus AS Status
FROM tblMilestone INNER JOIN ((G_tlkpProject INNER JOIN G_tlkpProject_RadTrackData ON G_tlkpProject.ParentProject = G_tlkpProject_RadTrackData.ParentProject) INNER JOIN vProjectLatestDetails ON G_tlkpProject.ParentProject = vProjectLatestDetails.ParentProject) ON tblMilestone.Project = G_tlkpProject.ParentProject
WHERE (((vProjectLatestDetails.Manager) Like fnGetHiddenManager()) AND ((G_tlkpProject.ProjectStatus)<>"Completed") AND ((fnDueYear([DateDue]))=fnReportYear()) AND ((fnSurvProgram([projectgroup]))=True) AND ((G_tlkpProject_RadTrackData.FormRequired)=True))
ORDER BY tblMilestone.DateDue;

