QUERY NAME: qryOutturn1
---------------------------------------------
TYPE: SELECT

SQL:
SELECT MY_tlkpProject.Year, MY_tlkpProject.ParentProject, MY_tlkpProject.Program, G_tlkpProject_RadTrackData.CustomerRef, MY_tlkpProject.Customer, qryFPSFigures.CustIncome, qryFPSFigures.Pay, qryFPSFigures.NonPayOH, Sum([TotalCost]-[TimeCosts]) AS Other, MY_tlkpProject.ParentProject AS Project
FROM ((G_tlkpProject_RadTrackData INNER JOIN MY_tlkpProject ON G_tlkpProject_RadTrackData.ParentProject = MY_tlkpProject.ParentProject) INNER JOIN qryFPSFigures ON (MY_tlkpProject.ParentProject = qryFPSFigures.ParentProject) AND (MY_tlkpProject.Year = qryFPSFigures.Year)) INNER JOIN MY_ProjectMonthFinal ON (MY_tlkpProject.ParentProject = MY_ProjectMonthFinal.Project) AND (MY_tlkpProject.Year = MY_ProjectMonthFinal.Year)
WHERE (((MY_ProjectMonthFinal.MonthNo)<=fnMonthToFMonth([Forms]![frmMenuReports]![cbMonth])))
GROUP BY MY_tlkpProject.Year, MY_tlkpProject.ParentProject, MY_tlkpProject.Program, G_tlkpProject_RadTrackData.CustomerRef, MY_tlkpProject.Customer, qryFPSFigures.CustIncome, qryFPSFigures.Pay, qryFPSFigures.NonPayOH, MY_tlkpProject.ParentProject
HAVING (((MY_tlkpProject.Year)=fnReportYear()));

