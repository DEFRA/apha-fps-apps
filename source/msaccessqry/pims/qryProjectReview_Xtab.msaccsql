QUERY NAME: qryProjectReview_Xtab
---------------------------------------------
TYPE: OTHER

SQL:
TRANSFORM First(tlkpFrequency.Frequency) AS FirstOfFrequency
SELECT tblProjectReviewItems.Project, MY_tlkpProject.Year, First(G_tlkpProject_RadTrackData.RiskID) AS RiskID, First(MY_tlkpProject.Program) AS Program, First(MY_tlkpProject.Manager) AS Manager, First(G_tlkpProject_RadTrackData.StartDate) AS StartDate
FROM (((tblProjectReviewItems INNER JOIN tlkpReviewItem ON tblProjectReviewItems.ItemID = tlkpReviewItem.ItemID) INNER JOIN MY_tlkpProject ON tblProjectReviewItems.Project = MY_tlkpProject.ParentProject) INNER JOIN tlkpFrequency ON tblProjectReviewItems.FrequencyID = tlkpFrequency.FrequencyID) INNER JOIN G_tlkpProject_RadTrackData ON MY_tlkpProject.ParentProject = G_tlkpProject_RadTrackData.ParentProject
WHERE (((MY_tlkpProject.Year)=fnReportYear()))
GROUP BY tblProjectReviewItems.Project, MY_tlkpProject.Year
PIVOT tlkpReviewItem.Item;

