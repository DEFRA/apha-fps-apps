QUERY NAME: qryProgramAndCustomerMonitoring_IG
---------------------------------------------
TYPE: SELECT

SQL:
SELECT MY_tlkpProject.Year, MY_tlkpProject.ParentProject AS Project, MY_tlkpProject.ParentProject, MY_tlkpProject.Program, G_tlkpProject.ProjectTitle, MY_tlkpProject.Manager, MY_tlkpProject.ProjectStatus, MY_tlkpProject.Customer, G_tlkpProject.Contract, MY_FPSYearTotals.TotalCosts AS PlannedCosts, MY_tlkpProject.Budget_CVL, MY_tlkpProject.CustIncome, MY_ProjectMonthFinal.CumCost AS ActualCostsYTD, (IIf(([MY_tlkpProject].[Budget_CVL]=0),Null,([cumcost]/[MY_tlkpProject].[Budget_CVL]))) AS PercentOfBudget, qryPMonitoringComments.Comment AS CustomerComment, ([PCForecastSpend]*[MY_tlkpProject].[Budget_cvl]/100) AS EstimateSpend, [cumcost]*12/fnMonthToFMonth([Forms]![frmMenuReports]![cbMonth]) AS LinearSpend, G_tlkpProject_RadTrackData.PCForecastSpend, MY_tlkpProjectRadTrackData.BFBudget, nz([MY_tlkpProject].[CustIncome],0)+nz([MY_tlkpProject].[TransferIncome],0) AS TotalIncome
FROM (G_tlkpProject LEFT JOIN G_tlkpProject_RadTrackData ON G_tlkpProject.ParentProject = G_tlkpProject_RadTrackData.ParentProject) INNER JOIN ((((MY_FPSYearTotals LEFT JOIN MY_ProjectMonthFinal ON (MY_FPSYearTotals.Year = MY_ProjectMonthFinal.Year) AND (MY_FPSYearTotals.ParentProject = MY_ProjectMonthFinal.Project)) LEFT JOIN qryPMonitoringComments ON (MY_FPSYearTotals.Year = qryPMonitoringComments.Year) AND (MY_FPSYearTotals.ParentProject = qryPMonitoringComments.Project)) RIGHT JOIN MY_tlkpProject ON (MY_FPSYearTotals.Year = MY_tlkpProject.Year) AND (MY_FPSYearTotals.ParentProject = MY_tlkpProject.ParentProject)) LEFT JOIN MY_tlkpProjectRadTrackData ON (MY_tlkpProject.Year = MY_tlkpProjectRadTrackData.Year) AND (MY_tlkpProject.ParentProject = MY_tlkpProjectRadTrackData.Project)) ON G_tlkpProject.ParentProject = MY_tlkpProject.ParentProject
WHERE (((MY_tlkpProject.Year)=2007) AND ((MY_tlkpProject.Program)="end_res") AND ((MY_ProjectMonthFinal.MonthNo)=3 Or (MY_ProjectMonthFinal.MonthNo) Is Null));

