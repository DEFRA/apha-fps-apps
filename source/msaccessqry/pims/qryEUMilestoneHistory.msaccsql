QUERY NAME: qryEUMilestoneHistory
---------------------------------------------
TYPE: SELECT

SQL:
SELECT MY_tlkpProject.ParentProject, MY_tlkpProject.Program, MY_tlkpProject.Manager, G_tlkpProject.ProjectTitle, tblMilestone.Number, tblMilestone.Description, tblMilestone.DateDue, tblMilestone.DateCompleted, tblMilestone.OnTarget, tblMilestone.Project, MY_tlkpProject.Customer, G_tlkpProject_RadTrackData.StartDate, G_tlkpProject_RadTrackData.EndDate, MY_tlkpProject.ProjectGroup
FROM ((tblMilestone INNER JOIN MY_tlkpProject ON tblMilestone.Project = MY_tlkpProject.ParentProject) INNER JOIN G_tlkpProject ON MY_tlkpProject.ParentProject = G_tlkpProject.ParentProject) LEFT JOIN G_tlkpProject_RadTrackData ON G_tlkpProject.ParentProject = G_tlkpProject_RadTrackData.ParentProject
WHERE (((MY_tlkpProject.Manager) Like fnGetHiddenManager()) AND ((MY_tlkpProject.Year)=fnYear()));

