QUERY NAME: qryAnnualAndFinalReports_PM TRIAL PROJECTS
---------------------------------------------
TYPE: SELECT

SQL:
SELECT qryMY_RadtrackReports.Project, qryMY_RadtrackReports.Type, G_tlkpProject.ProjectTitle, qryMY_RadtrackReports.RepDueDate, qryMY_RadtrackReports.EmailedToCustomer, 1 AS Due, (Not IsNull([EmailedToCustomer]))*-1 AS Sub, IIf([EmailedToCustomer]<=[RepDueDate],1,0) AS SubOnTime, qryMY_RadtrackReports.Manager, G_tlkpProject_RadTrackData.StartDate, G_tlkpProject_RadTrackData.EndDate, G_tlkpProject_RadTrackData.RevisedEndDate
FROM ((G_tlkpProject INNER JOIN qryMY_RadtrackReports ON G_tlkpProject.ParentProject = qryMY_RadtrackReports.Project) INNER JOIN dbo_vtblStaff_General ON qryMY_RadtrackReports.Manager = dbo_vtblStaff_General.Name) INNER JOIN G_tlkpProject_RadTrackData ON G_tlkpProject.ParentProject = G_tlkpProject_RadTrackData.ParentProject
GROUP BY qryMY_RadtrackReports.Year, qryMY_RadtrackReports.Program, qryMY_RadtrackReports.Project, qryMY_RadtrackReports.Type, G_tlkpProject.ProjectTitle, qryMY_RadtrackReports.RepDueDate, qryMY_RadtrackReports.EmailedToCustomer, 1, (Not IsNull([EmailedToCustomer]))*-1, IIf([EmailedToCustomer]<=[RepDueDate],1,0), qryMY_RadtrackReports.Manager, G_tlkpProject_RadTrackData.StartDate, G_tlkpProject_RadTrackData.EndDate, G_tlkpProject_RadTrackData.RevisedEndDate
HAVING (((qryMY_RadtrackReports.Year)=fnYear()) AND ((qryMY_RadtrackReports.Project)="MO3007" Or (qryMY_RadtrackReports.Project)="SE0243" Or (qryMY_RadtrackReports.Project)="SE1753" Or (qryMY_RadtrackReports.Project)="SE1847" Or (qryMY_RadtrackReports.Project)="SE1849" Or (qryMY_RadtrackReports.Project)="SE1851" Or (qryMY_RadtrackReports.Project)="SE1930" Or (qryMY_RadtrackReports.Project)="SE1945" Or (qryMY_RadtrackReports.Project)="SE2007" Or (qryMY_RadtrackReports.Project)="SE2010"))
ORDER BY qryMY_RadtrackReports.Project, qryMY_RadtrackReports.Manager;

