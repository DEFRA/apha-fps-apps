QUERY NAME: qryMilestonesAchieved
---------------------------------------------
TYPE: SELECT

SQL:
SELECT MY_tlkpProject.Program, tblMilestone.Project, MY_tlkpProject.Manager, tblMilestone.Number, tblMilestone.DateCompleted, tblMilestone.CAPSComment, IIf(fnInReportMonthOrBefore([DateDue]),"","(Early)") AS DoneEarly, tblMilestone.DateDue, MY_tlkpProject.Customer, G_tlkpProject.Contract, MY_tlkpProject.ProjectGroup
FROM (tblMilestone INNER JOIN MY_tlkpProject ON tblMilestone.Project = MY_tlkpProject.ParentProject) INNER JOIN G_tlkpProject ON MY_tlkpProject.ParentProject = G_tlkpProject.ParentProject
WHERE (((MY_tlkpProject.Manager) Like fnGetHiddenManager()) AND ((MY_tlkpProject.Year)=fnReportYear()) AND ((fnInFinancialYearOrBefore([datecompleted]))=True) AND ((fnInReportMonthOrBefore([DateDue]))=True));

