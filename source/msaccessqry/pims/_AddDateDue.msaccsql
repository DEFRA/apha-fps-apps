QUERY NAME: _AddDateDue
---------------------------------------------
TYPE: APPEND

SQL:
INSERT INTO MY_Radtrack_Reports ( [Year], Project, Type, RepDueDate, Reminder1, Reminder2, ReplyReceived, SentToProgManager, SentToProjLeader, EmailedToCustomer, SignedCopyToCustomer )
SELECT [_RepDateDue].Year, [_RepDateDue].Project, [_RepDateDue].Type, [_RepDateDue].[Due Date], [_RepDateDue].Reminder1, [_RepDateDue].Reminder2, [_RepDateDue].ReplyReceived, [_RepDateDue].SentToProgManager, [_RepDateDue].SentToProjLeader, [_RepDateDue].EmailedToCustomer, [_RepDateDue].SignedCopyToCustomer
FROM _RepDateDue LEFT JOIN MY_Radtrack_Reports ON ([_RepDateDue].Type = MY_Radtrack_Reports.Type) AND ([_RepDateDue].Project = MY_Radtrack_Reports.Project) AND ([_RepDateDue].Year = MY_Radtrack_Reports.Year)
WHERE (((MY_Radtrack_Reports.Year) Is Null));

