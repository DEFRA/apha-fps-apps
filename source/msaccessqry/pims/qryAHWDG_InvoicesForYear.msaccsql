QUERY NAME: qryAHWDG_InvoicesForYear
---------------------------------------------
TYPE: SELECT

SQL:
SELECT tblRadTrackInvoice.Contract, Sum(tblRadTrackInvoice.PlannedAmount) AS TotalPrice, Sum(tblRadTrackInvoice.DueAmount) AS DueAmount, Sum(tblRadTrackInvoice.ActualAmount) AS AmountInvoiced, Sum(Not [InvoicePaid]) AS Unpaid, Sum(tblRadTrackInvoice.ActualAmount) AS ActualAmount
FROM MY_tblContract INNER JOIN tblRadTrackInvoice ON MY_tblContract.ContractNo = tblRadTrackInvoice.Contract
WHERE (((MY_tblContract.Year)=fnReportYear()) AND ((fnInReportMonthOrBefore([Duedate]))=True))
GROUP BY tblRadTrackInvoice.Contract;

