QUERY NAME: qryDeliverablesUnderReview
---------------------------------------------
TYPE: SELECT

SQL:
SELECT vProjectLatestDetails.Program, tblMilestone.Project, vProjectLatestDetails.Manager, tblMilestone.Number, tblMilestone.DateDue, tblMilestone.CAPSComment, tblMilestone.Description, tblMilestone.ProjectLeaderComment, G_tlkpProject.Contract, vProjectLatestDetails.ProjectGroup
FROM ((tblMilestone INNER JOIN vProjectLatestDetails ON tblMilestone.Project = vProjectLatestDetails.ParentProject) LEFT JOIN qryCurrentMonth_FormRecieved_Dynamic ON vProjectLatestDetails.ParentProject = qryCurrentMonth_FormRecieved_Dynamic.ParentProject) INNER JOIN G_tlkpProject ON vProjectLatestDetails.ParentProject = G_tlkpProject.ParentProject
WHERE (((vProjectLatestDetails.Manager) Like fnGetHiddenManager()) AND ((IsNull([currentMonth]))=False) AND ((fnDoneInPeriod([DateCompleted]))=False) AND ((tblMilestone.UnderSDReview)=True) AND ((fnInReportMonthOrBefore([DateDue]))=True));

