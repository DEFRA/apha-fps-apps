{
  "family": "<TASK_DEFINITION_NAME>",
  "executionRoleArn": "arn:aws:iam::<account-id>:role/devldnfps-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::<account-id>:role/devldnfps-ecs-task-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "containerDefinitions": [
    {
      "name": "<CONTAINER_NAME>",
      "image": "<account-id>.dkr.ecr.eu-west-2.amazonaws.com/apha/<service-name>:<tag>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environmentFiles": [
        {
          "type": "s3",
          "value": "arn:aws:s3:::devldnfps-env/<service>.env"
        }
      ],
      "secrets": [
        {
          "name": "ConnectionStrings__FPSConnectionString",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:<account-id>:secret:devldnfps/<service>/runtime"
        },
        {
          "name": "AzureAd__ClientId",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:<account-id>:secret:devldnfps/<service>/runtime:AzureAd__ClientId::"
        },
        {
          "name": "AzureAd__ClientSecret",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:<account-id>:secret:devldnfps/<service>/runtime:AzureAd__ClientSecret::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "devldnfps-app-<service>",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "Container"
        }
      }
    }
  ]
}
