{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.EntityFrameworkCore": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "BatchJobsConnectionString": "__REPLACE_VIA_ENV__"
  },
  "ApplicationInsights": {
    "Enabled": false,
    "InstrumentationKey": ""
  },
  "ScheduledLoadFromFps": {
    "StepTimeoutSeconds": 300,
    "CurrentYearCutoverMonth": 4
  }
}
