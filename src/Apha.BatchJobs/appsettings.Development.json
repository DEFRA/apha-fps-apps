{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.EntityFrameworkCore": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "BatchJobsConnectionString": "__REPLACE_VIA_ENV__"
  },
  "ApplicationInsights": {
    "Enabled": false,
    "InstrumentationKey": ""
  },
  "ScheduledLoadFromFps": {
    "StepTimeoutSeconds": 300,
    "CurrentYearCutoverMonth": 4
  },
  "MabArchive": {
    "LockTimeoutSeconds": 3600,
    "TransactionTimeoutSeconds": 1800,
    "StrictYearIsolation": true,
    "AdminNotificationEmail": "dev-batch-admin@localhost",
    "NotificationFromEmail": "dev-batch-jobs@localhost",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "EnableEmailNotifications": false,
    "CloudWatchLogGroup": "/local/batch-jobs",
    "ValidateLoadersAtRuntime": true,
    "VerifyLogicEquivalence": true,
    "AllowSqlFallback": false
  }
}
