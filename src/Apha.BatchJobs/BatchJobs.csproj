<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Apha.BatchJobs</RootNamespace>
    <AssemblyName>BatchJobs</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Archive\**\*.cs" />
    <Compile Remove="ReImagineAnalysis_v4\**\*.cs" />
    <Compile Remove="docs\**\*.cs" />
    <Compile Remove="docs\legacy\**\*.cs" />
    <EmbeddedResource Remove="Archive\**\*" />
    <EmbeddedResource Remove="ReImagineAnalysis_v4\**\*" />
    <EmbeddedResource Remove="docs\**\*" />
    <EmbeddedResource Remove="docs\legacy\**\*" />
    <None Include="Archive\**\*" />
    <None Include="ReImagineAnalysis_v4\**\*" />
    <None Include="docs\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

</Project>