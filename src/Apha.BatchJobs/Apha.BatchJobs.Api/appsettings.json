{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BatchJobsConnectionString": "__REPLACE_VIA_ENV__"
  },
  "BatchJobs": {
    "EnableDatabase": true,
    "MaxConcurrentJobs": 5,
    "JobTimeout": 3600,
    "RetryAttempts": 3,
    "RetryDelaySeconds": 60,
    "LockTimeoutSeconds": 3600
  },
  "AwsEcsTrigger": {
    "Cluster": "apha-batchjobs-cluster",
    "TaskDefinition": "apha-batchjobs-worker",
    "LaunchType": "FARGATE",
    "ContainerName": "batch-jobs-worker",
    "Subnets": [
      "subnet-aaaaaaaa",
      "subnet-bbbbbbbb"
    ],
    "SecurityGroups": [
      "sg-aaaaaaaa"
    ],
    "AssignPublicIp": true,
    "PlatformVersion": "LATEST",
    "PowerShellExecutable": "pwsh",
    "PowerShellScriptPath": "scripts/trigger-healthcheck.ps1"
  }
}
