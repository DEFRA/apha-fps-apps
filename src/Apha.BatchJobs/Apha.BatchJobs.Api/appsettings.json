{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BatchJobsConnectionString": "__REPLACE_VIA_ENV__"
  },
  "BatchJobs": {
    "EnableDatabase": true,
    "MaxConcurrentJobs": 5,
    "JobTimeout": 3600,
    "RetryAttempts": 3,
    "RetryDelaySeconds": 60,
    "LockTimeoutSeconds": 3600
  },
  "MabArchive": {
    "LockTimeoutSeconds": 3600,
    "TransactionTimeoutSeconds": 1800,
    "AdminNotificationEmail": "batch-admin@defra.gov.uk",
    "NotificationFromEmail": "batch-jobs@defra.gov.uk",
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "EnableEmailNotifications": true,
    "CloudWatchLogGroup": "/aws/ecs/batch-jobs"
  },
  "EventBridge": {
    "EventBusName": "default",
    "Source": "apha.batchjobs.api",
    "DetailType": "BatchJobTriggerRequested",
    "RequestedBy": "api"
  },
  "EventBridgeDispatch": {
    "Cluster": "apha-batchjobs-cluster",
    "TaskDefinition": "apha-batchjobs-worker",
    "LaunchType": "FARGATE",
    "ContainerName": "batch-jobs-worker",
    "Subnets": [
      "subnet-aaaaaaaa",
      "subnet-bbbbbbbb"
    ],
    "SecurityGroups": [
      "sg-aaaaaaaa"
    ],
    "AssignPublicIp": true,
    "PlatformVersion": "LATEST",
    "PowerShellExecutable": "pwsh",
    "PowerShellScriptPath": "docs/database/scripts/trigger-healthcheck.ps1"
  }
}
