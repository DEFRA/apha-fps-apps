{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BatchJobsConnectionString": "__REPLACE_VIA_ENV__"
  },
  "BatchJobs": {
    "EnableDatabase": true,
    "MaxConcurrentJobs": 5,
    "JobTimeout": 3600,
    "RetryAttempts": 3,
    "RetryDelaySeconds": 60,
    "LockTimeoutSeconds": 3600
  }
}
