{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "BatchJobsConnectionString": "__REPLACE_VIA_ENV__"
  },
  "BatchJobs": {
    "EnableDatabase": true
  },
  "EventBridge": {
    "EventBusName": "default",
    "Source": "apha.batchjobs.api.dev",
    "DetailType": "BatchJob.TriggerRequested",
    "RequestedBy": "api-dev"
  },
  "EventBridgeDispatch": {
    "Cluster": "apha-batchjobs-cluster-dev",
    "TaskDefinition": "apha-batchjobs-worker-dev",
    "ContainerName": "batch-jobs-worker",
    "Subnets": [
      "subnet-dev-a",
      "subnet-dev-b"
    ],
    "SecurityGroups": [
      "sg-dev-batchjobs"
    ],
    "PowerShellExecutable": "pwsh",
    "PowerShellScriptPath": "docs/database/scripts/trigger-healthcheck.ps1"
  }
}
