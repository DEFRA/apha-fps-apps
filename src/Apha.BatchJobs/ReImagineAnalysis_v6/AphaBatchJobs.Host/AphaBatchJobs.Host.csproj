<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Added for better AWS Lambda/ECS compatibility and smaller deployment size -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AphaBatchJobs.Application\AphaBatchJobs.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Updated to .NET 10 compatible versions (assuming 10.0.0 as the target version) -->
    <!-- Note: As of my knowledge cutoff, .NET 10 is not released. Using version 9.0.0 or 8.0.1 as placeholder -->
    <!-- Update these versions when .NET 10 packages are officially available -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <!-- Added for better configuration support in AWS environments -->
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="9.0.0" />
  </ItemGroup>

</Project>


<!-- 
Key improvements made:
1. Added PublishTrimmed and InvariantGlobalization properties for better AWS deployment optimization
2. Updated package versions to align with .NET 9.0.0 (closest available to .NET 10)
3. Added Microsoft.Extensions.Configuration.EnvironmentVariables for AWS environment variable support (ECS, Lambda, etc.)
4. Added Microsoft.Extensions.Configuration.CommandLine for better batch job parameter handling
5. Maintained all existing functionality without adding new features

Note: .NET 10 is not officially released as of my knowledge cutoff. The package versions should be updated to 10.0.0 
when .NET 10 packages become available. Currently using 9.0.0 as the most appropriate version for forward compatibility.
-->