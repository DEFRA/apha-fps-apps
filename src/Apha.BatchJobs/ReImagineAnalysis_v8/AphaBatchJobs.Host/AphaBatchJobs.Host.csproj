<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target framework corrected to net8.0 - .NET 10 does not exist yet, using .NET 8 LTS -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- OutputType set to Exe for executable console application -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Enable latest C# language features compatible with .NET 8 -->
    <LangVersion>latest</LangVersion>
    <!-- Generate XML documentation for better code documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress XML documentation warnings for cleaner build output -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Enable deterministic builds for CI/CD reproducibility in AWS ECS Fargate environments -->
    <Deterministic>true</Deterministic>
    <!-- Enable continuous integration build mode for better reproducibility -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Treat warnings as errors in Release builds for production quality on AWS -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <!-- Enable NuGet package validation for better package quality -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Enable trimming warnings for AWS ECS Fargate optimization -->
    <IsTrimmable>true</IsTrimmable>
    <!-- Optimize for Docker container deployment - disabled for compatibility -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Disabled ReadyToRun for cross-platform Docker compatibility -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Enable invariant globalization for smaller container images and better performance -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to Application project for service interfaces and business logic -->
    <ProjectReference Include="..\AphaBatchJobs.Application\AphaBatchJobs.Application.csproj" />
    <!-- Reference to Infrastructure project for service registration and database context -->
    <ProjectReference Include="..\AphaBatchJobs.Infrastructure\AphaBatchJobs.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Hosting version 8.0.0 for Generic Host support aligned with .NET 8 -->
    <!-- This provides the Host.CreateDefaultBuilder functionality required by Program.cs -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <!-- Microsoft.Extensions.Logging.Console version 8.0.0 for console logging support -->
    <!-- This enables console output for batch job execution logs in AWS ECS Fargate -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include appsettings.json files for configuration -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

