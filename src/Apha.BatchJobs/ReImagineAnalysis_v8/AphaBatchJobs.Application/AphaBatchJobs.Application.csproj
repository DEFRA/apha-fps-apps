<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target framework set to net8.0 as per Dotnet8 technical stack requirement -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Enable latest C# language features compatible with .NET 8 -->
    <LangVersion>latest</LangVersion>
    <!-- Generate XML documentation for better code documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress XML documentation warnings for cleaner build output -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Enable deterministic builds for CI/CD reproducibility -->
    <Deterministic>true</Deterministic>
    <!-- Enable continuous integration build mode for better reproducibility -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Treat warnings as errors in Release builds for production quality -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to Core project for domain models and interfaces -->
    <ProjectReference Include="..\AphaBatchJobs.Core\AphaBatchJobs.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.DependencyInjection.Abstractions for dependency injection support -->
    <!-- Version aligned with .NET 8.0 LTS - using 8.0.* for stability -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.*" />
    <!-- Microsoft.Extensions.Logging.Abstractions for logging support -->
    <!-- Version aligned with .NET 8.0 LTS - using 8.0.* for stability -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.*" />
  </ItemGroup>

</Project>


<!-- 
Key improvements made:

1. **Version Alignment**: Changed package versions from 9.0.0 to 8.0.* to align with .NET 8.0 LTS target framework.
   Using version 9.0.0 packages with .NET 8.0 can cause compatibility issues. The 8.0.* wildcard ensures
   automatic minor/patch updates while maintaining major version compatibility.

2. **CI/CD Enhancement**: Added ContinuousIntegrationBuild property that activates when CI environment variable
   is set, improving build reproducibility in CI/CD pipelines (AWS CodeBuild, GitHub Actions, etc.).

3. **Production Quality**: Added TreatWarningsAsErrors for Release configuration to enforce higher code quality
   standards in production builds, which is critical for batch jobs running on AWS infrastructure.

4. **Best Practice Alignment**: These changes follow .NET 8 best practices for library projects and ensure
   better compatibility with AWS deployment scenarios where deterministic and reproducible builds are essential.
-->