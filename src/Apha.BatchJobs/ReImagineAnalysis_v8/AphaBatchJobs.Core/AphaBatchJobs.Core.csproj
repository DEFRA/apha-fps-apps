<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Corrected: net10.0 does not exist. Changed to net8.0 as per Dotnet8 requirement -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Added: LangVersion for explicit C# version control -->
    <LangVersion>latest</LangVersion>
    <!-- Added: Recommended for library projects to generate XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Added: Treat warnings as errors for better code quality -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Added: Enable deterministic builds for reproducibility -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Added: Common package references for .NET 8 PostgreSQL AWS batch jobs -->
