<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target framework set to .NET 10.0 -->
    <TargetFramework>net10.0</TargetFramework>
    
    <!-- Enable nullable reference types for better null safety -->
    <Nullable>enable</Nullable>
    
    <!-- Enable implicit usings to reduce boilerplate using statements -->
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Assembly and root namespace configuration -->
    <RootNamespace>AphaBatchJobs.Infrastructure</RootNamespace>
    <AssemblyName>AphaBatchJobs.Infrastructure</AssemblyName>
    
    <!-- Generate XML documentation file for API documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <!-- Treat warnings as errors for higher code quality -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    
    <!-- Language version set to latest for C# 12 features -->
    <LangVersion>latest</LangVersion>
    
    <!-- Enable deterministic builds for reproducible outputs -->
    <Deterministic>true</Deterministic>
    
    <!-- Enforce code analysis for better code quality -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to Core project for domain models and abstractions -->
    <ProjectReference Include="AphaBatchJobs.Core/AphaBatchJobs.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <!-- PostgreSQL Entity Framework Core provider for database access -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    
    <!-- Serilog console sink for structured logging output -->
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    
    <!-- Dependency injection and configuration -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    
    <!-- Quartz.NET for job scheduling and orchestration -->
    <PackageReference Include="Quartz" Version="3.13.1" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.13.1" />
  </ItemGroup>

</Project>
