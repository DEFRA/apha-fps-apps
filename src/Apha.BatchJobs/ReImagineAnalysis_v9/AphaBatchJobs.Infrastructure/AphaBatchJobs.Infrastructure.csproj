<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Best Practice: Enable TreatWarningsAsErrors in production code to catch potential issues early -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- CS1591: Missing XML comment for publicly visible type or member -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AphaBatchJobs.Core\AphaBatchJobs.Core.csproj" />
    <ProjectReference Include="..\AphaBatchJobs.Application\AphaBatchJobs.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Best Practice: Use consistent and latest stable versions for PostgreSQL EF Core -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.2" />
    <!-- Best Practice: Align Microsoft.Extensions.Hosting version with target framework (net8.0) -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- Best Practice: Add AWS SDK packages for AWS integration if deploying to AWS -->
    <!-- Uncomment if AWS services are used in Infrastructure layer -->
    <!-- <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="3.7.301" /> -->
    <!-- Best Practice: Add health checks for production readiness -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.HealthChecks" Version="9.0.2" />
  </ItemGroup>

</Project>


<!-- 
Key improvements made:

1. TreatWarningsAsErrors: Changed from 'false' to 'true' - This is a best practice for production code to ensure code quality and catch potential issues during compilation.

2. Microsoft.Extensions.Hosting Version: Changed from 9.0.0 to 8.0.1 - Aligned with .NET 8.0 target framework. Version 9.0.0 is for .NET 9, which creates a version mismatch.

3. Added Health Checks packages: Essential for production deployments, especially in AWS environments where health checks are critical for load balancers, ECS, and other services.

4. Added comments for AWS SDK: Placeholder for AWS integration packages that are typically needed in Infrastructure layer when deploying to AWS.

5. Maintained all existing functionality without adding new features beyond essential production-ready packages.
-->