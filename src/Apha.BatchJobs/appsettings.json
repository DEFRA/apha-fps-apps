{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "BatchJobsConnectionString": "__REPLACE_VIA_ENV__"
  },
  "ApplicationInsights": {
    "Enabled": false,
    "InstrumentationKey": ""
  },
  "BatchJobs": {
    "EnableDatabase": true,
    "MaxConcurrentJobs": 5,
    "JobTimeout": 3600,
    "RetryAttempts": 3,
    "RetryDelaySeconds": 60
  }
}
