{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "CloudWatch": {
      "GroupName": "/apha/batch-jobs",
      "StreamNameFormat": "{0:yyyy-MM-dd}",
      "TextFormatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
    }
  },
  "ConnectionStrings": {
    "BatchJobsConnectionString": "__REPLACE_VIA_ENV__"
  },
  "ExceptionTypes": {
    "General": "APHA_BATCH.GENERAL_EXCEPTION",
    "Sql": "APHA_BATCH.SQL_EXCEPTION",
    "Authorization": "APHA_BATCH.AUTHORIZATION_EXCEPTION",
    "Timeout": "APHA_BATCH.TIMEOUT_EXCEPTION"
  },
  "BatchJobs": {
    "EnableDatabase": true,
    "MaxConcurrentJobs": 5,
    "JobTimeout": 3600,
    "GracefulShutdownWindowSeconds": 25,
    "DbCommandTimeoutSeconds": 30,
    "RetryAttempts": 3,
    "RetryDelaySeconds": 60,
    "LockTimeoutSeconds": 3600
  },
  "ScheduledLoadFromFps": {
    "StepTimeoutSeconds": 300,
    "CurrentYearCutoverMonth": 4
  },
  "MabArchive": {
    "LockTimeoutSeconds": 3600,
    "TransactionTimeoutSeconds": 1800,
    "AdminNotificationEmail": "batch-admin@defra.gov.uk",
    "NotificationFromEmail": "batch-jobs@defra.gov.uk",
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "EnableEmailNotifications": true,
    "CloudWatchLogGroup": "/aws/ecs/batch-jobs"
  }
}
