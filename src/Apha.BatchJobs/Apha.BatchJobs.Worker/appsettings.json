{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BatchJobs": {
    "MaxConcurrentJobs": 5,
    "JobTimeout": 3600,
    "RetryAttempts": 3,
    "RetryDelaySeconds": 60,
    "MaxRetryDurationSeconds": 300,
    "LockTimeoutSeconds": 300
  }
}
