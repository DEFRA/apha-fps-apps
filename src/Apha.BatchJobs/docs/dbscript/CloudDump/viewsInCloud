    fpsyear,
    sum(budget_cvl) AS statusbudget
   FROM fps.tlkpproject
  GROUP BY program, projectstatus, fpsyear;"
"fps","vcontractadditionalcosts"," SELECT jobcode,
    account,
    description,
    itemcost
   FROM fps.tbladditionalcosts
  WHERE (jobcode::text IN ( SELECT vcontractproject.parentproject
           FROM fps.vcontractproject));"
"fps","vcontractanimalreq"," SELECT jobcode,
    animaltype,
    numberofdays,
    numberofanimals,
    indcounter,
    fpsyear
   FROM fps.tblanimalreq
  WHERE (jobcode::text IN ( SELECT vcontractproject.parentproject
           FROM fps.vcontractproject));"
"fps","vcontractproject"," SELECT parentproject,
    projecttitle,
    program,
    customer,
    manager,
    transferincome,
    custincome,
    wip_eoy,
    wip_limit,
    wip_current,
    projectstatus,
    costbookno,
    datecreated,
    feccost,
    profit,
