"fps","vcontracttestrequ"," SELECT buyer AS jobcode,
    testcode,
    norequired AS notests,
    unitprice AS testprice,
    datecreated,
    projectbuyercode
   FROM fps.tlkptestreqmt
  WHERE (buyer::text IN ( SELECT vcontractproject.parentproject
           FROM fps.vcontractproject));"
"fps","vcurrentperiod"," SELECT periodname,
    fpsyear
   FROM fps.tblperiod
  WHERE endperiod = (( SELECT max(tblperiod_1.endperiod) AS maxendperiod
           FROM fps.tblperiod tblperiod_1
          GROUP BY tblperiod_1.finalsummariesrun
         HAVING tblperiod_1.finalsummariesrun = '-1'::integer));"
"fps","vcustomerbudgetbyprogram"," SELECT program,
    projectstatus,
    customer,
    fpsyear,
    sum(budget_cvl) AS customerbudget
   FROM fps.tlkpproject
