   FROM fps.vprojectstaffplan
  GROUP BY parentproject, fpsyear;"
"fps","qrytotaltestcosts"," SELECT jobcode,
    sum(notests * testprice) AS totaltestcosts
   FROM fps.vtbltestrequ
