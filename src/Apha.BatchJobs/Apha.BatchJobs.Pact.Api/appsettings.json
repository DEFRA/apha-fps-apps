{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EventBridge": {
    "EventBusName": "default",
    "Source": "pact.api",
    "DetailType": "BatchJob.TriggerRequested",
    "DryRun": true
  },
  "TriggerStore": {
    "EntryTtlMinutes": 60
  },
  "AllowedHosts": "*"
}
