{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EventBridge": {
    "EventBusName": "default",
    "Source": "pact.api",
    "DetailType": "BatchJobTriggerRequested",
    "DryRun": true
  },
  "TriggerStore": {
    "Provider": "Redis",
    "EntryTtlMinutes": 60,
    "RedisConnectionString": "__REPLACE_REDIS_CONNECTION__",
    "RedisInstanceName": "pact-trigger-store:"
  },
  "AllowedHosts": "*"
}
