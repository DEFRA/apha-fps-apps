<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Corrected: net10.0 does not exist. Changed to net8.0 as per Dotnet8 requirement -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Best Practice: Add LangVersion for explicit C# version control -->
    <LangVersion>latest</LangVersion>
    <!-- Best Practice: Enable deterministic builds for reproducibility -->
    <Deterministic>true</Deterministic>
    <!-- Best Practice: Enable continuous integration build flag -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
