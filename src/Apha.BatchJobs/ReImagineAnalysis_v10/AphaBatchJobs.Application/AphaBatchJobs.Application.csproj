<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target Framework: Using net8.0 as per Dotnet8 technical stack requirement -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- Enable implicit usings for cleaner code -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enable nullable reference types for better null safety -->
    <Nullable>enable</Nullable>
    <!-- Use latest C# language version compatible with .NET 8 -->
    <LangVersion>latest</LangVersion>
    <!-- Enable deterministic builds for reproducibility in CI/CD pipelines -->
    <Deterministic>true</Deterministic>
    <!-- Enable continuous integration build flag for AWS deployment pipelines -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Generate XML documentation file for better IntelliSense support -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Treat warnings as errors in Release mode for production quality -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <!-- Suppress XML documentation warnings for public APIs if documentation file is generated -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Enable source link for better debugging experience in production -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to Core project containing domain models and interfaces -->
    <ProjectReference Include="..\AphaBatchJobs.Core\AphaBatchJobs.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.DependencyInjection.Abstractions for dependency injection support -->
    <!-- Updated to use version 8.0.* to align with .NET 8.0 target framework -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.*" />
    <!-- Microsoft.Extensions.Logging.Abstractions for logging support -->
    <!-- Updated to use version 8.0.* to align with .NET 8.0 target framework -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.*" />
  </ItemGroup>

</Project>
