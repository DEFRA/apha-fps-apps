    // - SSL Mode: For AWS RDS, use Require or VerifyFull in non-local environments
    
    "DefaultConnection": "Host=localhost;Port=5432;Database=aphafps;Username=postgres;Password=postgres;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=100;Connection Lifetime=0;Connection Idle Lifetime=300;Timeout=30;Command Timeout=30;SSL Mode=Prefer;Trust Server Certificate=true"
  },
  
