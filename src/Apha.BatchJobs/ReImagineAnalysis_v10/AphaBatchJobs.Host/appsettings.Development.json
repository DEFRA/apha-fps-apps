{
  "ConnectionStrings": {
    // Best Practice: Use environment-specific configuration and avoid hardcoded credentials
    // Consider using AWS Secrets Manager or Parameter Store for production environments
    // For local development, this is acceptable but should be documented
    
    // Best Practice: Include additional connection parameters for better performance and reliability
    // - Pooling: Enabled by default, but can be explicitly configured
    // - Timeout: Set appropriate connection timeout
