  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Npgsql": "Information"
    }
  },
  
  // Best Practice: Add development-specific settings
  "DetailedErrors": true,
  "HostingEnvironment": "Development"
}


