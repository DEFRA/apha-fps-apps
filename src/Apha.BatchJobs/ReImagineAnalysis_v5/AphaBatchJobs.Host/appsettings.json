{
  "ConnectionStrings": {
    // Connection string should be injected via environment variables or AWS Secrets Manager in ECS Fargate
    // Never commit actual connection strings to source control
    "DefaultConnection": ""
  },
  "DatabaseOptions": {
    // Recommended timeout for PostgreSQL in containerized environments (30s is reasonable)
    "TimeoutSeconds": 30,
    // Consider exponential backoff strategy for retries in production
    "MaxRetries": 3,
    // Add CommandTimeout for long-running queries (recommended for batch jobs)
    "CommandTimeout": 300,
    // Enable connection pooling for better performance
    "MinPoolSize": 0,
    "MaxPoolSize": 100,
    // Health check timeout for ECS Fargate health checks
    "HealthCheckTimeoutSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      // Use structured logging for CloudWatch Logs integration
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      // Add specific logging for Entity Framework and Npgsql for troubleshooting
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Npgsql": "Warning"
    },
    // Console logging is required for CloudWatch Logs in ECS Fargate
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true,
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  // Allow configuration override from environment variables (ECS Fargate best practice)
  "AllowedHosts": "*"
}