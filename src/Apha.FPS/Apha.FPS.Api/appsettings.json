{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "FPSConnectionString": "<FPS-DB-Connectionstring>"
  },
  "AllowedHosts": "*",
  "AwsLogging": {
    "LogGroupName": ""
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "<domain_name>.com",
    "ClientId": "<client_Id>",
    "TenantId": "<tenant_Id>",
    "ClientSecret": "<client_Secret>",
    "ClientCertificates": [
    ],
    "CallbackPath": "/signin-oidc"
  },
  "EventBridge": {
    "Region": "eu-west-2",
    "EventBusArn": "<EventBusArn>",
    "Source": "fps.api",
    "DetailType": "BatchJobTriggerRequested"
  },
  "GraphEmailSettings": {
    "TenantId": "<tenant_Id>",
    "ClientId": "<client_Id>",
    "ClientSecret": "<client_Secret>",
    "SharedMailbox": "<shared_mailbox>"
  },
  "YearEndEmailSettings": {
    "DataSetupInitiatedEmailRecipient": "<recipient_email>",
    "DataSetupInitiatedEmailSubject": "<subject>",
    "DataSetupInitiatedEmailBody": "<body>",
    "DataSetupApprovalEmailRecipient": "<recipient_email>",
    "DataSetupApprovalEmailSubject": "<subject>",
    "DataSetupApprovalEmailBody": "<body>",
    "DataSetupRejectionEmailRecipient": "<recipient_email>",
    "DataSetupRejectionEmailSubject": "<subject>",
    "DataSetupRejectionEmailBody": "<body>"
  },
  "LogsPath": "Logs",
  "ExceptionTypes": {
    "General": "FPSAPPS.EXCEPTION.FPS.GENERAL",
    "Database": "FPSAPPS.EXCEPTION.FPS.DB",
    "Authorization": "FPSAPPS.EXCEPTION.FPS.AUTHORIZATION",
    "BusinessValidation": "FPSAPPS.EXCEPTION.FPS.BUSINESSVALIDATION"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}

