{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "FPSConnectionString": "<FPS-DB-Connectionstring>"
  },
  "AllowedHosts": "*",
  "AwsLogging": {
    "LogGroupName": ""
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "<domain_name>.com",
    "ClientId": "<client_Id>",
    "TenantId": "<tenant_Id>",
    "ClientSecret": "<client_Secret>",
    "ClientCertificates": [
    ],
    "CallbackPath": "/signin-oidc"
  },
  "EventBridge": {
    "Region": "eu-west-2",
    "EventBusArn": "<EventBusArn>",
    "Source": "fps.api",
    "DetailType": "BatchJobTriggerRequested"
  },
  "LogsPath": "Logs",
  "ExceptionTypes": {
    "General": "FPSAPPS.EXCEPTION.FPS.GENERAL",
    "Database": "FPSAPPS.EXCEPTION.FPS.DB",
    "Authorization": "FPSAPPS.EXCEPTION.FPS.AUTHORIZATION",
    "BusinessValidation": "FPSAPPS.EXCEPTION.FPS.BUSINESSVALIDATION"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "GraphEmailSettings": {
    "TenantId": "<tenant_Id>",
    "ClientId": "<client_Id>",
    "ClientSecret": "<client_Secret>",
    "SharedMailbox": "<shared_mailbox>"
  },
  "YearEndEmailSettings": {
    "DataSetupInitiatedEmailRecipient": "<DataSetupInitiatedEmailRecipient>",
    "DataSetupInitiatedEmailSubject": "<DataSetupInitiatedEmailSubject>",
    "DataSetupInitiatedEmailBody": "<DataSetupInitiatedEmailBody>",
    "DataSetupApprovalEmailRecipient": "<DataSetupApprovalEmailRecipient>",
    "DataSetupApprovalEmailSubject": "<DataSetupApprovalEmailSubject>",
    "DataSetupApprovalEmailBody": "<>",
    "DataSetupRejectionEmailRecipient": "<>",
    "DataSetupRejectionEmailSubject": "<>",
    "DataSetupRejectionEmailBody": "<>",
    "CutOverInitiatedEmailRecipient": "<>",
    "CutOverInitiatedEmailSubject": "<>",
    "CutOverInitiatedEmailBody": "<>",
    "CutOverApprovalEmailRecipient": "<>",
    "CutOverApprovalEmailSubject": "<>",
    "CutOverApprovalEmailBody": "<>",
    "CutOverRejectionEmailRecipient": "<>",
    "CutOverRejectionEmailSubject": "<>",
    "CutOverRejectionEmailBody": "<>"
  },
  "BulkRatesEmailSettings": {
    "ReleasedForApprovalRecipients": "fpsapps_noreply@defradev.onmicrosoft.com",
    "ReleasedForApprovalSubject": "Bulk Rates — {JobName} {FpsYear} Released for Approval",
    "ReleasedForApprovalBody": "<p>A Bulk Rates request for <strong>{JobName} {FpsYear}</strong> has been released for approval by {RequestedBy}.</p><p>Job Queue ID: {JobQueueId}</p>",
    "ApprovedRecipients": "fpsapps_noreply@defradev.onmicrosoft.com",
    "ApprovedSubject": "Bulk Rates — {JobName} {FpsYear} Approved",
    "ApprovedBody": "<p>The Bulk Rates request for <strong>{JobName} {FpsYear}</strong> has been approved by {ApprovedBy}. Processing will begin shortly.</p><p>Job Queue ID: {JobQueueId}</p>",
    "RejectedSubject": "Bulk Rates — {JobName} {FpsYear} Rejected",
    "RejectedBody": "<p>Your Bulk Rates request for <strong>{JobName} {FpsYear}</strong> has been rejected.</p><p>Reason: {Reason}</p><p>Job Queue ID: {JobQueueId}</p>",
    "CancelledSubject": "",
    "CancelledBody": ""
  }
}
