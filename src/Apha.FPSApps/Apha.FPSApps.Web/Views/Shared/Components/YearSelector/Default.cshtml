@model Apha.FPSApps.Web.Models.Components.YearSelector.YearSelectorViewModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
}

<div style="display: flex; align-items: center; gap: 10px;">
    <select id="yearSelector"
            class="app-log"
            aria-label="Year"
            data-area="@ViewContext.RouteData.Values["area"]">
        @foreach (var item in Model.Years)
        {
            var selectedAttr = item.Selected ? "selected" : null;
            <option value="@item.Value" selected="@selectedAttr">
                @item.Text
            </option>
        }
    </select>
    @if (!string.IsNullOrEmpty(Model.SelectedYearStatus))
    {
        @if (Model.SelectedYearStatus.Equals("Closed", StringComparison.OrdinalIgnoreCase))
        {
            <div class="year-end-message">The selected financial year has been closed and is no longer available for modification.</div>
        }
        else if (Model.SelectedYearStatus.Equals("Planned", StringComparison.OrdinalIgnoreCase))
        {
            @if (string.Equals(area, "FPS", StringComparison.OrdinalIgnoreCase))
            {
                <div class="year-end-message">The selected financial year is in planning stage, you can only modify planning data.</div>
            }
            else
            {
                <div class="year-end-message">The selected financial year is in planing stage and is no longer available for modification.</div>
            }
        }
    }
</div>
<script>
    $('#yearSelector').on('change', function () {
        var area = $(this).data('area') || '';
        var homeUrl = area ? '/' + area + '/Home/Index' : '/Home/Index';
        window.location.href = homeUrl + '?year=' + $(this).val();
    });
</script>