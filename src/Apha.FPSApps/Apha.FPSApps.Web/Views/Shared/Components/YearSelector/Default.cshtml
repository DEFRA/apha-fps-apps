@model Apha.FPSApps.Web.Models.ViewComponents.YearSelectorViewModel

<select id="yearSelector"
        aria-label="Year"
        style="border: 1px solid #0374e9;
               border-radius: 10px;
               margin-left: 10px;
               font-size: 20px;
               font-weight: bold;
               color: #00005c;
               text-shadow: 1px 1px #b0d7ff;
               letter-spacing: 1px;
               background: #fff;
               padding: 3px;"
        asp-items="Model.Years">
</select>

<script>
    $('#yearSelector').on('change', function () {
        var url = new URL(window.location.href);
        url.searchParams.set('year', $(this).val());
        window.location.href = url.toString();
    });
</script>