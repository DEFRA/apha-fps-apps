@using Apha.FPSApps.Web.Handler
@inject IFpsYearContext Fy

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Apha.FPSApps.Web</title>

    <!-- Open Graph / Teams preview -->
    <meta property="og:title" content="@ViewData["Title"]">
    <meta property="og:description" content="FPS Apps - Department for Environment, Food & Rural Affairs">
    <meta property="og:type" content="website">

    <!-- CSS Load Order: Bootstrap → GOV.UK → Custom (bundled & minified) -->
    <link rel="stylesheet" href="~/css/bundles/root.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Apha.FPSApps.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()

    <script src="~/js/bundles/root.js" asp-append-version="true"></script>
    <fps-year-script></fps-year-script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
