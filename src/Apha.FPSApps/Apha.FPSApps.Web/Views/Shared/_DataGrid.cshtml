@using Apha.FPSApps.Web.Models.Components.DataGrid
@model dynamic

<div class="editable-grid-container">
    <div class="sup_border sup_border_bottom_0">
        <h2 class="sup_border-bottom sup_text_color sup_heading_bg_color govuk-heading-s sup_margin_0 sup_align_heading">
            <div class="sup_flex_space_between">
                @Model.Title  <button type="button" class="govuk-button sup_margin_0 sup_p_8"
                                      id="@($"{Model.GridId}_addRowBtn")" data-add-function="@Model.AddFunction">
                    <i class="fa fa-plus"></i> Add
                </button>
            </div>
        </h2>
        <div class="grid-toolbar">
            <div class="sup_flex_center_gap_0">
                <!-- Page Size Dropdown START -->
                @*  <select id="@($"{Model.GridId}_pageSize")" class="form-control form-control-sm" style="width: 90px;">
                    @{
                        var sizes = new[] { 5, 10, 20, 50, 100 };
                        int currentSize = Model.Pagination?.PageSize ?? 5;
                    }
                    @foreach (var size in sizes)
                    {
                        <option value="@size" selected="@(size == currentSize ? "selected" : null)">
                            @size / page
                        </option>
                    }
                </select> *@
                <!-- Page Size Dropdown END -->
                @*    <button type="button" class="btn btn-success" id="@($"{Model.GridId}_addRowBtn")">
                    <i class="fa fa-plus"></i> Add
                </button> *@
            </div>
        </div>
    </div>



    <div class="grid-wrapper">
        <div class="grid-scroll-container">
            <table id="@($"tbl_{Model.GridId}")" class="editable-grid-table govuk-table custom-table">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        @if (Model.ShowCheckboxColumn)
                        {
                            <th scope="col" class="govuk-table__header sup_p_0">

                                <div class="govuk-checkboxes govuk-checkboxes--small sup_margin_0 cust-abs-top-right" data-module="govuk-checkboxes">
                                    <div class="govuk-checkboxes__item">
                                        <input type="checkbox" id="@($"{Model.GridId}_selectAll")" class="govuk-checkboxes__input govuk-!-font-size-16" />
                                        @*        <input class="govuk-checkboxes__input govuk-!-font-size-16" id="chkfinished" name="chkfinished" type="checkbox" value="finished"> *@
                                        <label class="govuk-label govuk-checkboxes__label sup_label_auto_width sup_p_0 sup_w_h_0" for="@($"{Model.GridId}_selectAll")">
                                        </label>
                                    </div>

                                </div>
                            </th>
                        }
                        @foreach (var column in Model.Columns)
                        {
                            if (column.IsVisible)
                            {
                                var isSorted = (Model.Pagination.SortColumn == column.PropertyName);
                                var sortIcon = "";
                                if (isSorted)
                                    sortIcon = Model.Pagination.SortDirection ? "▲" : "▼";
                                <th scope="col" style="width: @column.Width px; cursor:pointer;"
                                    class="sortable-header"
                                    data-column="@column.PropertyName"
                                    data-sortdir="@(isSorted ? !Model.Pagination.SortDirection : false)">
                                    @column.DisplayName <span class="sort-icon">@sortIcon</span>
                                    <div class="column-resizer"></div>
                                </th>
                            }
                        }
                        <th scope="col" class="row-number-header govuk-table__header" style="width: 80px;">Action</th>
                    </tr>
                    <!-- Filter Row -->
                    <tr class="filter-row govuk-table__row">
                        @if (Model.ShowCheckboxColumn)
                        {
                            <th scope="col"></th>
                        }
                        @foreach (var column in Model.Columns)
                        {
                            if (column.IsVisible)
                            {
                                <th scope="col">
                                    @if (column.IsFilterable)
                                    {
                                        var filterValue = Model.CurrentFilters != null && Model.CurrentFilters.ContainsKey(column.PropertyName)
                                        ? Model.CurrentFilters[column.PropertyName]
                                        : "";

                                        if (column.FilterType == GridColumnType.Dropdown && column.FilterOptions != null)
                                        {
                                            <select class="grid-filter govuk-input govuk-!-font-size-16" data-filter="@column.PropertyName">
                                                <option value="">All</option>
                                                @foreach (var option in column.FilterOptions)
                                                {
                                                    <option value="@option.Key" selected="@(option.Key == filterValue ? "selected" : null)">
                                                        @option.Value
                                                    </option>
                                                }
                                            </select>
                                        }
                                        else if (column.FilterType == GridColumnType.Checkbox)
                                        {
                                            <select class="grid-filter govuk-input govuk-!-font-size-16" data-filter="@column.PropertyName">
                                                <option value="">All</option>
                                                <option value="true" selected="@(filterValue == "true" ? "selected" : null)">True</option>
                                                <option value="false" selected="@(filterValue == "false" ? "selected" : null)">False</option>
                                            </select>
                                        }
                                        //Add condition for datepicker
                                        else if (column.FilterType == GridColumnType.Date)
                                        {
                                            <input type="date" class="grid-filter grid-date govuk-input govuk-!-font-size-16" data-filter="@column.PropertyName"
                                                   value="@(!string.IsNullOrWhiteSpace(filterValue) ? Convert.ToDateTime(filterValue).ToString("yyyy-MM-dd") : "")" placeholder="Filter..." />
                                        }
                                        else
                                        {
                                            <input type="text" class="grid-filter govuk-input govuk-!-font-size-16" data-filter="@column.PropertyName" value="@filterValue" placeholder="Filter..." />
                                        }
                                    }
                                </th>
                            }
                        }
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @{
                        var rowIndex = 0;
                    }
                    @foreach (var row in Model.Data)
                    {
                        <tr data-row-index="@rowIndex">
                            @if (Model.ShowCheckboxColumn)
                            {
                                <td class="checkbox-cell govuk-table__cell">
                                    @*  <input type="checkbox" name="chk-box-_@rowIndex"
                                           id="@($"chk_{Model.GridId}_{rowIndex}")" class="row-checkbox" /> *@


                                    <div class="govuk-checkboxes govuk-checkboxes--small sup_margin_0" data-module="govuk-checkboxes">
                                        <div class="govuk-checkboxes__item sup_chk_margin">
                                            <input type="checkbox" name="chk-box-_@rowIndex"
                                                   id="@($"chk_{Model.GridId}_{rowIndex}")" class="row-checkbox govuk-checkboxes__input govuk-!-font-size-16" />
                                            <label class="govuk-label govuk-checkboxes__label sup_label_auto_width sup_p_0 sup_w_h_0" for="@($"{Model.GridId}_selectAll")">
                                            </label>
                                        </div>

                                    </div>
                                </td>
                            }
                            @foreach (var column in Model.Columns)
                            {
                                if (column.IsVisible)
                                {
                                    var value = GridHelpers.GetPropertyValue(row, column.PropertyName);
                                    if (column.ColumnType == GridColumnType.Checkbox)
                                    {
                                        <td class="checkbox-cell govuk-table__cell" data-property="@column.PropertyName" data-type="@column.ColumnType">
                                            <input readonly type="checkbox" name="@column.PropertyName"
                                                   id="@($"{Model.GridId}_{column.PropertyName}_{rowIndex}")" class="@GridHelpers.GetTypeCssClass(column)"
                                                   @(Convert.ToBoolean(value) ? "checked" : "") @(column.IsEditable ? "" : "disabled") />
                                        </td>
                                    }
                                    else
                                    {
                                        <td data-property="@column.PropertyName" data-type="@column.ColumnType" class="govuk-table__cell">
                                            <span name="@column.PropertyName"
                                                  id="@($"{Model.GridId}_{column.PropertyName}_{rowIndex}")"
                                                  class="@GridHelpers.GetTypeCssClass(column)">@GridHelpers.FormatValue(value, column)</span>
                                        </td>
                                    }
                                }
                            }
                            <!-- Edit Button -->
                            <td class="govuk-table__cell">
                                <button type="button"
                                        class="btn btn-sm btn-info edit-row-btn"
                                        data-id="@GridHelpers.GetPropertyValue(row, Model.KeyProperty)"                                       
                                        data-edit-function="@Model.EditFunction">
                                    <img src="../images/edit_gridicon.svg" alt="Edit icon" width="20" height="20" title="Edit">
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-danger delete-row-btn"
                                        data-id="@GridHelpers.GetPropertyValue(row, Model.KeyProperty)"
                                        data-delete-function="@Model.DeleteFunction">
                                    <img src="../images/delete_gridicon.svg" alt="Delete icon" width="20" height="20" title="Delete">
                                </button>
                            </td>
                        </tr>
                        rowIndex++;
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="sup_pagination_footer sup_p_0">
        <div class="sup_pagination_wrapper">
            <div class="sup_margin_top_bottom_5_10 sup_flex_center">
                <label for="recordsPerPage" class="sup_margin_right_5">Records per page  </label>
                <select id="@($"{Model.GridId}_pageSize")" class="govuk-select govuk-select--width-2 sup_width_4em govuk-!-font-size-16">
                    @{
                        var sizes = new[] { 5, 10, 20, 50, 100 };
                        int currentSize = Model.Pagination?.PageSize ?? 5;
                    }
                    @foreach (var size in sizes)
                    {
                        <option value="@size" selected="@(size == currentSize ? "selected" : null)">
                            @size
                        </option>
                    }
                </select>
            </div>

            @if (Model.ShowPagination)
            {

                @await Component.InvokeAsync("Pagination", Model.Pagination)
                <span class="record-info sup_display_none">
                    Page @Model.Pagination.PageNumber of @Model.Pagination.TotalPages
                    &nbsp;|&nbsp;
                    Showing @((Model.Pagination.PageSize * (Model.Pagination.PageNumber - 1)) + 1)
                    -
                    @(Math.Min(Model.Pagination.PageSize * Model.Pagination.PageNumber, Model.Pagination.TotalRecords))
                    of @Model.Pagination.TotalRecords
                </span>

            }
        </div>
    </div>
</div>

<script type="text/javascript">
    (function() {
        var gridId = '@Model.GridId';
        var gridContainerSelector = '#gridContainer_' + gridId;
        var bindGridUrl = '@Model.BindGridUrl';

        // Get extra filters once at initialization
        var extraFilters = typeof window['@Model.ExtraFilterMethod'] === "function"
            ? window['@Model.ExtraFilterMethod']()
            : {};

        // Core grid manager - attached to this specific grid
        var gridManager = {
            getFilterModel: function() {
                var filterModel = {};
                $(gridContainerSelector + ' .grid-filter').each(function () {
                    var prop = $(this).data('filter');
                    var val = $(this).val();
                    if (val !== undefined && val !== null && val !== '') {
                        filterModel[prop] = val;
                    }
                });
                return filterModel;
            },

            getAjaxParams: function(customParams) {
                var params = {
                    page: customParams.page || 1,
                    pageSize: customParams.pageSize || $('#' + gridId + '_pageSize').val() || 10,
                    sortBy: customParams.sortBy || '@Model.Pagination.SortColumn',
                    descending: customParams.descending || '@Model.Pagination.SortDirection',
                    filter: JSON.stringify(this.getFilterModel())
                };

                // Merge extra filters
                for (var key in extraFilters) {
                    if (extraFilters.hasOwnProperty(key)) {
                        params[key] = extraFilters[key];
                    }
                }

                return params;
            },

            reloadGrid: function(params) {
                var self = this;
                $.post(bindGridUrl, self.getAjaxParams(params))
                    .done(function (htmlData) {
                        $(gridContainerSelector).html(htmlData);
                        self.applyGridColumnWidths();
                        self.deselectAllCheckboxes();
                    });
            },

            deselectAllCheckboxes: function() {
                $('#' + gridId + '_selectAll').prop('checked', false);
                $('#tbl_' + gridId + ' .row-checkbox').prop('checked', false);
            },

            saveGridColumnWidths: function() {
                var widths = {};
                $('#tbl_' + gridId + ' th[data-column]').each(function () {
                    var col = $(this).data('column');
                    if (col) widths[col] = $(this).outerWidth();
                });
                localStorage.setItem(gridId + '_colWidths', JSON.stringify(widths));
            },

            applyGridColumnWidths: function() {
                var widths = {};
                try {
                    widths = JSON.parse(localStorage.getItem(gridId + '_colWidths') || '{}');
                } catch {}
                $('#tbl_' + gridId + ' th[data-column]').each(function () {
                    var col = $(this).data('column');
                    if (col && widths[col]) $(this).css('width', widths[col] + 'px');
                });
            }
        };

        // Initialize grid on document ready
        $(function() {
            // Track changes for saving
            var changedRows = {};

            $(gridContainerSelector).on('change', '.grid-input', function() {
                var $row = $(this).closest('tr');
                var rowIndex = $row.data('row-index');
                var property = $(this).closest('td').data('property');
                var value = $(this).is(':checkbox') ? $(this).is(':checked') : $(this).val();

                if (!changedRows[rowIndex]) {
                    changedRows[rowIndex] = {};
                }
                changedRows[rowIndex][property] = value;
                $row.css('background-color', '#ffffcc');
            });

            window.getChangedRows = function() {
                return changedRows;
            };

            // Sort header click
            $(gridContainerSelector).off('click', '.sortable-header').on('click', '.sortable-header', function (e) {
                if (resizing) {
                    e.stopImmediatePropagation();
                    return;
                }

                gridManager.reloadGrid({
                    page: 1,
                    sortBy: $(this).data('column'),
                    descending: $(this).data('sortdir')
                });
            });

            // Pagination click
            $(gridContainerSelector).off('click', '.pagination a, .pagination span').on('click', '.pagination a, .pagination span', function (e) {
                e.preventDefault();
                var pageNo = $(this).data('pageno');
                if ($(this).prop('disabled') || !pageNo || isNaN(pageNo) || pageNo < 1) return;

                gridManager.reloadGrid({ page: pageNo });
            });

            // Page size change
            $('#' + gridId + '_pageSize').on('change', function () {
                gridManager.reloadGrid({
                    page: 1,
                    pageSize: $(this).val()
                });
            });

            // Filter change
            $(gridContainerSelector).on('change', '.grid-filter', function () {
                gridManager.reloadGrid({ page: 1 });
            });

            // Select All checkbox
            $('#' + gridId + '_selectAll').on('change', function() {
                var checked = $(this).is(':checked');
                $('#tbl_' + gridId + ' .row-checkbox').prop('checked', checked);
            });

            // Row checkbox change
            $(gridContainerSelector).off('change', '.row-checkbox').on('change', '.row-checkbox', function() {
                var allChecked = $('.row-checkbox').length === $('.row-checkbox:checked').length;
                $('#' + gridId + '_selectAll').prop('checked', allChecked);
            });

            // Add button click
            $('#' + gridId + '_addRowBtn').on('click', function () {
                var customAddFn = $(this).data('add-function');
                if (customAddFn && typeof window[customAddFn] === 'function') {
                    window[customAddFn](this);
                }
            });

            // Edit button click
            $(gridContainerSelector).off('click', '.edit-row-btn').on('click', '.edit-row-btn', function() {
                debugger;
                var customEditFn = $(this).data('edit-function');
                if (customEditFn && typeof window[customEditFn] === 'function') {
                    window[customEditFn](this);
                }
            });

            // Delete button click
            $(gridContainerSelector).off('click', '.delete-row-btn').on('click', '.delete-row-btn', function() {
                var customDeleteFn = $(this).data('delete-function');
                if (customDeleteFn && typeof window[customDeleteFn] === 'function') {
                    window[customDeleteFn](this);
                }
            });

            // Column resizing
            const table = document.getElementById('tbl_' + gridId);
            let pressed = false;
            let startX, startWidth, th;
            let resizing = false;

            if (table) {
                table.querySelectorAll('.column-resizer').forEach(function (resizer) {
                    resizer.addEventListener('mousedown', function (e) {
                        pressed = true;
                        resizing = false;
                        th = resizer.parentElement;
                        startX = e.pageX;
                        startWidth = th.offsetWidth;
                        document.body.style.cursor = 'col-resize';
                        e.preventDefault();
                    });
                });

                document.addEventListener('mousemove', function (e) {
                    if (!pressed) return;
                    const diff = e.pageX - startX;
                    if (Math.abs(diff) > 2) resizing = true;
                    th.style.width = (startWidth + diff) + 'px';
                });

                window.addEventListener('mouseup', function (e) {
                    if (pressed) {
                        pressed = false;
                        setTimeout(() => { resizing = false; }, 100);
                        document.body.style.cursor = '';
                        gridManager.saveGridColumnWidths();
                    }
                });
            }
        });
    })();
</script>