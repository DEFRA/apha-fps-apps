<!-- TRANSFORMENGINE MIGRATION — _AddEditRadTrackProg.cshtml
     Pattern  : stack-upgrade/msaccess-frm-to-dotnet10-mvc-e2e  Phase 12 — Razor Views (Step 18)
     Migrated : 2026-07-06
     CHANGED:
       - MS Access frmMaintainance progProgEditModal -> Razor partial
       - Fields derived from HTML progProgEditModal: progProgName (select -> Program),
         progProgPrefix (text -> Publicationprefix)
       - Natural string PK: Program — editable on Add, disabled on Edit
       - Radtrackprog boolean not shown in HTML modal (backend-only flag)
       - Anti-forgery token included; saveRadTrackProg() calls /PIMS/Maintenance/SaveRadTrackProg
     DEFERRED:
       - TRANSFORMENGINE TODO: Programme name options are static in HTML prototype;
         confirm if they should be loaded dynamically from RadTrackProg lookup in production -->
@model Apha.FPSApps.Web.Areas.PIMS.Models.RadTrackProgItem

@{
    var isEditMode = !string.IsNullOrEmpty(Model.Program);
    var title = isEditMode ? "Edit PIMS Programme" : "Add PIMS Programme";
    var saveLabel = isEditMode ? "Update" : "Save";
}

<div class="modal-header flex-space-center">
    <h3 class="modal-title" style="margin: 0;">@title</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>
<div class="modal-body" style="padding-top: 5px;">
    <form class="row" id="formRadTrackProg">
        @Html.AntiForgeryToken()

        @* TRANSFORMENGINE: Natural string PK — carried as hidden for edit *@
        <input type="hidden" id="hdnProgProgId" name="Program" value="@Model.Program" />
        <input type="hidden" id="hdnProgIsEdit" value="@isEditMode.ToString().ToLower()" />

        <div class="govuk-error-summary ra-form-error-banner ra-hidden"
             id="progProgDbError" role="alert" aria-labelledby="progProgDbErrorTitle" tabindex="-1">
            <h2 class="govuk-error-summary__title govuk-!-font-size-14" id="progProgDbErrorTitle">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <p class="govuk-body govuk-!-font-size-14" id="progProgDbErrorText"></p>
            </div>
        </div>

        <div class="govuk-grid-row">
            @* Programme name — progProgName select in HTML modal *@
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10" id="progProgNameGroup">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="progProgName">
                        Programme: <span class="ra-required-star" aria-hidden="true">*</span>
                    </label>
                    @* TRANSFORMENGINE: Program -> progProgName select in HTML modal.
                       On Edit mode, shown as disabled display field (value carried by hidden input). *@
                    @if (isEditMode)
                    {
                        <input class="govuk-input govuk-!-font-size-16 ra-select-full"
                               id="progProgName"
                               type="text"
                               value="@Model.Program"
                               disabled />
                    }
                    else
                    {
                        <select class="govuk-select govuk-!-font-size-16 ra-select-full"
                                id="progProgName"
                                name="Program"
                                aria-required="true"
                                aria-describedby="progProgNameError">
                            <option value="">-- Select Programme --</option>
                            @{
                                var progOptions = new[]
                                {
                                    "APHA_MISC","ASU","ASUMisc","B&M","Bact","BactMisc","BactTest","Bee Insp",
                                    "BOVINE_TB","BPUMisc","BTB","BTUMisc","ClubFive","Comm","Commercial","CSG",
                                    "DoES","DSG","END_RES","END_SURV","EU Exit","EU_PROG","FES_RES","FES_SURV",
                                    "FS_SURV","FSZ_RES","FSZ_RESMVN","GM","HPE_PROG","IMT","IT_SURV","IT_WB",
                                    "MISC","NFC","NI_PROG","PHSI","PLANT_HEALTH","RABIES","SA_SURV","SHE",
                                    "TBSE","VIG","WB_SURV","WLD_HEALTH","ZOO_PROG"
                                };
                                foreach (var p in progOptions)
                                {
                                    <option value="@p">@p</option>
                                }
                            }
                        </select>
                        <span class="govuk-error-message" id="progProgNameError" style="display:none;"></span>
                    }
                </div>
            </div>

            @* Publication Prefix — progProgPrefix text input *@
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10" id="progProgPrefixGroup">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Publicationprefix">
                        Publication Prefix:
                    </label>
                    @* TRANSFORMENGINE: Publicationprefix -> progProgPrefix in HTML modal *@
                    <input class="govuk-input govuk-!-font-size-16"
                           asp-for="Publicationprefix"
                           id="progProgPrefix"
                           type="text" />
                </div>
            </div>
        </div>

        <div class="col-12" style="text-align: right; margin-top: 10px;">
            <button type="button"
                    class="govuk-button govuk-button--secondary sup_margin_0"
                    onclick="closeModal()">
                Cancel
            </button>
            <button type="button"
                    class="govuk-button sup_margin_0"
                    onclick="saveRadTrackProg()">
                @saveLabel
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function saveRadTrackProg() {
            var dbError     = document.getElementById('progProgDbError');
            var dbErrorText = document.getElementById('progProgDbErrorText');
            if (dbError) dbError.classList.add('ra-hidden');

            // TRANSFORMENGINE: For Add, pick value from select; for Edit, already in hidden field
            var isEdit = document.getElementById('hdnProgIsEdit').value === 'true';
            if (!isEdit) {
                var selVal = document.getElementById('progProgName')?.value || '';
                if (!selVal) {
                    if (dbErrorText) dbErrorText.textContent = 'Programme is required.';
                    if (dbError) dbError.classList.remove('ra-hidden');
                    return;
                }
                // Sync hidden PK field with select value
                document.getElementById('hdnProgProgId').value = selVal;
            }

            $.post({
                url: '/PIMS/Maintenance/SaveRadTrackProg',
                data: $('#formRadTrackProg').serialize(),
                success: function (data) {
                    if (data.success) {
                        closeModal();
                        reloadRadTrackProgsGrid();
                    } else {
                        var msg = data.message || 'Save failed.';
                        if (dbErrorText) dbErrorText.textContent = msg;
                        if (dbError) dbError.classList.remove('ra-hidden');
                    }
                },
                error: function () {
                    if (dbErrorText) dbErrorText.textContent = 'An error occurred while saving.';
                    if (dbError) dbError.classList.remove('ra-hidden');
                }
            });
        }
    </script>
}
