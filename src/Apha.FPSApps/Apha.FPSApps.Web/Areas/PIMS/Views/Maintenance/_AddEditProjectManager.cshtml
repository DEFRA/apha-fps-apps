<!-- TRANSFORMENGINE MIGRATION — _AddEditProjectManager.cshtml
     Pattern  : stack-upgrade/msaccess-frm-to-dotnet10-mvc-e2e  Phase 12 — Razor Views (Step 18)
     Migrated : 2026-07-06
     CHANGED:
       - MS Access frmMaintainance Manager edit modal -> Razor partial
       - Fields derived from HTML mgrManagerEditModal: mgrEditName (select -> Projectmanager),
         mgrEditMNumber (text -> Mnumber), mgrEditEmail (text -> Email),
         mgrEditDisabled (checkbox -> Disable)
       - Natural string PK: Projectmanager — editable on Add, read-only on Edit
       - Anti-forgery token included; SaveProjectManager() calls /PIMS/Maintenance/SaveProjectManager
     DEFERRED:
       - TRANSFORMENGINE TODO: Manager name dropdown populated dynamically in HTML (empty on load);
         confirm lookup endpoint for manager name options in production -->
@model Apha.FPSApps.Web.Areas.PIMS.Models.ProjectManagerItem

@{
    var isEditMode = !string.IsNullOrEmpty(Model.Projectmanager);
    var title = isEditMode ? "Edit Manager" : "Add Manager";
    var saveLabel = isEditMode ? "Update" : "Save";
}

<div class="modal-header flex-space-center">
    <h3 class="modal-title" style="margin: 0;">@title</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>
<div class="modal-body" style="padding-top: 5px;">
    <form class="row" id="formProjectManager">
        @Html.AntiForgeryToken()

        @* TRANSFORMENGINE: Natural string PK — hidden for edit, visible for add *@
        <input type="hidden" id="hdnProjectmanager" name="Projectmanager" value="@Model.Projectmanager" />
        <input type="hidden" id="hdnMgrIsEdit" value="@isEditMode.ToString().ToLower()" />

        <div class="govuk-error-summary ra-form-error-banner ra-hidden"
             id="mgrEditDbError" role="alert" aria-labelledby="mgrEditDbErrorTitle" tabindex="-1">
            <h2 class="govuk-error-summary__title govuk-!-font-size-14" id="mgrEditDbErrorTitle">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <p class="govuk-body govuk-!-font-size-14" id="mgrEditDbErrorText"></p>
            </div>
        </div>

        <div class="govuk-grid-row">
            @* Manager Name — mgrEditName select in HTML (populated dynamically) *@
            <div class="govuk-grid-column-full">
                <div class="govuk-form-group sup_margin_bottom_10" id="mgrEditNameGroup">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="mgrEditName">
                        Manager Name: <span class="ra-required-star" aria-hidden="true">*</span>
                    </label>
                    @* TRANSFORMENGINE: Projectmanager -> mgrEditName select.
                       Editable in both Add and Edit mode — driven by mgrAssignValue select
                       in HTML. For Razor we keep as text input; edit mode disables the field. *@
                    @if (isEditMode)
                    {
                        <input class="govuk-input govuk-!-font-size-16 ra-select-full"
                               id="mgrEditName"
                               type="text"
                               value="@Model.Projectmanager"
                               disabled />
                        @* disabled field not submitted — value carried by hdnProjectmanager *@
                    }
                    else
                    {
                        <input class="govuk-input govuk-!-font-size-16 ra-select-full"
                               id="mgrEditName"
                               name="Projectmanager"
                               type="text"
                               aria-required="true"
                               aria-describedby="mgrEditNameError" />
                        <span class="govuk-error-message" id="mgrEditNameError" style="display:none;"></span>
                    }
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            @* MNumber — mgrEditMNumber text input *@
            <div class="govuk-grid-column-one-half sup_padding_left_10">
                <div class="govuk-form-group sup_margin_bottom_10" id="mgrEditMNumberGroup">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Mnumber">
                        MNumber:
                    </label>
                    @* TRANSFORMENGINE: Mnumber -> mgrEditMNumber in HTML modal *@
                    <input class="govuk-input govuk-!-font-size-16"
                           asp-for="Mnumber"
                           id="mgrEditMNumber"
                           type="text"
                           aria-describedby="mgrEditMNumberError" />
                    <span asp-validation-for="Mnumber" class="govuk-error-message" id="mgrEditMNumberError" style="display:none;"></span>
                </div>
            </div>

            @* Email — mgrEditEmail text input *@
            <div class="govuk-grid-column-one-half sup_padding_right_10">
                <div class="govuk-form-group sup_margin_bottom_10" id="mgrEditEmailGroup">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Email">
                        Manager's email:
                    </label>
                    @* TRANSFORMENGINE: Email -> mgrEditEmail in HTML modal *@
                    <input class="govuk-input govuk-!-font-size-16"
                           asp-for="Email"
                           id="mgrEditEmail"
                           type="text"
                           aria-describedby="mgrEditEmailError" />
                    <span asp-validation-for="Email" class="govuk-error-message" id="mgrEditEmailError" style="display:none;"></span>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            @* Disable checkbox — mgrEditDisabled *@
            <div class="govuk-grid-column-full">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <div class="govuk-checkboxes govuk-checkboxes--small">
                        <div class="govuk-checkboxes__item">
                            @* TRANSFORMENGINE: Disable -> mgrEditDisabled checkbox in HTML modal *@
                            <input class="govuk-checkboxes__input"
                                   asp-for="Disable"
                                   id="mgrEditDisabled"
                                   type="checkbox" />
                            <label class="govuk-label govuk-checkboxes__label govuk-!-font-weight-regular"
                                   asp-for="Disable">
                                Disable
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12" style="text-align: right; margin-top: 10px;">
            <button type="button"
                    class="govuk-button govuk-button--secondary sup_margin_0"
                    onclick="closeModal()">
                Cancel
            </button>
            <button type="button"
                    class="govuk-button sup_margin_0"
                    onclick="saveProjectManager()">
                @saveLabel
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function saveProjectManager() {
            var dbError     = document.getElementById('mgrEditDbError');
            var dbErrorText = document.getElementById('mgrEditDbErrorText');
            if (dbError) dbError.classList.add('ra-hidden');

            $.post({
                url: '/PIMS/Maintenance/SaveProjectManager',
                data: $('#formProjectManager').serialize(),
                success: function (data) {
                    if (data.success) {
                        closeModal();
                        reloadProjectManagersGrid();
                    } else {
                        var msg = data.message || 'Save failed.';
                        if (dbErrorText) dbErrorText.textContent = msg;
                        if (dbError) dbError.classList.remove('ra-hidden');
                    }
                },
                error: function () {
                    if (dbErrorText) dbErrorText.textContent = 'An error occurred while saving.';
                    if (dbError) dbError.classList.remove('ra-hidden');
                }
            });
        }
    </script>
}
