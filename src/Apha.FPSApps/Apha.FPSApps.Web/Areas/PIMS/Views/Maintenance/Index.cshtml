<!-- TRANSFORMENGINE MIGRATION — Index.cshtml (Maintenance)
     Pattern  : stack-upgrade/msaccess-frm-to-dotnet10-mvc-e2e  Phase 12 — Razor Views (Step 18)
     Migrated : 2026-07-06
     CHANGED:
       - MS Access frmMaintainance form -> ASP.NET Core MVC Razor view
       - 6 GOV.UK tabs: Reports, Programme, Manager, Time, Admin Maintenance, Other
       - Each tab hosts DataGrid(s) via shared _DataGrid partial
       - Time Tab uses custom form layout bound to WorkingHoursSettingItem / WorkingDaysSettingItem
       - Manager Tab includes Manager grid + sub-grids (Program / Resource Centre) shown on row click
       - All CRUD operations use shared #modalPopup / #modaPopupBody pattern
       - _govuk_tabs.css + _govuk_tabs.js referenced via @@section Styles / @@section Scripts
       - No page-level filter dropdowns (HTML has no <select> outside grid containers)
     DEFERRED:
       - TRANSFORMENGINE TODO: verify _govuk_tabs.js path matches wwwroot layout
       - TRANSFORMENGINE TODO: confirm SaveSetting AJAX URL matches controller route -->
@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PIMS.Models.MaintenanceViewModel

@{
    ViewData["Title"] = "PIMS : Report Admin Maintenance";
}

@section Styles {
    <link rel="stylesheet" href="~/css/common/_govuk_tabs.css" />
}

<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_bottom_10">
    <div class="govuk-grid-column-full sup_border-bottom">
        <h1 class="govuk-heading-s sup_margin_0 govuk-grid-row govuk-!-padding-top-2 govuk-!-padding-bottom-2">
            Maintenance
        </h1>
    </div>
</div>

<div class="rc-flex-row govuk-!-padding-top-2 ra-layout-wrapper sup_overflow-y-auto">
    <main class="main-content sup_p_0 ra-main-content">

        <div class="govuk-grid-row sup_margin_left_right_0 ra-full-width">
            <div class="govuk-grid-column-full">

                <!-- TRANSFORMENGINE: GOV.UK tabs — _govuk_tabs.js handles tab switching; do NOT inline tab logic -->
                <div class="govuk-tabs ra-tabs" id="mainTabs">
                    <ul class="govuk-tabs__list">
                        <li class="govuk-tabs__list-item">
                            <a class="govuk-tabs__tab" href="#tab-reports">Reports</a>
                        </li>
                        <li class="govuk-tabs__list-item">
                            <a class="govuk-tabs__tab" href="#tab-programme">Programme</a>
                        </li>
                        <li class="govuk-tabs__list-item">
                            <a class="govuk-tabs__tab" href="#tab-manager">Manager</a>
                        </li>
                        <li class="govuk-tabs__list-item">
                            <a class="govuk-tabs__tab" href="#tab-time">Time</a>
                        </li>
                        <li class="govuk-tabs__list-item govuk-tabs__list-item--selected">
                            <a class="govuk-tabs__tab" href="#tab-admin-maintenance">Admin Maintenance</a>
                        </li>
                        <li class="govuk-tabs__list-item">
                            <a class="govuk-tabs__tab" href="#tab-other">Other</a>
                        </li>
                    </ul>

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!--  REPORTS TAB                                           -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="govuk-tabs__panel" id="tab-reports">

                        <!-- Reports Grid -->
                        <div class="ra-grid-wrapper">
                            <div class="ra-grid-toolbar sup_border">
                                <span></span>
                                <button type="button"
                                        class="govuk-button sup_margin_0 ra-btn-add"
                                        id="btnAddReport"
                                        data-module="govuk-button"
                                        aria-label="Add new report"
                                        onclick="addReport()">
                                    + &nbsp; Add Report
                                </button>
                            </div>
                            <div class="govuk-grid-row sup_margin_left_right_0 sup_margin_bottom_10">
                                <div class="govuk-grid-column-full sup_p_0">
                                    <div id="gridContainer_maintenanceTable">
                                        @* TRANSFORMENGINE: Reports DataGrid bound via MaintenanceViewModel.ReportsGrid *@
                                        @await Html.PartialAsync("_DataGrid", Model.ReportsGrid)
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Report Groups Grid -->
                        <div class="sup_margin_top_20 sup_margin_bottom_20">
                            <div class="ra-grid-toolbar">
                                <div class="ra-groups-row">
                                    <span class="govuk-body ra-groups-heading">Report Groups that this report will appear in</span>
                                </div>
                                <div class="govuk-grid-column-full sup_padding_right_left_10 ra-groups-table-wrap">
                                    <div id="gridContainer_reportGroupsTable">
                                        @* TRANSFORMENGINE: ReportGroups DataGrid bound via MaintenanceViewModel.ReportGroupsGrid *@
                                        @await Html.PartialAsync("_DataGrid", Model.ReportGroupsGrid)
                                    </div>
                                </div>
                                <div>
                                    <button type="button"
                                            class="govuk-button sup_margin_0 ra-btn-add"
                                            id="btnAddReportGroup"
                                            data-module="govuk-button"
                                            aria-label="Add Report Group"
                                            style="margin-left:auto;"
                                            onclick="addReportGroup()">
                                        + Add Group
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                    <!-- /Reports Tab -->

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!--  PROGRAMME TAB                                         -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="govuk-tabs__panel" id="tab-programme">
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-two-thirds">
                                <div class="prog-grid-wrapper">
                                    <div class="ra-grid-toolbar sup_border-bottom">
                                        <span></span>
                                        <button type="button"
                                                class="govuk-button ra-btn-add sup_margin_0"
                                                id="btnAddProg"
                                                onclick="addRadTrackProg()">
                                            + Add Programme
                                        </button>
                                    </div>
                                    <div class="govuk-grid-row sup_margin_left_right_0 sup_margin_bottom_10">
                                        <div class="govuk-grid-column-full sup_p_0">
                                            <div id="gridContainer_pimsProgTable">
                                                @* TRANSFORMENGINE: RadTrackProgs DataGrid bound via MaintenanceViewModel.RadTrackProgsGrid *@
                                                @await Html.PartialAsync("_DataGrid", Model.RadTrackProgsGrid)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /Programme Tab -->

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!--  MANAGER TAB                                           -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="govuk-tabs__panel" id="tab-manager">

                        <!-- Manager Grid -->
                        <div class="sup_border mgr-grid-wrapper">
                            <div class="ra-grid-toolbar sup_border-bottom">
                                <span class="govuk-heading-s sup_margin_0 ra-mgr-heading">Manager</span>
                                <button type="button"
                                        class="govuk-button ra-btn-add sup_margin_0"
                                        id="btnAddManager"
                                        onclick="addProjectManager()">
                                    + Add Manager
                                </button>
                            </div>
                            <div class="govuk-grid-row sup_margin_left_right_0 sup_margin_bottom_10">
                                <div class="govuk-grid-column-full sup_p_0">
                                    <div id="gridContainer_mgrTable">
                                        @* TRANSFORMENGINE: ProjectManagers DataGrid bound via MaintenanceViewModel.ProjectManagersGrid *@
                                        @await Html.PartialAsync("_DataGrid", Model.ProjectManagersGrid)
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Manager Sub-Grids (shown on row click) -->
                        <div id="mgrSubGrids" class="mgr-subgrids-wrapper ra-subgrids-hidden">
                            <div class="govuk-grid-row">

                                <!-- Program sub-grid -->
                                <div class="govuk-grid-column-one-half">
                                    <div class="mgr-sub-grid-box">
                                        <div class="ra-grid-toolbar sup_border-bottom">
                                            <span class="govuk-body govuk-!-font-weight-bold sup_margin_0">Program</span>
                                            <button type="button"
                                                    class="govuk-button ra-btn-add sup_margin_0"
                                                    id="btnAddMgrProgram"
                                                    onclick="addProgramManagerLink()">
                                                + Add Program
                                            </button>
                                        </div>
                                        <div class="govuk-grid-column-full sup_p_0 mgr-sub-table-wrapper">
                                            <div id="gridContainer_mgrProgramTable">
                                                @* TRANSFORMENGINE: ProgramManagerLinks sub-grid *@
                                                @await Html.PartialAsync("_DataGrid", Model.ProgramManagerLinksGrid)
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Resource Centre sub-grid -->
                                <div class="govuk-grid-column-one-half">
                                    <div class="mgr-sub-grid-box">
                                        <div class="ra-grid-toolbar sup_border-bottom">
                                            <span class="govuk-body govuk-!-font-weight-bold sup_margin_0">Resource Centre</span>
                                            <button type="button"
                                                    class="govuk-button ra-btn-add sup_margin_0"
                                                    id="btnAddMgrResource"
                                                    onclick="addProfitCentreManagerLink()">
                                                + Add Resource
                                            </button>
                                        </div>
                                        <div class="govuk-grid-column-full sup_p_0 mgr-sub-table-wrapper">
                                            <div id="gridContainer_mgrResourceTable">
                                                @* TRANSFORMENGINE: ProfitCentreManagerLinks sub-grid *@
                                                @await Html.PartialAsync("_DataGrid", Model.ProfitCentreManagerLinksGrid)
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                    <!-- /Manager Tab -->

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!--  TIME TAB                                              -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="govuk-tabs__panel" id="tab-time">

                        <div class="govuk-error-summary ra-form-error-banner ra-hidden"
                             id="timeDbError" role="alert" aria-labelledby="timeDbErrorTitle" tabindex="-1">
                            <h2 class="govuk-error-summary__title govuk-!-font-size-14" id="timeDbErrorTitle">There is a problem</h2>
                            <div class="govuk-error-summary__body">
                                <p class="govuk-body govuk-!-font-size-14" id="timeDbErrorText"></p>
                            </div>
                        </div>

                        <div class="time-form-container">

                            <!-- Working Hours in a Day -->
                            <div class="govuk-form-group time-form-row" id="timeWorkingHoursGroup">
                                <div class="time-form-label-col">
                                    <label for="timeWorkingHours"
                                           class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16">
                                        Working Hours in a Day:
                                        <span class="ra-required-star" aria-hidden="true"> *</span>
                                    </label>
                                </div>
                                <div class="time-form-input-col">
                                    @* TRANSFORMENGINE: WorkingHoursSettingItem.SettingValue bound to timeWorkingHours input *@
                                    <input type="number"
                                           id="timeWorkingHours"
                                           name="timeWorkingHours"
                                           class="govuk-input govuk-!-font-size-16"
                                           step="0.1" min="0.1" max="24"
                                           aria-required="true"
                                           aria-describedby="timeWorkingHoursError timeWorkingHoursHint"
                                           value="@Model.WorkingHoursSettingItem?.SettingValue" />
                                    <p class="govuk-error-message ra-hidden" id="timeWorkingHoursError">
                                        <span class="govuk-visually-hidden">Error:</span>
                                        <span id="timeWorkingHoursErrorText">Working Hours in a Day is required</span>
                                    </p>
                                </div>
                                <div class="time-form-hint-col">
                                    <span class="govuk-hint govuk-!-font-size-16" id="timeWorkingHoursHint">
                                        NB. This is the same figure used in the costbook. Do not adjust without proper consultation
                                    </span>
                                </div>
                            </div>

                            <!-- Working Days in a Year -->
                            <div class="govuk-form-group time-form-row" id="timeWorkingDaysGroup">
                                <div class="time-form-label-col">
                                    <label for="timeWorkingDays"
                                           class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16">
                                        Working Days in a Year:
                                        <span class="ra-required-star" aria-hidden="true"> *</span>
                                    </label>
                                </div>
                                <div class="time-form-input-col">
                                    @* TRANSFORMENGINE: WorkingDaysSettingItem.SettingValue bound to timeWorkingDays input *@
                                    <input type="number"
                                           id="timeWorkingDays"
                                           name="timeWorkingDays"
                                           class="govuk-input govuk-!-font-size-16"
                                           step="0.5" min="0.5" max="366"
                                           aria-required="true"
                                           aria-describedby="timeWorkingDaysError"
                                           value="@Model.WorkingDaysSettingItem?.SettingValue" />
                                    <p class="govuk-error-message ra-hidden" id="timeWorkingDaysError">
                                        <span class="govuk-visually-hidden">Error:</span>
                                        <span id="timeWorkingDaysErrorText">Working Days in a Year is required</span>
                                    </p>
                                </div>
                                <div class="time-form-hint-col"></div>
                            </div>

                        </div>

                        <div class="time-form-footer">
                            <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
                                    id="btnCancelTime" onclick="cancelTimeTab()">Cancel</button>
                            <button type="button" class="govuk-button sup_margin_0"
                                    id="btnSaveTime" onclick="saveTimeTab()">Save</button>
                        </div>

                    </div>
                    <!-- /Time Tab -->

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!--  ADMIN MAINTENANCE TAB                                 -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="govuk-tabs__panel active" id="tab-admin-maintenance">
                        <div class="admin-layout">

                            <!-- Users Grid -->
                            <div class="admin-users-panel">
                                <div class="admin-panel-header">
                                    <span>Users (First add users here)</span>
                                    <button type="button"
                                            class="govuk-button ra-btn-add sup_margin_0"
                                            id="btnAddUser"
                                            onclick="addAccessUser()">
                                        + Add User
                                    </button>
                                </div>
                                <div class="govuk-grid-column-full sup_p_0 admin-table-scroll">
                                    <div id="gridContainer_adminUsersTable">
                                        @* TRANSFORMENGINE: AccessUsers DataGrid — admin.js columns: ntlogin(170), username(240) *@
                                        @await Html.PartialAsync("_DataGrid", Model.AccessUsersGrid)
                                    </div>
                                </div>
                            </div>

                            <!-- User Access Grid -->
                            <div class="admin-access-panel">
                                <div class="admin-panel-header">
                                    <span>User Access (Add or remove permissions here)</span>
                                    <button type="button"
                                            class="govuk-button ra-btn-add sup_margin_0"
                                            id="btnAddAccess"
                                            onclick="addAccessUserLevel()">
                                        + Add Access
                                    </button>
                                </div>
                                <div class="govuk-grid-column-full sup_p_0 admin-table-scroll">
                                    <div id="gridContainer_adminAccessTable">
                                        @* TRANSFORMENGINE: AccessUserLevels DataGrid — admin.js columns: user(220), accessLevel(180) *@
                                        @await Html.PartialAsync("_DataGrid", Model.AccessUserLevelsGrid)
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <!-- /Admin Maintenance Tab -->

                    <!-- ═══════════════════════════════════════════════════════ -->
                    <!--  OTHER TAB                                             -->
                    <!-- ═══════════════════════════════════════════════════════ -->
                    <div class="govuk-tabs__panel" id="tab-other">
                        <div class="other-layout">

                            <!-- Grid 1 – List Description (Frequencies) -->
                            <div class="other-list-panel">
                                <div class="other-panel-header">List Description</div>
                                <div class="govuk-grid-column-full sup_p_0">
                                    <div id="gridContainer_otherListTable">
                                        @* TRANSFORMENGINE: Frequencies DataGrid (otherListTable) *@
                                        @await Html.PartialAsync("_DataGrid", Model.FrequenciesGrid)
                                    </div>
                                </div>
                            </div>

                            <!-- Grid 2 – Values (ReviewItems) -->
                            <div class="govuk-grid-column-two-thirds" id="otherValuesPanel">
                                <div class="govuk-grid-row">
                                    <div class="govuk-grid-column-full sup_p_0">
                                        <div id="gridContainer_otherValuesTable">
                                            @* TRANSFORMENGINE: ReviewItems DataGrid (otherValuesTable) *@
                                            @await Html.PartialAsync("_DataGrid", Model.ReviewItemsGrid)
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <!-- /Other Tab -->

                </div>
                <!-- /GOV.UK Tabs -->

                <div id="detail-panel-status" role="status" aria-live="polite" class="govuk-visually-hidden"></div>

            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/common/_govuk_tabs.js"></script>
    <script>
        // ── Stored original Time Tab values for Cancel ────────────────────────────
        var _timeOrigWorkingHours = document.getElementById('timeWorkingHours')?.value || '';
        var _timeOrigWorkingDays  = document.getElementById('timeWorkingDays')?.value  || '';

        // ── Current Manager context (for sub-grid reload) ─────────────────────────
        var _currentManagerName = '';

        // ════════════════════════════════════════════════════════════
        //  GRID RELOAD HELPERS
        //  ALWAYS use gm.reloadGrid({ page: 1 }) — NOT gm.reload()
        // ════════════════════════════════════════════════════════════

        function reloadReportsGrid() {
            var gm = window['gridManager_maintenanceTable'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadReportGroupsGrid() {
            var gm = window['gridManager_reportGroupsTable'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadRadTrackProgsGrid() {
            var gm = window['gridManager_pimsProgTable'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadProjectManagersGrid() {
            var gm = window['gridManager_mgrTable'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadProgramManagerLinksGrid() {
            var gm = window['gridManager_mgrProgramTable'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadProfitCentreManagerLinksGrid() {
            var gm = window['gridManager_mgrResourceTable'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadAccessUsersGrid() {
            var gm = window['gridManager_adminUsersTable'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadAccessUserLevelsGrid() {
            var gm = window['gridManager_adminAccessTable'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadFrequenciesGrid() {
            var gm = window['gridManager_otherListTable'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadReviewItemsGrid() {
            var gm = window['gridManager_otherValuesTable'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        // ════════════════════════════════════════════════════════════
        //  EXTRA FILTER METHODS (called automatically by _DataGrid)
        // ════════════════════════════════════════════════════════════

        function getReportsExtraFilters()              { return {}; }
        function getReportGroupsExtraFilters()         { return {}; }
        function getRadTrackProgsExtraFilters()        { return {}; }
        function getProjectManagersExtraFilters()      { return {}; }
        function getProgramManagerLinksExtraFilters()  { return { manager: _currentManagerName }; }
        function getProfitCentreManagerLinksExtraFilters() { return { manager: _currentManagerName }; }
        function getAccessUsersExtraFilters()          { return {}; }
        function getAccessUserLevelsExtraFilters()     { return {}; }
        function getFrequenciesExtraFilters()          { return {}; }
        function getReviewItemsExtraFilters()          { return {}; }

        // ════════════════════════════════════════════════════════════
        //  MODAL HELPERS
        // ════════════════════════════════════════════════════════════

        function closeModal() {
            $('#modaPopupBody').html('');
            $('#modalPopup').removeClass('show');
        }

        // ════════════════════════════════════════════════════════════
        //  REPORTS TAB — Add / Edit / Delete
        // ════════════════════════════════════════════════════════════

        function addReport() {
            $.get('/PIMS/Maintenance/GetAddEditReportPartial', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function editReport(btn) {
            var id = $(btn).data('id');
            $.get('/PIMS/Maintenance/GetAddEditReportPartial', { id: id }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function deleteReport(btn) {
            var id = $(btn).data('id');
            if (confirm('Are you sure you want to delete this report?')) {
                $.ajax({
                    url: '/PIMS/Maintenance/DeleteReport?id=' + encodeURIComponent(id),
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            alert('Report deleted successfully.');
                            reloadReportsGrid();
                        } else {
                            alert('Error: ' + (response.message || 'Delete failed.'));
                        }
                    },
                    error: function () { alert('An error occurred while deleting the report.'); }
                });
            }
        }

        // ════════════════════════════════════════════════════════════
        //  REPORTS TAB — Report Groups
        // ════════════════════════════════════════════════════════════

        function addReportGroup() {
            $.get('/PIMS/Maintenance/GetAddEditReportGroupPartial', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function editReportGroup(btn) {
            var groupid = $(btn).data('id');
            $.get('/PIMS/Maintenance/GetAddEditReportGroupPartial', { groupid: groupid }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function deleteReportGroup(btn) {
            var groupid = $(btn).data('id');
            if (confirm('Are you sure you want to delete this report group?')) {
                $.ajax({
                    url: '/PIMS/Maintenance/DeleteReportGroup?groupid=' + encodeURIComponent(groupid),
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            alert('Report group deleted successfully.');
                            reloadReportGroupsGrid();
                        } else {
                            alert('Error: ' + (response.message || 'Delete failed.'));
                        }
                    },
                    error: function () { alert('An error occurred while deleting the report group.'); }
                });
            }
        }

        // ════════════════════════════════════════════════════════════
        //  PROGRAMME TAB
        // ════════════════════════════════════════════════════════════

        function addRadTrackProg() {
            $.get('/PIMS/Maintenance/GetAddEditRadTrackProgPartial', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function editRadTrackProg(btn) {
            var program = $(btn).data('id');
            $.get('/PIMS/Maintenance/GetAddEditRadTrackProgPartial', { program: program }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function deleteRadTrackProg(btn) {
            var program = $(btn).data('id');
            if (confirm('Are you sure you want to delete this programme?')) {
                $.ajax({
                    url: '/PIMS/Maintenance/DeleteRadTrackProg?program=' + encodeURIComponent(program),
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            alert('Programme deleted successfully.');
                            reloadRadTrackProgsGrid();
                        } else {
                            alert('Error: ' + (response.message || 'Delete failed.'));
                        }
                    },
                    error: function () { alert('An error occurred while deleting the programme.'); }
                });
            }
        }

        // ════════════════════════════════════════════════════════════
        //  MANAGER TAB — Project Managers
        // ════════════════════════════════════════════════════════════

        function addProjectManager() {
            $.get('/PIMS/Maintenance/GetAddEditProjectManagerPartial', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function editProjectManager(btn) {
            var projectmanager = $(btn).data('id');
            $.get('/PIMS/Maintenance/GetAddEditProjectManagerPartial', { projectmanager: projectmanager }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function deleteProjectManager(btn) {
            var projectmanager = $(btn).data('id');
            if (confirm('Are you sure you want to delete this manager?')) {
                $.ajax({
