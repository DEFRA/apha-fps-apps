@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PIMS.Models.ProjectYearCostsViewModel

@{
    ViewData["Title"] = "PIMS : Yearly Finances";
}

<div class="govuk-grid-row sup_border-bottom" style="padding: 0">
    <h5 class="govuk-heading-s sup_margin_0"
        style="padding: 10px 0 5px 24px; border-bottom: 2px solid #1d70b8">
        Yearly Finances
    </h5>
</div>

<div class="d-flex govuk-!-padding-top-2">

    <!-- ── Side Navigation ──────────────────────────────────── -->
    @await Html.PartialAsync("_SideNav", new Apha.FPSApps.Web.Areas.PIMS.Models.ProjectDetailsViewModel
    {
        Parentproject = Model.Parentproject
    })

    <!-- ── Main Content ─────────────────────────────────────── -->
    <main class="main-content" style="padding-top: 0">

        <!-- ── Filters row ─────────────────────────────────── -->
        <div class="govuk-grid-row govuk-!-margin-bottom-3" id="search-grid">
            <div class="sup_search_panel sup_p_0 sup_border_b_0"
                 style="overflow: visible; border: 0; padding: 0">
                <div class="govuk-grid-column-full sup_flex_between_center"
                     style="align-items: flex-end">
                    <div class="govuk-grid-row"
                         style="margin: 8px; display: flex; align-items: flex-end;">

                        <div style="margin: 0 7px; flex: 1;">
                            <label for="dpprojectSelect" class="govuk-label tab-font-size">
                                Select a Project
                            </label>
                            <select id="dpprojectSelect"
                                    class="govuk-select project-dropdown tab-font-size"
                                    style="width: 100%;">
                                <option value="">Select a Project</option>
                                @foreach (var item in Model.ProjectOptions)
                                {
                                    if (item.Value == Model.Parentproject)
                                    {
                                        <option value="@item.Value" selected="selected">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>

                        <div style="margin: 0 5px; flex: 1;">
                            <label for="dpyear" class="govuk-label tab-font-size">Year</label>
                            <select id="dpyear"
                                    class="govuk-select project-dropdown tab-font-size"
                                    style="width: 100%;">
                                <option value="">Year</option>
                                @foreach (var item in Model.YearOptions)
                                {
                                    if (item.Value == Model.SelectedYear.ToString())
                                    {
                                        <option value="@item.Value" selected="selected">@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ── Tabs ─────────────────────────────────────────── -->
        <div class="govuk-template__body js-enabled govuk-frontend-supported">
            <div class="govuk-tabs" data-module="govuk-tabs">
                <ul class="govuk-tabs__list">
                    <li class="govuk-tabs__list-item tab-3-side-border" id="tab_nav-monthlyPact" role="presentation">
                        <a class="govuk-tabs__tab" href="#nav-monthlyPact" role="tab"
                           aria-controls="nav-monthlyPact" style="font-size: 14px; text-decoration: none">
                            Monthly Pact Data
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item tab-3-side-border" id="tab_nav-pact-pay" role="presentation">
                        <a class="govuk-tabs__tab" href="#nav-pact-pay" role="tab"
                           aria-controls="nav-pact-pay" style="font-size: 14px; text-decoration: none">
                            Pact Pay
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item tab-3-side-border" id="tab_nav-project-details" role="presentation">
                        <a class="govuk-tabs__tab" href="#nav-project-details" role="tab"
                           aria-controls="nav-project-details" style="font-size: 14px; text-decoration: none">
                            Project Details
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item tab-3-side-border" id="tab_nav-plan" role="presentation">
                        <a class="govuk-tabs__tab" href="#nav-plan" role="tab"
                           aria-controls="nav-plan" style="font-size: 14px; text-decoration: none">
                            Plan
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item tab-3-side-border" id="tab_nav-staff-plan" role="presentation">
                        <a class="govuk-tabs__tab" href="#nav-staff-plan" role="tab"
                           aria-controls="nav-staff-plan" style="font-size: 14px; text-decoration: none">
                            Staff Plan vs Actuals
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item tab-3-side-border" id="tab_nav-test-plan" role="presentation">
                        <a class="govuk-tabs__tab" href="#nav-test-plan" role="tab"
                           aria-controls="nav-test-plan" style="font-size: 14px; text-decoration: none">
                            Test Plan vs Actuals
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item tab-3-side-border" id="tab_nav-animal-plan" role="presentation">
                        <a class="govuk-tabs__tab" href="#nav-animal-plan" role="tab"
                           aria-controls="nav-animal-plan" style="font-size: 14px; text-decoration: none">
                            Animal Plan vs Actuals
                        </a>
                    </li>
                    <li class="govuk-tabs__list-item govuk-tabs__list-item--selected tab-3-side-border"
                        id="tab_nav-additional-cost" role="presentation">
                        <a class="govuk-tabs__tab" href="#nav-additional-cost" role="tab"
                           aria-controls="nav-additional-cost" style="font-size: 14px; text-decoration: none">
                            Additional Cost Plan vs Actuals
                        </a>
                    </li>
                </ul>

                <!-- Placeholder panels -->
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden govuk-!-padding-2"
                     id="nav-monthlyPact" role="tabpanel" aria-labelledby="tab_nav-monthlyPact">
                    <p class="govuk-body govuk-hint">Monthly Pact Data — coming soon.</p>
                </div>
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden govuk-!-padding-2"
                     id="nav-pact-pay" role="tabpanel" aria-labelledby="tab_nav-pact-pay">
                    <p class="govuk-body govuk-hint">Pact Pay — coming soon.</p>
                </div>
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden govuk-!-padding-2"
                     id="nav-project-details" role="tabpanel" aria-labelledby="tab_nav-project-details">
                    <p class="govuk-body govuk-hint">Project Details — coming soon.</p>
                </div>
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden govuk-!-padding-2"
                     id="nav-plan" role="tabpanel" aria-labelledby="tab_nav-plan">
                    <p class="govuk-body govuk-hint">Plan — coming soon.</p>
                </div>
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden govuk-!-padding-2"
                     id="nav-staff-plan" role="tabpanel" aria-labelledby="tab_nav-staff-plan">
                    <p class="govuk-body govuk-hint">Staff Plan vs Actuals — coming soon.</p>
                </div>
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden govuk-!-padding-2"
                     id="nav-test-plan" role="tabpanel" aria-labelledby="tab_nav-test-plan">
                    <p class="govuk-body govuk-hint">Test Plan vs Actuals — coming soon.</p>
                </div>

                <!-- ── Animal Plan vs Actuals tab ─────────────────────────────────────────
                     NOTE: panel starts hidden (GOV.UK tabs controls visibility via JS).
                     Grids are server-rendered so data is already present; reloadGrid is
                     called on filter change exactly like the Additional Cost tab.        -->
                <div class="govuk-tabs__panel govuk-tabs__panel--hidden govuk-!-padding-2"
                     id="nav-animal-plan" role="tabpanel"
                     aria-labelledby="tab_nav-animal-plan">
                    <div class="govuk-grid-row">

                        <!-- Animal Plan (left) -->
                        <div class="govuk-grid-column-one-half">
                            <div id="@($"gridContainer_{Model.AnimalPlansGrid.GridId}")">
                                @await Html.PartialAsync("_DataGrid", Model.AnimalPlansGrid)
                            </div>
                        </div>

                        <!-- Animal Actuals (right) -->
                        <div class="govuk-grid-column-one-half">
                            <div id="@($"gridContainer_{Model.AnimalActualsGrid.GridId}")">
                                @await Html.PartialAsync("_DataGrid", Model.AnimalActualsGrid)
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ── Additional Cost Plan vs Actuals tab ─────────────────────────────── -->
                <div class="govuk-tabs__panel govuk-!-padding-2"
                     id="nav-additional-cost" role="tabpanel"
                     aria-labelledby="tab_nav-additional-cost">
                    <div class="govuk-grid-row">

                        <!-- Additional Cost Plan (left) -->
                        <div class="govuk-grid-column-one-half">
                            <div id="@($"gridContainer_{Model.AdditionalPlansGrid.GridId}")">
                                @await Html.PartialAsync("_DataGrid", Model.AdditionalPlansGrid)
                            </div>
                        </div>

                        <!-- Additional Actuals (right) -->
                        <div class="govuk-grid-column-one-half">
                            <div id="@($"gridContainer_{Model.AdditionalActualsGrid.GridId}")">
                                @await Html.PartialAsync("_DataGrid", Model.AdditionalActualsGrid)
                            </div>
                        </div>

                    </div>
                </div>

            </div><!-- /govuk-tabs -->
        </div>

    </main>
</div>

@section Scripts {
<script>
    var plansGridId         = '@Model.AdditionalPlansGrid.GridId';
    var actualsGridId       = '@Model.AdditionalActualsGrid.GridId';
    var animalPlansGridId   = '@Model.AnimalPlansGrid.GridId';
    var animalActualsGridId = '@Model.AnimalActualsGrid.GridId';

    function getYearCostsExtraFilters() {
        return {
            project: document.getElementById('dpprojectSelect').value,
            year:    document.getElementById('dpyear').value
        };
    }

    function getPlansGridManager()         { return window['gridManager_' + plansGridId]; }
    function getActualsGridManager()       { return window['gridManager_' + actualsGridId]; }
    function getAnimalPlansGridManager()   { return window['gridManager_' + animalPlansGridId]; }
    function getAnimalActualsGridManager() { return window['gridManager_' + animalActualsGridId]; }

    // Both tabs are server-rendered — mark both as loaded so filter-change works
    var loadedTabs = {
        'nav-additional-cost': true,
        'nav-animal-plan':     true
    };

    // ── Panel visibility (GOV.UK Frontend JS is not loaded in the layout,
    //    so we manage show/hide manually exactly as CostBook does) ─────────
    function showPanel(panelId) {
        document.querySelectorAll('.govuk-tabs__panel').forEach(function (p) {
            if (p.id === panelId) {
                p.classList.remove('govuk-tabs__panel--hidden');
                p.style.display = 'block';
            } else {
                p.classList.add('govuk-tabs__panel--hidden');
                p.style.display = 'none';
            }
        });

        // Update selected tab styling
        document.querySelectorAll('.govuk-tabs__list-item').forEach(function (li) {
            li.classList.remove('govuk-tabs__list-item--selected');
        });
        var activeLink = document.querySelector('.govuk-tabs__tab[aria-controls="' + panelId + '"]');
        if (activeLink) {
            activeLink.closest('.govuk-tabs__list-item').classList.add('govuk-tabs__list-item--selected');
        }
    }

    function refreshActiveTab() {
        var activePanel = document.querySelector('.govuk-tabs__panel:not(.govuk-tabs__panel--hidden)');
        if (!activePanel) return;
        refreshTabById(activePanel.id);
    }

    function refreshTabById(tabId) {
        var project = document.getElementById('dpprojectSelect').value;
        var year    = document.getElementById('dpyear').value;
        if (!project || !year) return;

        if (tabId === 'nav-additional-cost') {
            var plansGm   = getPlansGridManager();
            var actualsGm = getActualsGridManager();
            if (plansGm)   plansGm.reloadGrid({ page: 1 });
            if (actualsGm) actualsGm.reloadGrid({ page: 1 });
        } else if (tabId === 'nav-animal-plan') {
            var animalPlansGm   = getAnimalPlansGridManager();
            var animalActualsGm = getAnimalActualsGridManager();
            if (animalPlansGm)   animalPlansGm.reloadGrid({ page: 1 });
            if (animalActualsGm) animalActualsGm.reloadGrid({ page: 1 });
        }
    }

    document.addEventListener('DOMContentLoaded', function () {

        // ── Wire up tab clicks: show panel + refresh grids ────────────────
        document.querySelectorAll('.govuk-tabs__tab').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                var panelId = this.getAttribute('aria-controls');
                if (!panelId) return;

                showPanel(panelId);

                if (loadedTabs[panelId]) {
                    refreshTabById(panelId);
                }
            });
        });

        // ── On arrival, honour the URL hash or default to additional-cost ─
        var hash = window.location.hash ? window.location.hash.substring(1) : 'nav-additional-cost';
        var targetPanel = document.getElementById(hash);
        var defaultPanel = hash && targetPanel ? hash : 'nav-additional-cost';

        // Hide all panels first, then show the target
        document.querySelectorAll('.govuk-tabs__panel').forEach(function (p) {
            p.classList.add('govuk-tabs__panel--hidden');
            p.style.display = 'none';
        });
        showPanel(defaultPanel);

        // If the landing tab has grids, reload them after _DataGrid scripts register
        if (loadedTabs[defaultPanel]) {
            setTimeout(function () { refreshTabById(defaultPanel); }, 300);
        }
    });

    document.getElementById('dpprojectSelect').addEventListener('change', refreshActiveTab);
    document.getElementById('dpyear').addEventListener('change', refreshActiveTab);
</script>
}
