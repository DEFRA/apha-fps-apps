@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PIMS.Models.CommentViewModel

@{
    ViewData["Title"] = "PIMS : Comments";
}

<div class="govuk-grid-row sup_border-bottom" style="padding: 0">
    <h5 class="govuk-heading-s sup_margin_0"
        style="padding: 10px 0 5px 24px;">
        Comments
    </h5>
</div>

<div class="content-wrapper govuk-!-padding-top-2">
    <div class="sup_flex sup_align-items-flex-start">

        <!-- ── Side Navigation ──────────────────────────────────────────── -->
        @await Html.PartialAsync("_SideNav", new Apha.FPSApps.Web.Areas.PIMS.Models.ProjectDetailsViewModel
        {
            Parentproject = Model.Parentproject
        })

        <!-- ── Main Content ─────────────────────────────────────────────── -->
        <main class="ra-main-content sup_p_0 sup_width_100">

            <!-- ── Filter / header row (4-column compact layout) ───────────── -->
            <div class="sup_margin_left_right_0 sup_padding_right_20 sup_margin_bottom_10">
                <div class="govuk-grid-column-full govuk-!-margin-left-1">
                    <table class="govuk-table sup-filters-table govuk-!-margin-bottom-2">
                        <thead class="govuk-visually-hidden">
                            <tr>
                                <th scope="col">Project and forecast spend</th>
                                <th scope="col">Comment filters</th>
                            </tr>
                        </thead>
                        <tbody>
                        <tr>
                            <!-- Column 1: Project + Forecast (two rows in a nested table for inline label/control alignment) -->
                            <td class="sup-col-1">
                                <table class="govuk-table sup-nested-table">
                                    <thead class="govuk-visually-hidden">
                                        <tr>
                                            <th scope="col">Field</th>
                                            <th scope="col">Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    <tr>
                                        <td class="sup-cell-label"><label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="commentProject">Project</label></td>
                                        <td class="sup-cell-control"><select class="govuk-select govuk-!-font-size-16 " id="commentProject" name="commentProject" asp-items="Model.ProjectOptions" onchange="onProjectChanged()"></select></td>
                                    </tr>
                                    <tr>
                                        <td class="sup-cell-label"><label class="govuk-label govuk-!-font-size-16 sup_font_weight_700" for="forecastSpend">Forecast Spend (%)</label></td>
                                        <td class="sup-cell-control">
                                            <div class="sup-inline-control">
                                                <input class="govuk-input govuk-!-font-size-16 " id="forecastSpend" name="forecastSpend" value="@Model.ForecastSpend" />
                                                <button type="button" class="govuk-button govuk-button--start" id="btnSaveForecastSpend" onclick="saveForecastSpendIfChanged()">Save</button>
                                            </div>
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>
                            </td>

                            <!-- Column 4: Filter title plus Topic + Year nested table (Filter title moved above Topic) -->
                            <td class="sup-col-4 govuk-!-margin-left-2">
                                <div class="sup-filter-box">
                                    
                                    <table class="govuk-table sup-nested-table ">
                                        <thead class="govuk-visually-hidden">
                                            <tr>
                                                <th scope="col">Section</th>
                                                <th scope="col">Filter field</th>
                                                <th scope="col">Filter value</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        <tr>
                                            <td><label class="govuk-!-padding-bottom-1 govuk-label govuk-!-font-size-16 sup_font_weight_700">Filter</label></td>
                                            <td class="sup-cell-label"><label class="govuk-label govuk-label govuk-!-font-size-16 sup_font_weight_700" for="filterTopic">Topic</label></td>
                                            <td class="sup-cell-control"><select class="govuk-select govuk-label govuk-!-font-size-16" id="filterTopic" name="filterTopic" asp-items="Model.TopicOptions" onchange="reloadCommentsGrid()"></select></td>
                                        </tr>
                                        <tr>
                                            <td></td>
                                            <td class="sup-cell-label"><label class="govuk-label govuk-label govuk-!-font-size-16 sup_font_weight_700" for="filterYear">Year</label></td>
                                            <td class="sup-cell-control"><input class="govuk-input govuk-label govuk-!-font-size-16" id="filterYear" name="filterYear" maxlength="4" inputmode="numeric" pattern="[0-9]*" oninput="onYearFilterChanged(this)" onkeydown="if (event.key === 'Enter') { event.preventDefault(); applyCommentsFilter(); }" /></td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </td>

                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ── Comments DataGrid ──────────────────────────────────────── -->
            
            <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_20">
                <div class="govuk-grid-column-full">
                    <div id="gridContainer_comments">
                        @await Html.PartialAsync("_DataGrid", Model.CommentsGrid)
                    </div>
                </div>
            </div>

        </main>
    </div>
</div>


@Html.AntiForgeryToken()

@section Scripts {
    <script>
        // ── Sidebar ─────────────────────────────────────────────────────────────
        function toggleSidebar() {
            document.querySelector('.sidenav').classList.toggle('collapsed');
        }

        // ── Extra filter method ─────────────────────────────────────────────────
        
        function normalizeCommentsYear(value) {
            return (value || '').toString().replace(/[^0-9]/g, '').slice(0, 4);
        }

        function getCommentsYearFilterValue() {
            var year = normalizeCommentsYear(document.getElementById('filterYear')?.value || '');
            return year.length === 4 ? year : '';
        }

        function getCommentsExtraFilters() {
            return {
                project: document.getElementById('commentProject')?.value || '',
                topic:   document.getElementById('filterTopic')?.value   || '',
                year:    getCommentsYearFilterValue()
            };
        }

        // ── Grid reload ─────────────────────────────────────────────────────────
        
        function reloadCommentsGrid() {
            var gm = window['gridManager_comments'];
            if (gm) {
                gm.reloadGrid({ page: 1 });
                return;
            }

            var extra = getCommentsExtraFilters();
            $.post('/PIMS/Comment/LoadCommentsGrid', {
                page: 1,
                pageSize: 10,
                sortBy: '',
                descending: false,
                filter: '{}',
                project: extra.project,
                topic: extra.topic,
                year: extra.year
            }).done(function (htmlData) {
                $('#gridContainer_comments').html(htmlData);
            });
        }

        function applyCommentsFilter() {
            reloadCommentsGrid();
        }

        // ── Live year filter ─────────────────────────────────────────────────────
        function onYearFilterChanged(input) {
            if (!input) {
                return;
            }

            var normalized = normalizeCommentsYear(input.value);
            if (input.value !== normalized) {
                input.value = normalized;
            }
        }

        // ── Project changed ─────────────────────────────────────────────────────
        
        var forecastSpendLastValue = '';
        var forecastSpendLastProject = '';
        var forecastSpendSaving = false;

        function normalizeForecastSpend(value) {
            return (value ?? '').toString().trim().replace(',', '.');
        }

        function parseForecastSpend(value) {
            var normalized = normalizeForecastSpend(value);
            if (!normalized) {
                return { valid: true, value: null, normalized: '' };
            }

            var parsed = Number(normalized);
            if (!Number.isFinite(parsed)) {
                return { valid: false, value: null, normalized: normalized };
            }

            return { valid: true, value: parsed, normalized: normalized };
        }

        function saveForecastSpendIfChanged() {
            var project = document.getElementById('commentProject')?.value || '';
            var input = document.getElementById('forecastSpend');
            if (!project || !input || forecastSpendSaving) {
                return;
            }

            var parsed = parseForecastSpend(input.value);
            if (!parsed.valid) {
                showAlertMessage('Forecast Spend must be a valid number.', AlertType.ERROR);
                input.value = forecastSpendLastValue;
                return;
            }

            if (forecastSpendLastProject === project && parsed.normalized === forecastSpendLastValue) {
                return;
            }

            var token = $('body > input[name="__RequestVerificationToken"]').val()
                || $('input[name="__RequestVerificationToken"]').first().val();

            forecastSpendSaving = true;
            $.ajax({
                url: '/PIMS/Comment/SaveForecastSpend?project=' + encodeURIComponent(project),
                type: 'POST',
                data: JSON.stringify({ forecastSpend: parsed.value }),
                contentType: 'application/json; charset=utf-8',
                headers: { 'RequestVerificationToken': token },
                success: function (data) {
                    if (data && data.success) {
                        var savedValue = (data.forecastSpend === null || data.forecastSpend === undefined) ? '' : data.forecastSpend.toString();
                        input.value = savedValue;
                        forecastSpendLastValue = normalizeForecastSpend(savedValue);
                        forecastSpendLastProject = project;
                    } else {
                        showAlertMessage(data?.message || 'Failed to save forecast spend.', AlertType.ERROR);
                    }
                },
                error: function () {
                    showAlertMessage('An error occurred while saving forecast spend.', AlertType.ERROR);
                },
                complete: function () {
                    forecastSpendSaving = false;
                }
            });
        }

        function onProjectChanged() {
            var project = document.getElementById('commentProject')?.value || '';

            if (!project) {
                var topicEl = document.getElementById('filterTopic');
                if (topicEl) { topicEl.value = ''; }

                var yearEl = document.getElementById('filterYear');
                if (yearEl) { yearEl.value = ''; }

                document.getElementById('forecastSpend').value = '';
                forecastSpendLastValue = '';
                forecastSpendLastProject = '';
                reloadCommentsGrid();
                return;
            }

            reloadCommentsGrid();
            $.get('/PIMS/Comment/GetForecastSpend', { project: project }, function (data) {
                var loadedValue = (data && data.forecastSpend !== null && data.forecastSpend !== undefined)
                    ? data.forecastSpend.toString()
                    : '';
                document.getElementById('forecastSpend').value = loadedValue;
                forecastSpendLastValue = normalizeForecastSpend(loadedValue);
                forecastSpendLastProject = project;
            }).fail(function () {
                document.getElementById('forecastSpend').value = '';
                forecastSpendLastValue = '';
                forecastSpendLastProject = project;
            });
        }

        // ── Add ─────────────────────────────────────────────────────────────────
        
        function addComment() {
            var project = document.getElementById('commentProject')?.value || '';
            var year    = document.getElementById('filterYear')?.value     || '';
            $.get('/PIMS/Comment/GetAddEditCommentPartial',
                { parentproject: project, commentNo: null, selectedYear: year || null },
                function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                });
        }

        // ── Edit ─────────────────────────────────────────────────────────────────
        
        function editComment(btn) {
            var commentNo = $(btn).data('id');
            var project   = document.getElementById('commentProject')?.value || '';
            $.get('/PIMS/Comment/GetAddEditCommentPartial',
                { parentproject: project, commentNo: commentNo, selectedYear: null },
                function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                });
        }

        // ── Delete ───────────────────────────────────────────────────────────────
        
        function deleteComment(btn) {
            var commentNo = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this comment?').then(function (result) {
                if (!result) return;
                var token = $('body > input[name="__RequestVerificationToken"]').val()
                    || $('input[name="__RequestVerificationToken"]').first().val();
                $.ajax({
                    url:     '/PIMS/Comment/DeleteComment?commentNo=' + encodeURIComponent(commentNo),
                    type:    'DELETE',
                    headers: { 'RequestVerificationToken': token },
                    success: function (data) {
                        if (data.success) {
                            showAlertMessage(data.message, AlertType.SUCCESS).then(function () {
                                reloadCommentsGrid();
                            });
                        } else {
                            showAlertMessage(data.errors?.map(function(e) { return e.message; }).join(', ') || 'Delete failed. Please try again.', AlertType.ERROR);
                        }
                    },
                    error: function () { showAlertMessage('An error occurred while deleting the comment.', AlertType.ERROR); }
                });
            });
        }

        // ── Save (called from _AddEditComment partial) ────────────────────────────
        function clearCommentValidationErrors() {
            $('#tblCommentsDbError').addClass('sup_display_none');
            $('#tblCommentsDbErrorText').text('');

            $('[data-field-group="modal-commentYear"]').removeClass('govuk-form-group--error');
            $('[data-field-group="modal-commentYearTopic"]').removeClass('govuk-form-group--error');
            $('[data-field-group="modal-commentText"]').removeClass('govuk-form-group--error');

            $('#modal-commentYear-error').addClass('sup_display_none').find('span:last').text('');
            $('#modal-commentYearTopic-error').addClass('sup_display_none').find('span:last').text('');
            $('#modal-commentText-error').addClass('sup_display_none').find('span:last').text('');
        }

        function setCommentFieldError(fieldGroup, errorId, message) {
            if (!message) return;
            $('[data-field-group="' + fieldGroup + '"]').addClass('govuk-form-group--error');
            $('#' + errorId).removeClass('sup_display_none').find('span:last').text(message);
        }

        function showCommentSummaryError(message) {
            if (!message) return;
            $('#tblCommentsDbErrorText').text(message);
            $('#tblCommentsDbError').removeClass('sup_display_none');
        }

        function displayCommentValidationErrors(errors) {
            clearCommentValidationErrors();

            (errors || []).forEach(function (error) {
                var field = ((error && error.field) || '').toString().toLowerCase();
                var message = ((error && error.message) || '').toString().trim();
                if (!message) return;

                if (field === 'year') {
                    setCommentFieldError('modal-commentYear', 'modal-commentYear-error', message);
                } else if (field === 'topic' || field === 'yeartopic') {
                    setCommentFieldError('modal-commentYearTopic', 'modal-commentYearTopic-error', message);
                } else if (field === 'commenttext' || field === 'comment') {
                    setCommentFieldError('modal-commentText', 'modal-commentText-error', message);
                }
            });
        }

        function saveComment() {
            var isAddingValue = (document.getElementById('hdnIsAddingNew')?.value || '').toString().toLowerCase();
            var isAdding      = isAddingValue === 'true' || isAddingValue === '1' || isAddingValue === 'yes';
            var commentNo     = parseInt(document.getElementById('hdnCommentNo')?.value  || '0', 10);
            var project       = document.getElementById('hdnProject')?.value             || '';
            var year          = (document.getElementById('selCommentYear')?.value || '').trim();
            var topic         = (document.getElementById('selCommentTopic')?.value || '').trim();
            var commentTxt    = document.getElementById('txtCommentText')?.value         || '';
            var commentTxtVal = commentTxt.trim();

            var errors = [];
            if (!year)          { errors.push({ field: 'Year', message: 'Please select Year.' }); }
            if (!topic)         { errors.push({ field: 'Topic', message: 'Please select Year Topic.' }); }
            if (!commentTxtVal) { errors.push({ field: 'CommentText', message: 'Please enter Comment.' }); }
            if (errors.length > 0) {
                displayCommentValidationErrors(errors);
                return;
            }

            clearCommentValidationErrors();

            var token = $('#formTblComments input[name="__RequestVerificationToken"]').val();

            var dto = {
                commentNo:   isAdding ? 0 : commentNo,
                project:     project,
                year:        parseInt(year, 10),
                topic:       topic,
                comment:     commentTxtVal,
                commentText: commentTxtVal
            };

            var url  = isAdding ? '/PIMS/Comment/CreateComment' : '/PIMS/Comment/UpdateComment';

            $.ajax({
                url:         url,
                type:        'POST',
                data:        JSON.stringify(dto),
                contentType: 'application/json; charset=utf-8',
                headers:     { 'RequestVerificationToken': token },
                success: function (data) {
                    if (data.success) {
                        closeCommentModal();
                        showAlertMessage(data.message, AlertType.SUCCESS).then(function () {
                            reloadCommentsGrid();
                        });
                    } else {
                        var serverErrors = Array.isArray(data?.errors) ? data.errors : [];
                        var normalizedErrors = serverErrors.map(function (e) {
                            if (typeof e === 'string') {
                                return { field: 'CommentText', message: e };
                            }
                            return {
                                field: (e?.field || e?.key || e?.propertyName || 'CommentText').toString(),
                                message: (e?.message || e?.errorMessage || '').toString()
                            };
                        }).filter(function (e) { return e.message && e.message.trim(); });

                        if (normalizedErrors.length === 0) {
                            normalizedErrors.push({ field: 'CommentText', message: data?.message || 'Failed to save comment. Please check the form and try again.' });
                        }

                        var duplicateError = normalizedErrors.find(function (e) {
                            return /already exists/i.test((e && e.message) || '');
                        });

                        if (duplicateError) {
                            clearCommentValidationErrors();
                            showCommentSummaryError(duplicateError.message);
                            return;
                        }

                        displayCommentValidationErrors(normalizedErrors);
                    }
                },
                error: function () {
                    displayCommentValidationErrors([{ field: 'CommentText', message: 'An error occurred while saving the comment. Please try again.' }]);
                }
            });
        }

        // ── Modal helpers ─────────────────────────────────────────────────────────
        function closeCommentModal() {
            $('#modaPopupBody').html('');
            $('#modalPopup').removeClass('show');
        }

        $(function () {
            onProjectChanged();

            var forecastSpendInput = document.getElementById('forecastSpend');
            if (forecastSpendInput) {
                forecastSpendInput.addEventListener('blur', saveForecastSpendIfChanged);
                forecastSpendInput.addEventListener('change', saveForecastSpendIfChanged);
                forecastSpendInput.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        saveForecastSpendIfChanged();
                    }
                });
            }
        });
    </script>
}
