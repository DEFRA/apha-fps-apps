@* TRANSFORMENGINE MIGRATION — _ViewYearlyFinancialData.cshtml
   Pattern  : stack-upgrade/msaccess-frm-to-dotnet10-mvc-e2e  Phase 15 — Build, Fix, and Final Validation
   Migrated : 2026-07-09

   CHANGED:
     - New file: read-only view modal partial for YearlyFinancialData
     - Derived from _AddEditYearlyFinancialData.cshtml — all inputs disabled, no Save/Update button
     - No form submission, no anti-forgery token, no oninput handlers
     - Resolves Phase 14/12 completeness gap: GetById() in YearlyFinancialDataController (frontend)
       returns PartialView("_ViewYearlyFinancialData", item) with AllowView=true; without this file
       the View modal throws InvalidOperationException at runtime
     - All DOM element ids preserved from Add/Edit partial so existing JS openViewYFDModal()
       calls targeting the same ids still function
     - costing panel shown as static data (no Fix Costing / Update Costing buttons)

   PRESERVED:
     - All govuk-edit-modal__* class names and modal DOM structure
     - All form element ids matching HTML prototype and _AddEditYearlyFinancialData.cshtml
     - Three-column layout: left (cost fields), centre (adjustment + pact details), right (costing panel)

   DEFERRED / REQUIRES HUMAN REVIEW:
     - TRANSFORMENGINE TODO: Confirm that yfdModalActualPact is display-only in view mode
       (no entity field mapped; safe to leave blank as in Add/Edit partial)
     - TRANSFORMENGINE TODO: Verify pact costing panel numeric display (pactCustomerIncome etc.)
       populated by updateCosting() JS in Index.cshtml if view modal also triggers it *@

@model Apha.FPSApps.Web.Areas.PIMS.Models.YearlyFinancialDataItem

<div id="viewYFDModal" class="govuk-edit-modal" role="dialog" aria-modal="true" aria-labelledby="viewYfdModalTitle">
    <div class="govuk-edit-modal-dialog sup_max-width_900">

        <div class="govuk-edit-modal__header">
            <h2 class="govuk-edit-modal__title" id="viewYfdModalTitle">View Yearly Record</h2>
            <button type="button" onclick="closeViewYFDModal()"
                    class="govuk-edit-modal__close-btn"
                    aria-label="Close">&#x2715;</button>
        </div>

        <div class="govuk-edit-modal__body">

            @* TRANSFORMENGINE: View modal — no form submission; all fields read-only via disabled *@
            <div class="yfd-modal-columns">

                @* ── LEFT column: primary cost fields (all disabled) ────────── *@
                <div class="yfd-modal-col-left">

                    @* Project *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalProject">
                            Project:
                        </label>
                        <input class="govuk-input govuk-!-font-size-16"
                               id="viewYfdModalProject"
                               type="text"
                               value="@Model.Project"
                               disabled
                               aria-readonly="true" />
                    </div>

                    @* Year *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalYear">
                            Year:
                        </label>
                        <input class="govuk-input govuk-!-font-size-16"
                               id="viewYfdModalYear"
                               type="text"
                               value="@Model.Year"
                               disabled
                               aria-readonly="true" />
                    </div>

                    @* PP/Acc — BfBudget *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalPPAcc">
                            PP/Acc:
                        </label>
                        <input class="govuk-input govuk-!-font-size-16"
                               id="viewYfdModalPPAcc"
                               type="text"
                               value="@Model.BfBudget"
                               disabled
                               aria-readonly="true" />
                    </div>

                    @* Customer Income — PyBudget *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalCustomerIncome">
                            Customer Income:
                        </label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input class="govuk-input govuk-!-font-size-16"
                                   id="viewYfdModalCustomerIncome"
                                   type="text"
                                   value="@Model.PyBudget"
                                   disabled
                                   aria-readonly="true" />
                        </div>
                    </div>

                    @* VLA Budget — VlaBudget *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalVLABudget">
                            VLA Budget:
                        </label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input class="govuk-input govuk-!-font-size-16"
                                   id="viewYfdModalVLABudget"
                                   type="text"
                                   value="@Model.VlaBudget"
                                   disabled
                                   aria-readonly="true" />
                        </div>
                    </div>

                    @* Seedcorn — Seedcorn *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalSeedcorn">
                            Seedcorn:
                        </label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input class="govuk-input govuk-!-font-size-16"
                                   id="viewYfdModalSeedcorn"
                                   type="text"
                                   value="@Model.Seedcorn"
                                   disabled
                                   aria-readonly="true" />
                        </div>
                    </div>

                    @* Pay Costs — PayCosts *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalPayCosts">
                            Pay Costs:
                        </label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input class="govuk-input govuk-!-font-size-16"
                                   id="viewYfdModalPayCosts"
                                   type="text"
                                   value="@Model.PayCosts"
                                   disabled
                                   aria-readonly="true" />
                        </div>
                    </div>

                    @* Non-Pay & OH Costs — NonPayOhCosts *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalNonPay">
                            Non-Pay &amp; OH Costs:
                        </label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input class="govuk-input govuk-!-font-size-16"
                                   id="viewYfdModalNonPay"
                                   type="text"
                                   value="@Model.NonPayOhCosts"
                                   disabled
                                   aria-readonly="true" />
                        </div>
                    </div>

                    @* Test Costs — TestCosts *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalTestCosts">
                            Test Costs:
                        </label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input class="govuk-input govuk-!-font-size-16"
                                   id="viewYfdModalTestCosts"
                                   type="text"
                                   value="@Model.TestCosts"
                                   disabled
                                   aria-readonly="true" />
                        </div>
                    </div>

                    @* Animal Costs — AnimalCosts *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalAnimalCosts">
                            Animal Costs:
                        </label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input class="govuk-input govuk-!-font-size-16"
                                   id="viewYfdModalAnimalCosts"
                                   type="text"
                                   value="@Model.AnimalCosts"
                                   disabled
                                   aria-readonly="true" />
                        </div>
                    </div>

                    @* Project-Specific Costs — NonAnimalCosts *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalProjectSpecific">
                            Project-Specific Costs:
                        </label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input class="govuk-input govuk-!-font-size-16"
                                   id="viewYfdModalProjectSpecific"
                                   type="text"
                                   value="@Model.NonAnimalCosts"
                                   disabled
                                   aria-readonly="true" />
                        </div>
                    </div>

                    @* Approximate Man-Time fieldset *@
                    <fieldset class="govuk-fieldset yfd-fieldset-mantime">
                        <legend class="govuk-fieldset__legend govuk-!-font-size-14 govuk-!-font-weight-bold">
                            Approximate Man-Time
                        </legend>

                        @* Appr. Man Hours — ManHours *@
                        <div class="govuk-form-group sup_margin_bottom_10">
                            <label class="govuk-label govuk-!-font-size-16" for="viewYfdModalManHours">
                                Appr. Man Hours:
                            </label>
                            <input class="govuk-input govuk-!-font-size-16 govuk-input--width-10"
                                   id="viewYfdModalManHours"
                                   type="text"
                                   value="@Model.ManHours"
                                   disabled
                                   aria-readonly="true" />
                        </div>

                        @* Appr. Man Days — ManDays *@
                        <div class="govuk-form-group sup_margin_bottom_10">
                            <label class="govuk-label govuk-!-font-size-16" for="viewYfdModalManDays">
                                Appr. Man Days:
                            </label>
                            <input class="govuk-input govuk-!-font-size-16 govuk-input--width-10"
                                   id="viewYfdModalManDays"
                                   type="text"
                                   value="@Model.ManDays"
                                   disabled
                                   aria-readonly="true" />
                        </div>

                        @* Appr. Man Years — ManYears *@
                        <div class="govuk-form-group sup_margin_bottom_10">
                            <label class="govuk-label govuk-!-font-size-16" for="viewYfdModalManYears">
                                Appr. Man Years:
                            </label>
                            <input class="govuk-input govuk-!-font-size-16 govuk-input--width-10"
                                   id="viewYfdModalManYears"
                                   type="text"
                                   value="@Model.ManYears"
                                   disabled
                                   aria-readonly="true" />
                        </div>
                    </fieldset>

                    @* Total Costs — computed read-only display *@
                    <div class="govuk-form-group sup_margin_bottom_10 govuk-!-margin-top-2">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalTotalCosts">
                            Total Costs:
                        </label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input class="govuk-input govuk-!-font-size-16"
                                   id="viewYfdModalTotalCosts"
                                   type="text"
                                   value="@(Model.TotalCosts.HasValue ? Model.TotalCosts.Value.ToString("F2") : "0.00")"
                                   disabled
                                   aria-readonly="true" />
                        </div>
                    </div>

                </div>
                @* end left column *@

                @* ── CENTRE column: Adjustment + Actual Pact Details ──────── *@
                <div class="yfd-modal-col-centre">

                    @* Adjustment (+/-) — Adjustment *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalAdjustment">
                            Adjustment (+/-):
                        </label>
                        <div class="govuk-input__wrapper">
                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input class="govuk-input govuk-!-font-size-16"
                                   id="viewYfdModalAdjustment"
                                   type="text"
                                   value="@Model.Adjustment"
                                   disabled
                                   aria-readonly="true" />
                        </div>
                    </div>

                    @* Adjustment Comment — AdjustmentComment *@
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalAdjComment">
                            Adjustment Comment:
                        </label>
                        <textarea class="govuk-textarea govuk-!-font-size-16 sup_margin_0"
                                  id="viewYfdModalAdjComment"
                                  rows="6"
                                  disabled
                                  aria-readonly="true">@Model.AdjustmentComment</textarea>
                    </div>

                    @* Actual (Pact) Details — display-only note area *@
                    @* TRANSFORMENGINE TODO: yfdModalActualPact has no entity field mapping; displayed blank *@
                    <div class="govuk-form-group sup_margin_bottom_10" id="viewYfdActualPactGroup">
                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                               for="viewYfdModalActualPact">
                            Actual (Pact) Details:
                        </label>
                        <textarea class="govuk-textarea govuk-!-font-size-16 sup_margin_0"
                                  id="viewYfdModalActualPact"
                                  rows="6"
                                  disabled
                                  aria-readonly="true"></textarea>
                    </div>

                </div>
                @* end centre column *@

                @* ── RIGHT column: Costing panel (static display, no buttons) ── *@
                <div class="yfd-modal-col-right">

                    @* TRANSFORMENGINE: View mode — no Update Costing or Fix Costing buttons *@
                    <div id="viewYfdCostingPanel"
                         class="yfd-costing-panel"
                         aria-label="Costing panel">

                        <div class="yfd-costing-panel__header">
                            @* Fixed checkbox — read-only display *@
                            <div class="govuk-checkboxes govuk-checkboxes--small yfd-costing-panel__checkbox"
                                 data-module="govuk-checkboxes">
                                <div class="govuk-checkboxes__item">
                                    @if (Model.Locked != 0)
                                    {
                                        <input class="govuk-checkboxes__input"
                                               id="viewYfdModalFixed"
                                               type="checkbox"
                                               value="fixed"
                                               checked
                                               disabled />
                                    }
                                    else
                                    {
                                        <input class="govuk-checkboxes__input"
                                               id="viewYfdModalFixed"
                                               type="checkbox"
                                               value="fixed"
                                               disabled />
                                    }
                                    <label class="govuk-label govuk-checkboxes__label sup_label_auto_width govuk-!-font-size-16"
                                           for="viewYfdModalFixed">Fixed</label>
                                </div>
                            </div>
                        </div>

                        @* Date Fixed — DateCosted *@
                        <div class="govuk-form-group sup_margin_bottom_10">
                            <label class="govuk-label govuk-!-font-size-16" for="viewYfdModalDateFixed">
                                Date Fixed:
                            </label>
                            <input class="govuk-input govuk-!-font-size-16"
                                   id="viewYfdModalDateFixed"
                                   type="text"
                                   value="@(Model.DateCosted.HasValue ? Model.DateCosted.Value.ToString("dd/MM/yyyy") : string.Empty)"
                                   disabled
                                   aria-readonly="true" />
                        </div>

                        @* Fixed By — CostedBy *@
                        <div class="govuk-form-group sup_margin_bottom_10">
                            <label class="govuk-label govuk-!-font-size-16" for="viewYfdModalFixedBy">
                                Fixed By:
                            </label>
                            <input class="govuk-input govuk-!-font-size-16"
                                   id="viewYfdModalFixedBy"
                                   type="text"
                                   value="@Model.CostedBy"
                                   disabled
                                   aria-readonly="true" />
                        </div>

                        <hr class="yfd-costing-panel__divider" />

                        @* Actual Expenditure / Actual ManYears reported display *@
                        <div class="yfd-costing-reported">
                            <p class="govuk-!-font-weight-bold yfd-costing-reported__label">
                                Actual Expenditure Reported as:
                            </p>
                            <p class="govuk-body govuk-!-font-size-16 yfd-costing-reported__value--spaced"
                               id="viewYfdActualExpReported">
                                @(Model.ActualExpenditure.HasValue
                                    ? "£" + Model.ActualExpenditure.Value.ToString("N2")
                                    : "—")
                            </p>
                            <p class="govuk-!-font-weight-bold yfd-costing-reported__label">
                                Actual ManYears Reported as:
                            </p>
                            <p class="govuk-body govuk-!-font-size-16"
                               id="viewYfdActualManYearsReported">
                                @(Model.ActualManYears.HasValue
                                    ? Model.ActualManYears.Value.ToString("F2")
                                    : "—")
                            </p>
                        </div>

                    </div>
                    @* end costing panel *@

                </div>
                @* end right column *@

            </div>
            @* end yfd-modal-columns *@

        </div>
        @* end modal body *@

        <div class="govuk-edit-modal__footer yfd-modal-footer">
            @* TRANSFORMENGINE: View modal — Close button only; no Save/Update *@
            <button type="button"
                    class="govuk-button govuk-button--secondary sup_margin_0 govuk-!-font-size-16"
                    data-module="govuk-button"
                    onclick="closeViewYFDModal()">Close</button>
        </div>

    </div>
</div>
