@* TRANSFORMENGINE MIGRATION — Index.cshtml (YearlyFinancialData)
   Pattern  : stack-upgrade/msaccess-frm-to-dotnet10-mvc-e2e  Phase 12 — Razor Views (Step 18)
   Migrated : 2026-07-09
   Phase 14 security fix applied : 2026-07-09
   CHANGED:
     - New file: Razor view for frmProjectRadTrackData (Yearly Financial Details)
     - Project dropdown (<select id="yfdProject">) preserved as explicit page-level filter
       (confirmed present outside #gridContainer_costcenterList in HTML prototype toolbar)
     - StartDate / EndDate read-only toolbar inputs mirror yfdStartDate / yfdEndDate
     - DataGrid bound to CostCenterListGrid (id="gridContainer_costcenterList")
     - Totals row mirrors tblYFDTotals static HTML structure with computed column ids
     - Add/Edit/Delete/View modal JS functions wired per AllowAdd/Edit/Delete/View=true
     - ExtraFilterMethod=getYearlyFinancialDataExtraFilters supplies project to grid reload
     - Save (Create) / Update (Edit) calls POST /PIMS/YearlyFinancialData/Create|Edit
     - Delete calls HTTP DELETE /PIMS/YearlyFinancialData/Delete (JS confirm() only)
     - View loads _ViewYearlyFinancialData partial into shared #modaPopupBody
     - updateCosting() JS function calls GET /PIMS/YearlyFinancialData/GetPactCosts
       and populates the PACT actuals panel inside the edit modal
     - Phase 14 security fix: @Html.AntiForgeryToken() added before @section Scripts;
       saveYFD() AJAX now sends headers: { 'RequestVerificationToken': token } to satisfy
       [ValidateAntiForgeryToken] on Create(POST) and Edit(POST) — matches Invoice/Index.cshtml
       and Milestone/Index.cshtml convention
   PRESERVED:
     - All toolbar element ids (yfdProject, yfdStartDate, yfdEndDate)
     - All totals cell ids (totalCustomerIncome, totalVLABudget, totalActualExp, etc.)
     - All modal element ids (yfdModalProject, yfdModalYear, yfdModalPPAcc, etc.)
     - Grid container id: gridContainer_costcenterList
   DEFERRED / REQUIRES HUMAN REVIEW:
     - TRANSFORMENGINE TODO: Confirm the updateCosting() PACT panel population logic
       correctly maps PactCostsItem fields to the panel input ids in _AddEditYearlyFinancialData
     - TRANSFORMENGINE TODO: Confirm totals row JS recalculation (recalcTotals()) triggers
       correctly on grid data load and cell change events via _DataGrid partial *@

@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PIMS.Models.YearlyFinancialDataViewModel

@{
    ViewData["Title"] = "PIMS : Yearly Financial Details";
}

<div class="govuk-grid-row sup_border-bottom" style="padding: 0">
    <h5 class="govuk-heading-s sup_margin_0"
        style="padding: 10px 0 5px 24px; border-bottom: 2px solid #1d70b8">
        Yearly Financial Details
    </h5>
</div>

<main id="main-content" style="padding-top: 0">
    <div class="container-fluid">

        <!-- ── Toolbar: Project selector + date display ──────────────────── -->
        @* TRANSFORMENGINE: toolbar mirrors .yfd-toolbar structure from frmProjectRadTrackData.html *@
        <div class="yfd-toolbar govuk-!-margin-right-5 govuk-!-margin-left-3 govuk-!-padding-2">
            <div class="yfd-toolbar__left" style="display: flex; align-items: flex-end; gap: 16px; flex-wrap: wrap;">

                @* TRANSFORMENGINE: Explicit <select id="yfdProject"> outside grid container →
                   page-level filter dropdown (skill rule: justified by HTML prototype) *@
                <div class="yfd-toolbar__item">
                    <label class="govuk-label tab-font-size" for="yfdProject">Project</label>
                    <select id="yfdProject"
                            class="govuk-select tab-font-size sup_select_option_width_100"
                            asp-items="Model.ProjectList"
                            onchange="onProjectChanged()"
                            aria-label="Select project">
                        <option value="">-- Select Project --</option>
                    </select>
                </div>

                <div class="yfd-toolbar__item">
                    <label class="govuk-label tab-font-size" for="yfdStartDate">Start Date</label>
                    <input class="govuk-input govuk-input--width-10 tab-font-size"
                           id="yfdStartDate"
                           name="yfdStartDate"
                           type="text"
                           value="@Model.StartDate"
                           readonly
                           aria-readonly="true" />
                </div>

                <div class="yfd-toolbar__item">
                    <label class="govuk-label tab-font-size" for="yfdEndDate">(Revised) End Date</label>
                    <input class="govuk-input govuk-input--width-10 tab-font-size"
                           id="yfdEndDate"
                           name="yfdEndDate"
                           type="text"
                           value="@Model.EndDate"
                           readonly
                           aria-readonly="true" />
                </div>

            </div>
        </div>

        <!-- ── DataGrid ───────────────────────────────────────────────────── -->
        @* TRANSFORMENGINE: id="gridContainer_costcenterList" mirrors frmProjectRadTrackData.html *@
        <div class="govuk-grid-row govuk-!-margin-right-5 govuk-!-margin-left-2 govuk-!-margin-right-1 sup_margin_bottom_10">
            <div class="govuk-grid-column-full">
                <div id="gridContainer_costcenterList">
                    @await Html.PartialAsync("_DataGrid", Model.CostCenterListGrid)
                </div>
            </div>
        </div>

        <!-- ── Totals row ─────────────────────────────────────────────────── -->
        @* TRANSFORMENGINE: tblYFDTotals structure mirrors frmProjectRadTrackData.html exactly;
           column widths use same yfd-col-* classes; totals populated by recalcTotals() JS *@
        <div class="govuk-grid-row govuk-!-margin-right-5 govuk-!-margin-left-5 sup_margin_bottom_10">
            <div class="govuk-grid-column-full sup_p_0">
                <div id="yfdTotalsScrollWrapper" class="yfd-scroll-wrapper">
                    <table id="tblYFDTotals"
                           class="govuk-table custom-table yfd-totals-table yfd-grid-table"
                           aria-label="Totals row">
                        <colgroup>
                            <col class="yfd-col-year" />
                            <col class="yfd-col-ppacc" />
                            <col class="yfd-col-income" />
                            <col class="yfd-col-budget" />
                            <col class="yfd-col-actexp" />
                            <col class="yfd-col-seedcorn" />
                            <col class="yfd-col-manhours" />
                            <col class="yfd-col-pay" />
                            <col class="yfd-col-nonpay" />
                            <col class="yfd-col-test" />
                            <col class="yfd-col-projspec" />
                            <col class="yfd-col-animal" />
                            <col class="yfd-col-excadj" />
                            <col class="yfd-col-adjcomment" />
                            <col class="yfd-col-actions" />
                        </colgroup>
                        <tbody class="govuk-table__body">
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell yfd-total-label" colspan="2">Totals</td>
                                <td class="govuk-table__cell" id="totalCustomerIncome"></td>
                                <td class="govuk-table__cell" id="totalVLABudget"></td>
                                <td class="govuk-table__cell" id="totalActualExp"></td>
                                <td class="govuk-table__cell" id="totalSeedcorn"></td>
                                <td class="govuk-table__cell" id="totalManHours"></td>
                                <td class="govuk-table__cell" id="totalPayCosts"></td>
                                <td class="govuk-table__cell" id="totalNonPay"></td>
                                <td class="govuk-table__cell" id="totalTestCosts"></td>
                                <td class="govuk-table__cell" id="totalProjectSpecific"></td>
                                <td class="govuk-table__cell" id="totalAnimal"></td>
                                <td class="govuk-table__cell" colspan="3"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</main>

@* TRANSFORMENGINE (Phase 14 — Security): Anti-forgery token rendered here so that
   saveYFD() and any DELETE AJAX in this view can read it via
   $('input[name="__RequestVerificationToken"]').val().
   Matches the Invoice/Index.cshtml and Milestone/Index.cshtml convention. *@
@Html.AntiForgeryToken()

@section Scripts {
    <script>
        // ── Grid extra filter — supplies current project to LoadYearlyFinancialDataGrid ──
        // TRANSFORMENGINE: ExtraFilterMethod="getYearlyFinancialDataExtraFilters" wired in
        //                  DataGridConfig.ExtraFilterMethod; called automatically by _DataGrid on reload.
        function getYearlyFinancialDataExtraFilters() {
            return {
                project: document.getElementById('yfdProject')?.value || ''
            };
        }

        // ── Grid reload ──────────────────────────────────────────────────────────────────
        // TRANSFORMENGINE: Always use gm.reloadGrid({ page: 1 }) — NOT gm.reload()
        function reloadYearlyFinancialDataGrid() {
            var gm = window['gridManager_costCenterListGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        // ── Project change handler ───────────────────────────────────────────────────────
        function onProjectChanged() {
            var project = document.getElementById('yfdProject')?.value || '';
            if (!project) {
                document.getElementById('yfdStartDate').value = '';
                document.getElementById('yfdEndDate').value = '';
                return;
            }
            // Reload grid with new project
            reloadYearlyFinancialDataGrid();
            // Fetch project dates via partial reload (delegates to controller)
            $.get('/PIMS/YearlyFinancialData/Index', { project: project }, function (html) {
                // Extract date values from returned HTML and update toolbar inputs
                var parser = new DOMParser();
                var doc = parser.parseFromString(html, 'text/html');
                var sd = doc.getElementById('yfdStartDate');
                var ed = doc.getElementById('yfdEndDate');
                if (sd) document.getElementById('yfdStartDate').value = sd.value;
                if (ed) document.getElementById('yfdEndDate').value = ed.value;
            });
        }

        // ── Add ──────────────────────────────────────────────────────────────────────────
        // TRANSFORMENGINE: AllowAdd=true — loads _AddEditYearlyFinancialData partial in create mode
        function addYearlyFinancialData() {
            $.get('/PIMS/YearlyFinancialData/Create', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        // ── Edit ─────────────────────────────────────────────────────────────────────────
        // TRANSFORMENGINE: AllowEdit=true — loads _AddEditYearlyFinancialData partial in edit mode
        //                  $(btn).data('id') carries Year; project from current page selection
        function editYearlyFinancialData(btn) {
            var year = $(btn).data('id');
            var project = document.getElementById('yfdProject')?.value || '';
            $.get('/PIMS/YearlyFinancialData/Edit', { year: year, project: project }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        // ── View (read-only details modal) ───────────────────────────────────────────────
        // TRANSFORMENGINE: AllowView=true — loads _ViewYearlyFinancialData partial (read-only)
        function viewYearlyFinancialData(btn) {
            var year = $(btn).data('id');
            var project = document.getElementById('yfdProject')?.value || '';
            $.get('/PIMS/YearlyFinancialData/GetById', { year: year, project: project }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        // ── Delete ───────────────────────────────────────────────────────────────────────
        // TRANSFORMENGINE: AllowDelete=true — JS confirm() only; no delete modal partial
        function deleteYearlyFinancialData(btn) {
            var year = $(btn).data('id');
            var project = document.getElementById('yfdProject')?.value || '';
            if (!confirm('Are you sure you want to delete this yearly financial record?')) return;
            $.ajax({
                url: '/PIMS/YearlyFinancialData/Delete?year=' + encodeURIComponent(year) +
                     '&project=' + encodeURIComponent(project),
                type: 'DELETE',
                success: function (response) {
                    if (response.success) {
                        alert('Yearly financial record deleted successfully');
                        reloadYearlyFinancialDataGrid();
                    } else {
                        alert('Error: ' + (response.message || 'Delete failed.'));
                    }
                },
                error: function () { alert('An error occurred while deleting.'); }
            });
        }

        // ── Save (from _AddEditYearlyFinancialData.cshtml) ───────────────────────────────
        // TRANSFORMENGINE: saveYFD() called by Save / Update buttons inside the modal partial
        function saveYFD() {
            var isEdit = $('#hdnYfdIsEdit').val() === 'true';
            var year = parseInt($('#hdnYfdYear').val(), 10);
            var project = $('#hdnYfdProject').val() || document.getElementById('yfdProject')?.value || '';

            // Collect all editable modal fields into the request DTO
            var dto = {
                year:                parseInt($('#yfdModalYear').val(), 10) || year,
                project:             project,
                bfBudget:            parseDecimalOrNull($('#yfdModalPPAcc').val()),
                pyBudget:            parseDecimalOrNull($('#yfdModalCustomerIncome').val()),
                vlaBudget:           parseDecimalOrNull($('#yfdModalVLABudget').val()),
                seedcorn:            parseDecimalOrNull($('#yfdModalSeedcorn').val()),
                payCosts:            parseDecimalOrNull($('#yfdModalPayCosts').val()),
                nonPayOhCosts:       parseDecimalOrNull($('#yfdModalNonPay').val()),
                testCosts:           parseDecimalOrNull($('#yfdModalTestCosts').val()),
                animalCosts:         parseDecimalOrNull($('#yfdModalAnimalCosts').val()),
                nonAnimalCosts:      parseDecimalOrNull($('#yfdModalProjectSpecific').val()),
                manHours:            parseFloatOrNull($('#yfdModalManHours').val()),
                manDays:             parseFloatOrNull($('#yfdModalManDays').val()),
                manYears:            parseFloatOrNull($('#yfdModalManYears').val()),
                adjustment:          parseDecimalOrNull($('#yfdModalAdjustment').val()),
                adjustmentComment:   $('#yfdModalAdjComment').val() || null,
                locked:              $('#yfdModalFixed').is(':checked') ? 1 : 0,
                dateCosted:          parseIsoDateOrNull($('#hdnYfdDateCosted').val()),
                costedBy:            $('#yfdModalFixedBy').val() || null,
                actualExpenditure:   parseDecimalOrNull($('#hdnYfdActualExpenditure').val()),
                actualManYears:      parseFloatOrNull($('#hdnYfdActualManYears').val())
            };

            var url = isEdit
                ? '/PIMS/YearlyFinancialData/Edit?year=' + encodeURIComponent(year) +
                  '&project=' + encodeURIComponent(project)
                : '/PIMS/YearlyFinancialData/Create';

            // TRANSFORMENGINE (Phase 14 - Security): Pass anti-forgery token as request header.
            // Controller Create(POST) and Edit(POST) have [ValidateAntiForgeryToken].
            // Token is rendered by Html.AntiForgeryToken() above the Scripts section.
            var antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url:         url,
                type:        'POST',
                data:        JSON.stringify(dto),
                contentType: 'application/json; charset=utf-8',
                headers:     { 'RequestVerificationToken': antiForgeryToken },
                success: function (data) {
                    if (data.success) {
                        closeYFDModal();
                        reloadYearlyFinancialDataGrid();
                    } else {
                        var msg = data.message || (data.errors ? data.errors.join('\n') : 'Save failed.');
                        alert('Save failed: ' + msg);
                    }
                },
                error: function () { alert('An error occurred while saving.'); }
            });
        }

        // ── Update Costing (from _AddEditYearlyFinancialData.cshtml) ────────────────────
        // TRANSFORMENGINE: updateCosting() calls GetPactCosts and populates the PACT actuals panel
        function updateCosting() {
            var year    = parseInt($('#hdnYfdYear').val(), 10);
            var project = $('#hdnYfdProject').val() || document.getElementById('yfdProject')?.value || '';
            if (!year || !project) { alert('Please select a project and year first.'); return; }

            $.get('/PIMS/YearlyFinancialData/GetPactCosts', { project: project, year: year }, function (response) {
                if (!response.success || !response.data) {
                    alert('Failed to load PACT costs.');
                    return;
                }
                var d = response.data;
                // Populate PACT actuals panel inputs (matching html id="pact..." in _AddEditYearlyFinancialData)
                setVal('pactCustomerIncome', formatGbp(d.custIncome));
                setVal('pactVLABudget',      formatGbp(d.budgetCvl));
                setVal('pactPay',            formatGbp(d.pay));
                setVal('pactNonPayOH',       formatGbp(d.nonPayOH));
                setVal('pactTotalTimeCosts', formatGbp(d.timeCost));
                setVal('pactTest',           formatGbp(d.tests));
                setVal('pactAnimal',         formatGbp(d.animals));
                setVal('pactProjectSpecific',formatGbp(d.subContracts));
                setVal('pactTotalCosts',     formatGbp(d.totalCosts));
                setVal('pactManHours',       d.hours != null ? d.hours.toFixed(2) : '—');
                setVal('pactManDays',        d.hours != null ? (d.hours / 8).toFixed(2) : '—');
                setVal('pactManYears',       d.hours != null ? (d.hours / 1650).toFixed(2) : '—');
                // Enable the costing panel
                var panel = document.getElementById('yfdCostingPanel');
                if (panel) { panel.classList.remove('yfd-costing-panel--disabled'); panel.removeAttribute('aria-disabled'); }
            });
        }

        // ── Fix Costing (from _AddEditYearlyFinancialData.cshtml) ───────────────────────
        // TRANSFORMENGINE: fixCosting() sets date/fixedBy fields from current pact data
        function fixCosting() {
            var today = new Date();
            var dd = String(today.getDate()).padStart(2, '0');
            var mm = String(today.getMonth() + 1).padStart(2, '0');
            var yyyy = today.getFullYear();
            var dateStr = dd + '/' + mm + '/' + yyyy;
            $('#yfdModalDateFixed').val(dateStr);
            $('#hdnYfdDateCosted').val(yyyy + '-' + mm + '-' + dd);
            // Mark the Fixed checkbox
            $('#yfdModalFixed').prop('checked', true);
        }

        // ── Modal close helpers ──────────────────────────────────────────────────────────
        function closeYFDModal() {
            $('#modaPopupBody').html('');
            $('#modalPopup').removeClass('show');
        }
        function closeYFDDetailsModal() {
            closeYFDModal();
        }

        // ── Totals row recalculation ─────────────────────────────────────────────────────
        // TRANSFORMENGINE: Called after grid data loads to sum visible columns into the totals row
        function recalcTotals() {
            var sums = {
                totalCustomerIncome: 0, totalVLABudget: 0,  totalActualExp: 0,
                totalSeedcorn: 0,       totalManHours: 0,   totalPayCosts: 0,
                totalNonPay: 0,         totalTestCosts: 0,  totalProjectSpecific: 0,
                totalAnimal: 0
            };
            // Sum data rows from the DataGrid table
            $('#gridContainer_costcenterList table tbody tr[data-row]').each(function () {
                var cells = $(this).find('td');
                // Column order: 0=Year, 1=BfBudget(PP/Acc), 2=PyBudget(CustomerIncome),
                //   3=VlaBudget, 4=ActualExp, 5=Seedcorn, 6=ManHours, 7=PayCosts,
                //   8=NonPayOhCosts, 9=TestCosts, 10=NonAnimalCosts, 11=AnimalCosts,
                //   12=Adjustment, 13=AdjComment, 14=actions
                sums.totalCustomerIncome  += parseGbpCell(cells.eq(2));
                sums.totalVLABudget       += parseGbpCell(cells.eq(3));
                sums.totalActualExp       += parseGbpCell(cells.eq(4));
                sums.totalSeedcorn        += parseGbpCell(cells.eq(5));
                sums.totalManHours        += parseNumCell(cells.eq(6));
                sums.totalPayCosts        += parseGbpCell(cells.eq(7));
                sums.totalNonPay          += parseGbpCell(cells.eq(8));
                sums.totalTestCosts       += parseGbpCell(cells.eq(9));
                sums.totalProjectSpecific += parseGbpCell(cells.eq(10));
                sums.totalAnimal          += parseGbpCell(cells.eq(11));
            });
            for (var id in sums) {
                var el = document.getElementById(id);
                if (el) {
                    if (id === 'totalManHours') {
                        el.textContent = sums[id].toFixed(2);
                    } else {
                        el.textContent = '£' + sums[id].toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                    }
                }
            }
        }

        // ── Utility helpers ──────────────────────────────────────────────────────────────
        function parseDecimalOrNull(val) {
            if (!val || val.trim() === '') return null;
            var n = parseFloat(val.replace(/[£,]/g, ''));
            return isNaN(n) ? null : n;
        }
        function parseFloatOrNull(val) {
            if (!val || val.trim() === '') return null;
            var n = parseFloat(val);
            return isNaN(n) ? null : n;
        }
        function parseIsoDateOrNull(val) {
            if (!val || val.trim() === '') return null;
            return val; // already yyyy-MM-dd from hidden field
        }
        function formatGbp(val) {
            if (val == null) return '—';
            return '£' + parseFloat(val).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }
        function setVal(id, val) {
            var el = document.getElementById(id);
            if (el) el.value = val;
        }
        function parseGbpCell(cell) {
            var txt = (cell.text() || '').replace(/[£,]/g, '');
            return parseFloat(txt) || 0;
        }
        function parseNumCell(cell) {
            return parseFloat(cell.text()) || 0;
        }

        // ── On page load: trigger initial totals once grid renders ───────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            // Recalc totals after grid data loads (listen for the custom grid-loaded event)
            document.addEventListener('gridLoaded', function (e) {
                if (e && e.detail && e.detail.gridId === 'costCenterListGrid') {
                    recalcTotals();
                }
            });
        });
    </script>
}
