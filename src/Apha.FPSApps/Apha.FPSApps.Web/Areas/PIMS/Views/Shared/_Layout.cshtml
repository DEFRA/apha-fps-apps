<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/govuk-frontend-6.0.0.min.css" />
    <link rel="stylesheet" href="~/css/supplement_style_for_gov.uk_style.css" />
    <link rel="stylesheet" href="~/css/pims_styles/styles.css" />
    <link rel="stylesheet" href="~/css/main_style.css" />
    <link rel="stylesheet" href="~/DataGrid/editable-grid.css" />
    <link rel="stylesheet" href="~/css/common/headernav/navstyle.css" />
    <script src="~/lib/jquery/dist/jquery.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ── Top Header ──────────────────────────────────────────────────── -->
    @await Component.InvokeAsync("AppHeader", new { appName = "PIMS" })

    <!-- ── Main Navigation ───────────────────────────────────────────── -->
    <div id="header">
        <nav class="main-nav">

            <!-- Choose Project -->
            <div class="nav-item">
                <a class="nav-button" asp-area="PIMS" asp-controller="ProjectList" asp-action="Index">
                    <div class="align-menu-text"><span>Choose Project</span></div>
                </a>
            </div>

            <!-- Print Reports -->
            <div class="nav-item dropdown">
                <button class="nav-button dropdown-toggle" data-dropdown="pims-print-reports" allow-edit="true">
                    <div class="align-menu-text"><span>Print Reports</span></div>
                    <span class="arrow"><img src="~/images/arrow-down.svg" alt="down arrow" width="12" /></span>
                </button>
                <div class="dropdown-menu" id="pims-print-reports">
                    <a class="dropdown-item" href="#">Project Details Report</a>
                </div>
            </div>

            <!-- Publications -->
            <div class="nav-item dropdown">
                <button class="nav-button dropdown-toggle" data-dropdown="pims-publications" allow-edit="true">
                    <div class="align-menu-text"><span>Publications</span></div>
                    <span class="arrow"><img src="~/images/arrow-down.svg" alt="down arrow" width="12" /></span>
                </button>
                <div class="dropdown-menu" id="pims-publications">
                    <a class="dropdown-item" href="#">Publications List</a>
                </div>
            </div>

            <!-- Maintenance -->
            <div class="nav-item dropdown">
                <button class="nav-button dropdown-toggle" data-dropdown="pims-maintenance" allow-edit="true">
                    <div class="align-menu-text"><span>Maintenance</span></div>
                    <span class="arrow"><img src="~/images/arrow-down.svg" alt="down arrow" width="12" /></span>
                </button>
                <div class="dropdown-menu" id="pims-maintenance">
                    <a class="dropdown-item" href="#">Maintenance List</a>
                </div>
            </div>

            <!-- Pop-up Data Check -->
            <div class="nav-item dropdown">
                <button class="nav-button dropdown-toggle" data-dropdown="pims-popup-data-check" allow-edit="true">
                    <div class="align-menu-text"><span>Pop-up Data Check</span></div>
                    <span class="arrow"><img src="~/images/arrow-down.svg" alt="down arrow" width="12" /></span>
                </button>
                <div class="dropdown-menu" id="pims-popup-data-check">
                    <a class="dropdown-item" href="#">Data Check</a>
                </div>
            </div>

        </nav>
    </div>

    <!-- ── Page Body ─────────────────────────────────────────────────── -->
    <div class="sup_margin_bottom_10 content-wrapper">
        @RenderBody()
    </div>

    <!-- ── Footer ────────────────────────────────────────────────────── -->
    @await Component.InvokeAsync("AppFooter")

    <!-- ── Shared modal popup (for add/edit forms) ───────────────────── -->
    <div id="modalPopup" tabindex="-1" aria-labelledby="modalPopupLabel"
         style="display:none; position:fixed; inset:0; z-index:1050;
                background:rgba(0,0,0,0.5); align-items:center; justify-content:center;">
        <div class="modal-dialog modal-lg" style="margin:auto; width:100%; max-width:700px;">
            <div id="modaPopupBody" class="modal-content" style="border-radius:4px;">
            </div>
        </div>
    </div>

    <!-- ── Scripts ───────────────────────────────────────────────────── -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/js/govuk-modal-dialog.js"></script>

    <script>
        // ── Modal open / close helpers ────────────────────────────────────
        (function () {
            var modal = document.getElementById('modalPopup');
            if (!modal) return;

            var observer = new MutationObserver(function () {
                if (modal.classList.contains('show')) {
                    modal.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                } else {
                    modal.style.display = 'none';
                    document.body.style.overflow = '';
                }
            });
            observer.observe(modal, { attributes: true, attributeFilter: ['class'] });

            modal.addEventListener('click', function (e) {
                if (e.target === modal) {
                    return false;
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modal.classList.contains('show')) {
                    modal.classList.remove('show');
                }
            });
        })();

        // ── jQuery.fn.serializeObject helper ─────────────────────────────
        $.fn.serializeObject = function () {
            var obj = {};
            this.serializeArray().forEach(function (item) {
                obj[item.name] = item.value;
            });
            return obj;
        };
    </script>

    <script src="~/js/pims_js/pimsnavmenu.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>