@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PIMS.Models.PMDMilestoneViewModel

@{
    ViewData["Title"] = "PIMS : PMD Milestone List";
    string parentproject = Model.Parentproject;
}

<div class="govuk-grid-row sup_border-bottom govuk-!-margin-bottom-3 govuk-!-padding-left-1 govuk-!-padding-right-1">
    <div class="govuk-grid-column-full sup_flex_between_center">
        <h1 class="govuk-heading-s sup_margin_0 govuk-!-padding-top-2 govuk-!-padding-bottom-2">
            Milestone List
        </h1>       
    </div>
</div>

<div class="sup_flex sup_align-items-flex-start">
    <main class="main-content govuk-!-padding-top-0 sup_overflow_hidden">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">

                <!-- ── Project Selection ───────────────────────────────────── -->
                <div class="govuk-grid-row sup_margin_left_right_10">
                    <div class="govuk-grid-column-full sup_p_0">
                        <div class="sup_border sup_p_8 sup_margin_bottom_10">
                            <label class="govuk-label govuk-!-font-size-16" for="dpprojectcode">Projects</label>
                            <select asp-for="Parentproject"
                                    asp-items="Model.ProjectOptions"
                                    class="govuk-select govuk-!-font-size-16"
                                    id="dpprojectcode"
                                    onchange="onProjectChanged(this.value)">
                            </select>
                        </div>
                    </div>
                </div>

                <!-- ── Milestones DataGrid ───────────────────────────────── -->
                <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                    <div class="govuk-grid-column-full sup_p_0">
                        <div id="@($"gridContainer_{Model.MilestonesGrid.GridId}")">
                            @await Html.PartialAsync("_DataGrid", Model.MilestonesGrid)
                        </div>
                    </div>
                </div>

                <div id="pmdConfirmationSection"
                     class="govuk-grid-row sup_margin_left_right_10 govuk-!-margin-bottom-3"
                     style="@(Model.ShowConfirmationSection ? string.Empty : "display:none;")">
                    <div class="govuk-grid-column-full sup_p_0">
                        <div class="sup_flex_align_center sup_flex_gap_10">
                            <span id="pmdConfirmationLabel" class="govuk-label govuk-!-font-size-24">@Model.ConfirmationLabelText</span>
                            <button id="pmdConfirmationSubmit" type="button" class="govuk-button govuk-!-margin-bottom-0" onclick="submitPmdConfirmation()">Submit</button>
                        </div>
                    </div>
                </div>

                <!-- ── Information Section ─────────────────────────────────── -->
                <div class="govuk-grid-row sup_margin_left_right_10">
                    <div class="govuk-grid-column-full sup_p_0">
                        <div class="sup_p_8 sup_margin_bottom_10">
                            <p>
                                Milestone updates are required for the following periods: April to June,
                                July to Sept, Oct to Dec, Jan, Feb, Mar in each financial year.<br />
                                Please indicate whether a milestone is on target (even if not yet due) with either
                                "Yes" or
                                "No". A milestone that has passed its due date cannot be classified as "On
                                Target".<br />
                                Comments should be added to the "Milestone Comments" section if a milestone is
                                logged as "Off
                                Target". The comments should state the reason why the milestone is off target and
                                any action
                                taken to remedy the situation.<br />
                                Note: the monthly project report on IntraVet will not update automatically. Changes
                                will show on
                                the report for the next month.
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>
</div>

@Html.AntiForgeryToken()
<script src="~/js/ajax-form-validation.js"></script>

@section Scripts {
    <script>
        // ── Shared state ─────────────────────────────────────────────────────
        var currentProject = '@Html.Raw(parentproject)';

        function onProjectChanged(project) {
            currentProject = project;

            updateConfirmationSection(project);

            // Reload grid with new project data
            var gmMilestone = window['gridManager_pmdMilestonesGrid'];
            if (gmMilestone) { gmMilestone.reloadGrid({ page: 1 }); }
        }

        function updateConfirmationSection(project) {
            $.get('@Url.Action("GetConfirmationState", "PMDMilestone", new { area = "PIMS" })',
                { parentproject: project },
                function (data) {
                    var section = document.getElementById('pmdConfirmationSection');
                    var label = document.getElementById('pmdConfirmationLabel');
                    if (!section || !label) return;

                    if (data && data.showConfirmationSection === true) {
                        label.textContent = data.confirmationLabelText || '';
                        section.style.display = '';
                    } else {
                        label.textContent = '';
                        section.style.display = 'none';
                    }
                });
        }

        function editMilestone(btn) {
            var number = $(btn).data('id');
            var editBaseUrl = '@Url.Action("Edit", "PMDMilestone", new { area = "PIMS" })';
            window.location.href = editBaseUrl
                + '?parentproject=' + encodeURIComponent(currentProject)
                + '&number=' + encodeURIComponent(number);
        }

        function submitPmdConfirmation() {
            // Placeholder for confirmation submit action.
            // Hook API call here when backend endpoint is available.
        }

        function getMilestoneExtraFilters() {
            return { parentproject: currentProject };
        }
    </script>
}
