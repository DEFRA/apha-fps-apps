@model Apha.FPSApps.Web.Areas.PACT.Models.InvoiceImportFailedItem

<div class="modal-header flex-space-center">
    <h3 class="govuk-heading-s sup_margin_0">Edit Failed Invoice Import</h3>
    <button type="button" class="btn-close" onclick="$('#modalPopup').removeClass('show')">×</button>
</div>

<div class="modal-body" style="overflow:hidden; padding:8px 16px 0 16px;">
    <form id="formEditFailedInvoice" class="govuk-grid-column-full">

        <input type="hidden" asp-for="Id" />

        <!-- Validation error summary -->
        <div class="govuk-error-summary" role="alert"
             aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ValidationFailure))
        {
            <div class="govuk-warning-text" style="font-size: 14px; display:none;">
                <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                <div class="govuk-warning-text__text">
                    <strong style="display: block; margin-bottom: 4px;">
                        <span class="govuk-warning-text__assistive">Warning</span>
                        Current Validation Errors:
                    </strong>
                    <div style="font-weight: normal; white-space: pre-wrap; word-wrap: break-word;">@Model.ValidationFailure</div>
                </div>
            </div>
        }

        <div class="govuk-grid-row sup_margin_top_10">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label sup_font_weight_700" asp-for="ProjectParent">
                        Project Parent:<span class="sup_color_red">*</span>
                    </label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           asp-for="ProjectParent" required />
                    <span asp-validation-for="ProjectParent" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label sup_font_weight_700" asp-for="Month">
                        Month:<span class="sup_color_red">*</span>
                    </label>
                    <input type="text" class="govuk-input govuk-!-font-size-16"
                           asp-for="Month" required />
                    <span asp-validation-for="Month" class="govuk-error-message"></span>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label sup_font_weight_700" asp-for="Amount">
                        Amount:<span class="sup_color_red">*</span>
                    </label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="text" class="govuk-input govuk-!-font-size-16 decfmt-input"
                               asp-for="Amount" placeholder="e.g., 1000" required />
                    </div>
                    <span asp-validation-for="Amount" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label sup_font_weight_700" asp-for="CostOfWork">Cost of Work</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="text" class="govuk-input govuk-!-font-size-16 decfmt-input"
                               asp-for="CostOfWork" placeholder="e.g., 5000" />
                    </div>
                    <span asp-validation-for="CostOfWork" class="govuk-error-message"></span>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label sup_font_weight_700" asp-for="Wip">WIP</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="text" class="govuk-input govuk-!-font-size-16 decfmt-input"
                               asp-for="Wip" placeholder="e.g., 2000" />
                    </div>
                    <span asp-validation-for="Wip" class="govuk-error-message"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label sup_font_weight_700" asp-for="ProfitLoss">Profit/Loss</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="text" class="govuk-input govuk-!-font-size-16 decfmt-input"
                               asp-for="ProfitLoss" placeholder="e.g., 500" />
                    </div>
                    <span asp-validation-for="ProfitLoss" class="govuk-error-message"></span>
                </div>
            </div>
        </div>

        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label sup_font_weight_700" asp-for="Detail">Detail</label>
            <textarea class="govuk-textarea govuk-!-font-size-16 sup_margin_0"
                      asp-for="Detail" rows="3"
                      placeholder="Enter invoice details..."></textarea>
        </div>

        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label sup_font_weight_700" asp-for="Type">Type</label>
            <input type="text" class="govuk-input govuk-!-font-size-16"
                   asp-for="Type" />
            <span asp-validation-for="Type" class="govuk-error-message"></span>
        </div>


    </form>
</div>

<div class="modal-footer sup_flex_space_center">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
            onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button type="button" class="govuk-button sup_margin_0" onclick="saveFailedInvoice()" allow-edit="true">
        Update
    </button>
</div>
