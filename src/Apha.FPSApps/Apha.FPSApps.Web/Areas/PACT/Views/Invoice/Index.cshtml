@using Apha.FPSApps.Web.Models.Components.DataGrid
@using Microsoft.AspNetCore.Mvc.Rendering
@model Apha.FPSApps.Web.Areas.PACT.Models.InvoiceViewModel

@{
    ViewData["Title"] = "Invoice Records";
}

<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-l">Invoice Records</h1>
    </div>
</div>

<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_bottom_20">
    <div class="govuk-grid-column-full">
        <div class="govuk-form-group">
            <fieldset class="govuk-fieldset">
                <div style="display: flex; gap: 20px; align-items: flex-end;">
                    <div class="govuk-form-group" style="margin-bottom: 0; flex: 1;">
                        <label class="govuk-label govuk-!-font-weight-bold" for="projectPick">
                            Project
                        </label>
                        <select id="projectPick"
                                class="govuk-select"
                                style="width: 100%;"
                                onchange="onProjectPickChange(this.value)">
                            <option value="">-- All Projects --</option>
                            @foreach (var project in Model.FilterProjects)
                            {
                                @if (project.Value == Model.ParentProject)
                                {
                                    <option value="@project.Value" selected>@project.Text</option>
                                }
                                else
                                {
                                    <option value="@project.Value">@project.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="govuk-form-group" style="margin-bottom: 0; flex: 1;">
                        <label class="govuk-label govuk-!-font-weight-bold" for="monthPick">
                            Month
                        </label>
                        <select id="monthPick" 
                                class="govuk-select"
                                style="width: 200px;"
                                onchange="onMonthPickChange(this.value)">
                            <option value="">All Months</option>
                            @if (Model.Month == 1) { <option value="1" selected>1 - January</option> } else { <option value="1">1 - January</option> }
                            @if (Model.Month == 2) { <option value="2" selected>2 - February</option> } else { <option value="2">2 - February</option> }
                            @if (Model.Month == 3) { <option value="3" selected>3 - March</option> } else { <option value="3">3 - March</option> }
                            @if (Model.Month == 4) { <option value="4" selected>4 - April</option> } else { <option value="4">4 - April</option> }
                            @if (Model.Month == 5) { <option value="5" selected>5 - May</option> } else { <option value="5">5 - May</option> }
                            @if (Model.Month == 6) { <option value="6" selected>6 - June</option> } else { <option value="6">6 - June</option> }
                            @if (Model.Month == 7) { <option value="7" selected>7 - July</option> } else { <option value="7">7 - July</option> }
                            @if (Model.Month == 8) { <option value="8" selected>8 - August</option> } else { <option value="8">8 - August</option> }
                            @if (Model.Month == 9) { <option value="9" selected>9 - September</option> } else { <option value="9">9 - September</option> }
                            @if (Model.Month == 10) { <option value="10" selected>10 - October</option> } else { <option value="10">10 - October</option> }
                            @if (Model.Month == 11) { <option value="11" selected>11 - November</option> } else { <option value="11">11 - November</option> }
                            @if (Model.Month == 12) { <option value="12" selected>12 - December</option> } else { <option value="12">12 - December</option> }
                        </select>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
</div>
<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full">
        <div id="gridContainer_invoicesGrid">
            @await Html.PartialAsync("_DataGrid", Model.InvoicesGrid)
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/pact_js/invoice.js"></script>
    <script>
        // ?? State ??????????????????????????????????????????????????????????
        var currentParentProject = '@(Model.ParentProject ?? "")';
        var currentMonth = '@(Model.Month?.ToString() ?? "")';
        var invoicesGridId = '@Model.InvoicesGrid.GridId';

        // Initialize state
        if (currentParentProject) {
            document.getElementById('projectPick').value = currentParentProject;
        }
        if (currentMonth) {
            document.getElementById('monthPick').value = currentMonth;
        }
    </script>
}