@using Apha.FPSApps.Web.Models.Components.DataGrid
@using Microsoft.AspNetCore.Mvc.Rendering
@model Apha.FPSApps.Web.Areas.PACT.Models.InvoiceViewModel

@{
    ViewData["Title"] = "Invoice Records";
}

<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full sup_border-bottom">
        <h1 class="heading_with_txtbox govuk-heading-s govuk-!-margin-top-2 govuk-!-margin-bottom-2">Invoice Recording</h1>
    </div>
</div>

<div class="govuk-grid-row sup_margin_left_right_0 govuk-!-margin-top-2 ">
    <div class="govuk-grid-column-full">
        <div class="govuk-form-group govuk-!-margin-bottom-3">
            <fieldset class="govuk-fieldset">
                <div style="display: flex; gap: 20px; align-items: flex-end;">
                    <div class="govuk-form-group" style="margin-bottom: 0; flex: 1;">
                        <label class="govuk-label govuk-!-font-weight-bold" for="projectPick">
                            Project
                        </label>
                        <div id="projectMultiDropdown" style="width: 100%;"></div>
                        <input type="hidden" id="projectPick" value="@(Model.ParentProject ?? "")" />
                    </div>
                    <div class="govuk-form-group" style="margin-bottom: 0; flex: 1;">
                        <label class="govuk-label govuk-!-font-weight-bold" for="monthPick">
                            Month
                        </label>
                        <select id="monthPick" 
                                class="govuk-select"
                                style="width: 200px;"
                                onchange="onMonthPickChange(this.value)">
                            <option value="">All Months</option>
                            @foreach (var month in Model.FilterMonths)
                            {
                                @if (month.Value == Model.Month?.ToString())
                                {
                                    <option value="@month.Value" selected>@month.Text</option>
                                }
                                else
                                {
                                    <option value="@month.Value">@month.Text</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </fieldset>
        </div>
    </div>
</div>
<div class="govuk-grid-row sup_margin_left_right_0 ">
    <div class="govuk-grid-column-full">
        <div id="gridContainer_invoicesGrid">
            @await Html.PartialAsync("_DataGrid", Model.InvoicesGrid)
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/common/multicolumn-dropdown.css" />
}

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/common/multicolumn-dropdown.component.js"></script>
    <script src="~/js/pact_js/invoice.js"></script>
    <script>
        // ?? State ??????????????????????????????????????????????????????????
        var currentParentProject = '@(Model.ParentProject ?? "")';
        var currentMonth = '@(Model.Month?.ToString() ?? "")';
        var invoicesGridId = '@Model.InvoicesGrid.GridId';

        // Data source for the multi-column project dropdown
        const projectOptionsListData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.FilterProjects));
        const preselectedProject = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ParentProject ?? string.Empty));

        // Initialize state
        if (currentMonth) {
            document.getElementById('monthPick').value = currentMonth;
        }
    </script>
}