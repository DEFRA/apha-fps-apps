@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PACT.Models.ProjectInvoiceSubContractViewModel

@{
    ViewData["Title"] = "Project Invoices & Sub-Contracts";
}

<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full">
        <h1 class="heading_with_txtbox govuk-heading-s sup_border-bottom">
            <span class="sup_flex_left_center">
                Project Invoices &amp; Sub-Contract Cost for: &nbsp;&nbsp;
                <label class="sup_hidden_label" for="sp-projectcode">&nbsp;project code&nbsp;</label>
                <input type="text" id="sp-projectcode"
                       class="govuk-input govuk-!-font-size-16 govuk-input--width-10"
                       value="@Model.ParentProject"                       
                       onchange="navigateToProjectCode(this.value)" />
            </span>
            <span>
                @if (Model.FromPortfolio)
                {
                    <a class="govuk-back-link"
                       asp-area="PACT"
                       asp-controller="PortfolioMaintenance"
                       asp-action="Index">Back</a>
                }
                else
                {
                    <a class="govuk-back-link"
                       asp-area="PACT"
                       asp-controller="ProjectMaintenance"
                       asp-action="Details"
                       asp-route-id="@Model.ParentProject">Back</a>
                }
            </span>
        </h1>
    </div>
</div>

<div class="govuk-grid-row sup_flex_row sup_margin_left_right_0 sup_margin_bottom_10">

    @await Html.PartialAsync("_PactProjectSideNav", new Apha.FPSApps.Web.Areas.PACT.Models.PactProjectSideNavModel
    {
        ParentProject = Model.ParentProject
    })

    <div class="govuk-grid-column-full">

        <!-- ── INVOICES SECTION ─────────────────────────────────────── -->
        <div class="govuk-grid-row sup_margin_left_right_0">
            <div>
                <div id="gridContainer_invoicesGrid">
                    @await Html.PartialAsync("_DataGrid", Model.InvoicesGrid)
                </div>
            </div>
        </div>

        <div id="amountBoxContainer" class="sup_surface_bg sup_position_relative ytd_total_div sup_border sup_border_t_0" style="min-height: 42px;">
            <label id="lbltotalamount" for="txtTotalAmount"
                   class="govuk-label govuk-!-font-weight-bold">YTD Total Amount:</label>
            <input type="text" id="txtTotalAmount"
                   class="govuk-input govuk-!-font-size-16 sup_margin_tb_5 sup_text_align_right"
                   readonly value="£@Model.TotalInvoiceAmount.ToString("N2")" />
        </div>

        <!-- ── SUB-CONTRACTS SECTION ─────────────────────────────────── -->
        <div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10">
            <div>    
                <div id="gridContainer_subContractsGrid">
                    @await Html.PartialAsync("_DataGrid", Model.SubContractsGrid)
                </div>
            </div>
        </div>

        <div id="testDataAmountBoxContainer" class="sup_surface_bg sup_position_relative ytd_total_div sup_border sup_border_t_0" style="min-height: 42px;">
            <label id="lblTestDataTotalAmount" for="txtTestDataTotalAmount"
                   class="govuk-label govuk-!-font-weight-bold">YTD Total Amount:</label>
            <input type="text" id="txtTestDataTotalAmount"
                   class="govuk-input govuk-!-font-size-16 sup_margin_tb_5 sup_text_align_right"
                   readonly value="£@Model.TotalSubContractAmount.ToString("N2")" />
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        var invoicesGridId = '@Model.InvoicesGrid.GridId';
        var subContractsGridId = '@Model.SubContractsGrid.GridId';
        var parentProject = '@Uri.EscapeDataString(Model.ParentProject ?? string.Empty)';

        function navigateToProjectCode(code) {
            code = (code || '').trim();
            fpsNavigateTo('/PACT/ProjectInvoiceSubContract/Index?parentProject=' + encodeURIComponent(code));
        }

        function getInvoicesGridManager() {
            return window['gridManager_' + invoicesGridId];
        }

        function getSubContractsGridManager() {
            return window['gridManager_' + subContractsGridId];
        }

         function toggleSidebar() {
            document.querySelector('.sidenav').classList.toggle('collapsed');
         }

        // ── Invoice CRUD ─────────────────────────────────────────────────

        function addInvoice() {
            $.ajax({
                url: '/PACT/ProjectInvoiceSubContract/GetInvoice',
                type: 'GET',
                data: { id: 0, parentProject: decodeURIComponent(parentProject) },
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                    // Initialize form validation (unobtrusive + numeric)
                    initializeFormValidation('#invoiceForm');
                },
                error: function () { showAlertMessage('An error occurred while loading the invoice.', AlertType.ERROR); }
            });
        }

        function editInvoice(btn) {
            var id = $(btn).data('id');
            $.ajax({
                url: '/PACT/ProjectInvoiceSubContract/GetInvoice',
                type: 'GET',
                data: { id: id },
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                    // Initialize form validation (unobtrusive + numeric)
                    initializeFormValidation('#invoiceForm');
                },
                error: function () { showAlertMessage('An error occurred while loading the invoice.', AlertType.ERROR); }
            });
        }

        function deleteInvoice(btn) {
            var id = $(btn).data('id');
            showGovukConfirm('Delete this invoice?').then(function (confirmed) {
                if (!confirmed) return;
                $.ajax({
                    url: '/PACT/ProjectInvoiceSubContract/DeleteInvoice',
                    type: 'DELETE',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            getInvoicesGridManager()?.reloadGrid({ page: 1 });
                            refreshInvoiceTotalAmount();
                            showAlertMessage('Invoice deleted successfully.', AlertType.SUCCESS);
                        } else {
                            showAlertMessage('Error: ' + response.message, AlertType.ERROR);
                        }
                    },
                    error: function () { showAlertMessage('An error occurred while deleting.', AlertType.ERROR); }
                });
            });
        }

        function saveInvoice() {
            var form = $('#invoiceForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#invoiceForm');
                return;
            }
            var data = form.serializeObject ? form.serializeObject() : Object.fromEntries(new FormData(form[0]));

            // Convert empty strings to null for nullable numeric fields so that JSON
            // deserialisation succeeds and [Required] data-annotation validation fires
            // with plain property-name ModelState keys (e.g. "Month") instead of the
            // JSON-path keys (e.g. "$.Month") that would be produced by a parse failure.
            ['Month', 'Amount', 'CostOfWork', 'Wip', 'ProfitLoss'].forEach(function (f) {
                if (data[f] === '' || data[f] === undefined) data[f] = null;
            });

            clearValidationErrors('#invoiceForm');
            $.ajax({
                url: '/PACT/ProjectInvoiceSubContract/SaveInvoice',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (response) {
                    if (response.success) {
                        $('#modalPopup').removeClass('show');
                        getInvoicesGridManager()?.reloadGrid({ page: 1 });
                        refreshInvoiceTotalAmount();
                        showAlertMessage(response.message, AlertType.SUCCESS);
                    } else {
                        displayServerValidationErrors(response.errors, response.message, '#invoiceForm');
                    }
                },
        error: function () { showAlertMessage('An error occurred while saving.', AlertType.ERROR); }
            });
        }

        // ── Sub-Contract CRUD ─────────────────────────────────────────────

        function addSubContract() {
            $.ajax({
                url: '/PACT/ProjectInvoiceSubContract/GetSubContract',
                type: 'GET',
                data: { id: 0, parentProject: decodeURIComponent(parentProject) },
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                    // Initialize form validation (unobtrusive + numeric)
                    initializeFormValidation('#subContractForm');
                },
                error: function () { showAlertMessage('An error occurred while loading the sub-contract.', AlertType.ERROR); }
            });
        }

        function editSubContract(btn) {
            var id = $(btn).data('id');
            $.ajax({
                url: '/PACT/ProjectInvoiceSubContract/GetSubContract',
                type: 'GET',
                data: { id: id },
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                    // Initialize form validation (unobtrusive + numeric)
                    initializeFormValidation('#subContractForm');
                },
                error: function () { showAlertMessage('An error occurred while loading the sub-contract.', AlertType.ERROR); }
            });
        }

        function deleteSubContract(btn) {
            var id = $(btn).data('id');
            showGovukConfirm('Delete this sub-contract?').then(function (confirmed) {
                if (!confirmed) return;
                $.ajax({
                    url: '/PACT/ProjectInvoiceSubContract/DeleteSubContract',
                    type: 'DELETE',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            getSubContractsGridManager()?.reloadGrid({ page: 1 });
                            refreshSubContractTotalAmount();
                            showAlertMessage('Sub-contract deleted successfully.', AlertType.SUCCESS);
                        } else {
                            showAlertMessage('Error: ' + response.message, AlertType.ERROR);
                        }
                    },
                    error: function () { showAlertMessage('An error occurred while deleting.', AlertType.ERROR); }
                });
            });
        }

        function saveSubContract() {
            var form = $('#subContractForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#subContractForm');
                return;
            }
            var data = form.serializeObject ? form.serializeObject() : Object.fromEntries(new FormData(form[0]));

            ['Month', 'Amount'].forEach(function (f) {
                if (data[f] === '' || data[f] === undefined) data[f] = null;
            });

            clearValidationErrors('#subContractForm');
            $.ajax({
                url: '/PACT/ProjectInvoiceSubContract/SaveSubContract',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (response) {
                    if (response.success) {
                        $('#modalPopup').removeClass('show');
                        getSubContractsGridManager()?.reloadGrid({ page: 1 });
                        refreshSubContractTotalAmount();
                        showAlertMessage(response.message, AlertType.SUCCESS);
                    } else {
                        displayServerValidationErrors(response.errors, response.message, '#subContractForm');
                    }
                },
        error: function () { showAlertMessage('An error occurred while saving.', AlertType.ERROR); }
            });
        }

        // ── Search ───────────────────────────────────────────────────────

        function filterInvoicesGrid(input) {
            var gm = getInvoicesGridManager();
            if (gm) gm.reloadGrid({ page: 1, search: input.value });
        }

        function filterSubContractsGrid(input) {
            var gm = getSubContractsGridManager();
            if (gm) gm.reloadGrid({ page: 1, search: input.value });
        }

        // ── YTD Totals ───────────────────────────────────────────────────────

        function formatGbp(value) {
            return '\u00a3' + parseFloat(value).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function refreshInvoiceTotalAmount() {
            $.ajax({
                url: '/PACT/ProjectInvoiceSubContract/GetInvoiceTotalAmount',
                type: 'GET',
                data: { parentProject: decodeURIComponent(parentProject) },
                success: function (response) {
                    $('#txtTotalAmount').val(formatGbp(response.total));
                },
                error: function () { showAlertMessage('An error occurred while refreshing the invoice total.', AlertType.ERROR); }
            });
        }

        function refreshSubContractTotalAmount() {
            $.ajax({
                url: '/PACT/ProjectInvoiceSubContract/GetSubContractTotalAmount',
                type: 'GET',
                data: { parentProject: decodeURIComponent(parentProject) },
                success: function (response) {
                    $('#txtTestDataTotalAmount').val(formatGbp(response.total));
                },
                error: function () { showAlertMessage('An error occurred while refreshing the sub-contract total.', AlertType.ERROR); }
            });
        }

        function alignYtdBox(tableId, gridContainerId, amountBoxId, boxId, lblId) {
            var amountTh = document.querySelector('#' + tableId + ' [data-column="Amount"]');
            var gridContainer = document.getElementById(gridContainerId);
            var amountBox = document.getElementById(amountBoxId);
            var box = document.getElementById(boxId);
            var lbl = document.getElementById(lblId);
            if (!amountTh || !gridContainer || !amountBox || !box || !lbl) return;
            var thRect = amountTh.getBoundingClientRect();
            var leftOffset = thRect.left - gridContainer.getBoundingClientRect().left;
            amountBox.style.display = 'flex';
            amountBox.style.alignItems = 'center';
            lbl.style.whiteSpace = 'nowrap';
            lbl.style.marginLeft = Math.max(0, leftOffset - lbl.offsetWidth - 8) + 'px';
            lbl.style.marginRight = '8px';
            box.style.width = thRect.width + 'px';
            box.style.flexShrink = '0';
        }

        function alignAmountBoxes() {
            alignYtdBox('tbl_invoicesGrid',    'gridContainer_invoicesGrid',    'amountBoxContainer',         'txtTotalAmount',         'lbltotalamount');
            alignYtdBox('tbl_subContractsGrid', 'gridContainer_subContractsGrid', 'testDataAmountBoxContainer', 'txtTestDataTotalAmount', 'lblTestDataTotalAmount');
        }

        document.addEventListener('DOMContentLoaded', alignAmountBoxes);
        window.addEventListener('resize', alignAmountBoxes);
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
