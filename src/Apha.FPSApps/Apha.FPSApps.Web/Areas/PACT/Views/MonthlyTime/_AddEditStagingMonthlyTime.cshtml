@model Apha.FPSApps.Web.Areas.PACT.Models.StagingMonthlyTimeItem

@{
    var isEdit = Model.Id != 0;
    var workGroups = ViewBag.WorkGroups as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var staffOptions = ViewBag.StaffOptions as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var timeCodeOptions = ViewBag.TimeCodeOptions as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var projectOptions = ViewBag.ProjectOptions as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var monthOptions = ViewBag.MonthOptions as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="modal-header flex-space-center">
    <h3 class="govuk-heading-s sup_margin_0">@(isEdit ? "Edit Imported Time Record" : "Add Time Record")</h3>
    <button type="button" class="btn-close" onclick="$('#modalPopup').removeClass('show')">×</button>
</div>
<div class="modal-body" style="overflow:hidden; padding:8px 16px 0 16px;">
    <form id="stagingMonthlyTimeForm" class="govuk-grid-column-full">
        <input type="hidden" asp-for="Id" />
        <div class="govuk-error-summary" role="alert" aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
            <div class="govuk-error-summary__body"><ul class="govuk-list govuk-error-summary__list"></ul></div>
        </div>
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label" asp-for="WorkGroup">Work Group</label>
            <select class="govuk-select govuk-!-font-size-16" asp-for="WorkGroup" asp-items="@workGroups" name="WorkGroup" required>
                <option value="">--select--</option>
            </select>
            <span data-valmsg-for="WorkGroup" class="govuk-error-message"></span>
        </div>
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label" asp-for="PactStaffId">Staff Pact ID</label>
            <select class="govuk-select govuk-!-font-size-16" asp-for="PactStaffId" asp-items="@staffOptions" name="PactStaffId" required>
                <option value="">--select--</option>
            </select>
            <span data-valmsg-for="PactStaffId" class="govuk-error-message"></span>
        </div>
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label" asp-for="Name">Name</label>
            <input class="govuk-input govuk-!-font-size-16" asp-for="Name" name="Name" />
        </div>
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label" asp-for="TimeCode">Time Code</label>
            <select class="govuk-select govuk-!-font-size-16" asp-for="TimeCode" asp-items="@timeCodeOptions" name="TimeCode" required>
                <option value="">--select--</option>
            </select>
            <span data-valmsg-for="TimeCode" class="govuk-error-message"></span>
        </div>
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label" asp-for="ParentProject">Parent Project</label>
            <select class="govuk-select govuk-!-font-size-16" asp-for="ParentProject" asp-items="@projectOptions" name="ParentProject" required>
                <option value="">--select--</option>
            </select>
            <span data-valmsg-for="ParentProject" class="govuk-error-message"></span>
        </div>
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label" asp-for="Month">Period</label>
            <select class="govuk-select govuk-!-font-size-16" asp-for="Month" asp-items="@monthOptions" name="Month" required>
                <option value="">--select--</option>
            </select>
            <span data-valmsg-for="Month" class="govuk-error-message"></span>
        </div>
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label" asp-for="Hours">Hours</label>
            <input class="govuk-input govuk-!-font-size-16" asp-for="Hours" type="number" step="0.01" name="Hours" required />
            <span data-valmsg-for="Hours" class="govuk-error-message"></span>
        </div>
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label" asp-for="FailureComments">Comments</label>
            <textarea class="govuk-textarea govuk-!-font-size-16" asp-for="FailureComments" name="FailureComments" rows="3"></textarea>
        </div>
    </form>
</div>
<div class="modal-footer sup_flex_space_center">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0" onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button type="button" class="govuk-button sup_margin_0" onclick="saveStagingMonthlyTime()" allow-edit="true">@(isEdit ? "Update" : "Save")</button>
</div>
