@model Apha.FPSApps.Web.Areas.PACT.Models.PactProjectSideNavModel

<nav class="sidenav flex-column flex-shrink-0" id="shortnav">
    <button type="button" class="toggle-btn" onclick="toggleSidebar()" style="right:-8px; top:30px;" allow-edit="true">
        <img src="~/images/chevron-left-solid-full.svg" width="20" alt="collapse sidebar"
             style="margin:-14px 8px 0 -4px;" />
    </button>
    <ul>
        <li class="sidebar-link-two"
            style="border-radius:0 8px 8px 0; cursor:pointer; background-color:#1d70b8;">
            <a style="color:#fff;"
               asp-area="PACT"
               asp-controller="ProjectInvoiceSubContract"
               asp-action="Index"
               asp-route-parentProject="@Model.ParentProject">
                Invoices &amp; Subcontracted Costs
            </a>
        </li>        
        <li class="sidebar-link-two"
            style="border-radius:0 8px 8px 0; cursor:pointer; background-color:#1d70b8;">
            <a style="color:#fff;"
               asp-area="PACT"
               asp-controller="TestPurchaseRequirement"
               asp-action="Index"
               asp-route-parentProject="@Model.ParentProject">
                Test Purchase Requirements
            </a>
        </li>
    </ul>
</nav>
