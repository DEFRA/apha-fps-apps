@using Apha.FPSApps.Application.Dtos.FPS
@using Apha.FPSApps.Web.Constants
@inject Apha.FPSApps.Web.Handler.IFpsYearContext FyContext
@inject Apha.Common.Utilities.StateManagement.IAppStateService AppStateService
@inject Apha.FPSApps.Web.Handler.IFpsYearContext FyContext
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @{
        var allYears = await AppStateService.GetCacheValueAsync<IEnumerable<YearMasterDto>>(FpsCacheKeys.AllYears);
        var fpsYearCode = allYears?.FirstOrDefault(y => y.FpsYear == FyContext.Year)?.FpsYearCode
                          ?? FyContext.Year.ToString();
        var pageTitle = ViewData["Title"]?.ToString();
        ViewData["Title"] = $"{fpsYearCode} : {pageTitle}";
    }
    <title>@ViewData["Title"]</title>


    <link rel="stylesheet" href="~/css/govuk-frontend-6.0.0.min.css" />
    <link rel="stylesheet" href="~/css/supplement_style_for_gov.uk_style.css" />
    <link rel="stylesheet" href="~/css/pact_styles/styles.css" />
    <link rel="stylesheet" href="~/css/main_style.css" />
    <link rel="stylesheet" href="~/DataGrid/editable-grid.css" />
    <link rel="stylesheet" href="~/css/common/headernav/navstyle.css" />
    <!-- jQuery (required before any scripts) -->
    <script src="~/lib/jquery/dist/jquery.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- ── Top Header ─────────────────────────────────────────────────── -->
    @await Component.InvokeAsync("AppHeader", new { appName = "PACT", showYearSelector = true })

    <!-- ── Main Navigation ───────────────────────────────────────────── -->
    @await Component.InvokeAsync("AppNav", new { appArea = "PACT" })
    <!-- ── Page Body ─────────────────────────────────────────────────── -->
        <div class="sup_margin_bottom_10 content-wrapper">
        @RenderBody()
    </div>    
    <!-- ── Footer ────────────────────────────────────────────────────── -->
    @await Component.InvokeAsync("AppFooter")

    <!-- ── Shared modal popup (for add/edit forms) ───────────────────── -->
    <div id="modalPopup" tabindex="-1" aria-label="Modal dialog"         
         style="display:none; position:fixed; inset:0; z-index:1050;
                background:rgba(0,0,0,0.5); align-items:center; justify-content:center;">
        <div class="modal-dialog modal-lg" style="margin:auto; width:100%; max-width:700px;">
            <div id="modaPopupBody" class="govuk-grid-column-full modal-content" style="border-radius:4px;">
            </div>
        </div>
    </div>

    <!-- ── Scripts ───────────────────────────────────────────────────── -->    
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/js/govuk-modal-dialog.js"></script>
    <fps-year-script></fps-year-script>

    <script>
        // ── Modal open / close helpers ────────────────────────────────────
        (function () {
            var modal = document.getElementById('modalPopup');
            if (!modal) return;

            var observer = new MutationObserver(function () {
                if (modal.classList.contains('show')) {
                    modal.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                } else {
                    modal.style.display = 'none';
                    document.body.style.overflow = '';
                }
            });
            observer.observe(modal, { attributes: true, attributeFilter: ['class'] });

            modal.addEventListener('click', function (e) {
                if (e.target === modal) {
                    return false; 
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modal.classList.contains('show')) {
                    modal.classList.remove('show');
                }
            });

            // Make the shared modal draggable by its content heading (progressive enhancement)
            try {
                var modalContent = modal.querySelector('.modal-content');
                if (modalContent) {
                    var handle = modalContent.querySelector('.govuk-heading-m') || modalContent;
                    handle.style.cursor = 'move';
                    (function makeDraggable(handle, el) {
                        var active = false, startX = 0, startY = 0, origX = 0, origY = 0;

                        function onPointerDown(e) {
                            if (e.pointerType === 'mouse' && e.button !== 0) return;
                            e.preventDefault();
                            active = true;
                            startX = e.clientX;
                            startY = e.clientY;
                            var rect = el.getBoundingClientRect();
                            origX = rect.left;
                            origY = rect.top;
                            el.style.transform = '';
                            el.style.position = 'absolute';
                            el.style.left = origX + 'px';
                            el.style.top = origY + 'px';
                            document.addEventListener('pointermove', onPointerMove, { passive: false });
                            document.addEventListener('pointerup', onPointerUp);
                        }

                        function onPointerMove(e) {
                            if (!active) return;
                            e.preventDefault();
                            var dx = e.clientX - startX;
                            var dy = e.clientY - startY;
                            var newLeft = origX + dx;
                            var newTop = origY + dy;
                            // Allow free movement anywhere on screen (progressive enhancement)
                            el.style.left = newLeft + 'px';
                            el.style.top = newTop + 'px';
                        }

                        function onPointerUp() {
                            active = false;
                            document.removeEventListener('pointermove', onPointerMove);
                            document.removeEventListener('pointerup', onPointerUp);
                        }

                        handle.addEventListener('pointerdown', onPointerDown);
                    })(handle, modalContent);
                }
            } catch (ex) {
                console && console.warn && console.warn('shared modal draggable init failed', ex);
            }
        })();

        // ── jQuery.fn.serializeObject helper ─────────────────────────────
        $.fn.serializeObject = function () {
            var obj = {};
            this.serializeArray().forEach(function (item) {
                obj[item.name] = item.value;
            });
            return obj;
        };
        
    </script>

    <script>
        // Global variable for PACT year status (available to all PACT pages)
        const isFPSYearClosed = @Html.Raw(FyContext.IsReadOnly.ToString().ToLower());
    </script>
    <script src="~/js/common/headernav/navmenu.js"></script>
    <script src="~/js/number-validation.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
