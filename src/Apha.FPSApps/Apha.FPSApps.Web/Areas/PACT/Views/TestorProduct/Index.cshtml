@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.PACT.Models.TestListViewModel

@{
    ViewData["Title"] = "Test/Product Maintenance";
}

<main id="main-content">
    <div class="container-fluid">
        <!-- Breadcrumb section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div style="padding: 5px 5px; border-bottom: 1px solid #b4b4b4" class="row">
                    <div style="display: flex; font-size: 14px; align-items: center; justify-content: space-between;">
                        <div class="col-md-6">
                            <nav aria-label="Breadcrumb">
                                <a class="" href="@Url.Action("Index", "Home", new { area = "PACT" })">Home</a> &gt; PACT &gt; Maintenance &gt; Test/Product List
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Title section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="row" style="display:flex; align-items: center;">
                    <div class="col-sm-12" style="padding:0px;">
                        <div style="border-bottom: 2px solid #1d70b8; height:48px;">
                            <h1 style="padding: 15px 0 5px 17px; font-size:16px; width: 50%; font-weight: 700; float:left; margin: 0;">
                                Test/Product Maintenance
                            </h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid " style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">
                                    <!-- Filter and Grid section -->
                                    <div class="govuk-grid-row">
                                        <div class="govuk-grid-column-full mt-2">
                                            <div id="gridContainer_testGrid">
                                                @await Html.PartialAsync("_DataGrid", Model.TestGrid)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>
</main>

<!-- Add/Edit Modal -->
<div class="modal fade" id="testModal" tabindex="-1" role="dialog" aria-labelledby="testModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="testModalLabel">Add/Edit Test or Product</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("_AddEditTestOrProduct")
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        // Fields to exclude from error summary validation
        const EXCLUDED_SUMMARY_FIELDS = [
            'ShortDescription',
            'ItemDescription',
            'TestManager',
            'Owner',
            'owner',
            'JobStatus',
            'ChargeMethod',
            'UnitPriceVla',
            'PriceAhvg'
        ];

        // Override displayClientValidationErrors to exclude specified fields from summary
        const originalDisplayClientErrors = window.displayClientValidationErrors;
        window.displayClientValidationErrors = function (form, container) {
            var $c = container ? (container instanceof $ ? container : $(container)) : form;
            clearValidationErrors($c);

            var errors = [];
            form.find('[required]').each(function () {
                var $field = $(this);
                if (!$field.val() || $field.val().trim() === '') {
                    var name = $field.attr('name') || '';
                    var label = $('label[for="' + $field.attr('id') + '"]', $c).clone().children().remove().end().text().trim().replace(/:\s*$/, '') || name;
                    errors.push({ field: name, message: label + ' is required' });
                }
            });

            if (!errors.length) return;

            var $summary = $c.find('.govuk-error-summary');
            $summary.find('.govuk-error-summary__title').text('There is a problem');
            var $list = $summary.find('.govuk-error-summary__list').empty();

            var hasSummaryErrors = false;

            errors.forEach(function (error) {
                var $field = $('[name="' + error.field + '"]', $c);

                if ($field.length) {
                    // Always highlight inline
                    $field.closest('.govuk-form-group').addClass('govuk-form-group--error');
                    $field.addClass('govuk-input--error');
                    var $valMsg = $field.siblings('[data-valmsg-for="' + error.field + '"]');
                    if ($valMsg.length) {
                        $valMsg.text(error.message)
                               .show()
                               .removeClass('field-validation-valid')
                               .addClass('field-validation-error');
                    }

                    // Only add to summary if NOT in excluded list
                    if (EXCLUDED_SUMMARY_FIELDS.indexOf(error.field) === -1) {
                        $list.append(
                            '<li><a href="#' + $field.attr('id') + '">' + error.message + '</a></li>'
                        );
                        hasSummaryErrors = true;
                    }
                }
            });

            if (hasSummaryErrors) {
                $summary.show().focus();
            } else {
                $summary.hide();
            }
        };

        // Override displayServerValidationErrors to exclude specified fields from summary
        const originalDisplayServerErrors = window.displayServerValidationErrors;
        window.displayServerValidationErrors = function (errors, summaryMessage, container) {
            var $c = container ? (container instanceof $ ? container : $(container)) : $(document);
            var $summary = $c.find('.govuk-error-summary');
            var $list = $summary.find('.govuk-error-summary__list').empty();
            $summary.find('.govuk-error-summary__title').text(summaryMessage || 'There is a problem');

            // Normalize errors to array format
            var items = [];
            if (!errors) {
                items = [];
            } else if (Array.isArray(errors)) {
                items = errors;
            } else {
                items = Object.keys(errors).map(function (key) {
                    return { field: key, message: errors[key] };
                });
            }

            var hasSummaryErrors = false;

            items.forEach(function (error) {
                var fieldName = error.field || '';
                var message = error.message || 'Validation error';
                var $field = $('[name="' + fieldName + '"]', $c);

                if ($field.length) {
                    // Always highlight inline
                    $field.closest('.govuk-form-group').addClass('govuk-form-group--error');
                    $field.addClass('govuk-input--error');
                    var $valMsg = $field.siblings('[data-valmsg-for="' + fieldName + '"]');
                    if ($valMsg.length) {
                        $valMsg.text(message)
                               .show()
                               .removeClass('field-validation-valid')
                               .addClass('field-validation-error');
                    }

                    // Only add to summary if NOT in excluded list
                    if (EXCLUDED_SUMMARY_FIELDS.indexOf(fieldName) === -1) {
                        $list.append(
                            '<li><a href="#' + $field.attr('id') + '">' + message + '</a></li>'
                        );
                        hasSummaryErrors = true;
                    }
                } else {
                    // Field not found - only add to summary if NOT in excluded list
                    if (EXCLUDED_SUMMARY_FIELDS.indexOf(fieldName) === -1) {
                        $list.append(
                            '<li><a href="#' + fieldName + '">' + message + '</a></li>'
                        );
                        hasSummaryErrors = true;
                    }
                }
            });

            if (hasSummaryErrors) {
                $summary.show().focus();
            } else {
                $summary.hide();
            }
        };

        let owners = [];

        $(document).ready(function () {
            loadOwners();

            // CRITICAL: Disable jQuery Unobtrusive Validation for this form
            // This prevents automatic validation that interferes with our custom logic
            if ($.validator && $.validator.unobtrusive) {
                // Remove unobtrusive validation from the form
                var form = $('#testForm');
                if (form.data('validator')) {
                    form.removeData('validator');
                }
                if (form.data('unobtrusiveValidation')) {
                    form.removeData('unobtrusiveValidation');
                }
            }

            // Initialize form validation
            $('#testForm').on('submit', function (e) {
                e.preventDefault();
                saveTestOrProduct();
            });

            // Handle modal show event - ensure no validation errors appear
            $('#testModal').on('show.bs.modal', function () {
                console.log('Modal show.bs.modal event triggered');
                // Clear any stray validation errors when modal is about to show
                clearValidationErrors('#testModal');
            });

            // Handle modal shown event - final cleanup after modal is visible
            $('#testModal').on('shown.bs.modal', function () {
                console.log('Modal shown.bs.modal event triggered (modal is now visible)');
                // Final validation clear after modal animation completes
                clearValidationErrors('#testModal');

                // AGGRESSIVE: Explicitly hide error summary and remove ALL error classes
                $('#testModal .govuk-error-summary').hide().css('display', 'none');
                $('#testModal .govuk-error-summary__list').empty();
                $('#testModal .govuk-form-group').removeClass('govuk-form-group--error');
                $('#testModal .govuk-input').removeClass('govuk-input--error');
                $('#testModal .govuk-textarea').removeClass('govuk-textarea--error');
                $('#testModal .govuk-error-message').hide().css('display', 'none');
                console.log('Post-shown: Error summary display:', $('#testModal .govuk-error-summary').css('display'));
            });

            // Handle modal close events
            $('#testModal').on('hidden.bs.modal', function () {
                closeTestModal();
            });

            // Handle cancel button click
            $(document).on('click', '.govuk-button--secondary[data-dismiss="modal"]', function () {
                closeTestModal();
            });
        });

        function loadOwners() {
            $.ajax({
                url: '@Url.Action("GetOwners", "TestList", new { area = "PACT" })',
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        owners = response.data;
                        populateOwnerDropdown();
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading owners:', error);
                }
            });
        }

        function populateOwnerDropdown() {
            const ownerSelect = $('#owner');
            ownerSelect.empty();
            ownerSelect.append('<option value="">Select Owner</option>');

            owners.forEach(function (owner) {
                ownerSelect.append($('<option></option>').val(owner).text(owner));
            });
        }

        function addTestOrProduct() {
            $('#testModalLabel').text('Add Test or Product');
            $('#isEdit').val('false');
            $('#originalItemCode').val('');
            $('#testForm')[0].reset();
            $('#itemCode').prop('readonly', false);

            // Ensure required attributes are set for Add mode
            $('#itemCode').prop('required', true);
            $('#owner').prop('required', true);
            $('#defraUnitPrice').prop('required', true);

            populateOwnerDropdown();
            clearValidationErrors('#testModal');
            $('#testModal').modal('show');
        }

        function editTestOrProduct(btn) {
            console.log('=== EDIT FUNCTION STARTED ===');
            const itemCode = $(btn).data('id');
            console.log('ItemCode:', itemCode);

            if (!itemCode) {
                console.error('ItemCode not found on edit button');
                showNotification('Error', 'Item code not found', 'error');
                return;
            }

            console.log('Step 1: Resetting form');
            // Reset form first
            $('#testForm')[0].reset();

            console.log('Step 2: Clearing validation errors (before AJAX)');
            // Clear any existing validation errors
            clearValidationErrors('#testModal');

            console.log('Step 3: Disabling all required attributes');
            // Temporarily disable required validation during data load
            $('#testForm [required]').prop('required', false);
            console.log('Required fields count after disable:', $('#testForm [required]').length);

            console.log('Step 4: Starting AJAX request');
            $.ajax({
                url: '@Url.Action("GetTestOrProduct", "TestList", new { area = "PACT" })',
                type: 'GET',
                data: { itemCode: itemCode },
                success: function (response) {
                    console.log('Step 5: AJAX Success - Response received:', response);

                    if (response.success) {
                        const data = response.data;
                        console.log('Step 6: Data from server:', data);
                        console.log('Step 6a: Checking property casing...');
                        console.log('  - data.ItemCode (PascalCase):', data.ItemCode);
                        console.log('  - data.itemCode (camelCase):', data.itemCode);
                        console.log('  - data.DefraUnitPrice (PascalCase):', data.DefraUnitPrice);
                        console.log('  - data.defraUnitPrice (camelCase):', data.defraUnitPrice);
                        console.log('  - All data keys:', Object.keys(data));

                        // Set modal title and hidden fields
                        $('#testModalLabel').text('Edit Test or Product');
                        $('#isEdit').val('true');
                        $('#originalItemCode').val(itemCode);
                        console.log('Step 7: Modal title and hidden fields set');

                        // Populate form fields - Support both PascalCase and camelCase
                        console.log('Step 8: Populating form fields');
                        const itemCodeValue = data.ItemCode || data.itemCode || '';
                        $('#itemCode').val(itemCodeValue).prop('readonly', true);
                        console.log('  - itemCode field value after set:', $('#itemCode').val(), 'isEmpty:', $('#itemCode').val() === '');

                        // $('#shortDescription').val(data.ShortDescription || data.shortDescription || '');
                        // $('#itemDescription').val(data.ItemDescription || data.itemDescription || '');
                        // $('#testManager').val(data.TestManager || data.testManager || '');
                         $('#owner').val(data.Owner || data.owner || '');
                        // $('#jobStatus').val(data.JobStatus || data.jobStatus || '');
                        // $('#chargeMethod').val(data.ChargeMethod || data.chargeMethod || '');

                        // Handle numeric fields - Support both PascalCase and camelCase
                        console.log('Step 9: Setting numeric fields');
                        const defraPrice = data.DefraUnitPrice !== undefined ? data.DefraUnitPrice : data.defraUnitPrice;
                        console.log('  - DefraUnitPrice value:', defraPrice);
                        if (defraPrice !== null && defraPrice !== undefined) {
                            $('#defraUnitPrice').val(defraPrice);
                            console.log('  - defraUnitPrice field value after set:', $('#defraUnitPrice').val(), 'isEmpty:', $('#defraUnitPrice').val() === '');
                        } else {
                            console.warn('  - DefraUnitPrice is null or undefined! This will cause validation error.');
                        }

                        const unitPriceVla = data.UnitPriceVla !== undefined ? data.UnitPriceVla : data.unitPriceVla;
                        console.log('  - UnitPriceVla value:', unitPriceVla);
                        if (unitPriceVla !== null && unitPriceVla !== undefined) {
                            $('#unitPriceVla').val(unitPriceVla);
                        }

                        const priceAhvg = data.PriceAhvg !== undefined ? data.PriceAhvg : data.priceAhvg;
                        console.log('  - PriceAhvg value:', priceAhvg);
                        if (priceAhvg !== null && priceAhvg !== undefined) {
                            $('#priceAhvg').val(priceAhvg);
                        }

                        console.log('Step 10: Re-enabling required attributes on required fields');
                        // Re-enable required validation on required fields only
                        $('#itemCode').prop('required', true);
                        $('#owner').prop('required', true);
                        $('#defraUnitPrice').prop('required', true);
                        console.log('Required fields count after re-enable:', $('#testForm [required]').length);

                        console.log('Step 11: Clearing validation errors (after populate)');
                        // Clear validation errors again after populating data
                        clearValidationErrors('#testModal');

                        console.log('Step 12: Setting timeout for modal show');
                        // Use setTimeout to ensure DOM is fully updated before showing modal
                        setTimeout(function() {
                            console.log('Step 13: Inside setTimeout - Final validation clear');
                            // Final validation clear
                            clearValidationErrors('#testModal');

                            // Explicitly hide error summary and remove error classes
                            $('#testModal .govuk-error-summary').hide();
                            $('#testModal .govuk-form-group').removeClass('govuk-form-group--error');
                            $('#testModal .govuk-input').removeClass('govuk-input--error');
                            console.log('Step 13a: Error summary explicitly hidden');

                            console.log('Step 14: Showing modal');
                            // Show modal AFTER data is populated and validation is cleared
                            $('#testModal').modal('show');

                            console.log('=== EDIT FUNCTION COMPLETED ===');
                        }, 50);
                    } else {
                        // Re-enable required fields on error
                        $('#itemCode').prop('required', true);
                        $('#owner').prop('required', true);
                        $('#defraUnitPrice').prop('required', true);
                        console.error('Server returned error:', response.message);
                        showNotification('Error', response.message, 'error');
                    }
                },
                error: function (xhr, status, error) {
                    // Re-enable required fields on error
                    $('#itemCode').prop('required', true);
                    $('#owner').prop('required', true);
                    $('#defraUnitPrice').prop('required', true);
                    console.error('AJAX error loading test/product:', { xhr, status, error });
                    showNotification('Error', 'Failed to load test/product details', 'error');
                }
            });
        }

        function closeTestModal() {
            // Reset form
            $('#testForm')[0].reset();

            // Clear validation errors using helper function
            clearValidationErrors('#testModal');

            // Reset hidden fields
            $('#isEdit').val('false');
            $('#originalItemCode').val('');

            // Reset item code readonly state
            $('#itemCode').prop('readonly', false);

            // Hide modal using Bootstrap method
            $('#testModal').modal('hide');

            // Ensure backdrop is removed
            $('.modal-backdrop').remove();

            // Remove modal-open class from body
            $('body').removeClass('modal-open');

            // Reset body padding and overflow
            $('body').css({
                'padding-right': '',
                'overflow': ''
            });
        }

        function saveTestOrProduct() {
            clearValidationErrors('#testModal');

            var form = $('#testForm');

            // Validate required fields using helper function
            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#testModal');
                return;
            }

            const isEdit = $('#isEdit').val() === 'true';
            const itemCode = $('#originalItemCode').val() || $('#itemCode').val();

            const formData = {
                ItemCode: $('#itemCode').val(),
                ShortDescription: $('#shortDescription').val(),
                ItemDescription: $('#itemDescription').val(),
                TestManager: $('#testManager').val(),
                Owner: $('#owner').val(),
                JobStatus: $('#jobStatus').val(),
                ChargeMethod: $('#chargeMethod').val(),
                DefraUnitPrice: parseFloat($('#defraUnitPrice').val()) || 0,
                UnitPriceVla: $('#unitPriceVla').val() ? parseFloat($('#unitPriceVla').val()) : null,
                PriceAhvg: $('#priceAhvg').val() ? parseFloat($('#priceAhvg').val()) : null
            };

            const url = isEdit 
                ? '@Url.Action("UpdateTestOrProduct", "TestList", new { area = "PACT" })' + '?itemCode=' + encodeURIComponent(itemCode)
                : '@Url.Action("CreateTestOrProduct", "TestList", new { area = "PACT" })';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (response) {
                    if (response.success) {
                        closeTestModal();
                        showNotification('Success', response.message, 'success');
                        reloadGrid('testGrid');
                    } else {
                        // Use helper function to display server-side validation errors
                        if (response.errors) {
                            displayServerValidationErrors(response.errors, response.message || 'There is a problem', '#testModal');
                        } else {
                            showNotification('Error', response.message, 'error');
                        }
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        // Use helper function to display server-side validation errors
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message || 'There is a problem', '#testModal');
                    } else {
                        const message = xhr.responseJSON?.message || 'An error occurred while saving';
                        showNotification('Error', message, 'error');
                    }
                }
            });
        }

        function deleteTestOrProduct(btn) {
            const itemCode = $(btn).data('id');

            if (!itemCode) {
                console.error('ItemCode not found on delete button');
                showNotification('Error', 'Item code not found', 'error');
                return;
            }

            if (!confirm(`Are you sure you want to delete test/product ${itemCode}?`)) {
                return;
            }

            $.ajax({
                url: '@Url.Action("DeleteTestOrProduct", "TestList", new { area = "PACT" })',
                type: 'POST',
                data: { itemCode: itemCode },
                success: function (response) {
                    if (response.success) {
                        showNotification('Success', response.message, 'success');
                        reloadGrid('testGrid');
                    } else {
                        showNotification('Error', response.message, 'error');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('AJAX error deleting test/product:', { xhr, status, error });
                    const message = xhr.responseJSON?.message || 'An error occurred while deleting';
                    showNotification('Error', message, 'error');
                }
            });
        }

        function showNotification(title, message, type) {
            // Using a simple alert for now - can be replaced with a toast notification library
            const icon = type === 'success' ? '✓' : '✗';
            alert(`${icon} ${title}: ${message}`);
        }

        function reloadGrid(gridId) {
            var gridManager = window['gridManager_' + gridId];
            if (gridManager && typeof gridManager.reloadGrid === 'function') {
                gridManager.reloadGrid({ page: 1 });
            } else if (typeof bindGrid === 'function') {
                bindGrid(gridId, 1);
            } else {
                location.reload();
            }
        }

        // Explicitly attach to window object to ensure global scope accessibility
        window.addTestOrProduct = addTestOrProduct;
        window.editTestOrProduct = editTestOrProduct;
        window.deleteTestOrProduct = deleteTestOrProduct;
        window.reloadGrid = reloadGrid;
    </script>
}