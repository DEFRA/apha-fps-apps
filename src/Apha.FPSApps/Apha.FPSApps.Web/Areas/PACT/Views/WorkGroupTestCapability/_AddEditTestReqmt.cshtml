@model Apha.FPSApps.Web.Areas.PACT.Models.TestReqmtItem
@using Apha.FPSApps.Application.Dtos.FPS
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var isEdit = !string.IsNullOrEmpty(Model.Buyer);
    var projects = ViewBag.Projects as List<ProjectDto> ?? new List<ProjectDto>();
    var testorProductOptions = ViewBag.TestorProductOptions as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="modal-header flex-space-center">
    <h3 class="govuk-heading-s" style="margin:0;">@(isEdit ? "Edit Test Requirement" : "Add Test Requirement")</h3>
    <button type="button" class="btn-close" onclick="$('#modalPopup').removeClass('show')">×</button>
</div>

<div class="modal-body" style="overflow:hidden; padding:8px 16px 0 16px;">
    <form id="testReqmtForm" class="govuk-grid-column-full">

        <input type="hidden" name="isEdit" value="@isEdit.ToString().ToLower()" />
        @if (isEdit)
        {
            <input type="hidden" name="TestCode" value="@Model.TestCode" />
        }

        <!-- Validation error summary -->
        <div class="govuk-error-summary" role="alert"
             aria-labelledby="tr-error-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="tr-error-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        <!-- Row 1: TestCode | Project -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold" for="TestCode">Test Code:</label>
                    @if (isEdit)
                    {
                        <select class="govuk-select govuk-!-font-size-16" asp-for="TestCode"
                                asp-items="testorProductOptions" style="width:100%;">
                            <option value="">-- Select Test Code --</option>
                        </select>
                    }
                    else
                    {
                        <select class="govuk-select govuk-!-font-size-16" asp-for="TestCode"
                                asp-items="testorProductOptions" style="width:100%;" required
                                onchange="fetchTestReqmtPricing()">
                            <option value="">-- Select Test Code --</option>
                        </select>
                        <span data-valmsg-for="TestCode"
                              class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    }
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold" for="ProjectBuyerCode">Project:</label>
                    <select class="govuk-select govuk-!-font-size-16" id="ProjectBuyerCode" 
                            name="ProjectBuyerCode" style="width:100%;" required
                            onchange="onTestReqmtProjectChange(this, @isEdit.ToString().ToLower())">
                        <option value="">-- Select Project --</option>
                        @foreach (var p in projects)
                        {
                            if (Model.ProjectBuyerCode == p.ParentProject)
                            {
                                <option value="@p.ParentProject" data-isdefra="@p.IsDefraProject" selected>@p.ParentProject</option>
                            }
                            else
                            {
                                <option value="@p.ParentProject" data-isdefra="@p.IsDefraProject">@p.ParentProject</option>
                            }
                        }
                    </select>
                    <span data-valmsg-for="ProjectBuyerCode"
                          class="govuk-error-message field-validation-valid" style="display:none;"></span>
                </div>
            </div>
        </div>

        <!-- Row 2: Buyer (auto-filled from Project on add) | Unit Price -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold">Buyer:</label>
                    <input type="hidden" name="Buyer" id="BuyerHidden" value="@Model.Buyer" />
                    <input class="govuk-input govuk-!-font-size-16" id="BuyerDisplay"
                           value="@Model.Buyer" readonly />
                    @if (!isEdit)
                    {
                        <span data-valmsg-for="Buyer"
                              class="govuk-error-message field-validation-valid" style="display:none;"></span>
                    }
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold" for="UnitPrice">Unit Price:</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input govuk-!-font-size-16" id="UnitPrice" name="UnitPrice"
                               type="number" step="0.01" min="0" value="@(Model.UnitPrice.HasValue ? Model.UnitPrice.Value.ToString("F2") : "")" />
                    </div>
                    <span data-valmsg-for="UnitPrice"
                          class="govuk-error-message field-validation-valid" style="display:none;"></span>
                </div>
            </div>
        </div>

        <!-- Row 3: No | Active -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold" for="NoRequired">No:</label>
                    <input class="govuk-input govuk-!-font-size-16" id="NoRequired" name="NoRequired"
                           type="number" step="0.01" min="0" value="@Model.NoRequired" />
                    <span data-valmsg-for="NoRequired"
                          class="govuk-error-message field-validation-valid" style="display:none;"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold">Rec Unit Price:</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">$</div>
                        <input class="govuk-input govuk-!-font-size-16" id="recUnitPrice"
                               value="@(Model.RecUnitPrice.HasValue ? Model.RecUnitPrice.Value.ToString("F2") : "")" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 4: Defra Project? (read-only, derived from selected project) | Rec Unit Price -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold">Active:</label>
                    <select class="govuk-select govuk-!-font-size-16" asp-for="Active"
                            style="width:100%;">
                        <option value="">-- Select Active --</option>
                        <option value="1">Yes</option>
                        <option value="0">No</option>
                    </select>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold">Defra Project?</label>
                    <select class="govuk-select govuk-!-font-size-16" id="isDefraSelect"
                            asp-for="IsDefraProject" style="width:100%;" disabled>
                        <option value="">-- N/A --</option>
                        <option value="-1">Yes</option>
                        <option value="0">No</option>
                    </select>
                </div>
            </div>            
        </div>

    </form>
</div>

<div class="modal-footer" style="display:flex; justify-content:space-between; align-items:center;">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
            onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button type="button" class="govuk-button sup_margin_0" onclick="saveTestReqmt()">
        @(isEdit ? "Update" : "Save")
    </button>
</div>

<script>
    function fetchTestReqmtPricing() {
        var testCode = $('#TestCode').val();
        var projectCode = $('#ProjectBuyerCode').val();

        if (!testCode) {
            $('#recUnitPrice').val('');
            $('#isDefraSelect').val('');
            return;
        }

        var params = { testCode: testCode };
        if (projectCode) params.projectCode = projectCode;

        $.get('/PACT/WorkGroupTestCapability/GetTestReqmtPricing', params,
            function (data) {
                if (data.success) {
                    var price = data.recUnitPrice !== null && data.recUnitPrice !== undefined ? parseFloat(data.recUnitPrice).toFixed(2) : '';
                    $('#recUnitPrice').val(price);
                    $('#UnitPrice').val(price);
                    // Only update isDefraSelect when a project was part of the lookup
                    if (projectCode) {
                        $('#isDefraSelect').val(data.isDefraProject !== null && data.isDefraProject !== undefined ? data.isDefraProject.toString() : '');
                    }
                } else {
                    $('#recUnitPrice').val('');
                    $('#UnitPrice').val('');
                    if (projectCode) $('#isDefraSelect').val('');
                }
            });
    }

    function onTestReqmtProjectChange(select, isEdit) {
        var val = select.value;

        if (!isEdit) {
            $('#BuyerHidden').val(val);
            $('#BuyerDisplay').val(val);
        }

        fetchTestReqmtPricing();
    }
</script>
