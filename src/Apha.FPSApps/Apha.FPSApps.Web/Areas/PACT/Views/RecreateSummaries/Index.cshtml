@model Apha.FPSApps.Web.Areas.PACT.Models.RecreateSummariesViewModel

@{
    ViewData["Title"] = "Recreate Summaries";
    var btnDisabled = Model.CanRunJob ? (string?)null : "disabled";
}

<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10">
    <div class="govuk-grid-column-full sup_flex_center_start sup_border-bottom sup_margin_bottom_10">
        <h1 class="govuk-heading-m sup_margin_bottom_10">Recreate Summaries</h1>
    </div>
</div>

<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10">
    <div class="govuk-grid-column-three-quarters govuk-!-padding-2">
        <table class="govuk-table govuk-!-margin-bottom-0 isCustomPivotGrid">
            <tbody class="govuk-table__body">
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell sup_border_0">
                        <div class="period-dropdown" id="select-period-dropdown">
                            <label class="govuk-label govuk-!-margin-bottom-1 isFontBold" for="select-period-input">
                                Select Summary Period:
                            </label>
                            <input type="text" id="select-period-input" value="--select--"
                                   class="dropdown-input down-arrow-img govuk-input govuk-!-font-size-16"
                                   readonly />
                            <input type="hidden" id="select-period-value" value="" />

                            <div class="dropdown-panel" id="select-period-panel" style="display:none;">
                                <label class="govuk-visually-hidden" for="select-period-search">
                                    Select Summary Period
                                </label>
                                <input type="text" class="search-box" id="select-period-search"
                                       placeholder="Type to search and select period" />
                                <table class="period-dropdown__table">
                                    <thead>
                                        <tr>
                                            <th>Period</th>
                                            <th>Month Name</th>
                                        </tr>
                                    </thead>
                                    <tbody id="select-period-body">
                                        @* Populated by inline script below *@
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </td>
                    <td class="govuk-table__cell sup_border_0 govuk-!-padding-left-3 recreate-summaries__action-cell">
                        <div class="govuk-button-group govuk-!-margin-bottom-0 govuk-!-margin-top-4">
                            <button type="button"
                                    id="btnCreateSummary"
                                    class="govuk-button govuk-!-margin-bottom-0"
                                    data-module="govuk-button"
                                    data-prevent-double-click="true"
                                    disabled="@btnDisabled"
                                    onclick="triggerCreateSummary()">
                                Create Summary
                            </button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div id="triggerNotification" class="govuk-!-margin-top-4" style="display:none;"></div>

<div class="govuk-grid-row sup_margin_left_right_0 govuk-!-margin-top-4" id="summary-history-section">
    <div class="govuk-grid-column-full govuk-!-padding-2">
        <div id="gridContainer_summaryHistoryGrid">
            @await Html.PartialAsync("_DataGrid", Model.HistoryGrid)
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Period dropdown data ──────────────────────────────────────────────
    const periodData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Months.Select(m => new {
            value    = m.Value,
            period   = m.Value,
            monthName = m.Text.Contains(" - ") ? m.Text.Split(" - ", 2)[1] : m.Text
        })
    ));

    // ── Populate tbody ────────────────────────────────────────────────────
    (function populatePeriodRows(rows) {
        const tbody = document.getElementById('select-period-body');
        rows.forEach(function (item) {
            const tr = document.createElement('tr');
            tr.dataset.value    = item.value;
            tr.dataset.display  = item.period + ' - ' + item.monthName;
            tr.innerHTML = '<td>' + item.period + '</td><td>' + item.monthName + '</td>';
            tr.addEventListener('click', function () {
                document.getElementById('select-period-input').value = this.dataset.display;
                document.getElementById('select-period-value').value = this.dataset.value;
                document.getElementById('select-period-panel').style.display = 'none';
            });
            tbody.appendChild(tr);
        });
    })(periodData);

    // ── Toggle panel on input click ───────────────────────────────────────
    document.getElementById('select-period-input').addEventListener('click', function () {
        const panel = document.getElementById('select-period-panel');
        panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
    });

    // ── Live search ───────────────────────────────────────────────────────
    document.getElementById('select-period-search').addEventListener('input', function () {
        const term = this.value.toLowerCase();
        document.querySelectorAll('#select-period-body tr').forEach(function (tr) {
            tr.style.display = tr.textContent.toLowerCase().includes(term) ? '' : 'none';
        });
    });

    // ── Close panel when clicking outside ────────────────────────────────
    document.addEventListener('click', function (e) {
        const container = document.getElementById('select-period-dropdown');
        if (container && !container.contains(e.target)) {
            document.getElementById('select-period-panel').style.display = 'none';
        }
    });

    // ── Trigger job ───────────────────────────────────────────────────────
    function triggerCreateSummary() {
        const monthVal = parseInt(document.getElementById('select-period-value').value, 10);
        if (!monthVal) {
            showNotification('Please select a summary period.', 'error');
            return;
        }

        const btn = document.getElementById('btnCreateSummary');
        btn.disabled = true;
        btn.setAttribute('aria-disabled', 'true');

        fetch('/PACT/RecreateSummaries/TriggerJob', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ month: monthVal, __RequestVerificationToken: getAntiForgeryToken() })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showNotification('Job triggered successfully. The history grid will refresh shortly.', 'success');
                refreshHistoryGrid();
            } else {
                showNotification(data.message ?? 'Failed to trigger the job.', 'error');
                btn.disabled = false;
                btn.removeAttribute('aria-disabled');
            }
        })
        .catch(() => {
            showNotification('An unexpected error occurred.', 'error');
            btn.disabled = false;
            btn.removeAttribute('aria-disabled');
        });
    }

    // ── Refresh history grid ──────────────────────────────────────────────
    function refreshHistoryGrid() {
        const container = document.getElementById('gridContainer_summaryHistoryGrid');
        if (!container) return;
        fetch('/PACT/RecreateSummaries/LoadHistoryGrid', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ Filter: '{}', Page: 1, PageSize: 10, __RequestVerificationToken: getAntiForgeryToken() })
        })
        .then(r => r.text())
        .then(html => { container.innerHTML = html; });
    }

    // ── Notification banner ───────────────────────────────────────────────
    function showNotification(message, type) {
        const el = document.getElementById('triggerNotification');
        const successClass = type === 'success' ? 'govuk-notification-banner--success' : '';
        el.innerHTML = `<div class="govuk-notification-banner ${successClass}" role="region" aria-label="Notice">
            <div class="govuk-notification-banner__content">
                <p class="govuk-body">${message}</p>
            </div>
        </div>`;
        el.style.display = 'block';
    }

    function getAntiForgeryToken() {
        const el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }
</script>
}
