@model Apha.FPSApps.Web.Areas.PACT.Models.RecreateSummariesViewModel

@{
    ViewData["Title"] = "Recreate Summaries";
    var btnDisabled = Model.CanRunJob ? (string?)null : "disabled";
}

<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10">
    <div class="govuk-grid-column-full sup_flex_center_start sup_border-bottom sup_margin_bottom_10">
        <h1 class="govuk-heading-m sup_margin_bottom_10">Recreate Summaries</h1>
    </div>
</div>

<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10">
    <div class="govuk-grid-column-three-quarters govuk-!-padding-2">
        <table class="govuk-table govuk-!-margin-bottom-0 isCustomPivotGrid">
            <tbody class="govuk-table__body">
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell sup_border_0">
                        <label class="govuk-label govuk-!-margin-bottom-1 isFontBold">
                            Select Summary Period:
                        </label>
                        <div id="select-period-container" style="min-width:280px;"></div>
                    </td>
                    <td class="govuk-table__cell sup_border_0 govuk-!-padding-left-3 recreate-summaries__action-cell">
                        <div class="govuk-button-group govuk-!-margin-bottom-0 govuk-!-margin-top-4">
                            <button type="button"
                                    id="btnCreateSummary"
                                    class="govuk-button govuk-!-margin-bottom-0"
                                    data-module="govuk-button"
                                    data-prevent-double-click="true"
                                    disabled="@btnDisabled"
                                    onclick="triggerCreateSummary()">
                                Create Summary
                            </button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div id="triggerNotification" class="govuk-!-margin-top-4" style="display:none;"></div>

<div class="govuk-grid-row sup_margin_left_right_0 govuk-!-margin-top-4" id="summary-history-section">
    <div class="govuk-grid-column-full govuk-!-padding-2">
        <div id="gridContainer_summaryHistoryGrid">
            @await Html.PartialAsync("_DataGrid", Model.HistoryGrid)
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/common/multicolumn-dropdown.css" />
}
@section Scripts {
<script>
    // ── Period dropdown data ──────────────────────────────────────────────
    const periodData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Months.Select(m => new {
            value    = m.Value,
            period   = m.Value,
            monthName = m.Text.Contains(" - ") ? m.Text.Split(" - ", 2)[1] : m.Text
        })
    ));
</script>
<script src="~/js/common/multicolumn-dropdown.component.js"></script>
<script>
    var selectPeriodDropdown = null;

    document.addEventListener('DOMContentLoaded', function () {
        selectPeriodDropdown = new MultiColumnDropdownComponent({
            dropdownId: 'selectPeriodDropdown',
            containerSelector: '#select-period-container',
            placeholder: '--select--',
            searchPlaceholder: 'Type to search and select period',
            showSerialNumber: false,
            columns: [
                { field: 'period',    header: 'Period',     width: '80px'  },
                { field: 'monthName', header: 'Month Name', width: '160px' }
            ],
            data: periodData,
            displayField: 'period',
            valueField: 'value',
            clearButtonClearsSelection: true,
            callbacks: {
                onSelect: function (selectedItem) {
                    // display as "period - monthName" in the input
                    var input = document.getElementById('selectPeriodDropdown_input');
                    if (input) input.value = selectedItem.period + ' - ' + selectedItem.monthName;
                },
                onClear: function () { }
            }
        });
    });

    // ── Trigger job ───────────────────────────────────────────────────────
    function triggerCreateSummary() {
        const hiddenInput = document.getElementById('selectPeriodDropdown_value');
        const monthVal = hiddenInput ? parseInt(hiddenInput.value, 10) : NaN;
        if (!monthVal) {
            showNotification('Please select a summary period.', 'error');
            return;
        }

        const btn = document.getElementById('btnCreateSummary');
        btn.disabled = true;
        btn.setAttribute('aria-disabled', 'true');

        fetch('/PACT/RecreateSummaries/TriggerJob', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ month: monthVal, __RequestVerificationToken: getAntiForgeryToken() })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showNotification('Job triggered successfully.', 'success');
                refreshHistoryGrid();
            } else {
                showNotification(data.message ?? 'Failed to trigger the job.', 'error');
                btn.disabled = false;
                btn.removeAttribute('aria-disabled');
            }
        })
        .catch(() => {
            showNotification('An unexpected error occurred.', 'error');
            btn.disabled = false;
            btn.removeAttribute('aria-disabled');
        });
    }

    // ── Refresh history grid ──────────────────────────────────────────────
    function refreshHistoryGrid() {
        const container = document.getElementById('gridContainer_summaryHistoryGrid');
        if (!container) return;
        fetch('/PACT/RecreateSummaries/LoadHistoryGrid', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ Filter: '{}', Page: 1, PageSize: 10, __RequestVerificationToken: getAntiForgeryToken() })
        })
        .then(r => r.text())
        .then(html => { container.innerHTML = html; });
    }

    // ── Notification banner ───────────────────────────────────────────────
    function showNotification(message, type) {
        const el = document.getElementById('triggerNotification');
        const successClass = type === 'success' ? 'govuk-notification-banner--success' : '';
        el.innerHTML = `<div class="govuk-notification-banner ${successClass}" role="region" aria-label="Notice">
            <div class="govuk-notification-banner__content">
                <p class="govuk-body">${message}</p>
            </div>
        </div>`;
        el.style.display = 'block';
    }

    function getAntiForgeryToken() {
        const el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }
</script>
}
