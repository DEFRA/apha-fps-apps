@using Apha.FPSApps.Web.Models.Components.DataGrid
@using Microsoft.AspNetCore.Mvc.Rendering
@model Apha.FPSApps.Web.Areas.PACT.Models.ProjectProfileViewModel

@{
    ViewData["Title"] = "Project Profile";
}


<div class="content-wrapper">
    <div class="govuk-grid-row sup_margin_left_right_0">
        <div class="govuk-grid-column-full">
            <h1 class="heading_with_txtbox govuk-heading-s sup_border-bottom sup_margin_bottom_10">
                Profile the Project Budget by Month:
                <a id="backlink" href="#" onclick="goBack(); return false;" class="govuk-back-link">Back</a>
            </h1>
        </div>
    </div>
    <div style="display: flex; flex-direction: row;">
        <div style="display: flex; flex-direction: column;width:100%" class="govuk-grid-row sup_margin_0">
            <!-- Left Column - Project Information -->
            <div class="govuk-grid-column-full">
                <div class="sup_border govuk-grid-column-full sup_border">
                    <!-- Project Information -->
                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-full">
                            <div class="govuk-form-group sup_margin_bottom_10 sup_p_t_b_5">
                                <label asp-for="@Model.ParentProject"
                                       class="govuk-label govuk-!-font-weight-bold">ParentProject:</label>
                                <select asp-for="@Model.ParentProject"
                                        class="govuk-select sup_select_option_width_100 govuk-!-font-size-16">
                                    <option value="">-- Select Parent Project --</option>
                                    @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Projects)
                                    {
                                        if (item.Selected)
                                        {
                                            <option value="@item.Value" selected>@item.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="govuk-form-group sup_margin_bottom_10">
                                <label asp-for="@Model.ProjectTitle"
                                       class="govuk-label govuk-!-font-weight-bold">
                                    ProjectTitle:
                                </label>
                                <input asp-for="@Model.ProjectTitle"
                                       type="text"
                                       class="govuk-input govuk-!-font-size-16" readonly>
                            </div>

                            <div class="govuk-form-group sup_margin_bottom_10">
                                <label asp-for="@Model.BudgetCvl"
                                       class="govuk-label govuk-!-font-weight-bold">
                                    Budget_cy1:
                                </label>
                                <input type="text"
                                       asp-for="@Model.BudgetCvl"
                                       class="govuk-input govuk-!-font-size-16"
                                       readonly>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Graphs Section -->
            <div class="govuk-grid-column-full govuk-grid-row sup_margin_left_right_0 sup_p_0 sup_margin_top_10">
                <div class="govuk-grid-column-full">
                    <div class="sup_flex_space_between" style="align-items:flex-end; margin-bottom:0;">
                        <div class="govuk-tabs pact-graph-tabs" data-module="govuk-tabs" style="flex:1; margin:0;">
                            <ul class="govuk-tabs__list">
                                <li class="govuk-tabs__list-item govuk-tabs__list-item--selected">
                                    <a class="govuk-tabs__tab" href="#nonCumulativeTab">
                                        Profile by Month (NOT Cumulative)
                                    </a>
                                </li>
                                <li class="govuk-tabs__list-item">
                                    <a class="govuk-tabs__tab" href="#cumulativeTab">
                                        Cumulative Graph
                                    </a>
                                </li>
                            </ul>

                            <!-- Tab Panel 1 - Non-Cumulative -->
                            <div class="govuk-tabs__panel" id="nonCumulativeTab">
                                <div class="chart-container">
                                    <canvas id="nonCumulativeChart"></canvas>
                                </div>
                            </div>

                            <!-- Tab Panel 2 - Cumulative -->
                            <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="cumulativeTab">
                                <div class="chart-container">
                                    <canvas id="cumulativeChart"></canvas>
                                </div>
                            </div>
                        </div>
                        <div style="margin-left:8px; align-self:flex-start;">
                            <button type="button" class="govuk-button sup_margin_0 sup_flex_p_4" onclick="refreshGraph()">
                                <img src="../images/refresh_icon.svg" width="24" height="24">&nbsp;Refresh Graph
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Right Column - Cost Profile Table -->
        <div class="govuk-grid-column-one-third sup_p_0" style="padding-left: 10px !important;">
            <div class="sup_border">
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 5px; border-bottom: 1px solid #b1b4b6;">
                    <h2 class="govuk-heading-s" style="margin: 0;">Cost Profile</h2>
                </div>
                <div id="gridContainer_costProfileGrid">
                </div>
            </div>
            <div class="sup_margin_10 sup_text_center">
                <div class="sup_flex_center_center_center">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="text" id="TotalCostProfile"
                           class="govuk-input govuk-!-font-size-16 govuk-input--width-5 sup_text_align_right"
                           readonly>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Add/Edit Cost Profile Modal -->
<div class="modal" id="costProfileModal" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content" id="costProfileModalContent">
        </div>
    </div>
</div>

<link href="~/css/pact_styles/suppliement_style_over_gov.uk_style.css" rel="stylesheet" />
<!-- Load JavaScript -->
<script src="~/js/pact_js/govuk-frontend-6.0.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/pact_js/project_budget_profile.js"></script>
