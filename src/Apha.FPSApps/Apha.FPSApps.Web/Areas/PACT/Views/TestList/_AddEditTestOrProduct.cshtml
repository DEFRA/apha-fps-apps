
<div class="modal-body">
    <div class="govuk-error-summary" role="alert"
         aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
            </ul>
        </div>
    </div>

    <form id="testForm" novalidate>
        <input type="hidden" id="isEdit" value="false" />
        <input type="hidden" id="originalItemCode" value="" />

        <div class="row">
            <div class="col-md-6">
                <div class="govuk-form-group">
                    <label for="itemCode" class="govuk-label">Item Code <span class="sup_color_red">*</span></label>
                    <input type="text" class="form-control govuk-input" id="itemCode" name="ItemCode" required maxlength="20" />
                    <span class="govuk-error-message validation-message" data-valmsg-for="ItemCode" style="display:none;"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="govuk-form-group">
                    <label for="shortDescription" class="govuk-label">Short Description</label>
                    <input type="text" class="form-control govuk-input" id="shortDescription" name="ShortDescription" maxlength="18" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="govuk-form-group">
                    <label for="itemDescription" class="govuk-label">Item Description</label>
                    <textarea class="form-control govuk-textarea" id="itemDescription" name="ItemDescription" rows="3" maxlength="200"></textarea>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="govuk-form-group">
                    <label for="testManager" class="govuk-label">Test Manager</label>
                    <input type="text" class="form-control govuk-input" id="testManager" name="TestManager" maxlength="50" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="govuk-form-group">
                    <label for="owner" class="govuk-label">Owner <span class="sup_color_red">*</span></label>
                    <select class="form-control govuk-select" id="owner" name="Owner" required>
                        <option value="">Select Owner</option>
                    </select>
                    <span class="govuk-error-message validation-message" data-valmsg-for="Owner" style="display:none;"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="govuk-form-group">
                    <label for="jobStatus" class="govuk-label">Job Status</label>
                    <input type="text" class="form-control govuk-input" id="jobStatus" name="JobStatus" maxlength="2" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="govuk-form-group">
                    <label for="chargeMethod" class="govuk-label">Charge Method</label>
                    <input type="text" class="form-control govuk-input" id="chargeMethod" name="ChargeMethod" maxlength="2" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="govuk-form-group">
                    <label for="defraUnitPrice" class="govuk-label">DEFRA Unit Price <span class="sup_color_red">*</span></label>
                    <input type="number" step="0.01" class="form-control govuk-input" id="defraUnitPrice" name="DefraUnitPrice" required />
                    <span class="govuk-error-message validation-message" data-valmsg-for="DefraUnitPrice" style="display:none;"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="govuk-form-group">
                    <label for="unitPriceVla" class="govuk-label">Unit Price VLA</label>
                    <input type="number" step="0.01" class="form-control govuk-input" id="unitPriceVla" name="UnitPriceVla" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="govuk-form-group">
                    <label for="priceAhvg" class="govuk-label">Price AHVG</label>
                    <input type="number" step="0.01" class="form-control govuk-input" id="priceAhvg" name="PriceAhvg" />
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal-footer">
    <button type="button" class="govuk-button govuk-button--secondary" data-dismiss="modal"
            onclick="closeTestModal()">
        Cancel
    </button>
    <button type="button" class="govuk-button" onclick="saveTestOrProduct()">Save</button>
</div>
