@model Apha.FPSApps.Web.Areas.PACT.Models.WorkGroupEmailItem

<div class="modal-header flex-space-center">
    <h3 class="govuk-heading-s sup_margin_0">Edit email settings</h3>
    <button type="button" class="btn-close"
            onclick="$('#modalPopup').removeClass('show')">×</button>
</div>

<div class="modal-body" style="overflow:hidden; padding:8px 16px 0 16px;">
    <form id="editEmailForm" class="govuk-grid-column-full" novalidate>

        <input type="hidden" id="edit-workgroup" name="workGroupName" value="@Model.WorkGroupName" />

        <div class="govuk-grid-row sup_margin_top_10">
            <div class="govuk-grid-column-full">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label" for="edit-workgroup-display">Workgroup</label>
                    <input class="govuk-input govuk-!-font-size-16"
                           id="edit-workgroup-display"
                           type="text" value="@Model.WorkGroupName"
                           readonly disabled />
                </div>
            </div>
        </div>

        <div class="govuk-grid-row govuk-!-margin-top-1">
            <div class="govuk-grid-column-full">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <fieldset class="govuk-fieldset">
                        <label class="govuk-label govuk-!-margin-bottom-0">
                            SendEmail?
                        </label>
                        <div class="govuk-radios govuk-radios--small govuk-radios--inline "
                             data-module="govuk-radios">
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="edit-send-yes"
                                       name="sendEmail" type="radio" value="1"
                                       @(Model.FlaggedForEmail ? "checked=\"checked\"" : "") />
                                <label class="govuk-label govuk-radios__label" for="edit-send-yes">
                                    Yes
                                </label>
                            </div>
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="edit-send-no"
                                       name="sendEmail" type="radio" value="0"
                                       @(!Model.FlaggedForEmail ? "checked=\"checked\"" : "") />
                                <label class="govuk-label govuk-radios__label" for="edit-send-no">
                                    No
                                </label>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row govuk-!-margin-bottom-2">
            <div class="govuk-grid-column-full">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-label--s" for="edit-email">
                        Email recipient
                    </label>
                    <input class="govuk-input govuk-!-font-size-16"
                           id="edit-email" name="emailRecipient" type="email"
                           value="@Model.EmailRecipient" autocomplete="off" />
                </div>
            </div>
        </div>

    </form>
</div>

<div class="modal-footer sup_flex_space_center">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
            onclick="$('#modalPopup').removeClass('show')">
        Cancel
    </button>
    <button type="button" class="govuk-button sup_margin_0"
            onclick="saveWorkGroupEmail()">
        Save
    </button>
</div>
