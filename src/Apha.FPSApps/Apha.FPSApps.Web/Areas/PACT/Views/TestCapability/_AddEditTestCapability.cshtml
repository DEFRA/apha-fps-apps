@model Apha.FPSApps.Web.Areas.PACT.Models.TestCapabilityItem
@using Microsoft.AspNetCore.Mvc.Rendering
@using Apha.FPSApps.Application.Dtos.FPS

@{
    var isEdit = !string.IsNullOrEmpty(Model.TestCode);
    var testorProductOptions = ViewBag.TestorProductOptions as List<SelectListItem> ?? new List<SelectListItem>();
    var workGroupOptions = ViewBag.WorkGroupOptions as List<SelectListItem> ?? new List<SelectListItem>();
    var projects = ViewBag.Projects as List<ProjectDto> ?? new List<ProjectDto>();
    var planPortfolioOptions = projects.Select(p => new SelectListItem(p.ParentProject, p.ParentProject)).ToList();
}

<div class="modal-header flex-space-center">
    <h3 class="govuk-heading-s" style="margin:0;">@(isEdit ? "Edit Test Capability" : "Add Test Capability")</h3>
    <button type="button" class="btn-close" onclick="$('#modalPopup').removeClass('show')">×</button>
</div>

<div class="modal-body" style="overflow:hidden; padding:8px 8px 0 8px;">
    <form id="testCapabilityForm" class="govuk-grid-column-full">

        <input type="hidden" name="isEdit" value="@isEdit.ToString().ToLower()" />

        <!-- Validation error summary -->
        <div class="govuk-error-summary" role="alert"
             aria-labelledby="tc-error-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="tc-error-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        <!-- Test Code -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" for="testCapabilityTestCodeDropdown_input">Test Code <span class="sup_color_red">*</span></label>
            @if (isEdit)
            {
                <input type="hidden" id="TestCode" name="TestCode" value="@Model.TestCode" />
                <input class="govuk-input govuk-!-font-size-16" aria-label="Test Code" value="@Model.TestCode" disabled />
            }
            else
            {
                <input type="hidden" id="TestCode" name="TestCode" value="@Model.TestCode" required />
                <div id="testCodeMultiDropdown"></div>
                <span data-valmsg-for="TestCode"
                      class="govuk-error-message field-validation-valid" style="display:none;"></span>
            }
        </div>

        <!-- Work Group -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" for="testCapabilityWorkGroupDropdown_input">WorkGroup <span class="sup_color_red">*</span></label>
            @if (isEdit)
            {
                <input type="hidden" id="WorkGroup" name="WorkGroup" value="@Model.WorkGroup" />
                <input class="govuk-input govuk-!-font-size-16" aria-label="Test Workgroup" value="@Model.WorkGroup" disabled />
            }
            else
            {
                <input type="hidden" id="WorkGroup" name="WorkGroup" value="@Model.WorkGroup" required />
                <div id="workGroupMultiDropdown"></div>
                <span data-valmsg-for="WorkGroup"
                      class="govuk-error-message field-validation-valid" style="display:none;"></span>
            }
        </div>

        <!-- Plan Portfolio -->
        <div class="govuk-form-group sup_margin_bottom_10">
            <label class="govuk-label govuk-!-font-weight-bold" for="testCapabilityPlanPortfolioDropdown_input">Plan Portfolio <span class="sup_color_red">*</span></label>
            <input type="hidden" id="PlanPortfolio" name="PlanPortfolio" value="@Model.PlanPortfolio" required />
            <div id="planPortfolioMultiDropdown"></div>
            <span data-valmsg-for="PlanPortfolio"
                  class="govuk-error-message field-validation-valid" style="display:none;"></span>
        </div>

    </form>
</div>

<div class="modal-footer" style="display:flex; justify-content:space-between; align-items:center;">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0"
            onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <button type="button" class="govuk-button sup_margin_0" onclick="saveTestCapability()" allow-edit="true">
        @(isEdit ? "Update" : "Save")
    </button>
</div>

<script>
    (function () {
        if (typeof window.initializeTestCapabilityAddEditDropdowns !== 'function') {
            return;
        }

        window.initializeTestCapabilityAddEditDropdowns({
            isEditMode: @isEdit.ToString().ToLowerInvariant(),
            testCodeData: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(testorProductOptions.Select(x => new { x.Value, x.Text }))),
            workGroupData: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(workGroupOptions.Select(x => new { x.Value, x.Text }))),
            planPortfolioData: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(planPortfolioOptions.Select(x => new { x.Value, x.Text })))
        });
    }());
</script>
