@model Apha.FPSApps.Web.Areas.PACT.Models.AutomaticInvoiceItem
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var isEdit = Model.InvoiceCounter != 0;
}

<div class="modal-header flex-space-center">
    <h3 class="govuk-heading-s sup_margin_0">@(isEdit ? "Edit Invoice" : "Add Invoice Record")</h3>
    <button type="button" class="btn-close" onclick="$('#modalPopup').removeClass('show')">×</button>
</div>

<div class="modal-body" style="overflow:hidden; padding:8px 16px 0 16px;">
    <form id="automaticInvoiceForm" class="govuk-grid-column-full">

        <input type="hidden" name="isEdit" value="@isEdit.ToString().ToLower()" />
        <input type="hidden" asp-for="InvoiceCounter" />

        <!-- Validation error summary -->
        <div class="govuk-error-summary" role="alert"
             aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
            <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>

        <span class="app-mandatory-note sup_padding_top_10" aria-hidden="true">
            <span class="app-required">*</span> Mandatory Fields
        </span>

        <div class="govuk-grid-row sup_margin_top_10">
            <div class="govuk-grid-column-full">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="ProjectParent">
                        Parent <span class="app-required" aria-hidden="true">*</span>
                    </label>
                    @{
                        var projects = ViewBag.Projects as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
                    }
                    <select class="govuk-select sup_select_option_width_100 govuk-!-font-size-16"
                            asp-for="ProjectParent"
                            asp-items="@projects"
                            required>
                        <option value="">-- Select Project --</option>
                    </select>
                    <span asp-validation-for="ProjectParent" class="govuk-error-message"></span>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Month">
                        Select month <span class="app-required" aria-hidden="true">*</span>
                    </label>
                    @{
                        var months = ViewBag.Months as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
                    }
                    <select class="govuk-select sup_select_option_width_100 govuk-!-font-size-16"
                            asp-for="Month"
                            asp-items="@months"
                            required>
                        <option value="">-- Select month --</option>
                    </select>
                    <span asp-validation-for="Month" class="govuk-error-message"></span>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Amount">
                        Amount <span class="app-required" aria-hidden="true">*</span>
                    </label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input type="number" class="govuk-input govuk-!-font-size-16"
                               asp-for="Amount" step="0.01" placeholder="" required />
                    </div>
                    <span asp-validation-for="Amount" class="govuk-error-message"></span>
                </div>
            </div>
        </div>

    </form>
</div>

<div class="modal-footer" style="display:flex; justify-content:space-between; padding:10px 16px;">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_bottom_20"
            data-module="govuk-button" onclick="$('#modalPopup').removeClass('show')">Cancel</button>
    <div>
        @if (isEdit)
        {
            <button type="button" class="govuk-button sup_margin_bottom_20" data-module="govuk-button"
                    onclick="saveAutomaticInvoice()">Update</button>
        }
        else
        {
            <button type="button" class="govuk-button sup_margin_bottom_20" data-module="govuk-button"
                    onclick="saveAutomaticInvoice()">Save</button>
        }
    </div>
</div>

<script>
    // Initialize form validation for this modal
    if (typeof initFormValidation === 'function') {
        initFormValidation('automaticInvoiceForm');
    }
</script>
