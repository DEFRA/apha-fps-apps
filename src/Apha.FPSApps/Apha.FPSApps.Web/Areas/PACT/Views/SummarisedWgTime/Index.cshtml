@model Apha.FPSApps.Web.Areas.PACT.Models.SummarisedWgTimeViewModel
@{
    ViewData["Title"] = "Time Usage Spreadsheet";
}

<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full sup_flex_space_center sup_border-bottom">
        <div class="sup_flex_center_start govuk-grid-column-one-half sup_p_0">
            <h1 class="sup_margin_top_10 sup_padding_bottom_10">Time Usage "Spreadsheet" for</h1>
            <div class="sup_margin_tb_5 sup_padding_right_8 govuk-grid-column-one-half">
                <div>
                    <input type="text" id="txtselectedWorkgroup" class="govuk-input govuk-!-font-size-16"
                           value="@Model.SelectedWorkgroup" readonly disabled />
                </div>
            </div>
        </div>
        <div class="govuk-grid-column-one-half">
            <a asp-area="PACT" asp-controller="WorkGroupPeople" asp-action="Index"
               class="govuk-back-link sup_align_right sup_margin_0">Back</a>
        </div>
    </div>
</div>

<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10 sup_margin_bottom_10">
    <div class="govuk-grid-column-full">
        <div class="sup_flex_end_center">
            <button type="button" class="govuk-button sup_margin_right_10"
                    data-module="govuk-button" onclick="resetCalculationGrid()">
                Reset Calculation
            </button>
            <button type="button" class="govuk-button" data-module="govuk-button" onclick="openTimeRecordModal()">
                Calculate Year Plan
            </button>
        </div>
    </div>
</div>
<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10 sup_margin_bottom_10">
    <div class="govuk-grid-column-full">
        <div id="gridContainer_summarisedWorkgroupTimeGrid">
            @await Html.PartialAsync("_DataGrid", Model.Grid)
        </div>

        @* ── Column Totals Row – one cell per grid column, in the same order ── *@
        @{
            var s = Model.Summary;
        }
        <div id="columnTotalsContainer" class="column-totals-container">
            @* Col 1 – Project (label cell) *@
            <div class="column-total column-total-label" data-col-index="0">Totals:</div>
            @* Col 2–13 – Apr to Mar *@
            <div class="column-total" data-col-index="1">@(s.TotalApril    == 0 ? "" : s.TotalApril.ToString("0.##"))</div>
            <div class="column-total" data-col-index="2">@(s.TotalMay      == 0 ? "" : s.TotalMay.ToString("0.##"))</div>
            <div class="column-total" data-col-index="3">@(s.TotalJune     == 0 ? "" : s.TotalJune.ToString("0.##"))</div>
            <div class="column-total" data-col-index="4">@(s.TotalJuly     == 0 ? "" : s.TotalJuly.ToString("0.##"))</div>
            <div class="column-total" data-col-index="5">@(s.TotalAugust   == 0 ? "" : s.TotalAugust.ToString("0.##"))</div>
            <div class="column-total" data-col-index="6">@(s.TotalSeptember== 0 ? "" : s.TotalSeptember.ToString("0.##"))</div>
            <div class="column-total" data-col-index="7">@(s.TotalOctober  == 0 ? "" : s.TotalOctober.ToString("0.##"))</div>
            <div class="column-total" data-col-index="8">@(s.TotalNovember == 0 ? "" : s.TotalNovember.ToString("0.##"))</div>
            <div class="column-total" data-col-index="9">@(s.TotalDecember == 0 ? "" : s.TotalDecember.ToString("0.##"))</div>
            <div class="column-total" data-col-index="10">@(s.TotalJanuary == 0 ? "" : s.TotalJanuary.ToString("0.##"))</div>
            <div class="column-total" data-col-index="11">@(s.TotalFebruary== 0 ? "" : s.TotalFebruary.ToString("0.##"))</div>
            <div class="column-total" data-col-index="12">@(s.TotalMarch   == 0 ? "" : s.TotalMarch.ToString("0.##"))</div>
            @* Col 14 – Time total *@
            <div class="column-total" data-col-index="13">@(s.GrandTotalTime == 0 ? "" : s.GrandTotalTime.ToString("0.##"))</div>
            @* Col 15 – Cost total *@
            <div class="column-total" data-col-index="14">@(s.GrandTotalCost == 0 ? "" : "£" + s.GrandTotalCost.ToString("N2"))</div>
            @* Col 16 – YrPlan (no summary value) *@
            <div class="column-total" data-col-index="15">&nbsp;</div>
            @* Col 17 – Spent (no summary value) *@
            <div class="column-total" data-col-index="16">&nbsp;</div>
        </div>
    </div>
</div>


<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_bottom_10">
    <div class="govuk-grid-column-one-quarter">
        <label for="txtSelectedProject" class="govuk-label govuk-!-font-weight-bold sup_visually_hidden">Selected Project:</label>
        <input type="text" id="txtSelectedProject" class="govuk-input govuk-!-font-size-16" readonly />
    </div>
    <div class="govuk-grid-column-one-half">
        <label for="txtProjectDescription" class="govuk-label govuk-!-font-weight-bold sup_visually_hidden">Project Description:</label>
        <input type="text" id="txtProjectDescription" class="govuk-input govuk-!-font-size-16" readonly />
    </div>
</div>

<!-- ============================================================
     CALCULATE YEAR PLAN MODAL
============================================================ -->
<div class="govuk-edit-modal" id="timeRecordModal" aria-labelledby="timeRecordModalLabel" aria-modal="true"
     role="dialog">
    <div class="govuk-edit-modal-dialog sup_overflow_visible">

        <div class="govuk-edit-modal__header">
            <h3 class="govuk-heading-s sup_margin_0" id="timeRecordModalLabel">
                Calculate Year Plan
            </h3>
            <button type="button" class="govuk-edit-modal__close" onclick="closeTimeRecordModal()"
                    aria-label="Close">
                &#x2715;
            </button>
        </div>

        <div class="govuk-edit-modal__body sup_padding_top_0 sup_overflow_visible">
            <form id="formTimeRecord" novalidate onsubmit="return false;">
                <!-- DB-level error banner (hidden by default) -->
                <div id="formTimeRecord-db-error" class="govuk-error-summary" role="alert"
                     aria-labelledby="formTimeRecord-db-error-title" hidden>
                    <h2 class="govuk-error-summary__title" id="formTimeRecord-db-error-title">
                        There is a problem
                    </h2>
                    <div class="govuk-error-summary__body">
                        <p class="govuk-body" id="formTimeRecord-db-error-msg"></p>
                    </div>
                </div>

                <fieldset class="govuk-fieldset">
                    <legend class="govuk-visually-hidden">Time Record</legend>

                    <span class="app-mandatory-note sup_padding_top_10" aria-hidden="true">
                        <span class="app-required">*</span> Mandatory Fields
                    </span>

                    <div class="govuk-grid-row">
                        <div class="govuk-grid-column-two-thirds">
                            <div class="govuk-form-group sup_margin_bottom_10" id="fg-project">
                                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                                       for="modal-amount">
                                    Years plan amount <span class="app-required" aria-hidden="true">*</span>
                                </label>
                                <div class="govuk-input__wrapper">
                                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                    <input class="govuk-input govuk-!-font-size-16 govuk-!-width-full"
                                           id="modal-amount" name="amount" type="number" step="0.01" autocomplete="off"
                                           aria-required="true" aria-describedby="modal-amount-error" />
                                </div>
                                <p id="modal-amount-error" class="govuk-error-message" hidden>
                                    <span class="govuk-visually-hidden">Error:</span>
                                    <span id="modal-amount-error-msg"></span>
                                </p>
                            </div>
                        </div>
                    </div>

                </fieldset>
            </form>
        </div>

        <div class="govuk-edit-modal__footer">
            <button type="button" class="govuk-button govuk-button--secondary sup_margin_bottom_20"
                    data-module="govuk-button" onclick="closeTimeRecordModal()">
                Cancel
            </button>
            <div>
                <button type="button" class="govuk-button sup_margin_bottom_20" data-module="govuk-button"
                        id="timeRecordSaveBtn" onclick="calculateSpent()">
                    Calculate
                </button>
            </div>
        </div>

    </div>
</div>

<script>
    var projectTitleLookup = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ProjectTitleLookup ?? new Dictionary<string, string>()))
</script>

<input type="hidden" id="hdnYrPlanAmount" value="0" />

@section Scripts {
    <script src="~/js/pact_js/summarisedWgTime.js" asp-append-version="true"></script>
}
