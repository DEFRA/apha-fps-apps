@model Apha.FPSApps.Web.Areas.PACT.Models.WgSummarisedStaffTimeUsageViewModel

@{
    ViewData["Title"] = "PACT : Work Group Time By Job Code";
}

@* ── Header info (mirrors Access FormHeader: WorkGroup / HrsPaid) ── *@

<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full  sup_flex_space_center sup_border-bottom">
        <div class="sup_flex_center_start govuk-grid-column-full sup_p_0 sup_margin_0">
            <h1 class="sup_padding_bottom_10 govuk-grid-column-one-third sup_p_0">Time Usage "Spreadsheet" for </h1>
            <div class="govuk-grid-column-three-quarters sup_margin_tb_5 sup_padding_right_8 sup_flex_gap_10">
                <div class="govuk-!-width-one-half">
                    <input type="text" id="txtselectedPersonname" class="govuk-input govuk-!-font-size-16" asp-for="@Model.SelectedPersonName" readonly="" disabled="">
                </div>
                <div>
                    <input type="text" id="txtselectedWG" class="govuk-input govuk-!-font-size-16" asp-for="@Model.SelectedWorkGroup" readonly="" disabled="">
                </div>
                <div class="govuk-grid-column-two-thirds sup_flex_align_center">
                    <span class="sup_bold_100">Standard Hours</span>
                    <input type="text" id="txtStandardhours" class="govuk-input govuk-!-font-size-16" value="@Model.HrsPaid.ToString("0.##")" readonly="" disabled="">
                </div>
            </div>
        </div>
        <div class="govuk-grid-column-one-half"><a href="#" id="backLink" class="govuk-back-link sup_align_right sup_margin_0">Back</a></div>
    </div>
</div>

@* ── Grid extra-filter: keeps workGroup and personName in every sort/pagination POST ── *@
<script>
    var currentWorkGroup = '@Html.Raw(Model.SelectedWorkGroup ?? "")';
    var currentPersonName = '@Html.Raw(Model.SelectedPersonName ?? "")';
    function getWorkGroupTimeByJobCodeExtraFilters() {
        return { workGroup: currentWorkGroup, personName: currentPersonName };
    }

                function alignColumnTotals() {
                const table = document.querySelector('#gridContainer_timeUsageGrid table');
                if (!table) return;

                const tableRect = table.getBoundingClientRect();
                const headers = table.querySelectorAll('thead th');

                if (headers.length === 0) return;

                // Map of column field names to their index in the table
                const columnMap = {
                            'ParentProject': 0,
                            'JobCode': 1,
                            'April': 2,
                            'May': 3,
                            'June': 4,
                            'July': 5,
                            'August': 6,
                            'September': 7,
                            'October': 8,
                            'November': 9,
                            'December': 10,
                            'January': 11,
                            'February': 12,
                            'March': 13,
                            'TotalTime': 14,
                            'TotalCost': 15
                };

                // Function to align a specific container
                const alignContainer = (containerId) => {
                    const container = document.getElementById(containerId);
                    if (!container) return;

                    const label = container.querySelector('.column-total-label');
                    const columns = container.querySelectorAll('.column-total');

                    if (!label || columns.length === 0) return;

                    // Position label to align with Project + JobCode columns
                    const projectHeader = headers[columnMap['ParentProject']];
                    const jobCodeHeader = headers[columnMap['JobCode']];

                    if (projectHeader && jobCodeHeader) {
                        const projectRect = projectHeader.getBoundingClientRect();
                        const jobCodeRect = jobCodeHeader.getBoundingClientRect();
                        const labelLeft = projectRect.left - tableRect.left;
                        const labelWidth = (jobCodeRect.right - projectRect.left);

                        label.style.position = 'absolute';
                        label.style.left = labelLeft + 'px';
                        label.style.width = labelWidth + 'px';
                    }

                    // Position each column total div
                    const monthColumns = ['April', 'May', 'June', 'July', 'August', 'September',
                                        'October', 'November', 'December', 'January', 'February', 'March',
                                        'TotalTime', 'TotalCost'];

                    columns.forEach((col, index) => {
                        if (index >= monthColumns.length) return;

                        const columnName = monthColumns[index];
                        const headerIndex = columnMap[columnName];
                        const header = headers[headerIndex];

                        if (header) {
                            const headerRect = header.getBoundingClientRect();
                            const colLeft = headerRect.left - tableRect.left;
                            const colWidth = headerRect.width;

                            col.style.position = 'absolute';
                            col.style.left = colLeft + 'px';
                            col.style.width = colWidth + 'px';
                        }
                    });
                };

                // Align all three containers
                alignContainer('columnTotalsContainer');
                alignContainer('columnStandardHoursContainer');
                alignContainer('columnStndHrsAllocatedContainer');
            }

            // Wrap setup in DOMContentLoaded to ensure grid is rendered
            document.addEventListener('DOMContentLoaded', function() {
                // Setup column totals alignment
                const table = document.querySelector('#gridContainer_timeUsageGrid table');
                if (table) {
                    // Align after grid is rendered
                    window.addEventListener('load', () => requestAnimationFrame(alignColumnTotals));
                    window.addEventListener('resize', () => requestAnimationFrame(alignColumnTotals));

                    // Use ResizeObserver to watch for table changes
                    const observer = new ResizeObserver(() => requestAnimationFrame(alignColumnTotals));
                    observer.observe(table);

                    // Listen for mouseup to catch column resize completion
                    let isResizing = false;
                    document.addEventListener('mousedown', function(e) {
                        if (e.target.classList.contains('column-resizer')) {
                            isResizing = true;
                        }
                    });

                    document.addEventListener('mouseup', function(e) {
                        if (isResizing) {
                            isResizing = false;
                            requestAnimationFrame(alignColumnTotals);
                        }
                    });

                    // Use MutationObserver to watch for style changes on table headers
                    const mutationObserver = new MutationObserver(function(mutations) {
                        let shouldRealign = false;
                        mutations.forEach(function(mutation) {
                            if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
                                shouldRealign = true;
                            }
                        });
                        if (shouldRealign) {
                            requestAnimationFrame(alignColumnTotals);
                        }
                    });

                    // Observe all th elements for style changes
                    const headers = table.querySelectorAll('th');
                    headers.forEach(function(th) {
                        mutationObserver.observe(th, { attributes: true, attributeFilter: ['style'] });
                    });

                    // Also align after initial render with a slight delay
                    setTimeout(() => alignColumnTotals(), 100);
                    setTimeout(() => alignColumnTotals(), 500); // Extra delay for grid initialization
                }
            });

</script>

@* ── Data Grid ──────────────────────────────────────────────────────────── *@
<div class="govuk-grid-row sup_margin_left_right_0" style="margin-top:20px;">
    <div class="govuk-grid-column-full">
        <div id="spreadsheetContainer1">
            <div id="gridContainer_timeUsageGrid">
                @await Html.PartialAsync("_DataGrid", Model.Grid)
            </div>

            @* ── Footer Summary ──────────────────────────────────────────────── *@
            @if (Model.Grid.Data != null && Model.Grid.Data.Any())
            {
                var s      = Model.Summary;
                var months = new[] { "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar" };
                var totals = new[] { s.TotalApril, s.TotalMay, s.TotalJune, s.TotalJuly, s.TotalAugust, s.TotalSeptember, s.TotalOctober, s.TotalNovember, s.TotalDecember, s.TotalJanuary, s.TotalFebruary, s.TotalMarch };
                var pcts   = new[] { s.PercentAllocatedApril, s.PercentAllocatedMay, s.PercentAllocatedJune, s.PercentAllocatedJuly, s.PercentAllocatedAugust, s.PercentAllocatedSeptember, s.PercentAllocatedOctober, s.PercentAllocatedNovember, s.PercentAllocatedDecember, s.PercentAllocatedJanuary, s.PercentAllocatedFebruary, s.PercentAllocatedMarch };

                        
                                <div id="columnTotalsContainer" class="column-totals-container">
                                    <div class="column-total-label">Total time for the Month:</div>
                                    @for (int i = 0; i < 12; i++)
                                    {
                                        <div class="column-total">@(totals[i] == 0 ? "" : totals[i].ToString("0.##"))</div>
                                    }
                                    <div class="column-total">@s.GrandTotalTime.ToString("0.##")</div>
                                    <div class="column-total">£@s.GrandTotalCost.ToString("N2")</div>
                                    
                                </div>

                        <div id="columnStandardHoursContainer" class="column-totals-container">
                            <div class="column-total-label">Standard Hours:</div>
                            @for (int i = 0; i < 12; i++)
                                    {
                                <div class="column-total" id="stndHrs_april">
                                    @(totals[i] == 0 ? "" : s.StandardHoursPerMonth.ToString("0.##"))
                                </div>                        
                                        }
                             <div class="column-total" id="stndHrs_time">@(s.TotalStandardHours == 0 ? "" : s.TotalStandardHours.ToString("0.##"))</div>
                            <div class="column-total" id="stndHrs_cost">&nbsp;</div>
                         </div>
                     
                        <div id="columnStndHrsAllocatedContainer" class="column-totals-container">
                            <div class="column-total-label">% of Standard Hrs Allocated</div>
                    
                            
                   
                        @for (int i = 0; i < 12; i++)
                        {
                                <div class="column-total">
                                    
                                    @(totals[i] == 0 ? "" : pcts[i].ToString("0.#") + "%")</div>
                        }
                            <div class="column-total">@(s.GrandTotalPercentAllocated == 0 ? "" : s.GrandTotalPercentAllocated.ToString("0.#") + "%")</div>
                            <div class="column-total"></div>
                     
                        </div> 
           
            }
        </div>
    </div>
</div>
