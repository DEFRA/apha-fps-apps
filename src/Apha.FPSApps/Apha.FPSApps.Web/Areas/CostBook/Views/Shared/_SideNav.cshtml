@model Apha.FPSApps.Web.Areas.CostBook.Models.YearlyDetailsViewModel

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string action = "Index")
    {
        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    }

    // Project Costs is the default ONLY on YearlyDetails page
    bool projectCostsActive =
        IsActive("ProjectCosts") ||
        string.Equals(currentController, "YearlyDetails", StringComparison.OrdinalIgnoreCase);

    bool staffYearsActive = IsActive("StaffYears");
    bool staffEffortActive = IsActive("StaffEffort");
    bool projectSummaryActive = IsActive("ProjectSummary");
    bool excelReportActive = IsActive("ProjectCosts", "ExportToExcel");
}

<!-- Side Navigation -->

<nav class="sidenav flex-column flex-shrink-0" id="shortnav">

    <button class="toggle-btn project-toggle-btn"
            onclick="toggleSidebar()"
            aria-label="Toggle side navigation">
        <img src="~/images/chevron-left-solid-full.svg"
             alt="side nav menu arrow"
             width="24">
    </button>

    <ul>

        <li>
            <a class="dropdown-item sidenav-title">
                Queries
            </a>
        </li>

        <!-- Project Costs Query -->
        <li>
            <a class="dropdown-item @(projectCostsActive ? "active" : "")"
               asp-area="CostBook"
               asp-controller="ProjectCosts"
               asp-action="Index"
               asp-route-projectId="@Model.ProjectHeaderDto.ProjectId">
                Project Costs Query
            </a>
        </li>

        <!-- CSG7 Staff Years -->
        <li>
            <a class="dropdown-item @(staffYearsActive ? "active" : "")"
               asp-area="CostBook"
               asp-controller="StaffYears"
               asp-action="Index"
               asp-route-projectId="@Model.ProjectHeaderDto.ProjectId">
                CSG7 Staff Years
            </a>
        </li>

        <!-- SID3 Staff Effort -->
        <li>
            <a class="dropdown-item @(staffEffortActive ? "active" : "")"
               asp-area="CostBook"
               asp-controller="StaffEffort"
               asp-action="Index"
               asp-route-projectId="@Model.ProjectHeaderDto.ProjectId">
                SID3 Staff Effort
            </a>
        </li>

        <!-- Project Summary -->
        <li>
            <a class="dropdown-item @(projectSummaryActive ? "active" : "")"
               asp-area="CostBook"
               asp-controller="ProjectSummary"
               asp-action="Index"
               asp-route-projectId="@Model.ProjectHeaderDto.ProjectId">
                Project Summary
            </a>
        </li>

        <!-- Excel Report -->
        <li>
            <a class="dropdown-item @(excelReportActive ? "active" : "")"
               asp-area="CostBook"
               asp-controller="ProjectCosts"
               asp-action="ExportToExcel"
               asp-route-projectId="@Model.ProjectHeaderDto.ProjectId">
                Excel Report
            </a>
        </li>

    </ul>
</nav>