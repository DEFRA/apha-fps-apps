@using System.Security.Claims
@{
    // Get display name from claims (try multiple claim types)
    var displayName = User.FindFirst("name")?.Value
                      ?? User.FindFirst(ClaimTypes.GivenName)?.Value
                      ?? User.FindFirst(ClaimTypes.Name)?.Value?.Split('@')[0]
                      ?? "Unknown User";
   
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Costbook</title>

    <!-- CSS References — 5-tier hierarchy -->
    <link rel="stylesheet" href="~/css/govuk-frontend-6.0.0.min.css" />
    <link rel="stylesheet" href="~/css/supplement_style_for_gov.uk_style.css" />
    <link rel="stylesheet" href="~/css/main_style.css" />
    <link rel="stylesheet" href="~/css/common/headernav/navstyle.css" />
    <link rel="stylesheet" href="~/DataGrid/editable-grid.css" />
    <link rel="stylesheet" href="~/css/costbook_styles/styles.css" />

    <script src="~/lib/jquery/dist/jquery.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- ── Top Header ─────────────────────────────────────────────────── -->
    <header>
        <div class="header-nav">
            <div class="pims-log-wrapper">
                <div>
                    <img src="~/images/defra_logo.png" alt="Defra logo" width="80" />
                </div>
                <div class="pims-log">
                    <span>Costbook</span>
                </div>
            </div>
            <div>
                <button class="userdropdownbtn" id="userdropdownbtn" allow-edit="true">@displayName &nbsp; <img src="~/images/circle-user-regular-full.svg" alt="user icon" width="24" /></button>
                <div class="userdropdown" id="userdropdowndp">
                    <ul>
                        <li>
                            <a href="/" style="display: flex; align-items: center;" type="button">
                                <img src="~/images/house-user-solid-full.svg" alt="dropdown home icon" width="22" />
                                Home
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <!-- ── Main Navigation ───────────────────────────────────────────── -->
    <div id="header">
        <nav class="main-nav">

            <!-- Choose Project -->
            <div class="nav-item">
                <a class="nav-button" asp-area="CostBook" asp-controller="Projects" asp-action="Index">
                    <div class="align-menu-text"><span>Choose Project</span></div>
                </a>
            </div>

            <!-- Maintenance -->
            <div class="nav-item dropdown">
                <button class="nav-button dropdown-toggle" data-dropdown="cb-maintenance" allow-edit="true">
                    <div class="align-menu-text"><span>Maintenance</span></div>
                    <span class="arrow"><img src="~/images/arrow-down.svg" alt="down arrow" width="12" /></span>
                </button>
                <div class="dropdown-menu" id="cb-maintenance">
                    <a class="dropdown-item" asp-area="CostBook" asp-controller="YearlyDetails" asp-action="Index">Yearly Details</a>
                </div>
            </div>

        </nav>
    </div>

    <!-- ── Page Body ─────────────────────────────────────────────────── -->
    <div class="sup_margin_bottom_10 content-wrapper">
        @RenderBody()
    </div>

    <!-- ── Footer ────────────────────────────────────────────────────── -->
    <div class="govuk-footer sup_p_0 sup_margin_left_right_0">
        <div class="govuk-width-container sup_p_8 sup_text_center">
            <span>
                &copy; Copyright Defra 2025
            </span>
        </div>
    </div>

    <!-- ── Shared modal popup (for add/edit forms) ───────────────────── -->
    <div id="modalPopup" tabindex="-1" aria-labelledby="modalPopupLabel"
         style="display:none; position:fixed; inset:0; z-index:1050;
                background:rgba(0,0,0,0.5); align-items:center; justify-content:center;">
        <div class="modal-dialog modal-lg" style="margin:auto; width:100%; max-width:700px;">
            <div id="modaPopupBody" class="modal-content" style="border-radius:4px;">
            </div>
        </div>
    </div>

    <!-- ── Scripts ───────────────────────────────────────────────────── -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/js/govuk-modal-dialog.js"></script>
    <fps-year-script></fps-year-script>

    <script>
        // ── Modal open / close helpers ────────────────────────────────────
        (function () {
            var modal = document.getElementById('modalPopup');
            if (!modal) return;

            var observer = new MutationObserver(function () {
                if (modal.classList.contains('show')) {
                    modal.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                } else {
                    modal.style.display = 'none';
                    document.body.style.overflow = '';
                }
            });
            observer.observe(modal, { attributes: true, attributeFilter: ['class'] });

            modal.addEventListener('click', function (e) {
                if (e.target === modal) {
                    return false;
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modal.classList.contains('show')) {
                    modal.classList.remove('show');
                }
            });
        })();

        // ── jQuery.fn.serializeObject helper ─────────────────────────────
        $.fn.serializeObject = function () {
            var obj = {};
            this.serializeArray().forEach(function (item) {
                obj[item.name] = item.value;
            });
            return obj;
        };
    </script>

    <script src="~/js/costbook_js/costbooknavmenu.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>