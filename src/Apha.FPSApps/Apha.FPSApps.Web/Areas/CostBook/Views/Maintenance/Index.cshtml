        // TRANSFORMENGINE: saveAccountCategory — called from _AddEditAccountCategory partial
        //   POST to EditAccountCategory (which dispatches PUT /api/v1/maintenance/account-categories/{accShortName})
        function saveAccountCategory() {
            var accShortName = $('#hdnAccShortName').val();
            var csg7Group    = $('#modal-acccat-csg7group').val();

            if (!csg7Group) {
                alert('Please select a CSG7 Group.');
                return;
            }

            var dto = { csg7Group: csg7Group };
            $.ajax({
                url: '@Url.Action("EditAccountCategory", "Maintenance", new { area = "CostBook" })?accShortName=' + encodeURIComponent(accShortName),
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(dto),
                headers: { 'RequestVerificationToken': getAntiForgeryToken() },
                success: function (data) {
                    if (data.success) {
                        closeModal();
                        reloadAccCatGrid();
                    } else {
                        var msg = (data.errors && data.errors.length) ? data.errors.join('; ') : (data.message || 'Save failed.');
                        alert('Error: ' + msg);
                    }
                },
                error: function () { alert('An error occurred while saving.'); }
            });
        }

