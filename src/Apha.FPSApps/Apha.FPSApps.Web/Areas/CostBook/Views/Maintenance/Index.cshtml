        // ── Tab 1: Inflation form ────────────────────────────────────────────────

        // TRANSFORMENGINE: formInflation submit handler — numeric validation + AJAX POST
        (function () {
            var inflFields = [
                { id: 'inflAnimals',              errId: 'inflAnimals-error',              wrapId: 'fg-inflAnimals' },
                { id: 'inflExceptionalCosts',     errId: 'inflExceptionalCosts-error',     wrapId: 'fg-inflExceptionalCosts' },
                { id: 'inflStaff',                errId: 'inflStaff-error',                wrapId: 'fg-inflStaff' },
                { id: 'inflTests',                errId: 'inflTests-error',                wrapId: 'fg-inflTests' },
                { id: 'inflCurrentFinancialYear', errId: 'inflCurrentFinancialYear-error', wrapId: 'fg-inflCurrentFinancialYear' },
                { id: 'inflWorkingHoursInDay',    errId: 'inflWorkingHoursInDay-error',    wrapId: 'fg-inflWorkingHoursInDay' },
                { id: 'inflWorkingDaysInYear',    errId: 'inflWorkingDaysInYear-error',    wrapId: 'fg-inflWorkingDaysInYear' }
            ];

            inflFields.forEach(function (fc) {
                var el = document.getElementById(fc.id);
                if (!el) return;
                el.addEventListener('input', function () {
                    if (isNumericValue(el.value.trim())) {
                        clearFieldError(fc.id, fc.errId, fc.wrapId);
                    }
                });
            });

            var cancelBtn = document.getElementById('btnInflationCancel');
            if (cancelBtn) {
                cancelBtn.addEventListener('click', function () {
                    clearFormErrors('formInflation');
                    document.getElementById('formInflation').reset();
                });
            }

            var form = document.getElementById('formInflation');
            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    clearFormErrors('formInflation');

                    var isValid = true;
                    inflFields.forEach(function (fc) {
                        var val = (document.getElementById(fc.id).value || '').trim();
                        if (!isNumericValue(val)) {
                            showFieldError(fc.id, fc.errId, fc.wrapId);
                            isValid = false;
                        }
                    });
                    if (!isValid) return;

                    var dto = {
                        inflationAnimals:          parseFloat(document.getElementById('inflAnimals').value),
                        inflationExceptionalCosts: parseFloat(document.getElementById('inflExceptionalCosts').value),
                        inflationStaff:            parseFloat(document.getElementById('inflStaff').value),
                        inflationTests:            parseFloat(document.getElementById('inflTests').value),
                        currentFinancialYear:       parseInt(document.getElementById('inflCurrentFinancialYear').value, 10),
                        workingHoursInDay:          parseFloat(document.getElementById('inflWorkingHoursInDay').value),
                        workingDaysInYear:          parseFloat(document.getElementById('inflWorkingDaysInYear').value)
                    };

                    $.ajax({
                        url: '@Url.Action("SaveInflationSettings", "Maintenance", new { area = "CostBook" })',
                        type: 'POST',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify(dto),
                        headers: { 'RequestVerificationToken': getAntiForgeryToken() },
                        success: function (data) {
                            if (data.success) {
                                alert(data.message || 'Inflation values saved successfully.');
                            } else {
                                var msg = (data.errors && data.errors.length) ? data.errors.join('; ') : (data.message || 'Save failed.');
                                showDbError('formInflation', msg);
                            }
                        },
                        error: function () {
                            showDbError('formInflation', 'An error occurred while saving inflation values.');
                        }
                    });
                });
            }
        })();

