@model Apha.FPSApps.Web.Areas.CostBook.Models.ProjectCreateEditViewModel

@{
    ViewData["Title"] = "Project Edit";
}

<script>
    function openDatePicker(pickerId) {
        var picker = document.getElementById(pickerId);
        if (picker) {
            try { picker.showPicker(); } catch (e) { picker.click(); }
        }
    }

    function syncDateToText(pickerId, displayId, hiddenId) {
        var picker = document.getElementById(pickerId);
        if (picker.value) {
            var parts = picker.value.split('-');
            document.getElementById(displayId).value = parts[2] + '/' + parts[1] + '/' + parts[0];
            document.getElementById(hiddenId).value = picker.value;
        } else {
            document.getElementById(displayId).value = '';
            document.getElementById(hiddenId).value = '';
        }

        // Auto-calculate StartFYear when StartDate changes
        if (pickerId === 'StartdatePicker') {
            calculateStartFYear();
        }
    }

    function calculateStartFYear() {
        var picker = document.getElementById('StartdatePicker');
        var startFYearInput = document.getElementById('StartFYear');
        var financialYearsSelect = document.getElementById('FinancialYears');

        if (!picker || !startFYearInput || !financialYearsSelect) return;

        if (!picker.value) {
            startFYearInput.value = '';
            return;
        }

        var parts = picker.value.split('-');
        var year = parseInt(parts[0], 10);
        var month = parseInt(parts[1], 10);
        var financialYears = financialYearsSelect.value;

        // Mirrors MS Access SetStartDate / C# CalculateStartFinancialYear logic
        if (financialYears === '0') {
            startFYearInput.value = year;
        } else if (month <= 3) {
            startFYearInput.value = year - 1;
        } else {
            startFYearInput.value = year;
        }
    }
</script>

<div class="container-fluid costbook-edit-page">
    <div class="row">
        <div >
            <div class="govuk-grid-row sup_border-bottom sup_margin_bottom_0">
                <div class="govuk-grid-column-full">
                    <h1 class="govuk-heading-s " style="padding-top: 10px">
                        Project Selection
                        <a asp-area="CostBook" asp-controller="Projects" asp-action="Index" class="govuk-back-link sup_align_right">Back</a>
                    </h1>
                </div>
            </div>
        </div>

        <div>
            <div class="main-content" style="padding-top: 0px;">
                <div class=" sup_margin_top_10">
                    <form asp-area="CostBook" asp-controller="Projects" asp-action="Edit" asp-route-id="@Model.ProjectId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
                        

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" data-module="govuk-error-summary">
                                <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
                            </div>
                        }                        

                        <div class="costbook-edit-page edit-form-container">

                            <!-- Action buttons -->
                            <div class="action-buttons edit-action-buttons">
                                <button type="button" class="govuk-button govuk-button--warning sup_margin_0" onclick="confirmDelete()">Delete</button>
                                <button type="button" class="govuk-button sup_margin_0" onclick="copyProject()">Copy</button>
                                <a class="govuk-button sup_margin_0" asp-area="CostBook" asp-controller="YearlyDetails" asp-action="Index" asp-route-projectId="@Model.ProjectId">
                                    Yearly Details
                                </a>
                            </div>

                            <!-- Costing Book Code -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label asp-for="ProjectId" class="govuk-label label_width mb-0 pt-1">Costing Book Code:</label>
                                <div>
                                    <input asp-for="ProjectId" class="govuk-input width-200 read-only margin_left_5" readonly>
                                    <span asp-validation-for="ProjectId" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Contract Number -->
                            <div class="govuk-form-group d-flex align-items-start mb-2 margin_left_5">
                                <label asp-for="ContractNumber" class="govuk-label label_width mb-0 pt-1">Contract Number:</label>
                                <div>                                    

                                    <input asp-for="ContractNumber" class="govuk-input width-200 margin_left_5">
                                    <span asp-validation-for="ContractNumber" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Title -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label asp-for="ProjectTitle" class="govuk-label label_width mb-0 pt-1">Title:</label>
                                <div class="margin_left_5" style="width: 61%;">
                                    <textarea asp-for="ProjectTitle" class="govuk-textarea w-100 sup_margin_0 margin_left_5"></textarea>
                                    <span asp-validation-for="ProjectTitle" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Year Type (Financialyears) + Programme -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                        <label asp-for="FinancialYears" class="govuk-label label_width mb-0 pt-1">Year Type:</label>
                                        <div class="me-4 margin_left_5">
                                            <select asp-for="FinancialYears" asp-items="Model.AvailableFinancialYears" class="govuk-select width-200 margin_left_5"></select>
                                            <span asp-validation-for="FinancialYears" class="govuk-error-message"></span>
                                        </div>
                                <label asp-for="Programme" class="govuk-label label_width mb-0 pt-1">Programme:</label>
                                <div>
                                    <select asp-for="Programme" asp-items="Model.AvailablePrograms" class="govuk-select width-200 margin_left_5 ">
                                                <option value="">Select Programme</option>
                                    </select>
                                    <span asp-validation-for="Programme" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Customer Name + Disease -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label asp-for="CustomerName" class="govuk-label label_width mb-0 pt-1">Customer Name:</label>
                                <div class="me-4">
                                    <select asp-for="CustomerName" asp-items="Model.AvailableCustomers" class="govuk-select width-200 margin_left_5">
                                                <option value="">Select Customer</option>
                                    </select>
                                    <span asp-validation-for="CustomerName" class="govuk-error-message"></span>
                                </div>
                                <label asp-for="Disease" class="govuk-label label_width mb-0 pt-1">Disease:</label>
                                <div>
                                            <select asp-for="Disease" asp-items="Model.AvailableDiseases" class="govuk-select width-200 margin_left_5">
                                                <option value="">Select Disease</option>
                                            </select>
                                            <span asp-validation-for="Disease" class="govuk-error-message"></span>
                                    
                                </div>
                            </div>

                            <!-- Start Date + Is Defra Project -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label for="StartdateDisplay" class="govuk-label label_width mb-0 pt-1">Start Date:</label>
                                <div class="me-4">
                                    <div class="margin_left_5" style="position:relative; display:inline-block;">
                                        <input type="text"
                                               id="StartdateDisplay"
                                               class="govuk-input width-200 "
                                               value="@Model.StartDate?.ToString("dd/MM/yyyy")"
                                               autocomplete="off"
                                               onclick="openDatePicker('StartdatePicker')"
                                               style="cursor:pointer;"
                                               readonly>
                                        <input type="hidden"
                                               name="Startdate"
                                               id="StartdateBinding"
                                               value="@Model.StartDate?.ToString("yyyy-MM-dd")">
                                        <input type="date"
                                               id="StartdatePicker"
                                               value="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                               style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                               onchange="syncDateToText('StartdatePicker', 'StartdateDisplay', 'StartdateBinding')">
                                    </div>
                                    <span asp-validation-for="StartDate" class="govuk-error-message"></span>
                                </div>
                                        <label asp-for="IsDefraProject" class="govuk-label label_width mb-0 pt-1">Is Defra Project?:</label>
                                <div class="d-flex align-items-center gap-2 margin_left_5">
                                            <select asp-for="IsDefraProject" asp-items="Model.AvailableDefraProjectOptions" class="govuk-select" style="min-width: 80px;"></select>
                                            <span class="warning-text" style="font-size:13px; width:217px; color:#353535; border:1px dashed #0d6efd; border-radius:4px; padding:2px;">
                                                Changing this option will recost existing projects with current rates.
                                            </span>
                                            <span asp-validation-for="IsDefraProject" class="govuk-error-message"></span>
                                        </div>
                            </div>

                            <!-- Start Financial Year (readonly) + Rate Used -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label asp-for="StartFYear" class="govuk-label label_width mb-0 pt-1">Start (Financial) Year:</label>
                                <div class="me-4">
                                    <input asp-for="StartFYear" asp-format="{0:0}" class="govuk-input width-200 margin_left_5 read-only" readonly>
                                    <span asp-validation-for="StartFYear" class="govuk-error-message"></span>
                                </div>
                                <label asp-for="Euroconvrate" class="govuk-label label_width mb-0 pt-1">Rate Used (£):</label>
                                <div>
                                    <input asp-for="Euroconvrate" class="govuk-input width-200 margin_left_5">
                                    <span asp-validation-for="Euroconvrate" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Submitted By Firstname + Prepared By -->
                            <div class="govuk-form-group d-flex align-items-start mb-2" >
                                                <label asp-for="SubmittedByFName" class="govuk-label label_width mb-0 pt-1" style="overflow-wrap: break-word; margin-left: -16px;">Submitted By - Firstname:</label>
                                <div class="me-4">
                                    <input asp-for="SubmittedByFName" class="govuk-input width-200 margin_left_5">
                                                        <span asp-validation-for="SubmittedByFName" class="govuk-error-message"></span>
                                </div>
                                <label asp-for="PreparedBy" class="govuk-label label_width mb-0 pt-1">Prepared by:</label>
                                <div>
                                    <select asp-for="PreparedBy" asp-items="Model.AvailableStaff" class="govuk-select inline-select" >
                                                            <option value="">Select PreparedBy </option>
                                    </select>
                                    <span asp-validation-for="PreparedBy" class="govuk-error-message"></span>
                                </div>
                            </div>

                            @* FIX 3: removed invalid {{!-- --}} Handlebars comment — not valid Razor syntax *@
                            <!-- Submitted By Lastname + Include Inflation -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                                    <label asp-for="SubmittedByLName" class="govuk-label label_width mb-0 pt-1">Lastname:</label>
                                <div class="me-4">
                                    <input asp-for="SubmittedByLName" class="govuk-input width-200 margin_left_5">
                                                            <span asp-validation-for="SubmittedByLName" class="govuk-error-message"></span>
                                </div>
                                <label for="chkInflation" class="govuk-label label_width mb-0 pt-1">Include Inflation?:</label>
                                <div class="d-flex align-items-center gap-2 margin_left_5">
                      
                                    <div class="govuk-checkboxes govuk-checkboxes--small">
                                        <div class="govuk-checkboxes__item">
                                            <input type="checkbox"
                                                   id="chkInflation"
                                                   name="Inflation"
                                                   value="-1"
                                                   class="govuk-checkboxes__input"
                                            @(Model.Inflation.HasValue && Model.Inflation.Value == -1 ? "checked=\"checked\"" : "") />
                                            <label class="govuk-checkboxes__label" for="chkInflation"></label>
                                        </div>
                                    </div>
                                    <span class="warning-text" style="font-size:13px; width:286px; color:#353535; border:1px dashed #0d6efd; border-radius:4px; padding:2px;">
                                        Changing this option will recost existing projects with current rates as well as affecting inflation.
                                    </span>
                                </div>
                            </div>

                            <!-- Date of Submission -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label for="DateOfSubmissionDisplay" class="govuk-label label_width mb-0 pt-1">Date of Submission:</label>
                                <div>
                                    <div style="position:relative; display:inline-block; ">
                                        <input type="text"
                                               id="DateOfSubmissionDisplay"
                                               class="govuk-input width-200 margin_left_5"
                                               value="@Model.DateOfSubmission?.ToString("dd/MM/yyyy")"
                                               autocomplete="off"
                                               onclick="openDatePicker('DateOfSubmissionPicker')"
                                               style="cursor:pointer;"
                                               readonly>
                                        <input type="hidden"
                                               name="DateOfSubmission"
                                               id="DateOfSubmissionBinding"
                                               value="@Model.DateOfSubmission?.ToString("yyyy-MM-dd")">
                                        <input type="date"
                                               id="DateOfSubmissionPicker"
                                               value="@Model.DateOfSubmission?.ToString("yyyy-MM-dd")"
                                               style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                               onchange="syncDateToText('DateOfSubmissionPicker', 'DateOfSubmissionDisplay', 'DateOfSubmissionBinding')">
                                    </div>
                                    <span asp-validation-for="DateOfSubmission" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Notes -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label asp-for="Notes" class="govuk-label label_width mb-0 pt-1">Notes:</label>
                                <div style="width: 61%;">
                                    <textarea asp-for="Notes" class="govuk-textarea w-100 margin_left_5"></textarea>
                                    <span asp-validation-for="Notes" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Save / Cancel -->
                            <div class="action-buttons edit-action-buttons">
                                <button type="submit" class="govuk-button">Save</button>
                                <a asp-area="CostBook" asp-controller="Projects" asp-action="Index" class="govuk-button govuk-button--secondary">Cancel</a>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
         $(document).ready(function () {
            @if (TempData["Success"] != null)
            {
                <text>showGovukAlert('@Html.Raw(TempData["Success"])');</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>showGovukAlert('@Html.Raw(TempData["Error"])');</text>
            }

        });

        function confirmDelete() {
                                    showGovukConfirm('This will delete all details for this project.  Are you sure?').then(function (result) {
                if (!result) return;

                document.body.style.cursor = 'wait';
                var deleteBtn = event.target;
                if (deleteBtn) { deleteBtn.disabled = true; deleteBtn.textContent = 'Deleting...'; }

                var projectId = '@Html.Raw(Model.ProjectId)';
                if (!projectId || projectId === '') {
                    showGovukAlert('Project ID is missing. Cannot delete project.');
                    if (deleteBtn) { deleteBtn.disabled = false; deleteBtn.textContent = 'Delete'; }
                    document.body.style.cursor = 'default';
                    return;
                }

                $.ajax({
                    url: '@Url.Action("Delete", "Projects", new { area = "CostBook" })' + '/' + encodeURIComponent(projectId),
                    type: 'POST',
                    data: {
                        id: projectId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            showGovukAlert('Project deleted successfully.').then(function () {
                                window.location.href = '@Url.Action("Index", "Projects", new { area = "CostBook" })';
                            });
                        } else {
                            showGovukAlert('Failed to delete project: ' + (response.message || 'Unknown error'));
                            if (deleteBtn) { deleteBtn.disabled = false; deleteBtn.textContent = 'Delete'; }
                            document.body.style.cursor = 'default';
                        }
                    },
                    error: function () {
                        showGovukAlert('An error occurred while deleting the project.');
                        if (deleteBtn) { deleteBtn.disabled = false; deleteBtn.textContent = 'Delete'; }
                        document.body.style.cursor = 'default';
                    }
                });
            });
        }

        function copyProject() {
        var projectId = '@Html.Raw(Model.ProjectId)';
        showGovukConfirm('Copy project "' + projectId + '"?').then(function (result) {
            if (!result) return;

            var copyBtn = event.target;
            if (copyBtn) { copyBtn.disabled = true; copyBtn.textContent = 'Copying...'; }

            $.ajax({
                url: '@Url.Action("Copy", "Projects", new { area = "CostBook" })',
                type: 'POST',
                data: {
                    sourceProjectId: projectId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (data) {
                    if (data.success) {
                        var newId = data.generatedId || data.projectId;

                        // Ask user if they want to recost the project
                        showGovukConfirm('Do you want to recost this project at todays rates, (including inflation if specified)?').then(function (recostResult) {
                            if (recostResult) {
                                // Call Recost method
                                if (copyBtn) { copyBtn.textContent = 'Recosting...'; }

                                $.ajax({
                                    url: '@Url.Action("Recost", "Projects", new { area = "CostBook" })',
                                    type: 'POST',
                                    data: {
                                        id: newId,
                                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                                    },
                                    success: function (recostData) {
                                        if (recostData.success) {
                                            // Navigate to edit page after successful recost
                                            var editUrl = '@Url.Action("Edit", "Projects", new { area = "CostBook", id = "PLACEHOLDER" })';
                                            editUrl = editUrl.replace('PLACEHOLDER', encodeURIComponent(newId));
                                            window.location.href = editUrl;
                                        } else {
                                            showGovukAlert('Failed to recost project. Redirecting to edit page.').then(function () {
                                                var editUrl = '@Url.Action("Edit", "Projects", new { area = "CostBook", id = "PLACEHOLDER" })';
                                                editUrl = editUrl.replace('PLACEHOLDER', encodeURIComponent(newId));
                                                window.location.href = editUrl;
                                            });
                                        }
                                    },
                                    error: function () {
                                        showGovukAlert('Error occurred during recost. Redirecting to edit page.').then(function () {
                                            var editUrl = '@Url.Action("Edit", "Projects", new { area = "CostBook", id = "PLACEHOLDER" })';
                                            editUrl = editUrl.replace('PLACEHOLDER', encodeURIComponent(newId));
                                            window.location.href = editUrl;
                                        });
                                    }
                                });
                            } else {
                                // User chose not to recost, navigate directly to edit page
                                var editUrl = '@Url.Action("Edit", "Projects", new { area = "CostBook", id = "PLACEHOLDER" })';
                                editUrl = editUrl.replace('PLACEHOLDER', encodeURIComponent(newId));
                                window.location.href = editUrl;
                            }
                        });
                    } else {
                        showGovukAlert('Failed to copy project: ' + (data.errors ? data.errors.join(', ') : 'Unknown error'));
                        if (copyBtn) { copyBtn.disabled = false; copyBtn.textContent = 'Copy'; }
                    }
                },
                error: function () {
                    showGovukAlert('Failed to copy project. Please try again.');
                    if (copyBtn) { copyBtn.disabled = false; copyBtn.textContent = 'Copy'; }
                }
            });
        });
        }
    </script>
    }