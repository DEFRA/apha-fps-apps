@model Apha.FPSApps.Web.Areas.CostBook.Models.ProjectCreateEditViewModel

@{
    ViewData["Title"] = "Add Project";
}

<script>
    function openDatePicker(pickerId) {
        var picker = document.getElementById(pickerId);
        if (picker) {
            try { picker.showPicker(); } catch (e) { picker.click(); }
        }
    }

    function syncDateToText(pickerId, displayId, hiddenId) {
        var picker = document.getElementById(pickerId);
        if (picker.value) {
            var parts = picker.value.split('-');
            document.getElementById(displayId).value = parts[2] + '/' + parts[1] + '/' + parts[0];
            document.getElementById(hiddenId).value = picker.value;
        } else {
            document.getElementById(displayId).value = '';
            document.getElementById(hiddenId).value = '';
        }
    }
</script>

<div class="container-fluid costbook-edit-page">
    <div class="row">
        <div>
            <div class="govuk-grid-row sup_border-bottom sup_margin_bottom_0">
                <div class="govuk-grid-column-full">
                    <h1 class="govuk-heading-s" style="padding-top: 10px">
                        Project Selection
                        <a asp-area="CostBook" asp-controller="Projects" asp-action="Index" class="govuk-back-link sup_align_right">Back</a>
                    </h1>
                </div>
            </div>
        </div>

        <div>
            <div class="main-content" style="padding-top: 0px;">
                <div class="sup_margin_top_10">
                    <form asp-area="CostBook" asp-controller="Projects" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" data-module="govuk-error-summary">
                                <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
                            </div>
                        }

                        <div class="edit-form-container">

                            <!-- Costing Book Code (auto-generated on save, display-only) -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label class="govuk-label label_width mb-0 pt-1">Costing Book Code:</label>
                                <div>
                                    <input type="text"
                                           class="govuk-input width-200 read-only margin_left_5"
                                           value="@Model.ProjectId"
                                           placeholder=""
                                           readonly
                                           tabindex="-1">
                                </div>
                            </div>

                            <!-- Contract Number -->
                            <div class="govuk-form-group d-flex align-items-start mb-2 margin_left_5">
                                <label asp-for="ContractNumber" class="govuk-label label_width mb-0 pt-1">Contract Number:</label>
                                <div>
                                    <input asp-for="ContractNumber" class="govuk-input width-200 margin_left_5">
                                    <span asp-validation-for="ContractNumber" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Title -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label asp-for="ProjectTitle" class="govuk-label label_width mb-0 pt-1">
                                    Title:<span class="sup_color_red">*</span>
                                </label>
                                <div style="width: 61%; margin_left_5">
                                    <textarea asp-for="ProjectTitle"
                                              class="govuk-textarea w-100 sup_margin_0 margin_left_5"
                                              required></textarea>
                                    <span asp-validation-for="ProjectTitle" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Year Type + Programme -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label asp-for="FinancialYears" class="govuk-label label_width mb-0 pt-1">Year Type:</label>
                                <div class="me-4 margin_left_5">
                                    <select asp-for="FinancialYears" asp-items="Model.AvailableFinancialYears" class="govuk-select width-200 margin_left_5"></select>
                                    <span asp-validation-for="FinancialYears" class="govuk-error-message"></span>
                                </div>
                                <label asp-for="Programme" class="govuk-label label_width mb-0 pt-1">Programme:</label>
                                <div>
                                    <select asp-for="Programme" asp-items="Model.AvailablePrograms" class="govuk-select width-200 margin_left_5"><option value="">Select Programme</option></select>
                                    <span asp-validation-for="Programme" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Customer Name + Disease -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label asp-for="CustomerName" class="govuk-label label_width mb-0 pt-1">Customer Name:</label>
                                <div class="me-4">
                                    <select asp-for="CustomerName" asp-items="Model.AvailableCustomers" class="govuk-select width-200 margin_left_5"><option value="">Select Customer</option></select>
                                    <span asp-validation-for="CustomerName" class="govuk-error-message"></span>
                                </div>
                                <label asp-for="Disease" class="govuk-label label_width mb-0 pt-1">Disease:</label>
                                <div>
                                    <select asp-for="Disease" asp-items="Model.AvailableDiseases" class="govuk-select width-200 margin_left_5"><option value="">Select Disease</option></select>
                                    <span asp-validation-for="Disease" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Start Date + Is Defra Project -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label for="StartdateDisplay" class="govuk-label label_width mb-0 pt-1">
                                    Start Date:<span class="sup_color_red">*</span>
                                </label>
                                <div class="me-4">
                                    <div style="position:relative; display:inline-block; margin_left_5">
                                        <input type="text"
                                               id="StartdateDisplay"
                                               class="govuk-input width-200"
                                               value="@Model.StartDate?.ToString("dd/MM/yyyy")"
                                               autocomplete="off"
                                               onclick="openDatePicker('StartdatePicker')"
                                               style="cursor:pointer;"
                                               readonly>
                                        <input type="hidden"
                                               name="StartDate"
                                               id="StartdateBinding"
                                               value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : string.Empty)">
                                        <input type="date"
                                               id="StartdatePicker"
                                               value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-dd") : string.Empty)"
                                               style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                               onchange="syncDateToText('StartdatePicker', 'StartdateDisplay', 'StartdateBinding')">
                                    </div>
                                    <span asp-validation-for="StartDate" class="govuk-error-message"></span>
                                </div>
                                <label asp-for="IsDefraProject" class="govuk-label label_width mb-0 pt-1">
                                    Is Defra Project?:<span class="sup_color_red">*</span>
                                </label>
                                <div class="d-flex align-items-center gap-2 margin_left_5">
                                    <select asp-for="IsDefraProject"
                                            asp-items="Model.AvailableDefraProjectOptions"
                                            class="govuk-select">
                                        <option value="">Select IsDefraProject </option>
                                    </select>
                                    <span class="warning-text" style="font-size:13px; width:217px; color:#353535; border:1px dashed #0d6efd; border-radius:4px; padding:2px;">
                                        Changing this option will recost existing projects with current rates.
                                    </span>
                                    <span asp-validation-for="IsDefraProject" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Start Financial Year (readonly, calculated) + Rate Used -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label asp-for="StartFYear" class="govuk-label label_width mb-0 pt-1">Start (Financial) Year:</label>
                                <div class="me-4">
                                    <input asp-for="StartFYear" asp-format="{0:0}" class="govuk-input width-200 margin_left_5 read-only" readonly>
                                    <span asp-validation-for="StartFYear" class="govuk-error-message"></span>
                                </div>
                                <label asp-for="Euroconvrate" class="govuk-label label_width mb-0 pt-1">Rate Used (£):</label>
                                <div>
                                    <input asp-for="Euroconvrate" class="govuk-input width-200 margin_left_5">
                                    <span asp-validation-for="Euroconvrate" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Submitted By Firstname + Prepared By -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label asp-for="SubmittedByFName" class="govuk-label label_width mb-0 pt-1" style="overflow-wrap: break-word; margin-left: -16px;">Submitted By - Firstname:</label>
                                <div class="me-4">
                                    <input asp-for="SubmittedByFName" class="govuk-input width-200 margin_left_5">
                                    <span asp-validation-for="SubmittedByFName" class="govuk-error-message"></span>
                                </div>
                                <label asp-for="PreparedBy" class="govuk-label label_width mb-0 pt-1">Prepared by:</label>
                                <div>
                                    <select asp-for="PreparedBy" asp-items="Model.AvailableStaff" class="govuk-select inline-select"><option value="">Select PreparedBy </option></select>
                                    <span asp-validation-for="PreparedBy" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Submitted By Lastname + Include Inflation -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label asp-for="SubmittedByLName" class="govuk-label label_width mb-0 pt-1">Lastname:</label>
                                <div class="me-4">
                                    <input asp-for="SubmittedByLName" class="govuk-input width-200 margin_left_5">
                                    <span asp-validation-for="SubmittedByLName" class="govuk-error-message"></span>
                                </div>
                                <label for="chkInflation" class="govuk-label label_width mb-0 pt-1">Include Inflation?:</label>
                                <div class="d-flex align-items-center gap-2 margin_left_5">
                                    <div class="govuk-checkboxes govuk-checkboxes--small">
                                        <div class="govuk-checkboxes__item">
                                            <input type="checkbox"
                                                   id="chkInflation"
                                                   name="Inflation"
                                                   value="-1"
                                                   class="govuk-checkboxes__input"
                                            @(Model.Inflation.HasValue && Model.Inflation.Value == -1 ? "checked=\"checked\"" : "") />
                                            <label class="govuk-checkboxes__label" for="chkInflation"></label>
                                        </div>
                                    </div>
                                    <span class="warning-text" style="font-size:13px; width:286px; color:#353535; border:1px dashed #0d6efd; border-radius:4px; padding:2px;">
                                        Changing this option will recost existing projects with current rates as well as affecting inflation.
                                    </span>
                                </div>
                            </div>

                            <!-- Date of Submission -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label for="DateOfSubmissionDisplay" class="govuk-label label_width mb-0 pt-1">Date of Submission:</label>
                                <div>
                                    <div style="position:relative; display:inline-block;">
                                        <input type="text"
                                               id="DateOfSubmissionDisplay"
                                               class="govuk-input width-200 margin_left_5"
                                               value="@Model.DateOfSubmission?.ToString("dd/MM/yyyy")"
                                               autocomplete="off"
                                               onclick="openDatePicker('DateOfSubmissionPicker')"
                                               style="cursor:pointer;"
                                               readonly>
                                        <input type="hidden"
                                               name="DateOfSubmission"
                                               id="DateOfSubmissionBinding"
                                               value="@Model.DateOfSubmission?.ToString("yyyy-MM-dd")">
                                        <input type="date"
                                               id="DateOfSubmissionPicker"
                                               value="@Model.DateOfSubmission?.ToString("yyyy-MM-dd")"
                                               style="position:absolute; top:0; left:0; opacity:0; width:1px; height:1px; pointer-events:auto;"
                                               onchange="syncDateToText('DateOfSubmissionPicker', 'DateOfSubmissionDisplay', 'DateOfSubmissionBinding')">
                                    </div>
                                    <span asp-validation-for="DateOfSubmission" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Notes -->
                            <div class="govuk-form-group d-flex align-items-start mb-2">
                                <label asp-for="Notes" class="govuk-label label_width mb-0 pt-1">Notes:</label>
                                <div style="width: 61%;">
                                    <textarea asp-for="Notes" class="govuk-textarea w-100 margin_left_5"></textarea>
                                    <span asp-validation-for="Notes" class="govuk-error-message"></span>
                                </div>
                            </div>

                            <!-- Save / Cancel -->
                            <div class="action-buttons edit-action-buttons">
                                <button type="submit" class="govuk-button">Save</button>
                                <a asp-area="CostBook" asp-controller="Projects" asp-action="Index" class="govuk-button govuk-button--secondary">Cancel</a>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {    
    <script>
        $(document).ready(function () {
            @if (TempData["Success"] != null)
            {
                <text>showGovukAlert('@Html.Raw(TempData["Success"])');</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>showGovukAlert('@Html.Raw(TempData["Error"])');</text>
            }

            // ── Client-side validation for StartDate (custom date picker) ─────
            // jQuery Validate ignores hidden inputs by default, so intercept submit
            $('form').on('submit', function (e) {
                var $startBinding = $('#StartdateBinding');
                var $startMsg = $('[data-valmsg-for="StartDate"]');
                var $startDisplay = $('#StartdateDisplay');
                var $startFg = $startDisplay.closest('.govuk-form-group');

                if (!$startBinding.val()) {
                    e.preventDefault();
                    $startFg.addClass('govuk-form-group--error');
                    $startDisplay.addClass('govuk-input--error');
                    $startMsg.text('Please enter Start Date')
                             .removeClass('field-validation-valid')
                             .addClass('field-validation-error')
                             .show();
                }

                // Clear StartDate error as soon as a date is picked
                $('#StartdatePicker').off('change.startval').on('change.startval', function () {
                    $startFg.removeClass('govuk-form-group--error');
                    $startDisplay.removeClass('govuk-input--error');
                    $startMsg.text('')
                             .removeClass('field-validation-error')
                             .addClass('field-validation-valid')
                             .hide();
                });
            });
        });

        function getAntiForgeryToken() {
            return $('input[name="__RequestVerificationToken"]').val();
        }
    </script>
}