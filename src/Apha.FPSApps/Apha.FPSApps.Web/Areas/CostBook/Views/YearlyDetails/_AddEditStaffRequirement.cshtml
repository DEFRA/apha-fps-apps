@using Microsoft.AspNetCore.Mvc.Rendering
@using Apha.FPSApps.Application.Dtos.CostBook
@model Apha.FPSApps.Web.Areas.CostBook.Models.StaffRequirementItem

@{
    var payRates = ViewBag.PayRates as List<PayRateDto> ?? new List<PayRateDto>();
}

<div class="modal-header">
    <h5 class="modal-title">@(Model.SrIdentity == 0 ? "Add" : "Edit") Staff Requirement</h5>
    <button type="button" class="close project-close-btn" aria-label="Close" onclick="closeModal()">×</button>
</div>
<div class="modal-body">
    <form id="staffRequirementForm">
        @Html.AntiForgeryToken()
        <input asp-for="SrIdentity" type="hidden" />
        <input asp-for="Payrate" type="hidden" />
        <input asp-for="Npr" type="hidden" />
        <input asp-for="Ohr" type="hidden" />
        <div class="govuk-error-summary" role="alert"
             aria-labelledby="staffFormErrorTitle" tabindex="-1" style="display: none;">
            <h2 class="govuk-error-summary__title" id="staffFormErrorTitle"></h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"></ul>
            </div>
        </div>
        <div class="govuk-form-group govuk-!-margin-bottom-4">
            <label asp-for="WgGrade" class="govuk-label">
                WG Grade <span class="sup_color_red">*</span>
            </label>
            <select asp-for="WgGrade"
                    class="govuk-select" required style="width: stretch; font-family: monospace;">
                <option value="">-- Select Grade --</option>
                @foreach (var p in payRates)
                {
                    var displayText = $"{p.WgGrade} | Rate: {p.ChargeRate?.ToString("F2") ?? "N/A"} ";
                    <option value="@p.WgGrade"
                            data-chargerate="@(p.ChargeRate?.ToString("F2") ?? "")"
                            data-payrate="@(p.PayRate?.ToString("F2") ?? "")"
                            data-npr="@(p.Npr?.ToString("F2") ?? "")"
                            data-ohr="@(p.Ohr?.ToString("F2") ?? "")"
                            selected="@(Model.WgGrade == p.WgGrade ? "selected" : null)">@displayText</option>
                }
            </select>
            <span asp-validation-for="WgGrade" class="govuk-error-message" style="display:none;"></span>
        </div>
        <div class="govuk-form-group govuk-!-margin-bottom-4">
            <label asp-for="Name" class="govuk-label">
                Name <span class="sup_color_red">*</span>
            </label>
            <input asp-for="Name" type="text" class="govuk-input" required />
            <span asp-validation-for="Name" class="govuk-error-message" style="display:none;"></span>
        </div>
        <div class="govuk-form-group govuk-!-margin-bottom-4">
            <label asp-for="Nohours" class="govuk-label">
                Hrs <span class="sup_color_red">*</span>
            </label>
            <input asp-for="Nohours" type="number" step="0.01" class="govuk-input" required />
            <span asp-validation-for="Nohours" class="govuk-error-message" style="display:none;"></span>
        </div>
        <div class="govuk-form-group govuk-!-margin-bottom-4">
            <label asp-for="Nodays" class="govuk-label">
                Days <span class="sup_color_red">*</span>
            </label>
            <input asp-for="Nodays" type="number" step="0.01" class="govuk-input" required />
            <span asp-validation-for="Nodays" class="govuk-error-message" style="display:none;"></span>
        </div>
        <div class="govuk-form-group govuk-!-margin-bottom-4">
            <label asp-for="Chargerate" class="govuk-label">
                Rate <span class="sup_color_red">*</span>
            </label>
            <input asp-for="Chargerate" type="text" readonly class="govuk-input" />
            <span asp-validation-for="Chargerate" class="govuk-error-message" style="display:none;"></span>
        </div>
        <div class="govuk-form-group govuk-!-margin-bottom-4">
            <label asp-for="StaffCost" class="govuk-label">
                Cost <span class="sup_color_red">*</span>
            </label>
            <input asp-for="StaffCost" type="text" readonly class="govuk-input" />
            <span asp-validation-for="StaffCost" class="govuk-error-message" style="display:none;"></span>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="govuk-button govuk-button--secondary sup_margin_0" onclick="closeModal()">Cancel</button>
    <button type="button" class="govuk-button sup_margin_0" onclick="saveStaff()">
        @(Model.SrIdentity == 0 ? "Save" : "Update")
    </button>
</div>
