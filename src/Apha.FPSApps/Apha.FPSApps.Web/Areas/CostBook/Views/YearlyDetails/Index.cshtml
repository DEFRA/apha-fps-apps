@model Apha.FPSApps.Web.Areas.CostBook.Models.YearlyDetailsViewModel
@{
    ViewData["Title"] = "Project Requirements";
    var projectId = Model.Code;
    var selectedYear = Model.SelectedYear;
    var isDefra = Model.IsDefraProject == 1;
}

<div class="govuk-grid-row sup_margin_left_right_0 govuk-!-margin-top-2">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-grid-row govuk-heading-s sup_border-bottom" style="padding:10px 0 0px 10px">
            Project Requirements
            <a asp-area="CostBook" asp-controller="Projects" asp-action="Index" class="govuk-back-link sup_align_right">Back</a>
        </h1>
    </div>
</div>

<div class="govuk-grid-row sup_margin_left_right_0 govuk-!-margin-top-2">
    <div class="govuk-grid-column-full">
        <div class="row">
            <div class="container project-layout-container">
                <div class="project-layout-row">

                    <!-- Side navigation -->
                    <nav class="sidenav flex-column flex-shrink-0" id="shortnav">
                        <button class="toggle-btn project-toggle-btn" onclick="toggleSidebar()" aria-label="Toggle side navigation">
                            <img src="~/images/chevron-left-solid-full.svg" alt="side nav menu arrow" width="24">
                        </button>
                        <ul>
                            <li><a class="dropdown-item sidenav-title">Reports</a></li>
                            <li><a class="dropdown-item" href="#">Summary Report</a></li>
                            <li><a class="dropdown-item" href="#">Detail Report</a></li>
                            <li><a class="dropdown-item" href="#">SID3 Staff Effort</a></li>
                            <li><a class="dropdown-item sidenav-title">Queries</a></li>
                            <li><a class="dropdown-item" asp-area="CostBook" asp-controller="Projects" asp-action="ProjectCostsQuery" asp-route-projectId="@projectId">Project Cost Queries</a></li>
                            <li><a class="dropdown-item" asp-area="CostBook" asp-controller="Projects" asp-action="Csg7StaffYears" asp-route-projectId="@projectId">CSG7 Staff Years</a></li>
                            <li><a class="dropdown-item" asp-area="CostBook" asp-controller="Projects" asp-action="StaffEffort" asp-route-projectId="@projectId">SID3 Staff Effort</a></li>
                            <li><a class="dropdown-item" asp-area="CostBook" asp-controller="Projects" asp-action="ProjectSummary" asp-route-projectId="@projectId">Project Summary</a></li>
                            <li><a class="dropdown-item" href="#">Excel Report</a></li>
                        </ul>
                    </nav>

                    <!-- Main content -->
                    <div class="project-main-column">

                        <!-- Header summary bar (read-only) -->
                        <footer class="financial-summary project-financial-summary">
                            <div class="summary-row project-summary-row">
                                <div class="summary-item d-flex">
                                    <label class="text-AlignRight govuk-label" for="summary-code">Code:</label>
                                    <input asp-for="Code" id="summary-code" type="text" readonly class="govuk-input">
                                </div>
                                <div class="summary-item d-flex">
                                    <label class="text-AlignRight govuk-label" for="summary-year-type">Year Type:</label>
                                    <select asp-for="FinancialYears" id="summary-year-type" class="govuk-select" disabled>
                                        <option value="-1">Financial Years</option>
                                        <option value="0">Project Years</option>
                                    </select>
                                </div>
                                <div class="summary-item d-flex">
                                    <label class="govuk-label text-AlignRight" for="summary-start-date">Start Date:</label>
                                    <input asp-for="StartDate" id="summary-start-date" type="text" readonly class="govuk-input">
                                </div>
                                <div class="summary-item d-flex ms-3">
                                    <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                                        <div class="govuk-checkboxes__item">
                                            <input id="summary-inflation" type="checkbox" class="govuk-checkboxes__input" disabled @(Model.Inflation == 1 ? "checked" : null)>
                                            <label class="govuk-label govuk-checkboxes__label" for="summary-inflation">Inflation?</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="summary-item d-flex project-summary-flag">
                                    <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                                        <div class="govuk-checkboxes__item">
                                            <input id="summary-defra" type="checkbox" class="govuk-checkboxes__input" disabled @(Model.IsDefraProject == 1 ? "checked" : null)>
                                            <label class="govuk-label govuk-checkboxes__label" for="summary-defra">Defra?</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="summary-row project-summary-row">
                                <div class="summary-item d-flex">
                                    <label class="text-AlignRight govuk-label" for="summary-title">Title:</label>
                                    <input asp-for="ProjectTitle" id="summary-title" type="text" readonly class="govuk-input">
                                </div>
                                <div class="summary-item d-flex">
                                    <label class="govuk-label text-AlignRight" for="summary-year">Year:</label>
                                    <input asp-for="SelectedYear" id="summary-year" type="text" readonly class="govuk-input">
                                </div>
                                <div class="summary-item d-flex">
                                    <label class="govuk-label text-AlignRight" for="summary-rate-used">Rate Used (£):</label>
                                    <input asp-for="EuroConvRate" id="summary-rate-used" type="text" readonly class="govuk-input">
                                </div>
                            </div>
                        </footer>

                        <!-- Year costs shell -->
                        <div class="project-year-costs-shell">
                            <div class="form-header project-year-costs-header">
                                <h3 class="govuk-heading-s">@selectedYear Year Costs</h3>
                            </div>

                            <div class="content-area">
                                <div class="user-grid-section project-year-grid">

                                    <!-- Year list (fsubProjectYear navigation) -->
                                    <div class="col-3 project-year-list">
                                        <label class="govuk-label">Project Years</label>
                                        <ul id="projectYearList" class="list-group project-year-nav">
                                            @foreach (var yr in Model.ProjectYears)
                                            {
                                                <li class="list-group-item @(yr == selectedYear ? "active" : "")"
                                                    onclick="selectYear('@projectId', @yr)"
                                                    data-year="@yr">@yr</li>
                                            }
                                        </ul>
                                        <button class="govuk-button govuk-button--secondary govuk-!-margin-top-2"
                                                onclick="addProjectYear('@projectId')"
                                                aria-label="Add new year">
                                            Add New Year
                                        </button>
                                    </div>

                                    <!-- Tab panels -->
                                    <div class="permissions-section">
                                        <div class="govuk-tabs" data-module="govuk-tabs">
                                            <ul class="govuk-tabs__list">
                                                <li class="govuk-tabs__list-item govuk-tabs__list-item--selected">
                                                    <a class="govuk-tabs__tab" href="#Staff-tab">Staff</a>
                                                </li>
                                                <li class="govuk-tabs__list-item">
                                                    <a class="govuk-tabs__tab" href="#Tests-tab">Tests</a>
                                                </li>
                                                <li class="govuk-tabs__list-item">
                                                    <a class="govuk-tabs__tab" href="#Animals-tab">Animals</a>
                                                </li>
                                                <li class="govuk-tabs__list-item">
                                                    <a class="govuk-tabs__tab" href="#AdditionalCosts-tab">Additional Costs</a>
                                                </li>
                                                @if (Model.Programme == "Comm")
                                                {
                                                    <li class="govuk-tabs__list-item">
                                                        <a class="govuk-tabs__tab" href="#MarkupAndProfit-tab">Markup and Profit</a>
                                                    </li>
                                                }
                                            </ul>

                                            <!-- Staff tab -->
                                            <div class="govuk-tabs__panel" id="Staff-tab">
                                                <section class="data-section">
                                                    <div class="text-AlignRight govuk-!-margin-bottom-1">
                                                        <button class="govuk-button sup_margin_0" id="addstaffbookedBtn"
                                                                onclick="openAddStaffModal('@projectId', @selectedYear)"
                                                                aria-label="Add staff">
                                                            <img alt="plus icon" src="~/images/circle-plus-solid-full-white.svg" width="16px">&nbsp;Add
                                                        </button>
                                                    </div>
                                                    @await Html.PartialAsync("~/Views/Shared/_DataGrid.cshtml", Model.StaffGrid)
                                                    <div class="project-total-bar">
                                                        <span class="govuk-label me-2">Year Staff Cost Total:</span>
                                                        <input type="text" id="staffTotalAmount" value="@Model.StaffCostTotal.ToString("C")"
                                                               aria-label="Total Staff Cost" class="govuk-input project-total-input" readonly>
                                                    </div>
                                                </section>
                                            </div>

                                            <!-- Tests tab -->
                                            <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="Tests-tab">
                                                <section class="data-section">
                                                    <div class="text-AlignRight govuk-!-margin-bottom-1">
                                                        <button class="govuk-button sup_margin_0" id="addtestBtn"
                                                                onclick="openAddTestModal('@projectId', @selectedYear)"
                                                                aria-label="Add test">
                                                            <img alt="plus icon" src="~/images/circle-plus-solid-full-white.svg" width="16px">&nbsp;Add
                                                        </button>
                                                    </div>
                                                    @await Html.PartialAsync("~/Views/Shared/_DataGrid.cshtml", Model.TestGrid)
                                                    <div class="project-total-bar">
                                                        <span class="govuk-label me-2">Year Test Cost Total:</span>
                                                        <input type="text" id="testTotalAmount" value="@Model.TestCostTotal.ToString("C")"
                                                               aria-label="Total Test Cost" class="govuk-input project-total-input" readonly>
                                                    </div>
                                                </section>
                                            </div>

                                            <!-- Animals tab -->
                                            <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="Animals-tab">
                                                <section class="data-section">
                                                    <div class="text-AlignRight govuk-!-margin-bottom-1">
                                                        <button class="govuk-button sup_margin_0" id="addanimalBtn"
                                                                onclick="openAddAnimalModal('@projectId', @selectedYear)"
                                                                aria-label="Add animal">
                                                            <img alt="plus icon" src="~/images/circle-plus-solid-full-white.svg" width="16px">&nbsp;Add
                                                        </button>
                                                    </div>
                                                    @await Html.PartialAsync("~/Views/Shared/_DataGrid.cshtml", Model.AnimalGrid)
                                                    <div class="project-total-bar">
                                                        <span class="govuk-label me-2">Year Animal Costs Total:</span>
                                                        <input type="text" id="animalTotalAmount" value="@Model.AnimalCostTotal.ToString("C")"
                                                               aria-label="Total Animal Cost" class="govuk-input project-total-input" readonly>
                                                    </div>
                                                </section>
                                            </div>

                                            <!-- Additional Costs tab -->
                                            <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="AdditionalCosts-tab">
                                                <section class="data-section">
                                                    <div class="text-AlignRight govuk-!-margin-bottom-1">
                                                        <button class="govuk-button sup_margin_0" id="addadditionalBtn"
                                                                onclick="openAddAdditionalCostModal('@projectId', @selectedYear)"
                                                                aria-label="Add additional cost">
                                                            <img alt="plus icon" src="~/images/circle-plus-solid-full-white.svg" width="16px">&nbsp;Add
                                                        </button>
                                                    </div>
                                                    @await Html.PartialAsync("~/Views/Shared/_DataGrid.cshtml", Model.AdditionalCostGrid)
                                                    <div class="project-total-bar">
                                                        <span class="govuk-label me-2">Year Total Additional Costs:</span>
                                                        <input type="text" id="additionalTotalAmount" value="@Model.AdditionalCostTotal.ToString("C")"
                                                               aria-label="Total Additional Cost" class="govuk-input project-total-input" readonly>
                                                    </div>
                                                </section>
                                            </div>

                                            <!-- Markup and Profit tab (Commercial projects only) -->
                                            @if (Model.Programme == "Comm")
                                            {
                                                <div class="govuk-tabs__panel govuk-tabs__panel--hidden" id="MarkupAndProfit-tab">
                                                    <section class="data-section">
                                                        <table class="govuk-table fps-sr-themed-table custom-table" id="markupProfitTable">
                                                            <thead class="govuk-table__head">
                                                                <tr class="govuk-table__row">
                                                                    <th class="govuk-table__header">Year</th>
                                                                    <th class="govuk-table__header" colspan="4" style="background-color:#acc8e0">Contingency Markup %</th>
                                                                    <th class="govuk-table__header" colspan="4" style="background-color:#ffffbb">Profit Margin %</th>
                                                                    <th class="govuk-table__header">Actions</th>
                                                                </tr>
                                                                <tr class="govuk-table__row">
                                                                    <th class="govuk-table__header"></th>
                                                                    <th class="govuk-table__header" style="background-color:#acc8e0">Time</th>
                                                                    <th class="govuk-table__header" style="background-color:#acc8e0">Tests</th>
                                                                    <th class="govuk-table__header" style="background-color:#acc8e0">Animal</th>
                                                                    <th class="govuk-table__header" style="background-color:#acc8e0">Addit'al</th>
                                                                    <th class="govuk-table__header" style="background-color:#ffffbb">Time</th>
                                                                    <th class="govuk-table__header" style="background-color:#ffffbb">Tests</th>
                                                                    <th class="govuk-table__header" style="background-color:#ffffbb">Animal</th>
                                                                    <th class="govuk-table__header" style="background-color:#ffffbb">Addit'al</th>
                                                                    <th class="govuk-table__header"></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody class="govuk-table__body">
                                                                @foreach (var rate in Model.YearRates)
                                                                {
                                                                    <tr class="govuk-table__row" data-year="@rate.YearValue" data-project="@rate.Project">
                                                                        <td class="govuk-table__cell">@rate.YearValue</td>
                                                                        <td class="govuk-table__cell"><input type="number" class="govuk-input govuk-input--width-4 rate-input" name="MarkupTime" value="@rate.MarkupTime" step="0.01"></td>
                                                                        <td class="govuk-table__cell"><input type="number" class="govuk-input govuk-input--width-4 rate-input" name="MarkupTests" value="@rate.MarkupTests" step="0.01"></td>
                                                                        <td class="govuk-table__cell"><input type="number" class="govuk-input govuk-input--width-4 rate-input" name="MarkupAnimals" value="@rate.MarkupAnimals" step="0.01"></td>
                                                                        <td class="govuk-table__cell"><input type="number" class="govuk-input govuk-input--width-4 rate-input" name="MarkupAdditional" value="@rate.MarkupAdditional" step="0.01"></td>
                                                                        <td class="govuk-table__cell"><input type="number" class="govuk-input govuk-input--width-4 rate-input" name="ProfitTime" value="@rate.ProfitTime" step="0.01"></td>
                                                                        <td class="govuk-table__cell"><input type="number" class="govuk-input govuk-input--width-4 rate-input" name="ProfitTests" value="@rate.ProfitTests" step="0.01"></td>
                                                                        <td class="govuk-table__cell"><input type="number" class="govuk-input govuk-input--width-4 rate-input" name="ProfitAnimals" value="@rate.ProfitAnimals" step="0.01"></td>
                                                                        <td class="govuk-table__cell"><input type="number" class="govuk-input govuk-input--width-4 rate-input" name="ProfitAdditional" value="@rate.ProfitAdditional" step="0.01"></td>
                                                                        <td class="govuk-table__cell">
                                                                            <button class="btn btn-sm btn-outline-primary"
                                                                                    onclick="saveYearRate('@rate.Project', @rate.YearValue, this.closest('tr'))"
                                                                                    aria-label="Save rate for year @rate.YearValue">
                                                                                Save
                                                                            </button>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </section>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Year totals panel -->
                                <div class="project-year-totals-panel">
                                    <label class="govuk-label govuk-!-font-weight-bold">Year Totals:</label>
                                    <div class="totals-row">
                                        <span class="govuk-label">Staff Costs:</span>
                                        <input type="text" id="staffCostTotalDisplay" value="@Model.StaffCostTotal.ToString("C")" readonly class="govuk-input project-total-input">
                                    </div>
                                    <div class="totals-row">
                                        <span class="govuk-label">Test Costs:</span>
                                        <input type="text" id="testCostTotalDisplay" value="@Model.TestCostTotal.ToString("C")" readonly class="govuk-input project-total-input">
                                    </div>
                                    <div class="totals-row">
                                        <span class="govuk-label">Animal Costs:</span>
                                        <input type="text" id="animalCostTotalDisplay" value="@Model.AnimalCostTotal.ToString("C")" readonly class="govuk-input project-total-input">
                                    </div>
                                    <div class="totals-row">
                                        <span class="govuk-label">Additional Costs:</span>
                                        <input type="text" id="additionalCostTotalDisplay" value="@Model.AdditionalCostTotal.ToString("C")" readonly class="govuk-input project-total-input">
                                    </div>
                                    <hr>
                                    <div class="totals-row">
                                        <span class="govuk-label govuk-!-font-weight-bold">Grand Totals:</span>
                                        <input type="text" id="year-total-grand" value="@Model.GrandTotal.ToString("C")" readonly class="govuk-input project-year-total-input">
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div><!-- /.project-main-column -->
                </div><!-- /.project-layout-row -->
            </div><!-- /.container -->
        </div><!-- /.row -->
    </div>
</div>

<!-- Modal container for Add/Edit partials -->
<div id="project1ModalContainer" class="modal project-modal-hidden" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" id="project1ModalContent">
        </div>
    </div>
</div>

@section Scripts {
<script>
    const antiForgeryToken = '@Html.AntiForgeryToken()';

    function selectYear(projectId, year) {
        window.location.href = '@Url.Action("Index", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&selectedYear=' + year;
    }

    function addProjectYear(projectId) {
        const years = Array.from(document.querySelectorAll('#projectYearList li')).map(li => parseInt(li.dataset.year));
        const nextYear = years.length > 0 ? Math.max(...years) + 1 : new Date().getFullYear();
        fetch('@Url.Action("AddProjectYear", "Project1", new { area = "CostBook" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' },
            body: 'projectId=' + encodeURIComponent(projectId) + '&year=' + nextYear
        })
        .then(r => r.json())
        .then(data => { if (data.success) selectYear(projectId, data.year); });
    }

    // ── Staff ────────────────────────────────────────────────────────────
    function openAddStaffModal(projectId, year) {
        fetch('@Url.Action("CreateStaff", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year + '&isDefra=@isDefra')
            .then(r => r.text()).then(html => { document.getElementById('project1ModalContent').innerHTML = html; openModal(); });
    }
    function openEditStaffModal(projectId, year, srIdentity) {
        fetch('@Url.Action("EditStaff", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year + '&srIdentity=' + srIdentity + '&isDefra=@isDefra')
            .then(r => r.text()).then(html => { document.getElementById('project1ModalContent').innerHTML = html; openModal(); });
    }
    function deleteStaff(projectId, year, srIdentity) {
        if (!confirm('Delete this staff entry?')) return;
        fetch('@Url.Action("DeleteStaff", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year + '&srIdentity=' + srIdentity,
            { method: 'DELETE', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } })
            .then(r => r.json()).then(d => { if (d.success) selectYear(projectId, year); });
    }

    // ── Tests ────────────────────────────────────────────────────────────
    function openAddTestModal(projectId, year) {
        fetch('@Url.Action("CreateTest", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year)
            .then(r => r.text()).then(html => { document.getElementById('project1ModalContent').innerHTML = html; openModal(); });
    }
    function openEditTestModal(projectId, year, testCode) {
        fetch('@Url.Action("EditTest", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year + '&testCode=' + encodeURIComponent(testCode))
            .then(r => r.text()).then(html => { document.getElementById('project1ModalContent').innerHTML = html; openModal(); });
    }
    function deleteTest(projectId, year, testCode) {
        if (!confirm('Delete this test entry?')) return;
        fetch('@Url.Action("DeleteTest", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year + '&testCode=' + encodeURIComponent(testCode),
            { method: 'DELETE', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } })
            .then(r => r.json()).then(d => { if (d.success) selectYear(projectId, year); });
    }

    // ── Animals ──────────────────────────────────────────────────────────
    function openAddAnimalModal(projectId, year) {
        fetch('@Url.Action("CreateAnimal", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year)
            .then(r => r.text()).then(html => { document.getElementById('project1ModalContent').innerHTML = html; openModal(); });
    }
    function openEditAnimalModal(projectId, year, arIdentity) {
        fetch('@Url.Action("EditAnimal", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year + '&arIdentity=' + arIdentity)
            .then(r => r.text()).then(html => { document.getElementById('project1ModalContent').innerHTML = html; openModal(); });
    }
    function deleteAnimal(projectId, year, arIdentity) {
        if (!confirm('Delete this animal entry?')) return;
        fetch('@Url.Action("DeleteAnimal", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year + '&arIdentity=' + arIdentity,
            { method: 'DELETE', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } })
            .then(r => r.json()).then(d => { if (d.success) selectYear(projectId, year); });
    }

    // ── Additional Costs ─────────────────────────────────────────────────
    function openAddAdditionalCostModal(projectId, year) {
        fetch('@Url.Action("CreateAdditionalCost", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year)
            .then(r => r.text()).then(html => { document.getElementById('project1ModalContent').innerHTML = html; openModal(); });
    }
    function openEditAdditionalCostModal(projectId, year, acIdentity) {
        fetch('@Url.Action("EditAdditionalCost", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year + '&acIdentity=' + acIdentity)
            .then(r => r.text()).then(html => { document.getElementById('project1ModalContent').innerHTML = html; openModal(); });
    }
    function deleteAdditionalCost(projectId, year, acIdentity) {
        if (!confirm('Delete this additional cost entry?')) return;
        fetch('@Url.Action("DeleteAdditionalCost", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year + '&acIdentity=' + acIdentity,
            { method: 'DELETE', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' } })
            .then(r => r.json()).then(d => { if (d.success) selectYear(projectId, year); });
    }

    // ── Markup/Profit ─────────────────────────────────────────────────────
    function saveYearRate(projectId, year, row) {
        const data = {
            Project: projectId, YearValue: year,
            MarkupTime: row.querySelector('[name="MarkupTime"]').value,
            MarkupTests: row.querySelector('[name="MarkupTests"]').value,
            MarkupAnimals: row.querySelector('[name="MarkupAnimals"]').value,
            MarkupAdditional: row.querySelector('[name="MarkupAdditional"]').value,
            ProfitTime: row.querySelector('[name="ProfitTime"]').value,
            ProfitTests: row.querySelector('[name="ProfitTests"]').value,
            ProfitAnimals: row.querySelector('[name="ProfitAnimals"]').value,
            ProfitAdditional: row.querySelector('[name="ProfitAdditional"]').value
        };
        fetch('@Url.Action("UpdateProjectYearRate", "Project1", new { area = "CostBook" })?projectId=' + encodeURIComponent(projectId) + '&year=' + year, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' },
            body: JSON.stringify(data)
        }).then(r => r.json()).then(d => { if (!d.success) alert('Failed to save rates.'); });
    }

    function openModal() { document.getElementById('project1ModalContainer').classList.remove('project-modal-hidden'); }
    function closeModal() { document.getElementById('project1ModalContainer').classList.add('project-modal-hidden'); }
</script>
}
