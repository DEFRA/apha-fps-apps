@using Microsoft.AspNetCore.Mvc.Rendering
@model Apha.FPSApps.Web.Areas.CostBook.Models.AdditionalCostItem

<div class="modal-header">
    <h5 class="modal-title">@(Model.AcIdentity == 0 ? "Add" : "Edit") Additional Cost</h5>
    <button type="button" class="close project-close-btn" aria-label="Close" onclick="closeModal()">×</button>
</div>
<div class="modal-body">
    <form id="additionalCostForm">
        <div class="form-group mb-2">
            <label asp-for="AccountCat" class="govuk-label">Account Cat</label>
            <select asp-for="AccountCat" asp-items="@((List<SelectListItem>)ViewBag.AccountCatOptions)" class="govuk-select">
                <option value="">-- Select Account Category --</option>
            </select>
            <span asp-validation-for="AccountCat" class="govuk-error-message"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="Description" class="govuk-label">Description</label>
            <input asp-for="Description" type="text" class="govuk-input">
            <span asp-validation-for="Description" class="govuk-error-message"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="CostEntered" class="govuk-label">Cost No</label>
            <input asp-for="CostEntered" type="number" step="0.01" class="govuk-input">
        </div>
        <div class="form-group mb-2">
            <label asp-for="ItemCost" class="govuk-label">Cost(inf)</label>
            <input asp-for="ItemCost" type="text" readonly class="govuk-input">
        </div>
        <input asp-for="AcIdentity" type="hidden">
        <button type="submit" class="govuk-button">Save</button>
        <button type="button" class="govuk-button govuk-button--secondary sup_margin_0" onclick="closeModal()">Cancel</button>
    </form>
</div>
