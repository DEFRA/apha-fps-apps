@model Apha.FPSApps.Web.Areas.CostBook.Models.TestRequirementItem

<div class="modal-header">
    <h5 class="modal-title">@(string.IsNullOrEmpty(Model.TestDescription) ? "Add" : "Edit") Test Requirement</h5>
    <button type="button" class="close project-close-btn" aria-label="Close" onclick="closeModal()">×</button>
</div>
<div class="modal-body">
    <form id="testRequirementForm">
        <div class="form-group mb-2">
            <label asp-for="TestCode" class="govuk-label"></label>
            <select asp-for="TestCode" class="govuk-select" id="testCodeSelect">
                @* Options populated via JS *@
            </select>
            <span asp-validation-for="TestCode" class="govuk-error-message"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="UnitPrice" class="govuk-label"></label>
            <input asp-for="UnitPrice" type="text" readonly class="govuk-input" id="testUnitPrice">
        </div>
        <div class="form-group mb-2">
            <label asp-for="NumberOfTests" class="govuk-label"></label>
            <input asp-for="NumberOfTests" type="number" step="0.01" class="govuk-input" id="testNumberOfTests">
        </div>
        <div class="form-group mb-2">
            <label asp-for="TestCost" class="govuk-label"></label>
            <input asp-for="TestCost" type="text" readonly class="govuk-input" id="testCost">
        </div>
        <input asp-for="TestDescription" type="hidden">
        <button type="submit" class="govuk-button">Save</button>
        <button type="button" class="govuk-button govuk-button--secondary sup_margin_0" onclick="closeModal()">Cancel</button>
    </form>
</div>
