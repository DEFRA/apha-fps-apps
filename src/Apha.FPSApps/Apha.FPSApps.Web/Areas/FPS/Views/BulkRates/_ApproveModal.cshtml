@*
    _ApproveModal.cshtml — Approval confirmation modal.
    Toggled by BulkRates.showApproveModal() / BulkRates.closeApproveModal().
    BulkRates.confirmApprove() POSTs to /FPS/BulkRates/Approve.
    Mirrors _CancelModal.cshtml / _RejectModal.cshtml's structure for a standardized modal pattern.
*@
<div id="approveModalOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:9999;"
     role="dialog" aria-modal="true" aria-labelledby="approveModalTitle">
    <div style="background:#fff; max-width:480px; margin:10vh auto; padding:2rem; border:2px solid #0b0c0c;">
        <div class="modal-header">
            <h2 class="govuk-heading-m" id="approveModalTitle">Approve request</h2>
            <button type="button" class="btn-close btn-red" aria-label="Close" onclick="BulkRates.closeApproveModal()">X</button>
        </div>
        <p class="govuk-body-s">Approve this request? The changes will be processed and applied.</p>

        <div class="govuk-button-group govuk-!-margin-bottom-0">
            <button type="button" class="govuk-button govuk-!-margin-bottom-0"
                    id="btnConfirmApprove" onclick="BulkRates.confirmApprove()">
                Approve
            </button>
            <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 govuk-!-margin-left-2"
                    onclick="BulkRates.closeApproveModal()">
                Cancel
            </button>
        </div>
    </div>
</div>
