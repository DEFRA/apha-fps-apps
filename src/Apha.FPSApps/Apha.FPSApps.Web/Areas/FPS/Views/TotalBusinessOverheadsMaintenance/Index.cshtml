@model Apha.FPSApps.Web.Areas.FPS.Models.TotalBusinessOverheadsViewModel

@{
    ViewData["Title"] = "Maintain Total Business Overheads";
}

<main id="main-content">
    <div class="container-fluid">

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    Total Business Overheads
                </h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">

                                    @await Html.PartialAsync("_MaintenanceSideNav", "TotalBusinessOverheadsMaintenance")

                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">

                                        @if (TempData["SuccessMessage"] != null)
                                        {
                                            <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
                                                <div class="govuk-notification-banner__content">
                                                    <p class="govuk-notification-banner__heading">@TempData["SuccessMessage"]</p>
                                                </div>
                                            </div>
                                        }
                                        @if (TempData["ErrorMessage"] != null)
                                        {
                                            <div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" data-module="govuk-error-summary">
                                                <div class="govuk-error-summary__body">
                                                    <p>@TempData["ErrorMessage"]</p>
                                                </div>
                                            </div>
                                        }

                                        <form asp-action="Save" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" asp-for="FpsYear" />

                                            <div class="govuk-!-margin-left-2 govuk-form-group sup_margin_bottom_10 ac-filter-panel govuk-!-padding-bottom-0">
                                                <div class="trl-filter-row govuk-!-margin-top-0 govuk-!-margin-bottom-0">

                                                    <div class="govuk-form-group sup_margin_bottom_10">
                                                        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16 pva-nowrap-label govuk-!-margin-bottom-2" for="TotalBusinessOverheads">Total Business Overheads:</label>
                                                    </div>
                                                    <div class="govuk-form-group sup_margin_bottom_10">
                                                        <div class="govuk-input__wrapper">
                                                            <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                                            <input type="text" asp-for="TotalBusinessOverheads" class="govuk-input text-AlignRight pva-input-185" id="ppf-programme-target" />
                                                        </div>
                                                    </div>

                                                    <div class="govuk-form-group sup_margin_bottom_10">
                                                        <div class="govuk-button-group sup_margin_0 trl-filter-actions-buttons">
                                                            <button type="submit" class="govuk-button govuk-!-margin-bottom-2" id="btnSaveBusinessOverheads" data-module="govuk-button">Save</button>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>

                                        </form>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>

    </div>
</main>
