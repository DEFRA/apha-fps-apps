@model Apha.FPSApps.Web.Areas.FPS.Models.YearEndInitiationViewModel

@{
    ViewData["Title"] = "Year End Initiation";
    var btnDisabled = Model.CanRunJob ? (string?)null : "disabled";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-grid-row govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
            YearEnd Initiation
        </h1>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="cc-container-fluid">
        <div class="cc-layout-row">
            <div class="cc-content-column">
                <div class="govuk-grid-row">
                    <div class="govuk-grid-column-full">
                        <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">

                            @* Error summary *@
                            <div class="govuk-grid-column-full sup_p_0">
                                <div class="govuk-error-summary" role="alert" tabindex="-1" style="display:none;" aria-labelledby="yei-error-summary-title">
                                    <h2 class="govuk-error-summary__title" id="yei-error-summary-title">There is a problem</h2>
                                    <div class="govuk-error-summary__body">
                                        <ul class="govuk-list govuk-error-summary__list" id="yei-error-list"></ul>
                                    </div>
                                </div>
                                <div id="yei-success-banner"
                                     class="govuk-notification-banner govuk-notification-banner--success"
                                     role="alert"
                                     aria-labelledby="yei-success-banner-title"
                                     style="display:none;">
                                    <div class="govuk-notification-banner__header">
                                        <h2 class="govuk-notification-banner__title" id="yei-success-banner-title">Success</h2>
                                    </div>
                                    <div class="govuk-notification-banner__body">
                                        <p id="yei-success-banner-message" class="govuk-body"></p>
                                    </div>
                                </div>
                            </div>

                            @* Process Rules *@
                            <div class="govuk-grid-column-full sup_p_0">
                                <section class="sup_border govuk-!-padding-3" aria-labelledby="process-rules-title">
                                    <h2 class="govuk-heading-s govuk-!-margin-bottom-2" id="process-rules-title">Process Rules</h2>
                                    <ul class="govuk-list govuk-list--bullet govuk-!-font-size-16 govuk-!-margin-bottom-0">
                                        <li>Calendar Year-End Process is a two-step process consisting of Data Setup Initiation &amp; Approval and Year Cutover.</li>
                                        <li>Only FPS Admin can perform Calendar Year-End process.</li>
                                        <li>The initiator and approver for the Data Setup Initiation &amp; Approval and Year Cutover steps must be different users.</li>
                                        <li>On Failure or Rejection, new request needs to be submitted.</li>
                                    </ul>
                                </section>
                            </div>

                            @* Calendar Year-End Process For + Config Values + Note *@
                            <div class="govuk-grid-column-full sup_p_0 govuk-!-margin-top-3 govuk-!-margin-left-3">
                                <div class="govuk-form-group govuk-!-margin-bottom-4" style="display:flex; align-items:center; gap:10px;">
                                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-margin-bottom-0" for="yearEndProcessYear">
                                        Calendar Year-End Process For
                                    </label>
                                    <input class="govuk-input govuk-input--width-5" id="yearEndProcessYear"
                                           type="text" value="@Model.PlannedYear" autocomplete="off" disabled>
                                </div>

                                <section class="sup_border govuk-!-padding-3 isOverflowHidden" aria-labelledby="config-values-title">
                                    <table class="govuk-grid-column-one-half editable-grid-table govuk-table custom-table govuk-!-margin-bottom-0 govuk-!-width-one-half">
                                        <caption class="govuk-visually-hidden" id="config-values-title">Config Values</caption>
                                        <colgroup>
                                            <col class="tracker-table-col-2">
                                            <col class="tracker-table-col-1">
                                            <col class="tracker-table-col-1">
                                        </colgroup>
                                        <thead class="govuk-table__head">
                                            <tr class="govuk-table__row">
                                                <th colspan="3" scope="col"
                                                    class="govuk-table__header govuk-!-font-size-16 govuk-!-text-align-left">
                                                    Config Value
                                                </th>
                                            </tr>
                                            <tr class="govuk-table__row">
                                                <th scope="col" class="govuk-table__header govuk-!-font-size-16 govuk-!-text-align-left">ID</th>
                                                <th scope="col" class="govuk-table__header govuk-!-font-size-16 govuk-!-text-align-left">Value</th>
                                                <th scope="col" class="govuk-table__header govuk-!-font-size-16 govuk-!-text-align-left">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody class="govuk-table__body">
                                            @foreach (var cfg in Model.ConfigValues)
                                            {
                                                var cfgDisabled = cfg.FpsYearType == "Planned" ? (string?)null : "disabled";
                                                <tr class="govuk-table__row">
                                                    <td class="govuk-table__cell govuk-!-font-size-16">@cfg.Label</td>
                                                    <td class="govuk-table__cell govuk-!-font-size-16" id="cfg-val-@cfg.Id">@cfg.Value</td>
                                                    <td class="govuk-table__cell govuk-!-font-size-16" id="cfg-action-@cfg.Id">
                                                        <button type="button"
                                                                class="govuk-button govuk-button--secondary sup_margin_0 sup_p_8 cfg-edit-link cfg-action-btn"
                                                                data-config-id="@cfg.Id"
                                                                data-config-label="@cfg.Label"
                                                                data-config-value="@cfg.Value"
                                                                aria-label="Edit @cfg.Label"
                                                                disabled="@cfgDisabled">
                                                            <img src="~/images/pen-to-square-regular-full.svg" alt="" aria-hidden="true" width="20" height="20">
                                                        </button>
                                                        <button type="button"
                                                                class="govuk-button sup_margin_0 sup_p_8 cfg-confirm-link cfg-action-btn"
                                                                data-config-id="@cfg.Id"
                                                                data-config-label="@cfg.Label"
                                                                data-config-value="@cfg.Value"
                                                                aria-label="Confirm @cfg.Label"
                                                                disabled="@cfgDisabled">
                                                            <img src="~/images/square-check-regular-full.svg" alt="" aria-hidden="true" width="20" height="20">
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                    <p class="govuk-grid-column-one-half govuk-body govuk-!-margin-0 govuk-!-margin-top-0">
                                        <strong>Note:</strong> Config value, Month Working Days, VID Hours and CVL Hours are default populated from previous year.
                                        Please review and confirm these values for the Calendar Year End.
                                    </p>
                                </section>
                            </div>

                            @* Month Working Hours Grid *@
                            <div class="govuk-grid-column-full sup_p_0 govuk-!-margin-top-3 govuk-!-margin-bottom-3">
                                <section class="sup_border govuk-!-padding-3" aria-labelledby="month-working-title">
                                    <h2 class="govuk-heading-s govuk-!-margin-bottom-2" id="month-working-title">Month Working Hours</h2>
                                    <table class="editable-grid-table govuk-table custom-table govuk-!-margin-bottom-0">
                                        <thead class="govuk-table__head">
                                            <tr class="govuk-table__row">
                                                <th scope="col" class="govuk-table__header govuk-!-font-size-16">Month</th>
                                                <th scope="col" class="govuk-table__header govuk-!-font-size-16">Days</th>
                                                <th scope="col" class="govuk-table__header govuk-!-font-size-16">CVL Hours</th>
                                                <th scope="col" class="govuk-table__header govuk-!-font-size-16">VID Hours</th>
                                                <th scope="col" class="govuk-table__header govuk-!-font-size-16">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody class="govuk-table__body" id="month-working-tbody">
                                            @foreach (var mh in Model.MonthWorkingHours)
                                            {
                                                var mhDisabled = mh.FpsYearType == "Planned" ? (string?)null : "disabled";
                                                <tr class="govuk-table__row"
                                                    data-year="@mh.Year"
                                                    data-month="@mh.Month"
                                                    data-days="@mh.Days"
                                                    data-cvl="@mh.CvlHours"
                                                    data-vid="@mh.VidHours"
                                                    data-fmonth="@mh.Fmonth"
                                                    data-fps-year="@mh.FpsYear">
                                                    <td class="govuk-table__cell govuk-!-font-size-16">@mh.MonthName</td>
                                                    <td class="govuk-table__cell govuk-!-font-size-16 mh-days">@mh.Days</td>
                                                    <td class="govuk-table__cell govuk-!-font-size-16 mh-cvl">@mh.CvlHours</td>
                                                    <td class="govuk-table__cell govuk-!-font-size-16 mh-vid">@mh.VidHours</td>
                                                    <td class="govuk-table__cell govuk-!-font-size-16">
                                                        <button type="button"
                                                                class="govuk-button govuk-button--secondary sup_margin_0 sup_p_8 mh-edit-btn"
                                                                aria-label="Edit @mh.MonthName"
                                                                disabled="@mhDisabled">
                                                            <img src="~/images/pen-to-square-regular-full.svg" alt="" aria-hidden="true" width="20" height="20">
                                                        </button>
                                                        <button type="button"
                                                                class="govuk-button sup_margin_0 sup_p_8 mh-confirm-btn"
                                                                aria-label="Confirm @mh.MonthName"
                                                                disabled="@mhDisabled">
                                                            <img src="~/images/square-check-regular-full.svg" alt="" aria-hidden="true" width="20" height="20">
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </section>
                            </div>

                        </div>

                        @* Release History Grid *@
                        <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                            <div class="govuk-grid-column-full sup_p_0">
                                <div id="gridContainer_yearEndInitiationHistoryGrid">
                                    @await Html.PartialAsync("_DataGrid", Model.HistoryGrid)
                                </div>
                            </div>
                        </div>

                        @* Action Buttons *@
                        <div class="govuk-grid-row sup_margin_left_right_10 govuk-!-margin-top-2">
                            <div class="govuk-grid-column-full govuk-!-padding-left-0 govuk-!-padding-right-0">
                                <div class="approval-buttons-row">
                                    <div class="govuk-button-group sup_flex_end_center approval-buttons-group">
                                        <button type="button" class="govuk-button" data-module="govuk-button"
                                                id="btnInitiateDataSetupRequest"
                                                disabled="@btnDisabled">
                                            Initiate DataSetup Request
                                        </button>
                                        <button type="button" class="govuk-button" data-module="govuk-button"
                                                id="btnApproveDataSetupRequest"
                                                disabled="@btnDisabled">
                                            Approve DataSetup Request
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Config Value Edit Modal *@
<div class="govuk-modal" id="configEditModal" aria-hidden="true">
    <div class="govuk-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="config-modal-title">
        <div class="govuk-modal__header">
            <h2 class="govuk-heading-m govuk-!-margin-bottom-0" id="config-modal-title">Edit Config Value</h2>
            <button class="govuk-modal__close" id="configModalClose" aria-label="Close">&times;</button>
        </div>
        <div class="govuk-modal__body">
            <input type="hidden" id="configModalId">
            <div class="govuk-form-group">
                <label class="govuk-label govuk-!-font-weight-bold" id="configModalLabel" for="configModalInput">Value</label>
                <input class="govuk-input govuk-input--width-10" id="configModalInput" type="text" autocomplete="off">
                <select class="govuk-select" id="configModalSelect" style="display:none;">
                    <option value="Yes">Yes</option>
                    <option value="No">No</option>
                </select>
            </div>
        </div>
        <div class="govuk-modal__footer">
            <div class="govuk-button-group">
                <button class="govuk-button" id="configModalSave">Confirm</button>
                <button class="govuk-button govuk-button--secondary" id="configModalCancel">Cancel</button>
            </div>
        </div>
    </div>
</div>

@* Month Working Hours Row Edit Modal *@
<div class="govuk-modal" id="monthRowEditModal" aria-hidden="true">
    <div class="govuk-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="month-modal-title">
        <div class="govuk-modal__header">
            <h2 class="govuk-heading-m govuk-!-margin-bottom-0" id="month-modal-title">Edit</h2>
            <button class="govuk-modal__close" id="monthModalClose" aria-label="Close">&times;</button>
        </div>
        <div class="govuk-modal__body">
            <input type="hidden" id="monthModalYear">
            <input type="hidden" id="monthModalMonth">
            <input type="hidden" id="monthModalFmonth">
            <input type="hidden" id="monthModalFpsYear">
            <div class="year-end-month-modal-inline-fields" style="display:flex; gap:16px;">
                <div class="govuk-form-group govuk-!-margin-bottom-0">
                    <label class="govuk-label govuk-!-font-weight-bold" for="monthModalDays">Days</label>
                    <input class="govuk-input govuk-input--width-5 govuk-!-font-size-16" id="monthModalDays" type="number" min="0" step="1" autocomplete="off">
                </div>
                <div class="govuk-form-group govuk-!-margin-bottom-0">
                    <label class="govuk-label govuk-!-font-weight-bold" for="monthModalCvlHours">CVL Hours</label>
                    <input class="govuk-input govuk-input--width-5 govuk-!-font-size-16" id="monthModalCvlHours" type="number" min="0" step="0.1" autocomplete="off">
                </div>
                <div class="govuk-form-group govuk-!-margin-bottom-0">
                    <label class="govuk-label govuk-!-font-weight-bold" for="monthModalVidHours">VID Hours</label>
                    <input class="govuk-input govuk-input--width-5 govuk-!-font-size-16" id="monthModalVidHours" type="number" min="0" step="0.1" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="govuk-modal__footer">
            <div class="govuk-button-group">
                <button class="govuk-button" id="monthModalSave">Confirm</button>
                <button class="govuk-button govuk-button--secondary" id="monthModalCancel">Cancel</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    window.YearEndInitiationConfig = {
        saveSettingUrl: '@Url.Action("SaveSetting", "YearEndInitiation", new { area = "FPS" })',
        saveMonthHourUrl: '@Url.Action("SaveMonthHour", "YearEndInitiation", new { area = "FPS" })',
        triggerInitiateUrl: '@Url.Action("TriggerInitiate", "YearEndInitiation", new { area = "FPS" })'
    };
</script>
<script src="~/js/fps_js/year-end-initiation.js"></script>
}
