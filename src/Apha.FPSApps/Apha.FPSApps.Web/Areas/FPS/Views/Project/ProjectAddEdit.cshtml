@* Single unified view for both Add and Edit operations *@
@model Apha.FPSApps.Web.Areas.FPS.Models.ProgrammeNewProjectViewModel
@{
    var isEditMode = ViewBag.IsEditMode ?? !string.IsNullOrEmpty(Model.ParentProject);
    ViewData["Title"] = isEditMode ? $"Edit Project - {Model.ParentProject}" : "Add New Project";
    
    var formId = isEditMode ? "editProgrammeNewProjectForm" : "addProgrammeNewProjectForm";
    var submitButtonText = isEditMode ? "Save" : "Save";
}

<main id="main-content">
    <div class="container-fluid">
        <!-- Breadcrumb section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div style="padding: 5px 5px; border-bottom: 1px solid #b4b4b4" class="row">
                    <div style="display: flex; font-size: 14px; align-items: center; justify-content: space-between;">
                        <div class="col-md-6">
                            <nav aria-label="Breadcrumb">
                                <a href="@Url.Action("Index", "Home", new { area = "FPS" })">Home</a> &gt;
                                <a href="@Url.Action("Index", "Project", new { area = "FPS" })">Programme Management</a> &gt;
                                Plan Projects &gt; @(isEditMode ? "Edit Project" : "Set Up A New Project")
                            </nav>
                        </div>
                        @if (!isEditMode)
                        {
                            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 6px;" class="col-md-6">
                                <label class="fw-bold mt-2" for="programmeSelect">Programme:</label>
                                <select id="programmeSelect" asp-items="Model.ProgrammeList" asp-for="SelectedProgramNo"
                                        class="form-select form-select-sm" style="width: auto; min-width: 260px;">
                                    <option value="">-- Select Programme --</option>
                                </select>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Title section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="row" style="display:flex; align-items: center;">
                    <div class="col-sm-12" style="padding:0px;">
                        <div style="border-bottom: 2px solid #1d70b8; height:48px;">
                            <h1 style="padding: 15px 0 5px 17px; font-size:16px; width: 50%; font-weight: 700; float:left; margin: 0;">
                                2025-2026 : @(isEditMode ? $"Edit Project - {Model.ParentProject}" : "Set Up New Project")
                            </h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0px 10px 10px 10px;">

                    <!-- Error Summary -->
                    <div class="govuk-error-summary" role="alert" aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
                        <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
                        <div class="govuk-error-summary__body">
                            <ul class="govuk-list govuk-error-summary__list"></ul>
                        </div>
                    </div>

                    <!-- Form -->
                    <form id="@formId" data-parent-project="@(isEditMode ? Html.Encode(Model.ParentProject) : string.Empty)" data-is-edit="@isEditMode.ToString().ToLower()">
                        @Html.AntiForgeryToken()

                        @* Hidden field to store original project code - Edit mode only *@
                        @if (isEditMode)
                        {
                            <input type="hidden" name="OriginalParentProject" value="@Model.ParentProject" />
                        }

                        <div class="row d-flex align-items-center mt-2 mb-2">
                            <div class="col-lg-6">
                                <h2 class="sup_text_color govuk-heading-s sup_align_flexheading">
                                    Please insert data for mandatory fields marked with *
                                </h2>
                            </div>
                            <div class="col-lg-6">
                                <div class="action-buttons">
                                    @if (isEditMode)
                                    {
                                        <button class="govuk-button sup_margin_0" type="button"
                                                onclick="window.location.href='@Url.Action("Add", "Project", new { area = "FPS" })'">
                                            Add Another Project
                                        </button>
                                        <button class="govuk-button sup_margin_0" type="button"
                                                onclick="planProject()">
                                            Plan this Project
                                        </button>
                                        <button class="govuk-button govuk-button--warning sup_margin_0" type="button"
                                                onclick="handleDeleteProject()">
                                             Delete this Project
                                         </button>
                                    }
                                    <button class="govuk-button sup_margin_0" type="button" onclick="submitProject()">
                                         @submitButtonText
                                     </button>
                                </div>
                            </div>
                        </div>

                        @* Change Project Code section - Edit mode, FPSAdmin only *@
                        @if (isEditMode && User.IsInRole("FPSAdmin"))
                        {
                            <div class="govuk-form-group sup_margin_0 mt-2 mb-3"
                                 style="border: 1px solid #1d70b8; padding: 8px; border-radius: 4px; display: flex; align-items: center; gap: 10px;">
                                <label class="govuk-label" style="display:inline-block; margin:0;" for="NewProjectCode">Change Project Code:</label>
                                <input type="text" style="width:350px;" class="govuk-input" id="NewProjectCode" name="NewProjectCode"
                                       placeholder="Enter new project code" />
                                <button class="govuk-button sup_margin_0" type="button"
                                        onclick="changeProjectCode(document.querySelector('input[name=OriginalParentProject]').value, document.getElementById('NewProjectCode').value)">
                                    Submit
                                </button>
                            </div>
                        }

                        <div class="form-container mt-3">
                            <!-- form-left column -->
                            <div class="form-left">
                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="ParentProject">Project Code:</label>
                                    @if (isEditMode)
                                    {
                                        <input type="text" asp-for="ParentProject" class="govuk-input" required readonly />
                                    }
                                    else
                                    {
                                        <input type="text" asp-for="ParentProject" class="govuk-input" required />
                                    }
                                    <span asp-validation-for="ParentProject" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="ProjectTitle">Description:</label>
                                    <input type="text" asp-for="ProjectTitle" class="govuk-input" required />
                                    <span asp-validation-for="ProjectTitle" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="ShortTitle">Short Title:</label>
                                    <input type="text" asp-for="ShortTitle" class="govuk-input" required />
                                    <span asp-validation-for="ShortTitle" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="Customer">Customer:</label>
                                    <select asp-for="Customer" asp-items="@Model.CustomerList" class="govuk-select sup_select_option_width_100" required></select>
                                    <span asp-validation-for="Customer" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="Program">Programme:</label>
                                    <select asp-for="Program" asp-items="@Model.ProgramList" class="govuk-select sup_select_option_width_100" required></select>
                                    <span asp-validation-for="Program" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="Manager">Manager:</label>
                                    <select asp-for="Manager" asp-items="@Model.ManagerList" class="govuk-select sup_select_option_width_100" required></select>
                                    <span asp-validation-for="Manager" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="Disease">Disease:</label>
                                    <select asp-for="Disease" asp-items="@Model.DiseaseList" class="govuk-select sup_select_option_width_100" required></select>
                                    <span asp-validation-for="Disease" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="CustIncome">Customer Income:</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                        <input type="text" asp-for="CustIncome" class="govuk-input" required />
                                    </div>
                                    <span asp-validation-for="CustIncome" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="TransferIncome">Transfer Income:</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                        <input type="text" asp-for="TransferIncome" class="govuk-input" required />
                                    </div>
                                    <span asp-validation-for="TransferIncome" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="Profit">Target Profit:</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                        <input type="text" asp-for="Profit" class="govuk-input" />
                                    </div>
                                    <span asp-validation-for="Profit" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="ProjectStatus">Status:</label>
                                    <select asp-for="ProjectStatus" asp-items="@Model.ProjectStatusList" class="govuk-select sup_select_option_width_100" required></select>
                                    <span asp-validation-for="ProjectStatus" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="CostBookNo">CostBookNo:</label>
                                    <input type="text" asp-for="CostBookNo" class="govuk-input" />
                                    <span asp-validation-for="CostBookNo" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="Contract">Contract No:</label>
                                    <select asp-for="Contract" asp-items="@Model.ContractList" class="govuk-select sup_select_option_width_100" required></select>
                                    <span asp-validation-for="Contract" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="IsDefraProject">Is Defra Project?</label>
                                    <select asp-for="IsDefraProject" asp-items="@Model.IsDefraProjectList" class="govuk-select sup_select_option_width_100" required></select>
                                    <span asp-validation-for="IsDefraProject" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="CostCentre">Cost Centre:</label>
                                    <select asp-for="CostCentre" asp-items="@Model.CostCentreList" class="govuk-select sup_select_option_width_100" required></select>
                                    <span asp-validation-for="CostCentre" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="OwningRc">Resource Centre:</label>
                                    <input type="text" asp-for="OwningRc" class="govuk-input" readonly />
                                    <span asp-validation-for="OwningRc" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="ProjectGroup">Project Group:</label>
                                    <select asp-for="ProjectGroup" asp-items="@Model.ProjectGroupList" class="govuk-select sup_select_option_width_100"></select>
                                    <span asp-validation-for="ProjectGroup" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="IncomeAccountCode">Income Account Code:</label>
                                    <select asp-for="IncomeAccountCode" asp-items="@Model.IncomeAccountCodeList" class="govuk-select sup_select_option_width_100" required></select>
                                    <span asp-validation-for="IncomeAccountCode" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="SubAccountCode">Objective Code:</label>
                                    <select asp-for="SubAccountCode" asp-items="@Model.SubAccountCodeList" class="govuk-select sup_select_option_width_100" required></select>
                                    <span asp-validation-for="SubAccountCode" class="govuk-error-message" style="display:none;"></span>
                                </div>
                            </div>

                            <!-- form-center column -->
                            <div class="form-center">
                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="BudgetCvl">Budget:</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                        <input type="text" asp-for="BudgetCvl" class="govuk-input" required />
                                    </div>
                                    <span asp-validation-for="BudgetCvl" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="PvsIncome">PVS Income: (Surv Only)</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                        <input type="text" asp-for="PvsIncome" class="govuk-input" />
                                    </div>
                                    <span asp-validation-for="PvsIncome" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="PlanCaseWorkDebit">Plan CW Debit: (Surv Only)</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                        <input type="text" asp-for="PlanCaseWorkDebit" class="govuk-input" />
                                    </div>
                                    <span asp-validation-for="PlanCaseWorkDebit" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="CarryOver">CarryOver:</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                        <input type="text" asp-for="CarryOver" class="govuk-input" />
                                    </div>
                                    <span asp-validation-for="CarryOver" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="CarryOverSeed">CarryOverSeed:</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                        <input type="text" asp-for="CarryOverSeed" class="govuk-input" />
                                    </div>
                                    <span asp-validation-for="CarryOverSeed" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="Comments">Comments:</label>
                                    <textarea asp-for="Comments" class="govuk-textarea sup_margin_0"></textarea>
                                    <span asp-validation-for="Comments" class="govuk-error-message" style="display:none;"></span>
                                </div>
                            </div>
                        </div>
                    </form>
                </main>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        if (typeof $ !== 'undefined' && $.validator && $.validator.unobtrusive) {
            $.validator.unobtrusive.parse(document);
        }

        $('#programmeSelect').on('change', function () {
            var programDropdown = document.getElementById('Program');
            if (programDropdown && !programDropdown.value) {
                programDropdown.value = $(this).val();
            }
        });

        function syncResourceCentreFromCostCentre() {
            const sel = document.getElementById('CostCentre');
            if (!sel) return;
            const parts = sel.options[sel.selectedIndex].text.split('|');
            const owningRc = document.getElementById('OwningRc');
            if (owningRc) owningRc.value = parts.length >= 2 ? parts[1].trim() : '';
        }
        document.getElementById('CostCentre')?.addEventListener('change', syncResourceCentreFromCostCentre);
        syncResourceCentreFromCostCentre(); // pre-populate on page load (edit mode)

        // Currency formatting and validation (same pattern as ProgramStaffPlan)
        function formatCurrency(value) {
            return '\u00A3' + parseFloat(value || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }

        function parseCurrencyValue(val) {
            return (val || '').toString().replace(/[£,\s]/g, '').trim();
        }

        var currencyFieldNames = ['CustIncome', 'TransferIncome', 'Profit', 'BudgetCvl', 'PvsIncome', 'PlanCaseWorkDebit', 'CarryOver', 'CarryOverSeed'];

        // Format currency fields on page load (edit mode)
        $(document).ready(function () {
            currencyFieldNames.forEach(function (name) {
                var $field = $('[name="' + name + '"]');
                var raw = parseCurrencyValue($field.val());
                if (raw !== '' && !isNaN(parseFloat(raw))) {
                    $field.val(formatCurrency(raw));
                }
            });
        });

        // Re-format on blur, validate on input
        currencyFieldNames.forEach(function (name) {
            var $field = $('[name="' + name + '"]');

            $field.on('blur', function () {
                var raw = parseCurrencyValue($(this).val());
                if (raw !== '' && !isNaN(parseFloat(raw))) {
                    $(this).val(formatCurrency(raw));
                }
            });

            $field.on('focus', function () {
                var raw = parseCurrencyValue($(this).val());
                $(this).val(raw);
            });

            $field.on('input', function () {
                var raw = $(this).val();
                // Allow digits, one decimal point, optional leading minus, and empty
                if (raw !== '' && raw !== '-' && !/^-?\d*\.?\d*$/.test(raw)) {
                    $(this).val(raw.replace(/[^0-9.\-]/g, ''));
                }
            });
        });


        // Strip currency formatting before validation so jQuery data-val-number passes
        function stripCurrencyFormatting() {
            currencyFieldNames.forEach(function (name) {
                var $field = $('[name="' + name + '"]');
                var raw = parseCurrencyValue($field.val());
                $field.val(raw);
            });
        }

        window.submitProject = function() {
            try {
      
                const form = document.querySelector('form[data-parent-project]');
                const formId = form.id;
                const isEdit = form.dataset.isEdit === 'true';
                const parentProject = form.dataset.parentProject;
                if (typeof clearValidationErrors === 'function') clearValidationErrors('#main-content');
                stripCurrencyFormatting();
                const $form = $('#' + formId);
                if ($form.data('validator') && !$form.valid()) {
                    if (typeof displayClientValidationErrors === 'function') displayClientValidationErrors($form, '#main-content');
                    // Re-format currency fields so they don't look stripped
                    currencyFieldNames.forEach(function (name) {
                        var $field = $('[name="' + name + '"]');
                        var raw = parseCurrencyValue($field.val());
                        if (raw !== '' && !isNaN(parseFloat(raw))) {
                            $field.val(formatCurrency(raw));
                        }
                    });
                    return;
                }
                submitForm(formId, isEdit, parentProject);
            } catch (e) {
                console.error('submitProject error:', e);
                showGovukAlert('An error occurred: ' + e.message);
            }
        };

        window.handleDeleteProject = function() {
            const form = document.querySelector('form[data-parent-project]');
            const parentProject = form.dataset.parentProject;
            deleteProject(parentProject);
        };

        window.planProject = function() {
            // TODO: Navigate to project planning page when ready
        };

        function submitForm(formId, isEdit, parentProject) {
            clearValidationErrors('#main-content');

            const form = document.getElementById(formId);
            const formData = new FormData(form);
            const data = Object.fromEntries(formData);

            // Strip £ signs, commas, and spaces from currency/numeric fields before parsing
            const numericFields = ['CustIncome', 'TransferIncome', 'Profit', 'BudgetCvl', 'PvsIncome',
                                   'PlanCaseWorkDebit', 'CarryOver', 'CarryOverSeed', 'CostCentre', 'IsDefraProject'];
            numericFields.forEach(field => {
                var raw = parseCurrencyValue(data[field]);
                if (raw === '') {
                    data[field] = null;
                } else {
                    const parsed = Number(raw);
                    data[field] = isNaN(parsed) ? null : parsed;
                }
            });
            // Non-nullable value types must not be null
            ['TransferIncome', 'CustIncome', 'IsDefraProject'].forEach(field => {
                if (data[field] === null || data[field] === undefined) data[field] = 0;
            });
            // ProjectGroup is optional — send null when blank to avoid FK constraint violation
            if (data['ProjectGroup'] === '' || data['ProjectGroup'] === undefined) data['ProjectGroup'] = null;

            const url = isEdit
                ? '@Url.Action("Edit", "Project", new { area = "FPS" })' + '?parentProject=' + encodeURIComponent(parentProject)
                : '@Url.Action("Add", "Project", new { area = "FPS" })';

            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                },
                body: JSON.stringify(data)
            })
            .then(r => {
                if (!r.ok) {
                    return r.text().then(t => { throw new Error('Server returned ' + r.status + ': ' + t); });
                }
                return r.json();
            })
            .then(result => {
                if (result.success) {
                    // Re-format currency fields after successful save
                    currencyFieldNames.forEach(function (name) {
                        var $field = $('[name="' + name + '"]');
                        var raw = parseCurrencyValue($field.val());
                        if (raw !== '' && !isNaN(parseFloat(raw))) {
                            $field.val(formatCurrency(raw));
                        }
                    });
                    if (!isEdit && result.data?.parentProject) {
                        showGovukAlert(result.message || 'Project created successfully.').then(function () {
                            window.location.href = '@Url.Action("Edit", "Project", new { area = "FPS" })' + '?parentProject=' + encodeURIComponent(result.data.parentProject);
                        });
                    } else {
                        showGovukAlert(result.message || 'Project updated successfully.');
                    }
                } else {
                    displayServerValidationErrors(result.errors, result.message, '#main-content');
                }
            })
            .catch(err => {
                console.error('Error:', err);
                showGovukAlert('An error occurred while submitting the form.');
            });
        }

        window.deleteProject = function(parentProject) {
            showGovukConfirm('Are you sure you want to delete this project and all associated data?').then(function (confirmed) {
                if (!confirmed) return;

                fetch('@Url.Action("Delete", "Project", new { area = "FPS" })' + '?parentProject=' + encodeURIComponent(parentProject), {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' }
                })
                .then(r => r.json())
                .then(result => {
                    if (result.success) {
                        showGovukAlert(result.message || 'Project deleted successfully.').then(function () {
                            window.location.href = result.redirectUrl;
                        });
                    } else {
                        displayServerValidationErrors(result.errors, result.message, '#main-content');
                    }
                });
            });
        };

        window.changeProjectCode = function(oldCode, newCode) {
            if (!oldCode || !newCode) {
                showGovukAlert('Both old and new project codes are required.');
                return;
            }
            showGovukConfirm('Are you sure you want to change project code from "' + oldCode + '" to "' + newCode + '"? This will update all related records.').then(function (confirmed) {
                if (!confirmed) return;

                fetch('@Url.Action("ChangeCode", "Project", new { area = "FPS" })' + '?oldCode=' + encodeURIComponent(oldCode) + '&newCode=' + encodeURIComponent(newCode), {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' }
                })
                .then(r => r.json())
                .then(result => {
                    if (result.success) {
                        showGovukAlert(result.message || 'Project code changed successfully.').then(function () {
                            window.location.href = result.redirectUrl;
                        });
                    } else {
                        displayServerValidationErrors(result.errors, result.message, '#main-content');
                    }
                })
                .catch(err => {
                    console.error('Error:', err);
                    showGovukAlert('An error occurred while changing project code.');
                });
            });
        };
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}