@* Single unified view for both Add and Edit operations *@
@model Apha.FPSApps.Web.Areas.FPS.Models.ProgrammeNewProjectViewModel
@{
    var isEditMode = ViewBag.IsEditMode ?? !string.IsNullOrEmpty(Model.ParentProject);
    ViewData["Title"] = isEditMode ? $"Edit Project - {Model.ParentProject}" : "Add New Project";
    
    var formId = isEditMode ? "editProgrammeNewProjectForm" : "addProgrammeNewProjectForm";
    var submitButtonText = isEditMode ? "Save" : "Save";
}

<main id="main-content">
    <div class="container-fluid">
        <!-- Title section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="row" style="display:flex; align-items: center;">
                    <div class="col-sm-12" style="padding:0px;">
                        <div class="sup_border-bottom" style="min-height:42px;">
                            <h1 style="padding: 0 17px; height:42px; font-size:16px; font-weight: 700; margin: 0; display:flex; align-items:center; justify-content:space-between;">
                                <span>2025-2026 : @(isEditMode ? $"Edit Project - {Model.ParentProject}" : "Set Up New Project")</span>
                                <a href="@(Context.Request.Query.ContainsKey("returnUrl") ? Context.Request.Query["returnUrl"].ToString() : "javascript:history.back()")" class="govuk-back-link sup_align_right sup_back_link_center_right">Back</a>
                            </h1>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0px 10px 10px 10px;">

                    <!-- Error Summary -->
                    <div class="govuk-error-summary" role="alert" aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
                        <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
                        <div class="govuk-error-summary__body">
                            <ul class="govuk-list govuk-error-summary__list"></ul>
                        </div>
                    </div>

                    <!-- Form -->
                    <form id="@formId" data-parent-project="@(isEditMode ? Html.Encode(Model.ParentProject) : string.Empty)" data-is-edit="@isEditMode.ToString().ToLower()">
                        @Html.AntiForgeryToken()

                        @* Hidden field to store original project code - Edit mode only *@
                        @if (isEditMode)
                        {
                            <input type="hidden" name="OriginalParentProject" value="@Model.ParentProject" />
                        }

                        <div class="row d-flex align-items-center mt-2 mb-2">
                            <div class="col-lg-6">
                                <h2 class="sup_text_color govuk-heading-s sup_align_flexheading">
                                    Please insert data for mandatory fields marked with *
                                </h2>
                            </div>
                            <div class="col-lg-6">
                                <div class="action-buttons">
                                    @if (isEditMode)
                                    {
                                        <button class="govuk-button sup_margin_0" type="button"
                                                onclick="window.location.href='@Url.Action("Add", "Project", new { area = "FPS" })'">
                                            Add Another Project
                                        </button>
                                        <button class="govuk-button sup_margin_0" type="button"
                                                onclick="planProject()">
                                            Plan this Project
                                        </button>
                                        <button class="govuk-button govuk-button--warning sup_margin_0" type="button"
                                                onclick="handleDeleteProject()">
                                             Delete this Project
                                         </button>
                                    }
                                    <button class="govuk-button sup_margin_0" type="button" onclick="submitProject()">
                                         @submitButtonText
                                     </button>
                                </div>
                            </div>
                        </div>

                        @* Change Project Code section - Edit mode, FPSAdmin only *@
                        @if (isEditMode && User.IsInRole("FPSAdmin"))
                        {
                            <div class="govuk-form-group sup_margin_0 mt-2 mb-3"
                                 style="border: 1px solid #1d70b8; padding: 8px; border-radius: 4px; display: flex; align-items: center; gap: 10px;">
                                <label class="govuk-label" style="display:inline-block; margin:0;" for="NewProjectCode">Change Project Code:</label>
                                <input type="text" style="width:350px;" class="govuk-input" id="NewProjectCode" name="NewProjectCode"
                                       placeholder="Enter new project code" />
                                <button class="govuk-button sup_margin_0" type="button"
                                        onclick="changeProjectCode(document.querySelector('input[name=OriginalParentProject]').value, document.getElementById('NewProjectCode').value)">
                                    Submit
                                </button>
                            </div>
                        }

                        <div class="form-container mt-3">
                            <!-- form-left column -->
                            <div class="form-left">
                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="ParentProject">Project Code:</label>
                                    @if (isEditMode)
                                    {
                                        <input type="text" asp-for="ParentProject" class="govuk-input" required readonly />
                                    }
                                    else
                                    {
                                        <input type="text" asp-for="ParentProject" class="govuk-input" required />
                                    }
                                    <span asp-validation-for="ParentProject" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="ProjectTitle">Description:</label>
                                    <input type="text" asp-for="ProjectTitle" class="govuk-input" required />
                                    <span asp-validation-for="ProjectTitle" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="ShortTitle">Short Title:</label>
                                    <input type="text" asp-for="ShortTitle" class="govuk-input" required />
                                    <span asp-validation-for="ShortTitle" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="Customer">Customer:</label>
                                    <select asp-for="Customer" asp-items="@Model.CustomerList" class="govuk-select sup_select_option_width_100" required>
                                        <option value="">Select Customer</option>
                                    </select>
                                    <span asp-validation-for="Customer" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                <label id="ProgramLabel" class="govuk-label required" asp-for="Program">Programme:</label>
                                    <div style="position: relative;">
                                        <input type="text" id="ProgramDisplay" placeholder="Select Programme" autocomplete="off"
                                               class="govuk-input govuk-!-font-size-16 down-arrow-img" style="width:100%; cursor:pointer;" readonly
                                               aria-labelledby="ProgramLabel" aria-haspopup="listbox" aria-expanded="false" aria-controls="ProgramDropdownBody" />
                                        <div id="ProgramDropdownPanel" style="display:none; position:absolute; top:100%; left:0; width:100%;
                                                max-height:260px; overflow-y:auto; background:#fff; border:1px solid #b1b4b6;
                                                box-shadow:0 4px 8px rgba(0,0,0,.2); z-index:2000;">
                                            <label for="ProgramSearchBox" class="govuk-label govuk-visually-hidden">Search programmes</label>
                                            <input type="text" id="ProgramSearchBox" placeholder="Type to search programme" aria-label="Search programmes"
                                                   style="width:100%; padding:6px 8px; border:0; border-bottom:1px solid #b1b4b6; outline:none; box-sizing:border-box;" />
                                            <table style="width:100%; border-collapse:collapse; font-size:14px;">
                                                <thead style="background:#f3f2f1; position:sticky; top:0; z-index:10;">
                                                    <tr>
                                                        <th style="padding:6px 8px; text-align:left;">Programme No</th>
                                                        <th style="padding:6px 8px; text-align:left;">Programme Name</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="ProgramDropdownBody" role="listbox" aria-label="Programme results">
                                                    @foreach (var item in Model.ProgramList.Where(i => !string.IsNullOrEmpty(i.Value)))
                                                    {
                                                        var parts = item.Text.Split('|');
                                                        var progNo   = parts[0].Trim();
                                                        var progName = parts.Length > 1 ? parts[1].Trim() : string.Empty;
                                                        <tr data-value="@item.Value" data-display="@progNo" style="cursor:pointer;">
                                                            <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@progNo</td>
                                                            <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@progName</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <select asp-for="Program" asp-items="@Model.ProgramList" class="govuk-select sup_select_option_width_100" required style="display:none;">
                                        <option value="">Select Programme</option>
                                    </select>
                                    <span asp-validation-for="Program" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="Manager">Manager:</label>
                                    @await Html.PartialAsync("_ManagerPicker", new Apha.FPSApps.Web.Areas.FPS.Models.ManagerPickerViewModel
                                    {
                                        ManagerList = Model.ManagerList,
                                        FieldName = "Manager",
                                        ShowGrade = false,
                                        Required = true,
                                        SelectCssClass = "govuk-select sup_select_option_width_100"
                                    })
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="Disease">Disease:</label>
                                    <select asp-for="Disease" asp-items="@Model.DiseaseList" class="govuk-select sup_select_option_width_100" required>
                                        <option value="">Select Disease</option>
                                    </select>
                                    <span asp-validation-for="Disease" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="CustIncome">Customer Income:</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                                        <input type="text" asp-for="CustIncome" class="govuk-input js-numeric-decimal" maxlength="20" required />
                                    </div>
                                    <span asp-validation-for="CustIncome" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="TransferIncome">Transfer Income:</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                                        <input type="text" asp-for="TransferIncome" class="govuk-input js-numeric-decimal" maxlength="20" required />
                                    </div>
                                    <span asp-validation-for="TransferIncome" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="Profit">Target Profit:</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                                        <input type="text" asp-for="Profit" class="govuk-input js-numeric-decimal" maxlength="20" />
                                    </div>
                                    <span asp-validation-for="Profit" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="ProjectStatus">Status:</label>
                                    <select asp-for="ProjectStatus" asp-items="@Model.ProjectStatusList" class="govuk-select sup_select_option_width_100" required>
                                        <option value="">Select Status</option>
                                    </select>
                                    <span asp-validation-for="ProjectStatus" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="CostBookNo">CostBookNo:</label>
                                    <input type="text" asp-for="CostBookNo" class="govuk-input" />
                                    <span asp-validation-for="CostBookNo" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="Contract">Contract No:</label>
                                    <select asp-for="Contract" asp-items="@Model.ContractList" class="govuk-select sup_select_option_width_100" required>
                                        <option value="">Select Contract No</option>
                                    </select>
                                    <span asp-validation-for="Contract" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="IsDefraProject">Is Defra Project?:</label>
                                    <select asp-for="IsDefraProject" asp-items="@Model.IsDefraProjectList" class="govuk-select sup_select_option_width_100" required>
                                        <option value="">Select Is Defra Project?</option>
                                    </select>
                                    <span asp-validation-for="IsDefraProject" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                <label id="CostCentreLabel" class="govuk-label required" asp-for="CostCentre">Cost Centre:</label>
                                    <div style="position: relative;">
                                        <input type="text" id="CostCentreDisplay" placeholder="Select Cost Centre" autocomplete="off"
                                               class="govuk-input govuk-!-font-size-16 down-arrow-img" style="width:100%; cursor:pointer;" readonly
                                               aria-labelledby="CostCentreLabel" aria-haspopup="listbox" aria-expanded="false" aria-controls="CostCentreDropdownBody" />
                                        <div id="CostCentreDropdownPanel" style="display:none; position:absolute; top:100%; left:0; width:100%;
                                                max-height:260px; overflow-y:auto; background:#fff; border:1px solid #b1b4b6;
                                                box-shadow:0 4px 8px rgba(0,0,0,.2); z-index:2000;">
                                            <label for="CostCentreSearchBox" class="govuk-label govuk-visually-hidden">Search cost centres</label>
                                            <input type="text" id="CostCentreSearchBox" placeholder="Type to search cost centre" aria-label="Search cost centres"
                                                   style="width:100%; padding:6px 8px; border:0; border-bottom:1px solid #b1b4b6; outline:none; box-sizing:border-box;" />
                                            <table style="width:100%; border-collapse:collapse; font-size:14px;">
                                                <thead style="background:#f3f2f1; position:sticky; top:0; z-index:10;">
                                                    <tr>
                                                        <th style="padding:6px 8px; text-align:left;">Cost Centre</th>
                                                        <th style="padding:6px 8px; text-align:left;">Profit Centre</th>
                                                        <th style="padding:6px 8px; text-align:left;">WG</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="CostCentreDropdownBody" role="listbox" aria-label="Cost centre results">
                                                    @foreach (var item in Model.CostCentreList.Where(i => !string.IsNullOrEmpty(i.Value)))
                                                    {
                                                        var ccParts  = item.Text.Split('|');
                                                        var ccNo     = ccParts[0].Trim();
                                                        var ccProfit = ccParts.Length > 1 ? ccParts[1].Trim() : string.Empty;
                                                        var ccWg     = ccParts.Length > 2 ? ccParts[2].Trim() : string.Empty;
                                                        <tr data-value="@item.Value" data-display="@ccNo" style="cursor:pointer;">
                                                            <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@ccNo</td>
                                                            <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@ccProfit</td>
                                                            <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@ccWg</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <select asp-for="CostCentre" asp-items="@Model.CostCentreList" class="govuk-select sup_select_option_width_100" required style="display:none;">
                                        <option value="">Select Cost Centre</option>
                                    </select>
                                    <span asp-validation-for="CostCentre" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="OwningRc">Resource Centre:</label>
                                    <input type="text" asp-for="OwningRc" class="govuk-input" readonly />
                                    <span asp-validation-for="OwningRc" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="ProjectGroup">Project Group:</label>
                                    <select asp-for="ProjectGroup" asp-items="@Model.ProjectGroupList" class="govuk-select sup_select_option_width_100">
                                        <option value="">Select Project Group</option>
                                    </select>
                                    <span asp-validation-for="ProjectGroup" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="IncomeAccountCode">Income Account Code:</label>
                                    <select asp-for="IncomeAccountCode" asp-items="@Model.IncomeAccountCodeList" class="govuk-select sup_select_option_width_100" required>
                                        <option value="">Select Income Account Code</option>
                                    </select>
                                    <span asp-validation-for="IncomeAccountCode" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="SubAccountCode">Objective Code:</label>
                                    <select asp-for="SubAccountCode" asp-items="@Model.SubAccountCodeList" class="govuk-select sup_select_option_width_100" required>
                                        <option value="">Select Objective Code</option>
                                    </select>
                                    <span asp-validation-for="SubAccountCode" class="govuk-error-message" style="display:none;"></span>
                                </div>
                            </div>

                            <!-- form-center column -->
                            <div class="form-center">
                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label required" asp-for="BudgetCvl">Budget:</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                                        <input type="text" asp-for="BudgetCvl" class="govuk-input js-numeric-decimal" maxlength="20" required />
                                    </div>
                                    <span asp-validation-for="BudgetCvl" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="PvsIncome">PVS Income: (Surv Only)</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                                        <input type="text" asp-for="PvsIncome" class="govuk-input js-numeric-decimal" maxlength="20" />
                                    </div>
                                    <span asp-validation-for="PvsIncome" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="PlanCaseWorkDebit">Plan CW Debit: (Surv Only)</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                                        <input type="text" asp-for="PlanCaseWorkDebit" class="govuk-input js-numeric-decimal" maxlength="20" />
                                    </div>
                                    <span asp-validation-for="PlanCaseWorkDebit" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="CarryOver">CarryOver:</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                                        <input type="text" asp-for="CarryOver" class="govuk-input js-numeric-decimal" maxlength="20" />
                                    </div>
                                    <span asp-validation-for="CarryOver" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="CarryOverSeed">CarryOverSeed:</label>
                                    <div class="govuk-input__wrapper">
                                        <div class="govuk-input__prefix" aria-hidden="true">&pound;</div>
                                        <input type="text" asp-for="CarryOverSeed" class="govuk-input js-numeric-decimal" maxlength="20" />
                                    </div>
                                    <span asp-validation-for="CarryOverSeed" class="govuk-error-message" style="display:none;"></span>
                                </div>

                                <div class="govuk-form-group sup_margin_0">
                                    <label class="govuk-label" asp-for="Comments">Comments:</label>
                                    <textarea asp-for="Comments" class="govuk-textarea sup_margin_0"></textarea>
                                    <span asp-validation-for="Comments" class="govuk-error-message" style="display:none;"></span>
                                </div>
                            </div>
                        </div>
                    </form>
                </main>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        // Server-generated URLs consumed by ProjectAddEdit.js
        window.projectAddEditConfig = {
            planningUrl: '@Url.Action("Index", "ProjectPlanning", new { area = "FPS" })',
            deleteUrl: '@Url.Action("Delete", "Project", new { area = "FPS" })',
            changeCodeUrl: '@Url.Action("ChangeCode", "Project", new { area = "FPS" })',
            editUrl: '@Url.Action("Edit", "Project", new { area = "FPS" })',
            addUrl: '@Url.Action("Add", "Project", new { area = "FPS" })'
        };
    </script>
    <script src="~/js/fps_js/ProjectAddEdit.js" asp-append-version="true"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
