@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProjectStaffPlanActualViewModel
@{
    ViewData["Title"] = "Plan vs Actual - Staff";
}

<div class="container-fluid">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div style="padding: 5px 5px; border-bottom: 1px solid #b4b4b4" class="row">
                <div style="display: flex; font-size: 14px; align-items: center; justify-content: space-between;">
                    <div class="col-md-6">

                    </div>
                    <div style="display: flex; justify-content: flex-end; align-items: center;" class="col-md-6">
                        <label class="fw-bold me-2" style="white-space:nowrap;">Project:</label>
                        <div style="position:relative;">
                            <input type="text" id="projectNameInput" placeholder="Select Project" autocomplete="off"
                                   class="govuk-input down-arrow-img" style="width:220px; cursor:pointer;"
                                   value="@Model.SelectedProjectCode" aria-label="Filter project" readonly />
                            <div id="ProjectDropdownPanel" style="display:none; position:fixed; width:420px;
                                    max-height:260px; overflow-y:auto; background:#fff; border:1px solid #b1b4b6;
                                    box-shadow:0 4px 8px rgba(0,0,0,.2); z-index:9999;">
                                <input type="text" id="ProjectSearchBox" placeholder="Type to search project"
                                       style="width:100%; padding:6px 8px; border:0; border-bottom:1px solid #b1b4b6; outline:none; box-sizing:border-box;" />
                                <table style="width:100%; border-collapse:collapse; font-size:14px;">
                                    <thead style="background:#f3f2f1; position:sticky; top:0; z-index:10;">
                                        <tr>
                                            <th style="padding:6px 8px; text-align:left;">Project</th>
                                            <th style="padding:6px 8px; text-align:left;">Project Title</th>
                                        </tr>
                                    </thead>
                                    <tbody id="ProjectDropdownBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Title section -->
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div style="display:flex; align-items:center; justify-content:space-between;"
                 class="sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                <h1 class="govuk-heading-s govuk-!-margin-bottom-0">Compare FPS Plan with PACT Actuals</h1>
                <a asp-area="FPS"
                   asp-controller="ProgramProject"
                   asp-action="Index"
                   class="govuk-back-link" style="margin-bottom:0;">Back</a>
            </div>
        </div>
    </div>

    <!-- Summary card -->
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full mt-2">
            <div class="pva-summary-card" style="background-color:#edf4ff; border:1px solid #1d70b8; border-radius:5px; padding:8px;">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="row">
                            <div class="col-lg-5">
                                <label class="govuk-label--s" for="summary-project-code">Project</label>
                                <input type="text" id="summary-project-code" asp-for="SelectedProjectCode"
                                       class="govuk-input" readonly>
                            </div>
                            <div class="col-lg-7">
                                <label class="govuk-label--s" for="summary-project-description">Project Description</label>
                                <input type="text" id="summary-project-description" asp-for="ProjectTitle"
                                       class="govuk-input" readonly>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="row">
                            <div class="col-lg-5">
                                <label class="govuk-label--s" for="summary-program">Program</label>
                                <input type="text" id="summary-program" asp-for="Program"
                                       class="govuk-input" readonly>
                            </div>
                            <div class="col-lg-7">
                                <label class="govuk-label--s" for="summary-contract">Contract</label>
                                <input type="text" id="summary-contract" asp-for="Contract"
                                       class="govuk-input" readonly>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Two-column grid area -->
    <div class="govuk-grid-row">
        <!-- Left: Planned Time -->
        <div class="govuk-grid-column-one-half mt-2">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full mt-2">
                    <div id="gridContainer_@Model.StaffPlanGrid.GridId" style="padding: 5px;">
                        @await Html.PartialAsync("_DataGrid", Model.StaffPlanGrid)
                    </div>
                </div>
                <div class="govuk-grid-column-full mt-2">
                    <div class="financial-summary mt-1" style="padding: 0 5px;">
                        <div style="display:flex; align-items:center;">
                            <span class="govuk-label--s" style="margin-left:auto; margin-right:8px; white-space:nowrap;">Total Planned Cost:</span>
                            <div class="govuk-input__wrapper" style="margin-right:75px;">
                                <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                <input type="text" id="planned-total-cost" readonly
                                       class="govuk-input text-AlignRight"
                                       value="@(Model.TotalPlannedCost.ToString("N2"))" style="width:140px;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Actual Time -->
        <div class="govuk-grid-column-one-half mt-2">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-full mt-2">
                    <div id="gridContainer_@Model.CompareStaff2Grid.GridId" style="padding: 5px;">
                        @await Html.PartialAsync("_DataGrid", Model.CompareStaff2Grid)
                    </div>
                </div>
                <div class="govuk-grid-column-full mt-2">
                    <div class="financial-summary mt-1" style="padding: 0 5px;">
                        <div style="display:flex; align-items:center; margin-bottom:4px;">
                            <span class="govuk-label--s" style="margin-left:auto; margin-right:8px; white-space:nowrap;">Totals:</span>
                            <input type="text" id="project-total-hrs" readonly
                                   class="govuk-input text-AlignRight"
                                   value="@(Model.TotalActualHrs.ToString("F2"))" style="width:90px; margin-right:4px;"
                                   aria-label="Total Hrs">
                            <div class="govuk-input__wrapper">
                                <div class="govuk-input__prefix" aria-hidden="true">£</div>
                                <input type="text" id="project-total-cost" readonly
                                       class="govuk-input text-AlignRight"
                                       value="@(Model.TotalActualCost.ToString("N0"))" style="width:110px;"
                                       aria-label="Total Actual Cost">
                            </div>
                        </div>
                        <div style="display:flex; align-items:center;">
                            <span class="govuk-label--s" style="margin-left:auto; margin-right:8px; white-space:nowrap;">Percent of Plan:</span>
                            <input type="text" id="project-percent-plan" readonly
                                   class="govuk-input text-AlignRight"
                                   value="@(Model.PercentOfPlan.ToString("F0"))%" style="width:110px;"
                                   aria-label="Percent of Plan">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/fps_js/StaffJob.js"></script>
    <script>
        var currentProjectCode = '@Html.Raw(Model.SelectedProjectCode)';

        StaffJobConfig.getJobCode = function () { return currentProjectCode; };
        StaffJobConfig.requireJobCodeForAdd = true;
        StaffJobConfig.onSaved = function () {
            window['gridManager_@Model.StaffPlanGrid.GridId'].reloadGrid({ page: 1 });
            refreshPlannedCost();
        };
        StaffJobConfig.onUpdated = function () {
            window['gridManager_@Model.StaffPlanGrid.GridId'].reloadGrid({ page: 1 });
            refreshPlannedCost();
        };
        StaffJobConfig.onDeleted = function () {
            window['gridManager_@Model.StaffPlanGrid.GridId'].reloadGrid({ page: 1 });
            refreshPlannedCost();
        };

        var _loaderPendingGrids = 0;

        $(document).ready(function () {
            if (currentProjectCode) {
                showLoader();
                _loaderPendingGrids = 2;
                setTimeout(function () {
                    window['gridManager_@Model.StaffPlanGrid.GridId'].reloadGrid({ page: 1 });
                    window['gridManager_@Model.CompareStaff2Grid.GridId'].reloadGrid({ page: 1 });
                    refreshPlannedCost();
                    refreshActualTotals();
                }, 0);
            }

            document.addEventListener('gridReloaded', function (e) {
                var tracked = ['@Model.StaffPlanGrid.GridId', '@Model.CompareStaff2Grid.GridId'];
                if (tracked.indexOf(e.detail.gridId) !== -1 && _loaderPendingGrids > 0) {
                    _loaderPendingGrids--;
                    if (_loaderPendingGrids === 0) hideLoader();
                }
            });
            var actualGridContainer = document.getElementById('gridContainer_@Model.CompareStaff2Grid.GridId');
            if (actualGridContainer) {
                new MutationObserver(function () {
                    refreshActualTotals();
                }).observe(actualGridContainer, { childList: true, subtree: true });
            }
        });


            function onProjectSelected(projectCode, projectTitle) {
                currentProjectCode = projectCode;
                // Update display input
                document.getElementById('projectNameInput').value = projectCode;
                // Persist project code to session
                $.ajax({
                    url: '@Url.Action("SaveProjectSession", "ProgramProject", new { area = "FPS" })',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(currentProjectCode)
                });
                $('#summary-project-code').val(currentProjectCode);
                $('#summary-project-description').val(projectTitle || '');
                $('#summary-program').val('');
                $('#summary-contract').val('');
                $('#planned-total-cost').val('0.00');
                $('#project-total-hrs').val('0.00');
                $('#project-total-cost').val('0');
                $('#project-percent-plan').val('0%');

                if (currentProjectCode) {
                    $.get('@Url.Action("GetProjectInfo", "ProjectStaffPlanActual", new { area = "FPS" })',
                        { projectCode: currentProjectCode },
                        function (result) {
                            if (result.success) {
                                $('#summary-project-description').val(result.projectTitle);
                                $('#summary-program').val(result.program);
                                $('#summary-contract').val(result.contract);
                            }
                        }
                    );

                    showLoader();
                    _loaderPendingGrids = 2;
                    setTimeout(function () {
                        window['gridManager_@Model.StaffPlanGrid.GridId'].reloadGrid({ page: 1 });
                        window['gridManager_@Model.CompareStaff2Grid.GridId'].reloadGrid({ page: 1 });
                        refreshPlannedCost();
                        refreshActualTotals();
                    }, 0);
                }
            }

        function getStaffPlanExtraFilters() {
            return { jobCode: currentProjectCode };
        }

        function getCompareStaff2ExtraFilters() {
            return { projectCode: currentProjectCode };
        }

        function refreshPlannedCost() {
            if (!currentProjectCode) return;
            $.get('@Url.Action("GetTotalPlannedCost", "ProjectStaffPlanActual", new { area = "FPS" })',
                { projectCode: currentProjectCode },
                function (result) {
                    if (result.success) {
                        $('#planned-total-cost').val(formatCurrency(result.totalPlannedCost));
                        calculatePercentOfPlan();
                    }
                }
            );
        }

        function refreshActualTotals() {
            if (!currentProjectCode) return;
            $.get('@Url.Action("GetTotalActualCost", "ProjectStaffPlanActual", new { area = "FPS" })',
                { projectCode: currentProjectCode },
                function (result) {
                    if (result.success) {
                        $('#project-total-hrs').val(parseFloat(result.totalHours || 0).toFixed(2));
                        $('#project-total-cost').val(formatCurrency(result.totalCost));
                        calculatePercentOfPlan();
                    }
                }
            );
        }

        function formatCurrency(value) {
            return parseFloat(value || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }

        function calculatePercentOfPlan() {
            var plannedRaw = parseFloat($('#planned-total-cost').val().replace(/[£,\s]/g, '')) || 0;
            var actualRaw = parseFloat($('#project-total-cost').val().replace(/[£,\s]/g, '')) || 0;
            var pct = plannedRaw > 0 ? (actualRaw / plannedRaw) * 100 : 0;
            $('#project-percent-plan').val(Math.round(pct) + '%');
        }

        // ── Multi-column Project dropdown ────────────────────────────────────
        $(document).ready(function () {
            var allProjects = [];
            var display = document.getElementById('projectNameInput');
            var panel   = document.getElementById('ProjectDropdownPanel');
            var search  = document.getElementById('ProjectSearchBox');
            var body    = document.getElementById('ProjectDropdownBody');

            if (!display || !panel || !search || !body) return;

            function getFiltered() {
                var term = (search.value || '').toLowerCase();
                if (!term) return allProjects;
                return allProjects.filter(function (p) {
                    return p.parentProject.toLowerCase().includes(term)
                        || p.projectTitle.toLowerCase().includes(term);
                });
            }

            function renderRows(rows) {
                body.innerHTML = '';
                rows.forEach(function (item) {
                    var tr = document.createElement('tr');
                    tr.style.cursor = 'pointer';
                    tr.innerHTML = '<td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">' + item.parentProject + '</td>'
                                 + '<td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">' + item.projectTitle + '</td>';
                    tr.addEventListener('click', function () {
                        panel.style.display = 'none';
                        onProjectSelected(item.parentProject, item.projectTitle);
                    });
                    tr.addEventListener('mouseenter', function () { this.style.backgroundColor = '#f3f2f1'; });
                    tr.addEventListener('mouseleave', function () { this.style.backgroundColor = ''; });
                    body.appendChild(tr);
                });
            }

            function positionPanel() {
                var rect = display.getBoundingClientRect();
                panel.style.top  = rect.bottom + 'px';
                panel.style.left = Math.max(0, rect.right - 420) + 'px';
            }

            function openPanel() {
                if (allProjects.length === 0) {
                    fetch('@Url.Action("GetProjectLookup", "ProjectStaffPlanActual", new { area = "FPS" })')
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            allProjects = data;
                            search.value = '';
                            renderRows(allProjects);
                            positionPanel();
                            panel.style.display = 'block';
                            search.focus();
                        })
                        .catch(function (err) { console.error('Project lookup failed', err); });
                } else {
                    search.value = '';
                    renderRows(allProjects);
                    positionPanel();
                    panel.style.display = 'block';
                    search.focus();
                }
            }

            display.addEventListener('click', function (e) {
                e.stopPropagation();
                if (panel.style.display !== 'none') { panel.style.display = 'none'; return; }
                openPanel();
            });

            search.addEventListener('input', function () { renderRows(getFiltered()); });

            document.addEventListener('click', function (e) {
                if (!display.contains(e.target) && !panel.contains(e.target))
                    panel.style.display = 'none';
            });
        });
        // ────────────────────────────────────────────────────────────────────

        function deleteCompareStaff2(btn) {
            var rowKey = $(btn).data('id');
            if (!rowKey) return;
            showGovukConfirm('Are you sure you want to delete this record?').then(function (confirmed) {
                if (!confirmed) return;
                $.ajax({
                    url: '@Url.Action("DeleteTimeCostCalcs", "ProjectStaffPlanActual", new { area = "FPS" })',
                    type: 'DELETE',
                    data: { rowKey: rowKey },
                    success: function (result) {
                        if (result.success) {
                            window['gridManager_@Model.CompareStaff2Grid.GridId'].reloadGrid({ page: 1 });
                            refreshActualTotals();
                            showAlertMessage('Record deleted successfully.', AlertType.SUCCESS);
                        } else {
                            showAlertMessage('Delete failed: ' + (result.message || 'Unknown error'), AlertType.ERROR);
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting the record.', AlertType.ERROR);
                    }
                });
            });
        }
    </script>
}
