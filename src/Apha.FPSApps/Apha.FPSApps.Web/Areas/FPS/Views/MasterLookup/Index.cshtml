@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.MasterLookupMaintenanceViewModel

@{
    ViewData["Title"] = "Master Lookup Maintenance";
}

<main id="main-content" class="isClearfix isNoGlobalScrollBar">
    <div class="container-fluid">
        <!-- Title section -->
        <div class="govuk-grid-row sup_border-bottom govuk-!-margin-bottom-3">
            <div class="govuk-grid-column-one-full govuk-!-margin-bottom-3">
                <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-3 govuk-!-margin-left-3 isCustomPageHeadings">
                    Master Lookup Maintenance
                </h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">
                                    <!-- Left side: lookup table list -->
                                    <div style="margin-right: 8px;">
                                        <nav class="sidenav flex-column flex-shrink-0" aria-label="Lookup tables">
                                             <button class="toggle-btn" onclick="toggleSidebar()" style="right: -8px; top: 30px;" aria-label="Toggle sidebar">
                                                <img src="/images/chevron-left-solid-full.svg" alt="side nav menu arrow" width="24">
                                            </button>
                                            <ul class="govuk-list" id="lookupTableList" style="margin:0;">
                                                @foreach (var tableName in Model.TableNames)
                                                {
                                                    var isSelected = string.Equals(tableName, Model.SelectedTable, StringComparison.OrdinalIgnoreCase);
                                                    <li>
                                                        <a href="#"
                                                           class="dropdown-item sidenav-title @(isSelected ? "lookup-table-link--active" : string.Empty)"
                                                           data-table="@tableName"
                                                           onclick="selectLookupTable(event, '@tableName')">
                                                            @tableName
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </nav>
                                    </div>

                                    <!-- Right side: DataGrid for selected table -->
                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full">
                                                <div id="gridContainer_lookupItemGrid">
                                                    @if (Model.ItemGrid != null)
                                                    {
                                                        @await Html.PartialAsync("_DataGrid", Model.ItemGrid)
                                                    }
                                                    else
                                                    {
                                                        <p class="govuk-body" id="noTableSelectedMessage">Select a table on the left to manage its values.</p>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        // Tracks the currently selected lookup table name.
        var currentLookupTable = '@(Model.SelectedTable ?? string.Empty)';

        // ExtraFilterMethod hook: the _DataGrid partial calls this on every reload
        // (sort, search, filter, pagination) and merges the result into the request,
        // so the selected table always travels with the grid's own state.
        window.getLookupExtraFilters = function () {
            return { tableName: currentLookupTable || '' };
        };

        // Loads the grid for the chosen table into the right-hand pane.
        function selectLookupTable(evt, tableName) {
            if (evt) { evt.preventDefault(); }
            currentLookupTable = tableName;

            $('.lookup-table-link').removeClass('lookup-table-link--active');
            $(".lookup-table-link[data-table='" + tableName.replace(/'/g, "\\'") + "']").addClass('lookup-table-link--active');

            $.ajax({
                url: '@Url.Action("LoadItemsGrid", "MasterLookup", new { area = "FPS" })',
                type: 'POST',
                data: { tableName: tableName, page: 1 },
                success: function (html) {
                    $('#gridContainer_lookupItemGrid').html(html);
                },
                error: function () {
                    showAlertMessage('An error occurred while loading the table', AlertType.ERROR);
                }
            });
        }

        // Add item
        function addLookupItem(btn) {
            if (!currentLookupTable) { return; }
            $.ajax({
                url: '@Url.Action("Create", "MasterLookup", new { area = "FPS" })',
                type: 'GET',
                data: { tableName: currentLookupTable },
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass("show");
                },
                error: function () {
                    showAlertMessage('An error occurred while loading the form', AlertType.ERROR);
                }
            });
        }

        // Edit item
        function editLookupItem(btn) {
            var value = $(btn).data('id');
            $.ajax({
                url: '@Url.Action("Edit", "MasterLookup", new { area = "FPS" })',
                type: 'GET',
                data: { tableName: currentLookupTable, value: value },
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass("show");
                },
                error: function () {
                    showAlertMessage('An error occurred while editing record', AlertType.ERROR);
                }
            });
        }

        // Delete item
        function deleteLookupItem(btn) {
            var value = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this record?').then(function (result) {
                if (!result) return;
                $.ajax({
                    url: '@Url.Action("Delete", "MasterLookup", new { area = "FPS" })',
                    type: 'DELETE',
                    data: { tableName: currentLookupTable, value: value },
                    success: function (response) {
                        if (response.success) {
                            showAlertMessage('Deleted successfully', AlertType.SUCCESS).then(function () {
                                reloadLookupGrid();
                            });
                        } else {
                            showAlertMessage('Error: ' + response.message, AlertType.ERROR);
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting', AlertType.ERROR);
                    }
                });
            });
        }

        // Checks value uniqueness before submitting, then invokes onAvailable().
        function checkLookupItemAvailable(value, originalValue, onAvailable) {
            $.ajax({
                url: '@Url.Action("CheckItemExists", "MasterLookup", new { area = "FPS" })',
                type: 'GET',
                data: { tableName: currentLookupTable, value: value, originalValue: originalValue || '' },
                success: function (result) {
                    if (result && result.exists) {
                        displayServerValidationErrors(
                            [{ field: 'Value', message: "'" + value + "' already exists." }],
                            'There is a problem',
                            '#modaPopupBody');
                    } else {
                        onAvailable();
                    }
                },
                error: function () {
                    onAvailable();
                }
            });
        }

        // Shared submit pipeline for the add/edit modals.
        function submitLookupItemForm(formSelector, url, originalValue) {
            clearValidationErrors('#modaPopupBody');
            var form = $(formSelector);

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var data = { Value: form.find('[name="Value"]').val() };

            checkLookupItemAvailable(data.Value, originalValue, function () {
                $.ajax({
                    url: url,
                    type: 'POST',
                    data: JSON.stringify(data),
                    contentType: 'application/json; charset=utf-8',
                    success: function (result) {
                        if (result.success) {
                            closeModal();
                            showAlertMessage(result.message, AlertType.SUCCESS).then(function () {
                                reloadLookupGrid();
                            });
                        } else {
                            displayServerValidationErrors(result.errors || [], result.message, '#modaPopupBody');
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while saving', AlertType.ERROR);
                    }
                });
            });
        }

        function saveLookupItem() {
            var url = '@Url.Action("Create", "MasterLookup", new { area = "FPS" })?tableName=' + encodeURIComponent(currentLookupTable);
            submitLookupItemForm('#addLookupItemForm', url, null);
        }

        function updateLookupItem() {
            var originalValue = $('#originalValue').val();
            var url = '@Url.Action("Edit", "MasterLookup", new { area = "FPS" })'
                + '?tableName=' + encodeURIComponent(currentLookupTable)
                + '&originalValue=' + encodeURIComponent(originalValue);
            submitLookupItemForm('#editLookupItemForm', url, originalValue);
        }

        // Reloads the grid for the current table (used after add/edit/delete).
        function reloadLookupGrid() {
            if (window['gridManager_lookupItemGrid'] && currentLookupTable) {
                window['gridManager_lookupItemGrid'].reloadGrid({ page: 1 });
            } else {
                selectLookupTable(null, currentLookupTable);
            }
        }

        function closeModal() {
            clearValidationErrors('#modaPopupBody');
            $('#modaPopupBody').html("");
            $('#modalPopup').removeClass("show");
        }

        // Returns true if all required fields in the form have values.
        function isFormValid(form) {
            var isValid = true;
            form.find('[required]').each(function () {
                if (!$(this).val() || $(this).val().trim() === '') {
                    isValid = false;
                    return false;
                }
            });
            return isValid;
        }

         function toggleSidebar() {
            document.querySelector('.sidenav')?.classList.toggle('collapsed');
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
