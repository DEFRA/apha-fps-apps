@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.BudgetResourceLevelViewModel
@inject Apha.FPSApps.Web.Handler.IFpsYearContext FpsYearContext

@{
    ViewData["Title"] = "Budget Bids for Resource Centre";
}


<main id="main-content">
    <div class="govuk-grid-row sup_margin_left_right_0">
        <div class="govuk-grid-column-full">
            <h1 class="govuk-grid-row sup_border-bottom govuk-!-font-size-19 sup_pad_top_bottom_5_10">
                <div class="sup_flex_between_center">
                    <div class="sup_flex_left_center">
                        Budget Bids for Resource Centre....
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedProfitCentre))
                        {
                            <div class="display-flex sup_margin_left_5">
                                <div class="m-0 p-0 sup_flex_row_center_center sup_margin_left_5">
                                    <span class="govuk-!-font-size-19 govuk-!-font-weight-bold sup_gov_blue_color sup_blue_border_bottom_2">@Model.SelectedProfitCentre</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div>
                        <form asp-action="Index" asp-controller="BudgetResourceLevel" asp-area="FPS" method="get" class="sup_flex_align_center">
                            <input type="hidden" name="year" value="@FpsYearContext.Year" />
                            <label class="govuk-label pva-nowrap-label govuk-!-padding-right-1" for="profitCentreSelect">Resource Centre:</label>
                            <select id="profitCentreSelect"
                                    name="profitCentre"
                                    asp-items="Model.ProfitCentreList"
                                    class="govuk-select govuk-!-font-size-16 brl-profit-centre-select"
                                    onchange="this.form.submit()">
                                <option value="">-- Select Resource Centre --</option>
                            </select>
                        </form>
                    </div>
                </div>
            </h1>
        </div>
    </div>

    <!-- Three-panel layout: WorkGroups | Budget Bids | Purchases -->
    <div class="govuk-grid-row sup_margin_left_right_0 sup_margin_10 sup_margin_top_0">

        <!-- Left: WorkGroup selector -->
        <div class="govuk-grid-column-one-third sup_p_0">
            <div class="sup_border sup_margin_bottom_10 sup_margin_right_10 brl-workgroup-grid">
                <div class="sup_justify_content sup_padding_right_left_10 sup_margin_tb_13">
                    <h2 class="govuk-!-font-size-16 sup_margin_5">(1) First Select a WorkGroup</h2>
                </div>
                <div id="gridContainer_workGroupGrid">
                    @await Html.PartialAsync("_DataGrid", Model.WorkGroupGrid)
                </div>
            </div>
            <div class="sup_padding_16 sup_margin_right_10 brl-action-buttons">
                <div class="brl-action-btn-row">
                    <button type="button" class="govuk-button govuk-!-margin-bottom-0 brl-action-btn" onclick="selectByAccount()">
                        Select by Account<br />[Rather than WorkGroup]
                    </button>
                </div>
                <div class="brl-action-btn-row">
                    <button type="button" class="govuk-button govuk-button--secondary sup_gov_blue_bg govuk-!-margin-bottom-0 brl-action-btn" onclick="viewReport()">
                        View Report
                    </button>
                </div>
                <div class="brl-action-btn-row">
                    <button type="button" class="govuk-button govuk-button--secondary sup_gov_blue_bg govuk-!-margin-bottom-0 brl-action-btn" onclick="sendToExcel()">
                        Send To Excel
                    </button>
                </div>
            </div>
        </div>

        <!-- Centre: Budget Bids grid -->
        <div class="govuk-grid-column-one-third sup_p_0">
            <div class="sup_border sup_margin_right_10">
                <div class="sup_flex_end_space sup_p_5 sup_border-bottom">
                    <div class="sup_flex_between_center sup_padding_right_left_5 govuk-grid-column-full">
                        <div>
                            <label class="govuk-!-font-size-16 sup_margin_0 govuk-!-font-weight-bold" for="fpsBrlSelectedWg">(2) Now Update the Budgets for WG</label>
                            <input id="fpsBrlSelectedWg"
                                   type="text"
                                   class="govuk-input govuk-!-font-size-16 sup_max_width_8em sup_margin_left_5"
                                   aria-label="Selected work group" readonly value="@Model.SelectedWorkgroup" />
                        </div>
                        <button type="button" class="govuk-button sup_margin_0 govuk-!-margin-bottom-2" onclick="addBudgetBid()">
                            + Add
                        </button>
                    </div>
                    </div>
                <div id="gridContainer_budgetBidsGrid">
                    @await Html.PartialAsync("_DataGrid", Model.BudgetBidsGrid)
                </div>
            </div>
            <div class="sup_padding_16 sup_flex_start_center sup_margin_top_10">
                <label class="govuk-body-s sup_margin_0" for="fpsBrlTotalBid">Total Bid for Workgroup: </label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input id="fpsBrlTotalBid" type="text" class="govuk-input govuk-!-font-size-16 sup_text_align_right" readonly
                           value="@Model.TotalBid.ToString("N2")" />
                </div>
            </div>
        </div>

        <!-- Right: Purchases grid -->
        <div class="govuk-grid-column-one-third sup_p_0">
            <div class="sup_border">
                <div class="sup_flex_end_space sup_p_5 sup_border-bottom">
                    <div class="sup_flex_between_center sup_padding_right_left_5 govuk-grid-column-full">
                        <div>
                            <label class="govuk-!-font-size-16 sup_margin_0 govuk-!-font-weight-bold">(3) Purchases in</label>
                            <input id="fpsBrlSelectedAccount"
                                   type="text"
                                   class="govuk-input govuk-!-font-size-16 govuk-input--width-5"
                                   aria-label="Selected account" readonly value="@Model.SelectedAccount" />
                            <label class="govuk-!-font-size-16 sup_margin_0 govuk-!-font-weight-bold">in Workgroup</label>
                            <input id="fpsBrlPurchasesWg"
                                   type="text"
                                   class="govuk-input govuk-!-font-size-16 govuk-input--width-5"
                                   aria-label="Selected workgroup for purchases" readonly value="@Model.SelectedWorkgroup" />
                        </div>
                        <button type="button" class="govuk-button sup_margin_0 govuk-!-margin-bottom-2" onclick="addPurchase()">
                            + Add
                        </button>
                    </div>
                </div>
                <div id="gridContainer_purchasesGrid">
                    @await Html.PartialAsync("_DataGrid", Model.PurchasesGrid)
                </div>
            </div>
            <div class="sup_padding_16 sup_flex_start_center sup_margin_top_10">
                <label class="govuk-body-s sup_margin_0" for="fpsBrlTotalPurchases">Total Purchases: </label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input id="fpsBrlTotalPurchases" type="text" class="govuk-input govuk-!-font-size-16 sup_text_align_right" readonly
                           value="@Model.TotalPurchases.ToString("N2")" />
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Modal container -->
<div id="modalContainer" class="brl-modal-container">
    <div class="modal-dialog modal-lg brl-modal-dialog-center" role="dialog" aria-modal="true">
        <div id="modalContent" class="modal-content sup_overflow_visible"></div>
    </div>
</div>

@section Scripts {
<script src="~/js/ajax-form-validation.js"></script>
<script>
    // ─── Server-rendered state ───────────────────────────────────────────────
    var currentWorkgroup    = '@Html.Raw(Model.SelectedWorkgroup ?? "")';
    var currentAccount      = '@Html.Raw(Model.SelectedAccount ?? "")';
    var currentProfitCentre = '@Html.Raw(Model.SelectedProfitCentre ?? "")';
    var currentYear         = @FpsYearContext.Year;
</script>
<script src="~/js/fps_js/budget-resource-level.js"></script>
@if (!string.IsNullOrWhiteSpace(Model.SelectedProfitCentre))
{
    <text>
    <script>
        $(document).ready(function () {
            var mgr = getWorkGroupGridManager();
            if (mgr) mgr.reloadGrid({ page: 1 });
        });
    </script>
    </text>
}
}
