@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.BudgetResourceLevelViewModel
@inject Apha.FPSApps.Web.Handler.IFpsYearContext FpsYearContext

@{
    ViewData["Title"] = "Budget Bids for Resource Centre";
}

<style type="text/css">
    #gridContainer_workGroupGrid .grid-scroll-container {
        height: 400px;
        max-height: 400px;
    }
    #gridContainer_budgetBidsGrid .grid-scroll-container {
        height: 300px;
        max-height: 300px;
    }
    #gridContainer_purchasesGrid .grid-scroll-container {
        height: 300px;
        max-height: 300px;
    }
</style>

<main id="main-content">
    <div class="container-fluid">
        <!-- Breadcrumb -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="row fps-sr-breadcrumb-row align-items-center">
                    <div class="col-md-6">
                        <nav class="govuk-breadcrumbs govuk-!-padding-left-3" aria-label="Breadcrumb">
                            <ol class="govuk-breadcrumbs__list">
                                <li class="govuk-breadcrumbs__list-item">
                                    <a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "Home", new { area = "FPS" })">Home</a>
                                </li>
                                <li class="govuk-breadcrumbs__list-item">Budget</li>
                                <li class="govuk-breadcrumbs__list-item" aria-current="page">Budget Bids for Resource Centre</li>
                            </ol>
                        </nav>
                    </div>
                    <div style="display: flex; justify-content: flex-end;" class="col-md-6">
                        <form asp-action="Index" asp-controller="BudgetResourceLevel" asp-area="FPS" method="get" style="display: flex; align-items: center;">
                            <input type="hidden" name="year" value="@FpsYearContext.Year" />
                            <label class="fw-bold mt-2" for="profitCentreSelect">Resource Centre:</label>
                            <select id="profitCentreSelect"
                                    name="profitCentre"
                                    asp-items="Model.ProfitCentreList"
                                    class="govuk-select govuk-!-font-size-16"
                                    style="width: auto; min-width: 260px;"
                                    onchange="this.form.submit()">
                                <option value="">-- Select Resource Centre --</option>
                            </select>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Page Title -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    Budget Bids for Resource Centre
                    @if (!string.IsNullOrWhiteSpace(Model.SelectedProfitCentre))
                    {
                        <span class="govuk-link">@Model.SelectedProfitCentre</span>
                    }
                </h1>
            </div>
        </div>

        <!-- Three-panel layout: WorkGroups | Budget Bids | Purchases -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="data-table-container sup_border govuk-!-margin-left-2 govuk-!-padding-3">
                    <div class="row" style="align-items: flex-start;">

                        <!-- Left: WorkGroup selector -->
                        <div class="col-3" style="border-right: 1px solid #b1b4b6;">
                            <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Select Work Group</h3>
                            <div id="gridContainer_workGroupGrid">
                                @await Html.PartialAsync("_DataGrid", Model.WorkGroupGrid)
                            </div>
                        </div>

                        <!-- Centre: Budget Bids grid -->
                        <div class="col-5" style="border-right: 1px solid #b1b4b6;">
                            <div class="d-flex align-items-center gap-3 govuk-!-margin-bottom-2">
                                <h3 class="govuk-heading-s govuk-!-margin-bottom-0" style="white-space: nowrap;">Budget Bids for Work Group</h3>
                                <input id="fpsBrlSelectedWg"
                                       class="govuk-input"
                                       style="width: auto; min-width: 120px;"
                                       aria-label="Selected work group" readonly value="@Model.SelectedWorkgroup" />
                            </div>
                            <div id="gridContainer_budgetBidsGrid">
                                @await Html.PartialAsync("_DataGrid", Model.BudgetBidsGrid)
                            </div>
                            <table class="govuk-table govuk-!-margin-top-0 govuk-!-margin-bottom-0" style="width: 100%; border-top: 2px solid #b1b4b6;">
                                <tbody>
                                    <tr class="govuk-table__row" style="background-color: #f3f2f1;">
                                        <td class="govuk-table__cell" style="font-weight:bold;">Total Bid for WG</td>
                                        <td class="govuk-table__cell" id="fpsBrlTotalBid" style="text-align:right; font-weight:bold;">@Model.TotalBid.ToString("C")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Right: Purchases grid -->
                        <div class="col-4">
                            <div class="d-flex align-items-center gap-3 govuk-!-margin-bottom-2">
                                <h3 class="govuk-heading-s govuk-!-margin-bottom-0" style="white-space: nowrap;">Purchases for Account</h3>
                                <input id="fpsBrlSelectedAccount"
                                       class="govuk-input"
                                       style="width: auto; min-width: 120px;"
                                       aria-label="Selected account" readonly value="@Model.SelectedAccount" />
                            </div>
                            <div id="gridContainer_purchasesGrid">
                                @await Html.PartialAsync("_DataGrid", Model.PurchasesGrid)
                            </div>
                            <table class="govuk-table govuk-!-margin-top-0 govuk-!-margin-bottom-0" style="width: 100%; border-top: 2px solid #b1b4b6;">
                                <tbody>
                                    <tr class="govuk-table__row" style="background-color: #f3f2f1;">
                                        <td class="govuk-table__cell" style="font-weight:bold;">Total Purchases</td>
                                        <td class="govuk-table__cell" id="fpsBrlTotalPurchases" style="text-align:right; font-weight:bold;">@Model.TotalPurchases.ToString("C")</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Modal container -->
<div id="modalContainer" class="modal-backdrop" style="display:none;">
    <div class="modal-dialog modal-lg" role="dialog" aria-modal="true">
        <div id="modalContent" class="modal-content"></div>
    </div>
</div>

@section Scripts {
<script>
    // ─── Shared state ───────────────────────────────────────────────────────────
    var currentWorkgroup = '@Html.Raw(Model.SelectedWorkgroup ?? "")';
    var currentAccount   = '@Html.Raw(Model.SelectedAccount ?? "")';
    var currentProfitCentre = '@Html.Raw(Model.SelectedProfitCentre ?? "")';

    // ─── WorkGroup grid — row click handler ────────────────────────────────────
    function getWorkGroupExtraFilters() {
        return { profitCentre: currentProfitCentre };
    }

    $(document).on('click', '#gridContainer_workGroupGrid tbody tr', function () {
        var workgroupName = $(this).find('td[data-field="WorkgroupName"]').text().trim()
                         || $(this).data('id');
        if (!workgroupName) return;

        currentWorkgroup = workgroupName;
        $('#fpsBrlSelectedWg').val(workgroupName);

        // Reload budget bids grid
        reloadGrid('budgetBidsGrid');
    });

    // ─── Budget Bids grid extra filters ────────────────────────────────────────
    function getBudgetBidExtraFilters() {
        return { workgroup: currentWorkgroup };
    }

    // ─── Budget Bids row click — select account ─────────────────────────────────
    $(document).on('click', '#gridContainer_budgetBidsGrid tbody tr', function () {
        var account = $(this).find('td[data-field="Account"]').text().trim()
                   || $(this).data('id');
        if (!account) return;

        currentAccount = account;
        $('#fpsBrlSelectedAccount').val(account);

        // Reload purchases grid
        reloadGrid('purchasesGrid');
    });

    // ─── Purchases grid extra filters ──────────────────────────────────────────
    function getPurchaseExtraFilters() {
        return { workgroup: currentWorkgroup, account: currentAccount };
    }

    // ─── Budget Bid CRUD ────────────────────────────────────────────────────────
    function addBudgetBid() {
        if (!currentWorkgroup) { alert('Please select a work group first.'); return; }
        openModal('/FPS/BudgetResourceLevel/CreateBudgetBid?workgroupName=' + encodeURIComponent(currentWorkgroup));
    }

    function editBudgetBid(btn) {
        var account = $(btn).data('id');
        openModal('/FPS/BudgetResourceLevel/EditBudgetBid?workgroupName=' + encodeURIComponent(currentWorkgroup) + '&account=' + encodeURIComponent(account));
    }

    function deleteBudgetBid(btn) {
        var account = $(btn).data('id');
        if (!confirm('Are you sure you want to delete this budget bid?')) return;
        $.ajax({
            url: '/FPS/BudgetResourceLevel/DeleteBudgetBid?workgroupName=' + encodeURIComponent(currentWorkgroup) + '&account=' + encodeURIComponent(account),
            type: 'DELETE',
            success: function (response) {
                if (response.success) {
                    showSuccess(response.message);
                    reloadGrid('budgetBidsGrid');
                } else {
                    showError(response.message || 'Failed to delete budget bid.');
                }
            }
        });
    }

    function saveBudgetBid() {
        var form = $('#formAddBudgetBid');
        submitFormAsJson(form, '/FPS/BudgetResourceLevel/CreateBudgetBid', function (response) {
            if (response.success) {
                closeModal();
                showSuccess(response.message);
                reloadGrid('budgetBidsGrid');
            } else {
                showModalErrors(response.errors);
            }
        });
    }

    function updateBudgetBid() {
        var form = $('#formEditBudgetBid');
        submitFormAsJson(form, '/FPS/BudgetResourceLevel/EditBudgetBid', function (response) {
            if (response.success) {
                closeModal();
                showSuccess(response.message);
                reloadGrid('budgetBidsGrid');
            } else {
                showModalErrors(response.errors);
            }
        });
    }

    // ─── Purchase CRUD ──────────────────────────────────────────────────────────
    function addPurchase() {
        if (!currentWorkgroup || !currentAccount) { alert('Please select a work group and account first.'); return; }
        openModal('/FPS/BudgetResourceLevel/CreatePurchase?workgroupName=' + encodeURIComponent(currentWorkgroup) + '&account=' + encodeURIComponent(currentAccount));
    }

    function editPurchase(btn) {
        var itemDescription = $(btn).data('id');
        openModal('/FPS/BudgetResourceLevel/EditPurchase?workgroupName=' + encodeURIComponent(currentWorkgroup) + '&account=' + encodeURIComponent(currentAccount) + '&itemDescription=' + encodeURIComponent(itemDescription));
    }

    function deletePurchase(btn) {
        var itemDescription = $(btn).data('id');
        if (!confirm('Are you sure you want to delete this purchase?')) return;
        $.ajax({
            url: '/FPS/BudgetResourceLevel/DeletePurchase?workgroupName=' + encodeURIComponent(currentWorkgroup) + '&account=' + encodeURIComponent(currentAccount) + '&itemDescription=' + encodeURIComponent(itemDescription),
            type: 'DELETE',
            success: function (response) {
                if (response.success) {
                    showSuccess(response.message);
                    reloadGrid('purchasesGrid');
                } else {
                    showError(response.message || 'Failed to delete purchase.');
                }
            }
        });
    }

    function savePurchase() {
        var form = $('#formAddPurchase');
        submitFormAsJson(form, '/FPS/BudgetResourceLevel/CreatePurchase', function (response) {
            if (response.success) {
                closeModal();
                showSuccess(response.message);
                reloadGrid('purchasesGrid');
            } else {
                showModalErrors(response.errors);
            }
        });
    }

    function updatePurchase() {
        var form = $('#formEditPurchase');
        submitFormAsJson(form, '/FPS/BudgetResourceLevel/EditPurchase', function (response) {
            if (response.success) {
                closeModal();
                showSuccess(response.message);
                reloadGrid('purchasesGrid');
            } else {
                showModalErrors(response.errors);
            }
        });
    }

    // ─── If profitCentre already selected, load workgroups ──────────────────────
    @if (!string.IsNullOrWhiteSpace(Model.SelectedProfitCentre))
    {
        <text>
        $(document).ready(function () {
            reloadGrid('workGroupGrid');
        });
        </text>
    }
</script>
}
