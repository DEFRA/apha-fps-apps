@model Apha.FPSApps.Web.Areas.FPS.Models.PurchaseItem
@{
    var isEditMode = !string.IsNullOrEmpty(Model.WorkgroupName) && !string.IsNullOrEmpty(Model.Account) && !string.IsNullOrEmpty(Model.ItemDescription);
    var title      = isEditMode ? "Update Purchase" : "Add Purchase";
    var formId     = isEditMode ? "formEditPurchase" : "formAddPurchase";
    var saveLabel  = isEditMode ? "Update" : "Save";
    var saveAction = isEditMode ? "updatePurchase()" : "savePurchase()";
}

<div class="modal-header flex-space-center">
    <h3 class="modal-title" style="margin: 0;" id="purchaseModalLabel">@title</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>
<div class="modal-body" style="overflow-y: auto; max-height: calc(80vh - 120px);">
    <div class="govuk-error-summary" role="alert"
         aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list" id="modalErrorList"></ul>
        </div>
    </div>
    <form class="row" id="@formId">
        <input type="hidden" asp-for="WorkgroupName" id="WorkgroupName" />
        <input type="hidden" asp-for="Account" id="Account" />
        @if (isEditMode)
        {
            <input type="hidden" asp-for="ItemDescription" id="OldItemDescription" />
        }
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="ItemDescription" class="govuk-label p-0">Item Description <span class="sup_color_red">*</span></label>
                <input type="text" asp-for="ItemDescription" id="ItemDescription" class="govuk-input sup_width_100" maxlength="50">
                <span asp-validation-for="ItemDescription" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="Amount" class="govuk-label" asp-for="Amount">Amount <span class="sup_color_red">*</span></label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="number" step="0.01" asp-for="Amount" class="govuk-input" id="Amount">
                </div>
                <span asp-validation-for="Amount" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer sup_flex_space_center">
    <button class="govuk-button govuk-button--secondary sup_margin_0" data-module="govuk-button" onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" data-module="govuk-button" type="button" onclick="@saveAction">@saveLabel</button>
</div>
