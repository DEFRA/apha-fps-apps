@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.AnimalCostsViewModel
@{
    ViewData["Title"] = "ASU Data View";
}

<div class="govuk-!-margin-bottom-5">
    <div class="govuk-grid-row sup_border-bottom govuk-!-margin-bottom-3">
        <div class="govuk-grid-column-one-half govuk-!-margin-bottom-3">
            <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-3 govuk-!-margin-left-3 isCustomPageHeadings">
                ASU Data View
            </h1>
        </div>

        <div class="govuk-grid-column-one-half govuk-!-margin-bottom-0 govuk-!-margin-top-0">
            <!-- Animal Type multicolumn dropdown (mirrors pickAnimalType RowSource on frmAnimalCosts) -->
            <div class="govuk-form-group govuk-!-margin-bottom-0 govuk-!-margin-top-0  govuk-!-margin-right-3 isFloatRight isSelectDropdown"
                 id="animal-type-dropdown">                
                <div class="govuk-grid-row govuk-!-margin-bottom-0 isAnimalTypeSelector govuk-!-margin-top-1">
                    <div class="govuk-grid-column-one-half govuk-!-text-align-right govuk-!-padding-right-1 govuk-!-margin-top-2">
                        <label class="govuk-label govuk-!-font-weight-bold" for="animal-type-input">
                            Choose an Animal Type:
                        </label>
                    </div>
                    <div class="govuk-grid-column-one-half govuk-!-padding-left-0 govuk-!-margin-top-1">
                        <input type="text"
                               id="animal-type-input"
                               value="Choose an animal type"
                               class="dropdown-input down-arrow-img govuk-input govuk-!-font-size-16"
                               readonly
                               aria-label="Choose an animal type">
                    </div>
                </div>

                <div class="multicolumn-dropdown-panel isAnimalTypePanel" id="animal-type-panel">
                    <div class="search-box-wrapper">
                        <input type="text"
                               class="search-box"
                               id="animal-type-search"
                               placeholder="Type to search animal type"
                               aria-label="Type to search animal type">
                    </div>
                    <table class="govuk-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Animal Type</th>
                                <th scope="col" class="govuk-table__header">Daily Rate</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body" id="animal-type-body"></tbody>
                    </table>
                </div>
            </div>
        </div>            
    </div>

    <div class="govuk-grid-row sup_margin_left_right_10">
        <!-- Left column: filter + grid + totals -->
        <div class="govuk-grid-column-two-thirds govuk-!-padding-left-0 govuk-!-padding-right-0">

            

            <!-- Read-only animal costs DataGrid (fsubAnimalCosts — DefaultView=2, all Allow* disabled) -->
            <div id="gridContainer_@Model.AnimalCostsGrid.GridId">
                @await Html.PartialAsync("_DataGrid", Model.AnimalCostsGrid)
            </div>

            <!-- Summary totals (fsubAnimalCosts footer: TotalAnimalDays + TotalAnimalCost) -->
            <div class="asu-summary-row govuk-!-margin-bottom-2">
                <div class="govuk-form-group govuk-!-margin-bottom-0">
                    <label class="govuk-label govuk-label--s govuk-!-margin-bottom-0" for="asuTotalDays">
                        Total Animal Days
                    </label>
                    <input type="text"
                           id="asuTotalDays"
                           class="govuk-input text-AlignRight pva-input-95"
                           value="0"
                           readonly
                           aria-label="Total animal days">
                </div>
                <div class="govuk-form-group govuk-!-margin-bottom-0">
                    <label class="govuk-label govuk-label--s govuk-!-margin-bottom-0" for="asuTotalCost">
                        Total Cost
                    </label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="text"
                           id="asuTotalCost"
                           class="govuk-input text-AlignRight pva-input-160"
                           value="0.00"
                           readonly
                           aria-label="Total cost">
                </div>
                </div>
            </div>
        </div>

        <div class="govuk-grid-column-one-third govuk-!-padding-right-0">
            <div class="pva-summary-card asu-side-card govuk-!-margin-top-0">
                <div class="asu-side-actions">
                     <button type="button"
                             id="asuExportBtn"
                             class="govuk-button govuk-button--primary asu-side-button"
                             data-module="govuk-button"
                             onclick="exportAnimalCosts()">
                         Download Animal data<br>For email attachment
                     </button>
                </div>
            </div>
       </div>
    </div>
</div>

@section Scripts {
    <script>
        // Animal type data loaded from the API (mirrors pickAnimalType RowSource on frmAnimalCosts)
        let animalTypeData = [];
        let currentAnimalType = '';

        // ── Initialise the grid and populate the animal type dropdown on page load ──

        document.addEventListener('DOMContentLoaded', function () {
            loadAnimalTypes();

            // DataGrid dispatches 'gridReloaded' on document after each ajax replacement
            document.addEventListener('gridReloaded', function (e) {
                if (e && e.detail && e.detail.gridId === '@Model.AnimalCostsGrid.GridId') {
                    calculateAnimalCostTotals();
                }
            });
        });

        function loadAnimalTypes() {
            $.getJSON('@Url.Action("GetAnimalTypes", "AnimalCosts", new { area = "FPS" })',
                function (result) {
                    if (!result.success) return;
                    animalTypeData = result.data;
                    renderAnimalTypeDropdownRows(animalTypeData);
                });
        }

        function renderAnimalTypeDropdownRows(items) {
            const tbody = document.getElementById('animal-type-body');
            tbody.innerHTML = '';
            items.forEach(function (item) {
                const tr = document.createElement('tr');
                tr.style.cursor = 'pointer';
                tr.setAttribute('tabindex', '0');
                tr.setAttribute('role', 'option');
                tr.innerHTML = '<td>' + escapeHtml(item.label) + '</td><td>' + escapeHtml(item.dailyRate) + '</td>';
                tr.addEventListener('click', function () {
                    selectAnimalType(item.value, item.label);
                });
                tr.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        selectAnimalType(item.value, item.label);
                    } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                        e.preventDefault();
                        const rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
                        const index = rows.indexOf(tr) + (e.key === 'ArrowDown' ? 1 : -1);
                        const clamped = Math.max(0, Math.min(rows.length - 1, index));
                        rows[clamped].focus();
                        rows[clamped].scrollIntoView({ block: 'nearest' });
                    } else if (e.key === 'Escape') {
                        document.getElementById('animal-type-panel').style.display = 'none';
                    }
                });
                tbody.appendChild(tr);
            });

            // Layer accessible names onto the newly rendered rows without
            // touching the markup/behaviour above (see enhanceAnimalTypeDropdownAccessibility).
            enhanceAnimalTypeDropdownAccessibility(items);
        }

        function selectAnimalType(value, label) {
            currentAnimalType = value;
            document.getElementById('animal-type-input').value = label;
            document.getElementById('animal-type-panel').style.display = 'none';


            // Reset totals while grid reloads
            document.getElementById('asuTotalDays').value = '0';
            document.getElementById('asuTotalCost').value = '0.00';

            // Reload the DataGrid with the selected animal type as an extra filter
            window['gridManager_@Model.AnimalCostsGrid.GridId'].reloadGrid({ page: 1 });
        }

        // ── Animal type dropdown toggle / search ──

        document.getElementById('animal-type-input').addEventListener('click', function () {
            const panel = document.getElementById('animal-type-panel');
            panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
        });


        document.getElementById('animal-type-search').addEventListener('input', function () {
            const term = this.value.toLowerCase();
            const filtered = animalTypeData.filter(function (item) {
                return item.label.toLowerCase().includes(term);
            });
            renderAnimalTypeDropdownRows(filtered);
        });

        document.getElementById('animal-type-input').addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                const panel = document.getElementById('animal-type-panel');
                const isOpen = panel.style.display === 'block';
                panel.style.display = isOpen ? 'none' : 'block';
                if (!isOpen) {
                    const searchBox = document.getElementById('animal-type-search');
                    if (searchBox) searchBox.focus();
                }
            } else if (e.key === 'Escape') {
                document.getElementById('animal-type-panel').style.display = 'none';
            }
        });
        document.getElementById('animal-type-search').addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                const firstRow = document.querySelector('#animal-type-body tr');
                if (firstRow) {
                    firstRow.focus();
                    firstRow.scrollIntoView({ block: 'nearest' });
                }
            } else if (e.key === 'Escape') {
                document.getElementById('animal-type-panel').style.display = 'none';
            }
        });

        document.addEventListener('click', function (e) {
            const wrapper = document.getElementById('animal-type-dropdown');
            if (!wrapper.contains(e.target)) {
                document.getElementById('animal-type-panel').style.display = 'none';
            }
        });

        // ── Accessibility enhancement ──
        // The dropdown rows already use role="option" and native focus/keyboard
        // handling above; the only gap is that screen readers read raw cell text
        // without the column headings, so a row announces just "Cattle 12.50"
        // instead of identifying which value is which. This adds an aria-label
        // per row combining both column names with their values, e.g.
        // "Animal Type Cattle, Daily Rate 12.50", called from
        // renderAnimalTypeDropdownRows without changing any existing function.

        function enhanceAnimalTypeDropdownAccessibility(items) {
            const tbody = document.getElementById('animal-type-body');
            if (!tbody) return;

            var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
            rows.forEach(function (row, idx) {
                var item = items[idx];
                if (!item) return;
                row.setAttribute('aria-label',
                    'Animal Type ' + (item.label || '') + ', Daily Rate ' + (item.dailyRate || ''));
            });
        }

        // ── Export the currently selected animal type's cost records to Excel ──

        function exportAnimalCosts() {

            const url = '@Url.Action("Export", "AnimalCosts", new { area = "FPS" })'
            downloadFile(url, 'AnimalCosts.xlsx');
        }

        // ── Extra filter passed to LoadAnimalCostsGrid (mirrors fsubAnimalCosts LinkMasterFields) ──

        function getAnimalCostsExtraFilters() {
            return { animalType: currentAnimalType || '' };
        }

        // ── Recompute summary totals after each grid reload (replaces fsubAnimalCosts footer Sum expressions) ──

        function calculateAnimalCostTotals() {
            let totalDays = 0;
            let totalCost = 0;

            $('#gridContainer_@Model.AnimalCostsGrid.GridId td[data-property="TotalDays"] span').each(function () {
                totalDays += parseFloat($(this).text().replace(/[,\s]/g, '')) || 0;
            });

            $('#gridContainer_@Model.AnimalCostsGrid.GridId td[data-property="AnimalCost"] span').each(function () {
                var val = $(this).text().replace(/[£,\s]/g, '') || '0';
                totalCost += parseFloat(val) || 0;
            });

            document.getElementById('asuTotalDays').value = totalDays.toFixed(2);
            document.getElementById('asuTotalCost').value = totalCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }
    </script>
}
