<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/govuk-frontend-6.0.0.min.css" />
    <link rel="stylesheet" href="~/css/supplement_style_for_gov.uk_style.css" />
    <link rel="stylesheet" href="~/css/main_style.css" />
    <link rel="stylesheet" href="~/css/common/headernav/navstyle.css" />
    <link rel="stylesheet" href="~/DataGrid/editable-grid.css" />
    <link rel="stylesheet" href="~/css/fps_styles/styles.css" />
    <script src="~/lib/jquery/dist/jquery.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- ── Top Header ─────────────────────────────────────────────────── -->
    @await Component.InvokeAsync("AppHeader", new { appName = "FPS", showYearSelector = true })

    <!-- ── Main Navigation ───────────────────────────────────────────── -->
    <div id="header">
        <nav class="main-nav">

            <!-- Programme Management -->
            <div class="nav-item dropdown">
                <button class="nav-button dropdown-toggle" data-dropdown="programme-management" allow-edit="true">
                    <div class="align-menu-text"><span>Programme Management</span></div>
                    <span class="arrow"><img src="~/images/arrow-down.svg" alt="down arrow" width="12" /></span>
                </button>
                <div class="dropdown-menu" id="programme-management">
                    <a class="dropdown-item" href="#">Select Programme</a>
                    <div class="sub-dropdown">
                        <button class="sub-dropdown-toggle" data-subdropdown="plan-projects">
                            Plan Projects
                            <img src="~/images/right-arrow.png" class="sub-right-arrow" alt="expand" width="14" />
                        </button>
                        <div class="sub-dropdown-menu" id="plan-projects">
                            <a class="dropdown-item" href="#">Set Up A New Project</a>
                            <a class="dropdown-item" asp-area="FPS" asp-controller="ProgramProject" asp-action="Index">Plan Project Individually</a>
                            <a class="dropdown-item" asp-area="FPS" asp-controller="ProgramStaffPlan" asp-action="Index">Plan STAFF for Entire Programme</a>
                            <a class="dropdown-item" asp-area="FPS" asp-controller="ProgramAnimalPlan" asp-action="Index">Plan Animals for Entire Programme</a>
                            <a class="dropdown-item" asp-area="FPS" asp-controller="ProgramTestPlan" asp-action="Index">Plan Test Purchases for Entire Programme</a>
                            <a class="dropdown-item" asp-area="FPS" asp-controller="ProgramAdditionalCostPlan" asp-action="Index">Plan Additional Cost for Entire Programme</a>
                        </div>
                    </div>
                    <div class="sub-dropdown">
                        <button class="sub-dropdown-toggle" data-subdropdown="review-plans">
                            Review Plans
                            <img src="~/images/right-arrow.png" class="sub-right-arrow" alt="expand" width="14" />
                        </button>
                        <div class="sub-dropdown-menu" id="review-plans">
                            <a class="dropdown-item" href="#">Project Portability</a>
                            <a class="dropdown-item" href="#">Staff Plan Pivot</a>
                        </div>
                    </div>
                    <div class="sub-dropdown">
                        <button class="sub-dropdown-toggle" data-subdropdown="summary-printouts">
                            Summary Printouts
                            <img src="~/images/right-arrow.png" class="sub-right-arrow" alt="expand" width="14" />
                        </button>
                        <div class="sub-dropdown-menu" id="summary-printouts">
                            <a class="dropdown-item" href="#">Programme Profitability Report</a>
                            <a class="dropdown-item" href="#">Summarized by Disease</a>
                            <a class="dropdown-item" href="#">Summarized by Customer</a>
                            <a class="dropdown-item" href="#">Project Specifics</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Resource Management -->
            <div class="nav-item dropdown">
                <button class="nav-button dropdown-toggle" data-dropdown="resource-management" allow-edit="true">
                    <div class="align-menu-text"><span>Resource Management</span></div>
                    <span class="arrow"><img src="~/images/arrow-down.svg" alt="down arrow" width="12" /></span>
                </button>
                <div class="dropdown-menu" id="resource-management">
                    <a class="dropdown-item" href="#">Create Resource Center</a>
                    <a class="dropdown-item" href="#">Setup Resource</a>
                    <a class="dropdown-item" href="#">Review Plans</a>
                    <a class="dropdown-item" href="#">Reports</a>
                </div>
            </div>

            <!-- Contract -->
            <div class="nav-item">
                <button class="nav-button" allow-edit="true">
                    <div class="align-menu-text"><span>Contract</span></div>
                </button>
            </div>

            <!-- Lab Testing Manager's -->
            <div class="nav-item">
                <button class="nav-button" allow-edit="true">
                    <div class="align-menu-text"><span>Lab Testing Manager's</span></div>
                </button>
            </div>

            <!-- Luvely Pivots -->
            <div class="nav-item">
                <button class="nav-button" allow-edit="true">
                    <div class="align-menu-text"><span>Luvely Pivots</span></div>
                </button>
            </div>

            <!-- MAB — multi-column -->
            <div class="nav-item dropdown">
                <button class="nav-button dropdown-toggle" data-dropdown="mab-menu" allow-edit="true">
                    <div class="align-menu-text"><span>MAB</span></div>
                    <span class="arrow"><img src="~/images/arrow-down.svg" alt="down arrow" width="12" /></span>
                </button>
                <div class="dropdown-menu dropdown-menu--columns" id="mab-menu">
                    <div class="dropdown-col">
                        <a class="dropdown-item" asp-area="FPS" asp-controller="StaffMaintenance" asp-action="Index">Maintenance Menu</a>
                        <a class="dropdown-item" href="#">Stage 1 Plans</a>
                        <a class="dropdown-item" href="#">ASU Data View</a>
                        <a class="dropdown-item" href="#">VLA Project Totals</a>
                        <a class="dropdown-item" href="#">Generic Bids</a>
                        <a class="dropdown-item" href="#">Project Audit Trails</a>
                    </div>
                    <div class="dropdown-col">
                        <a class="dropdown-item" href="#">SMG Summary Report - All Work</a>
                        <a class="dropdown-item" href="#">SMG Summary Report - Assured Work Only</a>
                        <a class="dropdown-item" href="#">All Programs Profitability</a>
                        <a class="dropdown-item" href="#">Program Exceptional Bids</a>
                        <a class="dropdown-item" href="#">Income Contribution Rpt</a>
                        <a class="dropdown-item" href="#">Income Cont - Summary</a>
                        <a class="dropdown-item" href="#">Project Specific - Query</a>
                    </div>
                    <div class="dropdown-col">
                        <a class="dropdown-item" href="#">Resource Grades by Programme</a>
                        <a class="dropdown-item" href="#">Resource Utilisation</a>
                        <a class="dropdown-item" href="#">Open FPS</a>
                        <a class="dropdown-item" href="#">Close FPS</a>
                        <a class="dropdown-item" href="#">Run Snapshot Queries</a>
                        <a class="dropdown-item" href="#">Run Comparison Queries</a>
                    </div>
                </div>
            </div>

            <!-- Project Plan Viewer -->
            <div class="nav-item">
                <button class="nav-button" allow-edit="true">
                    <div class="align-menu-text"><span>Project Plan Viewer</span></div>
                </button>
            </div>

            <!-- Project Group -->
            <div class="nav-item">
                <button class="nav-button" allow-edit="true">
                    <div class="align-menu-text"><span>Project Group</span></div>
                </button>
            </div>

            <!-- Management Account -->
            <div class="nav-item">
                <button class="nav-button" allow-edit="true">
                    <div class="align-menu-text"><span>Management Account</span></div>
                </button>
            </div>

        </nav>
    </div>

    <!-- ── Page Body ─────────────────────────────────────────────────── -->
    <div class="sup_margin_bottom_10 content-wrapper">
        @RenderBody()
    </div>

    <!-- ── Footer ────────────────────────────────────────────────────── -->
    @await Component.InvokeAsync("AppFooter")

    <!-- ── Shared modal popup (for add/edit forms) ───────────────────── -->
    <div id="modalPopup" tabindex="-1" aria-labelledby="modalPopupLabel"
         style="display:none; position:fixed; inset:0; z-index:1050;
                background:rgba(0,0,0,0.5); align-items:center; justify-content:center;">
        <div class="modal-dialog modal-lg" style="margin:auto; width:100%; max-width:700px;">
            <div id="modaPopupBody" class="modal-content" style="border-radius:4px;">
            </div>
        </div>
    </div>

    <!-- ── Scripts ───────────────────────────────────────────────────── -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/js/govuk-modal-dialog.js"></script>
    <fps-year-script></fps-year-script>

    <script>
        // ── Modal open / close helpers ────────────────────────────────────
        (function () {
            var modal = document.getElementById('modalPopup');
            if (!modal) return;

            var observer = new MutationObserver(function () {
                if (modal.classList.contains('show')) {
                    modal.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                } else {
                    modal.style.display = 'none';
                    document.body.style.overflow = '';
                }
            });
            observer.observe(modal, { attributes: true, attributeFilter: ['class'] });

            modal.addEventListener('click', function (e) {
                if (e.target === modal) {
                    return false;
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modal.classList.contains('show')) {
                    modal.classList.remove('show');
                }
            });
        })();

        // ── jQuery.fn.serializeObject helper ─────────────────────────────
        $.fn.serializeObject = function () {
            var obj = {};
            this.serializeArray().forEach(function (item) {
                obj[item.name] = item.value;
            });
            return obj;
        };
    </script>

    <script src="~/js/fps_js/fpsnavmenu.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
