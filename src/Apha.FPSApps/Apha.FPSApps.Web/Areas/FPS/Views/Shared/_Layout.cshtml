<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @{
        var allYears = await AppStateService.GetCacheValueAsync<IEnumerable<YearMasterDto>>(FpsCacheKeys.AllYears);
        var fpsYearCode = allYears?.FirstOrDefault(y => y.FpsYear == FyContext.Year)?.FpsYearCode
                          ?? FyContext.Year.ToString();
        var pageTitle = ViewData["Title"]?.ToString();
        ViewData["Title"] = $"{fpsYearCode} : {pageTitle}";
    }
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/govuk-frontend-6.0.0.min.css" />
    <link rel="stylesheet" href="~/css/supplement_style_for_gov.uk_style.css" />
    <link rel="stylesheet" href="~/css/fps_styles/styles.css" />
    <link rel="stylesheet" href="~/DataGrid/datagrid.css" />
    <link rel="stylesheet" href="~/css/main_style.css" />
    <link rel="stylesheet" href="~/DataGrid/editable-grid.css" />
    <link rel="stylesheet" href="~/css/common/headernav/navstyle.css" />
    <script src="~/lib/jquery/dist/jquery.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- ── Top Header ─────────────────────────────────────────────────── -->
    @await Component.InvokeAsync("AppHeader", new { appName = "FPS", showYearSelector = true })

    <!-- ── Main Navigation ───────────────────────────────────────────── -->
    @await Component.InvokeAsync("AppNav", new { appArea = "FPS" })

    <!-- ── Page loader overlay ──────────────────────────────────────────── -->
    <div id="pageLoader" aria-live="polite" aria-label="Loading" role="status"
         style="display:none; position:fixed; inset:0; z-index:9999;
                background:rgba(255,255,255,0.75);
                align-items:center; justify-content:center;">
        <div class="fps-spinner" aria-hidden="true"></div>
    </div>

    <!-- ── Page Body ─────────────────────────────────────────────────── -->
    <div class="sup_margin_bottom_10 content-wrapper">
        @RenderBody()
    </div>

    <!-- ── Footer ────────────────────────────────────────────────────── -->
    @await Component.InvokeAsync("AppFooter")

    <!-- ── Shared modal popup (for add/edit forms) ───────────────────── -->
    <div id="modalPopup" tabindex="-1" aria-label="Modal dialog"
         style="display:none; position:fixed; inset:0; z-index:1050;
        background:rgba(0,0,0,0.5); align-items:center; justify-content:center;">
        <div class="modal-dialog modal-lg" style="margin:auto; width:100%; max-width:700px;">
            <div id="modaPopupBody" class="modal-content" style="border-radius:4px;">
            </div>
        </div>
    </div>

    <!-- ── Scripts ───────────────────────────────────────────────────── -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/js/govuk-modal-dialog.js"></script>
    <fps-year-script></fps-year-script>

    <script>
        // ── Modal open / close helpers ────────────────────────────────────
        (function () {
            var modal = document.getElementById('modalPopup');
            if (!modal) return;

                var observer = new MutationObserver(function() {
                    if (modal.classList.contains('show')) {
                        modal.style.display = 'flex';
                        document.body.style.overflow = 'hidden';
                    } else {
                        modal.style.display = 'none';
                        document.body.style.overflow = '';
                    }
                });
                observer.observe(modal, { attributes: true, attributeFilter: ['class'] });

                modal.addEventListener('click', function(e) {
                    if (e.target === modal) {
                        return false;
                    }
                });

                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && modal.classList.contains('show')) {
                        modal.classList.remove('show');
                    }
                });
            })();

            // ── jQuery.fn.serializeObject helper ─────────────────────────────
            $.fn.serializeObject = function() {
                var obj = {};
                this.serializeArray().forEach(function(item) {
                    obj[item.name] = item.value;
                });
                return obj;
            };

        // ── Page loader: show on year-dropdown navigation, hide when fully loaded ──
        (function () {
            var loader = document.getElementById('pageLoader');
            if (!loader) return;

            // Show when the year selector triggers a full-page navigation
            document.addEventListener('change', function (e) {
                if (e.target && e.target.id === 'yearSelector') {
                    loader.style.display = 'flex';
                }
            });

            // Hide once the page (including images/scripts) has fully loaded
            window.addEventListener('load', function () {
                loader.style.display = 'none';
            });
        })();
    </script>

    <script src="~/js/common/headernav/navmenu.js"></script>
    <script src="~/js/common/numeric-decimal-input.js"></script>
    <script src="~/js/common/js-alphanumeric-field.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <style>
        .fps-spinner {
            width: 48px; height: 48px;
            border: 5px solid #dee0e2;
            border-top-color: #1d70b8;
            border-radius: 50%;
            animation: fps-spin 0.8s linear infinite;
        }
        @@keyframes fps-spin {
            to { transform: rotate(360deg); }
        }
    </style>
</body>
</html>
