    <script>
        // Initialize year selector with API data
        $(document).ready(function () {
            loadYearMasterDropdown();
        });

        function loadYearMasterDropdown() {
            $.ajax({
                url: '@Url.Action("GetYearMasterDropdown", "YearMaster", new { area = "FPS" })',
                type: 'GET',
                success: function (response) {
                    if (response.success && response.data) {
                        var $select = $('#yearSelector');
                        $select.empty();

                        // Get the year from query string (if present) or from context
                        var urlParams = new URLSearchParams(window.location.search);
                        var yearFromUrl = urlParams.get('year');
                        var currentYear = @Fy.Year;

                        // Determine which year to select
                        var defaultYear;
                        if (yearFromUrl) {
                            // If year is in URL, use that
                            defaultYear = parseInt(yearFromUrl);
                        } else {
                            // Otherwise, find the year with status "Open"
                            var openYear = response.data.find(function(item) {
                                return item.yearStatus && item.yearStatus.toLowerCase() === 'open';
                            });
                            // Fallback to current year from context if no open year found
                            defaultYear = openYear ? openYear.value : currentYear;
                        }

                        var yearFound = false;

                        $.each(response.data, function (index, item) {
                            var $option = $('<option></option>')
                                .addClass('pims-log')
                                .css({
                                    'border': '0',
                                    'margin-left': '0px'
                                })
                                .val(item.value)
                                .text(item.text);

                            // Set selected year based on URL parameter or Open status
                            if (item.value == defaultYear) {
                                $option.attr('selected', 'selected');
                                yearFound = true;
                            }

                            $select.append($option);
                        });

                        // If default year not found, select first item
                        if (!yearFound && response.data.length > 0) {
                            $select.val(response.data[0].value);
                        }
                    } else {
                        console.error('Failed to load year master dropdown');
                        $('#yearSelector').html('<option value="">Error loading years</option>');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading year master dropdown:', error);
                    $('#yearSelector').html('<option value="">Error loading years</option>');
                }
            });
        }

        // Handle year change event
        $('#yearSelector').on('change', function () {
            var selectedYear = $(this).val();
            if (selectedYear) {
                window.location.href = '/FPS/Home/Index?year=' + selectedYear;
            }
        });
    </script>
