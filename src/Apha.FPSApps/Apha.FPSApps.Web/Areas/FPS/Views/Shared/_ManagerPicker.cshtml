@model Apha.FPSApps.Web.Areas.FPS.Models.ManagerPickerViewModel
@{
    var fieldName = string.IsNullOrWhiteSpace(Model.FieldName) ? "Manager" : Model.FieldName;
}
<div style="position: relative; display: block; width: 100%;">
    <input type="text" id="ManagerDisplay" placeholder="Select Manager" autocomplete="off" aria-label="Select Manager"
           class="govuk-input govuk-!-font-size-16 down-arrow-img" style="width:100%; box-sizing:border-box; cursor:pointer;" readonly />
    <div id="ManagerDropdownPanel" style="display:none; position:fixed; top:0; left:0; right:auto; width:auto; box-sizing:border-box;
            max-height:260px; overflow-y:auto; overflow-x:hidden; background:#fff; border:1px solid #b1b4b6;
            box-shadow:0 4px 8px rgba(0,0,0,.2); z-index:2000;">
        <input type="text" id="ManagerSearchBox" placeholder="Type to search manager" aria-label="Type to search manager"
               style="width:100%; padding:6px 8px; border:0; border-bottom:1px solid #b1b4b6; outline:none; box-sizing:border-box;" />
        <table style="width:100%; table-layout:fixed; border-collapse:collapse; font-size:14px;">
            <thead style="background:#f3f2f1; position:sticky; top:0; z-index:10;">
                <tr>
                    <th style="padding:6px 8px; text-align:left; width:@(Model.ShowGrade ? "40%" : "50%");">Name</th>
                    <th style="padding:6px 8px; text-align:left; width:@(Model.ShowGrade ? "35%" : "50%");">Work Group</th>
                    @if (Model.ShowGrade)
                    {
                        <th style="padding:6px 8px; text-align:left; width:25%;">Grade</th>
                    }
                </tr>
            </thead>
            <tbody id="ManagerDropdownBody">
                @foreach (var item in Model.ManagerList.Where(i => !string.IsNullOrEmpty(i.Value)))
                {
                    var parts = item.Text.Split('|');
                    var mgrName = parts[0].Trim();
                    var mgrGroup = parts.Length > 1 ? parts[1].Trim() : string.Empty;
                    var mgrGrade = parts.Length > 2 ? parts[2].Trim() : string.Empty;
                    <tr data-value="@item.Value" data-display="@mgrName" style="cursor:pointer;">
                        <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@mgrName">@mgrName</td>
                        <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@mgrGroup">@mgrGroup</td>
                        @if (Model.ShowGrade)
                        {
                            <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@mgrGrade">@mgrGrade</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<select id="@fieldName" name="@fieldName" class="@Model.SelectCssClass" style="display:none;" required="@Model.Required">
    @foreach (var item in Model.ManagerList)
    {
        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
    }
</select>
<span class="govuk-error-message field-validation-valid" data-valmsg-for="@fieldName" data-valmsg-replace="true" style="display:none;"></span>

<script>
    (function () {
        // A previously opened panel is parked on <body>; drop it so the freshly
        // rendered markup below is the only ManagerDropdownPanel in the document.
        document.querySelectorAll('body > #ManagerDropdownPanel').forEach(function (stale) {
            stale.remove();
        });

        var managerDisplay = document.getElementById('ManagerDisplay');
        var managerSelect  = document.getElementById('@fieldName');
        var managerPanel   = document.getElementById('ManagerDropdownPanel');
        var managerSearch  = document.getElementById('ManagerSearchBox');
        var managerBody    = document.getElementById('ManagerDropdownBody');

        if (managerDisplay && managerSelect && managerPanel && managerSearch && managerBody) {
            if (managerSelect.value) {
                var matchManagerRow = managerBody.querySelector('tr[data-value="' + managerSelect.value + '"]');
                managerDisplay.value = matchManagerRow ? matchManagerRow.getAttribute('data-display') : managerSelect.value;
            }
            managerDisplay.addEventListener('click', function (e) {
                e.stopPropagation();
                managerPanel.style.display = managerPanel.style.display === 'none' ? 'block' : 'none';
                if (managerPanel.style.display === 'block') { positionManagerPanel(); managerSearch.value = ''; filterManagerRows(); managerSearch.focus(); }
            });
            // The panel is fixed-positioned so it floats above the modal rather than
            // being clipped by (or stretching) the scrollable modal body. It is moved
            // to <body> because .modal-dialog has a transform, which would otherwise
            // become the containing block and offset the fixed coordinates.
            function positionManagerPanel() {
                if (managerPanel.parentNode !== document.body) {
                    document.body.appendChild(managerPanel);
                }
                var rect = managerDisplay.getBoundingClientRect();
                var spaceBelow = window.innerHeight - rect.bottom;
                // setProperty with 'important' so no page stylesheet can stretch the
                // panel back to full width once it sits directly under <body>.
                managerPanel.style.setProperty('position', 'fixed', 'important');
                managerPanel.style.setProperty('left', rect.left + 'px', 'important');
                managerPanel.style.setProperty('top', rect.bottom + 'px', 'important');
                managerPanel.style.setProperty('width', rect.width + 'px', 'important');
                managerPanel.style.setProperty('right', 'auto', 'important');
                managerPanel.style.setProperty('bottom', 'auto', 'important');
                managerPanel.style.setProperty('max-width', 'none', 'important');
                managerPanel.style.setProperty('max-height', Math.min(260, spaceBelow - 8) + 'px', 'important');
            }
            managerSearch.addEventListener('input', filterManagerRows);
            function filterManagerRows() {
                var q = managerSearch.value.toLowerCase();
                managerBody.querySelectorAll('tr').forEach(function (row) {
                    row.style.display = row.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
                });
            }
            managerBody.querySelectorAll('tr').forEach(function (row) {
                row.addEventListener('click', function () {
                    managerDisplay.value = this.getAttribute('data-display');
                    var val = this.getAttribute('data-value');
                    Array.from(managerSelect.options).forEach(function (o) { o.selected = o.value === val; });
                    managerSelect.dispatchEvent(new Event('change'));
                    managerPanel.style.display = 'none';
                });
                row.addEventListener('mouseenter', function () { this.style.backgroundColor = '#f3f2f1'; });
                row.addEventListener('mouseleave', function () { this.style.backgroundColor = ''; });
            });
            document.addEventListener('click', function (e) {
                if (!managerDisplay.contains(e.target) && !managerPanel.contains(e.target)) {
                    managerPanel.style.display = 'none';
                }
            });
        }
    })();
</script>
