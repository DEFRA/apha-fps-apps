<form class="" id="formTblprojectprofitability" novalidate>
    <div class="govuk-form-group sup_margin_bottom_10">
        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="modal-project">Project:</label>
        <input class="govuk-input govuk-!-font-size-16 sup_select_option_width_100"
               id="modal-project" name="jobCode" type="text"
               aria-required="true" aria-label="Enter project code" maxlength="30" readonly>
    </div>
    <div class="govuk-form-group sup_margin_bottom_10">
        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="modal-staff-costs">Staff Costs:</label>
        <input class="govuk-input govuk-!-font-size-16 sup_select_option_width_100"
               id="modal-staff-costs" name="jcTotalStaffCosts" type="text"
               aria-label="Staff costs" maxlength="20" placeholder="e.g. £0" readonly>
    </div>
    <div class="govuk-form-group sup_margin_bottom_10">
        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="modal-test-cost">Test Cost:</label>
        <input class="govuk-input govuk-!-font-size-16 sup_select_option_width_100"
               id="modal-test-cost" name="jcTotalTestCosts" type="text"
               aria-label="Test cost" maxlength="20" placeholder="e.g. £0" readonly>
    </div>
    <div class="govuk-form-group sup_margin_bottom_10">
        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="modal-animal">Animal:</label>
        <input class="govuk-input govuk-!-font-size-16 sup_select_option_width_100"
               id="modal-animal" name="jcTotalAnimalCosts" type="text"
               aria-label="Animal cost" maxlength="20" placeholder="e.g. £0" readonly>
    </div>
    <div class="govuk-form-group sup_margin_bottom_10">
        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="modal-add-costs">Add Costs:</label>
        <input class="govuk-input govuk-!-font-size-16 sup_select_option_width_100"
               id="modal-add-costs" name="jcTotalAdditionalCosts" type="text"
               aria-label="Additional costs" maxlength="20" placeholder="e.g. £0" readonly>
    </div>
    <div class="govuk-form-group sup_margin_bottom_10">
        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="modal-total-costs">Total Costs:</label>
        <input class="govuk-input govuk-!-font-size-16 sup_select_option_width_100"
               id="modal-total-costs" name="totalCosts" type="text"
               aria-label="Total costs" maxlength="20" placeholder="e.g. £0" readonly>
    </div>
    <div class="govuk-form-group sup_margin_bottom_10">
        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="modal-budget">Budget:</label>
        <input class="govuk-input govuk-!-font-size-16 sup_select_option_width_100"
               id="modal-budget" name="budgetCvl" type="number" step="0.01"
               aria-label="Enter budget" maxlength="20" placeholder="e.g. 0">
    </div>
    <div class="govuk-form-group sup_margin_bottom_10">
        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="modal-profit">Profit:</label>
        <input class="govuk-input govuk-!-font-size-16 sup_select_option_width_100"
               id="modal-profit" name="profit" type="number" step="0.01"
               aria-required="true" aria-label="Enter profit value" maxlength="20" placeholder="e.g. 0">
    </div>
    <div class="govuk-form-group sup_margin_bottom_10">
        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="modal-target-profit">Target Profit:</label>
        <input class="govuk-input govuk-!-font-size-16 sup_select_option_width_100"
               id="modal-target-profit" name="targetProfit" type="text"
               aria-label="Target profit" maxlength="20" placeholder="e.g. £0" readonly>
    </div>
    <div class="govuk-form-group sup_margin_bottom_10">
        <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" for="modal-off-target">Off-Target:</label>
        <input class="govuk-input govuk-!-font-size-16 sup_select_option_width_100"
               id="modal-off-target" name="offTarget" type="text"
               aria-label="Off-target value" maxlength="20" placeholder="e.g. £0" readonly>
    </div>
</form>
