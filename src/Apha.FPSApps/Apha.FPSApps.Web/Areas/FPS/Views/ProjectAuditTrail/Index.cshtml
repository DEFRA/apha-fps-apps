<!-- TRANSFORMENGINE MIGRATION — Index.cshtml (ProjectAuditTrail)
     Pattern  : stack-upgrade/msaccess-frm-to-dotnet10-mvc-e2e  Phase 12 — Razor Views (Step 18)
     Migrated : 2026-06-22

     CHANGED:
       - New file — Razor view replacing HTML prototype projectaudit_trail.html
       - 5-tab GOV.UK tabs layout: Project Detail Changes, Staff Plan Changes,
         Test Requirement Changes, Animal Requirement Changes, Exceptional Cost Changes
       - Explicit filter section from HTML prototype preserved:
           * filter-project <select> (outside all grid containers) bound to asp-for="ParentProject"
             populated via asp-items="Model.ProjectList" (ProjectList from IProjectService)
           * filter-from <input type="date"> bound to asp-for="FromDate"
           * filter-to <input type="date"> bound to asp-for="ToDate"
         All 3 filter controls are outside #gridContainer_* divs — explicit page-level filters
       - Search / Clear buttons from HTML prototype preserved
       - 5 _DataGrid partials (one per tab): ProjectLogsGrid, StaffJobLogsGrid,
         TestRequirementLogsGrid, AnimalRequestLogsGrid, AdditionalCostLogsGrid
       - ExtraFilterMethod set per-grid in the controller; JS filter functions declared
         below pass project + fromDate + toDate to the AJAX reload POST
       - showAddButton: false in all 5 JS grids → AllowAdd/Edit/Delete all false
         → no add/edit/delete JS functions needed (read-only audit trail)
       - Tab switching via govuk-tabs JS pattern (DOMContentLoaded event handler)
       - All IDs mirror the HTML prototype: filter-project, filter-from, filter-to,
         gridContainer_projectAuditTrailList, gridContainer_staffPlanChangesList, etc.

     PRESERVED:
       - All HTML prototype DOM ids, aria attributes, role attributes
       - govuk-tabs structure: ul.govuk-tabs__list + div.govuk-tabs__panel per tab
       - Filter section layout: label + select + date fieldset + Search/Clear buttons
       - Tab panel IDs: panel-project-detail-changes, panel-staff-plan-changes,
         panel-test-requirement-changes, panel-animal-requirement-changes,
         panel-exceptional-cost-changes

     --- Phase 14 — Pre-Build Security Review Gate (2026-06-22) ---
     SECURITY REVIEW RESULT: PASS — no security defects requiring code changes.

     Checks performed:
       [PASS] No form-method-post elements — filter controls use button-type-button
              triggering JS; AJAX POSTs originate from _DataGrid's internal mechanism.
              Html.AntiForgeryToken() is not required in this view.
       [PASS] asp-for Tag Helpers (ParentProject, FromDate, ToDate) HTML-encode all
              model values before rendering into value attributes. No Html.Raw() used.
       [PASS] asp-items="Model.ProjectList" — Tag Helper renders and HTML-encodes all
              option tags from server-side SelectListItem list. No XSS vector.
       [PASS] No unencoded Razor output (Html.Raw / Razor string interpolation of
              user-supplied values) anywhere in the view.
       [PASS] JavaScript filter reads (filter-project, filter-from, filter-to) are sent
              as POST body params to server — not written back into the DOM. Server-side
              controller uses LINQ with typed params; no SQL injection vector.
       [PASS] Tab navigation: aria-controls values passed to showAuditTab() are
              hardcoded server-rendered panel IDs (panel-project-detail-changes etc.) —
              never derived from user-supplied data. getElementById(targetId) is safe.
       [PASS] window['gridManager_' + gridId] access: gridId drawn from a hardcoded
              array literal — no user-controlled key. No prototype pollution risk.
       [PASS] No hardcoded secrets, connection strings, API tokens, or environment-
              specific endpoints in view markup or the Scripts section block.
       [PASS] reloadGrid({ page: 1 }) used exclusively — not the deprecated reload().
       [PASS] No window.location, document.referrer, or query-string reads used for
              auth or routing decisions in client-side code.
       [REVIEW] Inline Scripts section block — consistent with FPS app-wide pattern
              (all other FPS views use inline Scripts sections). If a strict Content
              Security Policy (CSP) with nonce enforcement is adopted in the future,
              these scripts must be moved to external .js files or receive CSP nonces.
              Not a blocker for current deployment model.

     DEFERRED / REQUIRES HUMAN REVIEW:
       - TRANSFORMENGINE TODO: UserEmail column in all 5 grids is resolved at the backend;
         the stub AutoMapper Ignore() means the column renders empty until the backend
         UserId-to-email resolution is implemented.
       - TRANSFORMENGINE TODO: StaffJobLogItem.Name is stubbed — column renders empty
         until the backend staff-lookup join is implemented.
       - TRANSFORMENGINE TODO: FromDate/ToDate binding from HTML <input type="date"> to
         DateOnly? — verify the model binder handles ISO 8601 date strings correctly in all
         .NET 10 environments; add a custom TypeConverter or format annotation if needed. -->

@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProjectAuditTrailViewModel

@{
    ViewData["Title"] = FyContext.Year + " : Project Audit Trail";
}

<main class="govuk-main-wrapper govuk-!-padding-top-0" id="main-content" role="main">
    <div class="govuk-!-margin-bottom-5">

        <!-- ── Breadcrumb row ──────────────────────────────────────────────── -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="row fps-sr-breadcrumb-row">
                    <div class="fps-sr-breadcrumb-flex sup_context_row">
                        <div class="col-md-10">
                        </div>
                        <div class="col-md-2">
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Page title ──────────────────────────────────────────────── -->
            <div class="govuk-grid-column-full">
                <h1 class="govuk-grid-row govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    Project Audit Trail
                </h1>
            </div>
        </div>

        <!-- ── Filter section ─────────────────────────────────────────────── -->
        <!-- TRANSFORMENGINE: Explicit filter controls from HTML prototype, outside all
             gridContainer_* divs. Project <select> populated from IProjectService
             (separate lookup flow). fromDate/toDate are DateOnly? on ViewModel. -->
        <div class="govuk-grid-row sup_margin_left_right_10 trl-intro-block">
            <div class="govuk-grid-column-full sup_p_0">

                <section class="govuk-!-margin-top-2" aria-label="Project audit filters">
                    <div class="trl-filter-row spc-filter-row-near">

                        <!-- Project filter -->
                        <div class="govuk-form-group sup_margin_bottom_10">
                            <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                                   for="filter-project"
                                   id="filter-project-label">Project</label>
                            <select class="sup_margin_bottom_10 govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                                    id="filter-project"
                                    name="filterProject"
                                    asp-for="ParentProject"
                                    asp-items="Model.ProjectList"
                                    aria-label="Select project">
                                <option value="">All projects</option>
                            </select>
                            <div class="govuk-button-group sup_margin_0 trl-filter-actions-buttons trl-filter-buttons_alignment govuk-!-margin-top-2">
                                <button type="button"
                                        class="govuk-button sup_margin_0"
                                        id="btnApplyProjectAuditFilters"
                                        data-module="govuk-button">Search</button>
                                <button type="button"
                                        class="govuk-button sup_margin_0"
                                        id="btnResetProjectAuditFilters"
                                        data-module="govuk-button">Clear</button>
                            </div>
                        </div>

                        <!-- Date of change fieldset -->
                        <fieldset class="govuk-fieldset sup_margin_bottom_10 border-legend">
                            <legend class="govuk-fieldset__legend govuk-!-font-weight-bold govuk-!-font-size-16">
                                Date of change
                            </legend>
                            <div class="sup_flex_gap_10">
                                <div class="govuk-form-group govuk-!-margin-bottom-0">
                                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                                           for="filter-from">From</label>
                                    <input class="govuk-input width-200 govuk-!-font-size-16"
                                           id="filter-from"
                                           name="filterFrom"
                                           asp-for="FromDate"
                                           type="date"
                                           aria-label="Date of change from" />
                                </div>
                                <div class="govuk-form-group govuk-!-margin-bottom-0">
                                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                                           for="filter-to">To</label>
                                    <input class="govuk-input width-200 govuk-!-font-size-16"
                                           id="filter-to"
                                           name="filterTo"
                                           asp-for="ToDate"
                                           type="date"
                                           aria-label="Date of change to" />
                                </div>
                            </div>
                        </fieldset>

                    </div>
                </section>

            </div>
        </div>

        <!-- ── Tabbed grid area ────────────────────────────────────────────── -->
        <div class="govuk-grid-row sup_margin_left_right_10">
            <div class="govuk-grid-column-full sup_p_0">

                <div class="govuk-tabs">

                    <!-- Tab navigation -->
                    <ul class="govuk-tabs__list" role="tablist" aria-label="Project audit sections">
                        <li class="govuk-tabs__list-item govuk-tabs__list-item--selected govuk-!-margin-left-0"
                            role="presentation">
                            <a class="govuk-tabs__tab"
                               id="tab-project-detail-changes"
                               href="#panel-project-detail-changes"
                               role="tab"
                               aria-controls="panel-project-detail-changes"
                               aria-selected="true"
                               tabindex="0">Project Detail Change</a>
                        </li>
                        <li class="govuk-tabs__list-item" role="presentation">
                            <a class="govuk-tabs__tab"
                               id="tab-staff-plan-changes"
                               href="#panel-staff-plan-changes"
                               role="tab"
                               aria-controls="panel-staff-plan-changes"
                               aria-selected="false"
                               tabindex="-1">Staff Plan Changes</a>
                        </li>
                        <li class="govuk-tabs__list-item" role="presentation">
                            <a class="govuk-tabs__tab"
                               id="tab-test-requirement-changes"
                               href="#panel-test-requirement-changes"
                               role="tab"
                               aria-controls="panel-test-requirement-changes"
                               aria-selected="false"
                               tabindex="-1">Test Requirement Changes</a>
                        </li>
                        <li class="govuk-tabs__list-item" role="presentation">
                            <a class="govuk-tabs__tab"
                               id="tab-animal-requirement-changes"
                               href="#panel-animal-requirement-changes"
                               role="tab"
                               aria-controls="panel-animal-requirement-changes"
                               aria-selected="false"
                               tabindex="-1">Animal Requirement Changes</a>
                        </li>
                        <li class="govuk-tabs__list-item" role="presentation">
                            <a class="govuk-tabs__tab"
                               id="tab-exceptional-cost-changes"
                               href="#panel-exceptional-cost-changes"
                               role="tab"
                               aria-controls="panel-exceptional-cost-changes"
                               aria-selected="false"
                               tabindex="-1">Exceptional Cost Changes</a>
                        </li>
                    </ul>

                    <!-- Tab 1 — Project Detail Changes -->
                    <div class="govuk-tabs__panel active"
                         id="panel-project-detail-changes"
                         role="tabpanel"
                         aria-labelledby="tab-project-detail-changes">
                        <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                            <div class="govuk-grid-column-full sup_p_0">
                                <!-- TRANSFORMENGINE: Tab 1 — projectAuditTrailGrid
                                     AllowAdd/Edit/Delete all false (showAddButton:false in JS prototype).
                                     ExtraFilterMethod="getProjectAuditTrailExtraFilters" set in controller. -->
                                <div id="gridContainer_projectAuditTrailList">
                                    @await Html.PartialAsync("_DataGrid", Model.ProjectLogsGrid)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 2 — Staff Plan Changes -->
                    <div class="govuk-tabs__panel"
                         id="panel-staff-plan-changes"
                         role="tabpanel"
                         aria-labelledby="tab-staff-plan-changes">
                        <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                            <div class="govuk-grid-column-full sup_p_0">
                                <!-- TRANSFORMENGINE: Tab 2 — staffPlanChangesGrid
                                     AllowAdd/Edit/Delete all false. ExtraFilterMethod="getStaffPlanChangesExtraFilters". -->
                                <div id="gridContainer_staffPlanChangesList">
                                    @await Html.PartialAsync("_DataGrid", Model.StaffJobLogsGrid)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 3 — Test Requirement Changes -->
                    <div class="govuk-tabs__panel"
                         id="panel-test-requirement-changes"
                         role="tabpanel"
                         aria-labelledby="tab-test-requirement-changes">
                        <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                            <div class="govuk-grid-column-full sup_p_0">
                                <!-- TRANSFORMENGINE: Tab 3 — testRequirementChangesGrid
                                     AllowAdd/Edit/Delete all false. ExtraFilterMethod="getTestRequirementChangesExtraFilters". -->
                                <div id="gridContainer_testRequirementChangesList">
                                    @await Html.PartialAsync("_DataGrid", Model.TestRequirementLogsGrid)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 4 — Animal Requirement Changes -->
                    <div class="govuk-tabs__panel"
                         id="panel-animal-requirement-changes"
                         role="tabpanel"
                         aria-labelledby="tab-animal-requirement-changes">
                        <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                            <div class="govuk-grid-column-full sup_p_0">
                                <!-- TRANSFORMENGINE: Tab 4 — animalRequirementChangesGrid
                                     AllowAdd/Edit/Delete all false. ExtraFilterMethod="getAnimalRequirementChangesExtraFilters". -->
                                <div id="gridContainer_animalRequirementChangesList">
                                    @await Html.PartialAsync("_DataGrid", Model.AnimalRequestLogsGrid)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab 5 — Exceptional Cost Changes -->
                    <div class="govuk-tabs__panel"
                         id="panel-exceptional-cost-changes"
                         role="tabpanel"
                         aria-labelledby="tab-exceptional-cost-changes">
                        <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                            <div class="govuk-grid-column-full sup_p_0">
                                <!-- TRANSFORMENGINE: Tab 5 — exceptionalCostChangesGrid
                                     AllowAdd/Edit/Delete all false. ExtraFilterMethod="getExceptionalCostChangesExtraFilters". -->
                                <div id="gridContainer_exceptionalCostChangesList">
                                    @await Html.PartialAsync("_DataGrid", Model.AdditionalCostLogsGrid)
                                </div>
                            </div>
                        </div>
                    </div>

                </div><!-- /.govuk-tabs -->

            </div>
        </div>

        <div id="app-footer"></div>

    </div>
</main>

@section Scripts {
    <script>
        // ── Tab switching (mirrors govuk_tabs.js behavior from HTML prototype) ──────────
        function showAuditTab(targetId) {
            document.querySelectorAll('.govuk-tabs__panel').forEach(function (panel) {
                panel.classList.add('govuk-tabs__panel--hidden');
                panel.hidden = true;
            });
            document.querySelectorAll('.govuk-tabs__tab').forEach(function (link) {
                link.setAttribute('aria-selected', 'false');
                link.setAttribute('tabindex', '-1');
                link.parentElement.classList.remove('govuk-tabs__list-item--selected');
            });
            var activePanel = document.getElementById(targetId);
            if (activePanel) {
                activePanel.classList.remove('govuk-tabs__panel--hidden');
                activePanel.hidden = false;
            }
            var activeLink = document.querySelector('[aria-controls="' + targetId + '"]');
            if (activeLink) {
                activeLink.setAttribute('aria-selected', 'true');
                activeLink.setAttribute('tabindex', '0');
                activeLink.parentElement.classList.add('govuk-tabs__list-item--selected');
            }
        }

        // ── Extra filter methods — called by each _DataGrid on every AJAX reload ────────
        // TRANSFORMENGINE: Each function returns the current filter state to the POST body.
        // The controller LoadXxxLogsGrid actions read project/fromDate/toDate from these params.
        function getProjectAuditTrailExtraFilters() {
            return {
                project:  document.getElementById('filter-project')?.value || '',
                fromDate: document.getElementById('filter-from')?.value   || '',
                toDate:   document.getElementById('filter-to')?.value     || ''
            };
        }
        function getStaffPlanChangesExtraFilters() {
            return {
                project:  document.getElementById('filter-project')?.value || '',
                fromDate: document.getElementById('filter-from')?.value   || '',
                toDate:   document.getElementById('filter-to')?.value     || ''
            };
        }
        function getTestRequirementChangesExtraFilters() {
            return {
                project:  document.getElementById('filter-project')?.value || '',
                fromDate: document.getElementById('filter-from')?.value   || '',
                toDate:   document.getElementById('filter-to')?.value     || ''
            };
        }
        function getAnimalRequirementChangesExtraFilters() {
            return {
                project:  document.getElementById('filter-project')?.value || '',
                fromDate: document.getElementById('filter-from')?.value   || '',
                toDate:   document.getElementById('filter-to')?.value     || ''
            };
        }
        function getExceptionalCostChangesExtraFilters() {
            return {
                project:  document.getElementById('filter-project')?.value || '',
                fromDate: document.getElementById('filter-from')?.value   || '',
                toDate:   document.getElementById('filter-to')?.value     || ''
            };
        }

        // ── Grid reload helpers — reloadGrid({ page: 1 }) per _DataGrid contract ────────
        // TRANSFORMENGINE: ALWAYS use gm.reloadGrid({ page: 1 }) — NOT gm.reload()
        function reloadAllAuditGrids() {
            ['projectAuditTrailGrid',
             'staffPlanChangesGrid',
             'testRequirementChangesGrid',
             'animalRequirementChangesGrid',
             'exceptionalCostChangesGrid'].forEach(function (gridId) {
                var gm = window['gridManager_' + gridId];
                if (gm) { gm.reloadGrid({ page: 1 }); }
            });
        }

        // ── Apply filters (Search button) ─────────────────────────────────────────────
        function applyProjectAuditTrailFilters() {
            reloadAllAuditGrids();
        }

        // ── Reset filters (Clear button) ──────────────────────────────────────────────
        function resetProjectAuditTrailFilters() {
            document.getElementById('filter-project').value = '';
            document.getElementById('filter-from').value   = '';
            document.getElementById('filter-to').value     = '';
            reloadAllAuditGrids();
        }

        // ── DOMContentLoaded: wire tabs + buttons ─────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {

            // Wire tab click events
            document.querySelectorAll('.govuk-tabs__tab').forEach(function (link) {
                link.addEventListener('click', function (event) {
                    event.preventDefault();
                    showAuditTab(this.getAttribute('aria-controls'));
                });
                link.addEventListener('keydown', function (event) {
                    var tabs = Array.from(document.querySelectorAll('.govuk-tabs__tab'));
                    var index = tabs.indexOf(this);
                    if (event.key === 'ArrowRight' && index < tabs.length - 1) {
                        event.preventDefault();
                        showAuditTab(tabs[index + 1].getAttribute('aria-controls'));
                        tabs[index + 1].focus();
                    } else if (event.key === 'ArrowLeft' && index > 0) {
                        event.preventDefault();
                        showAuditTab(tabs[index - 1].getAttribute('aria-controls'));
                        tabs[index - 1].focus();
                    }
                });
            });

            // Wire Search / Clear buttons
            var btnApply = document.getElementById('btnApplyProjectAuditFilters');
            if (btnApply) { btnApply.addEventListener('click', applyProjectAuditTrailFilters); }
            var btnReset = document.getElementById('btnResetProjectAuditFilters');
            if (btnReset) { btnReset.addEventListener('click', resetProjectAuditTrailFilters); }

            // Activate first tab on load
            var firstTab = document.querySelector('.govuk-tabs__tab');
            if (firstTab) { showAuditTab(firstTab.getAttribute('aria-controls')); }
        });
    </script>
}
