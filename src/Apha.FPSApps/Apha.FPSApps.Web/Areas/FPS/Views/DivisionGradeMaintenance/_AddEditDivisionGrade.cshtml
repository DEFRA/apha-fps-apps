@model Apha.FPSApps.Web.Areas.FPS.Models.DivisionGradeItem
@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.DivisionGradeCode);
    var title = isEditMode ? "Edit Division Grade" : "Add Division Grade";
    var saveLabel = isEditMode ? "Update" : "Save";
}

<div class="modal-header">
    <h5 class="modal-title">@title</h5>
    <button type="button" class="btn-close btn-red" onclick="closeModal()" data-bs-dismiss="modal">X</button>
</div>
<div class="modal-body">
    <div class="govuk-error-summary" role="alert"
         aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
            </ul>
        </div>
    </div>
    <div class="row g-3">
        <form id="maintDGForm">
            <input type="hidden" id="hdnIsEdit" value="@(isEditMode ? "true" : "false")" />
            <input type="hidden" id="hdnOriginalCode" value="@(Model?.DivisionGradeCode ?? string.Empty)" />

            @if (!isEditMode)
            {
                <div class="govuk-form-group sup_margin_0">
                    <label class="govuk-label" asp-for="DivisionGradeCode">Division Grade <span class="sup_color_red">*</span></label>
                    <input type="text" id="DivisionGradeCode" name="DivisionGradeCode"
                           class="govuk-input" required maxlength="50">
                    <span asp-validation-for="DivisionGradeCode" class="govuk-error-message" style="display:none;"></span>
                </div>
            }
            else
            {
                <div class="govuk-form-group sup_margin_0">
                    <label class="govuk-label" asp-for="DivisionGradeCode">Division Grade</label>
                    <input type="text" id="DivisionGradeCode" name="DivisionGradeCode"
                           class="govuk-input govuk-input--disabled" readonly
                           value="@Model!.DivisionGradeCode">
                </div>
            }

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="GradeCode">Grade Code <span class="sup_color_red">*</span></label>
                <select id="GradeCode" name="GradeCode" required
                        class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                        aria-label="Select grade code">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="GradeCode" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="Division">Division <span class="sup_color_red">*</span></label>
                <select id="Division" name="Division" required
                        class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                        aria-label="Select division">
                    <option value="">-- Select --</option>
                </select>
                <span asp-validation-for="Division" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="ChargeRate">Charge Rate</label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="number" step="0.01" id="ChargeRate" asp-for="ChargeRate" class="govuk-input" min="0">
                </div>
                <span asp-validation-for="ChargeRate" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="DirectRate">Direct Rate</label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="number" step="0.01" id="DirectRate" asp-for="DirectRate" class="govuk-input" min="0">
                </div>
                <span asp-validation-for="DirectRate" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="PayRate">Pay Rate</label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="number" step="0.01" id="PayRate" asp-for="PayRate" class="govuk-input" min="0">
                </div>
                <span asp-validation-for="PayRate" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="Npr">NPR</label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="number" step="0.01" id="Npr" asp-for="Npr" class="govuk-input" min="0">
                </div>
                <span asp-validation-for="Npr" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="Ohr">OHR</label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="number" step="0.01" id="Ohr" asp-for="Ohr" class="govuk-input" min="0">
                </div>
                <span asp-validation-for="Ohr" class="govuk-error-message" style="display:none;"></span>
            </div>
        </form>
    </div>
</div>
<div class="modal-footer sup_flex_space_center">
    <button class="govuk-button govuk-button--secondary sup_margin_0" data-module="govuk-button"
            data-bs-dismiss="modal" onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" data-module="govuk-button"
            type="button" onclick="if(validateMaintDGForm()) saveDivisionGrade()">@saveLabel</button>
</div>

<script>
    var _currentGradeCode = '@Html.Raw(Model?.GradeCode ?? string.Empty)';
    var _currentDivision = '@Html.Raw(Model?.Division ?? string.Empty)';

    $(document).ready(function () {
        loadMaintDGDropdowns();
    });

    function loadMaintDGDropdowns() {
        // Load grade codes
        $.ajax({
            url: '@Url.Action("GetDistinctGradeCodes", "DivisionGradeMaintenance", new { area = "FPS" })',
            type: 'GET',
            success: function (response) {
                if (response.success && response.data) {
                    var $select = $('#GradeCode');
                    $.each(response.data, function (index, item) {
                        var isSelected = _currentGradeCode && _currentGradeCode === item.gradeCode;
                        $select.append($('<option></option>')
                            .attr('value', item.gradeCode)
                            .prop('selected', isSelected)
                            .text(item.gradeCode));
                    });
                }
            },
            error: function () {
                $('#GradeCode').append($('<option></option>').text('Error loading grade codes'));
            }
        });

        // Load divisions
        $.ajax({
            url: '@Url.Action("GetDistinctDivisions", "DivisionGradeMaintenance", new { area = "FPS" })',
            type: 'GET',
            success: function (response) {
                if (response.success && response.data) {
                    var $select = $('#Division');
                    $.each(response.data, function (index, item) {
                        var isSelected = _currentDivision && _currentDivision === item.divName;
                        $select.append($('<option></option>')
                            .attr('value', item.divName)
                            .prop('selected', isSelected)
                            .text(item.divName));
                    });
                }
            },
            error: function () {
                $('#Division').append($('<option></option>').text('Error loading divisions'));
            }
        });
    }

    // ── Client-side validation ──────────────────────────────────────────────
    function validateMaintDGForm() {
        var isValid = true;
        var errorItems = [];
        var isEdit = $('#hdnIsEdit').val() === 'true';

        // Clear all previous error states
        $('#maintDGForm .govuk-form-group').removeClass('govuk-form-group--error');
        $('#maintDGForm .govuk-error-message').text('').hide();
        $('.govuk-error-summary').hide();
        $('.govuk-error-summary__list').empty();

        // Helper: mark a field invalid
        function markInvalid(fieldId, message) {
            var $field = $('#' + fieldId);
            $field.closest('.govuk-form-group').addClass('govuk-form-group--error');
            var $span = $field.closest('.govuk-form-group').find('.govuk-error-message');
            $span.text(message).show();
            errorItems.push('<li><a href="#' + fieldId + '">' + message + '</a></li>');
            isValid = false;
        }

        // Division Grade Code — add mode only
        if (!isEdit) {
            var dgCode = $.trim($('#DivisionGradeCode').val());
            if (!dgCode) {
                markInvalid('DivisionGradeCode', 'Division Grade is required.');
            }
        }

        // Grade Code
        if (!$('#GradeCode').val()) {
            markInvalid('GradeCode', 'Grade code is required.');
        }

        // Division
        if (!$('#Division').val()) {
            markInvalid('Division', 'Division is required.');
        }

        // Show error summary if any failures
        if (!isValid) {
            $('.govuk-error-summary__list').html(errorItems.join(''));
            $('.govuk-error-summary').show().focus();
        }

        return isValid;
    }
</script>
