@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.DivisionGradeMaintenanceViewModel

@{
    ViewData["Title"] = "Division Grade Maintenance";
}

<main id="main-content">
    <div class="container-fluid">
        <!-- Breadcrumb section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div style="padding: 5px 5px; border-bottom: 1px solid #b4b4b4" class="row">
                    <div style="display: flex; font-size: 14px; align-items: center; justify-content: space-between;">
                        <div class="col-md-6">
                            <nav aria-label="Breadcrumb">
                                <a class="" href="@Url.Action("Index", "Home", new { area = "FPS" })">Home</a> &gt; MAB &gt; Maintenance Menu &gt; Division Grade Maintenance
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Title section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">Division Grade Maintenance</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">
                                    <!-- Side nav -->
                                    @await Html.PartialAsync("_MaintenanceSideNav", "DivisionGradeMaintenance")
                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">
                                        <!-- DataGrid section -->
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full mt-2">
                                                <!-- Grid Container -->
                                                <div id="@($"gridContainer_{Model.DivisionGradeGrid.GridId}")">
                                                    @await Html.PartialAsync("_DataGrid", Model.DivisionGradeGrid)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <style>
        .sup_highlight_new {
            background-color: #b8d4ea !important;
            transition: background-color 3s ease;
        }
    </style>
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        // Override year selector to stay on this page with the new year
        $(document).ready(function () {
            $('#yearSelector').off('change').on('change', function () {
                var year = $(this).val();
                var url = new URL(window.location.href);
                url.searchParams.set('year', year);
                window.location.href = url.toString();
            });
        });

        function reloadDivisionGradeGrid() {
            var gm = window['gridManager_divisionGradeGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function addDivisionGrade() {
            $.get('/FPS/DivisionGradeMaintenance/Create', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            }).fail(function () {
                alert('An error occurred while loading the form');
            });
        }

        function editDivisionGrade(btn) {
            var id = $(btn).data('id');
            $.get('/FPS/DivisionGradeMaintenance/Edit', { id: id }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            }).fail(function () {
                alert('An error occurred while loading the edit form');
            });
        }

        function deleteDivisionGrade(btn) {
            var id = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this record?').then(function (result) {
                if (!result) return;
                $.ajax({
                    url: '/FPS/DivisionGradeMaintenance/Delete?id=' + encodeURIComponent(id),
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            showGovukAlert('Division grade deleted successfully').then(function () {
                                reloadDivisionGradeGrid();
                            });
                        } else {
                            showGovukAlert('Error: ' + (response.message || 'Delete failed.'));
                        }
                    },
                    error: function () {
                        showGovukAlert('An error occurred while deleting.');
                    }
                });
            });
        }

        function saveDivisionGrade() {
            var isEdit = $('#hdnIsEdit').val() === 'true';
            var originalCode = $('#hdnOriginalCode').val();

            var gradeCodeVal = $('#GradeCode').val();
            var divisionVal = $('#Division').val();

            var dto = {
                DivisionGradeCode: isEdit ? originalCode : $('#DivisionGradeCode').val(),
                GradeCode: gradeCodeVal || null,
                Division: divisionVal || null,
                ChargeRate: parseDecimalOrNull($('#ChargeRate').val()),
                DirectRate: parseDecimalOrNull($('#DirectRate').val()),
                PayRate: parseDecimalOrNull($('#PayRate').val()),
                Npr: parseDecimalOrNull($('#Npr').val()),
                Ohr: parseDecimalOrNull($('#Ohr').val())
            };

            var url = isEdit
                ? '/FPS/DivisionGradeMaintenance/Edit?id=' + encodeURIComponent(originalCode)
                : '/FPS/DivisionGradeMaintenance/Create';

            $.ajax({
                url: url,
                type: 'POST',
                data: JSON.stringify(dto),
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    if (data.success) {
                        var newCode = !isEdit ? dto.DivisionGradeCode : null;
                        closeModal();
                        reloadDivisionGradeGrid();
                        if (newCode) {
                            // After grid reloads, find the new row by its data-id, move it to top and highlight it
                            var attempts = 0;
                            var maxAttempts = 20;
                            var interval = setInterval(function () {
                                attempts++;
                                var $row = $('tr[data-id="' + newCode + '"], td:contains("' + newCode + '")').closest('tr');
                                if ($row.length) {
                                    clearInterval(interval);
                                    var $tbody = $row.closest('tbody');
                                    $tbody.prepend($row);
                                    $row.addClass('sup_highlight_new');
                                    setTimeout(function () { $row.removeClass('sup_highlight_new'); }, 3000);
                                    $row[0].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                                } else if (attempts >= maxAttempts) {
                                    clearInterval(interval);
                                }
                            }, 150);
                        }
                    } else {
                        alert('Save failed: ' + (data.message || 'Unknown error.'));
                    }
                },
                error: function () {
                    alert('An error occurred while saving.');
                }
            });
        }

        function closeModal() {
            $('#modaPopupBody').html('');
            $('#modalPopup').removeClass('show');
        }

        function parseDecimalOrNull(val) {
            if (val === null || val === undefined || val.toString().trim() === '') return null;
            var parsed = parseFloat(val);
            return isNaN(parsed) ? null : parsed;
        }

    </script>
}
