@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.BBQueryViewModel

@{
    ViewData["Title"] = "Budget Bids Query";
}

<div class="govuk-grid-row sup_border-bottom govuk-!-margin-bottom-3">
    <div class="govuk-grid-column-one-half isFloatLeft">
        <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-3 govuk-!-margin-left-3 isCustomPageHeadings">
            Budget Bids Query
        </h1>
    </div>
    <div class="govuk-grid-column-one-half isFloatRight isBudgetBidsQuery">
        <table class="govuk-table govuk-!-margin-bottom-2">
            <tbody class="govuk-table__body">
                <tr class="govuk-table__row">
                    <th scope="row" class="govuk-table__header govuk-!-padding-bottom-0 govuk-!-padding-right-0 isNoBottomBorder">
                        <label class="govuk-label govuk-!-margin-bottom-0 govuk-!-padding-right-0 govuk-!-font-weight-bold isNoWrap" for="SelectedProfitCentre">
                            Resource Centre:
                        </label>
                    </th>
                    <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-right-1 isNoBottomBorder">
                        <select class="govuk-select govuk-!-font-size-16"
                                id="SelectedProfitCentre"
                                name="SelectedProfitCentre">
                            <option value="">--Select Resource Centre--</option>
                            @foreach (var pc in Model.ProfitCentreOptions)
                            {
                                if (Model.SelectedProfitCentre == pc.Value)
                                {
                                    <option value="@pc.Value" selected>@pc.Text</option>
                                }
                                else
                                {
                                    <option value="@pc.Value">@pc.Text</option>
                                }
                            }
                        </select>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_bottom_10">
    <div class="govuk-grid-column-full">
        @* The grid partial is always rendered so its gridManager is registered for reloads,
           but the container stays hidden until a Resource Centre is selected. The number of
           columns depends on the selected Resource Centre, so the table structure must not be
           shown by default. *@
        <div id="gridContainer_bbQueryGrid" style="@(string.IsNullOrWhiteSpace(Model.SelectedProfitCentre) ? "display:none" : "")">
            @await Html.PartialAsync("_DataGrid", Model.Grid)
        </div>
    </div>
</div>

@section Scripts {
    @* getBBQueryExtraFilters must be global before the _DataGrid grid manager is used *@
    <script>
        function getBBQueryExtraFilters() {
            return { profitCentre: document.getElementById('SelectedProfitCentre')?.value ?? '' };
        }

        document.addEventListener('DOMContentLoaded', function () {
            var pc = document.getElementById('SelectedProfitCentre');
            if (!pc) return;

            // Auto-trigger grid when session value is restored on page load
            if (pc.value) {
                var gm = window['gridManager_bbQueryGrid'];
                if (gm) {
                    showLoader();
                    gm.reloadGrid({ filter: '{}', sortBy: '', descending: false, page: 1 });
                }
            }

            pc.addEventListener('change', function () {
                var container = document.getElementById('gridContainer_bbQueryGrid');

                // No Resource Centre selected: clear any existing table structure/data
                // and keep the grid hidden. Columns are generated per Resource Centre.
                if (!pc.value) {
                    if (container) {
                        container.innerHTML = '';
                        container.style.display = 'none';
                    }
                    return;
                }

                var gm = window['gridManager_bbQueryGrid'];
                if (gm) {
                    if (container) {
                        container.style.display = '';
                    }
                    showLoader();
                    gm.reloadGrid({ filter: '{}', sortBy: '', descending: false, page: 1 });
                }
            });

            document.addEventListener('gridReloaded', function (e) {
                if (e.detail && e.detail.gridId === 'bbQueryGrid') {
                    hideLoader();
                }
            });
        });
    </script>
}
