@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProjectPlanViewerViewModel
@{
    ViewData["Title"] = "Project Plan Viewer";
}

<script src="~/js/common/_govuk_tabs.js"></script>
<link href="~/css/common/_govuk_tabs.css" rel="stylesheet" />


<div class="container-fluid">

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full govuk-!-padding-0">
            <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                Project Plan Viewer
            </h1>
        </div>
    </div>

    <!-- Selection filters -->
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div class="govuk-!-margin-right-2 ">
                <div class="search_panel sup_p_0 sup_border_b_0">
                <div class="row govuk-!-margin-bottom-3">
                    <div class="govuk-grid-column-one-third">
                        <div class="govuk-form-group govuk-!-margin-bottom-0">
                            <label class="govuk-label govuk-!-font-weight-bold" for="programSelect">Select a Programme</label>
                            <select class="govuk-select govuk-!-font-size-16" id="programSelect" asp-items="Model.ProgramList">
                                <option value="">--select--</option>
                            </select>
                        </div>
                    </div>

                    <div class="govuk-grid-column-one-third">
                        <div class="govuk-form-group govuk-!-margin-bottom-0">
                            <label class="govuk-label govuk-!-font-weight-bold" for="projectGroupSelect">or Select Group</label>
                            <select class="govuk-select govuk-!-font-size-16" id="projectGroupSelect" asp-items="Model.ProjectGroupList">
                                <option value="">--select--</option>
                            </select>
                        </div>
                    </div>

                    <div class="govuk-grid-column-one-third">
                        <div class="govuk-form-group govuk-!-margin-bottom-0">
                            <label class="govuk-label govuk-!-font-weight-bold" for="projectSelect">or Find Project</label>
                            <select class="govuk-select govuk-!-font-size-16" id="projectSelect" asp-items="Model.ProjectList">
                                <option value="">--select--</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            </div>
        </div>
    </div>

    <!-- Project Details Grid -->
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div id="gridContainer_@Model.ProjectDetailsGrid.GridId">
                @await Html.PartialAsync("_DataGrid", Model.ProjectDetailsGrid)
            </div>
        </div>
    </div>

    <!-- Project Details Partial (loaded on row click) -->
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            <div id="projectDetailsContainer">
                @await Html.PartialAsync("_ProjectDetails", Model.ProjectDetails)
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/fps_js/ProjectPlanViewer.js"></script>
}
