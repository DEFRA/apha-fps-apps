@{
    var panelId = ViewData["PanelId"] as string ?? "panel";
    var panelTitle = ViewData["PanelTitle"] as string ?? "Permissions";
    var options = ViewData["Options"] as List<string> ?? new List<string>();
    var allowFreeText = ViewData["AllowFreeText"] as bool? ?? false;
}

<section class="fps-mup-list-panel" aria-labelledby="@(panelId)Heading">
    <h3 id="@(panelId)Heading" class="govuk-heading-s sup_align_heading sup_border sup_border_b_0">
        @panelTitle
    </h3>
    <div class="fps-mup-panel-actions sup_border sup_border_t_0">
        @if (!allowFreeText)
        {
            <button type="button" class="govuk-link mup-select-action" onclick="selectAll('@panelId')">Select all</button>
        }
        else
        {
            <span class="mup-select-action" style="visibility:hidden;">Select all</span>
        }
        <button type="button" class="govuk-link mup-select-action" onclick="clearAll('@panelId')">Clear</button>
        <span id="@(panelId)Count" class="govuk-hint govuk-!-margin-bottom-0">0 selected</span>
    </div>
    <fieldset id="panel_@panelId" class="fps-mup-checkbox-list sup_border" aria-label="@panelTitle" data-roving-checkboxes="true">
        @if (options.Count == 0 && !allowFreeText)
        {
            <p class="govuk-body-s" style="color:#666; padding: 8px;">No options available.</p>
        }
        else
        {
            var isFirst = true;
            foreach (var opt in options)
            {
                var cbId = $"cb_{panelId}_{opt.Replace(" ", "_")}";
                <label class="fps-mup-checkbox-label" for="@cbId">
                    <input type="checkbox" id="@cbId" class="fps-mup-checkbox permission-item" value="@opt" tabindex="@(isFirst ? "0" : "-1")" />
                    <span class="fps-mup-checkbox-text">@opt</span>
                </label>
                isFirst = false;
            }
        }
        @if (allowFreeText)
        {
            <div id="@(panelId)_freeTextContainer" class="fps-mup-freetext-container">
                <div id="@(panelId)_newEntries"></div>
                <div class="fps-mup-freetext-row">
                    <input type="text" class="govuk-input fps-mup-freetext-input" id="@(panelId)_newEntry"
                           maxlength="2" placeholder="Enter code" aria-label="New test owner code" />
                    <button type="button" class="fps-mup-freetext-add-btn" onclick="addFreeTextEntry('@panelId')"
                            title="Add new entry" aria-label="Add new entry">+</button>
                </div>
            </div>
        }
    </fieldset>
</section>

<script>
    function selectAll(panelId) {
        $('#panel_' + panelId + ' input.permission-item').prop('checked', true);
        if (typeof updateCount === 'function') updateCount(panelId);
        if (typeof updateSaveButtonState === 'function') updateSaveButtonState();
    }
    function clearAll(panelId) {
        $('#panel_' + panelId + ' input.permission-item').prop('checked', false);
        if (typeof updateCount === 'function') updateCount(panelId);
        if (typeof updateSaveButtonState === 'function') updateSaveButtonState();
    }

    // Roving tabindex + arrow-key navigation for the checkbox list within a panel.
    // Tab moves focus into/out of the fieldset once; arrow keys move between checkboxes.
    (function () {
        function getCheckboxes(fieldset) {
            return Array.prototype.slice.call(fieldset.querySelectorAll('input.permission-item'));
        }

        function focusCheckbox(fieldset, checkboxes, index) {
            if (!checkboxes.length) return;
            const nextIndex = (index + checkboxes.length) % checkboxes.length;
            checkboxes.forEach(function (cb) { cb.tabIndex = -1; });
            checkboxes[nextIndex].tabIndex = 0;
            checkboxes[nextIndex].focus();
        }

        function onKeyDown(event) {
            const key = event.key;
            const navigationKeys = ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Home', 'End'];
            if (navigationKeys.indexOf(key) === -1) return;

            const fieldset = event.currentTarget.closest('fieldset[data-roving-checkboxes="true"]');
            if (!fieldset) return;

            const checkboxes = getCheckboxes(fieldset);
            const currentIndex = checkboxes.indexOf(event.target);
            if (currentIndex === -1) return;

            event.preventDefault();

            switch (key) {
                case 'ArrowDown':
                case 'ArrowRight':
                    focusCheckbox(fieldset, checkboxes, currentIndex + 1);
                    break;
                case 'ArrowUp':
                case 'ArrowLeft':
                    focusCheckbox(fieldset, checkboxes, currentIndex - 1);
                    break;
                case 'Home':
                    focusCheckbox(fieldset, checkboxes, 0);
                    break;
                case 'End':
                    focusCheckbox(fieldset, checkboxes, checkboxes.length - 1);
                    break;
            }
        }

        function onFocusIn(event) {
            const fieldset = event.currentTarget.closest('fieldset[data-roving-checkboxes="true"]');
            if (!fieldset) return;

            getCheckboxes(fieldset).forEach(function (cb) { cb.tabIndex = (cb === event.target) ? 0 : -1; });
        }

        function initPanel(fieldset) {
            if (!fieldset || fieldset.dataset.rovingInitialized === 'true') return;
            fieldset.dataset.rovingInitialized = 'true';

            getCheckboxes(fieldset).forEach(function (cb) {
                cb.addEventListener('keydown', onKeyDown);
                cb.addEventListener('focusin', onFocusIn);
            });
        }

        initPanel(document.getElementById('panel_@panelId'));
    })();
</script>
