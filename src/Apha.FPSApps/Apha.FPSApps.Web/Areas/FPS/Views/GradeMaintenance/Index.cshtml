@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.GradeMaintenanceViewModel

@{
    // TRANSFORMENGINE: Title from HTML prototype <title>2025-2026 : Grade Maintenance</title>
    ViewData["Title"] = "2025-2026 : Grade Maintenance";
}

<main id="main-content">
    <div class="container-fluid">

        <!-- Title — matches frmMaintGrade.html govuk-heading-s -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    Grade Maintenance
                </h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">

                                    <!-- TRANSFORMENGINE: _MaintenanceSideNav partial — active token "GradeMaintenance" -->
                                    @await Html.PartialAsync("_MaintenanceSideNav", "GradeMaintenance")

                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">

                                        <!-- DataGrid section -->
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full mt-2">
                                                <!-- TRANSFORMENGINE: grid container ID = gridContainer_gradeGrid
                                                     matching JS: containerSelector:'#gridContainer_gradeList'
                                                     NOTE: JS uses 'gradeList' for container but 'gradeGrid' for gridId.
                                                     The _DataGrid partial and window['gridManager_gradeGrid'] use the GridId value. -->
                                                <div id="@($"gridContainer_{Model.GradeGrid.GridId}")">
                                                    @await Html.PartialAsync("_DataGrid", Model.GradeGrid)
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>

        // TRANSFORMENGINE: reloadGradeGrid — uses gm.reloadGrid({ page: 1 }) (NOT gm.reload())
        function reloadGradeGrid() {
            var gm = window['gridManager_gradeGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        // TRANSFORMENGINE: addGrade — AllowAdd:true from JS showAddButton:true
        // Loads _AddEditGrade partial (empty GradeItem) into shared modal host
        function addGrade() {
            $.get('/FPS/GradeMaintenance/Create', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            }).fail(function () {
                showGovukAlert('An error occurred while loading the form');
            });
        }

        // TRANSFORMENGINE: editGrade — AllowEdit:true from JS openTblGradeEditModal button
        // $(btn).data('id') reads data-id attribute emitted by _DataGrid EditFunction
        function editGrade(btn) {
            var id = $(btn).data('id');
            $.get('/FPS/GradeMaintenance/Edit', { id: id }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            }).fail(function () {
                showGovukAlert('An error occurred while loading the edit form');
            });
        }

        // TRANSFORMENGINE: deleteGrade — AllowDelete:true from JS handleTblGradeDelete button
        // JS prototype used window.confirm(); MVC equivalent uses showGovukConfirm (govuk-alert pattern)
        function deleteGrade(btn) {
            var id = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this record?').then(function (result) {
                if (!result) return;
                $.ajax({
                    url: '/FPS/GradeMaintenance/Delete?id=' + encodeURIComponent(id),
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            showGovukAlert('Grade deleted successfully').then(function () {
                                reloadGradeGrid();
                            });
                        } else {
                            showGovukAlert('Error: ' + (response.message || 'Delete failed.'));
                        }
                    },
                    error: function () {
                        showGovukAlert('An error occurred while deleting.');
                    }
                });
            });
        }

        // TRANSFORMENGINE: saveGrade — called from _AddEditGrade.cshtml when isEditMode=false
        // Collects GradeCode, Description, AvSalary from modal inputs and POST to Create
        function saveGrade() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#addGradeForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var dto = {
                GradeCode: $('#GradeCode').val(),
                Description: $('#Description').val() || null,
                AvSalary: parseDecimalOrNull($('#AvSalary').val())
            };

            $.ajax({
                url: '/FPS/GradeMaintenance/Create',
                type: 'POST',
                data: JSON.stringify(dto),
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    if (data.success) {
                        showGovukAlert(data.message || 'Grade created successfully.');
                        closeModal();
                        reloadGradeGrid();
                    } else {
                        displayServerValidationErrors(data.errors, data.message, '#modaPopupBody');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showGovukAlert('An error occurred while saving.');
                    }
                }
            });
        }

        // TRANSFORMENGINE: updateGrade — called from _AddEditGrade.cshtml when isEditMode=true
        // GradeCode is read-only on edit; originalCode taken from hdnOriginalCode hidden field
        function updateGrade() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#editGradeForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var originalCode = $('#hdnOriginalCode').val();

            var dto = {
                GradeCode: originalCode,
                Description: $('#Description').val() || null,
                AvSalary: parseDecimalOrNull($('#AvSalary').val())
            };

            $.ajax({
                url: '/FPS/GradeMaintenance/Edit?id=' + encodeURIComponent(originalCode),
                type: 'POST',
                data: JSON.stringify(dto),
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    if (data.success) {
                        showGovukAlert(data.message || 'Grade updated successfully.');
                        closeModal();
                        reloadGradeGrid();
                    } else {
                        displayServerValidationErrors(data.errors, data.message, '#modaPopupBody');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showGovukAlert('An error occurred while saving.');
                    }
                }
            });
        }

        function closeModal() {
            $('#modaPopupBody').html('');
            $('#modalPopup').removeClass('show');
        }

        // TRANSFORMENGINE: parseDecimalOrNull — shared decimal parsing helper
        // Used for AvSalary (optional numeric field; null when empty/invalid)
        function parseDecimalOrNull(val) {
            if (val === null || val === undefined || val.toString().trim() === '') return null;
            var parsed = parseFloat(val);
            return isNaN(parsed) ? null : parsed;
        }

    </script>
}
