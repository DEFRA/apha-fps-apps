@using Apha.FPSApps.Web.Areas.FPS.Models
@using Apha.FPSApps.Web.Models.Components.DataGrid
@model PlanStaffZTCodePageViewModel

@{
    ViewData["Title"] = "Plan Staff ZT Codes";
}

<div class="govuk-grid-row sup_margin_left_right_0 govuk-!-margin-bottom-3 isPlanStaffZtCodesPage">
    <div class="govuk-grid-column-full govuk-!-padding-left-0 govuk-!-padding-right-0 sup_border-bottom govuk-!-margin-bottom-3">
        <div class="govuk-grid-column-one-half govuk-!-padding-right-0">
            <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-2 govuk-!-margin-left-0 isCustomPageHeadings isFloatLeft">
                Plan Staff Against ZT Codes
            </h1>
        </div>

        <div class="govuk-grid-column-one-half govuk-!-padding-left-0">
            @{
                // Resolve the single Back target up-front so the page renders exactly one
                // "Back" link. Multiple anchors sharing identical link text but pointing at
                // different destinations is an accessibility failure.
                string backLinkUrl;
                if (Model.ReturnToSsr)
                {
                    backLinkUrl = Url.Action("Index", "SetUpStaffResources", new { area = "FPS" })!;
                }
                else if (Context.Request.Query["source"] == "resource")
                {
                    backLinkUrl = Url.Action("Index", "ResourceSetUp", new
                    {
                        area = "FPS",
                        profitCentre = Context.Request.Query["profitCentre"].ToString(),
                        pcGrade = Context.Request.Query["pcGrade"].ToString(),
                        wgGrade = Context.Request.Query["wgGrade"].ToString(),
                        staffId = Model.StaffId
                    })!;
                }
                else
                {
                    backLinkUrl = "JavaScript:history.back()";
                }
            }
            <a href="@backLinkUrl" class="govuk-back-link isFloatRight">Back</a>
        </div>
    </div>
    
    <div class="govuk-grid-column-full">
        <ul class="govuk-list isCustomList">
            <li class="isFloatLeft govuk-!-margin-right-1">
                <label class="govuk-!-font-weight-bold govuk-!-margin-right-1">Staff Name:</label>
                <label>@Model.Name</label>
            </li>

            <li class="isFloatLeft">
                <label class="govuk-!-font-weight-bold govuk-!-margin-right-1">Grade:</label>
                <label>@Model.WorkGroupGrade</label>
            </li>
        </ul>
    </div>
</div>



<div class="govuk-grid-row govuk-!-margin-top-3 sup_margin_left_right_0">
    <div class="govuk-grid-column-three-quarters">
        <div id="@($"gridContainer_{Model.GridConfig.GridId}")">
            @await Html.PartialAsync("_DataGrid", Model.GridConfig)
        </div>
        <div class="govuk-!-margin-top-2 sup_border" style="padding: 10px; background-color: #f3f2f1;">
            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 10px;">
                <span class="govuk-label govuk-!-font-weight-bold">Total Planned Hours:</span>
                <input type="text"
                       id="total-planned-hours"
                       class="govuk-input text-AlignRight"
                       style="width: 150px; text-align: right;"
                       value="@Model.PlannedAdminZT"
                       readonly
                       aria-label="Total Planned Hours" />
            </div>
        </div>
    </div>

    <div class="govuk-grid-column-one-quarter isTimeSummary">
        <div class="govuk-summary-card govuk-!-margin-bottom-0">
            <div class="govuk-summary-card__title-wrapper">
                <h2 class="govuk-summary-card__title isBlock isFullWidth govuk-!-text-align-centre">Time Summary</h2>
            </div>
            <div class="govuk-summary-card__content">
                <dl class="govuk-summary-list govuk-!-margin-bottom-0">
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">HrsPaid</dt>
                        <dd class="govuk-summary-list__value" id="ts-hrspaid">@Model.HrsPaid</dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Leave</dt>
                        <dd class="govuk-summary-list__value" id="ts-leave">@Model.Leave</dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">SickSpecial</dt>
                        <dd class="govuk-summary-list__value" id="ts-sickspecial">@Model.SickSpecial</dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">HrsAvail</dt>
                        <dd class="govuk-summary-list__value" id="ts-hrsavail">@Model.HrsAvail</dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Planned Admin [ZT]</dt>
                        <dd class="govuk-summary-list__value" id="ts-planned-zt">@Model.PlannedAdminZT</dd>
                    </div>
                    <div class="govuk-summary-list__row">
                        <dt class="govuk-summary-list__key">Free for Chargeable Work</dt>
                        <dd class="govuk-summary-list__value" id="ts-free">@Model.FreeForChargeableWork</dd>
                    </div>
                </dl>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/fps_js/PlanStaffZTCode.js"></script>
    <script>
        ZtPlanConfig.staffId = '@Html.Raw(Model.StaffId)';
        ZtPlanConfig.summaryUrl = '@Url.Action("GetStaffSummary", "PlanStaffZTCode", new { area = "FPS" })';
        ZtPlanConfig.createUrl = '@Url.Action("Create", "PlanStaffZTCode", new { area = "FPS" })';
        ZtPlanConfig.editUrl = '@Url.Action("Edit", "PlanStaffZTCode", new { area = "FPS" })';
        ZtPlanConfig.deleteUrl = '@Url.Action("Delete", "PlanStaffZTCode", new { area = "FPS" })';
        ZtPlanConfig.gridId = '@Model.GridConfig.GridId';
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}