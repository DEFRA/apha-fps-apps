@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.TestListVlaViewModel

@{
    ViewData["Title"] = "2025-2026 : Test List for VLA";
}

@section Styles {
    <link rel="stylesheet" href="~/css/common/_govuk_tabs.css" />
}

<main id="main-content">
    <div class="govuk-!-margin-bottom-5">

        @* ── Breadcrumb ─────────────────────────────────────────────────────── *@
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="govuk-grid-row fps-sr-breadcrumb-row">
                    <div class="fps-sr-breadcrumb-flex sup_context_row">
                        <div class="govuk-grid-column-two-thirds sup_context_placeholder"></div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Main Test List grid ─────────────────────────────────────────────── *@
        <div class="govuk-grid-row sup_margin_left_right_10">
            <div class="govuk-grid-column-full sup_p_0">
                <div id="gridContainer_testListVlaGrid">
                    @await Html.PartialAsync("_DataGrid", Model.TestListGrid)
                </div>
            </div>
        </div>

        @* ── Tab panel — Test Requirements / Component Charges / Suppliers ─── *@
        <div class="govuk-grid-row sup_margin_left_right_10 govuk-!-margin-top-5">
            <div class="govuk-grid-column-full sup_p_0">

                <div class="govuk-tabs" id="stage2-tabs" data-module="govuk-tabs">
                    <ul class="govuk-tabs__list">
                        <li class="govuk-tabs__list-item govuk-tabs__list-item--selected">
                            <a class="govuk-tabs__tab" href="#tab-test-requirements">Test Requirements</a>
                        </li>
                        <li class="govuk-tabs__list-item">
                            <a class="govuk-tabs__tab" href="#tab-component-charges">Component Charges</a>
                        </li>
                        <li class="govuk-tabs__list-item">
                            <a class="govuk-tabs__tab" href="#tab-suppliers">Suppliers</a>
                        </li>
                    </ul>

                    @* ── Tab: Test Requirements ─────────────────────────────── *@
                    <div class="govuk-tabs__panel active" id="tab-test-requirements">
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full">
                                <div id="gridContainer_testRequirementsGrid">
                                    @await Html.PartialAsync("_DataGrid", Model.TestRequirementsGrid)
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ── Tab: Component Charges ─────────────────────────────── *@
                    <div class="govuk-tabs__panel" id="tab-component-charges">
                        <div class="govuk-grid-row sup_flex_row">
                            <div class="govuk-grid-column-one-half">
                                <div id="gridContainer_componentChargesGeneralGrid">
                                    @await Html.PartialAsync("_DataGrid", Model.ComponentChargesGeneralGrid)
                                </div>
                                <div class="govuk-grid-row govuk-!-margin-top-2">
                                    <div class="govuk-grid-column-full">
                                        <label class="govuk-label govuk-label--s govuk-!-margin-bottom-1"
                                               for="stage2-component-total">Component Total Price</label>
                                        <input class="govuk-input govuk-input--width-10"
                                               id="stage2-component-total"
                                               type="text" disabled />
                                    </div>
                                    <div class="govuk-grid-column-full govuk-!-margin-top-2">
                                        <label class="govuk-label govuk-label--s govuk-!-margin-bottom-1"
                                               for="stage2-vla-unit-price">VLA Unit Price</label>
                                        <input class="govuk-input govuk-input--width-10"
                                               id="stage2-vla-unit-price"
                                               type="text" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="govuk-grid-column-one-half">
                                <div id="gridContainer_componentChargesProjectGrid">
                                    @await Html.PartialAsync("_DataGrid", Model.ComponentChargesProjectGrid)
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ── Tab: Suppliers ─────────────────────────────────────── *@
                    <div class="govuk-tabs__panel" id="tab-suppliers">
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full">
                                <div id="gridContainer_suppliersGrid">
                                    @await Html.PartialAsync("_DataGrid", Model.SuppliersGrid)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    <script src="~/js/common/_govuk_tabs.js"></script>
    <script>
        // ── State ───────────────────────────────────────────────────────────────
        var selectedTestCode = '';

        // ── Grid reload helpers ─────────────────────────────────────────────────

        function reloadTestListVlaGrid() {
            var gm = window['gridManager_testListVlaGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadTestRequirementsGrid() {
            var gm = window['gridManager_testRequirementsGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadComponentChargesGeneralGrid() {
            var gm = window['gridManager_componentChargesGeneralGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadComponentChargesProjectGrid() {
            var gm = window['gridManager_componentChargesProjectGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadSuppliersGrid() {
            var gm = window['gridManager_suppliersGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        function reloadAllTabGrids() {
            reloadTestRequirementsGrid();
            reloadComponentChargesGeneralGrid();
            reloadComponentChargesProjectGrid();
            reloadSuppliersGrid();
        }

        // ── Extra-filter methods (called automatically by _DataGrid on every reload) ──

        function getTestListVlaExtraFilters() {
            return {};
        }

        function getTestRequirementExtraFilters() {
            return { testCode: selectedTestCode };
        }

        function getComponentChargesExtraFilters() {
            return { testCode: selectedTestCode };
        }

        function getComponentChargesProjectExtraFilters() {
            return { testCode: selectedTestCode };
        }

        // ── Parent row selection (clicking a TestListVla row updates child grids) ──

        function selectTestListVlaRow(btn) {
            var itemCode = $(btn).data('id');
            if (!itemCode) { return; }
            selectedTestCode = itemCode;

            // Highlight selected row
            $('#tbl_testListVlaGrid tbody tr').removeClass('selected-row');
            $(btn).closest('tr').addClass('selected-row');

            reloadAllTabGrids();
        }

        // ── Main TestListVla CRUD ───────────────────────────────────────────────

        function addTestListVla() {
            $.get('/FPS/TestListVla/CreateTestListVla', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function editTestListVla(btn) {
            var itemCode = $(btn).data('id');
            $.get('/FPS/TestListVla/EditTestListVla', { itemCode: itemCode }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function deleteTestListVla(btn) {
            var itemCode = $(btn).data('id');
            if (confirm('Are you sure you want to delete this test record?')) {
                $.ajax({
                    url: '/FPS/TestListVla/DeleteTestListVla?itemCode=' + encodeURIComponent(itemCode),
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            alert('Test deleted successfully.');
                            reloadTestListVlaGrid();
                            if (selectedTestCode === itemCode) {
                                selectedTestCode = '';
                                reloadAllTabGrids();
                            }
                        } else {
                            alert('Error: ' + (response.message || 'Delete failed.'));
                        }
                    },
                    error: function () { alert('An error occurred while deleting.'); }
                });
            }
        }

        // ── Test Requirement CRUD ───────────────────────────────────────────────

        function addTestRequirement() {
            if (!selectedTestCode) {
                alert('Please select a test from the list above first.');
                return;
            }
            $.get('/FPS/TestListVla/CreateTestRequirement', { testCode: selectedTestCode }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function editTestRequirement(btn) {
            var buyer = $(btn).data('id');
            $.get('/FPS/TestListVla/EditTestRequirement',
                { testCode: selectedTestCode, buyer: buyer },
                function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                });
        }

        function deleteTestRequirement(btn) {
            var buyer = $(btn).data('id');
            if (confirm('Are you sure you want to delete this test requirement?')) {
                $.ajax({
                    url: '/FPS/TestListVla/DeleteTestRequirement?testCode=' +
                         encodeURIComponent(selectedTestCode) + '&buyer=' + encodeURIComponent(buyer),
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            alert('Test requirement deleted successfully.');
                            reloadTestRequirementsGrid();
                        } else {
                            alert('Error: ' + (response.message || 'Delete failed.'));
                        }
                    },
                    error: function () { alert('An error occurred while deleting.'); }
                });
            }
        }

        // ── Component Charge (General / RC Cost) CRUD ──────────────────────────

        function addComponentChargeGeneral() {
            if (!selectedTestCode) {
                alert('Please select a test from the list above first.');
                return;
            }
            $.get('/FPS/TestListVla/CreateComponentChargeGeneral', { testCode: selectedTestCode }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function editComponentChargeGeneral(btn) {
            var profitCentre = $(btn).data('id');
            $.get('/FPS/TestListVla/EditComponentChargeGeneral',
                { testCode: selectedTestCode, profitCentre: profitCentre },
                function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                });
        }

        function deleteComponentChargeGeneral(btn) {
            var profitCentre = $(btn).data('id');
            if (confirm('Are you sure you want to delete this component charge?')) {
                $.ajax({
                    url: '/FPS/TestListVla/DeleteComponentChargeGeneral?testCode=' +
                         encodeURIComponent(selectedTestCode) + '&profitCentre=' + encodeURIComponent(profitCentre),
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            alert('Component charge deleted successfully.');
                            reloadComponentChargesGeneralGrid();
                        } else {
                            alert('Error: ' + (response.message || 'Delete failed.'));
                        }
                    },
                    error: function () { alert('An error occurred while deleting.'); }
                });
            }
        }

        // ── Component Charge (Project-specific) CRUD ───────────────────────────

        function addComponentChargeProject() {
            if (!selectedTestCode) {
                alert('Please select a test from the list above first.');
                return;
            }
            $.get('/FPS/TestListVla/CreateComponentChargeProject', { testCode: selectedTestCode }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        function editComponentChargeProject(btn) {
            var profitCentre = $(btn).data('id');
            var buyer = $(btn).data('buyer') || '';
            $.get('/FPS/TestListVla/EditComponentChargeProject',
                { testCode: selectedTestCode, buyer: buyer, profitCentre: profitCentre },
                function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass('show');
                });
        }

        function deleteComponentChargeProject(btn) {
            var profitCentre = $(btn).data('id');
            var buyer = $(btn).data('buyer') || '';
            if (confirm('Are you sure you want to delete this project component charge?')) {
                $.ajax({
                    url: '/FPS/TestListVla/DeleteComponentChargeProject?testCode=' +
                         encodeURIComponent(selectedTestCode) + '&buyer=' + encodeURIComponent(buyer) +
                         '&profitCentre=' + encodeURIComponent(profitCentre),
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            alert('Project component charge deleted successfully.');
                            reloadComponentChargesProjectGrid();
                        } else {
                            alert('Error: ' + (response.message || 'Delete failed.'));
                        }
                    },
                    error: function () { alert('An error occurred while deleting.'); }
                });
            }
        }

        // ── Shared modal close ──────────────────────────────────────────────────

        function closeModal() {
            $('#modaPopupBody').html('');
            $('#modalPopup').removeClass('show');
        }
    </script>
}
