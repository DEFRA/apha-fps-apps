@* TRANSFORMENGINE MIGRATION — TestListVla/_AddEditTestListVla.cshtml
   Pattern  : stack-upgrade/msaccess-frm-to-dotnet10-mvc-e2e  Phase 12 — Razor Views (Step 18)
   Migrated : 2026-07-01
   CHANGED:
     - New modal partial for Add/Edit TestListVla (frmTestList vlaTestListModal)
     - Modal fields derived from HTML prototype vlaTestListModal and JS openVlaAddModal/openVlaEditModal:
         vla-form-item-code  → ItemCode*   (visible PK; editable on Add; read-only on Edit via disabled)
         vla-form-short-desc → ShortDescription
         vla-form-description → ItemDescription*
         vla-form-manager    → TestManager
         vla-form-status     → JobStatus
         vla-form-unit-price → UnitPriceVla* (number, £ prefix)
         vla-form-default-price → DefraUnitPrice* (number, £ prefix)
     - isEditMode computed from ItemCode (string PK: empty string = Add mode)
     - FpsYear carried as hidden field for composite PK round-trip
     - Save dispatches to CreateTestListVla (POST) or EditTestListVla (POST) based on isEditMode
   PRESERVED:
     - Two-column layout from HTML prototype (ItemCode | Short Desc), (Manager | Status), (UnitPrice | DefaultPrice)
     - Full-width Description row
     - aria-required semantics and govuk-input__wrapper £ prefix for currency fields
     - govuk modal header / body / footer structure mirroring existing FPS partials
   DEFERRED / REQUIRES HUMAN REVIEW:
     - TRANSFORMENGINE TODO: owner, chargeMethod, priceAhvg fields from TestListVlaDto are not in the HTML
       prototype modal — omitted. Add hidden fields or additional rows if the service layer requires them.
*@
@model Apha.FPSApps.Web.Areas.FPS.Models.TestListVlaItem

@{
    // TRANSFORMENGINE: isEditMode — ItemCode is string PK; empty = Add, populated = Edit
    var isEditMode = !string.IsNullOrEmpty(Model.ItemCode);
    var title      = isEditMode ? "Edit Test" : "Add Test";
    var saveLabel  = isEditMode ? "Update" : "Save";
}

<div class="modal-header flex-space-center">
    <h3 class="modal-title" style="margin: 0;">@title</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>

<div class="modal-body" style="overflow-y: auto; max-height: calc(80vh - 120px); padding-top: 5px;">

    @* Validation error summary *@
    <div class="govuk-error-summary" role="alert"
         aria-labelledby="vla-error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="vla-error-summary-title">There is a problem</h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list"></ul>
        </div>
    </div>

    <form class="row" id="formTestListVla">
        @Html.AntiForgeryToken()

        @* TRANSFORMENGINE: Hidden fields — composite PK (FpsYear not in modal inputs) *@
        <input type="hidden" id="hdnIsEdit" value="@isEditMode.ToString().ToLower()" />
        <input type="hidden" asp-for="FpsYear" id="hdnFpsYear" />

        @* ── Row 1: ItemCode (left) | Short Desc (right) ─────────────────────── *@
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           for="ItemCode">ItemCode <span aria-hidden="true">*</span></label>
                    @* TRANSFORMENGINE: ItemCode is visible PK — editable on Add, disabled on Edit *@
                    @if (isEditMode)
                    {
                        <input class="govuk-input govuk-!-font-size-16"
                               asp-for="ItemCode"
                               id="ItemCode"
                               type="text"
                               aria-required="true"
                               disabled />
                        @* Hidden field preserves value for POST when input is disabled *@
                        <input type="hidden" asp-for="ItemCode" />
                    }
                    else
                    {
                        <input class="govuk-input govuk-!-font-size-16"
                               asp-for="ItemCode"
                               id="ItemCode"
                               type="text"
                               aria-required="true" />
                    }
                    <span asp-validation-for="ItemCode" class="govuk-error-message" style="display:none;"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           for="ShortDescription">Short Desc</label>
                    <input class="govuk-input govuk-!-font-size-16"
                           asp-for="ShortDescription"
                           id="ShortDescription"
                           type="text" />
                </div>
            </div>
        </div>

        @* ── Row 2: Description (full width) ────────────────────────────────── *@
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           for="ItemDescription">Description <span aria-hidden="true">*</span></label>
                    <input class="govuk-input govuk-!-font-size-16"
                           asp-for="ItemDescription"
                           id="ItemDescription"
                           type="text"
                           aria-required="true" />
                    <span asp-validation-for="ItemDescription" class="govuk-error-message" style="display:none;"></span>
                </div>
            </div>
        </div>

        @* ── Row 3: Manager (left) | Status (right) ─────────────────────────── *@
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           for="TestManager">Manager</label>
                    <input class="govuk-input govuk-!-font-size-16"
                           asp-for="TestManager"
                           id="TestManager"
                           type="text" />
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           for="JobStatus">Status</label>
                    <input class="govuk-input govuk-!-font-size-16"
                           asp-for="JobStatus"
                           id="JobStatus"
                           type="text" />
                </div>
            </div>
        </div>

        @* ── Row 4: UnitPrice (left) | Default Unit Price (right) ───────────── *@
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           for="UnitPriceVla">UnitPrice (Std) <span aria-hidden="true">*</span></label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input govuk-!-font-size-16 govuk-input--width-10 currency-input"
                               asp-for="UnitPriceVla"
                               id="UnitPriceVla"
                               type="number"
                               step="0.01"
                               min="0"
                               aria-required="true" />
                    </div>
                    <span asp-validation-for="UnitPriceVla" class="govuk-error-message" style="display:none;"></span>
                </div>
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           for="DefraUnitPrice">Default Unit Price <span aria-hidden="true">*</span></label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input govuk-!-font-size-16 govuk-input--width-10 currency-input"
                               asp-for="DefraUnitPrice"
                               id="DefraUnitPrice"
                               type="number"
                               step="0.01"
                               min="0"
                               aria-required="true" />
                    </div>
                    <span asp-validation-for="DefraUnitPrice" class="govuk-error-message" style="display:none;"></span>
                </div>
            </div>
        </div>

        @* ── Footer buttons ──────────────────────────────────────────────────── *@
        <div class="col-12" style="text-align: right; margin-top: 10px;">
            <button type="button"
                    class="govuk-button govuk-button--secondary sup_margin_0"
                    onclick="closeModal()">Cancel</button>
            <button type="button"
                    class="govuk-button sup_margin_0"
                    onclick="saveTestListVla()">@saveLabel</button>
        </div>

    </form>
</div>

<script>
    // TRANSFORMENGINE: saveTestListVla — dispatches POST to CreateTestListVla or EditTestListVla
    function saveTestListVla() {
        var isEdit = document.getElementById('hdnIsEdit').value === 'true';
        var itemCode = document.getElementById('ItemCode').value || '';

        var dto = {
            ItemCode:         itemCode,
            ItemDescription:  document.getElementById('ItemDescription').value || '',
            ShortDescription: document.getElementById('ShortDescription').value || '',
            TestManager:      document.getElementById('TestManager').value || '',
            JobStatus:        document.getElementById('JobStatus').value || '',
            UnitPriceVla:     parseFloat(document.getElementById('UnitPriceVla').value) || 0,
            DefraUnitPrice:   parseFloat(document.getElementById('DefraUnitPrice').value) || 0,
            FpsYear:          parseInt(document.getElementById('hdnFpsYear').value, 10) || 0
        };

        // TRANSFORMENGINE: required field client-side guard (mirrors HTML aria-required)
        if (!dto.ItemCode || !dto.ItemDescription) {
            alert('ItemCode and Description are required.');
            return;
        }

        var url = isEdit
            ? '/FPS/TestListVla/EditTestListVla'
            : '/FPS/TestListVla/CreateTestListVla';

        $.ajax({
            url:         url,
            type:        'POST',
            data:        JSON.stringify(dto),
            contentType: 'application/json; charset=utf-8',
            success: function (data) {
                if (data.success) {
                    closeModal();
                    reloadTestListVlaGrid();
                } else {
                    alert('Save failed: ' + (data.message || 'Unknown error.'));
                }
            },
            error: function () {
                alert('An error occurred while saving.');
            }
        });
    }
</script>
