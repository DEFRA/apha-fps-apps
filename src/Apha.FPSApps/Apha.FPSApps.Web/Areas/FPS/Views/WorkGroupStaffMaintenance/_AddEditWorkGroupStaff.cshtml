@model Apha.FPSApps.Web.Areas.FPS.Models.WorkGroupEmployeeStaffItem

@{
    var isEditMode = ViewData["IsEditMode"] is bool mode
        ? mode
        : !string.IsNullOrWhiteSpace(Model?.PactId);
    var title = isEditMode ? "Edit WG Staff" : "Add WG Staff";
    var saveLabel = isEditMode ? "Update" : "Save";

    // The staff lookup returns several thousand records. Rendering one <tr> per
    // record into the scrollable modal body makes every main-thread scroll (i.e.
    // dragging the scrollbar thumb) recalculate style/layout over that subtree.
    // The data is emitted as JSON instead and rows are built on demand.
    var staffLookup = (Model?.StaffLookupOptions ?? Enumerable.Empty<Apha.FPSApps.Web.Areas.FPS.Models.WorkGroupStaffLookupItem>())
        .Where(x => !string.IsNullOrWhiteSpace(x.Name))
        .GroupBy(x => x.Name)
        .Select(g => g.First())
        .Select(x => new { pactId = x.PactId, name = x.Name, spNumber = x.SpNumber })
        .ToList();
}

<div class="modal-header">
    <h5 class="modal-title" id="wgStaffModalTitle">@title</h5>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>

<style>
    /* The shared .modal-dialog carries transform/transition, which makes it the
       containing block for the dialog and forces a composited repaint of the whole
       dialog while the modal body scrollbar is dragged. Not needed for this modal. */
    #modalPopup .modal-dialog {
        transform: none;
        transition: none;
    }

    /* The base .dropdown-panel class carries no positioning rules, so this panel
       was laid out in normal flow and pushed the form down when opened. */
    #staff-name-dropdown {
        position: relative;
    }

    #staff-name-panel {
        position: absolute;
        z-index: 9999;
        background: #fff;
        border: 1px solid #b1b4b6;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
</style>

<div id="wgStaffModalBody" class="modal-body" style="overflow-y:auto; overflow-x:hidden; max-height:calc(80vh - 120px); overscroll-behavior:contain;">
    <div class="govuk-error-summary" role="alert" aria-labelledby="error-summary-title"
         tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list"></ul>
        </div>
    </div>

    <form id="formMaintWGStaff" class="row g-2">
        @Html.AntiForgeryToken()

        <input type="hidden" id="hdnIsEdit" value="@(isEditMode ? "true" : "false")" />
        <input type="hidden" id="SpNumber" asp-for="SpNumber" />

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="PactId">
                    PACT Id: @if (isEditMode) { <span class="sup_color_red">*</span> }
                </label>
                @if (isEditMode)
                {
                    <input class="govuk-input govuk-!-font-size-16"
                           id="PactId"
                           asp-for="PactId"
                           type="number"
                           min="1"
                           required
                           readonly />
                }
                else
                {
                    <input class="govuk-input govuk-!-font-size-16 govuk-input--disabled"
                           id="PactId"
                           asp-for="PactId"
                           type="text"
                           placeholder="PACTId will be auto-generated"
                           readonly
                           tabindex="-1" />
                }
                <span asp-validation-for="PactId" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label id="NameLabel" class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Name">
                    Staff Name: <span class="sup_color_red">*</span>
                </label>
                <input type="hidden" id="Name" asp-for="Name" required />
                <div id="staff-name-dropdown" class="govuk-form-group govuk-!-margin-bottom-0">
                    <input type="text"
                           id="staff-name-input"
                           value="-- Select Staff --"
                           class="dropdown-input down-arrow-img govuk-input govuk-!-font-size-16"
                           readonly
                           aria-labelledby="NameLabel"
                           aria-label="Staff Name"
                           aria-haspopup="listbox"
                           aria-expanded="false"
                           aria-controls="staffNameTableBody"
                           onclick="toggleWgStaffNameDropdown()" />

                    <div class="dropdown-panel" id="staff-name-panel" style="display:none; width:100%; top:100%; left:0; max-height:220px; overflow-y:auto; overscroll-behavior:contain;">
                        <label for="staff-name-search" class="govuk-label govuk-visually-hidden">Search staff</label>
                        <input type="text"
                               class="search-box govuk-input govuk-!-font-size-16"
                               id="staff-name-search"
                               placeholder="Type to search staff"
                               aria-label="Search staff"
                               oninput="filterWgStaffNameTable(this.value)" />
                        <table class="period-dropdown__table govuk-table govuk-!-font-size-16" style="table-layout:fixed; margin-bottom:0;">
                            <colgroup>
                                <col style="width:65%;" />
                                <col style="width:35%;" />
                            </colgroup>
                            <thead class="govuk-table__head">
                                <tr class="govuk-table__row">
                                    <th class="govuk-table__header">Name</th>
                                    <th class="govuk-table__header">SPNumber</th>
                                </tr>
                            </thead>
                            <tbody class="govuk-table__body" id="staffNameTableBody" role="listbox" aria-label="Staff results">
                            </tbody>
                        </table>
                    </div>
                    <script type="application/json" id="staff-lookup-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(staffLookup))</script>
                </div>
                <span asp-validation-for="Name" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="WorkGroupGrade">
                    WG Grade: <span class="sup_color_red">*</span>
                </label>
                <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                        id="WorkGroupGrade"
                        asp-for="WorkGroupGrade"
                        required>
                    <option value="">-- Select WG Grade --</option>
                    @foreach (var wgGrade in (Model?.WgGradeOptions ?? System.Linq.Enumerable.Empty<string>()))
                    {
                        <option value="@wgGrade">@wgGrade</option>
                    }
                </select>
                <span asp-validation-for="WorkGroupGrade" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="PersonStatus">
                    Status: <span class="sup_color_red">*</span>
                </label>
                <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                        id="PersonStatus"
                        asp-for="PersonStatus"
                        required>
                    <option value="">-- Select Status --</option>
                    @foreach (var status in Apha.FPSApps.Application.Common.StaffStatus.All)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
                <span asp-validation-for="PersonStatus" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="PersonClass">
                    Class:
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="PersonClass"
                       asp-for="PersonClass"
                       type="text"
                       maxlength="10" />
                <span asp-validation-for="PersonClass" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="HrsPaid">
                    HrsPaid: <span class="sup_color_red">*</span>
                </label>
                <input class="govuk-input govuk-!-font-size-16 js-numeric-decimal"
                       id="HrsPaid"
                       asp-for="HrsPaid"
                       type="text"
                       maxlength="20"
                       required
                       value="@(isEditMode ? Model?.HrsPaid.ToString() : "0")" />
                <span asp-validation-for="HrsPaid" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Leave">
                    Leave: <span class="sup_color_red">*</span>
                </label>
                <input class="govuk-input govuk-!-font-size-16 js-numeric-decimal"
                       id="Leave"
                       asp-for="Leave"
                       type="text"
                       maxlength="20"
                       required
                       value="@(isEditMode ? Model?.Leave.ToString() : "0")" />
                <span asp-validation-for="Leave" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="SickSpecial">
                    SickSpecial: <span class="sup_color_red">*</span>
                </label>
                <input class="govuk-input govuk-!-font-size-16 js-numeric-decimal"
                       id="SickSpecial"
                       asp-for="SickSpecial"
                       type="text"
                       maxlength="20"
                       required
                       value="@(isEditMode ? Model?.SickSpecial.ToString() : "0")" />
                <span asp-validation-for="SickSpecial" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="HrsAvail">
                    HrsAvail: <span class="sup_color_red">*</span>
                </label>
                <input class="govuk-input govuk-!-font-size-16 js-numeric-decimal"
                       id="HrsAvail"
                       asp-for="HrsAvail"
                       type="text"
                       maxlength="20"
                       required
                       value="@(isEditMode ? Model?.HrsAvail.ToString() : "0")" />
            <span asp-validation-for="HrsAvail" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <span class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16">Available?:</span>
                <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input" id="MakeAvailable" asp-for="MakeAvailable" type="checkbox" />
                        <label class="govuk-label govuk-checkboxes__label" for="MakeAvailable">Yes</label>
                    </div>
                </div>
                <span asp-validation-for="MakeAvailable" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <span class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16">Time recorder?:</span>
                <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input" id="TimeRecorder" asp-for="TimeRecorder" type="checkbox" />
                        <label class="govuk-label govuk-checkboxes__label" for="TimeRecorder">Yes</label>
                    </div>
                </div>
                <span asp-validation-for="TimeRecorder" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="StartDate">
                    Start Date:
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="StartDate"
                       asp-for="StartDate"
                       type="date"
                       value="@(Model?.StartDate?.ToString("yyyy-MM-dd") ?? string.Empty)"
                       autocomplete="off" />
                <span asp-validation-for="StartDate" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="EndDate">
                    End Date:
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="EndDate"
                       asp-for="EndDate"
                       type="date"
                       value="@(Model?.EndDate?.ToString("yyyy-MM-dd") ?? string.Empty)"
                       autocomplete="off" />
                <span asp-validation-for="EndDate" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="HoursPerWeek">
                    Hours per week:
                </label>
                <input class="govuk-input govuk-!-font-size-16 js-numeric-decimal"
                       id="HoursPerWeek"
                       asp-for="HoursPerWeek"
                       type="text"
                       maxlength="20" />
                <span asp-validation-for="HoursPerWeek" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

    </form>
</div>

<div class="modal-footer sup_flex_space_center">
    <button class="govuk-button govuk-button--secondary sup_margin_0"
            data-module="govuk-button"
            onclick="closeModal()">
        Cancel
    </button>
    <button class="govuk-button sup_margin_0"
            data-module="govuk-button"
            type="button"
            onclick="saveMaintWGStaff()">
        @saveLabel
    </button>
</div>

<script>
    function toggleWgStaffNameDropdown() {
        var dropdown = document.getElementById('staff-name-dropdown');
        var input = document.getElementById('staff-name-input');
        var panel = document.getElementById('staff-name-panel');
        var search = document.getElementById('staff-name-search');
        if (!dropdown || !input || !panel || !search) return;

        var isHidden = panel.style.display === 'none' || panel.style.display === '';
        if (isHidden) {
            filterWgStaffNameTable(search.value);
            panel.style.display = 'block';
            panel.style.width = input.offsetWidth + 'px';
            input.setAttribute('aria-expanded', 'true');
            search.focus();
        } else {
            panel.style.display = 'none';
            input.setAttribute('aria-expanded', 'false');
        }
    }

    function selectWgStaffName(row) {
        var name = row.getAttribute('data-name') || '';
        var spNumber = row.getAttribute('data-spnumber') || '';

        var staffNameInput = document.getElementById('Name');
        var spNumberInput = document.getElementById('SpNumber');

        if (staffNameInput) {
            staffNameInput.value = name;
        }

        if (spNumberInput) {
            spNumberInput.value = spNumber;
        }

        var displayText = name + (spNumber ? ' - ' + spNumber : '');
        var display = document.getElementById('staff-name-input');
        if (display) {
            display.value = displayText;
        }

        if (staffNameInput) {
            staffNameInput.dispatchEvent(new Event('input', { bubbles: true }));
            staffNameInput.dispatchEvent(new Event('change', { bubbles: true }));

            var formGroup = staffNameInput.closest('.govuk-form-group');
            if (formGroup) {
                formGroup.classList.remove('govuk-form-group--error');
                var validationMessage = formGroup.querySelector('[data-valmsg-for="Name"]');
                if (validationMessage) {
                    validationMessage.textContent = '';
                    validationMessage.style.display = 'none';
                    validationMessage.classList.remove('field-validation-error');
                    validationMessage.classList.add('field-validation-valid');
                }
            }
        }

        var panelEl = document.getElementById('staff-name-panel');
        if (panelEl) panelEl.style.display = 'none';
        var displayEl = document.getElementById('staff-name-input');
        if (displayEl) displayEl.setAttribute('aria-expanded', 'false');
        document.getElementById('staff-name-search').value = '';
        var tableBody = document.getElementById('staffNameTableBody');
        if (tableBody) tableBody.replaceChildren();
    }

    var WG_STAFF_MAX_ROWS = 50;
    var wgStaffLookup = null;

    function getWgStaffLookup() {
        if (wgStaffLookup) return wgStaffLookup;
        var dataEl = document.getElementById('staff-lookup-data');
        try {
            wgStaffLookup = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
        } catch (e) {
            wgStaffLookup = [];
        }
        return wgStaffLookup;
    }

    // Builds only the rows that match the current search term, capped at
    // WG_STAFF_MAX_ROWS. The full lookup holds several thousand entries, so they
    // are never all placed in the DOM.
    function filterWgStaffNameTable(query) {
        var body = document.getElementById('staffNameTableBody');
        if (!body) return;

        var lower = (query || '').trim().toLowerCase();
        var items = getWgStaffLookup();
        var fragment = document.createDocumentFragment();
        var shown = 0;

        for (var i = 0; i < items.length && shown < WG_STAFF_MAX_ROWS; i++) {
            var item = items[i];
            var name = (item.name || '');
            var spNumber = (item.spNumber || '') + '';

            if (lower &&
                name.toLowerCase().indexOf(lower) === -1 &&
                spNumber.toLowerCase().indexOf(lower) === -1) {
                continue;
            }

            var row = document.createElement('tr');
            row.id = 'staffNameRow_' + item.pactId + '_' + spNumber;
            row.className = 'govuk-table__row staff-name-row';
            row.setAttribute('data-pactid', item.pactId == null ? '' : item.pactId);
            row.setAttribute('data-name', name);
            row.setAttribute('data-spnumber', spNumber);
            row.setAttribute('role', 'option');
            row.setAttribute('tabindex', '-1');
            row.style.cursor = 'pointer';
            row.onclick = function () { selectWgStaffName(this); };

            var nameCell = document.createElement('td');
            nameCell.className = 'govuk-table__cell';
            nameCell.style.overflow = 'hidden';
            nameCell.style.textOverflow = 'ellipsis';
            nameCell.textContent = name;

            var spCell = document.createElement('td');
            spCell.className = 'govuk-table__cell';
            spCell.style.whiteSpace = 'nowrap';
            spCell.style.overflow = 'hidden';
            spCell.style.textOverflow = 'ellipsis';
            spCell.textContent = spNumber;

            row.appendChild(nameCell);
            row.appendChild(spCell);
            fragment.appendChild(row);
            shown++;
        }

        body.replaceChildren(fragment);
    }

    function recalculateHrsAvail() {
        var hrsPaid = parseFloat(document.getElementById('HrsPaid')?.value || '0') || 0;
        var leave = parseFloat(document.getElementById('Leave')?.value || '0') || 0;
        var sickSpecial = parseFloat(document.getElementById('SickSpecial')?.value || '0') || 0;

        var hrsAvail = hrsPaid - leave - sickSpecial;
        var hrsAvailInput = document.getElementById('HrsAvail');
        if (hrsAvailInput) {
            hrsAvailInput.value = hrsAvail.toFixed(2);
        }
    }

    function closeWgStaffNameDropdown() {
        var panel = document.getElementById('staff-name-panel');
        // Writing style.display unconditionally mutates the style attribute even
        // when the value is unchanged. A global MutationObserver watches every
        // .dropdown-panel for style/class changes and measures visibility, which
        // forces a synchronous layout, so only touch the DOM when actually open.
        if (!panel || panel.style.display === 'none' || panel.style.display === '') {
            return;
        }

        panel.style.display = 'none';
        var displayEl = document.getElementById('staff-name-input');
        if (displayEl) displayEl.setAttribute('aria-expanded', 'false');
    }

    function onWgStaffDocumentClick(e) {
        var dropdown = document.getElementById('staff-name-dropdown');
        if (!dropdown) return;
        if (!dropdown.contains(e.target)) {
            closeWgStaffNameDropdown();
        }
    }

    (function initialiseWgStaffModalDropdowns() {
        var initialName = document.getElementById('Name')?.value || '';
        var initialSpNumber = document.getElementById('SpNumber')?.value || '';

        if (initialName) {
            var display = document.getElementById('staff-name-input');
            if (display) {
                display.value = initialName + (initialSpNumber ? ' - ' + initialSpNumber : '');
            }
        }

        ['HrsPaid', 'Leave', 'SickSpecial'].forEach(function (fieldId) {
            var input = document.getElementById(fieldId);
            if (input) {
                input.addEventListener('input', recalculateHrsAvail);
            }
        });

        // The partial is re-injected each time the modal opens and each injection
        // creates a brand new function object, so the previously registered
        // handler must be tracked on window to be removable.
        if (window.__wgStaffDocClickHandler) {
            document.removeEventListener('click', window.__wgStaffDocClickHandler);
        }
        window.__wgStaffDocClickHandler = onWgStaffDocumentClick;
        document.addEventListener('click', onWgStaffDocumentClick);

        var modalBody = document.getElementById('wgStaffModalBody');
        if (modalBody) {
            modalBody.addEventListener('scroll', function () {
                var panel = document.getElementById('staff-name-panel');
                if (panel && panel.style.display === 'block') {
                    closeWgStaffNameDropdown();
                }
            }, { passive: true });
        }
    })();
</script>