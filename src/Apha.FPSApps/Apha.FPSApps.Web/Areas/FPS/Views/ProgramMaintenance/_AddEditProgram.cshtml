@model Apha.FPSApps.Web.Areas.FPS.Models.ProgramViewModel
@{
    var isEditMode = !string.IsNullOrEmpty(Model.ProgramNo);
    var title      = isEditMode ? "Edit Program"    : "Add Program";
    var formId     = isEditMode ? "editProgramForm" : "addProgramForm";
    var saveLabel  = isEditMode ? "Update"          : "Save";
    var saveAction = isEditMode ? "updateProgram()" : "saveProgram()";
}

<div class="modal-header">
    <h5 class="modal-title" id="programModalTitle">@title</h5>
    <button type="button" class="btn-close btn-red" onclick="closeModal()" data-bs-dismiss="modal">X</button>
</div>
<div class="modal-body" style="overflow-y: auto; max-height: calc(80vh - 120px);">
    <div class="govuk-error-summary" role="alert"
         aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
            </ul>
        </div>
    </div>
    <div class="row g-3">
        <form id="@formId">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="ProgramNo">Program <span class="sup_color_red">*</span> </label>
                <input type="text" asp-for="ProgramNo" required class="govuk-input" readonly="@isEditMode">
                    <span asp-validation-for="ProgramNo" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="ProgramName">Program Name</label>
                <input type="text" asp-for="ProgramName" class="govuk-input">
                        <span asp-validation-for="ProgramName" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="Directorate">Directorate</label>
                        <select id="Directorate" asp-for="Directorate" asp-items="@Model.DirectorateOptions" class="govuk-select govuk-!-font-size-16 sup_width_100">
                </select>
                        <span asp-validation-for="Directorate" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="Target">Target</label> 
                 <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                            <input type="text" asp-for="Target" class="govuk-input" value="@Model.Target">
                         </div> 
                            <span asp-validation-for="Target" class="govuk-error-message" style="display:none;"></span>
            </div>
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="Manager">Manager</label>
                <div style="position: relative;">
                    <input type="text" id="ManagerDisplay" placeholder="Select Manager" autocomplete="off"
                           class="govuk-input govuk-!-font-size-16 down-arrow-img" style="width:100%; cursor:pointer;" readonly />
                    <div id="ManagerDropdownPanel" style="display:none; position:absolute; top:100%; left:0; width:100%;
                            max-height:260px; overflow-y:auto; background:#fff; border:1px solid #b1b4b6;
                            box-shadow:0 4px 8px rgba(0,0,0,.2); z-index:2000;">
                        <input type="text" id="ManagerSearchBox" placeholder="Type to search manager"
                               style="width:100%; padding:6px 8px; border:0; border-bottom:1px solid #b1b4b6; outline:none; box-sizing:border-box;" />
                        <table style="width:100%; border-collapse:collapse; font-size:14px;">
                            <thead style="background:#f3f2f1; position:sticky; top:0; z-index:10;">
                                <tr>
                                    <th style="padding:6px 8px; text-align:left;">Name</th>
                                    <th style="padding:6px 8px; text-align:left;">Work Group</th>
                                    <th style="padding:6px 8px; text-align:left;">Grade</th>
                                </tr>
                            </thead>
                            <tbody id="ManagerDropdownBody">
                                @foreach (var item in Model.ManagerList.Where(i => !string.IsNullOrEmpty(i.Value)))
                                {
                                    var parts = item.Text.Split('|');
                                    var mgrName  = parts[0].Trim();
                                    var mgrGroup = parts.Length > 1 ? parts[1].Trim() : string.Empty;
                                    var mgrGrade = parts.Length > 2 ? parts[2].Trim() : string.Empty;
                                    <tr data-value="@item.Value" data-display="@mgrName" style="cursor:pointer;">
                                        <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@mgrName</td>
                                        <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@mgrGroup</td>
                                        <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@mgrGrade</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <select asp-for="Manager" asp-items="@Model.ManagerList" class="govuk-select govuk-!-font-size-16 sup_width_100" style="display:none;">
                </select>
                            <span asp-validation-for="Manager" class="govuk-error-message" style="display:none;"></span>
            </div>
        </form>
    </div>
</div>
            <div class="modal-footer sup_flex_space_center">
    <button class="govuk-button govuk-button--secondary sup_margin_0" data-module="govuk-button" data-bs-dismiss="modal" onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" data-module="govuk-button" type="button" onclick="@saveAction">@saveLabel</button>
</div>

<script>
    (function () {
        var managerDisplay = document.getElementById('ManagerDisplay');
        var managerSelect  = document.getElementById('Manager');
        var managerPanel   = document.getElementById('ManagerDropdownPanel');
        var managerSearch  = document.getElementById('ManagerSearchBox');
        var managerBody    = document.getElementById('ManagerDropdownBody');

        if (managerDisplay && managerSelect && managerPanel && managerSearch && managerBody) {
            if (managerSelect.value) {
                var matchManagerRow = managerBody.querySelector('tr[data-value="' + managerSelect.value + '"]');
                managerDisplay.value = matchManagerRow ? matchManagerRow.getAttribute('data-display') : managerSelect.value;
            }
            managerDisplay.addEventListener('click', function (e) {
                e.stopPropagation();
                managerPanel.style.display = managerPanel.style.display === 'none' ? 'block' : 'none';
                if (managerPanel.style.display === 'block') { managerSearch.value = ''; filterManagerRows(); managerSearch.focus(); }
            });
            managerSearch.addEventListener('input', filterManagerRows);
            function filterManagerRows() {
                var q = managerSearch.value.toLowerCase();
                managerBody.querySelectorAll('tr').forEach(function (row) {
                    row.style.display = row.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
                });
            }
            managerBody.querySelectorAll('tr').forEach(function (row) {
                row.addEventListener('click', function () {
                    managerDisplay.value = this.getAttribute('data-display');
                    var val = this.getAttribute('data-value');
                    Array.from(managerSelect.options).forEach(function (o) { o.selected = o.value === val; });
                    managerSelect.dispatchEvent(new Event('change'));
                    managerPanel.style.display = 'none';
                });
                row.addEventListener('mouseenter', function () { this.style.backgroundColor = '#f3f2f1'; });
                row.addEventListener('mouseleave', function () { this.style.backgroundColor = ''; });
            });
            document.addEventListener('click', function (e) {
                if (!managerDisplay.contains(e.target) && !managerPanel.contains(e.target)) {
                    managerPanel.style.display = 'none';
                }
            });
        }
    })();
</script>
