@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProgrammeSelectViewModel
@{
    ViewData["Title"] = "Programme Management";
}

<main id="main-content">
    <div class="container-fluid">
        <div class="govuk-grid-row sup_border-bottom">
            <div class="govuk-grid-column-one-half">
                <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-3 govuk-!-margin-left-0 isCustomPageHeadings">
                    Programme Management
                </h1>
            </div>
            <div class="govuk-grid-column-one-third isFloatRight">
                <form id="programmeFilterForm" role="search" aria-label="Programme and project filters">
                <table class="govuk-table govuk-!-margin-bottom-2">
                    <tbody class="govuk-table__body">
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header govuk-!-padding-bottom-0 govuk-!-padding-right-0 isNoBottomBorder">
                                <label id="programmeDropdownLabel" class="govuk-label govuk-!-margin-bottom-0 govuk-!-padding-right-0 govuk-!-font-weight-bold isNoWrap" for="programmeDropdown">Select a Programme:</label>
                            </th>
                            <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-right-1 isNoBottomBorder">
                                <select id="programmeDropdown"
                                        asp-items="Model.ProgrammeList"
                                        asp-for="SelectedProgramNo"
                                        onchange="filterProgramme()"
                                        class="govuk-select"
                                        style="width:auto; min-width:160px;"
                                        aria-label="Select a Programme">
                                    <option value="">-- Select Programme --</option>
                                </select>
                            </td>

                            <th scope="row" class="govuk-table__header  govuk-!-padding-right-1 govuk-!-padding-bottom-0 isNoBottomBorder">
                                <label id="projectNameInputLabel" class="govuk-label govuk-!-margin-bottom-0 govuk-!-font-weight-bold isNoWrap" for="projectNameInput">Project:</label>
                            </th>
                            <td class="govuk-table__cell govuk-!-padding-bottom-0 isNoBottomBorder">
                                <input type="text" id="projectNameInput" placeholder="Select Project" autocomplete="off"
                                       class="govuk-input down-arrow-img isNoWrap"
                                       value="@Model.ProjectName" readonly />
                                <div id="ProjectDropdownPanel" style="display:none; position:absolute; top:100%; right: 26px; width:420px;
                                    max-height:260px; overflow-y:auto; background:#fff; border:1px solid #b1b4b6;
                                        box-shadow:0 4px 8px rgba(0,0,0,.2); z-index:2000; top: 168px; left: 76.7vw !important;">
                                    <label for="ProjectSearchBox" class="govuk-label govuk-visually-hidden">Search projects</label>
                                    <input type="text" id="ProjectSearchBox" placeholder="Type to search project" aria-label="Search projects"
                                           style="width:100%; padding:6px 8px; border:0; border-bottom:1px solid #b1b4b6; outline:none; box-sizing:border-box;" />
                                    <table style="width:100%; border-collapse:collapse; font-size:14px;">
                                        <thead style="background:#f3f2f1; position:sticky; top:0; z-index:10;">
                                            <tr>
                                                <th style="padding:6px 8px; text-align:left;">Project</th>
                                                <th style="padding:6px 8px; text-align:left;">Program</th>
                                            </tr>
                                        </thead>
                                        <tbody id="ProjectDropdownBody"></tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
                </form>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12 govuk-!-padding-0">
                <div class="col-lg-12">
                    <div class="main-content pmg-main-content govuk-!-margin-top-2 govuk-!-margin-left-2 govuk-!-margin-right-2">
                        <div id="@($"gridContainer_{Model.ProjectsGrid!.GridId}")">
                            @await Html.PartialAsync("_DataGrid", Model.ProjectsGrid)
                        </div>
                    </div>
                    </div>
                </div>
             </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/common/lazy-panel-dropdown.js" asp-append-version="true"></script>
    <style>
        /* Row hover, previously applied via per-row mouseenter/mouseleave handlers. */
        #ProjectDropdownBody tr[data-lazy-row]:hover {
            background-color: #f3f2f1;
        }
    </style>
    <script>
        var allProjectLookup = [];

        function filterProgramme() {
            var programNo = document.getElementById('programmeDropdown').value;
            // Clear the project field when programme changes
            var projectNameInput = document.getElementById('projectNameInput');
            if (projectNameInput) projectNameInput.value = '';
            if (programNo) {
                fpsNavigateTo('@Url.Action("Index", "ProgrammeSelect", new { area = "FPS" })?programNo=' + encodeURIComponent(programNo));
            } else {
                fetch('@Url.Action("SaveProgrammeSession", "ProgrammeSelect", new { area = "FPS" })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' },
                    body: JSON.stringify('')
                }).finally(function () {
                        var projectName = document.getElementById('projectNameInput')?.value ?? '';
                        // Navigate for both a selected programme and the empty "-- Select Programme --" option
                        // so the grid is refreshed and cleared when the selection is reset.
                        var url = '@Url.Action("Index", "ProgrammeSelect", new { area = "FPS" })?programNo=' + encodeURIComponent(programNo) + '&projectName=' + encodeURIComponent(projectName);
                        fpsNavigateTo(url);
                });
            }
        }

        function getProjectsExtraFilters() {
            return {
                projectName: document.getElementById('projectNameInput')?.value ?? ''
            };
        }

        var reloadDebounce;
        function reloadProjectsGrid() {
            clearTimeout(reloadDebounce);
            reloadDebounce = setTimeout(function () {
                if (window['gridManager_projectsGrid']) {
                    window['gridManager_projectsGrid'].reloadGrid({ page: 1 });
                }
            }, 300);
        }

        function planProject(btn) {
            var projectCode = $(btn).data('id');
            sessionStorage.setItem('fps_clearFiltersOnReturn', '1');
            fpsNavigateTo('@Url.Action("Index", "ProjectPlanning", new { area = "FPS" })' + '?projectCode=' + encodeURIComponent(projectCode));
        }

        function editProject(btn) {
            var parentProject = $(btn).data('id');
            var programNo = document.getElementById('programmeDropdown')?.value ?? '';
            var projectName = document.getElementById('projectNameInput')?.value ?? '';

            var returnUrl = '@Url.Action("Index", "ProgrammeSelect", new { area = "FPS" })'
                + '?programNo=' + encodeURIComponent(programNo)
                + '&projectName=' + encodeURIComponent(projectName);

            sessionStorage.setItem('fps_clearFiltersOnReturn', '1');
            fpsNavigateTo('@Url.Action("Edit", "Project", new { area = "FPS" })'
                + '?parentProject=' + encodeURIComponent(parentProject)
                + '&returnUrl=' + encodeURIComponent(returnUrl));
        }

        window.addEventListener('pageshow', function () {
            if (sessionStorage.getItem('fps_clearFiltersOnReturn') === '1') {
                sessionStorage.removeItem('fps_clearFiltersOnReturn');
                fpsNavigateTo('@Url.Action("Index", "ProgrammeSelect", new { area = "FPS" })');
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            function applyButtonTitles() {
                document.querySelectorAll('#gridContainer_projectsGrid .edit-row-btn:not([data-titled])').forEach(function (btn) {
                    btn.title = 'Edit';
                    var img = btn.querySelector('img');
                    if (img) img.title = 'Edit';
                    btn.setAttribute('data-titled', '1');
                });
                document.querySelectorAll('#gridContainer_projectsGrid .delete-row-btn[data-delete-function="planProject"]:not([data-titled])').forEach(function (btn) {
                    btn.title = 'Plan';
                    var img = btn.querySelector('img');
                    if (img) img.title = 'Plan';
                    btn.setAttribute('data-titled', '1');
                });
            }

            applyButtonTitles();

            // ── Project multi-column dropdown ──────────────────────────────────
            // Lazy/chunked rendering, debounced search and delegated row selection
            // are provided by common/lazy-panel-dropdown.js.
            var projectDisplay = document.getElementById('projectNameInput');
            var projectPanel   = document.getElementById('ProjectDropdownPanel');
            var projectSearch  = document.getElementById('ProjectSearchBox');
            var projectBody    = document.getElementById('ProjectDropdownBody');

            var projectDropdown = createLazyPanelDropdown({
                panelId: 'ProjectDropdownPanel',
                bodyId: 'ProjectDropdownBody',
                searchBoxId: 'ProjectSearchBox',
                displayId: 'projectNameInput',
                // All projects are searchable regardless of the selected programme.
                getOptions: function () { return allProjectLookup; },
                getSearchKey: function (p) { return p.parentProject + '\u0000' + (p.program || ''); },
                getRowAttributes: function (p) {
                    return { value: p.parentProject, program: p.program || '' };
                },
                getCells: function (p) { return [p.parentProject, p.program || '']; },
                onSelect: function (row) { selectProject(row.value, row.program); }
            });

            function selectProject(parentProject, program) {
                projectDisplay.value = parentProject;

                var programmeDropdown = document.getElementById('programmeDropdown');
                var currentProgramNo = programmeDropdown ? programmeDropdown.value : '';

                if (program && program !== currentProgramNo) {
                    // Project belongs to a different programme — switch programme and navigate
                    if (programmeDropdown) {
                        Array.from(programmeDropdown.options).forEach(function (o) {
                            o.selected = o.value === program;
                        });
                    }
                    fpsNavigateTo('@Url.Action("Index", "ProgrammeSelect", new { area = "FPS" })?programNo='
                        + encodeURIComponent(program)
                        + '&projectName=' + encodeURIComponent(parentProject));
                } else {
                    reloadProjectsGrid();
                }
            }

            if (projectDisplay && projectPanel && projectSearch && projectBody) {
                projectDisplay.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (projectPanel.style.display !== 'none') {
                        projectDropdown.close();
                        return;
                    }
                    if (allProjectLookup.length === 0) {
                        fetch('@Url.Action("GetProjectLookup", "ProgrammeSelect", new { area = "FPS" })')
                            .then(function (r) { return r.json(); })
                            .then(function (data) {
                                allProjectLookup = data;
                                projectDropdown.toggle();
                            });
                    } else {
                        projectDropdown.toggle();
                    }
                });

                projectSearch.addEventListener('input', function () {
                    projectDropdown.filter(this.value);
                });
            }

            var observer = new MutationObserver(function (mutations) {
                var hasNewNodes = mutations.some(function (m) {
                    return Array.from(m.addedNodes).some(function (n) { return n.nodeType === 1; });
                });
                if (hasNewNodes) applyButtonTitles();
            });

            var container = document.getElementById('gridContainer_projectsGrid');
            if (container) {
                observer.observe(container, { childList: true, subtree: true });
            }
        });
    </script>
}
