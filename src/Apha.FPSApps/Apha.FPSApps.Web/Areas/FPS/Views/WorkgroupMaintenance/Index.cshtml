@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.WorkgroupMaintenanceViewModel

@{
    // TRANSFORMENGINE: Title from HTML prototype <title>2025-2026 : WorkGroup Maintenance</title>
    ViewData["Title"] = "2025-2026 : WorkGroup Maintenance";
}

<main id="main-content">
    <div class="container-fluid">

        <!-- Title — matches frmMaintWorkGroup2 HTML prototype govuk-heading-s -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    WorkGroup Maintenance
                </h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">

                                    <!-- TRANSFORMENGINE: _MaintenanceSideNav partial — active token "WorkgroupMaintenance" -->
                                    @await Html.PartialAsync("_MaintenanceSideNav", "WorkgroupMaintenance")

                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">

                                        <!-- DataGrid section -->
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full mt-2">
                                                <!-- TRANSFORMENGINE: grid container ID = gridContainer_workgroupGrid
                                                     matching DataGridConfig.GridId = "workgroupGrid"
                                                     No page-level filter dropdowns — HTML prototype has no <select>
                                                     outside the modal; all selects are modal-only AJAX lookups -->
                                                <div id="@($"gridContainer_{Model.WorkgroupGrid.GridId}")">
                                                    @await Html.PartialAsync("_DataGrid", Model.WorkgroupGrid)
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>

        // TRANSFORMENGINE: reloadWorkgroupMaintenanceGrid — uses gm.reloadGrid({ page: 1 }) (NOT gm.reload())
        // GridId = "workgroupGrid" so window key is gridManager_workgroupGrid
        function reloadWorkgroupMaintenanceGrid() {
            var gm = window['gridManager_workgroupGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        // TRANSFORMENGINE: addWorkgroupMaintenance — AllowAdd:true from JS showAddButton:true
        // Loads _AddEditWorkgroup partial (empty WorkgroupMaintenanceItem) into shared modal host
        function addWorkgroupMaintenance() {
            $.get('/FPS/WorkgroupMaintenance/Create', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            }).fail(function () {
                showGovukAlert('An error occurred while loading the form');
            });
        }

        // TRANSFORMENGINE: editWorkgroupMaintenance — AllowEdit:true from JS openTblWGEditModal button
        // $(btn).data('id') reads data-id attribute emitted by _DataGrid EditFunction (WorkGroupName = KeyProperty)
        function editWorkgroupMaintenance(btn) {
            var id = $(btn).data('id');
            $.get('/FPS/WorkgroupMaintenance/Edit', { workGroupName: id }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            }).fail(function () {
                showGovukAlert('An error occurred while loading the edit form');
            });
        }

        // TRANSFORMENGINE: deleteWorkgroupMaintenance — AllowDelete:true from JS handleTblWGDelete button
        // JS prototype used window.confirm(); MVC equivalent uses showGovukConfirm (govuk-alert pattern)
        // KeyProperty = "WorkGroupName" so id is the workGroupName string value
        function deleteWorkgroupMaintenance(btn) {
            var id = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this record?').then(function (result) {
                if (!result) return;
                $.ajax({
                    url: '/FPS/WorkgroupMaintenance/Delete?workGroupName=' + encodeURIComponent(id),
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            showGovukAlert(response.message || 'WorkGroup deleted successfully').then(function () {
                                reloadWorkgroupMaintenanceGrid();
                            });
                        } else {
                            showGovukAlert('Error: ' + (response.message || 'Delete failed.'));
                        }
                    },
                    error: function () {
                        showGovukAlert('An error occurred while deleting.');
                    }
                });
            });
        }

        // TRANSFORMENGINE: saveWorkgroup — called from _AddEditWorkgroup.cshtml when isEditMode=false
        // Collects WorkGroupName, ProfitCentre, CostCentre, Owner, Description, CentralOverhead from modal inputs
        // CentralOverhead: strip £ prefix + non-numeric chars client-side before POST (matches JS parseWGOverheadAmount)
        function saveWorkgroup() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#addWorkgroupForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var dto = {
                WorkGroupName: $('#WorkGroupName').val(),
                ProfitCentre: $('#ProfitCentre').val() || null,
                CostCentre: parseDoubleOrNull($('#CostCentre').val()),
                Owner: $('#Owner').val() || null,
                Description: $('#Description').val() || null,
                CentralOverhead: parseDecimalOrNull($('#CentralOverhead').val())
            };

            $.ajax({
                url: '/FPS/WorkgroupMaintenance/Create',
                type: 'POST',
                data: JSON.stringify(dto),
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    if (data.success) {
                        showGovukAlert(data.message || 'WorkGroup created successfully.');
                        closeModal();
                        reloadWorkgroupMaintenanceGrid();
                    } else {
                        displayServerValidationErrors(data.errors, data.message, '#modaPopupBody');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showGovukAlert('An error occurred while saving.');
                    }
                }
            });
        }

        // TRANSFORMENGINE: updateWorkgroup — called from _AddEditWorkgroup.cshtml when isEditMode=true
        // WorkGroupName may be changed (rename); original name taken from hdnOriginalWorkGroupName hidden field
        // Edit POST route: /FPS/WorkgroupMaintenance/Edit?originalWorkGroupName={original}
        function updateWorkgroup() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#editWorkgroupForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var originalName = $('#hdnOriginalWorkGroupName').val();

            var dto = {
                WorkGroupName: $('#WorkGroupName').val(),
                ProfitCentre: $('#ProfitCentre').val() || null,
                CostCentre: parseDoubleOrNull($('#CostCentre').val()),
                Owner: $('#Owner').val() || null,
                Description: $('#Description').val() || null,
                CentralOverhead: parseDecimalOrNull($('#CentralOverhead').val())
            };

            $.ajax({
                url: '/FPS/WorkgroupMaintenance/Edit?originalWorkGroupName=' + encodeURIComponent(originalName),
                type: 'POST',
                data: JSON.stringify(dto),
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    if (data.success) {
                        showGovukAlert(data.message || 'WorkGroup updated successfully.');
                        closeModal();
                        reloadWorkgroupMaintenanceGrid();
                    } else {
                        displayServerValidationErrors(data.errors, data.message, '#modaPopupBody');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showGovukAlert('An error occurred while saving.');
                    }
                }
            });
        }

        function closeModal() {
            $('#modaPopupBody').html('');
            $('#modalPopup').removeClass('show');
        }

        // TRANSFORMENGINE: parseDecimalOrNull — strip £ prefix and non-numeric chars before parsing
        // Matches JS parseWGOverheadAmount() behaviour for CentralOverhead field
        function parseDecimalOrNull(val) {
            if (val === null || val === undefined || val.toString().trim() === '') return null;
            var cleaned = val.toString().replace(/[^0-9.-]/g, '');
            var parsed = parseFloat(cleaned);
            return isNaN(parsed) ? null : parsed;
        }

        // TRANSFORMENGINE: parseDoubleOrNull — numeric parsing helper for CostCentre (double?)
        function parseDoubleOrNull(val) {
            if (val === null || val === undefined || val.toString().trim() === '') return null;
            var parsed = parseFloat(val);
            return isNaN(parsed) ? null : parsed;
        }

    </script>
}
