@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ResourceSetUpViewModel

@{
    ViewData["Title"] = "Resource Set-Up";
}

<style type="text/css">
    #gridContainer_rcGradeGrid .grid-scroll-container {
        height: 260px;
        max-height: 260px;
    }
    #gridContainer_wgGradeGrid .grid-scroll-container {
        height: 220px;
        max-height: 220px;
    }
    #gridContainer_wgStaffGrid .grid-scroll-container {
        height: 240px;
        max-height: 240px;
    }
    #gridContainer_wgGradeGrid table thead th,
    #gridContainer_wgGradeGrid table tbody td { text-align: left !important; }
</style>

<main id="main-content">
    <div class="container-fluid">
        <!-- Breadcrumb -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="row fps-sr-breadcrumb-row align-items-center">
                        <div class="col-md-6">
                            <nav class="govuk-breadcrumbs govuk-!-padding-left-3" aria-label="Breadcrumb">
                                <ol class="govuk-breadcrumbs__list">
                                    <li class="govuk-breadcrumbs__list-item">
                                        <a class="govuk-breadcrumbs__link" href="@Url.Action("Index", "Home", new { area = "FPS" })">Home</a>
                                    </li>
                                    <li class="govuk-breadcrumbs__list-item">Resource Management</li>
                                    <li class="govuk-breadcrumbs__list-item" aria-current="page">Setup Resource</li>
                                </ol>
                            </nav>
                        </div>
                        <div style="display: flex; justify-content: flex-end;" class="col-md-6">
                            <form asp-action="Index" asp-controller="ResourceSetUp" asp-area="FPS" method="get" style="display: flex; align-items: center;">
                                <label class="fw-bold mt-2" for="profitCentreSelect">Resource Centre:</label>
                                <select id="profitCentreSelect"
                                        name="profitCentre"
                                        asp-items="Model.ProfitCentreList"
                                        class="govuk-select govuk-!-font-size-16"
                                        style="width: auto; min-width: 260px;"
                                        onchange="this.form.submit()">
                                    <option value="">-- Select Resource Centre --</option>
                                </select>
                            </form>
                        </div>
                    </div>
            </div>
        </div>

        <!-- Page Title -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    Resource Set-Up <a href="#" id="fpsSrRcTitle" class="govuk-link">@Model.ProfitCentre</a>
                </h1>
            </div>
        </div>

        <!-- Three-grid layout -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="data-table-container sup_border govuk-!-margin-left-2 govuk-!-padding-3">

                    <!-- Top row: RC Grades (55%) + WG Grades (45%) -->
                    <div class="row govuk-!-margin-bottom-4">
                        <!-- RC Grades Available -->
                        <div class="col-7" style="border-right: 1px solid #b1b4b6;">
                            <div id="gridContainer_@Model.RcGradeGrid.GridId">
                                @await Html.PartialAsync("_DataGrid", Model.RcGradeGrid)
                            </div>
                        </div>

                        <!-- WG Grades Available within -->
                        <div class="col-5">
                            <h3 class="govuk-heading-s govuk-!-margin-bottom-2">WG Grades Available within</h3>
                            <input id="fpsSrRcFilter"
                                   class="govuk-input govuk-!-margin-bottom-2"
                                   style="width: 100%;"
                                   aria-label="Selected RC grade" readonly
                                   value="" />
                            <div id="gridContainer_@Model.WgGradeGrid.GridId">
                                @await Html.PartialAsync("_DataGrid", Model.WgGradeGrid)
                            </div>
                        </div>
                    </div>

                    <!-- Bottom row: Staff grid + Person Selected panel -->
                    <div class="d-flex align-items-center gap-3 govuk-!-margin-bottom-2">
                        <h3 class="govuk-heading-s govuk-!-margin-bottom-0" style="white-space: nowrap;">Staff of WG Grade</h3>
                        <input id="fpsSrSelectedWg"
                               class="govuk-input"
                               style="width: auto; min-width: 120px;"
                               aria-label="Selected WG grade" readonly value="" />
                    </div>
                    <div class="row align-items-start">
                        <!-- Staff of WG Grade -->
                        <div class="col-10">
                            <!-- WG Staff grid -->
                            <div id="gridContainer_@Model.WgStaffGrid.GridId">
                                @await Html.PartialAsync("_DataGrid", Model.WgStaffGrid)
                            </div>

                            <!-- Footer totals row -->
                            <table class="govuk-table govuk-!-margin-top-0 govuk-!-margin-bottom-0" style="table-layout: fixed;">
                                <tfoot class="govuk-table__foot">
                                    <tr class="govuk-table__row">
                                        <td class="govuk-table__cell" colspan="2"><strong>Totals</strong></td>
                                        <td class="govuk-table__cell govuk-table__cell--numeric" id="fpsSrTotalHrsPaid">@Model.WgHrsPaid</td>
                                        <td class="govuk-table__cell govuk-table__cell--numeric" id="fpsSrTotalLeave">@Model.WgLeave</td>
                                        <td class="govuk-table__cell govuk-table__cell--numeric" id="fpsSrTotalSick">@Model.WgSickSpecial</td>
                                        <td class="govuk-table__cell govuk-table__cell--numeric" id="fpsSrTotalAtWork">@Model.WgHrsAvail</td>
                                        <td class="govuk-table__cell"></td>
                                        <td class="govuk-table__cell"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Person Selected panel -->
                        <div class="col-2">
                            <aside class="govuk-!-padding-3"
                                   style="background-color: #d4e8f5; border: 1px solid #b1b4b6;"
                                   aria-label="Person selected panel">
                                <h2 class="govuk-heading-s govuk-!-margin-bottom-2">Person Selected</h2>
                                <input type="text" id="fpsSrPersonName"
                                       class="govuk-input govuk-!-margin-bottom-3"
                                       style="width: 100%;"
                                       readonly
                                       value="@Model.SelectedPersonName" />
                                <input type="hidden" id="fpsSrSelectedPactId" value="@Model.SelectedPactId" />
                                <button type="button" id="fpsSrPlanBtn"
                                        class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0"
                                        style="width: 100%;"
                                        data-module="govuk-button"
                                        onclick="planPersonOntoZTCodes()">
                                    Plan Person onto ZT Codes
                                </button>
                            </aside>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</main>

<!-- Edit WG Staff Modal -->
<div class="modal" id="modalPopup" tabindex="-1" aria-labelledby="wgStaffModalLabel">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="modaPopupBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        var rcGradeGridId   = '@Model.RcGradeGrid.GridId';
        var wgGradeGridId   = '@Model.WgGradeGrid.GridId';
        var wgStaffGridId   = '@Model.WgStaffGrid.GridId';
        var currentProfitCentre = '@Model.ProfitCentre';
        var currentPcGrade  = '';
        var currentWgGrade  = '';

        function getRcGradeGridManager()  { return window['gridManager_' + rcGradeGridId]; }
        function getWgGradeGridManager()  { return window['gridManager_' + wgGradeGridId]; }
        function getWgStaffGridManager()  { return window['gridManager_' + wgStaffGridId]; }

        // Extra filter callbacks required by DataGrid
        function getRcGradeExtraFilters() { return { profitCentre: currentProfitCentre }; }
        function getWgGradeExtraFilters() { return { pcGrade: currentPcGrade }; }
        function getWgStaffExtraFilters() { return { wgGrade: currentWgGrade }; }

        // Pre-select the dropdown to match the value returned from the controller
        document.getElementById('profitCentreSelect').value = '@Model.ProfitCentre';

        // On initial page load auto-select first RC grade row if grid already has data
        $(function () {
            if (currentProfitCentre) {
                selectFirstRow(rcGradeGridId, function (row) {
                    var pcGrade = row.data('id');
                    onRcGradeRowClick(pcGrade);
                });
            }
        });

        // Resource Centre dropdown change — handled by form GET submit (onchange="this.form.submit()").
        // RC grade row click — cascade to WG grades grid via AJAX reloadGrid
        // WG grade row click — cascade to WG staff grid via AJAX reloadGrid

        // Auto-select first row helper
        function selectFirstRow(gridId, onRowSelected) {
            var firstRow = $('#gridContainer_' + gridId + ' table tbody tr:first');
            if (firstRow.length && firstRow.data('id')) {
                firstRow.closest('table').find('tbody tr').removeClass('selected-row');
                firstRow.addClass('selected-row');
                onRowSelected(firstRow);
            }
        }

        // After RC Grade grid reloads — auto-select first row and cascade to WG grades
        document.addEventListener('gridReloaded', function (e) {
            if (e.detail.gridId === rcGradeGridId) {
                selectFirstRow(rcGradeGridId, function (row) {
                    var pcGrade = row.data('id');
                    onRcGradeRowClick(pcGrade);
                });
            }

            if (e.detail.gridId === wgGradeGridId) {
                selectFirstRow(wgGradeGridId, function (row) {
                    var wgGrade = row.data('id');
                    onWgGradeRowClick(wgGrade);
                });
            }

            if (e.detail.gridId === wgStaffGridId) {
                selectFirstRow(wgStaffGridId, function (row) {
                    var pactId = row.data('id');
                    var name   = row.find('td').eq(1).text().trim();
                    onWgStaffRowClick(pactId, name);
                });
            }
        });

        // Wire RC Grade row click — delegated so it survives grid reloads
        $(document).on('click', '#gridContainer_' + rcGradeGridId + ' table tbody tr', function () {
            var pcGrade = $(this).data('id');
            if (pcGrade) {
                $(this).closest('table').find('tbody tr').removeClass('selected-row');
                $(this).addClass('selected-row');
                onRcGradeRowClick(pcGrade);
            }
        });

        // Wire WG Grade row click — delegated so it survives grid reloads
        $(document).on('click', '#gridContainer_' + wgGradeGridId + ' table tbody tr', function () {
            var wgGrade = $(this).data('id');
            if (wgGrade) {
                $(this).closest('table').find('tbody tr').removeClass('selected-row');
                $(this).addClass('selected-row');
                onWgGradeRowClick(wgGrade);
            }
        });

        // Wire WG Staff row click — delegated so it survives grid reloads
        $(document).on('click', '#gridContainer_' + wgStaffGridId + ' table tbody tr', function () {
            var pactId = $(this).data('id');
            var name   = $(this).find('td').eq(1).text().trim();
            if (pactId) {
                $(this).closest('table').find('tbody tr').removeClass('selected-row');
                $(this).addClass('selected-row');
                onWgStaffRowClick(pactId, name);
            }
        });

        // Called when user clicks an RC grade row
        function onRcGradeRowClick(pcGrade) {
            currentPcGrade = pcGrade;
            document.getElementById('fpsSrRcFilter').value = pcGrade;
            currentWgGrade = '';
            document.getElementById('fpsSrSelectedWg').value = '';

            var mgr = getWgGradeGridManager();
            if (mgr) {
                mgr.reloadGrid({ page: 1 });
            }
        }

        // Called when user clicks a WG grade row — cascade to WG staff grid
        function onWgGradeRowClick(wgGrade) {
            currentWgGrade = wgGrade;
            document.getElementById('fpsSrSelectedWg').value = wgGrade;

            var mgr = getWgStaffGridManager();
            if (mgr) {
                mgr.reloadGrid({ page: 1 });
            }
        }

        // Called when user clicks a WG staff row — populate Person Selected panel
        function onWgStaffRowClick(pactId, name) {
            document.getElementById('fpsSrPersonName').value = name;
            document.getElementById('fpsSrSelectedPactId').value = pactId;
        }

        // Edit WG Staff
        function editWgStaff(btn) {
            var pactId = $(btn).data('id');
            $.get('/FPS/ResourceSetUp/EditWgStaff', { pactId: pactId }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
                $.validator.unobtrusive.parse($('#wgStaffForm'));
            });
        }

       

        // Plan Person onto ZT Codes — navigates to ZTstaffMain for the selected person (Button46_Click)
        function planPersonOntoZTCodes() {
            var pactId = document.getElementById('fpsSrSelectedPactId').value;
            if (!pactId) {
                showGovukAlert('Please select a person first.');
                return;
            }
            window.location.href = '/FPS/ZTstaffMain/Index?staffId=' + encodeURIComponent(pactId);
        }

        // Save (Update) WG Staff from modal
        function saveWgStaffPlan() {
            var form = $('#wgStaffForm');
            if (!isFormValid(form)) {
                displayClientValidationErrors(form);
                return;
            }

            var formData = {
                pactId:        $('#wgStaffForm #PactId').val(),
                spNumber:      $('#wgStaffForm #SpNumber').val(),
                name:          '',
                hrsPaid:       parseFloat($('#wgStaffForm #HrsPaid').val()) || 0,
                leave:         parseFloat($('#wgStaffForm #Leave').val()) || 0,
                sickSpecial:   parseFloat($('#wgStaffForm #SickSpecial').val()) || 0,
                hrsAvail:      parseFloat($('#wgStaffForm #HrsAvail').val()) || 0,
                makeAvailable: $('#wgStaffForm #MakeAvailable').is(':checked'),
                personStatus:  $('#wgStaffForm #PersonStatus').val(),
                personClass:   $('#wgStaffForm #PersonClass').val()
            };

            $.ajax({
                url: '/FPS/ResourceSetUp/UpdateWgStaff',
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (response) {
                    if (response.success) {
                        closeModal();
                        showGovukAlert('Staff record updated successfully.').then(function () {
                            getWgStaffGridManager().reloadGrid({ page: 1 });
                            updateStaffTotals();
                        });
                    } else {
                        displayServerValidationErrors(response.errors, 'Please correct the errors below.', '#wgStaffForm');
                    }
                },
                error: function (xhr) {
                    showGovukAlert('An unexpected error occurred. Please try again.');
                }
            });
        }

        function closeModal() {
            $('#modalPopup').removeClass('show');
            $('#modaPopupBody').html('');
        }

        // Recompute footer totals from currently loaded grid rows
        function updateStaffTotals() {
            var totalHrsPaid   = 0;
            var totalLeave     = 0;
            var totalSick      = 0;
            var totalAtWork    = 0;
            // DataGrid renders rows — sum visible numeric cells by column index
            $('#gridContainer_wgStaffGrid tbody tr').each(function () {
                var cells = $(this).find('td');
                totalHrsPaid += parseFloat($(cells[2]).text()) || 0;
                totalLeave   += parseFloat($(cells[3]).text()) || 0;
                totalSick    += parseFloat($(cells[4]).text()) || 0;
                totalAtWork  += parseFloat($(cells[5]).text()) || 0;
            });
            $('#fpsSrTotalHrsPaid').text(totalHrsPaid.toFixed(2));
            $('#fpsSrTotalLeave').text(totalLeave.toFixed(2));
            $('#fpsSrTotalSick').text(totalSick.toFixed(2));
            $('#fpsSrTotalAtWork').text(totalAtWork.toFixed(2));
        }
    </script>
}
