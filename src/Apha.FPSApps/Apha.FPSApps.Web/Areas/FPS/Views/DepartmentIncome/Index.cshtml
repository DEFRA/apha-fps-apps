@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.DepartmentIncomeViewModel

@{
    ViewData["Title"] = "Department Income";
}

@section Styles {
    <!-- TRANSFORMENGINE: GOV.UK tabs present — include tab CSS conditionally in this view only, not in _Layout.cshtml -->
    <link rel="stylesheet" href="~/css/common/_govuk_tabs.css" />
    <link rel="stylesheet" href="~/css/common/_govuk_modal.css" />
}

<main id="main-content">
    <div class="content-wrapper">

        <!-- ── Page heading ──────────────────────────────────────────────── -->
        <div class="govuk-grid-row sup_margin_left_right_0">
            <div class="govuk-grid-column-full sup_margin_bottom_10">
                <h1 class="heading_with_txtbox govuk-heading-s sup_border-bottom sup_margin_0 sup_padding_top_10 sup_padding_bottom_10">
                    Department Income
                </h1>
            </div>
        </div>

        <!-- ── Page-level filter controls ────────────────────────────────── -->
        <!-- TRANSFORMENGINE: Explicit <select> elements for projectSelect and period controls exist in HTML prototype
             outside the grid containers — include as page-level filters per Phase 12 rule -->
        <div class="govuk-grid-row sup_margin_left_right_0">

            <!-- Project dropdown -->
            <div class="govuk-grid-column-one-third">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold" for="projectSelect">Project</label>
                    <select id="projectSelect"
                            asp-for="SelectedProject"
                            asp-items="Model.ProjectList"
                            class="govuk-select sup_select_option_width_100 govuk-!-font-size-16"
                            aria-label="Select a project">
                        <option value="">Select project</option>
                    </select>
                </div>
            </div>

            <!-- Period from / Period to (custom table-dropdown controls) -->
            <div class="govuk-grid-column-two-thirds">
                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold" for="monthFromSelect">Period from</label>
                        <!-- TRANSFORMENGINE: Backing hidden select — JS reads this value for monthFrom filter -->
                        <select id="monthFromSelect"
                                asp-for="SelectedMonthFrom"
                                class="govuk-select sup_select_option_width_100 govuk-!-font-size-16 govuk-visually-hidden"
                                aria-hidden="true" tabindex="-1">
                            <option value="">From</option>
                            @foreach (var period in Model.PeriodList)
                            {
                                if (Model.SelectedMonthFrom.HasValue && Model.SelectedMonthFrom == period.AccntsPeriod)
                                {
                                    <option value="@period.AccntsPeriod" selected>@period.AccntsPeriod @period.MonthName</option>
                                }
                                else
                                {
                                    <option value="@period.AccntsPeriod">@period.AccntsPeriod @period.MonthName</option>
                                }
                            }
                        </select>
                        <!-- TRANSFORMENGINE: Custom period-table-dropdown — rendered by JS initPeriodDropdownTables() -->
                        <div class="period-table-dropdown" id="periodFromDropdown">
                            <label for="periodFromInput" class="govuk-visually-hidden">Period from date selection</label>
                            <input type="text" id="periodFromInput" value="--select--"
                                   class="govuk-input govuk-!-font-size-16 dropdown-input" readonly>
                            <div class="dropdown-panel" id="periodFromPanel" style="display:none;">
                                <label for="periodFromSearch" class="govuk-visually-hidden">Search period from</label>
                                <input type="text" class="search-box" id="periodFromSearch"
                                       placeholder="Type to search and select period">
                                <table class="period-table-dropdown__table">
                                    <thead>
                                        <tr>
                                            <th scope="col">AccntsPeriod</th>
                                            <th scope="col">MonthName</th>
                                            <th scope="col">MonthNumber</th>
                                        </tr>
                                    </thead>
                                    <tbody id="periodFromBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="govuk-grid-column-one-half">
                    <div class="govuk-form-group sup_margin_bottom_10">
                        <label class="govuk-label govuk-!-font-weight-bold" for="monthToSelect">Period to</label>
                        <!-- TRANSFORMENGINE: Backing hidden select — JS reads this value for monthTo filter -->
                        <select id="monthToSelect"
                                asp-for="SelectedMonthTo"
                                class="govuk-select sup_select_option_width_100 govuk-!-font-size-16 govuk-visually-hidden"
                                aria-hidden="true" tabindex="-1">
                            <option value="">To</option>
                            @foreach (var period in Model.PeriodList)
                            {
                                if (Model.SelectedMonthTo.HasValue && Model.SelectedMonthTo == period.AccntsPeriod)
                                {
                                    <option value="@period.AccntsPeriod" selected>@period.AccntsPeriod @period.MonthName</option>
                                }
                                else
                                {
                                    <option value="@period.AccntsPeriod">@period.AccntsPeriod @period.MonthName</option>
                                }
                            }
                        </select>
                        <!-- TRANSFORMENGINE: Custom period-table-dropdown — rendered by JS initPeriodDropdownTables() -->
                        <div class="period-table-dropdown" id="periodToDropdown">
                            <label for="periodToInput" class="govuk-visually-hidden">Period to date selection</label>
                            <input type="text" id="periodToInput" value="--select--"
                                   class="govuk-input govuk-!-font-size-16 dropdown-input" readonly>
                            <div class="dropdown-panel" id="periodToPanel" style="display:none;">
                                <label for="periodToSearch" class="govuk-visually-hidden">Search period to</label>
                                <input type="text" class="search-box" id="periodToSearch"
                                       placeholder="Type to search and select period">
                                <table class="period-table-dropdown__table">
                                    <thead>
                                        <tr>
                                            <th scope="col">AccntsPeriod</th>
                                            <th scope="col">MonthName</th>
                                            <th scope="col">MonthNumber</th>
                                        </tr>
                                    </thead>
                                    <tbody id="periodToBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── GOV.UK tabs: Snapshot data / Current data ─────────────────── -->
        <!-- TRANSFORMENGINE: GOV.UK tabs structure mirrored from HTML prototype — tab switching handled
             by _govuk_tabs.js (included in @@section Scripts); do NOT inline tab-switching logic here -->
        <div class="govuk-grid-row sup_margin_left_right_0">
            <div class="govuk-grid-column-full sup_p_0">
                <div class="govuk-tabs" id="department-income-tabs" data-module="govuk-tabs">
                    <ul class="govuk-tabs__list">
                        <li class="govuk-tabs__list-item govuk-tabs__list-item--selected">
                            <a class="govuk-tabs__tab" href="#department-income-snapshot">
                                Snapshot data
                            </a>
                        </li>
                        <li class="govuk-tabs__list-item">
                            <a class="govuk-tabs__tab" href="#department-income-current">
                                Current data (old style)
                            </a>
                        </li>
                    </ul>

                    <!-- ── Snapshot data tab panel ───────────────────────── -->
                    <div class="govuk-tabs__panel govuk-!-padding-2" id="department-income-snapshot">
                        <div class="govuk-grid-row">

                            <!-- Query listbox + Run query button (left 1/4) -->
                            <div class="govuk-grid-column-one-quarter">
                                <div class="govuk-form-group sup_margin_bottom_10">
                                    <label class="govuk-label govuk-!-font-weight-bold" for="snapshotQuerySelect">
                                        Query
                                    </label>
                                    <!-- TRANSFORMENGINE: multi-select listbox — populated by JS initPageState() from
                                         DepartmentIncomeViewModel.SnapshotGrid; options match snapshotQueries list -->
                                    <select id="snapshotQuerySelect"
                                            class="sup_select_option_width_100 govuk-!-font-size-16"
                                            size="10" multiple
                                            aria-label="Snapshot query list">
                                        <option value="time">Time</option>
                                        <option value="tests">Tests</option>
                                        <option value="animals">Animals</option>
                                        <option value="exceptional">Exceptional</option>
                                        <option value="totals">Totals</option>
                                    </select>
                                    <div class="govuk-grid-column-one-sixth">
                                        <div class="govuk-form-group sup_margin_bottom_10">
                                            <label class="govuk-label govuk-visually-hidden" for="runQueryBtnSnapshot">Run query</label>
                                            <button type="button" id="runQueryBtnSnapshot"
                                                    class="govuk-button govuk-!-margin-top-7 sup_p_8"
                                                    data-module="govuk-button">
                                                Run query
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Snapshot DataGrid (right 3/4) -->
                            <!-- TRANSFORMENGINE: Snapshot DataGrid — binds to LoadSnapshotGrid POST endpoint;
                                 showAddButton:false, AllowEdit:false, AllowDelete:false in controller config -->
                            <div class="govuk-grid-column-three-quarters">
                                <div id="gridContainer_@(Model.SnapshotGrid.GridId)" role="region" aria-label="Snapshot query results">
                                    @await Html.PartialAsync("_DataGrid", Model.SnapshotGrid)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Current data tab panel ────────────────────────── -->
                    <div class="govuk-tabs__panel govuk-tabs__panel--hidden govuk-!-padding-2" id="department-income-current">
                        <div class="govuk-grid-row">

                            <!-- Query listbox + Run query button (left 1/4) -->
                            <div class="govuk-grid-column-one-quarter">
                                <div class="govuk-form-group sup_margin_bottom_10">
                                    <label class="govuk-label govuk-!-font-weight-bold" for="querySelect">Query</label>
                                    <!-- TRANSFORMENGINE: single-select listbox — JS reads selectedIndex on Run query click -->
                                    <select id="querySelect"
                                            class="sup_select_option_width_100 govuk-!-font-size-16"
                                            size="10" aria-label="Department income query list">
                                        <option value="qryDeptIncomeTime">qryDeptIncomeTime</option>
                                        <option value="qryDeptIncomeTest">qryDeptIncomeTest</option>
                                        <option value="qryDeptIncomeAnimal">qryDeptIncomeAnimal</option>
                                        <option value="qryDeptIncomeAdditional">qryDeptIncomeAdditional</option>
                                        <option value="qryDeptIncomeTotals">qryDeptIncomeTotals</option>
                                    </select>
                                    <label class="govuk-label govuk-visually-hidden" for="runQueryBtnCurrent">Run query</label>
                                    <button type="button" id="runQueryBtnCurrent"
                                            class="govuk-button govuk-!-margin-top-7 sup_p_8"
                                            data-module="govuk-button">
                                        Run query
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div><!-- /.content-wrapper -->
</main>

<!-- ── Department Income query results modal ────────────────────────────── -->
<!-- TRANSFORMENGINE: Custom query results modal (departmentIncomeQueryModal) is separate from the
     shared #modalPopup in _Layout.cshtml. This modal holds the DataGridComponent query results grid.
     HTML prototype uses a GOV.UK modal class (.govuk-modal) — CSS from ~/css/common/_govuk_modal.css -->
<div class="govuk-modal" id="departmentIncomeQueryModal" aria-hidden="true">
    <div class="govuk-modal__dialog department-income-query-modal-dialog"
         role="dialog" aria-modal="true" aria-labelledby="departmentIncomeQueryModalTitle">
        <div class="govuk-modal__header">
            <h2 class="govuk-heading-m govuk-!-margin-bottom-0" id="departmentIncomeQueryModalTitle">
                Department income query results
            </h2>
            <button type="button" class="govuk-modal__close" id="departmentIncomeQueryModalCloseBtn"
                    aria-label="Close query results">&times;</button>
        </div>
        <div class="govuk-modal__body">
            <!-- TRANSFORMENGINE: Client-side DataGridComponent renders query rows here (not _DataGrid partial);
                 populated by ensureQueryGrid() / queryGrid.updateData() in JS below -->
            <div id="gridContainer_departmentIncomeQuery" role="region" aria-label="Department income snapshot query results"></div>
        </div>
    </div>
</div>

<!-- ── Popup overlay (showPopupMessage / closePopupMessage) ─────────────── -->
<!-- TRANSFORMENGINE: Preserved from HTML prototype — used by showPopupMessage for non-modal notifications -->
<div id="govuk-popup-overlay">
    <div id="govuk-popup"></div>
</div>

@section Scripts {
    <!-- TRANSFORMENGINE: GOV.UK tabs present — include tab JS conditionally; _govuk_tabs.js handles all
         tab-switching and panel activation; do NOT duplicate tab-wiring logic inline -->
    <script src="~/js/common/_govuk_tabs.js"></script>
    <!-- TRANSFORMENGINE TODO: Confirm DataGridComponent bundle path — used for query results modal grid -->
    <script src="~/js/common/datagrid.component.js"></script>

    <script>
        // ── Snapshot DataGrid extra-filter callback ──────────────────────────
        //   ExtraFilterMethod = "getDepartmentIncomeSnapshotExtraFilters"
        // Called automatically by _DataGrid on every reload; passes project + period params
        function getDepartmentIncomeSnapshotExtraFilters() {
            return {
                project: document.getElementById('projectSelect')?.value || '',
                monthFrom: document.getElementById('monthFromSelect')?.value || '',
                monthTo: document.getElementById('monthToSelect')?.value || ''
            };
        }

        // ── Snapshot grid reload helper ──────────────────────────────────────
        function reloadDepartmentIncomeSnapshotGrid() {
            var gm = window['gridManager_departmentIncomeSnapshotGrid'];
            if (gm) { gm.reloadGrid({ page: 1 }); }
        }

        // ────────────────────────────────────────────────────────────────────
        // Period-table-dropdown state and helpers
        // ────────────────────────────────────────────────────────────────────
        var departmentIncomePagePeriods = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                Model.PeriodList.Select(p => new {
                    value    = p.AccntsPeriod,
                    label    = p.AccntsPeriod.ToString() + " " + p.MonthName,
                    monthNum = p.MonthNumber
                })
            )
        );

        function getDeptIncomeMonthDisplayName(label) {
            return String(label || '').replace(/^\d+\s+/, '');
        }

        function closeDeptIncomeAllPeriodPanels() {
            document.querySelectorAll('.period-table-dropdown .dropdown-panel').forEach(function (panel) {
                panel.style.display = 'none';
            });
        }

        function initDeptIncomeSinglePeriodDropdown(config) {
            var dropdown = document.getElementById(config.dropdownId);
            var input    = document.getElementById(config.inputId);
            var panel    = document.getElementById(config.panelId);
            var search   = document.getElementById(config.searchId);
            var tbody    = document.getElementById(config.bodyId);
            var backing  = document.getElementById(config.selectId);

            if (!dropdown || !input || !panel || !search || !tbody || !backing) { return; }

            function renderRows(filterTerm) {
                var term = String(filterTerm || '').toLowerCase();
                tbody.innerHTML = '';

                departmentIncomePagePeriods
                    .filter(function (p) {
                        var periodText = String(p.value);
                        var monthName  = getDeptIncomeMonthDisplayName(p.label);
                        var monthNum   = String(p.monthNum);
                        return periodText.indexOf(term) !== -1 ||
                               monthName.toLowerCase().indexOf(term) !== -1 ||
                               monthNum.indexOf(term) !== -1;
                    })
                    .forEach(function (p) {
                        var tr          = document.createElement('tr');
                        var tdPeriod    = document.createElement('td');
                        var tdMonthName = document.createElement('td');
                        var tdMonthNum  = document.createElement('td');

                        tdPeriod.textContent    = String(p.value);
                        tdMonthName.textContent = getDeptIncomeMonthDisplayName(p.label);
                        tdMonthNum.textContent  = String(p.monthNum);

                        tr.appendChild(tdPeriod);
                        tr.appendChild(tdMonthName);
                        tr.appendChild(tdMonthNum);

                        tr.addEventListener('click', function () {
                            backing.value = String(p.value);
                            input.value   = getDeptIncomeMonthDisplayName(p.label);
                            panel.style.display = 'none';
                            backing.dispatchEvent(new Event('change', { bubbles: true }));
                        });

                        tbody.appendChild(tr);
                    });
            }

            function syncInputFromSelect() {
                var selected = backing.options[backing.selectedIndex];
                if (selected && selected.value) {
                    input.value = getDeptIncomeMonthDisplayName(selected.textContent);
                } else {
                    input.value = '--select--';
                }
            }

            input.addEventListener('click', function (evt) {
                evt.stopPropagation();
                closeDeptIncomeAllPeriodPanels();
                panel.style.display = 'block';
                search.value = '';
                renderRows('');
                search.focus();
            });

            search.addEventListener('input', function (evt) {
                renderRows(evt.target.value);
            });

            backing.addEventListener('change', syncInputFromSelect);

            document.addEventListener('click', function (evt) {
                if (!dropdown.contains(evt.target)) {
                    panel.style.display = 'none';
                }
            });

            syncInputFromSelect();
        }

        function initDeptIncomePeriodDropdownTables() {
            initDeptIncomeSinglePeriodDropdown({
                dropdownId: 'periodFromDropdown',
                inputId:    'periodFromInput',
                panelId:    'periodFromPanel',
                searchId:   'periodFromSearch',
                bodyId:     'periodFromBody',
                selectId:   'monthFromSelect'
            });

            initDeptIncomeSinglePeriodDropdown({
                dropdownId: 'periodToDropdown',
                inputId:    'periodToInput',
                panelId:    'periodToPanel',
                searchId:   'periodToSearch',
                bodyId:     'periodToBody',
                selectId:   'monthToSelect'
            });
        }

        // ────────────────────────────────────────────────────────────────────
        // Query results grid (client-side DataGridComponent in modal)
        // ────────────────────────────────────────────────────────────────────
        var deptIncomeQueryGrid = null;

        function getDeptIncomeQueryColumns() {
            return [
                { field: 'project',          header: 'Project',        width: 110, sortable: true },
                { field: 'oracleProjectCode', header: 'OracleProject',  width: 130, sortable: true },
                { field: 'subAccountCode',    header: 'SubAccount',     width: 120, sortable: true },
                { field: 'month',             header: 'Month',          width: 80,  sortable: true },
                { field: 'defraProject',      header: 'DefraProject',   width: 120, sortable: true },
                { field: 'oCC',               header: 'OCC',            width: 100, sortable: true },
                { field: 'oPC',               header: 'OPC',            width: 80,  sortable: true },
                { field: 'sPC',               header: 'SPC',            width: 80,  sortable: true },
                { field: 'sCC',               header: 'SCC',            width: 100, sortable: true },
                { field: 'name',              header: 'Name',           width: 170, sortable: true },
                { field: 'gradeCode',         header: 'GradeCode',      width: 100, sortable: true },
                { field: 'spNumber',          header: 'SPNumber',       width: 100, sortable: true },
                { field: 'chargeRate',        header: 'ChargeRate',     width: 110, sortable: true },
                { field: 'pay',               header: 'Pay',            width: 100, sortable: true },
                { field: 'nonPay',            header: 'NonPay',         width: 100, sortable: true },
                { field: 'overhead',          header: 'Overhead',       width: 100, sortable: true },
                { field: 'time',              header: 'Time',           width: 90,  sortable: true },
                { field: 'totalCost',         header: 'TotalCost',      width: 110, sortable: true }
            ];
        }

        function ensureDeptIncomeQueryGrid(dataRows) {
            if (!deptIncomeQueryGrid) {
                if (typeof DataGridComponent === 'undefined') { return; }
                deptIncomeQueryGrid = new DataGridComponent({
                    gridId:               'departmentIncomeQueryGrid',
                    containerSelector:    '#gridContainer_departmentIncomeQuery',
                    title:                '',
                    columns:              getDeptIncomeQueryColumns(),
                    data:                 dataRows,
                    pageSize:             10,
                    enableSort:           true,
                    enableFilter:         true,
                    enableResize:         true,
                    enableSelection:      false,
                    enablePagination:     true,
                    showAddButton:        false,
                    scrollContainerHeight: 'calc(100vh - 230px)',
                    pageSizeOptions:      [5, 10, 25, 50, 100]
                });
                return;
            }
            deptIncomeQueryGrid.updateData(dataRows);
        }

        // ────────────────────────────────────────────────────────────────────
        // GOV.UK query results modal helpers
        //   openModal / closeModal from ~/css/common/_govuk_modal.css conventions
        // ────────────────────────────────────────────────────────────────────
        function openDeptIncomeQueryModal() {
            var modal = document.getElementById('departmentIncomeQueryModal');
            if (modal) {
                modal.setAttribute('aria-hidden', 'false');
                modal.classList.add('govuk-modal--open');
                modal.style.display = 'flex';
            }
        }

        function closeDeptIncomeQueryModal() {
            var modal = document.getElementById('departmentIncomeQueryModal');
            if (modal) {
                modal.setAttribute('aria-hidden', 'true');
                modal.classList.remove('govuk-modal--open');
                modal.style.display = '';
            }
        }

        // ────────────────────────────────────────────────────────────────────
        // Utility: read filter values
        // ────────────────────────────────────────────────────────────────────
        function getDeptIncomeProject() {
            var el = document.getElementById('projectSelect');
            return el ? (el.value || '') : '';
        }

        function getDeptIncomeMonthFromValue() {
            var el = document.getElementById('monthFromSelect');
            if (!el || !el.value) { return null; }
            var n = parseInt(el.value, 10);
            return Number.isNaN(n) ? null : n;
        }

        function getDeptIncomeMonthToValue() {
            var el = document.getElementById('monthToSelect');
            if (!el || !el.value) { return null; }
            var n = parseInt(el.value, 10);
            return Number.isNaN(n) ? null : n;
        }

        // ────────────────────────────────────────────────────────────────────
        // Popup message helpers (preserved from HTML prototype)
        // ────────────────────────────────────────────────────────────────────
        function closeDeptIncomePopupMessage() {
            var overlay = document.getElementById('govuk-popup-overlay');
            var popup   = document.getElementById('govuk-popup');
            if (overlay) { overlay.classList.remove('active'); }
            if (popup)   { popup.classList.remove('active'); popup.innerHTML = ''; }
        }

        function showDeptIncomePopupMessage(title, message) {
            var overlay = document.getElementById('govuk-popup-overlay');
            var popup   = document.getElementById('govuk-popup');
            if (!overlay || !popup) { window.alert(message); return; }

            popup.innerHTML =
                '<div class="govuk-notification-banner" role="alert">' +
                '  <div class="govuk-notification-banner__header">' +
                '    <h2 class="govuk-notification-banner__title">' + title + '</h2>' +
                '  </div>' +
                '  <div class="govuk-notification-banner__content">' +
                '    <h3 class="govuk-notification-banner__heading">' + message + '</h3>' +
                '    <div class="govuk-button-group">' +
                '      <button type="button" class="govuk-button govuk-button--secondary" id="departmentIncomePopupCloseBtn">Close</button>' +
                '    </div>' +
                '  </div>' +
                '</div>';

            overlay.classList.add('active');
            popup.classList.add('active');

            var closeBtn = document.getElementById('departmentIncomePopupCloseBtn');
            if (closeBtn) { closeBtn.addEventListener('click', closeDeptIncomePopupMessage); }
        }

        // ────────────────────────────────────────────────────────────────────
        // AJAX data loaders — call MVC controller AJAX endpoints
        // ────────────────────────────────────────────────────────────────────
        var deptIncomeQueryIdToEndpoint = {
            'time':                   '@Url.Action("GetTimeData",       "DepartmentIncome", new { area = "FPS" })',
            'tests':                  '@Url.Action("GetTestData",        "DepartmentIncome", new { area = "FPS" })',
            'animals':                '@Url.Action("GetAnimalData",      "DepartmentIncome", new { area = "FPS" })',
            'exceptional':            '@Url.Action("GetAdditionalData",  "DepartmentIncome", new { area = "FPS" })',
            'totals':                 '@Url.Action("GetTotalsData",      "DepartmentIncome", new { area = "FPS" })',
            'qryDeptIncomeTime':      '@Url.Action("GetTimeData",       "DepartmentIncome", new { area = "FPS" })',
            'qryDeptIncomeTest':      '@Url.Action("GetTestData",        "DepartmentIncome", new { area = "FPS" })',
            'qryDeptIncomeAnimal':    '@Url.Action("GetAnimalData",      "DepartmentIncome", new { area = "FPS" })',
            'qryDeptIncomeAdditional':'@Url.Action("GetAdditionalData",  "DepartmentIncome", new { area = "FPS" })',
            'qryDeptIncomeTotals':    '@Url.Action("GetTotalsData",      "DepartmentIncome", new { area = "FPS" })'
        };

        function fetchDeptIncomeQueryData(queryId, callback) {
            var endpoint = deptIncomeQueryIdToEndpoint[queryId];
            if (!endpoint) {
                callback([]);
                return;
            }

            var params = {
                project:   getDeptIncomeProject(),
                monthFrom: getDeptIncomeMonthFromValue(),
                monthTo:   getDeptIncomeMonthToValue()
            };

            $.ajax({
                url:  endpoint,
                type: 'POST',
                data: params,
                success: function (response) {
                    if (response && response.success && Array.isArray(response.data)) {
                        callback(response.data);
                    } else {
                        showDeptIncomePopupMessage('Error', response.message || 'Failed to load query data.');
                        callback([]);
                    }
                },
                error: function () {
                    showDeptIncomePopupMessage('Error', 'An error occurred while loading query data.');
                    callback([]);
                }
            });
        }

        // ────────────────────────────────────────────────────────────────────
        // Snapshot tab — Run query
        //   merges rows from all selected snapshot query IDs then shows the modal
        // ────────────────────────────────────────────────────────────────────
        function getSelectedSnapshotQueryIds() {
            var select = document.getElementById('snapshotQuerySelect');
            if (!select) { return []; }
            return Array.from(select.selectedOptions).map(function (o) { return o.value; });
        }

        function openSnapshotQueryModal() {
            var selectedIds = getSelectedSnapshotQueryIds();
            var queryIds    = selectedIds.length ? selectedIds : ['time'];
            var allRows     = [];
            var pending     = queryIds.length;

            function onDone(rows) {
                allRows = allRows.concat(rows);
                pending--;
                if (pending === 0) {
                    var titleEl = document.getElementById('departmentIncomeQueryModalTitle');
                    if (titleEl) {
                        titleEl.textContent = 'Department income query results: ' + queryIds.join(', ');
                    }
                    ensureDeptIncomeQueryGrid(allRows);
                    openDeptIncomeQueryModal();
                }
            }

            //   prototype also runs them sequentially via concat)
            queryIds.forEach(function (queryId) {
                fetchDeptIncomeQueryData(queryId, onDone);
            });
        }

        // ────────────────────────────────────────────────────────────────────
        // Current tab — Run query
        // ────────────────────────────────────────────────────────────────────
        function getSelectedCurrentQueryId() {
            var select = document.getElementById('querySelect');
            if (!select || select.selectedIndex < 0) { return ''; }
            return select.options[select.selectedIndex].value;
        }

        function openCurrentQueryModal() {
            var queryId = getSelectedCurrentQueryId() || 'qryDeptIncomeTime';

            fetchDeptIncomeQueryData(queryId, function (rows) {
                var titleEl = document.getElementById('departmentIncomeQueryModalTitle');
                if (titleEl) {
                    titleEl.textContent = 'Department income query results: ' + queryId;
                }
                ensureDeptIncomeQueryGrid(rows);
                openDeptIncomeQueryModal();
            });
        }

        // ────────────────────────────────────────────────────────────────────
        // DOMContentLoaded — wire all events, initialise period dropdowns
        // ────────────────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {

            // Period dropdown tables
            initDeptIncomePeriodDropdownTables();

            // Project / period change — reload snapshot grid
            var projectSelect   = document.getElementById('projectSelect');
            var monthFromSelect = document.getElementById('monthFromSelect');
            var monthToSelect   = document.getElementById('monthToSelect');

            if (projectSelect)   { projectSelect.addEventListener('change',   reloadDepartmentIncomeSnapshotGrid); }
            if (monthFromSelect) { monthFromSelect.addEventListener('change',  reloadDepartmentIncomeSnapshotGrid); }
            if (monthToSelect)   { monthToSelect.addEventListener('change',    reloadDepartmentIncomeSnapshotGrid); }

            // Run query buttons
            var runSnapshot = document.getElementById('runQueryBtnSnapshot');
            var runCurrent  = document.getElementById('runQueryBtnCurrent');

            if (runSnapshot) {
                runSnapshot.addEventListener('click', function () {
                    reloadDepartmentIncomeSnapshotGrid();
                    openSnapshotQueryModal();
                });
            }

            if (runCurrent) {
                runCurrent.addEventListener('click', function () {
                    openCurrentQueryModal();
                });
            }

            // Modal close button
            var modalCloseBtn = document.getElementById('departmentIncomeQueryModalCloseBtn');
            if (modalCloseBtn) {
                modalCloseBtn.addEventListener('click', closeDeptIncomeQueryModal);
            }

            // Click outside modal dialog to close
            var modal = document.getElementById('departmentIncomeQueryModal');
            if (modal) {
                modal.addEventListener('click', function (evt) {
                    if (evt.target && evt.target.id === 'departmentIncomeQueryModal') {
                        closeDeptIncomeQueryModal();
                    }
                });
            }

            // Popup overlay click to close
            var popupOverlay = document.getElementById('govuk-popup-overlay');
            if (popupOverlay) {
                popupOverlay.addEventListener('click', function (evt) {
                    if (evt.target && evt.target.id === 'govuk-popup-overlay') {
                        closeDeptIncomePopupMessage();
                    }
                });
            }
        });
    </script>
}
