@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ResourceCentreMaintenanceViewModel

@{
    ViewData["Title"] = "Resource Centre Maintenance";
}

<main id="main-content">
    <div class="container-fluid">
        <!-- Breadcrumb section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div style="padding: 5px 5px; border-bottom: 1px solid #b4b4b4" class="row">
                    <div style="display: flex; font-size: 14px; align-items: center; justify-content: space-between;">
                        <div class="col-md-6">
                            <nav aria-label="Breadcrumb">
                                <a class="" href="@Url.Action("Index", "Home", new { area = "FPS" })">Home</a> &gt; MAB &gt; Maintenance Menu &gt; Maintain Resource Centre
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Title section -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">Resource Centre Maintenance</h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">
                                    <!-- Side nav -->
                                    @await Html.PartialAsync("_MaintenanceSideNav", "ResourceCentreMaintenance")
                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">
                                        <!-- DataGrid section -->
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full mt-2">
                                                <!-- Grid Container -->
                                                <div id="@($"gridContainer_{Model.ResourceCentreGrid.GridId}")">
                                                    @await Html.PartialAsync("_DataGrid", Model.ResourceCentreGrid)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>

        // Function to get current filters from the grid
        function getCurrentFilters() {
            var filters = {};
            $('.grid-filter').each(function () {
                var filterName = $(this).data('filter');
                var filterValue = $(this).val();
                if (filterValue && filterValue.trim() !== '') {
                    filters[filterName] = filterValue;
                }
            });
            return filters;
        }

        // Function to get current sort state
        function getCurrentSort() {
            var sortColumn = '';
            var sortDescending = false;

            var $sortedHeader = $('.sortable-header').filter(function() {
                return $(this).find('.sort-icon').text().trim() !== '';
            });

            if ($sortedHeader.length > 0) {
                sortColumn = $sortedHeader.data('column');
                sortDescending = $sortedHeader.data('sortdir') === 'true';
            }

            return { column: sortColumn, descending: sortDescending };
        }

        // Function to refresh grid with current filters and sort
        function refreshGrid() {
            var filters = getCurrentFilters();
            var sort = getCurrentSort();
            var currentPage = parseInt($('#resourceCentreGrid').data('current-page')) || 1;
            var pageSize = parseInt($('#resourceCentreGrid').data('page-size')) || 10;
            var requestData = {
                Page: currentPage,
                PageSize: pageSize,
                Filter: JSON.stringify(filters),
                SortBy: sort.column,
                Descending: sort.descending
            };

            $.ajax({
                url: '@Url.Action("LoadResourceCentreGrid", "ResourceCentreMaintenance", new { area = "FPS" })',
                type: 'POST',
                data: requestData,
                success: function (html) {
                    $('#gridContainer_resourceCentreGrid').html(html);
                },
                error: function (xhr, status, error) {
                    window.location.reload();
                }
            });
        }

        // Add Resource Centre
        function addResourceCentre(btn) {
            $.ajax({
                url: '@Url.Action("Create", "ResourceCentreMaintenance", new { area = "FPS" })',
                type: 'GET',
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass("show");
                },
                error: function () {
                    showGovukAlert('An error occurred while loading the form');
                }
            });
        }

        // Save Resource Centre (Create)
        function saveResourceCentre() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#addResourceCentreForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var rawContTarget = form.find('[name="ContTarget"]').val();
            var contTarget = rawContTarget !== '' ? parseFloat(rawContTarget) : null;

            var rawDivisionId = form.find('[name="DivisionId"]').val();
            var divisionId = rawDivisionId !== '' ? parseInt(rawDivisionId) : null;

            var data = {
                ProfitCentreId: form.find('[name="ProfitCentreId"]').val(),
                ProfitCentreName: form.find('[name="ProfitCentreName"]').val(),
                Division: form.find('[name="Division"]').val(),
                ContTarget: contTarget,
                ProfitCentreHead: form.find('[name="ProfitCentreHead"]').val() || null,
                DivisionId: divisionId,
                EmailRecipient: form.find('[name="EmailRecipient"]').val() || null
            };

            $.ajax({
                url: '@Url.Action("Create", "ResourceCentreMaintenance", new { area = "FPS" })',
                type: 'POST',
                data: JSON.stringify(data),
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    if (result.success) {
                        showGovukAlert(result.message).then(function () {
                            closeModal();
                            window['gridManager_resourceCentreGrid'].reloadGrid({ page: 1 });
                        });
                    } else {
                        displayServerValidationErrors(result.errors, result.message, '#modaPopupBody');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showGovukAlert('An error occurred while saving');
                    }
                }
            });
        }

        // Update Resource Centre (Edit)
        function updateResourceCentre() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#editResourceCentreForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var originalProfitCentreId = $('#originalProfitCentreId').val();

            var rawContTarget = form.find('[name="ContTarget"]').val();
            var contTarget = rawContTarget !== '' ? parseFloat(rawContTarget) : null;

            var rawDivisionId = form.find('[name="DivisionId"]').val();
            var divisionId = rawDivisionId !== '' ? parseInt(rawDivisionId) : null;

            var data = {
                ProfitCentreId: form.find('[name="ProfitCentreId"]').val(),
                ProfitCentreName: form.find('[name="ProfitCentreName"]').val(),
                Division: form.find('[name="Division"]').val(),
                ContTarget: contTarget,
                ProfitCentreHead: form.find('[name="ProfitCentreHead"]').val() || null,
                DivisionId: divisionId,
                EmailRecipient: form.find('[name="EmailRecipient"]').val() || null
            };

            $.ajax({
                url: '@Url.Action("Edit", "ResourceCentreMaintenance", new { area = "FPS" })?originalProfitCentreId=' + encodeURIComponent(originalProfitCentreId),
                type: 'POST',
                data: JSON.stringify(data),
                contentType: 'application/json; charset=utf-8',
                success: function (result) {
                    if (result.success) {
                        showGovukAlert(result.message).then(function () {
                            closeModal();
                            window['gridManager_resourceCentreGrid'].reloadGrid({ page: 1 });
                        });
                    } else {
                        displayServerValidationErrors(result.errors, result.message, '#modaPopupBody');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showGovukAlert('An error occurred while saving.');
                    }
                }
            });
        }

        // Edit Resource Centre
        function editResourceCentre(btn) {
            var profitCentreId = $(btn).data('id');
            $.ajax({
                url: '@Url.Action("Edit", "ResourceCentreMaintenance", new { area = "FPS" })',
                type: 'GET',
                data: { profitCentreId: profitCentreId },
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass("show");
                },
                error: function () {
                    showGovukAlert('An error occurred while editing record');
                }
            });
        }

        // Delete Resource Centre
        function deleteResourceCentre(btn) {
            var profitCentreId = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this record?').then(function (result) {
                if (!result) return;
                $.ajax({
                    url: '@Url.Action("Delete", "ResourceCentreMaintenance", new { area = "FPS" })',
                    type: 'DELETE',
                    data: { profitCentreId: profitCentreId },
                    success: function (response) {
                        if (response.success) {
                            showGovukAlert('ResourceCentre Deleted successfully').then(function () {
                                window['gridManager_resourceCentreGrid'].reloadGrid({ page: 1 });
                            });
                        } else {
                            showGovukAlert('Error: ' + response.message);
                        }
                    },
                    error: function () {
                        showGovukAlert('An error occurred while deleting');
                    }
                });
            });
        }

        function closeModal() {
            clearValidationErrors('#modaPopupBody');
            $('#modaPopupBody').html("");
            $('#modalPopup').removeClass("show");
        }

        function isFormValid(form) {
            var isValid = true;
            form.find('[required]').each(function () {
                if (!$(this).val() || $(this).val().trim() === '') {
                    isValid = false;
                    return false;
                }
            });
            return isValid;
        }

        $(document).ready(function() {
            $('#gridContainer_resourceCentreGrid').on('keypress', '.grid-filter', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $(this).trigger('change');
                }
            });
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
