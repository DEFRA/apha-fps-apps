@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.DivisionMaintenanceViewModel

@{
    ViewData["Title"] = "Division Maintenance";
}

<main id="main-content" class="isClearfix isNoGlobalScrollBar">
    <div class="container-fluid">
        <!-- Title section -->
        <div class="govuk-grid-row sup_border-bottom govuk-!-margin-bottom-3">
            <div class="govuk-grid-column-one-full govuk-!-margin-bottom-3">
                <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-3 govuk-!-margin-left-3 isCustomPageHeadings">
                    Division Maintenance
                </h1>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding: 0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div style="display: flex; flex-direction: row; align-items: flex-start;">
                                    <!-- Side nav -->
                                    @await Html.PartialAsync("_MaintenanceSideNav", "DivisionMaintenance")
                                    <div style="display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; margin: 0 0px 5px 8px;">
                                        <!-- DataGrid section -->
                                        <div class="govuk-grid-row">
                                            <div class="govuk-grid-column-full mt-2">
                                                <!-- Grid Container -->
                                                <div id="@($"gridContainer_{Model.DivisionGrid.GridId}")">
                                                    @await Html.PartialAsync("_DataGrid", Model.DivisionGrid)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>

        // Add Division
        function addDivision(btn) {
            $.ajax({
                url: '@Url.Action("Create", "DivisionMaintenance", new { area = "FPS" })',
                type: 'GET',
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass("show");
                },
                error: function () {
                    showAlertMessage('An error occurred while loading the form', AlertType.ERROR);
                }
            });
        }

        // Division ID is stored as a 32-bit integer in the database, so values above
        // int.MaxValue must be rejected before posting, otherwise the JSON payload
        // cannot be bound to the view model.
        var MAX_DIVISION_ID = 2147483647;

        function isDivisionIdInRange(form) {
            var rawDivisionId = form.find('[name="DivisionId"]').val();
            if (rawDivisionId === '' || parseInt(rawDivisionId, 10) <= MAX_DIVISION_ID) {
                return true;
            }

            displayServerValidationErrors(
                [{ field: 'DivisionId', message: 'Division ID must be between 1 and ' + MAX_DIVISION_ID + '.' }],
                'There is a problem',
                '#modaPopupBody');
            return false;
        }

        // Checks Division Name uniqueness (case-insensitive) before submitting the modal.
        // Invokes onAvailable() when the name is free, otherwise shows an inline error.
        function checkDivisionNameAvailable(divName, originalDivName, onAvailable) {
            $.ajax({
                url: '@Url.Action("CheckDivisionNameExists", "DivisionMaintenance", new { area = "FPS" })',
                type: 'GET',
                data: { divName: divName, originalDivName: originalDivName || '' },
                success: function (result) {
                    if (result && result.exists) {
                        displayServerValidationErrors(
                            [{ field: 'DivName', message: "Division '" + divName + "' already exists." }],
                            'There is a problem',
                            '#modaPopupBody');
                    } else {
                        onAvailable();
                    }
                },
                error: function () {
                    // If the availability check fails, fall back to server-side validation on submit.
                    onAvailable();
                }
            });
        }

        // Builds the payload posted to Create/Edit from the modal form.
        function buildDivisionPayload(form) {
            var rawCentOverhead = form.find('[name="CentOverhead"]').val();
            var rawDivisionId = form.find('[name="DivisionId"]').val();

            return {
                DivisionId: rawDivisionId !== '' ? parseInt(rawDivisionId) : null,
                DivName: form.find('[name="DivName"]').val(),
                AgencyId: parseInt(form.find('[name="AgencyId"]').val()),
                CentOverhead: rawCentOverhead !== '' ? parseFloat(rawCentOverhead) : null
            };
        }

        // Shared submit pipeline for both the Create and Edit modals.
        // formSelector: modal form to read; url: endpoint to post to.
        function submitDivisionForm(formSelector, url) {
            clearValidationErrors('#modaPopupBody');
            var form = $(formSelector);

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            if (!isDivisionIdInRange(form)) {
                return;
            }

            var originalDivName = $('#originalDivName').val();
            var data = buildDivisionPayload(form);

            checkDivisionNameAvailable(data.DivName, originalDivName, function () {
                $.ajax({
                    url: url(originalDivName),
                    type: 'POST',
                    data: JSON.stringify(data),
                    contentType: 'application/json; charset=utf-8',
                    success: function (result) {
                        if (result.success) {
                            showAlertMessage(result.message, AlertType.SUCCESS).then(function () {
                                closeModal();
                                window['gridManager_divisionGrid'].reloadGrid({ page: 1 });
                            });
                        } else {
                            displayServerValidationErrors(result.errors, result.message, '#modaPopupBody');
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 400 && xhr.responseJSON) {
                            displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                        } else {
                            showAlertMessage('An error occurred while saving', AlertType.ERROR);
                        }
                    }
                });
            });
        }

        // Save Division (Create)
        function saveDivision() {
            submitDivisionForm('#addDivisionForm', function () {
                return '@Url.Action("Create", "DivisionMaintenance", new { area = "FPS" })';
            });
        }

        // Update Division (Edit)
        // Uses original DivName in the URL to identify the record to update.
        function updateDivision() {
            submitDivisionForm('#editDivisionForm', function (originalDivName) {
                return '@Url.Action("Edit", "DivisionMaintenance", new { area = "FPS" })?originalDivName=' + encodeURIComponent(originalDivName);
            });
        }

        // Edit Division
        function editDivision(btn) {
            var divName = $(btn).data('id');
            $.ajax({
                url: '@Url.Action("Edit", "DivisionMaintenance", new { area = "FPS" })',
                type: 'GET',
                data: { divName: divName },
                success: function (html) {
                    $('#modaPopupBody').html(html);
                    $('#modalPopup').addClass("show");
                },
                error: function () {
                    showAlertMessage('An error occurred while editing record', AlertType.ERROR);
                }
            });
        }

        // Delete Division
        function deleteDivision(btn) {
            var divName = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this record?').then(function (result) {
                if (!result) return;
                $.ajax({
                    url: '@Url.Action("Delete", "DivisionMaintenance", new { area = "FPS" })',
                    type: 'DELETE',
                    data: { divName: divName },
                    success: function (response) {
                        if (response.success) {
                                showAlertMessage('Deleted successfully', AlertType.SUCCESS).then(function () {
                                    window['gridManager_divisionGrid'].reloadGrid({ page: 1 });
                                });
                        } else {

                            showAlertMessage('Error: ' + response.message, AlertType.ERROR);
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting', AlertType.ERROR);
                    }
                });
            });
        }
        
        function closeModal() {
            clearValidationErrors('#modaPopupBody');
            $('#modaPopupBody').html("");
            $('#modalPopup').removeClass("show");
        }

        // Returns true if all required fields in the form have values
        function isFormValid(form) {
            var isValid = true;
            form.find('[required]').each(function () {
                if (!$(this).val() || $(this).val().trim() === '') {
                    isValid = false;
                    return false; // break
                }
            });
            return isValid;
        }

        $(document).ready(function() {

            // Add Enter key support for filter inputs
            $('#gridContainer_divisionGrid').on('keypress', '.grid-filter', function(e) {
                if (e.which === 13) { // Enter key
                    e.preventDefault();
                    $(this).trigger('change'); // Trigger the change event to reload grid
                }
            });
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
