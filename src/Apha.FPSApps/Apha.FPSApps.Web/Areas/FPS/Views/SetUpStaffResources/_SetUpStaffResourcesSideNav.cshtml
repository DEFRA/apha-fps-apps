@* SetUpStaffResources side-navigation partial.
   Displays the Resource Management sub-nav with the active item highlighted.
   Pattern mirrors _MaintenanceSideNav.cshtml used by the Maintenance pages.
*@
<script>
    function toggleSidebar() {
        const sidebar = document.querySelector('.sidenav');
        sidebar.classList.toggle('collapsed');
    }
</script>
<nav class="sidenav flex-column flex-shrink-0" id="shortnav" aria-label="WorkGroup Resources navigation">
    <button class="toggle-btn" onclick="toggleSidebar()" style="right: -8px; top: 30px;" aria-label="Toggle sidebar">
        <img src="~/images/chevron-left-solid-full.svg" alt="side nav menu arrow" width="24" />
    </button>
    <ul>
        <li>
            <a class="dropdown-item sidenav-title"
               asp-area="FPS" asp-controller="SetUpStaffResources" asp-action="Index">
                Set Up Resources
            </a>
        </li>
        <li>
            <a class="dropdown-item"
               asp-area="FPS" asp-controller="BudgetResourceLevel" asp-action="Index">
                Review Plans
            </a>
        </li>
        <li>
            <a class="dropdown-item" href="#">
                Reports
            </a>
        </li>
    </ul>
</nav>
