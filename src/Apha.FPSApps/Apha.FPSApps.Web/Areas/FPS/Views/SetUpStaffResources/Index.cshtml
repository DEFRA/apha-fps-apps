@model Apha.FPSApps.Web.Areas.FPS.Models.SetUpStaffResourcesViewModel
@{
    ViewData["Title"] = "Set Up Staff Resources";
}

<main class="govuk-main-wrapper govuk-!-padding-top-0" id="main-content" role="main">
    <div class="container-fluid">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">              

                <div class="govuk-grid-row sup_border-bottom govuk-!-margin-bottom-2">
            <div class="govuk-grid-column-one-half">
                <h1 class="govuk-grid-row govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-3 govuk-!-margin-left-0 isCustomPageHeadings">
                    WorkGroup Selection Screen for <span id="ssrSelectedCentreName">@Model.SelectedResourceCentre</span>
                </h1>
            </div>
            <div class="govuk-grid-column-one-half isFloatRight">
                <table class="govuk-table govuk-!-margin-bottom-2">
                    <tbody class="govuk-table__body">
                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header govuk-!-padding-bottom-0 govuk-!-padding-right-0 isNoBottomBorder">
                                        <label class="govuk-label govuk-!-margin-bottom-0 govuk-!-padding-right-0 govuk-!-font-weight-bold isNoWrap govuk-!-padding-right-1" for="programmeDropdown">Select a Resource Center:</label>
                            </th>
                            <td class="govuk-table__cell govuk-!-padding-bottom-0 govuk-!-padding-right-1 isNoBottomBorder">
                                <select class="govuk-select"  id="resourceCentreSelect"
										aria-label="Select a Resource Center"
										asp-for="SelectedResourceCentre"
										asp-items="Model.ResourceCentres"
										onchange="LoadGroupsByResourceCentre()">
									<option value="">-- Select a Resource Center --</option>
								</select>
                            </td>

                                    <th scope="row" class="govuk-table__header  govuk-!-padding-right-1 govuk-!-padding-bottom-0 isNoBottomBorder">
                                        <label for="ssrSelectedWorkgroup" class="govuk-label govuk-!-margin-bottom-0 govuk-!-font-weight-bold isNoWrap govuk-!-padding-right-0">Select WorkGroup: </label>
                                    </th>
                                    <td class="govuk-table__cell govuk-!-padding-bottom-0 isNoBottomBorder">
                                        <select class="govuk-select"
                                                id="workGroupSelect"
                                                asp-for="SelectedWorkgroup"
                                                asp-items="Model.WorkGroupList"
                                                onchange="LoadGradeByGroup()">
                                            <option value="">-- Select a Work Group --</option>
                                        </select>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="govuk-grid-row">
            <div class="cc-container-fluid">
                <div class="cc-layout-row">

                    @await Html.PartialAsync("_SetUpStaffResourcesSideNav", "SetUpStaffResources")

                    <div class="cc-content-column">
                        <div class="govuk-grid-row">
                            <div class="govuk-grid-column-full">

                                <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
                                    <div class="govuk-grid-column-full sup_p_0">

                                        <section class="ssr-workgroup-section sup_border" aria-labelledby="ssr-workgroup-title">
                                            <h2 class="govuk-heading-s ssr-section-title" id="ssr-workgroup-title">
                                                Staff in WorkGroup <span id="ssrSelectedWorkGroupName">@Model.SelectedWorkgroup</span>
                                            </h2>

                                            <div class="ssr-top-layout">

                                                <div class="ssr-grade-panel">
                                                    <div class="ssr-grade-header">
                                                        <button type="button"
                                                                id="ssrGradeSortButton"
                                                                class="ssr-grade-sort-button govuk-label govuk-!-font-weight-bold govuk-!-margin-bottom-0"
                                                                aria-sort="ascending"
                                                                onclick="ssrToggleGradeSort()">
                                                            Grades in this Work Group
                                                            <span class="ssr-grade-sort-indicator" id="ssrGradeSortIndicator" aria-hidden="true">&#9650;</span>
                                                        </button>
                                                    </div>
                                                    <ul class="ssr-grade-list" id="ssrGradeList" role="listbox" aria-label="Select workgroup grade">
                                                        @foreach (var grade in Model.GradeList)
                                                        {
                                                            var gradeCode = Model.GradeCodeMap.TryGetValue(grade, out var gc) ? gc : string.Empty;
                                                            <li class="ssr-grade-item @(grade == Model.SelectedGrade ? "ssr-grade-item--active" : "")"
                                                                role="option"
                                                                tabindex="0"
                                                                data-grade-code="@gradeCode"
                                                                aria-selected="@(grade == Model.SelectedGrade ? "true" : "false")"
                                                                onclick="ssrSelectWorkGroup('@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(grade))')">
                                                                @grade
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>

                                                <div class="ssr-right-panel">
                                                    <div id="gridContainer_ssrStaffGrid">
                                                        @await Html.PartialAsync("_DataGrid", Model.StaffGrid)
                                                    </div>
                                                </div>

                                            </div>
                                        </section>
                                        <div class="ssr-bottom-row">
                                            <div class="ssr-summary-box">
                                                <div class="ssr-summary-field">
                                                    <span class="govuk-label govuk-!-font-weight-bold ssr-summary-label">Summary for Grade:</span>
                                                    <input type="text"
                                                           id="ssrSummaryGrade"
                                                           class="govuk-input ssr-summary-input text-AlignRight"
                                                           value="@Model.SummaryGrade"
                                                           readonly
                                                           aria-label="Summary grade" />
                                                </div>
                                                <div class="ssr-summary-field">
                                                    <span class="govuk-label govuk-!-font-weight-bold ssr-summary-label">WorkHrs at Staff Level:</span>
                                                    <input type="text"
                                                           id="ssrWorkHrs"
                                                           class="govuk-input ssr-summary-input text-AlignRight"
                                                           value="@Model.SummaryWorkHrs"
                                                           readonly
                                                           aria-label="Work hours at staff level" />
                                                </div>
                                            </div>

                                            <div class="ssr-person-box">
                                                <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Person Selected</h3>
                                                <div class="ssr-person-row">
                                                    <input type="text"
                                                           id="ssrPersonSelected"
                                                           class="govuk-input ssr-person-input govuk-!-font-weight-bold"
                                                           value="@Model.SelectedPersonName"
                                                           readonly
                                                           aria-label="Selected person" />
                                                    <input type="hidden" id="ssrSelectedPersonId" value="" />
                                                    <button type="submit"
                                                            id="planPersontoZTCodes"
                                                            class="govuk-button govuk-button--start ssr-person-action"
                                                            data-module="govuk-button"
                                                            onclick="ssrPlanPersonOntoZT()">
                                                        Plan Person onto ZT Codes
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    <script>
        // Initialise the SetUpStaffResources module with server-side values.
        window.ssrConfig = {
            currentCentre: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedResourceCentre))',
            currentWorkGroup: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedWorkgroup))',
            currentGrade: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedGrade))',
            ztCodeUrl: '@Url.Action("Index", "PlanStaffZTCode", new { area = "FPS" })',
            savePcSessionUrl: '@Url.Action("SaveProfitCentreSession", "SetUpStaffResources", new { area = "FPS" })'
        };

        // Initialise side nav state from server-selected values.
        window.sideNavState = {
            resourceCentre: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedResourceCentre))',
            workGroup: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.SelectedWorkgroup))',
            fpsYear: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(ViewBag.FpsYear?.ToString() ?? string.Empty))'
        };

        // Keep sideNavState in sync when the user changes the Resource Centre dropdown.
        (function() {
            function attachDropdownListeners() {
                const rcSelect = document.getElementById('resourceCentreSelect');
                const wgSelect = document.getElementById('workGroupSelect');

                if (rcSelect) {
                    rcSelect.addEventListener('change', function() {
                        window.sideNavState.resourceCentre = this.value;
                        window.sideNavState.workGroup = '';
                        sideNavUpdateLinks();
                    });
                }

                if (wgSelect) {
                    wgSelect.addEventListener('change', function() {
                        window.sideNavState.workGroup = this.value;
                        sideNavUpdateLinks();
                    });
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', attachDropdownListeners);
            } else {
                attachDropdownListeners();
            }
        })();

        // Keyboard navigation for the ".ssr-grade-list" listboxes
        // ("Grades in this Work Group"). The <li role="option"> items are not
        // focusable by default, so Tab skipped the list and arrow keys did
        // nothing. Every option is now a Tab stop, so Tab moves from one list
        // item to the next until the whole list has been navigated. Up/Down
        // (and Left/Right) also move between options, Home/End jump to
        // first/last, and Enter/Space activates the focused option. Listeners
        // are delegated so options rendered later by JavaScript are supported too.
        (function () {
            const LIST_SELECTOR = '.ssr-grade-list';
            const ITEM_SELECTOR = '.ssr-grade-item';
            const ACTIVE_CLASS = 'ssr-grade-item--active';

            function getOptions(list) {
                return Array.prototype.slice.call(list.querySelectorAll(ITEM_SELECTOR));
            }

            // Ensures every option is reachable with Tab, so focus moves from
            // one list item to the next and through the whole list.
            function syncTabIndexes(list) {
                getOptions(list).forEach(function (option) {
                    option.setAttribute('tabindex', '0');
                });
            }

            function syncAllLists() {
                Array.prototype.slice.call(document.querySelectorAll(LIST_SELECTOR))
                    .forEach(syncTabIndexes);
            }

            function focusOption(options, index) {
                if (index < 0 || index >= options.length) {
                    return;
                }
                options[index].focus();
            }

            document.addEventListener('keydown', function (e) {
                const item = e.target && e.target.closest ? e.target.closest(ITEM_SELECTOR) : null;
                if (!item) {
                    return;
                }

                const list = item.closest(LIST_SELECTOR);
                if (!list) {
                    return;
                }

                const options = getOptions(list);
                const currentIndex = options.indexOf(item);
                if (currentIndex === -1) {
                    return;
                }

                switch (e.key) {
                    case 'ArrowDown':
                    case 'ArrowRight':
                        e.preventDefault();
                        focusOption(options, (currentIndex + 1) % options.length);
                        break;
                    case 'ArrowUp':
                    case 'ArrowLeft':
                        e.preventDefault();
                        focusOption(options, (currentIndex - 1 + options.length) % options.length);
                        break;
                    case 'Home':
                        e.preventDefault();
                        focusOption(options, 0);
                        break;
                    case 'End':
                        e.preventDefault();
                        focusOption(options, options.length - 1);
                        break;
                    case 'Enter':
                    case ' ':
                    case 'Spacebar':
                        e.preventDefault();
                        item.click();
                        break;
                    default:
                        break;
                }
            });

            // Keep every option tabbable after a mouse selection.
            document.addEventListener('click', function (e) {
                const item = e.target && e.target.closest ? e.target.closest(ITEM_SELECTOR) : null;
                if (!item) {
                    return;
                }

                const list = item.closest(LIST_SELECTOR);
                if (!list) {
                    return;
                }

                syncTabIndexes(list);
            });

            function initGradeListKeyboard() {
                syncAllLists();

                // Lists built by JavaScript after load need the tab stops
                // re-applied whenever their content changes.
                if (window.MutationObserver) {
                    new MutationObserver(function (mutations) {
                        const needsSync = mutations.some(function (mutation) {
                            return mutation.type === 'childList' &&
                                (mutation.target.closest(LIST_SELECTOR) ||
                                    mutation.target.querySelector(LIST_SELECTOR));
                        });
                        if (needsSync) {
                            syncAllLists();
                        }
                    }).observe(document.body, { childList: true, subtree: true });
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initGradeListKeyboard);
            } else {
                initGradeListKeyboard();
            }
        })();

        // Tab order pairing: a grade option behaves like a tab and the staff
        // grid on the right behaves like its tab panel. By default Tab walked
        // through every grade first and only then entered the grid. This makes
        // Tab go option -> that option's content -> next option, and only after
        // the LAST option's content is finished does focus continue on to the
        // rest of the page (and finally the GOV.UK footer).
        //
        // Implementation notes:
        //  - The grid is re-rendered by AJAX when an option is selected, which
        //    destroys whatever we just focused and dumps focus on <body>
        //    (which is why Tab appeared to jump straight to the footer). We
        //    therefore re-apply focus once the panel stops mutating.
        //  - Zero-size "sentinel" elements are placed at the start and end of
        //    the panel. They are invisible and add no layout, but give us a
        //    reliable last/first tab stop that survives re-renders, instead of
        //    comparing against whichever element happens to be last.
        (function () {
            const LIST_SELECTOR = '.ssr-grade-list';
            const ITEM_SELECTOR = '.ssr-grade-item';
            const PANEL_SELECTOR = '.ssr-right-panel';
            const END_SELECTOR = '.ssr-bottom-row';
            const ACTIVE_CLASS = 'ssr-grade-item--active';
            const FOCUSABLE_SELECTOR = 'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
            const SENTINEL_CLASS = 'ssr-tab-sentinel';
            const SENTINEL_STYLE = 'position:absolute;width:1px;height:1px;padding:0;margin:0;border:0;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;';

            // Index of the option whose content is currently being navigated.
            let visitedIndex = -1;
            // Set while we are deliberately moving focus, to ignore our own events.
            let suppress = false;

            function isVisible(el) {
                return !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);
            }

            function getLayouts() {
                return Array.prototype.slice.call(document.querySelectorAll('.ssr-top-layout'));
            }

            function getOptions(list) {
                return list
                    ? Array.prototype.slice.call(list.querySelectorAll(ITEM_SELECTOR)).filter(isVisible)
                    : [];
            }

            function getListFor(el) {
                const layout = el ? el.closest('.ssr-top-layout') : null;
                if (layout) {
                    return layout.querySelector(LIST_SELECTOR);
                }
                // The end sentinel lives outside the layout (after the
                // "Plan Person onto ZT Codes" button), so fall back to the page.
                return document.querySelector(LIST_SELECTOR);
            }

            function getPanelFor(el) {
                const layout = el.closest('.ssr-top-layout');
                return layout ? layout.querySelector(PANEL_SELECTOR) : null;
            }

            // Adds/keeps the invisible tab stops that bound an option's content.
            // The start stop is the beginning of the grid panel; the end stop is
            // placed after the "Plan Person onto ZT Codes" button so the whole
            // summary / person area counts as the option's content.
            function makeSentinel(edge) {
                const el = document.createElement('span');
                el.className = SENTINEL_CLASS;
                el.dataset.edge = edge;
                el.tabIndex = 0;
                el.setAttribute('aria-hidden', 'true');
                el.setAttribute('style', SENTINEL_STYLE);
                return el;
            }

            function ensureSentinels(panel) {
                if (!panel) {
                    return;
                }

                let start = panel.querySelector(':scope > .' + SENTINEL_CLASS + '[data-edge="start"]');
                if (!start) {
                    start = makeSentinel('start');
                }
                if (panel.firstElementChild !== start) {
                    panel.insertBefore(start, panel.firstChild);
                }

                // End of content: after the Plan Person button when that block
                // exists, otherwise fall back to the end of the grid panel.
                const endHost = (panel.closest('.ssr-workgroup-section') || document)
                    .parentElement?.querySelector(END_SELECTOR) ||
                    document.querySelector(END_SELECTOR) ||
                    panel;

                let end = document.querySelector('.' + SENTINEL_CLASS + '[data-edge="end"]');
                if (!end) {
                    end = makeSentinel('end');
                }
                if (endHost.lastElementChild !== end) {
                    endHost.appendChild(end);
                }
            }

            function ensureAllSentinels() {
                getLayouts().forEach(function (layout) {
                    ensureSentinels(layout.querySelector(PANEL_SELECTOR));
                });
            }

            function focusSilently(el) {
                if (!el) {
                    return;
                }
                suppress = true;
                el.focus();
                window.setTimeout(function () { suppress = false; }, 0);
            }

            // Focuses the first real focusable inside the panel, re-applying it
            // after the AJAX re-render settles so focus is not lost to <body>.
            function enterPanel(panel) {
                let settled = false;

                function firstReal() {
                    ensureSentinels(panel);
                    const start = panel.querySelector('.' + SENTINEL_CLASS + '[data-edge="start"]');
                    let el = start ? start.nextElementSibling : null;
                    while (el) {
                        if (!el.classList.contains(SENTINEL_CLASS)) {
                            const candidate = el.matches(FOCUSABLE_SELECTOR) && isVisible(el)
                                ? el
                                : Array.prototype.slice.call(el.querySelectorAll(FOCUSABLE_SELECTOR)).filter(isVisible)[0];
                            if (candidate) {
                                return candidate;
                            }
                        }
                        el = el.nextElementSibling;
                    }
                    return start;
                }

                function apply() {
                    focusSilently(firstReal());
                }

                apply();

                // Re-apply while the grid is still being replaced.
                if (window.MutationObserver) {
                    const observer = new MutationObserver(function () {
                        if (!settled) {
                            apply();
                        }
                    });
                    observer.observe(panel, { childList: true, subtree: true });
                    window.setTimeout(function () {
                        settled = true;
                        observer.disconnect();
                        apply();
                    }, 600);
                }
            }

            // Forward Tab from a grade option enters that option's content.
            document.addEventListener('keydown', function (e) {
                if (e.key !== 'Tab' || e.shiftKey || e.altKey || e.ctrlKey || e.metaKey) {
                    return;
                }

                const target = e.target;
                if (!target || !target.closest) {
                    return;
                }

                const item = target.closest(ITEM_SELECTOR);
                if (!item || !item.closest(LIST_SELECTOR)) {
                    return;
                }

                const panel = getPanelFor(item);
                const options = getOptions(item.closest(LIST_SELECTOR));
                const index = options.indexOf(item);
                if (!panel || index === -1) {
                    return;
                }

                e.preventDefault();
                visitedIndex = index;
                if (!item.classList.contains(ACTIVE_CLASS)) {
                    item.click();
                }
                enterPanel(panel);
            }, true);

            // Landing on a sentinel means the panel's content boundary was
            // reached by normal tabbing, so redirect to the correct option.
            document.addEventListener('focusin', function (e) {
                if (suppress) {
                    return;
                }

                const sentinel = e.target && e.target.closest
                    ? e.target.closest('.' + SENTINEL_CLASS)
                    : null;
                if (!sentinel) {
                    return;
                }

                const options = getOptions(getListFor(sentinel));
                if (!options.length) {
                    return;
                }

                let index = visitedIndex;
                if (index < 0 || index >= options.length) {
                    index = options.findIndex(function (option) {
                        return option.classList.contains(ACTIVE_CLASS);
                    });
                }
                if (index === -1) {
                    return;
                }

                if (sentinel.dataset.edge === 'end') {
                    // Content finished: go to the next option. Only after the
                    // last option's content do we release focus to the rest of
                    // the page (and then the GOV.UK footer).
                    if (index + 1 < options.length) {
                        focusSilently(options[index + 1]);
                        visitedIndex = index + 1;
                    } else {
                        visitedIndex = -1;
                        sentinel.tabIndex = -1;
                        window.setTimeout(function () { sentinel.tabIndex = 0; }, 400);
                    }
                } else {
                    // Reverse into the panel: go back to the owning option.
                    focusSilently(options[index]);
                }
            });

            function init() {
                ensureAllSentinels();
                if (window.MutationObserver) {
                    new MutationObserver(ensureAllSentinels)
                        .observe(document.body, { childList: true, subtree: true });
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>
    <script src="~/js/fps_js/SetUpStaffResources.js"></script>
}