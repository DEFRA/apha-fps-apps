@* TRANSFORMENGINE MIGRATION — _EditStaffModal.cshtml (SetUpStaffResources)
   Pattern  : stack-upgrade/msaccess-frm-to-dotnet10-mvc-frontend  Phase 6 + Phase 8 Security Review
   Migrated : 2026-07-07
   CHANGED (Phase 6 — original migration):
     - Inline HTML modal (#ssrEditModal) extracted to shared _Layout #modalPopup pattern
     - @model directive added: SetUpStaffResourcesItem
     - asp-for Tag Helpers replace manual id="ssrEditXxx" inputs
     - @Html.AntiForgeryToken() added for CSRF protection
     - GradeCode (ssrEditGradeCode) → asp-for="WorkGroupGrade" disabled (read-only in HTML prototype)
     - SpNo (ssrEditSpNo) → asp-for="SpNumber" disabled (read-only in HTML prototype)
     - Name (ssrEditName) → asp-for="Name" editable text input
     - HrsPaid (ssrEditHrsPaid) → asp-for="HrsPaid" number input (editable)
     - Leave (ssrEditLeave) → asp-for="Leave" number input (editable)
     - SickSp (ssrEditSickSp) → asp-for="SickSpecial" number input (editable)
     - AtWork (ssrEditAtWork) → asp-for="HrsAvail" number input (disabled + JS recalc)
     - Planable (ssrEditPlanable) → asp-for="MakeAvailable" checkbox
     - PactId hidden input added for save routing
     - JS recalculateAtWork() listener for HrsPaid / Leave / SickSp changes
   CHANGED (Phase 8 — security fix):
     - onsubmit="return false;" added to form element: prevents Enter-key native GET submission
       that would expose the @Html.AntiForgeryToken() value as a URL query parameter
       (token leakage into server access logs / browser history)
   PRESERVED:
     - All govuk-grid-column-one-half two-column layout from HTML prototype modal body
     - All govuk-form-group, govuk-label, govuk-input, govuk-checkboxes CSS classes
     - Label text from HTML prototype verbatim: Grade Code, SP No, Name, Hrs Paid, Leave, Sick Sp, At Work, Planable
     - Modal header, modal body, modal footer button layout
     - saveSetUpStaffResources() / closeModal() JS function names
   DEFERRED: none — fully automated. *@

@model Apha.FPSApps.Web.Areas.FPS.Models.SetUpStaffResourcesItem

<div class="modal-header flex-space-center">
    <h3 class="modal-title govuk-heading-s govuk-!-margin-bottom-0" id="ssrEditModalTitle" style="margin: 0;">Edit Staff Record</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()" aria-label="Close">X</button>
</div>

<div class="modal-body" style="padding-top: 5px;">
    @* TRANSFORMENGINE (Phase 8 security fix): onsubmit="return false;" prevents Enter-key native
       browser form GET submission which would expose the anti-forgery token value as a URL
       query parameter (token leakage into server access logs / browser history). All saving
       goes through saveSetUpStaffResources() AJAX in Index.cshtml — no native submit needed. *@
    <form class="row" id="ssrEditForm" onsubmit="return false;">
        @Html.AntiForgeryToken()

        @* TRANSFORMENGINE: PactId hidden — key for edit POST routing; not visible in modal *@
        <input type="hidden" id="hdnPactId" asp-for="PactId" />

        @* ── Row 1: Grade Code (readonly) + SP No (readonly) ─────────────────── *@
        <div class="govuk-grid-column-one-half">
            <div class="govuk-form-group sup_margin_bottom_10">
                @* TRANSFORMENGINE: GradeCode — maps to WorkGroupGrade; disabled matches HTML 'readonly' *@
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="WorkGroupGrade">Grade Code</label>
                <input class="govuk-input govuk-!-font-size-16"
                       asp-for="WorkGroupGrade"
                       id="ssrEditGradeCode"
                       type="text"
                       disabled />
            </div>
        </div>
        <div class="govuk-grid-column-one-half">
            <div class="govuk-form-group sup_margin_bottom_10">
                @* TRANSFORMENGINE: SpNo — maps to SpNumber; disabled matches HTML 'readonly' *@
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="SpNumber">SP No</label>
                <input class="govuk-input govuk-!-font-size-16"
                       asp-for="SpNumber"
                       id="ssrEditSpNo"
                       type="text"
                       disabled />
            </div>
        </div>

        @* ── Row 2: Name (editable) + Hrs Paid (number) ──────────────────────── *@
        <div class="govuk-grid-column-one-half">
            <div class="govuk-form-group sup_margin_bottom_10">
                @* TRANSFORMENGINE: Name — editable text field (ssrEditName in HTML prototype) *@
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Name">Name</label>
                <input class="govuk-input govuk-!-font-size-16"
                       asp-for="Name"
                       id="ssrEditName"
                       type="text" />
                <span asp-validation-for="Name" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
        <div class="govuk-grid-column-one-half">
            <div class="govuk-form-group sup_margin_bottom_10">
                @* TRANSFORMENGINE: HrsPaid — editable number (ssrEditHrsPaid, min=0) *@
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="HrsPaid">Hrs Paid</label>
                <input class="govuk-input govuk-!-font-size-16"
                       asp-for="HrsPaid"
                       id="ssrEditHrsPaid"
                       type="number"
                       min="0"
                       step="0.01" />
                <span asp-validation-for="HrsPaid" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── Row 3: Leave (number) + Sick Sp (number) ────────────────────────── *@
        <div class="govuk-grid-column-one-half">
            <div class="govuk-form-group sup_margin_bottom_10">
                @* TRANSFORMENGINE: Leave — editable number (ssrEditLeave, min=0) *@
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Leave">Leave</label>
                <input class="govuk-input govuk-!-font-size-16"
                       asp-for="Leave"
                       id="ssrEditLeave"
                       type="number"
                       min="0"
                       step="0.01" />
                <span asp-validation-for="Leave" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
        <div class="govuk-grid-column-one-half">
            <div class="govuk-form-group sup_margin_bottom_10">
                @* TRANSFORMENGINE: SickSpecial — editable number (ssrEditSickSp, min=0) *@
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="SickSpecial">Sick Sp</label>
                <input class="govuk-input govuk-!-font-size-16"
                       asp-for="SickSpecial"
                       id="ssrEditSickSp"
                       type="number"
                       min="0"
                       step="0.01" />
                <span asp-validation-for="SickSpecial" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── Row 4: At Work (disabled + JS recalc) + Planable (checkbox) ─────── *@
        <div class="govuk-grid-column-one-half">
            <div class="govuk-form-group sup_margin_bottom_10">
                @* TRANSFORMENGINE: HrsAvail (AtWork) — computed = HrsPaid - Leave - SickSpecial.
                   disabled (not readonly) per GOV.UK styling for non-editable inputs.
                   JS listener recalculates on HrsPaid/Leave/SickSp input events. *@
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="HrsAvail">At Work</label>
                <input class="govuk-input govuk-!-font-size-16"
                       asp-for="HrsAvail"
                       id="ssrEditAtWork"
                       type="number"
                       min="0"
                       step="0.01"
                       disabled />
            </div>
        </div>
        <div class="govuk-grid-column-one-half">
            <div class="govuk-form-group sup_margin_bottom_10">
                @* TRANSFORMENGINE: MakeAvailable (Planable) — checkbox (ssrEditPlanable in HTML prototype)
                   int type (0/1) from WorkGroupEmployeeStaffDto; rendered as checkbox *@
                <div class="govuk-checkboxes govuk-checkboxes--small govuk-!-margin-top-5" data-module="govuk-checkboxes">
                    <div class="govuk-checkboxes__item">
                        <input class="govuk-checkboxes__input"
                               id="ssrEditPlanable"
                               type="checkbox"
                               @(Model.MakeAvailable != 0 ? "checked" : "") />
                        <label class="govuk-checkboxes__label govuk-!-font-weight-bold govuk-!-font-size-16" for="ssrEditPlanable">Planable</label>
                    </div>
                </div>
            </div>
        </div>

        @* ── Modal footer buttons ─────────────────────────────────────────────── *@
        <div class="govuk-grid-column-full" style="text-align: right; margin-top: 10px;">
            <button type="button"
                    class="govuk-button govuk-button--secondary sup_margin_0"
                    onclick="closeModal()">
                Cancel
            </button>
            <button type="button"
                    class="govuk-button sup_margin_0"
                    onclick="saveSetUpStaffResources()">
                Save
            </button>
        </div>

    </form>
</div>

<script>
    // TRANSFORMENGINE: recalculateAtWork() — HrsPaid - Leave - SickSpecial → AtWork (disabled field)
    //   Mirrors JS prototype's ssrSaveEdit() inline recalc logic, surfaced as a live update on input.
    function recalculateAtWork() {
        var hrsPaid  = parseFloat(document.getElementById('ssrEditHrsPaid')?.value || '0') || 0;
        var leave    = parseFloat(document.getElementById('ssrEditLeave')?.value   || '0') || 0;
        var sickSp   = parseFloat(document.getElementById('ssrEditSickSp')?.value  || '0') || 0;
        var atWork   = hrsPaid - leave - sickSp;
        var el = document.getElementById('ssrEditAtWork');
        if (el) el.value = atWork.toFixed(2);
    }

    // Wire input events for live recalc (mirrors JS prototype behaviour)
    (function wireAtWorkRecalc() {
        ['ssrEditHrsPaid', 'ssrEditLeave', 'ssrEditSickSp'].forEach(function (id) {
            var input = document.getElementById(id);
            if (input) { input.addEventListener('input', recalculateAtWork); }
        });
    })();
</script>
