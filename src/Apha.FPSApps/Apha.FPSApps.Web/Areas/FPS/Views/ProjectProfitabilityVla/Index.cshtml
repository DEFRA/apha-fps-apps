@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.ProjectProfitabilityVlaViewModel

@{
    ViewData["Title"] = "FPS : Project Profitability for VLA";

    // Negative totals are displayed as -(1,234.00); the JS summary refresh mirrors this.
    Func<decimal?, string> formatTotal = v =>
        !v.HasValue ? "0.00"
            : v.Value < 0 ? "-(" + Math.Abs(v.Value).ToString("N2") + ")"
            : v.Value.ToString("N2");
}

<main class="govuk-main-wrapper govuk-!-padding-top-0 asu-main-content" id="main-content" role="main">
    <div class="container-fluid">

        @* ── Page title ──────────────────────────────────────────────────────── *@
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <h1 class="govuk-grid-row govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    Project Profitability for VLA
                </h1>
            </div>
        </div>

        @* ── Filter dropdowns ────────────────────────────────────────────────── *@
        <div class="govuk-grid-row sup_margin_left_right_10">

            @* Filter 1: Project Status — static options matching HTML prototype *@
            <div class="govuk-grid-column-one-quarter govuk-!-padding-left-0" style="width: 20%;">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           for="filterProjectStatus">Project Status Filter</label>
                    <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                            id="filterProjectStatus"
                            asp-for="SelectedStatus"
                            onchange="reloadProjectProfitabilityVlaGrid()">
                        @if (Model.SelectedStatus == "Approved")
                        {
                            <option value="">All statuses</option>
                            <option value="Approved" selected>Approved</option>
                            <option value="Completed">Completed</option>
                            <option value="Not Approved">Not Approved</option>
                        }
                        else if (Model.SelectedStatus == "Completed")
                        {
                            <option value="">All statuses</option>
                            <option value="Approved">Approved</option>
                            <option value="Completed" selected>Completed</option>
                            <option value="Not Approved">Not Approved</option>
                        }
                        else if (Model.SelectedStatus == "Not Approved")
                        {
                            <option value="">All statuses</option>
                            <option value="Approved">Approved</option>
                            <option value="Completed">Completed</option>
                            <option value="Not Approved" selected>Not Approved</option>
                        }
                        else
                        {
                            <option value="" selected>All statuses</option>
                            <option value="Approved">Approved</option>
                            <option value="Completed">Completed</option>
                            <option value="Not Approved">Not Approved</option>
                        }
                    </select>
                </div>
            </div>

            @* Filter 2: Program — dynamic, populated from IProgramService *@
            <div class="govuk-grid-column-one-quarter" style="width: 20%;">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           for="filterProgram">Program Filter</label>
                    <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                            id="filterProgram"
                            asp-for="SelectedProgram"
                            asp-items="Model.ProgramList"
                            onchange="reloadProjectProfitabilityVlaGrid()">
                        <option value="">All programs</option>
                    </select>
                </div>
            </div>

            @* Filter 3: Manager — dynamic, populated from IProjectService.GetManagersAsync() *@
            <div class="govuk-grid-column-one-quarter" style="width: 20%;">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           for="filterManager">Manager Filter</label>
                    <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                            id="filterManager"
                            asp-for="SelectedManager"
                            asp-items="Model.ManagerList"
                            onchange="reloadProjectProfitabilityVlaGrid()">
                        <option value="">All managers</option>
                    </select>
                </div>
            </div>

            @* Filter 4: Customer — dynamic, populated from IProjectService.GetAllCustomersAsync() *@
            <div class="govuk-grid-column-one-quarter" style="width: 20%;">
                <div class="govuk-form-group sup_margin_bottom_10">
                    <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16"
                           for="filterCustomer">Project Customer Filter</label>
                    <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                            id="filterCustomer"
                            asp-for="SelectedCustomer"
                            asp-items="Model.CustomerList"
                            onchange="reloadProjectProfitabilityVlaGrid()">
                        <option value="">All customers</option>
                    </select>
                </div>
            </div>

            @* Clear button — resets all 4 filters and reloads grid *@
            <div class="govuk-grid-column-one-quarter govuk-!-text-align-right"
                 style="width: 20%; display: flex; align-items: flex-end; justify-content: flex-start;">
                <button type="button"
                        class="govuk-button govuk-!-margin-bottom-2 govuk-!-margin-top-5"
                        data-module="govuk-button"
                        id="clearProjectProfitabilityFilters"
                        aria-label="Clear all filters"
                        onclick="clearProjectProfitabilityVlaFilters()">Clear</button>
            </div>
        </div>

        @* ── DataGrid ────────────────────────────────────────────────────────── *@
        <div class="govuk-grid-row sup_margin_left_right_10 sup_margin_bottom_10">
            <div class="govuk-grid-column-full sup_p_0">
                <div id="gridContainer_projectProfitabilityVlaGrid">
                    @await Html.PartialAsync("_DataGrid", Model.ProfitabilityVlaGrid)
                </div>
            </div>
        </div>

        @* ── Summary totals bar ──────────────────────────────────────────────── *@
        <div id="projectProfitabilitySummary"
             class="sup_margin_left_right_10 financial-summary govuk-!-margin-bottom-2">
            <div class="summary-row ppf-total-summary-row govuk-!-margin-top-0 govuk-!-margin-bottom-0">

                @* Staff Costs *@
                <div class="govuk-form-group ppf-total-summary-item govuk-!-margin-bottom-0 govuk-!-margin-left-2">
                    <label class="govuk-label govuk-!-font-weight-bold sup_margin_0"
                           for="ppf-total-staff-costs">Staff Costs</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input text-AlignRight pva-input-185 @(Model.TotalStaffCosts < 0 ? "fps-profit-offtarget" : "")"
                               id="ppf-total-staff-costs"
                               type="text"
                               value="@formatTotal(Model.TotalStaffCosts)"
                               readonly />
                    </div>
                </div>

                @* Test Cost *@
                <div class="govuk-form-group ppf-total-summary-item govuk-!-margin-bottom-0 govuk-!-margin-left-2">
                    <label class="govuk-label govuk-!-font-weight-bold sup_margin_0"
                           for="ppf-total-test-cost">Test Cost</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input text-AlignRight pva-input-185 @(Model.TotalTestCost < 0 ? "fps-profit-offtarget" : "")"
                               id="ppf-total-test-cost"
                               type="text"
                               value="@formatTotal(Model.TotalTestCost)"
                               readonly />
                    </div>
                </div>

                @* Animal *@
                <div class="govuk-form-group ppf-total-summary-item govuk-!-margin-bottom-0 govuk-!-margin-left-2">
                    <label class="govuk-label govuk-!-font-weight-bold sup_margin_0"
                           for="ppf-total-animal">Animal</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input text-AlignRight pva-input-185 @(Model.TotalAnimalCosts < 0 ? "fps-profit-offtarget" : "")"
                               id="ppf-total-animal"
                               type="text"
                               value="@formatTotal(Model.TotalAnimalCosts)"
                               readonly />
                    </div>
                </div>

                @* Add Costs *@
                <div class="govuk-form-group ppf-total-summary-item govuk-!-margin-bottom-0 govuk-!-margin-left-2">
                    <label class="govuk-label govuk-!-font-weight-bold sup_margin_0"
                           for="ppf-total-add-costs">Add Costs</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input text-AlignRight pva-input-185 @(Model.TotalAdditionalCosts < 0 ? "fps-profit-offtarget" : "")"
                               id="ppf-total-add-costs"
                               type="text"
                               value="@formatTotal(Model.TotalAdditionalCosts)"
                               readonly />
                    </div>
                </div>

                @* Total Costs *@
                <div class="govuk-form-group ppf-total-summary-item govuk-!-margin-bottom-0 govuk-!-margin-left-2">
                    <label class="govuk-label govuk-!-font-weight-bold sup_margin_0"
                           for="ppf-total-total-costs">Total Costs</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input text-AlignRight pva-input-185 @(Model.TotalTotalCosts < 0 ? "fps-profit-offtarget" : "")"
                               id="ppf-total-total-costs"
                               type="text"
                               value="@formatTotal(Model.TotalTotalCosts)"
                               readonly />
                    </div>
                </div>

                @* Budget *@
                <div class="govuk-form-group ppf-total-summary-item govuk-!-margin-bottom-0 govuk-!-margin-left-2">
                    <label class="govuk-label govuk-!-font-weight-bold sup_margin_0"
                           for="ppf-total-budget">Budget</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input text-AlignRight pva-input-185 @(Model.TotalBudget < 0 ? "fps-profit-offtarget" : "")"
                               id="ppf-total-budget"
                               type="text"
                               value="@formatTotal(Model.TotalBudget)"
                               readonly />
                    </div>
                </div>

                @* Profit *@
                <div class="govuk-form-group ppf-total-summary-item govuk-!-margin-bottom-0 govuk-!-margin-left-2">
                    <label class="govuk-label govuk-!-font-weight-bold sup_margin_0"
                           for="ppf-total-profit">Profit</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input text-AlignRight pva-input-185 @(Model.TotalProfit < 0 ? "fps-profit-offtarget" : "")"
                               id="ppf-total-profit"
                               type="text"
                               value="@formatTotal(Model.TotalProfit)"
                               readonly />
                    </div>
                </div>

                @* Target Profit *@
                <div class="govuk-form-group ppf-total-summary-item govuk-!-margin-bottom-0 govuk-!-margin-left-2">
                    <label class="govuk-label govuk-!-font-weight-bold sup_margin_0"
                           for="ppf-total-target-profit">Target Profit</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input text-AlignRight pva-input-185 @(Model.TotalTargetProfit < 0 ? "fps-profit-offtarget" : "")"
                               id="ppf-total-target-profit"
                               type="text"
                               value="@formatTotal(Model.TotalTargetProfit)"
                               readonly />
                    </div>
                </div>

                @* Off-Target — fps-profit-offtarget CSS class applied when value is negative *@
                <div class="govuk-form-group ppf-total-summary-item govuk-!-margin-bottom-0 govuk-!-margin-left-2">
                    <label class="govuk-label govuk-!-font-weight-bold sup_margin_0"
                           for="ppf-total-off-target">Off-Target</label>
                    <div class="govuk-input__wrapper">
                        <div class="govuk-input__prefix" aria-hidden="true">£</div>
                        <input class="govuk-input text-AlignRight pva-input-185 @(Model.TotalOffTarget.HasValue && Model.TotalOffTarget.Value < 0 ? "fps-profit-offtarget" : "")"
                               id="ppf-total-off-target"
                               type="text"
                               value="@formatTotal(Model.TotalOffTarget)"
                               readonly />
                    </div>
                </div>

            </div>
        </div>

    </div>
</main>

@section Scripts {
    <script>
        // ── Grid reload ──────────────────────────────────────────────────────────
        //   GridId = "projectProfitabilityVlaGrid" (matches controller DataGridConfig).
        function reloadProjectProfitabilityVlaGrid() {
            var gm = window['gridManager_projectProfitabilityVlaGrid'];
            if (gm) {
                gm.reloadGrid({ page: 1 });
            }
        }

        // ── Extra filter method ──────────────────────────────────────────────────
        //   Returns the 4 filter values as query params to merge into the DataGrid AJAX POST body.
        //   Parameter names match controller LoadProjectProfitabilityVlaGrid action params exactly:
        //   projectStatus, programNo, manager, customer.
        function getProjectProfitabilityVlaExtraFilters() {
            return {
                projectStatus: document.getElementById('filterProjectStatus')?.value || '',
                programNo:     document.getElementById('filterProgram')?.value || '',
                manager:       document.getElementById('filterManager')?.value || '',
                customer:      document.getElementById('filterCustomer')?.value || ''
            };
        }

        // ── Clear filters ────────────────────────────────────────────────────────
        //   Mirrors projectprofitability_vla.js clearFilters() behaviour.
        function clearProjectProfitabilityVlaFilters() {
            ['filterProjectStatus', 'filterProgram', 'filterManager', 'filterCustomer'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) { el.value = ''; }
            });
            reloadProjectProfitabilityVlaGrid();
        }

        // ── Summary totals update ────────────────────────────────────────────────
        //   and updates the 9 ppf-total-* readonly inputs.
        //   Mirrors projectprofitability_vla.js updateSummary() + formatCurrency() behaviour.
        //   Called on page load and after every grid reload.
        function formatSummaryValue(value) {
            var numeric = Number(value) || 0;
            var absolute = Math.abs(numeric).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            return numeric < 0 ? '-(' + absolute + ')' : absolute;
        }

        // Negative totals are shown in red, matching the grid's accounting presentation.
        function setSummaryValue(elementId, value) {
            var el = document.getElementById(elementId);
            if (!el) { return; }
            el.value = formatSummaryValue(value);
            el.classList.toggle('fps-profit-offtarget', (Number(value) || 0) < 0);
        }

        function updateProjectProfitabilityVlaSummary() {
            var qs = new URLSearchParams({
                projectStatus: document.getElementById('filterProjectStatus')?.value || '',
                programNo:     document.getElementById('filterProgram')?.value || '',
                manager:       document.getElementById('filterManager')?.value || '',
                customer:      document.getElementById('filterCustomer')?.value || ''
            }).toString();

            $.getJSON('/FPS/ProjectProfitabilityVla/GetProjectProfitabilityVlaSummary?' + qs, function (data) {
                setSummaryValue('ppf-total-staff-costs', data.totalStaffCosts);
                setSummaryValue('ppf-total-test-cost', data.totalTestCost);
                setSummaryValue('ppf-total-animal', data.totalAnimalCosts);
                setSummaryValue('ppf-total-add-costs', data.totalAdditionalCosts);
                setSummaryValue('ppf-total-total-costs', data.totalTotalCosts);
                setSummaryValue('ppf-total-budget', data.totalBudget);
                setSummaryValue('ppf-total-profit', data.totalProfit);
                setSummaryValue('ppf-total-target-profit', data.totalTargetProfit);
                setSummaryValue('ppf-total-off-target', data.totalOffTarget);
            });
        }

        // ── Initialise on page load ──────────────────────────────────────────────
        $(document).ready(function () {
            // Trigger initial grid data load via AJAX (Index() returns empty Data; grid
            // must fetch its first page through the LoadProjectProfitabilityVlaGrid endpoint).
            reloadProjectProfitabilityVlaGrid();

            // Fetch initial summary totals in parallel with the grid load.
            updateProjectProfitabilityVlaSummary();

            // Refresh summary totals after every DataGrid reload.
            // _DataGrid dispatches 'gridReloaded' on document itself (not on a child element),
            // so the listener must be a direct document handler — NOT a delegated selector.
            $(document).on('gridReloaded', function () {
                updateProjectProfitabilityVlaSummary();
            });
        });
    </script>
}
