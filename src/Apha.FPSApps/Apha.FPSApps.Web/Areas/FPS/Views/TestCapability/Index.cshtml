@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.TestCapabilityViewModel

@{
    ViewData["Title"] = "FPS : Set Up Portfolio Components";
}

@* Page Title with the Portfolio selector inline (matches the MS Access layout) *@
<div class="govuk-grid-row sup_border-bottom govuk-!-margin-bottom-3">
    <div class="govuk-grid-column-one-full govuk-!-margin-bottom-3">
        <div class="portfolio-heading-row">
            <h1 class="govuk-heading-s govuk-!-margin-bottom-0 govuk-!-margin-top-3 govuk-!-margin-left-6 isCustomPageHeadings">
                Test Capabilities within..&nbsp;<span id="portfolioHeadingCode"></span>
            </h1>

            <div class="portfolio-select-inline govuk-!-margin-right-6 govuk-!-margin-top-3">
                <label for="portfolioDisplay" class="govuk-label govuk-!-font-weight-bold govuk-!-margin-bottom-0 isNoWrap">
                    Select a Portfolio:
                </label>
                <div class="portfolio-select-control">
                    <input type="text" id="portfolioDisplay" placeholder="Select Portfolio" autocomplete="off"
                           class="govuk-input govuk-!-font-size-16 down-arrow-img" style="width:100%; cursor:pointer;" readonly
                           onclick="togglePortfolioPanel()" />
                    <div id="PortfolioDropdownPanel" style="display:none; position:absolute; top:100%; left:0; width:100%;
                            max-height:260px; overflow-y:auto; background:#fff; border:1px solid #b1b4b6;
                            box-shadow:0 4px 8px rgba(0,0,0,.2); z-index:2000;">
                        <label for="PortfolioSearchBox" class="govuk-visually-hidden">Type to search portfolio</label>
                        <input type="text" id="PortfolioSearchBox" placeholder="Type to search portfolio..."
                               style="width:100%; padding:6px 8px; border:0; border-bottom:1px solid #b1b4b6; outline:none; box-sizing:border-box;"
                               oninput="filterPortfolioPanel(this.value)" />
                        <table style="width:100%; border-collapse:collapse; font-size:14px;">
                            <thead style="background:#f3f2f1; position:sticky; top:0; z-index:10;">
                                <tr>
                                    <th style="padding:6px 8px; text-align:left;">Portfolio</th>
                                    <th style="padding:6px 8px; text-align:left;">Description</th>
                                </tr>
                            </thead>
                            <tbody id="PortfolioDropdownBody">
                                @foreach (var item in Model.PortfolioOptions.Where(o => !string.IsNullOrEmpty(o.Value)))
                                {
                                    var sepIdx = item.Text.IndexOf(" \u2013 ");
                                    var pCode = sepIdx >= 0 ? item.Text.Substring(0, sepIdx).Trim() : item.Value;
                                    var pDesc = sepIdx >= 0 ? item.Text.Substring(sepIdx + 3).Trim() : string.Empty;
                                    <tr data-portfolio="@item.Value" data-code="@pCode" data-description="@pDesc"
                                        tabindex="0"
                                        onclick="selectPortfolio('@item.Value', '@Html.Raw(pCode.Replace("'", "\\'"))', '@Html.Raw(pDesc.Replace("'", "\\'"))', this)"
                                        onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); selectPortfolio('@item.Value', '@Html.Raw(pCode.Replace("'", "\\'"))', '@Html.Raw(pDesc.Replace("'", "\\'"))', this); }"
                                        style="cursor:pointer;">
                                        <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@pCode</td>
                                        <td style="padding:6px 8px; border-bottom:1px solid #f3f2f1;">@pDesc</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Portfolio Description: label, text area and action button all on one line *@
<div class="govuk-grid-row sup_margin_left_right_0 sup_padding_bottom_10 sup_border-bottom" style="margin-top:10px;">
    <div class="govuk-grid-column-full">
        <input type="hidden" id="portfolioPick" value="" />
        <input type="hidden" id="portfolioDescription" value="" />

        <div class="portfolio-description-section">
            <label for="portfolioDescriptionDisplay" class="govuk-label govuk-!-font-weight-bold portfolio-description-label">
                Portfolio Description:
            </label>
            <textarea id="portfolioDescriptionDisplay" readonly rows="2"
                      class="govuk-textarea govuk-!-font-size-16 portfolio-description-text"
                      aria-label="Portfolio description"></textarea>
            <button class="govuk-button govuk-!-margin-bottom-0 portfolio-description-action" type="button"
                    onclick="editPortfolioDetails()">
                Edit Portfolio Details
            </button>
        </div>
    </div>
</div>

@* Grid *@
<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10">
    <div class="govuk-grid-column-full">
        <div id="gridContainer_testCapabilityGrid">
            @await Html.PartialAsync("_DataGrid", Model.TestCapabilityGrid)
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Scoped to this page so other FPS/PACT screens are unaffected. */

        /* Heading and the Portfolio selector sit on one line, with the selector
           pushed to the right as in the MS Access form. */
        .portfolio-heading-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            flex-wrap: wrap;
        }

        .portfolio-select-inline {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 3px;
        }

        /* Anchors the absolutely positioned dropdown panel. */
        .portfolio-select-control {
            position: relative;
            width: 220px;
        }

        /* Label, 2-line text area and button all share one line. */
        .portfolio-description-section {
            display: flex;
            align-items: stretch;
            gap: 15px;
        }

        .portfolio-description-label {
            flex: 0 0 auto;
            align-self: center;
            margin-bottom: 0;
        }

        /* Two-line read-only description, matching the MS Access layout. Longer
           text wraps and scrolls instead of being truncated. */
        .portfolio-description-text {
            flex: 1 1 auto;
            min-width: 0;
            background-color: #f3f2f1;
            cursor: default;
            resize: vertical;
            overflow-y: auto;
            margin-bottom: 0;
        }

        /* Button matches the full height of the 2-line description area. */
        .portfolio-description-action {
            flex: 0 0 auto;
            align-self: stretch;
            white-space: nowrap;
        }

        @@media (max-width: 640px) {
            .portfolio-heading-row,
            .portfolio-description-section {
                flex-direction: column;
                align-items: stretch;
            }

            .portfolio-select-control {
                width: 100%;
            }
        }
    </style>
}

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        var currentPortfolio = '';

        // ── Filter ────────────────────────────────────────────────────────────

        function onPortfolioChange(portfolio, desc) {
            currentPortfolio = portfolio;

            $('#portfolioPick').val(portfolio || '');
            $('#portfolioDescription').val(portfolio ? (desc || '') : '');

            window['gridManager_testCapabilityGrid'].reloadGrid({ page: 1 });
        }

        // ── Portfolio panel dropdown ──────────────────────────────────────────

        function togglePortfolioPanel() {
            var panel = document.getElementById('PortfolioDropdownPanel');
            if (!panel) return;
            var isOpen = panel.style.display !== 'none';
            panel.style.display = isOpen ? 'none' : 'block';
            if (!isOpen) {
                var searchBox = document.getElementById('PortfolioSearchBox');
                if (searchBox) { searchBox.value = ''; filterPortfolioPanel(''); searchBox.focus(); }
            }
        }

        function filterPortfolioPanel(query) {
            var rows = document.querySelectorAll('#PortfolioDropdownBody tr');
            var q = (query || '').toLowerCase();
            rows.forEach(function (row) {
                var code = (row.getAttribute('data-code') || '').toLowerCase();
                var desc = (row.getAttribute('data-description') || '').toLowerCase();
                row.style.display = (!q || code.indexOf(q) !== -1 || desc.indexOf(q) !== -1) ? '' : 'none';
            });
        }

        function selectPortfolio(portfolio, code, desc, rowEl) {
            var display = document.getElementById('portfolioDisplay');
            if (display) display.value = code;

            var descDisplay = document.getElementById('portfolioDescriptionDisplay');
            if (descDisplay) descDisplay.value = desc || '';

            // Append the selected portfolio code to the page heading. textContent is
            // used so the code is never treated as markup.
            var headingCode = document.getElementById('portfolioHeadingCode');
            if (headingCode) headingCode.textContent = code || '';

            var panel = document.getElementById('PortfolioDropdownPanel');
            if (panel) panel.style.display = 'none';

            onPortfolioChange(portfolio, desc);
        }

        // Close panel when clicking outside
        $(document).on('click', function (e) {
            if (!$(e.target).closest('#PortfolioDropdownPanel, #portfolioDisplay').length) {
                var panel = document.getElementById('PortfolioDropdownPanel');
                if (panel) panel.style.display = 'none';
            }
        });

        function getTestCapabilityExtraFilters() {
            return { portfolio: currentPortfolio };
        }

        // ── Navigation ────────────────────────────────────────────────────────

        function editPortfolioDetails() {
            if (!currentPortfolio) {
                showAlertMessage('Please select a Portfolio first.', AlertType.INFO);
                return;
            }
            window.location.href = '/FPS/PortfolioNew/Index?parentProject=' + encodeURIComponent(currentPortfolio);
        }

        // ── CRUD ──────────────────────────────────────────────────────────────

        function addTestCapability() {
            if (!currentPortfolio) {
                showAlertMessage('Please select a Portfolio first.', AlertType.INFO);
                return;
            }
            $.get('/FPS/TestCapability/CreateTestCapability', { portfolio: currentPortfolio }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            }).fail(function () {
                showAlertMessage('An error occurred while loading the form.', AlertType.ERROR);
            });
        }

        function editTestCapability(btn) {
            var testCode = $(btn).data('id');
            var workGroup = $(btn).closest('tr').find('td[data-property="WorkGroup"] span').text().trim();
            $.get('/FPS/TestCapability/EditTestCapability', { testCode: testCode, workGroup: workGroup }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            }).fail(function () {
                showAlertMessage('An error occurred while loading the edit form.', AlertType.ERROR);
            });
        }

        function deleteTestCapability(btn) {
            var testCode = $(btn).data('id');
            var workGroup = $(btn).closest('tr').find('td[data-property="WorkGroup"] span').text().trim();
            showGovukConfirm('Are you sure you want to delete this Portfolio Component?').then(function (result) {
                if (!result) return;
                $.ajax({
                    url: '/FPS/TestCapability/DeleteTestCapability',
                    type: 'DELETE',
                    data: { testCode: testCode, workGroup: workGroup },
                    success: function (response) {
                            if (response.success) {
                                showAlertMessage('Record deleted successfully.', AlertType.SUCCESS).then(function () {
                                    window['gridManager_testCapabilityGrid'].reloadGrid({ page: 1 });
                                });
                        } else {
                            showAlertMessage(response.message || 'Failed to delete entry.', AlertType.ERROR);
                        }
                    },
                    error: function () {
                        showAlertMessage('An error occurred while deleting.', AlertType.ERROR);
                    }
                });
            });
        }

        function saveTestCapability() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#testCapabilityForm');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var isEdit = form.data('mode') === 'edit';
            var url = isEdit
                ? '/FPS/TestCapability/EditTestCapability'
                : '/FPS/TestCapability/CreateTestCapability';

            var formData = {};
            form.serializeArray().forEach(function (item) {
                formData[item.name] = item.value;
            });

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (result) {
                    if (result.success) {
                        closeModal();
                        showAlertMessage(result.message || 'Record saved successfully.', AlertType.SUCCESS);
                        window['gridManager_testCapabilityGrid'].reloadGrid({ page: 1 });
                    } else {
                        displayServerValidationErrors(result.errors, result.message, '#modaPopupBody');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showAlertMessage('An error occurred while saving.', AlertType.ERROR);
                    }
                }
            });
        }

        function closeModal() {
            clearValidationErrors('#modaPopupBody');
            $('#modaPopupBody').html('');
            $('#modalPopup').removeClass('show');
        }
    </script>
}
