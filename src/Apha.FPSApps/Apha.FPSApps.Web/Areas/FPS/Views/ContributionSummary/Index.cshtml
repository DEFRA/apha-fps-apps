@model Apha.FPSApps.Web.Areas.FPS.Models.ContributionSummaryViewModel

@{
    ViewData["Title"] = "Income/Contribution from Time Sales";
}

@* ── Header row ── *@
<div class="govuk-grid-row sup_margin_left_right_0 sup_padding_bottom_10 sup_border-bottom" style="margin-top:10px; align-items:flex-end;">

    <div class="govuk-grid-column-one-third">
        <h1 class="govuk-heading-s sup_margin_bottom_0">Income / Contribution from Time Sales</h1>
    </div>

    @* Selling PC dropdown *@
    <div class="govuk-grid-column-one-quarter">
        <label class="govuk-label govuk-!-font-size-16 govuk-!-font-weight-bold" for="sellingPcDisplay">
            Resource Center
        </label>
        <div style="position:relative; z-index:50;">
            <input type="text" id="sellingPcDisplay" placeholder="Select Resource Center" autocomplete="off"
                   class="govuk-input govuk-!-font-size-16 down-arrow-img"
                   style="width:100%; cursor:pointer;" readonly />
            <div id="sellingPcPanel" style="display:none; position:absolute; top:100%; left:0; width:200px;
                 max-height:260px; overflow-y:auto; background:#fff; border:1px solid #b1b4b6;
                 box-shadow:0 4px 8px rgba(0,0,0,.2); z-index:2000;">
                <input type="text" id="sellingPcSearch" placeholder="Search..."
                       style="width:100%; padding:6px 8px; border:0; border-bottom:1px solid #b1b4b6;
                              outline:none; box-sizing:border-box;" />
                <ul id="sellingPcList" style="list-style:none; margin:0; padding:0;">
                    @foreach (var pc in Model.SellingProfitCentres)
                    {
                        <li data-value="@pc.Value"
                            style="padding:6px 10px; cursor:pointer; font-size:14px; border-bottom:1px solid #f3f2f1;">
                            @pc.Text
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@* ── Prompt shown before any PC is selected ── *@
<div id="contributionSummaryPrompt" style="margin-top:16px;">
    <div class="govuk-inset-text">
        <p class="govuk-body">Select a Selling PC above to view the Income / Contribution from Time Sales data.</p>
    </div>
</div>

@* ── Grid + totals — both inside the same column, matching the reference panel layout ── *@
<div id="contributionSummaryGridArea" style="display:none; margin-top:16px;">
    <div class="govuk-grid-row sup_margin_left_right_0">
        <div class="govuk-grid-column-full">
            <section class="fps-cs-panel sup_border" aria-label="Income contribution summary panel">
                <div id="gridContainer_contributionSummaryGrid"></div>
                <div id="contributionSummaryTotalsArea"></div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentSellingPc = null;
        var contributionGridId = 'contributionSummaryGrid';

        // Called by the DataGrid component on every page/sort/filter reload
        function getContributionSummaryExtraFilters() {
            return {};  // sellingPc is baked into BindGridUrl by the controller
        }

        // ── Selling PC dropdown ────────────────────────────────────────────

        function initSellingPcDropdown() {
            var $display = $('#sellingPcDisplay');
            var $panel   = $('#sellingPcPanel');
            var $search  = $('#sellingPcSearch');
            var $items   = $('#sellingPcList li');

            $display.on('click', function (e) {
                e.stopPropagation();
                $panel.toggle();
                if ($panel.is(':visible')) {
                    $search.val('').trigger('input').focus();
                }
            });

            $search.on('click', function (e) { e.stopPropagation(); });

            $search.on('input', function () {
                var term = $(this).val().toLowerCase();
                $items.each(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(term) > -1);
                });
            });

            $items.on('click', function () {
                currentSellingPc = $(this).data('value');
                $display.val($(this).text().trim());
                $panel.hide();
                loadContributionData(currentSellingPc);
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('#sellingPcDisplay, #sellingPcPanel').length) {
                    $panel.hide();
                }
            });
        }

        // ── Grid + totals load ─────────────────────────────────────────────

        function loadContributionData(sellingPc) {
            $('#contributionSummaryPrompt').hide();
            $('#contributionSummaryGridArea').show();
            $('#contributionSummaryTotalsArea').empty();

            $.ajax({
                url: '@Url.Action("LoadData", "ContributionSummary", new { area = "FPS" })',
                type: 'POST',
                data: { sellingPc: sellingPc, Filter: '{}', SortBy: '', Descending: false, Page: 1, PageSize: 10 },
                success: function (html) {
                    $('#gridContainer_' + contributionGridId).html(html);
                    refreshTotals(sellingPc);
                },
                error: function () {
                    $('#gridContainer_' + contributionGridId).html(
                        '<div class="govuk-error-message" style="padding:12px;">Failed to load data. Please try again.</div>'
                    );
                }
            });
        }

        function refreshTotals(sellingPc) {
            $.get('@Url.Action("LoadTotals", "ContributionSummary", new { area = "FPS" })',
                { sellingPc: sellingPc || currentSellingPc },
                function (html) { $('#contributionSummaryTotalsArea').html(html); }
            );
        }

        // ── Init ───────────────────────────────────────────────────────────

        $(document).ready(function () {
            initSellingPcDropdown();
        });
    </script>
}
