<div class="modal-header flex-space-center">
    <h3 class="modal-title" style="margin: 0;" id="exampleModalLabel">Update Staff Booked</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>
<div class="modal-body" style="padding-top: 5px;">
    <form class="row" id="formAddStaff">
        <div class="col-12">
            <label for="modal-staffname" class="form-label p-0">Staff Name:</label>
            <select id="modal-staffname" name="" class="form-select" aria-label="StaffName">
                <option value=""></option>
                <option value="Staff_001,General">Staff_001,General | Staff_001 | 0</option>
                <option value="Staff_002,General">Staff_002,General | Staff_002 | 0</option>
                <option value="Staff_003,General">Staff_003,General | Staff_003 | 0</option>
                <option value="Staff_004,General">Staff_004,General | Staff_004 | 0</option>
                <option value="Staff_005,General">Staff_005,General | Staff_005 | 0</option>
                <option value="Staff_006,General">Staff_006,General | Staff_006 </option>
            </select>
        </div>
        <div class="col-12">
            <label for="modal-rate" class="form-label">Rate:</label>
            <input type="text" class="form-control" id="modal-rate">
        </div>
        <div class="col-12">
            <label for="modal-hrs" class="form-label">Hrs</label>
            <input type="text" class="form-control" id="modal-hrs">
        </div>
        <div class="col-12">
            <label for="modal-days" class="form-label">Days</label>
            <input type="text" class="form-control" id="modal-days">
        </div>
        <div class="col-12">
            <label for="modal-staffcost" class="form-label">Staff Cost</label>
            <input type="text" class="form-control" id="modal-staffcost">
        </div>
    </form>
</div>
<div class="modal-footer">
    <button class="btnCancel" onclick="closeModal()">Cancel</button>
    <button class="btnBlue" id="modalsaveBtn">Save</button>
    <button class="btnBlue" id="updateBtn" style="display: none;">Update</button>
</div>