@model Apha.FPSApps.Web.Areas.FPS.Models.StaffJobItem

<div class="modal-header flex-space-center">
    <h3 class="modal-title" style="margin: 0;" id="exampleModalLabel">Add Staff Booked</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>
<div class="modal-body" style="padding-top: 5px;">
    <div asp-validation-summary="ModelOnly" class="govuk-error-summary" role="alert" aria-labelledby="error-summary-title" tabindex="-1">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
            </ul>
        </div>
    </div>
    <form class="row" id="formAddStaff">
        <input type="hidden" asp-for="StaffID" id="StaffID" />
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="StaffDropdown" class="govuk-label p-0">Staff Name:</label>
                <select id="StaffDropdown" name="StaffDropdown" required class="govuk-select" onchange="onStaffSelected(this)">
                    <option value="">-- Select Staff --</option>
                    @if (Model.StaffList != null)
                    {
                        foreach (var staff in Model.StaffList)
                        {
                            <option value="@staff.Value" data-name="@staff.Text">@staff.Text</option>
                        }
                    }
                </select>
                <span asp-validation-for="StaffID" class="text-danger" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="ChargeRate" class="govuk-label" asp-for="ChargeRate">Rate:</label>
                <input type="number" step="0.01" asp-for="ChargeRate" required class="govuk-input" id="ChargeRate">
                <span asp-validation-for="ChargeRate" class="text-danger" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="PlannedHours" class="govuk-label" asp-for="PlannedHours">Hrs</label>
                <input type="number" step="0.01" asp-for="PlannedHours" required class="govuk-input" id="PlannedHours">
                <span asp-validation-for="PlannedHours" class="text-danger" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="Days" class="govuk-label" asp-for="Days">Days</label>
                <input type="number" step="0.01" asp-for="Days" required class="govuk-input" id="Days">
                <span asp-validation-for="Days" class="text-danger" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="StaffCost" class="govuk-label" asp-for="StaffCost">Staff Cost</label>
                <input type="number" step="0.01" asp-for="StaffCost" required class="govuk-input" id="StaffCost">
                <span asp-validation-for="StaffCost" class="text-danger" style="display:none;"></span>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button class="govuk-button govuk-button--secondary sup_margin_0" data-module="govuk-button" onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" data-module="govuk-button" onclick="saveStaffJob()">Save</button>
</div>