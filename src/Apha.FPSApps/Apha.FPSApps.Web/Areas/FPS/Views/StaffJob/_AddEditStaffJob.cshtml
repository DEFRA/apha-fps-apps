@model Apha.FPSApps.Web.Areas.FPS.Models.StaffJobItemViewModel
@{
    var isEditMode = !string.IsNullOrEmpty(Model.StaffID);
    var title      = isEditMode ? "Update Staff Booked" : "Add Staff Booked";
    var formId     = isEditMode ? "formEditStaff"       : "formAddStaff";
    var saveLabel  = isEditMode ? "Update"              : "Save";
    var saveAction = isEditMode ? "updateStaffJob()"    : "saveStaffJob()";
}

<div class="modal-header flex-space-center">
    <h3 class="modal-title" style="margin: 0;" id="exampleModalLabel">@title</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>
<div class="modal-body" style="padding-top: 5px;">
    <div asp-validation-summary="ModelOnly" class="govuk-error-summary" role="alert"
         aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list">
            </ul>
        </div>
    </div>
    <form class="row" id="@formId">
        <input type="hidden" asp-for="StaffID" id="StaffID" />
        @if (isEditMode)
        {
            <input type="hidden" asp-for="JobCode" />
        }
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="Name" class="govuk-label p-0">Staff Name:</label>
                <select id="Name" name="Name" required class="govuk-select" onchange="onStaffSelected(this)">
                    <option value="">-- Select Staff --</option>
                    @if (Model.StaffList != null)
                    {
                        foreach (var staff in Model.StaffList)
                        {
                            var isSelected = isEditMode && staff.Value == Model.StaffID;
                            <option value="@staff.Value" data-name="@staff.Text"
                                    selected="@(isSelected ? "selected" : null)">@staff.Text</option>
                        }
                    }
                </select>
                <span asp-validation-for="Name" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="ChargeRate" class="govuk-label" asp-for="ChargeRate">Rate:</label>
                <input type="number" step="0.01" asp-for="ChargeRate" class="govuk-input" id="ChargeRate">
                <span asp-validation-for="ChargeRate" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="PlannedHours" class="govuk-label" asp-for="PlannedHours">Hrs</label>
                <input type="number" step="0.01" asp-for="PlannedHours" class="govuk-input" id="PlannedHours">
                <span asp-validation-for="PlannedHours" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="Days" class="govuk-label" asp-for="Days">Days</label>
                <input type="number" step="0.01" asp-for="Days" class="govuk-input" id="Days">
                <span asp-validation-for="Days" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="StaffCost" class="govuk-label" asp-for="StaffCost">Staff Cost</label>
                <input type="number" step="0.01" asp-for="StaffCost" class="govuk-input" id="StaffCost">
                <span asp-validation-for="StaffCost" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button class="govuk-button govuk-button--secondary sup_margin_0" data-module="govuk-button" onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" data-module="govuk-button" type="button" onclick="@saveAction">@saveLabel</button>
</div>
