@model string
@{
    ViewData["Title"] = "Access Denied";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-s sup_border-bottom govuk-!-margin-top-2
                    govuk-!-padding-bottom-2 govuk-!-padding-left-4">
            Access Denied
        </h1>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds govuk-!-padding-left-4">

        <div class="govuk-warning-text govuk-!-margin-top-4 govuk-!-margin-bottom-4">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                You do not have the required roles to access or perform this functionality.
            </strong>
        </div>

        <p class="govuk-body">
            If you believe this is incorrect, please contact your system administrator.
        </p>

        <a href="javascript:history.back()" class="govuk-button govuk-button--secondary">
            Back
        </a>

    </div>
</div>
