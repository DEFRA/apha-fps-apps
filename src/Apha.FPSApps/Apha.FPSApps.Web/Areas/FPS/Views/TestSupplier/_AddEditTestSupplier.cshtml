@model Apha.FPSApps.Web.Areas.FPS.Models.TestSupplierItem

<div class="modal-header">
    <h5 class="modal-title">Edit Test Supplier</h5>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>

<div class="modal-body" style="overflow-y: auto; max-height: calc(80vh - 120px);">
    <div class="govuk-error-summary" role="alert" aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list"></ul>
        </div>
    </div>

    <form id="testSupplierForm">
        <input type="hidden" id="hdnTestCode" value="@Model?.TestCode" />
        <input type="hidden" id="hdnProjectBuyerCode" value="@Model?.ProjectBuyerCode" />
        <input type="hidden" id="hdnTestBuyerCode" value="@Model?.TestBuyerCode" />

        <div class="row g-3">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="Buyer">Project (Buyer) <span class="sup_color_red">*</span></label>
                <input type="text" class="govuk-input" maxlength="20" asp-for="Buyer" readonly />
                <span asp-validation-for="Buyer" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="ProjectManager">Project Manager</label>
                <input type="text" class="govuk-input" asp-for="ProjectManager" readonly />
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="NoTests">No Tests</label>
                <input type="number" class="govuk-input" min="0" step="1" asp-for="NoTests"
                       id="NoTests" readonly />
                <span asp-validation-for="NoTests" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="TestPrice">Test Price (£)</label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="number" class="govuk-input text-AlignRight" min="0" step="0.01"
                           asp-for="TestPrice" id="TestPrice" oninput="recalcTestCost()" />
                </div>
                <span asp-validation-for="TestPrice" class="govuk-error-message" style="display:none;"></span>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="TestCost">Test Cost (£)</label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="text" class="govuk-input text-AlignRight" asp-for="TestCost"
                           id="TestCost" readonly />
                </div>
            </div>

            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label" asp-for="ProjectStatus">Project Status</label>
                <select class="govuk-select" asp-for="ProjectStatus" asp-items="Model!.ProjectStatusOptions" disabled>
                    <option value="">-- Select --</option>
                </select>
            </div>
        </div>
    </form>
</div>

<div class="modal-footer sup_flex_space_center">
    <button class="govuk-button govuk-button--secondary sup_margin_0" data-module="govuk-button" onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" data-module="govuk-button" onclick="saveTestSupplier()">Update</button>
</div>

<script>
    function recalcTestCost() {
        var noTests = parseFloat(document.getElementById('NoTests').value) || 0;
        var testPrice = parseFloat(document.getElementById('TestPrice').value) || 0;
        var testCost = (noTests * testPrice).toFixed(2);
        document.getElementById('TestCost').value = testCost;
    }

    // Initialise on load
    recalcTestCost();
</script>
