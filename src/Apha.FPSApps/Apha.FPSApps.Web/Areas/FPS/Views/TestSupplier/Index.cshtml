@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.TestSupplierViewModel

@{
    ViewData["Title"] = "FPS : Test Supplier";
}



<div class="govuk-grid-row sup_border-bottom isTestSupplierPage">
    <div class="govuk-grid-column-one-half isFloatLeft">
        <h1 class="govuk-heading-s sup_margin_bottom_0 govuk-!-margin-top-3 govuk-!-padding-left-3">
            Test Suppliers View (Who is Buying TestX?)
        </h1>
    </div>
    <div class="govuk-grid-column-one-half isFloatRight isBudgetBidsQuery">
        <div class="test-select-inline govuk-!-margin-top-3 govuk-!-margin-bottom-2 govuk-!-margin-right-3">
            <label class="govuk-label govuk-!-font-size-16 govuk-!-font-weight-bold govuk-!-margin-bottom-0 isNoWrap" for="testCodePick">
                Select a Test:
            </label>
            <div class="test-select-control">
                <div id="testCodePickMultiDropdown"></div>
                <input type="hidden" id="testCodePick" value="@Model.SelectedTestCode" />
            </div>
        </div>
    </div>
</div>

@* Grid *@
<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10">
    <div class="govuk-grid-column-full">
        <div id="gridContainer_testSupplierGrid">
            @await Html.PartialAsync("_DataGrid", Model.TestSupplierGrid)
        </div>
        <div class="fps-summary-row">
            <div class="govuk-form-group govuk-!-margin-bottom-0">
                <label class="govuk-label govuk-label--s govuk-!-margin-bottom-0" for="totalTests">Total Tests</label>
                <input type="text" id="totalTests" class="govuk-input fps-summary-input" value="0.00" readonly aria-label="Total tests" />
            </div>
            <div class="govuk-form-group govuk-!-margin-bottom-0">
                <label class="govuk-label govuk-label--s govuk-!-margin-bottom-0" for="totalTestCost">Total Cost</label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                <input type="text" id="totalTestCost" class="govuk-input fps-summary-input" value="£0.00" readonly aria-label="Total test cost" />
            </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/common/multicolumn-dropdown.css" />
    <style>
        /* Scoped to this page only so PACT and other apps are unaffected.
           Mirrors the "Select a Portfolio" layout on the Test Capability page. */

        /* Label and control sit on one line, pushed to the right. */
        .isTestSupplierPage .test-select-inline {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            min-width: 0;
            max-width: 100%;
        }

        .isTestSupplierPage .isNoWrap {
            white-space: nowrap;
        }

        /* Anchors the absolutely positioned dropdown panel. */
        .isTestSupplierPage .test-select-control {
            position: relative;
            width: 220px;
            max-width: 100%;
            flex: 0 1 220px;
        }

        #testCodePickMultiDropdown {
            width: 100%;
        }

            #testCodePickMultiDropdown .dropdown-input.down-arrow-img {
                width: 100%;
                padding-right: 34px;
                text-overflow: ellipsis;
                white-space: nowrap;
                overflow: hidden;
            }

            /* The component sets position:relative inline on this container when
               the panel opens, so the panel anchors here. Declare it up front so
               the anchor is correct on first paint too. */
            #testCodePickMultiDropdown {
                position: relative;
            }

            /* The inner wrapper must not become the anchor, otherwise the panel
               is positioned against the flex input-group instead of the control. */
            #testCodePickMultiDropdown .tableselectdropdown {
                position: static;
            }

            /* The panel is wider than its 220px anchor, so it is pinned to the
               anchor's right edge and grows leftwards, keeping it on-page.
               min-width must be reset: the shared component sets min-width:100%
               together with width:max-content, which is what pushed the panel
               past the right border. */
            #testCodePickMultiDropdown .multicolumn-dropdown-panel {
                top: 100%;
                right: 0 !important;
                left: auto !important;
                margin: 0;
                width: 420px;
                min-width: 0;
                max-width: calc(100vw - 40px);
                box-sizing: border-box;
            }

                #testCodePickMultiDropdown .multicolumn-dropdown-panel table {
                    width: 100%;
                    table-layout: fixed;
                    border-collapse: collapse;
                }

                #testCodePickMultiDropdown .multicolumn-dropdown-panel th,
                #testCodePickMultiDropdown .multicolumn-dropdown-panel td {
                    padding: 6px 8px;
                    text-align: left;
                    vertical-align: top;
                    word-break: break-word;
                }

                /* The shared component reserves the first column for a serial
                   number (60px fixed). This dropdown has no serial number
                   column, so ItemCode takes a proportional share instead. */
                #testCodePickMultiDropdown .dropdown-table-wrapper thead th:first-child,
                #testCodePickMultiDropdown .dropdown-table-wrapper tbody td:first-child {
                    width: 40%;
                    min-width: 0;
                    max-width: none;
                    white-space: normal;
                    overflow: visible;
                    text-overflow: clip;
                    text-align: left;
                }

                /* Description takes the remaining width and wraps if needed. */
                #testCodePickMultiDropdown .multicolumn-dropdown-panel th:last-child,
                #testCodePickMultiDropdown .multicolumn-dropdown-panel td:last-child {
                    width: 60%;
                    white-space: normal;
                    overflow-wrap: anywhere;
                }
    </style>
}

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/common/multicolumn-dropdown.component.js"></script>
    <script>
    var currentTestCode = '@Model.SelectedTestCode';
    var currentShowRejected = @Model.ShowRejected.ToString().ToLower();
    var testCodeSelectDropdown = null;
    const testCodeOptionsListData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TestCodeList));

    $(function () {
        initializeTestCodeMultiColumnDropdown();
        calculateTotals();
    });

    // Multi-column dropdown for Test selection (consistent with other lookup screens).
    function initializeTestCodeMultiColumnDropdown() {
        testCodeSelectDropdown = new MultiColumnDropdownComponent({
            dropdownId: 'testCodePickDropdown',
            containerSelector: '#testCodePickMultiDropdown',
            placeholder: 'Select a Test',
            showSerialNumber: false,
            searchPlaceholder: 'Search by Test',
            labelText: '',
            columns: [
                { field: 'Value', header: 'ItemCode' },
                { field: 'Text', header: 'ItemDescription' }
            ],
            data: testCodeOptionsListData,
            // Show the Test code in the closed control; the description remains
            // visible as a column inside the dropdown panel.
            displayField: 'Value',
            valueField: 'Value',
            showClearButton: false,

            callbacks: {
                onSelect: function (selectedItem) {
                    $('#testCodePick').val(selectedItem.Value);
                    onTestCodeChange(selectedItem.Value);
                }
            }
        });

        // Preserve the selected value after reloads so the dropdown stays consistent.
        if (currentTestCode) {
            testCodeSelectDropdown.setValue(currentTestCode);
        }
    }

    // Extra filters merged into the grid's own sort/filter/pagination requests.
    function getTestSupplierExtraFilters() {
        return {
            testCode: currentTestCode,
            showRejected: currentShowRejected
        };
    }

    // Recalculate totals after the grid reloads itself (sort/filter/pagination).
    document.addEventListener('gridReloaded', function (e) {
        if (e.detail && e.detail.gridId === 'testSupplierGrid') {
            calculateTotals();
        }
    });

    // ── Filter changes ────────────────────────────────────────────────────────

    function onTestCodeChange(testCode) {
        currentTestCode = testCode;
        reloadGrid();
    }

    function onShowRejectedChange(checked) {
        currentShowRejected = checked;
        reloadGrid();
    }

    function reloadGrid() {
        var request = {
            Page: 1,
            PageSize: 10,
            SortBy: '',
            Descending: false,
            Filter: '{}',
            testCode: currentTestCode,
            showRejected: currentShowRejected
        };
        $.post('/FPS/TestSupplier/LoadTestSupplierGrid', request, function (html) {
            $('#gridContainer_testSupplierGrid').html(html);
            calculateTotals();
        });
    }

    // Totals always represent the entire dataset for the selected test and must NOT
    // change with pagination, sorting, or filtering. They are computed server-side.
    function calculateTotals() {
        if (!currentTestCode) {
            $('#totalTests').val('0.00');
            $('#totalTestCost').val('0.00');
            return;
        }

        $.get('/FPS/TestSupplier/GetTestSupplierTotals', {
            testCode: currentTestCode,
            showRejected: currentShowRejected
        }, function (result) {
            if (result && result.success) {
                var totalTests = parseFloat(result.totalTests) || 0;
                var totalCost = parseFloat(result.totalCost) || 0;
                $('#totalTests').val(totalTests.toFixed(2));
                $('#totalTestCost').val(totalCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            }
        });
    }
</script>
}
