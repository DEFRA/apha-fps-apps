@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.TestSupplierViewModel

@{
    ViewData["Title"] = "FPS : Test Supplier";
}

@* Page Title *@
<div class="govuk-grid-row sup_margin_left_right_0">
    <div class="govuk-grid-column-full">
        <h1 class="heading_with_txtbox govuk-heading-s sup_border-bottom sup_margin_bottom_10">
            <div class="sup_flex_left_center">Test Supplier</div>
        </h1>
    </div>
</div>

@* Filter Header: Select Test Code + Show Rejected toggle *@
<div class="govuk-grid-row sup_margin_left_right_0 sup_flex_left_center sup_padding_bottom_10 sup_border-bottom" style="margin-top:10px;">

    <div class="govuk-grid-column-one-third">
        <label for="testCodePick" class="govuk-label govuk-!-font-weight-bold">Select a Test:</label>
        <div id="testCodePickMultiDropdown"></div>
        <input type="hidden" id="testCodePick" value="@Model.SelectedTestCode" />
    </div>
</div>

@* Grid *@
<div class="govuk-grid-row sup_margin_left_right_0 sup_margin_top_10">
    <div class="govuk-grid-column-full">
        <div id="gridContainer_testSupplierGrid">
            @await Html.PartialAsync("_DataGrid", Model.TestSupplierGrid)
        </div>
        <div class="fps-summary-row">
            <div class="govuk-form-group govuk-!-margin-bottom-0">
                <label class="govuk-label govuk-label--s govuk-!-margin-bottom-0" for="totalTests">Total Tests</label>
                <input type="text" id="totalTests" class="govuk-input fps-summary-input" value="0.00" readonly aria-label="Total tests" />
            </div>
            <div class="govuk-form-group govuk-!-margin-bottom-0">
                <label class="govuk-label govuk-label--s govuk-!-margin-bottom-0" for="totalTestCost">Total Cost</label>
                <input type="text" id="totalTestCost" class="govuk-input fps-summary-input" value="£0.00" readonly aria-label="Total test cost" />
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/common/multicolumn-dropdown.css" />
}

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script src="~/js/common/multicolumn-dropdown.component.js"></script>
    <script>
    var currentTestCode = '@Model.SelectedTestCode';
    var currentShowRejected = @Model.ShowRejected.ToString().ToLower();
    var testCodeSelectDropdown = null;
    const testCodeOptionsListData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.TestCodeList));

    $(function () {
        initializeTestCodeMultiColumnDropdown();
        calculateTotals();
    });

    // Multi-column dropdown for Test selection (consistent with other lookup screens).
    function initializeTestCodeMultiColumnDropdown() {
        testCodeSelectDropdown = new MultiColumnDropdownComponent({
            dropdownId: 'testCodePickDropdown',
            containerSelector: '#testCodePickMultiDropdown',
            placeholder: 'Select a Test',
            showSerialNumber: false,
            searchPlaceholder: 'Search by Test',
            labelText: '',
            columns: [
                { field: 'Value', header: 'Test Code', width: '100px' },
                { field: 'Text', header: 'Test Description', width: '180px' }
            ],
            data: testCodeOptionsListData,
            displayField: 'Text',
            valueField: 'Value',
            clearButtonClearsSelection: true,
            showClearButton: true,

            callbacks: {
                onSelect: function (selectedItem) {
                    $('#testCodePick').val(selectedItem.Value);
                    onTestCodeChange(selectedItem.Value);
                },
                onClear: function () {
                    $('#testCodePick').val('');
                    onTestCodeChange('');
                }
            }
        });

        // Preserve the selected value after reloads so the dropdown stays consistent.
        if (currentTestCode) {
            testCodeSelectDropdown.setValue(currentTestCode);
        }
    }

    // Extra filters merged into the grid's own sort/filter/pagination requests.
    function getTestSupplierExtraFilters() {
        return {
            testCode: currentTestCode,
            showRejected: currentShowRejected
        };
    }

    // Recalculate totals after the grid reloads itself (sort/filter/pagination).
    document.addEventListener('gridReloaded', function (e) {
        if (e.detail && e.detail.gridId === 'testSupplierGrid') {
            calculateTotals();
        }
    });

    // ── Filter changes ────────────────────────────────────────────────────────

    function onTestCodeChange(testCode) {
        currentTestCode = testCode;
        reloadGrid();
    }

    function onShowRejectedChange(checked) {
        currentShowRejected = checked;
        reloadGrid();
    }

    function reloadGrid() {
        var request = {
            Page: 1,
            PageSize: 10,
            SortBy: '',
            Descending: false,
            Filter: '{}',
            testCode: currentTestCode,
            showRejected: currentShowRejected
        };
        $.post('/FPS/TestSupplier/LoadTestSupplierGrid', request, function (html) {
            $('#gridContainer_testSupplierGrid').html(html);
            calculateTotals();
        });
    }

    function calculateTotals() {
        var totalTests = 0;
        var totalCost = 0;

        $('#gridContainer_testSupplierGrid td[data-property="NoRequired"] span').each(function () {
            var val = parseFloat($(this).text().trim());
            if (!isNaN(val)) totalTests += val;
        });

        $('#gridContainer_testSupplierGrid td[data-property="TestCost"] span').each(function () {
            var raw = $(this).text().trim().replace(/[£,]/g, '');
            var val = parseFloat(raw);
            if (!isNaN(val)) totalCost += val;
        });

        $('#totalTests').val(totalTests.toFixed(2));
        $('#totalTestCost').val('£' + totalCost.toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    }

    // ── CRUD ──────────────────────────────────────────────────────────────────

    function addTestSupplier() {
        if (!currentTestCode) {
            showAlertMessage('Please select a Test Code first.', AlertType.INFO);
            return;
        }
        $.get('/FPS/TestSupplier/CreateTestReqmt', { testCode: currentTestCode }, function (html) {
            openModal(html);
        }).fail(function () {
            showAlertMessage('An error occurred while loading the form', AlertType.ERROR);
        });
    }

    function editTestSupplier(btn) {
        var buyer = $(btn).data('id');
        $.get('/FPS/TestSupplier/EditTestReqmt', { testCode: currentTestCode, buyer: buyer }, function (html) {
            openModal(html);
        }).fail(function () {
            showAlertMessage('An error occurred while loading the edit form', AlertType.ERROR);
        });
    }

    function deleteTestSupplier(btn) {
        var buyer = $(btn).data('id');
        showGovukConfirm('Are you sure you want to delete this Test Supplier entry?').then(function (result) {
            if (!result) return;
            $.ajax({
                url: '/FPS/TestSupplier/DeleteTestReqmt',
                type: 'DELETE',
                data: { testCode: currentTestCode, buyer: buyer },
                success: function (response) {
                    if (response.success) {
                        showAlertMessage('Record deleted successfully.', AlertType.SUCCESS).then(function () {
                            reloadGrid();
                        });
                    } else {
                        showAlertMessage(response.message || 'Failed to delete entry.', AlertType.ERROR);
                    }
                },
                error: function () {
                    showAlertMessage('An error occurred while deleting.', AlertType.ERROR);
                }
            });
        });
    }

    function saveTestSupplier() {
        clearValidationErrors('#modaPopupBody');
        var form = $('#testSupplierForm');

        if (!isFormValid(form)) {
            displayClientValidationErrors(form, '#modaPopupBody');
            return;
        }

        var formData = {};
        form.serializeArray().forEach(function (item) {
            // Convert empty strings to null for nullable decimal fields
            if (item.name === 'UnitPrice' && item.value === '') {
                formData[item.name] = null;
            } else {
                formData[item.name] = item.value;
            }
        });

        $.ajax({
            url: '/FPS/TestSupplier/EditTestReqmt',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(formData),
            success: function (result) {
                if (result.success) {
                    closeModal();
                    showAlertMessage(result.message || 'Record saved successfully.', AlertType.SUCCESS);
                    reloadGrid();
                } else {
                    displayServerValidationErrors(result.errors, result.message, '#modaPopupBody');
                }
            },
            error: function (xhr) {
                if (xhr.status === 400 && xhr.responseJSON) {
                    displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                } else {
                    showAlertMessage('An error occurred while saving.', AlertType.ERROR);
                }
            }
        });
    }

    function openModal(html) {
        $('#modaPopupBody').html(html);
        $('#modalPopup').addClass('show');
    }

    function closeModal() {
        $('#modaPopupBody').html('');
        $('#modalPopup').removeClass('show');
    }
</script>
}
