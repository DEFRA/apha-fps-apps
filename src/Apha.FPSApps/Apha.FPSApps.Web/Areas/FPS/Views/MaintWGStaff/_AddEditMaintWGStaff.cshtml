@model Apha.FPSApps.Web.Areas.FPS.Models.WorkGroupEmployeeItem

@* TRANSFORMENGINE: human_review — verify before running *@

@{
    // TRANSFORMENGINE: isEditMode = PactId is non-null/empty (string PK).
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.PactId);
    var title = isEditMode ? "Edit WG Staff" : "Add WG Staff";
    var saveLabel = isEditMode ? "Update" : "Save";
}

<div class="modal-header">
    <h5 class="modal-title" id="wgStaffModalTitle">@title</h5>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>

<div class="modal-body" style="overflow-y:auto; max-height:calc(80vh - 120px);">
    <div class="govuk-error-summary" role="alert" aria-labelledby="error-summary-title"
         tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">There is a problem</h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list"></ul>
        </div>
    </div>

    <form id="formMaintWGStaff" class="row g-2">
        @Html.AntiForgeryToken()

        @* ── Hidden edit-mode flag ── *@
        <input type="hidden" id="hdnIsEdit" value="@(isEditMode ? "true" : "false")" />

        @* ── SpNumber — not a JS modal field; hidden, used as contextual identifier for display.
               IsVisible=false in WorkGroupEmployeeItem; not posted in DTO but preserved here.
               TRANSFORMENGINE: SpNumber hidden for transport; no asp-for output field needed in save payload. *@
        <input type="hidden" id="SpNumber" asp-for="SpNumber" />

        @* ── 1. PACT Id — JS field: { id: 'wgStaffPactId', key: 'pactId', type: 'number' }
               PK and visible grid column. In Add mode: user entry (required, > 0).
               In Edit mode: disabled (key cannot change) + hidden for save payload. *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="PactId">
                    PACT Id: <span class="sup_color_red">*</span>
                </label>
                @if (isEditMode)
                {
                    @* TRANSFORMENGINE: PactId — edit mode: disabled display + hidden for payload *@
                    <input class="govuk-input govuk-!-font-size-16"
                           id="PactId"
                           asp-for="PactId"
                           type="number"
                           disabled />
                    <input type="hidden" asp-for="PactId" />
                }
                else
                {
                    @* TRANSFORMENGINE: PactId — add mode: editable number input, required *@
                    <input class="govuk-input govuk-!-font-size-16"
                           id="PactId"
                           asp-for="PactId"
                           type="number"
                           min="1"
                           required />
                }
                <span asp-validation-for="PactId" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── 2. Staff Name — JS field: { id: 'wgStaffName', key: 'staffName', type: 'text' }
               Required. Maps to WorkGroupEmployeeDto.Name via FpsViewModelMapper ForMember. *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="StaffName">
                    Staff Name: <span class="sup_color_red">*</span>
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="StaffName"
                       asp-for="StaffName"
                       type="text"
                       required />
                <span asp-validation-for="StaffName" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── 3. WG Grade — JS field: { id: 'wgStaffGrade', key: 'wgGrade', type: 'text' }
               Required. Maps to WorkGroupEmployeeDto.WorkGroupGrade via FpsViewModelMapper ForMember. *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="WgGrade">
                    WG Grade: <span class="sup_color_red">*</span>
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="WgGrade"
                       asp-for="WgGrade"
                       type="text"
                       required />
                <span asp-validation-for="WgGrade" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── 4. Status — JS field: { id: 'wgStaffStatus', key: 'status', type: 'text', defaultValue: 'I' }
               Required. Maps to WorkGroupEmployeeDto.PersonStatus. *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="PersonStatus">
                    Status: <span class="sup_color_red">*</span>
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="PersonStatus"
                       asp-for="PersonStatus"
                       type="text"
                       maxlength="10"
                       required />
                <span asp-validation-for="PersonStatus" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── 5. Class — JS field: { id: 'wgStaffClass', key: 'classCode', type: 'text', defaultValue: 'A' }
               Nullable. Maps to WorkGroupEmployeeDto.PersonClass. *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="PersonClass">
                    Class:
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="PersonClass"
                       asp-for="PersonClass"
                       type="text"
                       maxlength="10" />
                <span asp-validation-for="PersonClass" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── 6. HrsPaid — JS field: { id: 'wgStaffHrsPaid', key: 'hrsPaid', type: 'number', defaultValue: 0 }
               Required double. *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="HrsPaid">
                    HrsPaid: <span class="sup_color_red">*</span>
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="HrsPaid"
                       asp-for="HrsPaid"
                       type="number"
                       step="0.01"
                       required />
                <span asp-validation-for="HrsPaid" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── 7. Leave — JS field: { id: 'wgStaffLeave', key: 'leave', type: 'number', defaultValue: 0 }
               Required double. *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="Leave">
                    Leave: <span class="sup_color_red">*</span>
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="Leave"
                       asp-for="Leave"
                       type="number"
                       step="0.01"
                       required />
                <span asp-validation-for="Leave" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── 8. SickSpecial — JS field: { id: 'wgStaffSickSpecial', key: 'sickSpecial', type: 'number', defaultValue: 0 }
               Required double. *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="SickSpecial">
                    SickSpecial: <span class="sup_color_red">*</span>
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="SickSpecial"
                       asp-for="SickSpecial"
                       type="number"
                       step="0.01"
                       required />
                <span asp-validation-for="SickSpecial" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── 9. HrsAvail — JS field: { id: 'wgStaffHrsAvail', key: 'hrsAvail', type: 'number', defaultValue: 0 }
               Read-only: computed server-side (HrsPaid - Leave - SickSpecial). GridColumnType.ReadOnly.
               TRANSFORMENGINE: disabled — not posted in DTO. saveMaintWGStaff() reads this for DTO.HrsAvail. *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="HrsAvail">
                    HrsAvail:
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="HrsAvail"
                       asp-for="HrsAvail"
                       type="number"
                       step="0.01"
                       disabled />
            </div>
        </div>

        @* ── 10. Available? — JS field: { id: 'wgStaffAvailable', key: 'available', type: 'select',
                options: [{ value: 'false', text: 'No' }, { value: 'true', text: 'Yes' }] }
               bool in WorkGroupEmployeeItem; int (0/1) in Dto via FpsViewModelMapper.
               TRANSFORMENGINE: Safe manual <option> pattern — @if/@else block (never @(...) in attribute area). *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="MakeAvailable">
                    Available?:
                </label>
                <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                        id="MakeAvailable"
                        asp-for="MakeAvailable"
                        aria-label="Select available status">
                    @if (Model?.MakeAvailable == true)
                    {
                        <option value="false">No</option>
                        <option value="true" selected>Yes</option>
                    }
                    else
                    {
                        <option value="false" selected>No</option>
                        <option value="true">Yes</option>
                    }
                </select>
                <span asp-validation-for="MakeAvailable" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── 11. Time recorder? — JS field: { id: 'wgStaffRecorder', key: 'timeRecorder', type: 'select',
                options: [{ value: 'false', text: 'No' }, { value: 'true', text: 'Yes' }] }
               Default 'true' in JS add defaults (timeRecorder: true).
               bool in WorkGroupEmployeeItem; int (0/1) in Dto via FpsViewModelMapper.
               TRANSFORMENGINE: Safe manual <option> pattern — @if/@else block only. *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="TimeRecorder">
                    Time recorder?:
                </label>
                <select class="govuk-select govuk-!-font-size-16 sup_select_option_width_100"
                        id="TimeRecorder"
                        asp-for="TimeRecorder"
                        aria-label="Select time recorder status">
                    @if (Model?.TimeRecorder == true)
                    {
                        <option value="false">No</option>
                        <option value="true" selected>Yes</option>
                    }
                    else
                    {
                        <option value="false" selected>No</option>
                        <option value="true">Yes</option>
                    }
                </select>
                <span asp-validation-for="TimeRecorder" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── 12. Start Date — JS field: { id: 'wgStaffStartDate', key: 'startDate', type: 'date' }
               Nullable DateTime?. *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="StartDate">
                    Start Date:
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="StartDate"
                       asp-for="StartDate"
                       type="date" />
                <span asp-validation-for="StartDate" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── 13. End Date — JS field: { id: 'wgStaffEndDate', key: 'endDate', type: 'date' }
               Nullable DateTime?. *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="EndDate">
                    End Date:
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="EndDate"
                       asp-for="EndDate"
                       type="date" />
                <span asp-validation-for="EndDate" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

        @* ── 14. Hours per week — JS field: { id: 'wgStaffHoursPerWeek', key: 'hoursPerWeek', type: 'number' }
               Nullable double?. Empty string in JS means "not set". *@
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label class="govuk-label govuk-!-font-weight-bold govuk-!-font-size-16" asp-for="HoursPerWeek">
                    Hours per week:
                </label>
                <input class="govuk-input govuk-!-font-size-16"
                       id="HoursPerWeek"
                       asp-for="HoursPerWeek"
                       type="number"
                       step="0.01" />
                <span asp-validation-for="HoursPerWeek" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>

    </form>
</div>

<div class="modal-footer sup_flex_space_center">
    <button class="govuk-button govuk-button--secondary sup_margin_0"
            data-module="govuk-button"
            onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0"
            data-module="govuk-button"
            type="button"
            onclick="saveMaintWGStaff()">@saveLabel</button>
</div>
