         message before inserting. -->

@using Apha.FPSApps.Web.Models.Components.DataGrid
@model Apha.FPSApps.Web.Areas.FPS.Models.MaintWGStaffViewModel

@* TRANSFORMENGINE: human_review — verify before running *@

@{
    ViewData["Title"] = "2025-2026 : WG Staff Maintenance";
}

<main id="main-content">
    <div class="container-fluid">

        <!-- Breadcrumb — replicated from frmMaintWGStaff.html govuk-breadcrumbs nav -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="fps-sr-breadcrumb-row">
                    <div class="fps-sr-breadcrumb-flex">
                        <div class="govuk-grid-column-full">
                            <nav class="govuk-breadcrumbs" aria-label="Breadcrumb">
                                <ol class="govuk-breadcrumbs__list">
                                    <li class="govuk-breadcrumbs__list-item">
                                        <a class="govuk-breadcrumbs__link"
                                           href="@Url.Action("Index", "Home", new { area = "FPS" })">Home</a>
                                    </li>
                                    <li class="govuk-breadcrumbs__list-item">
                                        <a class="govuk-breadcrumbs__link" href="#">MAB</a>
                                    </li>
                                    <li class="govuk-breadcrumbs__list-item">
                                        <a class="govuk-breadcrumbs__link"
                                           href="@Url.Action("Index", "DivisionMaintenance", new { area = "FPS" })">Maintenance Menu</a>
                                    </li>
                                    <li class="govuk-breadcrumbs__list-item" aria-current="page">
                                        Maintain WG Staff
                                    </li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Title — "Work Group Staff" from HTML prototype h1 -->
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full govuk-!-margin-left-3">
                <h1 class="govuk-grid-row govuk-heading-s sup_border-bottom govuk-!-margin-top-2 govuk-!-padding-bottom-2 govuk-!-padding-left-4">
                    Work Group Staff
                </h1>
            </div>
        </div>

        <!-- Main layout row: side nav + grid -->
        <div class="row">
            <div class="col-lg-12">
                <main class="main-content" style="padding:0;">
                    <div class="container-fluid" style="padding:0;">
                        <div class="row">
                            <div class="container-fluid" style="padding-left:0px;">
                                <div class="wgg-container-fluid">
                                    <div class="wgg-layout-row">

                                        <!-- Side navigation — mirrors prototype #shortnav via _MaintenanceSideNav partial -->
                                        @await Html.PartialAsync("_MaintenanceSideNav", "MaintWGStaff")

                                        <div style="display:flex; flex-direction:column; flex:1 1 auto; min-width:0; margin:0 0px 5px 8px;">

                                            <!-- DataGrid — no page-level filter; HTML prototype has no <select> outside grid.
                                                 AllowAdd/Edit/Delete all true — derived from JS showAddButton + action column buttons.
                                                 TRANSFORMENGINE: gridContainer_ ID uses model GridId ("wgStaffGrid"). -->
                                            <div class="govuk-grid-row">
                                                <div class="govuk-grid-column-full mt-2">
                                                    <div id="gridContainer_@Model.WGStaffGrid.GridId">
                                                        @await Html.PartialAsync("_DataGrid", Model.WGStaffGrid)
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>

    </div>
</main>

@section Scripts {
    <script src="~/js/ajax-form-validation.js"></script>
    <script>
        // TRANSFORMENGINE: gridId mirrors DataGridConfig.GridId = "wgStaffGrid" set in MaintWGStaffController.
        // TRANSFORMENGINE (Phase 14 security fix): Html.JavaScriptStringEncode() applied — model values
        // emitted into JS string literals require JS encoding, not HTML encoding, to prevent XSS.
        var wgStaffGridId = '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.WGStaffGrid.GridId)';

        // ── Grid manager helper ─────────────────────────────────────────────────
        function getGridManager() {
            return window['gridManager_' + wgStaffGridId];
        }

        // ── ExtraFilterMethod — called by _DataGrid on every reload.
        // No page-level filter controls; returns empty object.
        // TRANSFORMENGINE: ExtraFilterMethod = "getMaintWGStaffExtraFilters" in DataGridConfig.
        function getMaintWGStaffExtraFilters() {
            return {};
        }

        // ── Add — AllowAdd: true (JS showAddButton: true) ───────────────────────
        // TRANSFORMENGINE: AddFunction = "addMaintWGStaff" in DataGridConfig.
        function addMaintWGStaff() {
            $.get('/FPS/MaintWGStaff/Create', function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        // ── Edit — AllowEdit: true (JS wg-edit-btn in action column) ───────────
        // TRANSFORMENGINE: EditFunction = "editMaintWGStaff" in DataGridConfig; $(btn).data('id') reads KeyProperty "PactId".
        function editMaintWGStaff(btn) {
            var pactId = $(btn).data('id');
            $.get('/FPS/MaintWGStaff/Edit', { pactId: pactId }, function (html) {
                $('#modaPopupBody').html(html);
                $('#modalPopup').addClass('show');
            });
        }

        // ── Delete — AllowDelete: true (JS wg-delete-btn in action column) ─────
        // TRANSFORMENGINE: DeleteFunction = "deleteMaintWGStaff"; DataGrid delete uses confirm(), NOT a modal partial.
        // $(btn).data('id') reads KeyProperty "PactId".
        function deleteMaintWGStaff(btn) {
            var pactId = $(btn).data('id');
            showGovukConfirm('Are you sure you want to delete this WG Staff record?').then(function (result) {
                if (!result) return;
                $.ajax({
                    url: '/FPS/MaintWGStaff/Delete',
                    type: 'DELETE',
                    data: { pactId: pactId },
                    success: function (response) {
                        if (response.success) {
                            showGovukAlert('WG Staff record deleted successfully').then(function () {
                                getGridManager().reloadGrid({ page: 1 });
                            });
                        } else {
                            showGovukAlert('Error: ' + (response.message || 'Delete failed.'));
                        }
                    },
                    error: function () {
                        showGovukAlert('An error occurred while deleting.');
                    }
                });
            });
        }

        // ── Save — called from _AddEditMaintWGStaff.cshtml ──────────────────────
        // TRANSFORMENGINE: Builds WorkGroupEmployeeDto JSON for Create/Edit POST.
        // Field name mapping:
        //   Item.StaffName        → Dto.Name
        //   Item.WgGrade          → Dto.WorkGroupGrade
        //   Item.PersonStatus     → Dto.PersonStatus
        //   Item.PersonClass      → Dto.PersonClass
        //   Item.MakeAvailable    → Dto.MakeAvailable (bool→int: true→1, false→0)
        //   Item.TimeRecorder     → Dto.TimeRecorder  (bool→int: true→1, false→0)
        //   Item.HrsAvail         → Dto.HrsAvail  (read-only computed; still included for DTO completeness)
        function saveMaintWGStaff() {
            clearValidationErrors('#modaPopupBody');
            var form = $('#formMaintWGStaff');

            if (!isFormValid(form)) {
                displayClientValidationErrors(form, '#modaPopupBody');
                return;
            }

            var isEdit = $('#hdnIsEdit').val() === 'true';

            // TRANSFORMENGINE: Build WorkGroupEmployeeDto — use Dto field names, not Item property names.
            // MakeAvailable and TimeRecorder: select values are 'true'/'false' strings → convert to int 1/0.
            var dto = {
                PactId:          $('#PactId').val(),
                SpNumber:        $('#SpNumber').val() || '',
                Name:            $('#StaffName').val(),
                WorkGroupGrade:  $('#WgGrade').val(),
                PersonStatus:    $('#PersonStatus').val(),
                PersonClass:     $('#PersonClass').val() || null,
                HrsPaid:         parseFloat($('#HrsPaid').val()) || 0,
                Leave:           parseFloat($('#Leave').val()) || 0,
                SickSpecial:     parseFloat($('#SickSpecial').val()) || 0,
                HrsAvail:        parseFloat($('#HrsAvail').val()) || 0,
                MakeAvailable:   $('#MakeAvailable').val() === 'true' ? 1 : 0,
                TimeRecorder:    $('#TimeRecorder').val() === 'true' ? 1 : 0,
                StartDate:       $('#StartDate').val() || null,
                EndDate:         $('#EndDate').val() || null,
                HoursPerWeek:    $('#HoursPerWeek').val() !== '' ? parseFloat($('#HoursPerWeek').val()) : null
            };

            var url = isEdit
                ? '/FPS/MaintWGStaff/Edit'
                : '/FPS/MaintWGStaff/Create';

            $.ajax({
                url: url,
                type: 'POST',
                data: JSON.stringify(dto),
                contentType: 'application/json',
                success: function (response) {
                    if (response.success) {
                        closeModal();
                        showGovukAlert(response.message);
                        getGridManager().reloadGrid({ page: 1 });
                    } else {
                        displayServerValidationErrors(response.errors, response.message, '#modaPopupBody');
                    }
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON) {
                        displayServerValidationErrors(xhr.responseJSON.errors, xhr.responseJSON.message, '#modaPopupBody');
                    } else {
                        showGovukAlert('An error occurred while saving.');
                    }
                }
            });
        }

        // ── Form validity check (mirrors pattern from StaffMaintenance/Index.cshtml) ──
        function isFormValid(form) {
            var isValid = true;
            form.find('[required]').each(function () {
                if (!$(this).val() || $(this).val().trim() === '') {
                    isValid = false;
                    return false;
                }
            });
            return isValid;
        }

        // ── Modal close ─────────────────────────────────────────────────────────
        function closeModal() {
            clearValidationErrors();
            $('#modaPopupBody').html('');
            $('#modalPopup').removeClass('show');
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
