@model Apha.FPSApps.Web.Areas.FPS.Models.AdditionalCostItemViewModel
@{
    var isEditMode = !string.IsNullOrEmpty(Model.JobCode) && !string.IsNullOrEmpty(Model.Account);
    var title = isEditMode ? "Update Additional Cost" : "Add Additional Cost";
    var formId = isEditMode ? "formEditAdditionalCost" : "formAddAdditionalCost";
    var saveLabel = isEditMode ? "Update" : "Save";
    var saveAction = isEditMode ? "updateAdditionalCost()" : "saveAdditionalCost()";
}

<div class="modal-header flex-space-center">
    <h3 class="modal-title" style="margin: 0;" id="additionalCostModalLabel">@title</h3>
    <button type="button" class="btn-close btn-red" onclick="closeModal()">X</button>
</div>
<div class="modal-body" style="overflow-y: auto; max-height: calc(80vh - 120px);">
    <div  class="govuk-error-summary" role="alert"
         aria-labelledby="error-summary-title" tabindex="-1" style="display:none;">
        <h2 class="govuk-error-summary__title" id="error-summary-title">
            There is a problem
        </h2>
        <div class="govuk-error-summary__body">
            <ul class="govuk-list govuk-error-summary__list" id="modalErrorList"></ul>
        </div>
    </div>
    <form class="row" id="@formId">
        <input type="hidden" asp-for="JobCode" id="JobCode" />
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="JobCode" class="govuk-label p-0">Job Code</label>
                <input type="text" asp-for="JobCode" class="govuk-input sup_width_100" readonly>
            </div>
        </div>
        @if (isEditMode)
        {
            <input type="hidden" asp-for="Account" id="OriginalAccount" />
        }
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="Description" class="govuk-label p-0">Description <span class="sup_color_red">*</span></label>
                <input type="text" asp-for="Description" id="Description" class="govuk-input sup_width_100" maxlength="20">
                <span asp-validation-for="Description" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="Account" class="govuk-label p-0">Account <span class="sup_color_red">*</span></label>
                <select id="Account" name="Account" required class="govuk-select sup_width_100">
                    <option value="">-- Select Account --</option>
                    @if (Model.AccountList != null)
                    {
                        foreach (var account in Model.AccountList)
                        {
                            <option value="@account.Value"
                                    selected="@(account.Selected ? "selected" : null)">@account.Text</option>
                        }
                    }
                </select>
                <span asp-validation-for="Account" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="ItemCost" class="govuk-label" asp-for="ItemCost">Item Cost</label>
                <div class="govuk-input__wrapper">
                    <div class="govuk-input__prefix" aria-hidden="true">£</div>
                    <input type="number" step="0.01" asp-for="ItemCost" class="govuk-input" id="ItemCost">
                </div>
                <span asp-validation-for="ItemCost" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="Freq" class="govuk-label" asp-for="Freq">Freq / Month</label>
                <input type="text" asp-for="Freq" class="govuk-input" id="Freq" maxlength="5">
                <span asp-validation-for="Freq" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
        <div class="col-12">
            <div class="govuk-form-group sup_margin_0">
                <label for="Supplier" class="govuk-label" asp-for="Supplier">Supplier</label>
                <input type="text" asp-for="Supplier" class="govuk-input" id="Supplier" maxlength="50">
                <span asp-validation-for="Supplier" class="govuk-error-message" style="display:none;"></span>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer sup_flex_space_center">
    <button class="govuk-button govuk-button--secondary sup_margin_0" data-module="govuk-button" onclick="closeModal()">Cancel</button>
    <button class="govuk-button sup_margin_0" data-module="govuk-button" type="button" onclick="@saveAction">@saveLabel</button>
</div>
