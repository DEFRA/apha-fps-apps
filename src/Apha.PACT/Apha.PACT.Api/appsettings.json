{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"ConnectionStrings": {
		"FPSConnectionString": "<FPS-DB-Connectionstring>"
	},
	"AllowedHosts": "*",
	"AwsLogging": {
		"LogGroupName": ""
	},
	"AzureAd": {
		"Instance": "https://login.microsoftonline.com/",
		"Domain": "<domain_name>.com",
		"ClientId": "<client_Id>",
		"TenantId": "<tenant_Id>",
		"ClientSecret": "<client_Secret>",
		"ClientCertificates": [
		],
		"CallbackPath": "/signin-oidc"
	},
	"GraphEmailSettings": {
		"TenantId": "<tenant_Id>",
		"ClientId": "<client_Id>",
		"ClientSecret": "<client_Secret>",
		"SharedMailbox": "<shared_mailbox>"
	},
	"WorkGroupReportEmailSettings": {
		"GatekeeperMailbox": "CAPSMailbox@vla.defra.gsi.gov.uk",
		"EmailBodyTemplate": "Please complete and return to APHA Gatekeeper - OTL Mailbox. [Mailto:{0}]. Thank you."
	},
	"LogsPath": "Logs",
	"ExceptionTypes": {
		"General": "FPS.GENERAL_EXCEPTION",
		"Database": "FPS.DB_EXCEPTION",
		"Authorization": "FPS.AUTHORIZATION_EXCEPTION"
	},
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"System": "Warning",
				"Microsoft.AspNetCore": "Warning"
			}
		}
	}

}
